{
 "s022.sec5.u0": "我的翅膀……",
 "s022.sec5.u1": "怎么了？",
 "s022.sec5.u2": "翅膀受伤了……你有没有治伤的药？",
 "s022.sec5.u3": "伤得好重！撑住，我找找看。",
 "s022.sec5.u4": "啊……什么药都没有。",
 "s022.sec5.u5": "不是这个。",
 "s022.sec5.u6": "好多了……谢谢你。",
 "s022.sec5.u7": "能飞了吗？",
 "s022.sec5.u8": "还飞不了太远。",
 "s022.sec5.u10": "我听说过城里的事……没想到，已经发展得那么好了。",
 "s022.sec5.u11": "你先去城里休息吧。",
 "s022.sec5.u12": "给你添麻烦了。这份恩情，我一定会报答。",
 "s022.sec5.u13": "独角马兽加入了文件城！",
 "s022.sec5.u14": "我去拿治伤的药来，你等着。",
 "s022.sec5.u15": "拜托……尽快……",
 "s022.sec51.u0": "地上有奇怪的图案。",
 "s022.sec51.u1": "是麦田怪圈！看样子，出现没多久。",
 "s022.sec51.u4": "嗯？",
 "s022.sec51.u5": "（入侵兽的飞碟出现了。）",
 "s022.sec51.u6": "外星人？！",
 "s022.sec51.u7": "……",
 "s022.sec51.u8": "是数码宝贝……？",
 "s022.sec51.u9": "……",
 "s022.sec51.u10": "那个……",
 "s022.sec51.u11": "……",
 "s022.sec51.u12": "（入侵兽举起了枪。）",
 "s022.sec51.u13": "等等，我们不是敌人！",
 "s022.sec51.u14": "（入侵兽放下了枪。）",
 "s022.sec51.u15": "（听懂了？太好了……）",
 "s022.sec51.u16": "{color 6}{player}{color 1}拼命地劝说！",
 "s022.sec51.u17": "……",
 "s022.sec51.u18": "（不行吗……？）",
 "s022.sec51.u19": "好——啊。",
 "s022.sec51.u20": "入侵兽加入了文件城！",
 "s189.sec5.u0": "治伤的药……带来了吗？",
 "s189.sec5.u1": "撑住，我找找看。",
 "s190.sec51.u3": "哇？！",
 "s190.sec51.u4": "又多了！比上次多太多了！",
 "s190.sec51.u5": "一定就是这么回事！",
 "s022.sec5.u9": [
  [
   "城里有家诊所。"
  ],
  [
   "去那里看看吧，离这儿不远。"
  ]
 ],
 "s022.sec51.u2": [
  [
   "又多了！比上次看到的还多！"
  ],
  [
   "难道和飞碟有关？"
  ]
 ],
 "s022.sec51.u3": [
  [
   "又多了！比上次多太多了！"
  ],
  [
   "一定就是这么回事！"
  ]
 ],
 "s022.sec51.u21": [
  [
   "那、那家伙……"
  ],
  [
   "原来会说话啊！！"
  ]
 ],
