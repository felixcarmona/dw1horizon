{
 "s133.sec5.u0": "嗡——！",
 "s133.sec6.u0": "咻哔哔哔……",
 "s133.sec7.u0": "唰唰……",
 "s133.sec8.u0": "气死我了，呱！",
 "s133.sec9.u0": "拿出毅力来！",
 "s133.sec10.u0": "住手，呱！",
 "s134.sec5.u0": "沙沙！沙沙！",
 "s134.sec6.u0": "咻——……",
 "s134.sec7.u0": "呱？",
 "s134.sec8.u0": "不先下手，就会被干掉，呱！",
 "s134.sec9.m0.o0": "都这么说了，忍不了！",
 "s134.sec9.m0.o1": "小孩子而已，不理他们",
 "s134.sec9.u0": "略略略！",
 "s134.sec9.u1": "胆小鬼！",
 "s134.sec9.u2": "没胆量的家伙！",
 "s134.sec9.u3": "窝囊废！",
 "s134.sec9.u4": "慢吞吞！",
 "s134.sec9.u5": "大笨蛋！",
 "s134.sec9.u6": "你、你们说什么？！",
 "s134.sec9.u7": "呜哇——他们欺负我！",
 "s134.sec9.u8": "嗯，怎么了？",
 "s134.sec9.u9": "！！",
 "s134.sec9.u10": "主公召见你们，呱。跟我们走，呱。",
 "s134.sec9.u11": "糟、糟了……上当了……",
 "s134.sec9.u12": "呵呵，还挺会逞强。我才不跟小孩子计较！"
}
