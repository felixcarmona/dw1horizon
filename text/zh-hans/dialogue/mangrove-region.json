{
 "s016.sec5.u1": "有……什么……有什么……有什么事，想起来了！",
 "s016.sec5.u2": "？",
 "s016.sec5.u3": "我以前住在城里。你身上，有城市的气味呢。",
 "s016.sec5.u4": "居然是这样。",
 "s016.sec5.u6": "当然。我想，现在肯定比以前更热闹了！",
 "s016.sec5.u7": "真的？好，我也要加油！",
 "s016.sec5.u8": "贝塔兽加入了文件城！",
 "s016.sec6.u0": "这是我的地盘！",
 "s016.sec7.u0": "吱呀！吱呀呀呀！",
 "s016.sec8.u0": "你、你等着瞧。",
 "s017.sec5.u0": "嘶！嘶！",
 "s017.sec6.u0": "嗡嗡！嗡嗡！",
 "s017.sec7.u0": "哈哈哈！你没事吧？",
 "s017.sec8.u0": "唔？",
 "s017.sec9.u0": "吼！吼吼吼吼！",
 "s017.sec10.u0": "丛林毛呀——……",
 "s016.sec5.u0": [
  [
   "咕噜噜……"
  ],
  [
   "咕噜噜……噜……噜？"
  ]
 ],
 "s016.sec5.u5": [
  [
   "真可怕，不知不觉，我就离开了城市，还失",
   "去了记忆。"
  ],
  [
   "不过，多亏你，我全都想起来了！"
  ],
  [
   "我要回城里去，可以吧？"
  ]
 ],
 "s017.sec81.u0": [
  [
   "{color 3}警告{color 1}：鲁莽闯入者，将遭到炮击。",
   "",
   "人马兽"
  ]
 ],
 "s017.sec81.u1": [
  [
