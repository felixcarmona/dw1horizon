   "看来，赶上啦！"
  ]
 ],
 "s184.sec51.u34": [
  [
   "{color 7}模拟人 {color 1}",
   "不可能……再这样下去……不要……救、救",
   "命……呜……啊啊啊啊——！！！"
  ]
 ],
 "s184.sec51.u36": [
  [
   "{color 7}公公兽 {color 1}",
   "不知道。不过……"
  ]
 ],
 "s184.sec51.u38": [
  [
