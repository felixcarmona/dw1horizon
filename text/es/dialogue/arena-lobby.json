 "s168.sec82.m0.o0": "Historial",
 "s168.sec82.m0.o1": "Torneos de categoría",
 "s168.sec82.m0.o2": "Torneos especiales",
 "s168.sec82.u0": "Información del Coliseo",
 "s168.sec82.u1": [
  [
   "Torneos ganados: {cupswon}",
   "",
   "{wins} victorias",
   "{losses} derrotas"
  ]
 ],
 "s168.sec82.u2": [
  [
   "Cualquiera puede participar en los torneos",
   "de categoría, que se celebran a menudo."
  ],
  [
   "Aun así, evita inscribir a un Digimon muy",
   "por encima del nivel del torneo."
  ],
  [
   "Además, si tu Digimon cambia de especie entre",
   "la inscripción y el torneo, su inscripción",
   "queda anulada."
  ]
 ],
 "s168.sec82.u3": "Los torneos especiales tienen requisitos fijos y se celebran muy de vez en cuando. Si en la ciudad no hay bastantes participantes que los cumplan, no se celebran. Cada uno se celebra solo una o dos veces al año, así que mira el calendario con tiempo.",
 "s168.sec84.u0": [
  [
   "Je, je... {color 10}{partner}{color 1},",
   "has salvado el mundo. Deja que",
   "te busque un título de héroe."
  ],
  [
   "Veamos..."
  ]
 ],
