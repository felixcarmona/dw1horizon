 "s102.sec51.u0": "Hoy no torneo.",
 "s102.sec51.u1": "Quien no inscrito, no entrar.",
 "s102.sec51.u2": "Todavía preparar. Venir día 22, de 10:00 de mañana a 23:00 de noche.",
 "s102.sec51.u3": "Lástima. Torneo ya terminar. Volver año que viene.",
 "s102.sec81.m0.o0": "Explícamelo",
 "s102.sec81.m0.o1": "No hace falta",
 "s102.sec81.m1.o0": "Inscribirme",
 "s102.sec81.m1.o1": "No inscribirme",
 "s102.sec81.m2.o0": "No cancelar",
 "s102.sec81.m2.o1": "Cancelar",
 "s102.sec81.u0": "Lástima. Inscripción ya cerrar. Esperar otro año.",
 "s102.sec81.u1": "Ahora no época de torneo. Yo aburrido.",
 "s102.sec81.u2": "Torneo acabar ahora mismo. Esperar otro año.",
 "s102.sec81.u3": "Tú no insecto. No entrar torneo.",
 "s102.sec81.u4": "¿Tú inscribirte en torneo?",
 "s102.sec81.u5": [
  [
   "Día 22, torneo de lucha solo",
   "para Digimon insecto. Ahora tú",
   "poder inscribirte."
  ],
  [
   "Si no Digimon insecto, no",
   "entrar."
  ],
  [
   "Si ganar, tú llevar premio muy",
   "bueno. Probar no hacer daño."
  ]
 ],
 "s102.sec81.u6": "Ahora no época de torneo. Yo aburrido.",
 "s102.sec81.u7": "Torneo acabar ahora mismo. Esperar otro año.",
 "s102.sec81.u8": "Tú inscrito en «{cup 3}». ¿Tú cancelar?",
 "s102.sec81.u9": "Cancelado.",
 "s102.sec81.u10": "¿Qué? ¿Tú seguro?",
 "s102.sec81.u11": "Inscrito.",
 "s102.sec82.u0": "Lástima. Otra vez año que viene.",
 "s102.sec82.u1": [
  [
