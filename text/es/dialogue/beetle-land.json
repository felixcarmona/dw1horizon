 "s102.sec82.u8": "¡Objetos llenos!",
 "s103.sec5.m0.o0": "En un gimnasio, supongo",
 "s103.sec5.m0.o1": "En el Coliseo, quizá",
 "s103.sec5.u0": "Yo aburrido entrenar aquí. ¿Qué hacer?",
 "s103.sec5.u1": "¿Que qué hacer, dices...?",
 "s103.sec5.u2": "¿Dónde tú entrenar?",
 "s103.sec5.u3": "En un gimnasio, supongo.",
 "s103.sec5.u4": "Entrenar aburrido. Yo querer hacerme fuerte en combates de verdad.",
 "s103.sec5.u5": "Entrenar aburrido. Yo querer hacerme fuerte en combates de verdad.",
 "s103.sec5.u6": "Yo ir allí. Yo entrenar.",
 "s103.sec5.u7": "¡Kabuterimon se ha unido a la ciudad!",
 "s103.sec6.u0": [
  [
   "Cada año, en día con dos 2,",
   "torneo de lucha de insectos",
   "aquí. Ganador llevar cosa"
  ],
  [
   "genial."
  ],
  [
   "Pero solo Digimon insecto poder",
   "entrar."
  ]
 ],
 "s103.sec6.u1": [
  [
   "Kabuterimon, Kuwagamon,",
   "Kunemon, y otra clase más de",
   "insecto. Pero Numemon no."
  ],
  [
   "Cada año, en día con dos 2,",
   "torneo de lucha de insectos",
   "aquí... ¿Mm?"
  ],
  [
   "Tú ya ganar torneo antes."
  ]
 ],
 "s103.sec6.u2": [
  [
   "Kabuterimon, Kuwagamon,",
   "Kunemon, y otra clase más de",
   "insecto: HerculesKabuterimon."
  ],
  [
   "Hercules superfuerte. Ganador",
   "de torneo llevar objeto que",
   "hace Hercules."
  ],
  [
   "Tú poder entrar en torneo de",
   "insectos muchas veces."
  ]
 ],
 "s103.sec7.m0.o0": "¡Pues claro!",
 "s103.sec7.m0.o1": "No, gracias",
 "s103.sec7.u0": "Tú fuerte. Yo nada que enseñarte.",
 "s103.sec7.u1": [
  [
   "Nosotros estudiar técnicas.",
   "Técnicas fuertes difícil",
   "aprender."
  ],
  [
   "Si tú tener capacidad, quizá tú",
   "aprender técnica. ¿Tú querer",
   "técnica fuerte?"
  ]
 ],
 "s103.sec7.u2": "Entonces probar.",
 "s103.sec7.u3": "A ti faltar Defensa. Entrenar más.",
 "s103.sec7.u4": "A ti faltar Velocidad. Entrenar más.",
 "s103.sec7.u5": "A ti faltar HP. Entrenar más.",
 "s103.sec7.u6": "Tú aprender técnica.",
 "s103.sec7.u7": "¡Ha aprendido Bicho!",
 "s103.sec81.u0": [
  [
   "",
   "{color 5}Entrenamiento: Empujar roca{color 1}"
  ]
 ],
 "s103.sec81.u1": "Empujar la roca da una fuerza oculta. Los HP máx. suben mucho.",
 "s103.sec81.u2": [
  [
   "{color 7}Tragaperras{color 1}",
   "",
   "Para los tres rodillos con {color 6}×{color 1}",
   "y alinea los dibujos."
  ]
 ],
 "s103.sec83.u0": [
  [
   "",
   "{color 5}Entrenamiento: Golpeo{color 1}"
  ]
 ],
 "s103.sec83.u1": "Practica técnicas de golpeo con un muñeco. El Ataque sube mucho.",
 "s103.sec83.u2": [
  [
   "{color 7}Tragaperras{color 1}",
   "",
   "Para los tres rodillos con {color 6}×{color 1}",
   "y alinea los dibujos."
  ]
 ],
 "s104.sec5.m0.o0": "Mmm. Hacerte más fuerte",
 "s104.sec5.m0.o1": "Pues sé de un truco...",
 "s104.sec5.m0.o2": "Ánimo",
 "s104.sec5.u0": "Yo querer ganar a esos Kabuterimon. ¿Cómo yo ganar?",
 "s104.sec5.u1": "Sí, yo pensar eso. Yo entrenar.",
 "s104.sec5.u2": "¿Qué? Decirme.",
 "s104.sec5.u3": "Pues vente a la ciudad.",
 "s104.sec5.u4": [
  [
   "..."
  ],
  [
   "Tú amable. Yo ir ciudad."
  ]
 ],
 "s104.sec5.u5": "¡Kuwagamon se ha unido a la ciudad!",
 "s104.sec5.u6": "Tú no amable. Yo decepcionado.",
 "s104.sec6.u0": [
  [
   "Mm, tú ya estar en torneo de",
   "insectos antes."
  ],
  [
   "Entonces yo contarte cosa",
   "buena."
  ],
  [
   "¿Tú conocer «Lecho de",
   "Kunemon»? Estar en Bosque",
   "Native."
  ],
  [
   "Digimon niño dormir allí.",
   "Despertar Kunemon. A veces",
   "no. Ser suerte."
  ]
 ],
 "s104.sec6.u1": [
  [
   "Tú, torneo de insectos... ¿Mm?",
   "Tú ahora no poder entrar."
  ],
  [
   "Entonces yo contarte cosa",
   "buena."
  ],
  [
   "¿Tú conocer «Lecho de",
   "Kunemon»? Estar en Bosque",
   "Native."
  ],
  [
   "Digimon niño dormir allí.",
   "Despertar Kunemon. A veces",
   "no. Ser suerte."
  ]
 ],
 "s104.sec6.u2": "¿Tú entrar en torneo de lucha de insectos?",
 "s104.sec6.u3": "¿Y eso qué es?",
 "s104.sec6.u4": "Apuntarse antes de 10 en punto de día 22, o no entrar.",
 "s104.sec6.u5": "¿¿¿???",
 "s104.sec6.u6": "Detalles el mismo día.",
 "s104.sec6.u7": "No tengo ni idea de qué habla.",
 "s104.sec7.m0.o0": "Descansar un rato",
 "s104.sec7.m0.o1": "No descansar",
 "s104.sec7.u0": [
  [
