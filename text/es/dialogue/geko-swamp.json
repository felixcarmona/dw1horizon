{
 "s133.sec5.u0": "¡Bzzzzzz!",
 "s133.sec6.u0": "Fiuiuiuiu...",
 "s133.sec7.u0": "Zas, zas...",
 "s133.sec8.u0": "¡Qué rabia me da, croac!",
 "s133.sec9.u0": "¡Echadle agallas!",
 "s133.sec10.u0": "¡Basta ya, croac!",
 "s134.sec5.u0": "¡Chaca-chaca!",
 "s134.sec6.u0": "Fsssuuuuu...",
 "s134.sec7.u0": "¿Croac?",
 "s134.sec8.u0": "¡A por ellos antes de que vengan a por nosotros, croac!",
 "s134.sec9.m0.o0": "¡Esto no lo consiento!",
 "s134.sec9.m0.o1": "Son críos. Paso de ellos",
 "s134.sec9.u0": "¡Chincha, rabiña!",
 "s134.sec9.u1": "¡Gallina!",
 "s134.sec9.u2": "¡Miedica!",
 "s134.sec9.u3": "¡Paquete!",
 "s134.sec9.u4": "¡Tortuga!",
 "s134.sec9.u5": "¡Tonto!",
 "s134.sec9.u6": "¿¡Q-qué has dicho!?",
 "s134.sec9.u7": "¡Buaaa! ¡Se meten conmigo!",
 "s134.sec9.u8": "¿Mm? ¿Qué es eso?",
 "s134.sec9.u9": "¡¡!!",
 "s134.sec9.u10": "Nuestro señor te manda llamar, croac. Te vienes con nosotros, croac.",
 "s134.sec9.u11": "Oh, no... He caído de lleno en la trampa...",
 "s134.sec9.u12": "Je, je, cuánto se hacen los valientes. ¡Yo paso de críos!"
}
