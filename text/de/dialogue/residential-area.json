{
 "s028.sec5.u0": [
  [
   "Ich habe das Schild am Eingang",
   "wieder aufgestellt. Ehrlich..."
  ]
 ],
 "s028.sec5.u1": [
  [
   "Heiß! Glühend heiß!! Ich",
   "koche!!! Jemand muss was tun!"
  ]
 ],
 "s028.sec5.u2": [
  [
   "Was ist denn in dich",
   "gefahren...?"
  ]
 ],
 "s028.sec5.u3": [
  [
   "Es ist so heiß! Ich halte es",
   "nicht mehr aus!"
  ]
 ],
 "s028.sec5.u4": [
  [
   "T-tut mir leid. Die Hitze hat",
   "mich wohl ganz wirr gemacht."
  ]
 ],
 "s028.sec5.u5": [
  [
   "Klar, es ist heiß, aber..."
  ]
 ],
 "s028.sec5.u6": [
  [
   "Dieser Tunnel... Je tiefer wir",
   "graben, desto heißer wird es.",
   "Kein Wunder, wir sind in einem"
  ],
  [
   "Vulkan."
  ]
 ],
 "s028.sec5.u7": [
  [
   "Aber in letzter Zeit ist da",
   "noch was. Es wurde ganz",
   "plötzlich heiß, wirklich"
  ],
  [
   "schlagartig. Als würde irgendwo",
   "ein Feuer brennen..."
  ]
 ],
 "s028.sec5.u8": [
  [
   "Hmmm."
  ]
 ],
 "s028.sec5.u9": [
  [
   "Am Ende muss ich wohl die",
   "Zähne zusammenbeißen und",
   "graben. Na gut, ich gebe mein"
  ],
  [
   "Bestes."
  ]
 ],
 "s028.sec5.u10": [
  [
   "Verstehe. Wir suchen auch",
   "nach der Ursache. Es würde",
   "uns sehr helfen, wenn dieser"
  ],
  [
   "Tunnel durchkäme."
  ]
 ],
 "s028.sec5.u11": [
  [
   "Du bist echt ein guter Kerl,",
   "weißt du? Gut, ich grabe diesen",
   "Tunnel im Nu fertig!"
  ]
 ],
 "s028.sec5.u12": [
  [
   "Heute habe ich Küchendienst."
  ]
 ]
