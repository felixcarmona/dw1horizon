   "{losses} Niederlagen"
  ]
 ],
 "s168.sec82.u2": [
  [
   "Klassenturniere finden oft",
   "statt und stehen allen offen.",
   "Melde aber keinen Digimon an,"
  ],
  [
   "der weit über der Turnierstufe",
   "liegt. Wechselt dein Digimon",
   "zwischen Anmeldung und Turnier"
  ],
  [
   "die Art, wird seine Anmeldung",
   "gestrichen."
  ]
 ],
 "s168.sec82.u3": [
  [
   "Spezialturniere haben feste",
   "Teilnahmebedingungen und finden",
   "selten statt. Gibt es in der"
  ],
  [
   "Stadt zu wenige geeignete",
   "Teilnehmer, fallen sie aus.",
   "Jedes findet nur ein- oder"
  ],
  [
   "zweimal im Jahr statt. Sieh",
   "also frühzeitig im Kalender",
   "nach."
  ]
 ],
