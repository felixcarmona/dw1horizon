 "s103.sec5.m0.o0": "Auf einem Trainingsplatz",
 "s103.sec5.m0.o1": "In der Arena vielleicht",
 "s103.sec5.u0": [
  [
   "Mir hier beim Training",
   "langweilig. Was tun?"
  ]
 ],
 "s103.sec5.u1": [
  [
   "Was tun, sagst du..."
  ]
 ],
 "s103.sec5.u2": "Wo du trainieren?",
 "s103.sec5.u3": [
  [
   "Auf einem Trainingsplatz, denke",
   "ich."
  ]
 ],
 "s103.sec5.u4": [
  [
   "Training langweilig. Ich in",
   "echten Kämpfen stark werden",
   "wollen."
  ]
 ],
 "s103.sec5.u5": [
  [
   "Training langweilig. Ich in",
   "echten Kämpfen stark werden",
   "wollen."
  ]
 ],
 "s103.sec5.u6": [
  [
   "Ich dorthin gehen. Ich",
   "trainieren."
  ]
 ],
 "s103.sec5.u7": "Kabuterimon ist in die Stadt gezogen!",
 "s103.sec6.u0": [
  [
   "Jedes Jahr, am Tag mit zwei",
   "Zweien, hier",
   "Insektenkampfturnier. Sieger"
  ],
  [
   "bekommt tollen Preis. Aber nur",
   "Insekten-Digimon dürfen",
   "teilnehmen."
  ]
 ],
 "s103.sec6.u1": [
  [
   "Kabuterimon, Kuwagamon,",
   "Kunemon und noch eine",
   "Insektenart. Aber nicht"
  ],
  [
   "Numemon. Jedes Jahr, am Tag",
   "mit zwei Zweien, hier",
   "Insektenkampfturnier... Hm? Du"
  ],
  [
   "Turnier schon gewonnen."
  ]
 ],
 "s103.sec6.u2": [
  [
   "Kabuterimon, Kuwagamon,",
   "Kunemon und noch ein Insekt:",
   "HerculesKabuterimon. Hercules"
  ],
  [
   "superstark. Turniersieger",
   "bekommt Item, das zu Hercules",
   "macht. Du oft am"
  ],
  [
   "Insektenturnier teilnehmen",
   "können."
  ]
 ],
 "s103.sec7.m0.o0": "Na klar!",
 "s103.sec7.m0.o1": "Nein, danke",
 "s103.sec7.u0": [
  [
   "Du stark. Ich dir nichts",
   "beibringen können."
  ]
 ],
 "s103.sec7.u1": [
  [
   "Wir Techniken studieren.",
   "Starke Techniken schwer zu",
   "lernen. Wenn du fähig,"
  ],
  [
   "vielleicht Technik lernen. Du",
   "starke Technik wollen?"
  ]
 ],
 "s103.sec7.u2": [
  [
   "Dann wir versuchen."
  ]
 ],
 "s103.sec7.u3": [
  [
   "Du nicht genug Abwehr. Mehr",
   "trainieren."
  ]
 ],
 "s103.sec7.u4": [
  [
