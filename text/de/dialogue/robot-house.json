{
 "s140.sec5.m0.o0": "Ja",
 "s140.sec5.m0.o1": "Nein",
 "s140.sec5.u0": [
  [
   "Was zum...?!"
  ]
 ],
 "s140.sec5.u1": [
  [
   "Ah, Willkommen zu Hause,",
   "Hagurumon!"
  ]
 ],
 "s140.sec5.u2": [
  [
   "Hagurumon!?"
  ]
 ],
 "s140.sec5.u3": [
  [
   "Was ist los!?"
  ]
 ],
 "s140.sec5.u4": [
  [
   "{color 7}Spielzeuge {color 1}",
   "«Dies ist eine Geschichte aus",
   "alter Zeit. Ein Bösewicht kam",
   "von weit her auf diese Insel.»"
  ]
 ],
 "s140.sec5.u5": [
  [
   "{color 7}Spielzeuge {color 1}",
   "«Der Bösewicht sagte den",
   "Digimon: Diese Insel gehört",
   "mir.»"
  ]
 ],
 "s140.sec5.u6": [
  [
   "{color 7}Spielzeuge {color 1}",
   "«Die Digimon sagten ihm: Das",
   "stimmt nicht. Diese Insel",
   "gehört allen.»"
  ]
 ],
 "s140.sec5.u7": [
  [
   "{color 7}Spielzeuge {color 1}",
   "«Sie forderten ihn zum Kampf",
   "heraus. Alle Digimon hielten",
   "zusammen und der Bösewicht"
  ],
  [
   "{color 7}Spielzeuge {color 1}",
   "wurde bestraft.»"
  ]
 ],
 "s140.sec5.u8": [
  [
   "{color 7}Spielzeuge {color 1}",
   "«Aber der Bösewicht sagte:",
   "Wartet nur! Dann ging er",
   "irgendwohin fort.»"
  ]
 ],
 "s140.sec5.u9": [
  [
   "{color 7}Spielzeuge {color 1}",
   "«Dies ist eine Geschichte aus",
   "alter Zeit.»"
  ]
 ],
 "s140.sec5.u10": [
  [
   "Juhu... Ich bin ganz",
   "glücklich... Halt, nein! Das",
   "Lied handelte doch von der"
  ],
  [
   "Vergangenheit dieser Insel?",
   "Davon, wie die Digimon vor",
   "langer Zeit einen Bösewicht"
  ],
  [
   "besiegten... Hm... Ein",
   "Bösewicht... Wer das wohl war?"
  ]
 ],
 "s140.sec5.u11": [
  [
   "Danke, dass du uns gerettet",
   "hast. Das ist ein",
   "Dankeschön-Geschenk."
  ]
 ],
 "s140.sec5.u12": "Der Plüsch-Monzaemon ist in die Stadt gezogen!",
 "s140.sec5.u13": [
  [
   "He, hat WaruMonzaemon nicht",
   "etwas fallen lassen?"
  ]
 ],
 "s140.sec5.u14": [
  [
   "Viel Glück! Es ist das Haus",
   "nebenan!"
  ]
 ],
 "s140.sec5.u15": [
  [
   "......"
  ]
 ],
 "s140.sec5.u16": [
  [
   "Willst du unseren Chor noch",
   "einmal hören?"
  ]
 ],
 "s140.sec5.u17": [
  [
   "Ah, Monzaemon! Du bist wieder",
   "zum Leben zurückgekehrt!"
  ]
 ],
 "s140.sec5.u18": [
  [
   "Oh, was ist das?"
  ]
 ],
 "s140.sec5.u19": [
  [
   "Besiege schnell WaruMonzaemon!",
   "Alle bewegen sich nicht mehr!",
   "Schnell, schnell!"
  ]
 ],
 "s140.sec5.u20": [
  [
   "M-moment mal! Das ist nicht",
   "der Monzaemon, den du kennst."
  ]
 ],
 "s140.sec5.u21": [
  [
   "Hä? Oje. Aber er ist trotzdem",
   "ein Monzaemon, oder?"
  ]
 ],
 "s140.sec5.u22": [
  [
   "Na ja... ein Monzaemon ist er",
   "schon."
  ]
 ],
 "s140.sec5.u23": [
  [
   "Dann bitte! Ein seeehr böser",
   "Kerl namens WaruMonzaemon hat",
   "meinen Freund entführt."
  ]
 ],
 "s140.sec5.u24": [
  [
   "Monzaemon ist wohl der Einzige,",
   "der ihn besiegen kann!"
  ]
 ],
 "s140.sec5.u25": [
  [
   "Hm... Das kann ich nicht",
   "durchgehen lassen. Gut, wo ist",
   "er?"
  ]
 ],
 "s140.sec5.u26": [
  [
   "Er ist im Haus nebenan. Ich",
   "breche das Siegel an der Tür.",
   "Geh und sieh nach!"
  ]
 ],
 "s140.sec5.u27": [
  [
   "Verstanden. Gut, wir helfen",
   "dir!"
  ]
 ],
