 "s177.sec6.u0": [
  [
   "Dein bescheidener Diener weiß",
   "etwas über Items. Insgesamt",
   "gibt es 128 Arten, sagt man."
  ],
  [
   "Davon sind 32 Nahrung! Manche",
   "wachsen nur in einer einzigen",
   "Region. Sehr selten! Im Urwald"
  ],
  [
   "findet man etwa den Blauen",
   "Apfel. Solche Nahrung hat",
   "besondere Wirkungen. Überlege"
  ],
  [
   "gut, wann du sie isst!"
  ]
 ],
 "s177.sec6.u1": [
  [
   "Diesmal spricht dein",
   "bescheidener Diener über",
   "Digitationsitems. Sie lassen"
  ],
  [
   "ein Digimon digitieren. Es gibt",
   "alle möglichen, eines für jede",
   "Form, sagt man. Graue Krallen"
  ],
  [
   "ergeben zum Beispiel Greymon!",
   "Es sind legendäre Items;",
   "manche gibt es nur einmal auf"
  ],
  [
   "der Welt. Anders als bei",
   "normaler Digitation gibt es",
   "keinen Wertebonus und die"
  ],
  [
   "Stimmung sinkt. Kein gutes",
   "Geschäft! Aber sofort die",
   "gewünschte Form zu erhalten,"
  ],
  [
   "hat seinen Reiz. Achtung: Es",
   "geht nur vom Level direkt",
   "davor!"
  ]
 ]
