{
 "s158.sec5.u0": [
  [
   "Du hast überhaupt kein Talent!"
  ]
 ],
 "s158.sec6.u0": [
  [
   "Biepiié!"
  ]
 ],
 "s158.sec7.u0": [
  [
   "Baupi, Bosupi!"
  ]
 ],
 "s158.sec8.u0": [
  [
   "Bopiiiié!"
  ]
 ],
 "s158.sec9.u0": [
  [
   "Ist das wirklich alles, was du",
   "draufhast?"
  ]
 ],
 "s158.sec10.u0": [
  [
   "Wasch dir das Gesicht und",
   "versuch es noch mal!"
  ]
 ],
 "s159.sec6.m0.o0": "Tauschen",
 "s159.sec6.m0.o1": "Nicht tauschen",
 "s159.sec6.u0": [
  [
   "Hm, ich sammle Digimon-Karten.",
   "Ich möchte eine",
   "KingSukamon-Karte. Tauschst"
  ],
  [
   "du eine gegen eine",
   "Etemon-Karte?"
  ]
 ],
 "s159.sec6.u1": [
  [
   "Es tut mir leid, Ich habe",
   "keine."
  ]
 ],
 "s159.sec6.u2": [
  [
   "Puh, was für ein Gestank...",
   "Ist das eine Müllhalde? Die",
   "gibt es also auch in der"
  ],
  [
   "Digimon-Welt."
  ]
 ],
 "s159.sec6.u3": [
  [
   "Hm? Oh, willkommen. Neue",
   "Freunde sind uns immer",
   "willkommen, jawohl!"
  ]
 ],
 "s159.sec6.u4": [
  [
   "Ist das ein Dorf des",
   "Sukamon-Stammes?"
  ]
 ],
 "s159.sec6.u5": [
  [
   "Genau. Das ist das Paradies",
   "der Sukamon, das",
   "Staubkönigreich. Auch Seine"
  ],
  [
   "Majestät KingSukamon lebt",
   "hier."
  ]
 ],
 "s159.sec6.u6": [
  [
   "KingSukamon..."
  ]
 ],
 "s159.sec6.u7": [
  [
   "Seine Majestät ist erstaunlich.",
   "Widersetzt du dich ihm,",
   "verwandelt er dich in eine"
  ],
  [
   "andere Art!"
  ]
 ],
 "s159.sec6.u8": [
  [
   "Was?! Dann wärst du kein",
   "Sukamon mehr? Das heißt... er",
   "kann dich zurückverwandeln?!"
  ]
 ],
 "s159.sec6.u9": [
  [
   "Ja... Mmm, Das ist eine",
   "beängstigende Geschichte.",
   "Schrecklich."
  ]
 ],
 "s159.sec6.u10": [
  [
   "Gut zu wissen!"
  ]
 ],
 "s159.sec6.u11": [
  [
   "Hä, ein Sukamon?!"
  ]
 ],
 "s159.sec6.u12": [
  [
   "Hm? Weißt du, wer ich bin?"
  ]
 ],
 "s159.sec6.u13": [
  [
   "N-na ja, so ungefähr. Hm,",
   "müssen wir Sukamon auch in die",
   "Stadt holen...?"
  ]
 ],
 "s159.sec6.u14": [
  [
   "Hm? So etwas sieht man selten,",
   "jawohl!"
  ]
 ],
 "s159.sec6.u15": [
  [
   "Igitt, der Kothaufen bewegt",
   "sich und spricht!"
  ]
 ],
 "s159.sec6.u16": [
  [
   "Hm? Meinst du mich? Ich bin",
   "Sukamon, ein Mutanten-Digimon."
  ]
 ],
 "s159.sec6.u17": [
  [
   "Du bist also kein Kot?"
  ]
 ],
 "s159.sec6.u18": [
  [
   "In gewisser Weise stimmt das.",
   "Wir bestehen aus Resten",
   "digitaler Daten."
  ]
 ],
 "s159.sec6.u19": [
  [
   "Hm... Sollten wir den auch in",
   "die Stadt einladen? Na ja, man",
   "sollte niemanden ausgrenzen."
  ]
 ],
 "s159.sec6.u20": [
  [
   "Wollt ihr hier wohnen?"
  ]
 ],
 "s159.sec6.u21": [
  [
   "Hä? Das ist mir nicht mal in",
   "den Sinn gekommen."
  ]
 ],
 "s159.sec6.u22": [
  [
   "Hm, dieses Paradies ist nur für",
   "den Sukamon-Stamm. Tut mir",
   "leid, andere Arten dürfen hier"
  ],
  [
   "nicht wohnen, jawohl."
  ]
 ],
 "s159.sec6.u23": [
  [
   "Dann könnt ihr also nirgendwo",
   "anders wohnen?"
  ]
 ],
 "s159.sec6.u24": [
  [
   "Natürlich!"
  ]
 ],
 "s159.sec6.u25": [
  [
   "Ach so, dachte ich mir... Puh."
  ]
 ],
 "s159.sec6.u26": [
  [
   "Hm? Ihr dürft hier nicht",
   "wohnen, aber seht euch ruhig",
   "um, verehrte Gäste, jawohl."
  ]
 ],
 "s159.sec6.u27": [
  [
   "Ach, äh, ja. Wir schauen nur."
  ]
 ],
 "s159.sec6.u28": [
  [
   "Ach, verärgert Seine Majestät",
   "nicht. Wenn sein Zauber euch",
   "in etwas Erbärmliches"
  ],
  [
   "verwandelt, gebt mir nicht die",
   "Schuld, jawohl!"
  ]
 ],
 "s159.sec6.u29": [
  [
   "He, he, du hast zu viele",
   "Etemon-Karten! Lieber nicht."
  ]
 ],
 "s159.sec6.u30": [
  [
   "Oh, Vielen Dank!"
  ]
 ],
 "s159.sec7.u0": [
  [
   "Hm, sagt mal, ihr kommt doch",
   "aus dieser Stadt oder so?",
   "Unter uns, ich bin etwas"
  ],
  [
   "neugierig darauf. Ich schaue",
   "eines Tages vorbei."
  ]
 ],
 "s159.sec7.u1": [
  [
   "Hm, sagt mal. Kennt ihr das",
   "besondere Talent der Sukamon?",
   "Wir nehmen den Kot am"
  ],
  [
   "Wegesrand in unsere Körper",
   "auf und wandeln ihn in Energie",
   "um!"
  ]
 ],
 "s159.sec8.u0": [
  [
   "Hm? Das ist das",
   "Staubkönigreich. Für euch",
   "bestimmt nur ein Müllhaufen."
  ],
  [
   "Aber hier liegen vielleicht",
   "nützliche Dinge herum. Da",
   "drüben sah ich etwas wie eine"
  ],
  [
   "lange Stange, jawohl."
  ]
 ],
 "s159.sec51.u0": [
  [
   "He, eine {color 6}Alte Angel{color 1}!"
  ]
 ],
 "s159.sec81.m0.o0": "Wir wollen hier wohnen",
 "s159.sec81.m0.o1": "Mach es wieder normal!",
 "s159.sec81.u0": [
  [
   "Hmpf! Ihr schon wieder!",
   "Verschwindet!"
  ]
 ],
 "s159.sec81.u1": [
  [
   "Ähm..."
  ]
 ],
 "s159.sec81.u2": [
  [
   "Pah, seid ihr hartnäckig! Da!",
   "Zufrieden?"
  ]
 ],
 "s159.sec81.u3": [
  [
   "Hmpf! Ihr schon wieder!",
   "Verschwindet!"
  ]
 ],
 "s159.sec81.u4": [
  [
   "Hm! Willkommen, mein",
   "Sukamon-Bruder. Wenn du hier",
   "leben willst, erteile ich dir"
  ],
  [
   "die Erlaubnis."
  ]
 ],
 "s159.sec81.u5": [
  [
   "Hm! Sehr gut, sehr gut. Hm?",
   "Nicht du, analoges Wesen."
  ]
 ],
 "s159.sec81.u6": [
  [
   "Wir müssen zusammen sein!"
  ]
 ],
 "s159.sec81.u7": [
  [
   "Hmpf, dann verschwindet eben",
   "gemeinsam!"
  ]
 ],
 "s159.sec81.u8": [
  [
   "Was? Was sagst du?"
  ]
 ],
 "s159.sec81.u9": [
  [
   "Er war ursprünglich kein",
   "Sukamon. König, verwandle ihn",
   "bitte zurück!"
  ]
 ],
 "s159.sec81.u10": [
  [
   "Aber ist das nicht wunderbar?",
   "Er durfte ein Sukamon werden."
  ]
 ],
 "s159.sec81.u11": [
  [
   "Nein, im Moment ist das eher",
   "ein Problem. Bitte!"
  ]
 ],
 "s159.sec81.u12": [
  [
   "Wenn ihr glaubt, man wird",
   "einfach so ein Sukamon, irrt",
   "ihr euch gewaltig! Nur wer sich"
  ],
  [
   "anstrengt, kann Sukamon",
   "werden!"
  ]
 ],
 "s159.sec81.u13": [
  [
   "Er ist eben einfach so ein",
   "Sukamon geworden. Das ist ja",
   "das Problem..."
  ]
 ],
 "s159.sec81.u14": [
  [
   "Hmpf, euch ist nicht zu helfen!",
   "Genug! Das passt zu euch!"
  ]
 ],
 "s159.sec81.u15": [
  [
   "Wow, danke, König!"
  ]
 ],
 "s159.sec81.u16": [
  [
   "Und jetzt verschwindet!"
  ]
 ],
 "s159.sec81.u17": [
  [
   "Hmpf, was wollt ihr von mir?"
  ]
 ],
 "s159.sec81.u18": [
  [
   "Ähm..."
  ]
 ],
 "s159.sec81.u19": [
  [
   "Hmpf, ich höre mir keine Bitten",
   "an. Ich bin der König der",
   "Sukamon und nur der Sukamon!"
  ]
 ],
 "s159.sec81.u20": [
  [
   "Dann kann ich ihn wohl nicht in",
   "die Stadt einladen..."
  ]
 ],
