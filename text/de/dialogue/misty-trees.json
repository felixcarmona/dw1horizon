 "s115.sec51.u0": [
  [
   "Hoho. Willkommen, willkommen,",
   "junger Mann."
  ]
 ],
 "s115.sec51.u1": "Du bist Cherrymon, oder?",
 "s115.sec51.u2": [
  [
   "Wer ist da?"
  ]
 ],
 "s115.sec51.u3": [
  [
   "Was bringt dich zu diesem alten",
   "Mann?"
  ]
 ],
 "s115.sec51.u4": [
  [
   "Lichte zuerst den Nebel."
  ]
 ],
 "s115.sec51.u5": [
  [
   "Ich sehe nichts in diesem",
   "Nebel. Kannst du zuerst etwas",
   "dagegen tun?"
  ]
 ],
 "s115.sec51.u6": [
  [
   "Hoho. So ist das also. Wie ich",
   "dachte."
  ]
 ],
 "s115.sec51.u7": [
  [
   "...Kannst du nicht?"
  ]
 ],
 "s115.sec51.u8": [
  [
   "Zuerst musst du hören, was ich",
   "zu sagen habe. Nun... wo fange",
   "ich an?"
  ]
 ],
 "s115.sec51.u9": [
  [
   "Wenn du etwas über die",
   "Unruhen auf der Insel weißt,",
   "erzähl es mir bitte."
  ]
 ],
 "s115.sec51.u10": [
  [
   "Hm. Ja, ja. Die Unruhen."
  ]
 ],
 "s115.sec51.u11": [
  [
   "Auf der Insel ging vor etwa 80",
   "Jahren alles schief. Es begann",
   "damit, dass sich das Land"
  ],
  [
   "veränderte. Frostland, das",
   "Herrenhaus des Grauen Lords,",
   "die Große Schlucht... Die"
  ],
  [
   "Länder im Nordosten tauchten",
   "plötzlich auf, vor etwa 80",
   "Jahren. Danach zogen die"
  ],
  [
   "Digimon nach und nach in die",
   "Gebiete, die zu ihnen passten.",
   "Die Arten verstreuten sich."
  ],
  [
   "Die Digimon, die einst alle",
   "dieselbe Sprache sprachen,",
   "begannen, eigene Sprachen zu"
  ],
  [
   "sprechen."
  ]
 ],
 "s115.sec51.u12": [
  [
   "Sie vergaßen die Sprache der",
   "Stadt... So verlor File City,",
   "wo einst viele Arten"
  ],
  [
   "zusammenlebten, die meisten",
   "Digimon und verfiel. Dann",
   "geschah etwas Furchtbares:"
  ],
  [
   "Die Digimon verloren ihre",
   "Erinnerungen! Ihre",
   "Vergangenheit, die der Insel,"
  ],
  [
   "ihren Verstand... Selbst ich",
   "kann mich an etwas Wichtiges",
   "nicht erinnern... etwas, das"
  ],
  [
   "ich dir sagen muss."
  ]
 ],
 "s115.sec51.u13": [
  [
   "Doch am Ende hängt alles",
   "zusammen. Jemand hat all das",
   "verursacht! Damit alles nach"
  ],
  [
   "seinem Willen läuft... Bald",
   "werden die Digimon das Seltsame",
   "nicht mehr seltsam finden,"
  ],
  [
   "fürchte ich. Nur die Bindung",
   "zwischen dir und File City kann",
   "das verhindern! Sammle Digimon"
  ],
  [
   "in der Stadt und bewirke ein",
   "Wunder. Es wird gewiss",
   "geschehen. Alle zählen auf"
  ],
  [
   "dich!!! ...Oje, ich habe mich",
   "hinreißen lassen. Puh... Das",
   "ist alles, was ich zu sagen"
  ],
  [
   "habe..."
  ]
 ],
 "s115.sec51.u14": [
  [
   "Nun denn, lichten wir den",
   "Nebel."
  ]
 ],
 "s115.sec51.u15": [
  [
   "Ich habe den Wald mit Nebel",
   "geschützt, damit ich dir meine",
   "Geschichte erzählen kann... Und"
  ],
  [
   "noch etwas."
  ]
 ],
 "s115.sec51.u16": [
  [
   "Andere in diesem Wald kennen",
   "ebenfalls die Vergangenheit.",
   "Geh weiter hinein. Hohoho..."
  ]
 ],
