{
 "s160.sec5.u0": [
  [
   "Überlass es miiir!"
  ]
 ],
 "s160.sec6.u0": [
  [
   "Zuerst musst du mich schlagen!"
  ]
 ],
 "s160.sec7.u0": [
  [
   "Befehle. Darf nicht",
   "widersprechen."
  ]
 ],
 "s160.sec8.u0": [
  [
   "Uoooooooh!"
  ]
 ],
 "s160.sec9.u0": [
  [
   "Geh zurück."
  ]
 ],
 "s161.sec5.u0": [
  [
   "Ich muss dich führen!"
  ]
 ],
 "s161.sec6.u0": [
  [
   "Nun bereue deine Sünden."
  ]
 ],
 "s161.sec7.u0": [
  [
   "Du hast es also endlich bis",
   "hierher geschafft!"
  ]
 ],
 "s161.sec8.u0": [
  [
   "Tu, was ich sage."
  ]
 ],
 "s161.sec9.u0": [
  [
   "Du kommst nicht durch, selbst",
   "wenn es mein Leben kostet!"
  ]
 ],
 "s170.sec5.u0": [
  [
   "Nein. Halt."
  ]
 ],
 "s170.sec6.u0": [
  [
   "So wollen es die Götter..."
  ]
 ],
 "s170.sec7.u0": [
  [
   "Ich halte hier Wache."
  ]
 ],
 "s170.sec8.u0": [
  [
   "Glaubst duuu an die Götter?"
  ]
 ],
 "s170.sec9.u0": [
  [
   "Keine Gewalt! Die Gewalt ist",
   "schlecht!"
  ]
 ],
 "s172.sec5.u0": [
  [
   "Überlass alles miiir!"
  ]
 ],
 "s172.sec6.u0": [
  [
   "Hau ab!"
  ]
 ],
 "s172.sec7.u0": [
  [
   "Als ob du mich aufhalten",
   "könntest!"
  ]
 ],
 "s172.sec8.u0": [
  [
   "Na dann, komm nur!"
  ]
 ],
 "s172.sec9.u0": [
  [
   "Komm, schlag mit allem zu, was",
   "du hast!"
  ]
 ],
 "s179.sec5.u0": [
  [
   "Greif mich mit voller Kraft an!"
  ]
 ],
 "s179.sec6.u0": [
  [
   "Durchlassen, Ärger bekommen."
  ]
 ],
 "s179.sec7.u0": [
  [
   "Letzter Job heute."
  ]
 ],
 "s182.sec53.u0": [
  [
   "So... du hast es endlich bis",
   "hierher geschafft."
  ]
 ],
 "s182.sec53.u1": [
  [
   "Bist du der Oberboss?!"
  ]
 ],
 "s182.sec53.u2": [
  [
   "Es tut mir leid, , aber nein.",
   "Ich bin MetalGreymon!"
  ]
 ],
 "s182.sec53.u3": [
  [
   "Um dich kümmere ich mich",
   "später! Aus dem Weg!"
  ]
 ],
 "s182.sec53.u4": [
  [
   "Das geht nicht. Meine Aufgabe",
   "ist es, dich am Weitergehen zu",
   "hindern."
  ]
 ],
 "s182.sec53.u5": [
  [
   "Ugh... Ich wollte unsere",
   "Kräfte schonen, aber der lässt",
   "mich nicht..."
  ]
 ],
 "s182.sec53.u6": [
  [
   "Ich komme!"
  ]
 ],
 "s182.sec53.u7": [
  [
   "Ugh... Hm... Wo bin ich...?"
  ]
 ],
 "s182.sec53.u8": [
  [
   "Du bist wieder bei Sinnen!"
  ]
 ],
 "s182.sec53.u9": [
  [
   "Scheint so... He... Wenn du ihn",
   "besiegst, sehen wir uns",
   "vielleicht eines Tages wieder."
  ],
  [
   "Bis dahin gehe ich."
  ]
 ],
 "s184.sec51.u0": [
  [
   "!!!"
  ]
 ],
 "s184.sec51.u1": [
  [
   "Ein Ei! Sag bloß, es ist von",
   "Machinedramon..."
  ]
 ],
 "s184.sec51.u2": [
  [
   "Oh! Ist das schlimm?!"
  ]
 ],
 "s184.sec51.u3": "Digitamamon ist in die Stadt gezogen!",
 "s184.sec51.u4": [
  [
   "!!!"
  ]
 ],
 "s184.sec51.u5": [
  [
   "D-da! Ich habe dich gefunden!"
  ]
 ],
 "s184.sec51.u6": [
  [
   "Du bist also der Oberboss?!"
  ]
 ],
 "s184.sec51.u7": [
  [
   "Hehehe... Schön, dich endlich",
   "kennenzulernen. Ich bin",
   "Analogman."
  ]
 ],
 "s184.sec51.u8": [
  [
   "Ich weiß alles über dich... Hm,",
   "aus der Nähe bist du wirklich",
   "nur ein Balg. Dass so ein Balg"
  ],
  [
   "meine Pläne durchkreuzt... Die",
   "Netzwelt gehörte schon fast",
   "mir..."
  ]
 ],
 "s184.sec51.u9": [
  [
   "He, du... du bist doch ein",
   "erwachsener Mensch? Was für",
   "Pläne? Das ist doch dumm. Du"
  ],
  [
   "machst allen Ärger!"
  ]
 ],
 "s184.sec51.u10": [
  [
   "Ärger? Für die Digimon?",
   "Hehehehe..."
  ]
 ],
 "s184.sec51.u11": [
  [
   "Digimon müssen nur tun, was",
   "Menschen ihnen sagen. Ganz",
   "nach meinem Willen... wie"
  ],
  [
   "Werkzeuge!"
  ]
 ],
 "s184.sec51.u12": [
  [
   "Du irrst dich! Auch Digimon",
   "haben ein Herz! Sie sind alle",
   "unsere Freunde!"
  ]
 ],
 "s184.sec51.u13": [
  [
   "Hmpf. Dann sehen wir, was",
   "besser ist: deine Freunde oder",
   "meine Werkzeuge!"
  ]
 ],
 "s184.sec51.u14": [
  [
   "Du bist dran! Der ultimative,",
   "stärkste Digimon...",
   "Machinedramon!"
  ]
 ],
 "s184.sec51.u15": [
  [
   "Wir haben es geschafft,",
   "{color 10}{partner}{color 1}! Wir haben es",
   "geschafft!"
  ]
 ],
 "s184.sec51.u16": [
  [
   "Un... unmöglich! Meine stärkste",
   "Waffe!"
  ]
 ],
 "s184.sec51.u17": [
  [
   "Siehst du? Du warst derjenige,",
   "der sich geirrt hat."
  ]
 ],
 "s184.sec51.u18": [
  [
   ". . ohhh. . . ."
  ]
 ],
 "s184.sec51.u19": [
  [
   "...Hör zu. Bring die Insel",
   "wieder in Ordnung und",
   "entschuldige dich bei allen in"
  ],
  [
   "der Stadt. Dann vergebe ich",
   "dir. Die anderen bestimmt",
   "auch..."
  ]
 ],
 "s184.sec51.u20": [
  [
   "He... hehe... Genau. Auf",
   "Digimon ist kein Verlass... Ich",
   "kann nur meiner eigenen Kraft"
  ],
  [
   "vertrauen..."
  ]
 ],
 "s184.sec51.u21": [
  [
   "Hey! Was machst du da!?"
  ]
 ],
 "s184.sec51.u22": [
  [
   "{color 7}Analogman {color 1}",
   "Ich sprenge diesen Ort in die",
   "Luft und fliehe in eine andere",
   "Welt... Pech für dich, Balg!"
  ]
 ],
 "s184.sec51.u23": [
  [
   "Oh nein, das darf er nicht!"
  ]
 ],
 "s184.sec51.u24": [
  [
   "{color 7}Analogman {color 1}",
   "He, hahaha! Lebt wohl!"
  ]
 ],
 "s184.sec51.u25": [
  [
   "Mist! Es tut mir leid, alle",
   "zusammen..."
  ]
 ],
 "s184.sec51.u26": [
  [
   "{color 7}??? {color 1}",
   "Das ist okay."
  ]
 ],
 "s184.sec51.u27": [
  [
   "Hä...?"
  ]
 ],
 "s184.sec51.u28": [
  [
   "{color 7}Analogman {color 1}",
   "Was...? Der Transfer startet",
   "nicht... E-etwas stimmt",
   "nicht... das Programm... Was"
  ],
  [
   "{color 7}Analogman {color 1}",
   "ist das?!"
  ]
 ],
 "s184.sec51.u29": [
  [
   "Ich höre... die Stimmen von",
   "allen...!"
  ]
 ],
 "s184.sec51.u30": [
  [
   "{color 7}Jijimon {color 1}",
   "Wir schicken euch jetzt unsere",
   "Kraft."
  ]
 ],
 "s184.sec51.u31": [
  [
   "{color 7}Tokomon {color 1}",
   "Könnt ihr uns hören?"
  ]
 ],
 "s184.sec51.u32": [
  [
   "{color 7}Agumon {color 1}",
   "Wir sind gerade noch",
   "rechtzeitig gekommen!"
  ]
 ],
 "s184.sec51.u33": [
  [
   "Alle..."
  ]
 ],
 "s184.sec51.u34": [
  [
   "{color 7}Analogman {color 1}",
   "Unmöglich... So geht das...",
   "Nein... H-helft mir... Ugh...",
   "Aaaaaaaaaaah!!!"
  ]
 ],
 "s184.sec51.u35": [
  [
   "Er ist verschwunden?! Was ist",
   "mit ihm passiert?"
  ]
 ],
 "s184.sec51.u36": [
  [
   "{color 7} Jijimon {color 1}",
   "Ich weiß es nicht. Aber",
   "trotzdem..."
  ]
 ],
 "s184.sec51.u37": [
  [
   "Ach ja! Jijimon, hörst du mich?",
   "Dieser Ort fliegt gleich in die",
   "Luft! Tu etwas!!!"
  ]
 ],
 "s184.sec51.u38": [
  [
   "{color 7}Jijimon {color 1}",
   "Hm. Er müsste jetzt dort sein,",
   "oder?"
  ]
 ],
 "s184.sec51.u39": [
  [
   "Airdramon!!!"
  ]
 ],
 "s184.sec51.u40": [
  [
   "Schnell, steigt auf!"
  ]
 ],
 "s184.sec51.u41": [
  [
   "Analogman war verschwunden..."
  ]
 ],
 "s184.sec51.u42": [
  [
   "Auf File Island kehrte Frieden",
   "ein..."
  ]
 ],
 "s184.sec51.u43": [
  [
   "Und dann..."
  ]
 ]
}
