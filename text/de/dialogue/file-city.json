  ]
 ],
 "s163.sec6.u3": [
  [
   "He, liest du meine Zeitung?"
  ]
 ],
 "s163.sec7.u0": [
  [
   "Aaah. Schön kühl. An einem",
   "gemütlichen Ort steigt auch die",
   "Stimmung, oder?"
  ]
 ],
 "s163.sec7.u1": [
  [
   "Hihi, na? Wie gefällt dir mein",
   "Laden? Verkaufen kann ich",
   "nicht so gut, aber gerade"
  ],
  [
   "macht es sonst niemand! Bring",
   "schnell viele Digimon hierher,",
