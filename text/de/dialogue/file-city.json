 "s192.sec51.u0": [
  [
   "Also... die Zeit ist endlich",
   "gekommen."
  ]
 ],
 "s192.sec51.u1": [
  [
   "Ja... Ehrlich gesagt würde ich",
   "gern für immer hierbleiben.",
   "Aber meine Mutter macht sich"
  ],
  [
   "Sorgen..."
  ]
 ],
 "s192.sec51.u2": [
  [
   "Alles, was ich dir sagen kann,",
   "{color 6}{player}{color 1}, ist danke. Ich",
   "hätte gern mehr für dich getan,"
  ],
  [
   "um es dir zu vergelten..."
  ]
 ],
 "s192.sec51.u3": [
  [
   "{color 7} Tokomon {color 1}",
   "Snif. . . Vergiss uns nicht,",
   "okay. . . ?"
  ]
 ],
 "s192.sec51.u4": [
  [
   "Eines Tages sehen wir uns",
   "wieder... Dieser Tag wird",
   "kommen... nicht wahr...?"
  ]
 ],
 "s192.sec51.u5": [
  [
   "...Leute, es war wirklich",
   "wunderschön hier. Danke."
  ]
 ],
 "s192.sec51.u6": [
  [
   "Nun, nun... bevor uns der",
   "Abschied noch schwerer fällt...",
   "beginnen wir mit der"
  ],
  [
   "Zeremonie..."
  ]
 ],
 "s192.sec51.u7": [
  [
   "{color 10}{partner}{color 1}, mein bester",
   "Freund... Unser Abenteuer war",
   "das beste aller Zeiten!!"
  ]
 ],
 "s193.sec54.u0": [
  [
   "Hm... kommt er zu sich? Es",
   "scheint geklappt zu haben!"
  ]
 ],
 "s193.sec54.u1": [
  [
   "Ein Mensch... genau wie Jiji",
   "sagte!"
  ]
 ],
 "s193.sec54.u2": [
  [
   "Mmmmmm. . ."
  ]
 ],
 "s193.sec54.u3": [
  [
   "Psst! Er wacht auf!"
  ]
 ],
 "s193.sec54.u4": [
  [
   "Hä...? Wo... bin ich?"
  ]
 ],
 "s193.sec54.u5": [
  [
   "Willkommen in der Digimon-Welt!"
  ]
 ],
 "s193.sec54.u6": [
  [
   "Huh?"
  ]
 ],
 "s193.sec54.u7": [
  [
   "Aaaaah! !"
  ]
 ],
 "s193.sec54.u8": [
  [
   "Huh? Was? Was ist los?"
  ]
 ],
 "s193.sec54.u9": [
  [
   "W-w-was seid ihr denn?!"
  ]
 ],
 "s193.sec54.u10": [
  [
   "Wir sind Digimon."
  ]
 ],
 "s193.sec54.u11": [
  [
   "Digimon?! Ihr meint..."
  ]
 ],
 "s193.sec54.u12": [
  [
   "Hm? Du kennst doch bestimmt",
   "Digimon...?"
  ]
 ],
 "s193.sec54.u13": [
  [
   "Hm? Aha, verstehe. Das ist ein",
   "Traum, oder? Ja, genau."
  ]
 ],
 "s193.sec54.u14": [
  [
   "Das ist kein Traum! Wir sind",
   "echt!"
  ]
 ],
 "s193.sec54.u15": [
  [
   "Oh, du bist Tokomon! Ihr seid",
   "also wirklich Digimon. Was für",
   "ein realistischer Traum..."
  ]
 ],
 "s193.sec54.u16": [
  [
   "Ähem. Hör zu, {color 6}{player}{color 1}.",
   "Das ist kein Traum. Aber auch",
   "nicht ganz die Wirklichkeit..."
  ]
 ],
 "s193.sec54.u17": [
  [
   "Was redest du da? Woher",
   "kennst du dann meinen Namen?",
   "Und wer bist du überhaupt?"
  ]
 ],
 "s193.sec54.u18": [
  [
   "Ich bin Jijimon."
  ]
 ],
 "s193.sec54.u19": [
  [
   "Huh? Gab es jemals einen",
   "Digimon, der so genannt wurde?"
  ]
 ],
 "s193.sec54.u20": [
  [
   "Hehe. Die Digimon, die du",
   "kennst, sind längst nicht alle.",
   "Schließlich ist dies die"
  ],
  [
   "Digimon-Welt."
  ]
 ],
 "s193.sec54.u21": [
  [
   "Digimon... Welt..."
  ]
 ],
 "s193.sec54.u22": [
  [
   "Eine Welt, die weder Traum",
   "noch Realität ist. Die Welt von",
   "Digimon!"
  ]
 ],
 "s193.sec54.u23": [
  [
   "Na ja... Wenn du es so sagst...",
   "Für einen Traum ist es viel zu",
   "echt..."
  ]
 ],
 "s193.sec54.u24": [
  [
   "Sieh hinter dich. Dann wird es",
   "dir klar."
  ]
 ],
 "s193.sec54.u25": [
  [
   "Huh?"
  ]
 ],
 "s193.sec54.u26": [
  [
   "Unmöglich... Ist das",
   "{color 10}{partner}{color 1}, das Digimon, das",
   "ich aufgezogen habe?"
  ]
 ],
 "s193.sec54.u27": [
  [
   "Das ist es...! Ich wurde in",
   "meinen",
   "Digimon-Schlüsselanhänger"
  ],
  [
   "gesaugt..."
  ]
 ],
 "s193.sec54.u28": [
  [
   "Genau. Jetzt verstehst du."
  ]
 ],
 "s193.sec54.u29": [
  [
   "Ich verstehe, aber... warum bin",
   "ich... hier?"
  ]
 ],
 "s193.sec54.u30": [
  [
   "Hm... Nun, da du verstehst,",
   "komm zu uns nach Hause. Dort",
   "reden wir weiter."
  ]
 ],
 "s193.sec55.u0": [
  [
   "Nun, wo war ich? Ich habe dich",
   "hergerufen. Du musst uns",
   "retten."
  ]
 ],
 "s193.sec55.u1": [
  [
   "Euch retten?? Warum? Stimmt",
   "etwas nicht?"
  ]
 ],
 "s193.sec55.u2": [
  [
   "Wir sind in File City, mitten",
   "auf einer Insel namens File",
   "Island."
  ]
 ],
 "s193.sec55.u3": [
  [
   "Eine Stadt? Das hier? Ziemlich",
   "klein und heruntergekommen."
  ]
 ],
 "s193.sec55.u4": [
  [
   "He... Nun, ich sollte wohl",
   "sagen, es WAR eine Stadt.",
   "Früher lebten hier Digimon"
  ],
  [
   "aller Art."
  ]
 ],
 "s193.sec55.u5": [
  [
   "Doch irgendwann verloren die",
   "Digimon ihr \"Herz\"... und",
   "zerstreuten sich außerhalb der"
  ],
  [
   "Stadt."
  ]
 ],
 "s193.sec55.u6": [
  [
   "Was meinst du damit?"
  ]
 ],
 "s193.sec55.u7": [
  [
   "Wir wissen nicht, warum... Die",
   "Digimon verlieren die Fähigkeit",
   "zu sprechen..."
  ]
 ],
 "s193.sec55.u8": [
  [
   "Manche können noch ein wenig",
   "sprechen... aber sie haben",
   "vergessen, dass sie in der"
  ],
  [
   "Stadt lebten."
  ]
 ],
 "s193.sec55.u9": [
  [
   "Verstehe. Das bedeutet es",
   "also, ihr \"Herz\" zu verlieren."
  ]
 ],
 "s193.sec55.u10": [
  [
   "Genau. Und das ist gefährlich.",
   "Laut der Legende sind alle",
   "Digimon in Gefahr, wenn File"
  ],
  [
   "City bedroht ist..."
  ]
 ],
 "s193.sec55.u11": [
  [
   "Aber warum ich? Könnte das",
   "nicht jeder sein?"
  ]
 ],
 "s193.sec55.u12": [
  [
   "Du kannst doch gut Digimon",
   "aufziehen, oder?"
  ]
 ],
 "s193.sec55.u13": [
  [
   "Hä? ...Ach ja. Darin bin ich",
   "großartig! Hehe."
  ]
 ],
 "s193.sec55.u14": [
  [
   "Hast du es nicht bemerkt? Du",
   "sprichst die Sprache der",
   "Digimon."
  ]
 ],
 "s193.sec55.u15": [
  [
   "Was? Ich bin mir ziemlich",
   "sicher, dass ich ganz normal",
   "Deutsch spreche."
  ]
 ],
 "s193.sec55.u16": [
  [
   "Für uns klingt es genau wie die",
   "Sprache der Digimon."
  ]
 ],
 "s193.sec55.u17": [
  [
   "Ja, Ja!"
  ]
 ],
 "s193.sec55.u18": [
  [
   "Die Liebe, die du in deiner",
   "Welt für Digimon empfindest,",
   "zeigt sich hier als echte"
  ],
  [
   "Kraft."
  ]
 ],
 "s193.sec55.u19": [
  [
   "O-oh... Du machst mich ganz",
   "verlegen."
  ]
 ],
 "s193.sec55.u20": [
  [
   "Darum habe ich dich ausgewählt.",
   "Du kannst die Digimon von ganz",
   "File Island hierher"
  ],
  [
   "zurückbringen!"
  ]
 ],
 "s193.sec55.u21": [
  [
   "Oh..."
  ]
 ],
 "s193.sec55.u22": [
  [
   "Ohh..."
  ]
 ],
 "s193.sec55.u23": [
  [
   "Ohhh! A-alles klar! Jetzt habe",
   "ich es endlich verstanden!",
   "Haha! Überlass das mir!"
  ]
 ],
 "s193.sec55.u24": [
  [
   "Jaaa! Hurra, hurra!"
  ]
 ],
 "s193.sec55.u25": [
  [
   "Hm, hm, danke. Ich weiß, die",
   "Bitte ist selbstsüchtig, aber",
   "du bist unsere letzte Hoffnung."
  ]
 ],
 "s193.sec55.u26": [
  [
   "Hehe. Also, was mache ich",
   "zuerst?"
  ]
 ],
 "s193.sec55.u27": [
  [
   "Von nun an wirst du mit deinem",
   "Partner {color 10}{partner}{color 1} gemeinsam",
   "File Island bereisen."
  ]
 ],
 "s193.sec55.u28": [
  [
   "Finde heraus, was",
   "dahintersteckt, und überrede",
   "die Digimon, in die Stadt"
  ],
  [
   "zurückzukehren."
  ]
 ],
 "s193.sec55.u29": [
  [
   "Gut, verstanden. Also looos,",
   "{color 10}{partner}{color 1}!"
  ]
 ],
 "s193.sec55.u30": [
  [
   "H-he, warte, ich bin noch nicht",
   "fertig..."
  ]
 ]
}
