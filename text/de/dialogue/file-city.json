{
 "s162.sec5.u0": [
  [
   "Hast du den Hüter des Sees",
   "schon getroffen? Wenn nicht,",
   "warte am Südufer gaaaanz"
  ],
  [
   "geduldig auf ihn!"
  ]
 ],
 "s162.sec5.u1": [
  [
   "Steh mal suuuperfrüh auf und",
   "wandere durch den Nebel. Dann",
   "passiert etwas Gutes!"
  ]
 ],
 "s162.sec5.u2": [
  [
   "He, weißt du was? Weit im",
   "Nooorden liegt der",
   "Eisbergstrand. Dort soll sich"
  ],
  [
   "in letzter Zeit oft ein",
   "riiiesiges Digimon zeigen."
  ]
 ],
 "s162.sec5.u3": [
  [
   "Hast du die Banditen schon",
   "besiegt? Sie sollen irgendwo",
   "noch ein Versteck haben."
  ]
 ],
 "s162.sec5.u4": [
  [
   "Warst du schon in der Großen",
   "Schlucht? Dort sollen Banditen",
   "auftauchen."
  ]
 ],
 "s162.sec5.u5": [
  [
   "Sind sie schlecht?"
  ]
 ],
 "s162.sec5.u6": [
  [
   "Wenn du durch die Schlucht",
   "gehst, umzingeln und berauben",
   "sie dich. Hoffentlich wird sie"
  ],
  [
   "jemand los."
  ]
 ],
 "s162.sec5.u7": [
  [
   "Hm. Das können wir wohl nicht",
   "einfach so hinnehmen."
  ]
 ],
 "s162.sec5.u8": [
  [
   "Warst du schon in der Großen",
   "Schlucht? Dort soll es eine",
   "unsichtbare Brücke geben."
  ]
 ],
 "s162.sec5.u9": [
  [
   "Machinedramon soll wieder zum",
   "Leben erwacht sein!"
  ]
 ],
 "s162.sec5.u10": [
  [
   "Du hast Machinedramon wieder",
   "besiegt? Uuunglaublich."
  ]
 ],
 "s162.sec5.u11": [
  [
   "Hehe, ich erzähle dir von der",
   "Umgebung. Um die Stadt liegt",
   "der Urwald. Die Digimon dort"
  ],
  [
   "sind nicht sehr stark. Gleich",
   "im Westen ist das Grüne Gym.",
   "Dort wirst du wohl oft"
  ],
  [
   "hingehen. Jenseits des Flusses",
   "im Osten liegt der Tropische",
   "Dschungel. Was dahinter ist,"
  ],
  [
   "weiß ich nicht. Im Westen",
   "versperren ein Berg und ein",
   "See den Weg, aber dahinter"
  ],
  [
   "könnte noch mehr Land liegen.",
   "Ganz im Süden ist das Meer.",
   "Im Norden steht ein seeehr"
  ],
  [
   "hoher Berg. Beides sind",
   "Sackgassen. Mehr weiß ich",
   "nicht. Aber die Stadt liegt in"
  ],
  [
   "der Mitte der Insel, also gibt",
   "es im Norden wohl noch mehr.",
   "Ich höre mich nach Gerüchten"
  ],
  [
   "von draußen um. Komm ab und",
   "zu vorbei und hör sie dir an."
  ]
 ],
 "s162.sec6.u0": [
  [
   "Mmm, ich wollte mal sehen, wie",
   "es hier so läuft, ja! Die",
   "Toilette mag ich nicht, aber"
  ],
  [
   "der Rest ist ziemlich gut, ja!"
  ]
 ],
 "s162.sec7.u0": [
  [
   "Hm... Hier scheint es... recht",
   "lebhaft zu sein. Ob ich nicht",
   "in die Fabrikstadt zurückkehren"
  ],
  [
   "sollte... fragst du? Meine",
   "Zeitplanung funktioniert",
   "normal. Es gibt kein Problem."
  ]
 ],
 "s162.sec8.u0": [
  [
   "Oh, du kommst genau richtig!",
   "Sieh dir diese Statue an! Hm?",
   "Na? Was für ein prächtiges"
  ],
  [
   "Kunstwerk... War von mir wohl",
   "zu erwarten. Hm? Was ist? Was",
   "hast du gesagt?! Waaas! Du"
  ],
  [
   "machst dich über mich lustig?!",
   "Also... worum ging es noch mal?",
   "Hm. Ach, egal."
  ]
 ],
 "s162.sec8.u1": [
  [
   "Hmmmm... Was habe ich mir",
   "bloß... vorgestellt... Haaah.",
   "Wenn du es herausfindest,"
  ],
  [
   "sagst du es mir?"
  ]
 ],
 "s162.sec55.m0.o0": "Zur Fabrikstadt",
 "s162.sec55.m0.o1": "Zur geheimen Strandhöhle",
 "s162.sec55.m0.o2": "Schon gut",
 "s162.sec55.u0": [
  [
   "Hallo! Haha, ich habe dich",
   "erschreckt, oder? Alle auf",
   "Seereisen mitzunehmen, das ist"
  ],
  [
   "mein Beruf. Wie wäre es mit",
   "dir? Ich kann dich an Orte",
   "bringen, die man nur übers"
  ],
  [
   "Meer erreicht. Also..."
  ]
 ],
 "s162.sec55.u1": [
  [
   "Hm, wohin soll es gehen? In die",
   "Fabrikstadt... oder in die",
   "geheime Strandhöhle?"
  ]
 ],
 "s162.sec57.u0": [
  [
   "Ich habe dich gefunden!"
  ]
 ],
 "s162.sec57.u1": [
  [
   "W-was? Er greift uns an?!"
  ]
 ],
 "s162.sec57.u2": [
  [
   "Endlich treffen wir uns! Ich",
   "bin Greymon, ein Wanderer.",
   "Kommen wir gleich zur Sache!"
  ]
 ],
 "s162.sec57.u3": "Was?!",
 "s162.sec57.u4": [
  [
   "Die Gerüchte über dich haben",
   "mich hergeführt. Du wirst gegen",
   "mich kämpfen! Und wenn ich"
  ],
  [
   "gewinne... gehört mir das",
   "Schild dieser Stadt!"
  ]
 ],
 "s162.sec57.u5": [
  [
   "Es gibt gar kein Schild."
  ]
 ],
 "s162.sec57.u6": [
  [
   "Egal! Kämpf gegen mich!"
  ]
 ],
 "s162.sec57.u7": [
  [
   "He, du machst es mir schwer...",
   "gar nicht schlecht. Aber du",
   "bist noch zu unerfahren, um"
  ],
  [
   "dein Ziel zu erreichen!"
  ]
 ],
 "s162.sec57.u8": [
  [
   "Hmpf..."
  ]
 ],
 "s162.sec57.u9": [
  [
   "Ich bleibe hier und mache dich",
   "fit. Du wirst noch viel, viel",
   "stärker werden!"
  ]
 ],
 "s162.sec57.u10": "Greymon ist in die Stadt gezogen!",
 "s162.sec57.u11": [
  [
   "Hehe, ich habe dich gefunden,",
   "{color 6}{player}{color 1}!"
  ]
 ],
 "s162.sec57.u12": [
  [
   "Ein Überraschungsangriff!?"
  ]
 ],
 "s162.sec57.u13": [
  [
   "Mein Ziel ist es, dich zu",
   "besiegen... und dafür ist mir",
   "jedes Mittel recht!"
  ]
 ],
 "s162.sec57.u14": [
  [
   "...Diese Augen! Jemand",
   "kontrolliert ihn!"
  ]
 ],
 "s162.sec57.u15": [
  [
   "Ngh... so... selbst um den",
   "Preis meines Lebens... sie",
   "besiegen... das waren... meine"
  ],
  [
   "Befehle..."
  ]
 ],
 "s162.sec57.u16": [
  [
   "Was redest du da? So stirbst",
   "du wirklich! Du brauchst",
   "Behandlung, schnell..."
  ]
 ],
 "s162.sec81.u0": "Zzz...",
 "s162.sec81.u1": [
  [
   "He, hast du gehört? Im",
