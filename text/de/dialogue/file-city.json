 "s163.sec9.m0.o0": [
  [
   "Worum geht es?"
  ]
 ],
 "s163.sec9.m0.o1": "Später, okay?",
 "s163.sec9.u0": [
  [
   "Hey, Hör mir eine Sekunde zu."
  ]
 ],
 "s163.sec9.u1": [
  [
   "Hast du die Brücke im Osten",
   "gesehen? Sie ist repariert! Wir",
   "haben hart gearbeitet."
  ]
 ],
 "s163.sec9.u2": [
  [
   "Wir reparieren die Digi-Brücke",
   "noch. Warte noch etwas, ja?",
   "Ach, im Süden am Coela-Kap"
  ],
  [
   "soll es ein seltenes Digimon",
   "geben. Jeden Abend soll es",
   "kurz den Kopf herausstrecken."
  ]
 ],
 "s163.sec9.u3": [
