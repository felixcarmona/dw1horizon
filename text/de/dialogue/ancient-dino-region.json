 ],
 "s076.sec51.u12": [
  [
   "Der andere Teil ist die Uralte",
   "Tempo-Region, ein gefährliches",
   "Gebiet hinter der Eisregion."
  ],
  [
   "Warum gefährlich? Die Zeit",
   "vergeht dort rasend schnell.",
   "Deshalb ist das Land"
