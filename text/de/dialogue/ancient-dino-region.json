 "s076.sec51.u4": [
  [
   "Warte... sagst du die Wahrheit?"
  ]
 ],
 "s076.sec51.u5": [
  [
   "Das habe ich dir gesagt!"
  ]
 ],
 "s076.sec51.u6": [
  [
   "He, tut mir leid. Fremde kommen",
   "selten hierher. Mein erster",
   "Einsatz seit Ewigkeiten, da"
  ],
  [
   "habe ich mich hinreißen lassen."
  ]
 ],
 "s076.sec51.u7": [
  [
   "Arbeit?"
