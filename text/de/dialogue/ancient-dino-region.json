   "den Weg."
  ]
 ],
 "s076.sec51.u15": [
  [
   "Aber du hast gerade gegen uns",
   "verloren."
  ]
 ],
 "s076.sec51.u16": [
  [
   "Argh... Das war Zufall! Sonst",
   "läuft es nicht so!"
  ]
 ],
 "s076.sec51.u17": [
  [
   "Wenn du meinst..."
