{
 "s049.sec81.m0.o0": "Ich werde es versuchen.",
 "s049.sec81.m0.o1": "Jetzt nicht",
 "s049.sec81.u0": [
  [
   "Willkommen... Oh? Dich habe ich",
   "hier noch nie gesehen. Kommst",
   "du von weit her?"
  ]
 ],
 "s049.sec81.u1": [
  [
   "Ich komme aus der Stadt. Nun,",
   "tatsächlich, aus einer anderen",
   "Welt."
  ]
 ],
 "s049.sec81.u2": [
  [
   "Du verstehst also, was ich",
   "sage."
  ]
 ],
 "s049.sec81.u3": [
  [
   "Klar... Oh, Moment, das ist ja",
   "nicht normal... Wie führst du",
   "einen Laden, wenn dich keiner"
  ],
  [
   "versteht?"
  ]
 ],
 "s049.sec81.u4": [
  [
   "Mit Erfahrung und Gesten.",
   "Aber manchmal ist es schwierig.",
   "Der Verkauf kommt einfach"
  ],
  [
   "nicht in Schwung..."
  ]
 ],
 "s049.sec81.u5": [
  [
   "Ach, verstehe."
  ]
 ],
 "s049.sec81.u6": [
  [
   "Das Geschäft läuft in letzter",
   "Zeit schleppend. Meine früheren",
   "Kunden kommen nicht mehr..."
  ]
 ],
 "s049.sec81.u7": [
  [
   "Das liegt bestimmt an den",
   "Unruhen auf der Insel..."
  ]
 ],
 "s049.sec81.u8": [
  [
   "Darum hätte ich gern deine",
   "Hilfe bei etwas."
  ]
 ],
 "s049.sec81.u9": [
  [
   "Worum geht es?"
  ]
 ],
 "s049.sec81.u10": [
  [
   "Möchtest du in meinem Laden",
   "arbeiten?"
  ]
 ],
 "s049.sec81.u11": [
  [
   "Hä? Im Laden?"
  ]
 ],
 "s049.sec81.u12": [
  [
   "Nur einen halben Tag. Dein",
   "Lohn steigt mit dem Umsatz.",
   "Du verstehst die Sprache, und"
  ],
  [
   "ich glaube, du hast ein",
   "Händchen dafür."
  ]
 ],
 "s049.sec81.u13": [
  [
   "Hm. Gib mir nicht die Schuld,",
   "wenn du Geld verlierst..."
  ]
 ],
 "s049.sec81.u14": [
  [
   "Keine Sorge. Ich lerne auf",
   "jeden Fall etwas daraus. Es",
   "dauert etwa acht Stunden."
  ],
  [
   "Machst du mit?"
  ]
 ],
 "s049.sec81.u15": [
  [
   "Verstehe... Da kann man nichts",
   "machen. Komm bitte wieder, wenn",
   "du Zeit hast."
  ]
 ],
 "s049.sec81.u16": [
  [
   "Oh, bist du bereit für den",
   "Aushilfsjob?"
  ]
 ],
 "s049.sec82.u0": [
  [
   "Gut, wir sind gerade über der",
   "Hälfte."
  ]
 ],
 "s049.sec82.u1": [
  [
   "Hm, wenn es so weitergeht...",
   "machen wir vielleicht keinen",
   "Gewinn. Bleib dran."
  ]
 ],
 "s049.sec82.u2": [
  [
   "Gut, die Verkäufe laufen recht",
   "ordentlich. Vielleicht machen",
   "wir doch noch Gewinn."
  ]
 ],
 "s049.sec82.u3": [
  [
   "Donnerwetter! So gute",
   "Verkäufe sind selten. Weiter so",
   "bis zum Schluss!"
  ]
 ],
 "s049.sec82.u4": [
  [
   "Okay, Es sieht so aus, als ob",
   "die Zeit abgelaufen ist."
  ]
 ],
 "s049.sec82.u5": [
  [
   "Hm, ich dachte, du würdest",
   "etwas besser abschneiden. Nun,",
   "manchmal hat man eben kein"
  ],
  [
   "Glück... Hilf mir bitte wieder."
  ]
 ],
 "s049.sec82.u6": [
  [
   "500 Bits erhalten!"
  ]
 ],
 "s049.sec82.u7": [
  [
   "Ja, die Verkäufe entsprechen",
   "meinen Erwartungen. Aber für",
   "jemanden mit deinem Können"
  ],
  [
   "reicht das noch nicht. Hilf mir",
   "bitte wieder."
  ]
 ],
 "s049.sec82.u8": [
  [
   "1500 Bits erhalten!"
  ]
 ],
 "s049.sec82.u9": [
  [
   "Was soll ich sagen: großartig!",
   "Dein Verstand, dein Elan und",
   "dein Charakter reichen aus, um"
  ],
  [
   "die Insel zu retten."
  ]
 ],
 "s049.sec82.u10": [
  [
   "Huh?"
  ]
 ],
 "s049.sec82.u11": [
  [
   "Verzeih mir. Ich habe dich",
   "geprüft, um zu sehen, ob du das",
   "Zeug hast, die Insel zu"
  ],
  [
   "retten. Stärke im Kampf ist",
   "natürlich wichtig."
  ]
 ],
 "s049.sec82.u12": [
  [
   "Aber ich dachte, Stärke allein",
   "würde die Insel nicht retten.",
   "Man braucht auch Verstand und"
  ],
  [
   "Mut."
  ]
 ],
 "s049.sec82.u13": [
  [
   "Tut mir leid, dass ich dir das",
   "verschwiegen habe."
  ]
 ],
 "s049.sec82.u14": [
  [
   "Und, haben wir bestanden?"
  ]
 ],
 "s049.sec82.u15": [
  [
   "Weit über meine Erwartungen",
   "hinaus. Von nun an helfe ich",
   "euch mit all meiner Kraft."
  ]
 ],
 "s049.sec82.u16": [
  [
   "Dann kommst du in die Stadt!",
   "Hm? Was wird aus dem Laden?"
  ]
 ],
 "s049.sec82.u17": [
  [
   "Einen Laden kann ich jederzeit",
   "eröffnen. Dieser hier hat",
   "seinen Zweck erfüllt."
  ]
 ],
 "s049.sec82.u18": [
  [
   "Monochromon ist in die Stadt",
   "gezogen! 2000 Bits erhalten!"
  ]
 ]
}
