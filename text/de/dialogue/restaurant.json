 "s174.sec81.u0": [
  [
   "Willkommen. Sieh her,",
   "{color 6}{player}{color 1}. Ich bin jetzt",
   "Besitzer und Küchenchef dieses"
  ],
  [
   "Restaurants. Lasst euch Zeit",
   "und genießt meine feurige",
   "Küche... Hehehe..."
  ]
 ],
 "s174.sec81.u1": [
  [
   "Hahaha! {color 6}{player}{color 1},",
   "{color 10}{partner}{color 1}, kommt und",
   "probiert meine Küche! Hätte"
  ],
  [
   "nie gedacht, dass mein",
   "verborgenes Talent mal nützlich",
   "wird. Das ist echtes Essen,"
  ],
  [
   "keine Items! Lasst es euch",
   "schmecken!"
  ]
 ],
 "s174.sec81.u2": [
  [
   "He, {color 6}{player}{color 1},",
   "{color 10}{partner}{color 1}! Ich verdiene",
   "mein Geld jetzt mit Kochen."
  ],
  [
   "Lasst euch von meinem",
   "Aussehen nicht täuschen, ich",
   "bin ein toller Koch."
  ],
  [
   "Reiseproviant wird doch",
   "langweilig, oder? Ab und zu in",
   "einem Restaurant zu essen ist"
  ],
  [
   "ein echter Genuss!"
  ]
 ],
 "s174.sec81.u3": [
  [
   "Hallooo! {color 6}{player}{color 1},",
