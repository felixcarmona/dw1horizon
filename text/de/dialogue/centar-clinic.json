{
 "s173.sec6.u0": [
  [
   "Nun... Häufige Ruhepausen",
   "gegen Müdigkeit sind das",
   "Geheimnis guter Gesundheit."
  ]
 ],
 "s173.sec6.u1": [
  [
   "Nun, soll ich dir erklären, wie",
   "der Wohlstand der Stadt",
   "wächst? Ein Rookie bringt 1"
  ],
  [
   "Punkt, ein Champion 2. Ein",
   "Ultra bringt 3, wie ich höre.",
   "Aber drei der weniger"
  ],
  [
   "nützlichen Champions bringen",
   "nur 1 Punkt."
  ]
 ],
 "s173.sec6.u2": [
  [
   "Nun, etwas über die Typen.",
   "Gegner vom selben Typ wie dein",
   "Partner schließen sich selten"
  ],
  [
   "einem Kampf an. Und an zwei",
   "Orten darfst du nur mit dem",
   "passenden Typ hinein."
  ],
  [
   "Ansonsten musst du dir kaum",
   "Gedanken darüber machen."
  ]
 ],
 "s173.sec6.u3": [
  [
   "Nun, soll ich dir vom",
   "Tamer-Level erzählen? Zuerst",
   "die Digitation: Ziehst du ein"
  ],
  [
   "Digimon bis zum Ultra-Level",
   "auf, steigt er sicher um eine",
   "Stufe. Ein Sieg in einem"
  ],
  [
   "hochklassigen Turnier hilft",
   "auch. Er steigt eigentlich von",
   "selbst. Aufpassen musst du,"
  ],
  [
   "dass er nicht sinkt. Wenn dir",
   "zum Beispiel alle Leben",
   "ausgehen, sinkt er garantiert."
  ],
  [
   "Selten können auch Fehler bei",
   "der täglichen Pflege ihn",
   "senken. Also immer gut"
  ],
  [
   "aufpassen, ja?"
  ]
 ]
}
