 ],
 "s065.sec51.u0": [
  [
   "Ich... werde... dich...",
   "töten...!"
  ]
 ],
 "s065.sec81.u0": [
  [
   "Agh, Eine schwarze Mauer! Ich",
   "bin getäuscht worden!"
  ]
 ],
 "s181.sec51.u0": [
  [
   "!"
  ]
 ],
 "s181.sec51.u1": [
