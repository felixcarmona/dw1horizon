{
 "s064.sec5.u0": [
  [
   "Wir treten wieder in der Arena",
   "an. Manche würden mich sicher",
   "vermissen. Hehe..."
  ]
 ],
 "s064.sec5.u1": [
  [
   "Meine Leute sind im Vergleich",
   "zu mir nachlässig. Darum nehme",
   "ich SkullGreymon mit in die"
  ],
  [
   "Arena."
  ]
 ],
 "s064.sec5.u2": [
  [
   "Und sei unbesorgt: Anders als",
   "früher gehorcht SkullGreymon",
   "nun."
  ]
 ],
 "s064.sec5.u3": [
  [
   "Myotismon, geht es dir gut?!"
  ]
 ],
 "s064.sec5.u4": [
  [
   "Ugh... uhh... Oh? Du bist es!",
   "Du kommst mir immer wieder zu",
   "Hilfe."
  ]
 ],
 "s064.sec5.u5": [
  [
   "Was ist passiert?"
  ]
 ],
 "s064.sec5.u6": [
  [
   "Hm... Sag mir, bist du Devimon",
   "begegnet?"
  ]
 ],
 "s064.sec5.u7": [
  [
   "Ja. Dieser üble Kerl."
  ]
 ],
 "s064.sec5.u8": [
  [
   "Er hat dunkle Energie in das",
   "Material geleitet, an dem ich",
   "forschte."
  ]
 ],
 "s064.sec5.u9": [
  [
   "Deine Forschung, du meinst",
   "SkullGreymon?! Das ist",
   "gefährlich..."
  ]
 ],
 "s064.sec5.u10": [
  [
   "Es war eher eine Sammlung als",
   "Forschung. Ich sammelte",
   "Knochen und setzte sie"
  ],
  [
   "zusammen... Ich habe meine",
   "Lektion gelernt."
  ]
 ],
 "s064.sec5.u11": [
  [
   "Aber Devimon ist hier der",
   "Böse."
  ]
 ],
 "s064.sec5.u12": [
  [
   "...In Wahrheit kenne ich ihn."
  ]
 ],
 "s064.sec5.u13": [
  [
   "Waaas?!"
  ]
 ],
 "s064.sec5.u14": [
  [
   "Er war schon immer",
   "verschlagen... aber so etwas",
   "hätte er nicht getan."
  ],
  [
   "Vielleicht wird er von jemandem",
   "kontrolliert."
  ]
 ],
 "s064.sec5.u15": [
  [
   "...So ist das also..."
  ]
 ],
 "s064.sec5.u16": [
  [
   "Wenn er wieder der Alte wird...",
   "denk daran, dass selbst er sich",
   "euch anschließen könnte."
  ]
 ],
 "s064.sec6.u0": [
  [
   "Bu!"
  ]
 ],
 "s064.sec6.u1": [
  [
   "......"
  ]
 ],
 "s064.sec81.u0": [
  [
   "Myotismon! Was ist denn",
   "passiert...?"
  ]
 ],
 "s065.sec6.u0": [
  [
   "........."
  ]
 ],
 "s065.sec7.u0": [
  [
   "........."
