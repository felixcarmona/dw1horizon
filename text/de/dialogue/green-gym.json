{
 "s108.sec5.m0.o0": "Was ist Training?",
 "s108.sec5.m0.o1": "Wie trainiere ich?",
 "s108.sec5.m0.o2": "Nichts. Vielen Dank.",
 "s108.sec5.u0": [
  [
   "Hey, hey, Neuigkeiten! Ähm...",
   "Solange dein Digimon noch ein",
   "Baby ist, solltest du dasselbe"
  ],
  [
   "Training immer wieder machen.",
   "Das soll etwas Gutes bewirken!"
  ]
 ],
 "s108.sec5.u1": [
  [
   "Hey, hey, Neuigkeiten! Ähm...",
   "Wenn du beim Bonustraining",
   "dieselben Bilder wie auf dem"
  ],
  [
   "Schild aufreihst, steigen die",
   "Werte noch stärker!"
  ]
 ],
 "s108.sec5.u2": [
  [
   "Ach ja, ich wollte dir von",
   "Techniken erzählen! Nach einem",
   "Kampf kann dein Digimon eine"
  ],
  [
   "Technik lernen, die der Gegner",
   "gegen es eingesetzt hat.",
   "Allerdings nur eine, die es in"
  ],
  [
   "seiner jetzigen Form ausrüsten",
   "kann. Das klappt nicht immer,",
   "ist aber der schnellste Weg,"
  ],
  [
   "mehr Techniken zu lernen.",
   "Außerdem... die Chance ist",
   "winzig, aber auch beim Training"
  ],
  [
   "kann es eine lernen. Bei hoher",
   "Klugheit soll der Unterricht",
   "bei {color 6}{player}{color 1} eine Technik"
  ],
  [
   "vermitteln können. Ich",
   "wiederhole mich, aber die",
   "Chance ist wirklich gering."
  ],
  [
   "Verlass dich also nicht darauf.",
   "Auf die Mischung kommt es an!"
  ]
 ],
 "s108.sec5.u3": [
  [
   "Hey, hey, ich bin Koromon! Jiji",
   "hat mich gebeten, dir das",
   "Training zu erklären. Was"
  ],
  [
   "möchtest du wissen?"
  ]
 ],
 "s108.sec5.u4": [
  [
   "Das Training hier steigert die",
   "Werte deines Digimon. Es ist",
   "aber anstrengend und dauert"
  ],
  [
   "eine ganze Weile. Trotzdem ist",
   "es zuverlässiger als Kämpfe.",
   "Ganz selten lernt dein Digimon"
  ],
  [
   "dabei sogar eine neue Technik!",
   "Davon erzähle ich dir ein",
   "anderes Mal."
  ]
 ],
 "s108.sec5.u5": [
  [
   "Hier gibt es sechs",
   "Trainingsgeräte, jedes mit",
   "einem Schild daneben."
  ]
 ],
 "s108.sec5.u6": [
  [
   "Stell dich vor ein Schild und",
   "drücke {color 6}×{color 1}. Lies es, um zu",
   "erfahren, welche Werte steigen."
  ],
  [
   "Manche Digimon steigern",
   "bestimmte Werte leicht, andere",
   "weniger. Das musst du"
  ],
  [
   "ausprobieren! Wähle Trainieren",
   "und dann Normales Training.",
   "Dein Digimon trainiert eine"
  ],
  [
   "Stunde lang. Dabei kannst du",
   "mit {color 5}△{color 1} die Zeit vorspulen. Ach",
   "ja, das Bonustraining! Wenn es"
  ],
  [
   "gelingt, steigt der Wert enorm.",
   "Wenn es misslingt... steigt er",
   "kaum. Probier es einmal aus."
  ]
 ],
 "s108.sec5.u7": [
  [
   "Ach so, gut... Ich suche neue",
   "Infos für dich."
  ]
 ],
 "s108.sec6.u0": [
  [
   "Ich in Stadt gehen. Stadt zu",
   "viel Stadt für mich. Ich nicht",
   "reinpassen. Also ich"
  ],
  [
   "hierherkommen. Ich Maschinen",
   "hier umbauen. Besser arbeiten",
   "als vorher. Du viel trainieren."
  ]
 ],
 "s108.sec7.u0": [
  [
   "Ich in Stadt gehen. Stadt zu",
