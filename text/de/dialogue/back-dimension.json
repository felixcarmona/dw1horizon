{
 "s185.sec5.u0": [
  [
   "Ich zeige dir meine wahre",
   "Kraft."
  ]
 ],
 "s185.sec6.u0": [
  [
   "Dass ich nun mit all meiner",
   "Kraft kämpfen muss..."
  ]
 ],
 "s185.sec7.u0": [
  [
   "...Du... wirst sterben."
  ]
 ],
 "s185.sec8.u0": [
  [
   "Hier beginnt die wahre Hölle..."
  ]
 ],
 "s185.sec60.u0": [
  [
   "Dieser Ort...!"
  ]
 ],
 "s185.sec60.u1": [
  [
   "Verstehe. Weiter drinnen,",
   "hinter diesem Ort..."
  ]
 ],
 "s186.sec5.u0": [
  [
   "...Dich... in... Stücke...",
   "reißen..."
  ]
 ],
 "s186.sec6.u0": [
  [
   "TÖTEN!"
  ]
 ],
 "s186.sec7.u0": [
  [
   "Winde dich und leide. Das ist",
   "dein Schicksal."
  ]
 ],
 "s186.sec8.u0": [
  [
   "Was suchst du, wenn du dein",
   "Leben wegwirfst?"
  ]
 ],
 "s187.sec5.u0": [
  [
   "Kampf beginnen!"
  ]
 ],
 "s187.sec6.u0": [
  [
   "Zielen... FEUER!"
  ]
 ],
 "s187.sec7.u0": [
  [
   "...Meine... Arbeit."
  ]
 ],
 "s187.sec8.u0": [
  [
   "Befehle. Darum."
  ]
 ]
