 "s052.sec83.u0": [
  [
   "Es geht nicht auf... Es ist",
   "verschlossen. Und es gibt kein",
   "Schlüsselloch!"
  ]
 ],
 "s054.sec5.u0": [
  [
   "Du hast uns oft geholfen. Lass",
   "mich die Früchte meiner",
   "Forschung mit dir teilen. Wenn"
  ],
  [
   "MetalGreymon im Kampf oder an",
   "einer Krankheit stirbt, kann es",
   "manchmal zu SkullGreymon"
  ],
  [
   "werden. Auch Bakemon, Devimon",
   "und Phoenixmon können so",
   "entstehen... Aus welchen"
  ],
  [
   "Formen, weiß ich nicht. Der",
   "Digitationsbaum zeigt diese",
   "Wege nicht. Merk es dir also"
  ],
  [
   "gut."
  ]
 ],
 "s054.sec5.u1": [
  [
   "Seit meine Leute in der Arena",
   "kämpfen, werden sie wieder sie",
   "selbst. Es scheint ihnen sehr"
  ],
  [
   "gutzutun. Und mir verschafft",
   "ein Kampf zwischen meinen",
   "Studien auch eine angenehme"
  ],
  [
   "Abwechslung."
  ]
 ],
 "s054.sec5.u2": [
  [
   "Woran forscht er eigentlich...?"
  ]
 ],
 "s054.sec5.u3": [
  [
   "Myotismon, in der Stadt hat",
   "eine Arena eröffnet!"
  ]
 ],
 "s054.sec5.u4": [
  [
   "Hm. Meinst du, meine Leute",
   "könnten dort nützlich sein?"
  ]
 ],
 "s054.sec5.u5": [
  [
   "Und ob! Lass sie sich",
   "austoben!"
  ]
 ],
 "s054.sec5.u6": [
  [
   "Meinen Leuten geht es immer",
   "schlechter... Vielleicht ist es",
   "nur eine Frage der Zeit, bis"
  ],
  [
   "sie dieses Anwesen verlassen."
  ]
 ],
 "s054.sec60.u0": [
  [
   "Mampf, mampf..."
  ]
 ],
 "s054.sec60.u1": [
  [
   "Fein..."
  ]
 ],
 "s054.sec60.u2": [
  [
   "Vielleicht hörst du dir an, was",
   "ich zu sagen habe."
  ]
 ],
 "s054.sec60.u3": [
  [
   "Kau, kau..."
  ]
 ],
 "s054.sec60.u4": [
  [
   "Meine Leute tun in letzter",
   "Zeit nicht mehr, was ich sage.",
   "Sie rebellieren nicht... sie"
  ],
  [
   "scheinen ihre Befehle einfach",
   "völlig zu vergessen. Manchmal",
   "verstehen sie sie nicht einmal."
  ],
  [
   "Eigentlich sollen sie mir meine",
   "Mahlzeiten bringen, aber..."
  ]
 ],
 "s054.sec60.u5": [
  [
   "Glu, Glu. . . ."
  ]
 ],
 "s054.sec60.u6": [
  [
   "Während ich in meine Forschung",
   "vertieft war, kam kein Essen...",
   "Und ich war so vertieft, dass"
  ],
  [
   "ich meinen Hunger vergaß. So",
   "ist das passiert."
  ]
 ],
 "s054.sec60.u7": [
  [
   "...Das ist aber VIEL zu",
   "vertieft."
  ]
 ],
 "s054.sec60.u8": [
  [
   "Oh, wie peinlich."
  ]
 ],
 "s054.sec60.u9": [
  [
   "Hier geschehen also dieselben",
   "seltsamen Dinge wie draußen."
  ]
 ],
 "s054.sec60.u10": [
  [
   "Oh? Mit den Unruhen auf der",
   "Insel meinst du also, dass alle",
   "so werden wie meine Leute?"
  ]
 ],
 "s054.sec60.u11": [
  [
   "Ja. Jede Art bleibt unter sich",
   "und verliert ihre Erinnerungen.",
   "Noch nicht alle, aber wenn das"
  ],
  [
   "so weitergeht..."
  ]
 ],
 "s054.sec60.u12": [
  [
   "Könnte jemand dahinterstecken?",
   "Hm... Und wenn ja, zu welchem",
   "Zweck...?"
  ]
 ],
 "s054.sec60.u13": [
  [
   "Mmm. . ."
  ]
 ],
 "s054.sec60.u14": [
  [
   "Was kann ich für die Insel",
   "tun?"
  ]
 ],
 "s054.sec60.u15": [
  [
   "Wir bauen eine Stadt, um die",
   "Herzen der Digimon zu",
   "vereinen. Darum bereisen wir"
  ],
  [
   "die Insel: um Freunde zu",
   "finden."
  ]
 ],
 "s054.sec60.u16": [
  [
   "Verstehe. Aber da gibt es ein",
   "Problem. Außer mir können",
   "meine Leute kaum etwas anderes"
  ],
  [
   "als kämpfen. Doch ich kann sie",
   "nicht einfach zurücklassen..."
  ]
 ],
 "s054.sec60.u17": [
  [
   "Ich sehe..."
  ]
 ],
 "s054.sec60.u18": [
  [
   "Ich gebe dir zu gegebener Zeit",
   "eine Antwort. Ich habe hier",
   "noch Arbeit. Es tut mir"
  ],
  [
   "wirklich leid..."
  ]
 ],
 "s054.sec60.u19": [
  [
   "Gut, dann komme ich wieder.",
   "Und iss ordentlich!"
  ]
 ],
 "s054.sec60.u20": [
  [
   "Warum kämpfst du dann nicht in",
   "der Arena?"
  ]
 ],
 "s054.sec60.u21": [
  [
   "Oh... die Arena? Das ist",
   "interessant. Genau das",
   "Richtige, um meine Leute in"
  ],
  [
   "Form zu bringen. Auch ich",
   "möchte mir ab und zu die Beine",
   "vertreten."
  ]
 ],
 "s054.sec60.u22": [
  [
   "Dann schließt du dich uns an?!"
  ]
 ],
 "s054.sec60.u23": [
  [
   "Ja. Ich muss hier aber noch",
   "etwas Forschung abschließen.",
   "Also komme ich zwischen meinen"
  ],
  [
   "Studien in die Stadt. Ich",
   "freue mich darauf."
  ]
 ],
 "s054.sec81.u0": [
  [
   "Oh!"
  ]
 ],
 "s054.sec81.u1": [
  [
   "Ja, ein Schlüssel! Vielleicht",
   "öffnet er die Türen, die nicht",
   "aufgingen."
  ]
 ],
 "s054.sec81.u2": [
  [
   "{color 6}Villaschlüssel{color 1} erhalten!"
  ]
 ],
 "s054.sec81.u3": [
  [
   "Hoppla, ich muss etwas",
   "wegwerfen."
  ]
 ],
 "s054.sec82.u0": [
  [
   "{color 6}Villaschlüssel{color 1} benutzt!"
  ]
 ],
 "s054.sec82.u1": [
  [
   "Es öffnet sich nicht... Es ist",
   "verschlossen."
  ]
 ],
 "s054.sec83.u0": [
  [
   "{color 6}Villaschlüssel{color 1} benutzt!"
  ]
 ],
 "s054.sec83.u1": [
  [
   "Es öffnet sich nicht... Es ist",
   "verschlossen."
