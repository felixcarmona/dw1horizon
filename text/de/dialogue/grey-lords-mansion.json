 ],
 "s055.sec5.u0": [
  [
   "Ich werde dich kochen!"
  ]
 ],
 "s055.sec6.u0": [
  [
   "Ich werde dich kochen!"
  ]
 ],
 "s055.sec7.u0": [
  [
   "Ich werde dich kochen!"
  ]
 ],
 "s055.sec83.u0": [
  [
   "Mal sehen, auf dem Zettel",
   "stand..."
  ]
 ],
 "s055.sec83.u1": [
  [
   "«Geh dorthin zurück, wo du dem",
   "Narren Punkte abgenommen",
   "hast.»"
  ]
 ],
 "s055.sec83.u2": [
  [
   "{color 6}Kühlschrank-S.{color 1} benutzt!"
  ]
 ],
 "s055.sec83.u3": [
  [
   "Huh? ist sie nicht hier? Fehlt",
   "es?"
  ]
 ],
 "s055.sec83.u4": [
  [
   "Oh? Da klebt ein Zettel dran..."
  ]
 ],
 "s055.sec83.u5": [
  [
   "«Geh dorthin zurück, wo du dem",
   "Narren Punkte abgenommen",
   "hast.»"
  ]
 ],
 "s055.sec83.u6": [
  [
   "Hm, dieser Zettel ist vorerst",
   "mein einziger Anhaltspunkt. Hm."
  ]
 ],
 "s055.sec83.u7": [
  [
   "Oh, ein Kühlschrank."
  ]
 ],
 "s055.sec83.u8": [
  [
   "Uff, er ist abgeschlossen. Wer",
   "schließt denn einen Kühlschrank",
   "ab?"
  ]
 ],
 "s056.sec53.u0": [
  [
   "Au, au... Das hat gesessen!"
  ]
 ],
 "s056.sec81.u0": [
  [
   "{color 6}Villaschlüssel{color 1} benutzt!"
  ]
 ],
 "s056.sec81.u1": [
  [
   "Es öffnet sich nicht... Es ist",
   "verschlossen."
  ]
 ],
 "s057.sec5.u0": [
  [
   "Meister...? Nein, du bist es",
   "nicht!"
  ]
 ],
 "s058.sec5.u0": [
  [
   "Ist das Essen noch nicht",
   "feeertig?"
  ]
 ],
 "s060.sec82.u0": [
  [
   "Aha, hier ist es!"
  ]
 ],
 "s061.sec52.u0": [
  [
   "Au, au... Geht's dir gut,",
   "{color 10}{partner}{color 1}?"
  ]
 ],
 "s061.sec52.u1": [
  [
   "Mm? Wo sind wir? . . ? ?"
  ]
 ],
 "s061.sec52.u2": [
  [
   "Es sieht so aus, als ob wir",
   "einen Raum betreten hätten, in",
   "dem wir noch nie waren."
  ]
 ],
 "s061.sec52.u3": [
  [
   "Ja, perfekte Landung!"
  ]
 ],
 "s061.sec82.u0": [
  [
   "Hm, ist das abgeschlossen?"
  ]
 ],
 "s061.sec82.u1": [
  [
   "Geht sie auf, wenn ich diesen",
   "Knauf drehe?"
  ]
 ],
 "s061.sec82.u2": [
  [
   "Okay, Es ist offen."
  ]
 ],
