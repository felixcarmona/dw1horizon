  ]
 ],
 "s050.sec51.u1": [
  [
   "Aaaaaah! ?"
  ]
 ],
 "s050.sec51.u2": [
  [
   "Ich komme!"
  ]
 ],
 "s051.sec57.u0": [
  [
   "...! Ich spüre die Mordlust von",
   "jemandem..."
  ]
 ],
 "s051.sec57.u1": [
  [
   "Hehe... haha... Du bist also",
   "doch gekommen!"
  ]
 ],
 "s051.sec57.u2": [
  [
   "Wer ist da!?"
  ]
 ],
 "s051.sec57.u3": [
  [
   "Ich bin Devimon! Ein gefallener",
   "Engel, der Macht der",
   "Finsternis verfallen. Hehehe..."
  ]
 ],
 "s051.sec57.u4": [
  [
   "Du scheinst etwas zu wissen!"
  ]
 ],
 "s051.sec57.u5": [
  [
   "Myotismon ist irgendwo im",
   "Herrenhaus. Wahrscheinlich",
   "sogar noch am Leben."
  ]
 ],
 "s051.sec57.u6": [
  [
   "Das ist also dein Werk!"
  ]
 ],
 "s051.sec57.u7": [
  [
   "Wer weiß? Aber ich bin dein",
   "Feind. Das ist sicher."
  ]
 ],
 "s051.sec57.u8": [
  [
   "He, du entkommst mir nicht!"
  ]
 ],
 "s051.sec57.u9": [
  [
   "Hehehe... Hahaha!"
  ]
 ],
 "s051.sec57.u10": [
  [
   "Oh, Nein!"
  ]
 ],
 "s051.sec57.u11": [
  [
   "Hehe... Grüß Myotismon von mir."
  ]
 ],
 "s051.sec57.u12": [
  [
   "Er ist entkommen... Mist! Was",
   "für ein Widerling."
  ]
 ],
 "s051.sec57.u13": [
  [
   "Wow, dieses Herrenhaus scheint",
   "riesig."
  ]
 ],
 "s051.sec57.u14": [
  [
   "Ist jemand zu Haaause?"
  ]
 ],
 "s051.sec57.u15": [
  [
   "Niemand da? Oder ist es hier",
   "zu groß, um mich zu hören?"
  ]
 ],
 "s051.sec57.u16": [
  [
   "Na ja. Gut, auf",
   "Erkundungstour!"
  ]
 ],
