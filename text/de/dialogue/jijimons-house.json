{
 "s165.sec5.u0": [
  [
   "Ah, du kommst genau richtig!",
   "Ich habe eine wichtige Bitte,",
   "die nur du erfüllen kannst."
  ]
 ],
 "s165.sec5.u1": [
  [
   "Worum geht es?"
  ]
 ],
 "s165.sec5.u2": [
  [
   "Ich habe es gerade wieder",
   "gespürt: dieselbe böse Aura wie",
   "bei Analogman und"
  ],
  [
   "Machinedramon. Aber ich weiß",
   "noch nicht, woher sie kommt..."
  ]
 ],
 "s165.sec5.u3": [
  [
   "Schon wieder?! Gut, überlass",
   "das mir!"
  ]
 ],
 "s165.sec5.u4": [
  [
   "Oh, danke. Übrigens..."
  ]
 ],
 "s165.sec5.u5": [
  [
   "Ich habe gehört, du hast",
   "Machinedramon besiegt!"
  ]
 ],
 "s165.sec5.u6": [
  [
   "Ja. Aber ich verstehe es nicht",
   "ganz. Es wirkte wie eine Art",
   "Fluch von Analogman."
  ]
 ],
 "s165.sec5.u7": [
  [
   "Sein Groll muss noch immer",
   "furchtbar stark sein... Nun,",
   "vielleicht haben wir jetzt"
  ],
  [
   "wieder Frieden."
  ]
 ],
 "s165.sec5.u8": [
  [
   "Wenn Machinedramon",
   "wiederkommt, besiegen wir ihn",
   "eben wieder. Wie ein jährliches"
  ],
  [
   "Fest. Klingt lustig, oder?"
  ]
 ],
 "s165.sec5.u9": [
  [
   "Haha, das beruhigt mich. Ach",
   "ja, nimm das als Dankeschön. Es",
   "ist zufällig auf der"
  ],
  [
   "Fleischfarm gewachsen."
  ]
 ],
 "s165.sec5.u10": [
  [
   "Wow, eine {color 6}Reife Melone{color 1}?"
  ]
 ],
 "s165.sec5.u11": [
  [
   "Ups, meine Tasche ist voll."
  ]
 ],
 "s165.sec5.u12": [
  [
   "Ich nehme es, danke!"
  ]
 ],
 "s165.sec5.u13": [
  [
   "Ah, da bist du! Es geht um",
   "etwas Wichtiges, das ich nur",
   "dir anvertrauen kann."
  ]
 ],
 "s165.sec5.u14": [
  [
   "Hehe, keine Ursache. Was hat",
   "es damit auf sich, dass",
   "Analogman zurück ist?"
  ]
 ],
 "s165.sec5.u15": [
  [
   "Hm, ich spüre es. Etwas mit",
   "genau derselben bösen Aura wie",
   "er. Aber ich kann nicht sagen,"
  ],
  [
   "woher sie kommt..."
  ]
 ],
 "s165.sec5.u16": [
  [
   "Gut, überlass das mir! Ich",
   "finde ihn und besiege ihn."
  ]
 ],
 "s165.sec5.u17": [
  [
   "Oh, danke. Übrigens..."
  ]
 ],
 "s165.sec7.u0": [
  [
   "Yuramon hat wohl neue",
   "Gerüchte aufgeschnappt."
  ]
 ],
 "s165.sec7.u1": [
  [
   "Ach ja, Yuramon kennt",
   "angeblich neue Gerüchte."
  ]
 ],
 "s165.sec7.u2": [
  [
   "Die Stadt wird immer lebhafter,",
   "und auch die Gespräche",
   "verändern sich ein wenig."
  ]
 ],
 "s165.sec7.u3": [
  [
   "{color 6}{player}{color 1}, du gehst deine",
   "Abenteuer ziemlich ungewöhnlich",
   "an, weißt du."
  ]
 ],
 "s165.sec20.u0": [
  [
   "Du bist also wieder bei",
   "Bewusstsein... Es tut mir so",
   "leid, mein Junge."
  ]
 ],
 "s165.sec85.m0.o0": "Benutzen",
 "s165.sec85.m0.o1": "Nicht benutzen",
 "s165.sec85.u0": [
  [
   "Oh? Was ist das für eine",
   "Maschine?"
  ]
 ],
 "s165.sec85.u1": [
  [
   "Hm, die? Das ist die",
   "{color 4}Kampfdaten-Speicher{color 1}. Er",
   "speichert die Kampfdaten deines"
  ],
  [
   "jetzigen Partners auf der",
   "Speicherkarte. Drücke dort {color 6}×{color 1},",
   "dann erklärt sie dir alles"
  ],
  [
   "Weitere."
  ]
 ],
 "s165.sec85.u2": [
  [
   "Die {color 4}Kampfdaten-Speicher{color 1}",
   "benutzen?"
  ]
 ],
 "s166.sec5.u0": [
  [
   "Sie arbeiten alle so hart!"
  ]
 ],
 "s166.sec6.u0": [
  [
   "Es sieht so aus, als ob nichts",
   "drin ist."
  ]
 ],
 "s166.sec7.u0": [
  [
   "Airdramon schläft. . ."
  ]
 ],
 "s166.sec60.u0": [
  [
   "Hm, im Moment scheint es ihm",
   "gut zu gehen."
  ]
 ],
 "s166.sec60.u1": [
  [
   "Puh, zum Glück..."
  ]
 ],
 "s166.sec60.u2": [
  [
   "Auch ihm zuliebe müssen wir",
   "ihren Anführer so schnell wie",
   "möglich besiegen."
  ]
 ],
 "s166.sec60.u3": [
  [
   "...Ich weiß, ich weiß."
  ]
 ],
