 "s178.sec5.u18": [
  [
   "Äh, räusper. Gemeinsam mit den",
   "zurückkehrenden Digimon werde",
   "ich File City wiederaufbauen."
  ]
 ],
 "s178.sec5.u19": [
  [
   "Ich will Läden bauen, die dir",
   "und {color 10}{partner}{color 1} nützlich sein",
   "werden."
  ]
 ],
 "s178.sec5.u20": [
  [
   "Für den Anfang... Mal sehen.",
   "Erkunde doch den Urwald gleich",
   "außerhalb der Stadt."
  ]
 ],
 "s178.sec6.u0": [
  [
   "Das ist für dich. Viel Glück!"
  ]
 ],
 "s178.sec6.u1": [
  [
   "Allerlei Gegenstände erhalten!"
  ]
 ],
 "s178.sec6.u2": [
  [
   "Drücke {color 5}△{color 1}, wähle Items und",
   "sieh dir deine Gegenstände mit",
   "{color 6}×{color 1} an."
  ]
 ],
 "s178.sec6.u3": [
  [
   "Yuramon hat wohl neue",
   "Gerüchte aufgeschnappt."
  ]
 ],
 "s178.sec6.u4": [
  [
   "Ach ja, Yuramon kennt",
   "angeblich neue Gerüchte."
  ]
 ],
 "s178.sec6.u5": [
  [
   "Die Stadt wird immer lebhafter,",
   "und auch die Gespräche",
   "verändern sich ein wenig."
  ]
 ],
 "s178.sec6.u6": [
  [
   "Ich erkläre dir die Grundlagen",
   "unserer Welt! Ein Tag hat 24",
   "Stunden: Morgen, Tag und"
  ],
  [
   "Nacht. Das kommt dir vielleicht",
   "etwas schnell vor. Ein Jahr",
   "hat 30 Tage. Monate? Was ist"
  ],
  [
   "das? Jahreszeiten...? Kann man",
   "die essen? Natürlich haben wir",
   "Geld. Es heißt Bits. Davon"
  ],
  [
   "kann man nie genug haben! Auf",
   "dieser Insel meint man mit \"der",
   "Stadt\" diesen Ort hier, obwohl"
  ],
  [
   "es noch ein paar kleine Städte",
   "und Dörfer gibt. Ach ja, die",
   "Uhr: Der gelbe Punkt zeigt die"
  ],
  [
   "Stunde, der Zeiger die",
   "Minuten. Mitternacht ist oben,",
   "Mittag unten. Rot auf der"
  ],
  [
   "linken Seite ist der Abend, von",
   "16 bis 20 Uhr. Lila rechts ist",
   "der Morgen, von 4 bis 8 Uhr."
  ],
  [
   "Digimon haben unterschiedliche",
   "Wachzeiten. Die meisten stehen",
   "morgens auf und schlafen"
  ],
  [
   "nachts, aber nicht alle.",
   "Findest du ein Digimon nicht,",
   "das du treffen möchtest,"
  ],
  [
   "versuche es zu einer anderen",
   "Uhrzeit."
  ]
 ],
 "s178.sec7.u0": [
  [
   "Schau oft bei Tsunomon und",
   "Yuramon vorbei, ja?"
  ]
 ],
 "s178.sec7.u1": [
  [
   "Ich erkläre dir den",
   "Tamer-Level! Je höher er ist,",
   "desto mehr Werte vererbt ein"
  ],
  [
   "Digimon, wenn es an",
   "Altersschwäche stirbt. Anfangs",
   "steigt er kaum, aber wenn du"
  ],
  [
   "weiter Digimon aufziehst,",
   "steigt er nach und nach, ja?"
  ]
 ],
 "s178.sec7.u2": [
  [
   "Drückst du bei einer",
   "Finisher-Technik immer wieder",
   "schnell L1 und R1? Mit voller"
  ],
  [
   "Leiste verursachst du doppelt",
   "so viel Schaden wie mit leerer.",
   "Doppelt so viel!"
  ]
 ],
 "s178.sec7.u3": [
  [
   "Ich erkläre dir, wie Digimon",
   "leben! Natürlich müssen Digimon",
   "zuerst einmal essen. Wenn sie"
  ],
  [
   "Hunger haben, sagen sie dir",
   "Bescheid. Dann müssen sie ihr",
   "Geschäft erledigen, am besten"
  ],
  [
   "auf einer Toilette. Wenn sie",
   "müde sind, schlafen sie. Sie",
   "warten auf dein Zeichen,"
  ],
  [
   "{color 6}{player}{color 1}, aber je früher,",
   "desto besser. Sie werden auch",
   "erschöpft, krank oder schlecht"
  ],
  [
   "gelaunt. Sie sind ziemlich",
   "empfindlich, ja? Im Herzen sind",
   "Digimon wild. Darum solltest du"
  ],
  [
   "sie manchmal loben und manchmal",
   "tadeln. Was du auch tust,",
   "beobachte dein Digimon genau"
  ],
  [
   "und kümmere dich gut darum."
  ]
 ],
 "s178.sec20.u0": [
  [
   "Du bist also wieder bei",
   "Bewusstsein... Es tut mir so",
   "leid, mein Junge."
  ]
 ],
