{
 "s080.sec5.u0": [
  [
   "Et llevaré la vida, si no",
   "t'importa."
  ]
 ],
 "s080.sec6.u0": [
  [
   "Has vingut fins aquí per a",
   "morir, o què?"
  ]
 ],
 "s080.sec7.u0": [
  [
   "Hala, quin valor tens!"
  ]
 ],
 "s080.sec8.u0": [
  [
   "Je. Tantes ganes tens de",
   "morir?"
  ]
 ],
 "s080.sec9.u0": "Has de desaparèixer...",
 "s080.sec10.u0": [
  [
   "Perdona, et faria res",
   "apartar-te?"
  ]
 ],
 "s080.sec51.u0": [
  [
   "Hala, de debò que aquí sembla",
   "una altra època."
  ]
 ],
 "s080.sec51.u1": [
  [
   "...Ui, espera! No hi ha temps",
   "per badar. El meteorit, el",
   "meteorit..."
  ]
 ],
 "s081.sec5.u0": [
  [
   "Tu ets d'AQUESTS,",
   "veritat...? Je, je..."
  ]
 ],
 "s081.sec5.u1": [
  [
   "Je, je... Al costat del túnel",
   "d'ossos... es gira..."
  ]
 ],
 "s082.sec5.m0.o0": "Tocar i examinar!",
 "s082.sec5.m0.o1": "Obrir-ho a cops!",
 "s082.sec5.u0": [
  [
   "És aquest...! Per descomptat",
   "sembla un meteorit. Primer..."
  ]
 ],
 "s082.sec5.u1": [
  [
   "Mmm..."
  ]
 ],
 "s082.sec5.u2": [
  [
   "És... un meteorit més normal",
   "del que esperava..."
  ]
 ],
 "s082.sec5.u3": [
  [
   "{color 7}???mon {color 1}",
   "Doncs perdona per ser tan",
   "normal..."
  ]
 ],
 "s082.sec5.u4": [
  [
   "!"
  ]
 ],
 "s082.sec5.u5": [
  [
   "Eres un Digimon!? Qui ets?"
  ]
 ],
 "s082.sec5.u6": [
  [
   "{color 7}???mon {color 1}",
   "...Em diuen Meteormon."
  ]
 ],
 "s082.sec5.u7": [
  [
   "Saps res dels problemes de",
   "l'illa?"
  ]
 ],
 "s082.sec5.u8": [
  [
   "...No sé res de res!"
  ]
 ],
 "s082.sec5.u9": [
  [
   "Res de res? De debò...? No",
   "m'estaràs ocultant alguna cosa?"
  ]
 ],
 "s082.sec5.u10": [
  [
   "Hmpf, quin maleducat! Doncs",
   "barallem-nos! A veure qui té",
   "raó!"
  ]
 ],
 "s082.sec5.u11": [
  [
   "V-val! D'acord..."
  ]
 ],
 "s082.sec5.u12": [
  [
   "Hmpf... Em rendeixo. Ets fort",
   "de debò."
  ]
 ],
 "s082.sec5.u13": [
  [
   "El que sigui sobre els",
   "disturbis de l'illa... Saps",
   "alguna cosa? Si us plau."
  ]
 ],
 "s082.sec5.u14": [
  [
   "Que no. Que jo acabo de",
   "néixer, com qui diu."
  ]
 ],
 "s082.sec5.u15": "Què!?",
 "s082.sec5.u16": [
  [
   "Els Meteormon naixem al cel,",
   "caiem de seguida a terra i",
   "passem molt de temps dormint",
   "sense moure'ns."
  ]
 ],
 "s082.sec5.u17": [
  [
   "Tot i que jo hauria d'haver",
   "estat quiet molt més temps,",
   "eh..."
  ]
 ],
 "s082.sec5.u18": [
  [
   "Ja ho entenc. Aquí el temps",
   "corre de pressa."
  ]
 ],
 "s082.sec5.u19": [
  [
   "Això sembla. Bé, faré un volt",
   "per l'illa. Sort, sagal."
  ]
 ],
 "s082.sec5.u20": [
  [
   "...Ai. Així que no hi ha cap",
   "pista... Au, sortim d'aquí de",
   "pressa."
  ]
 ],
 "s082.sec5.u21": [
  [
   "Total, mirant-ho no trauré res",
   "en clar. Ho trencarem!"
  ]
 ],
 "s082.sec5.u22": [
  [
   "{color 7}???mon {color 1}",
   "Eh, però tu què et creus que",
   "fas?! Que brut!"
  ]
 ],
 "s082.sec6.u0": [
  [
   "Eh? I tu qui ets!?"
  ]
 ],
 "s082.sec6.u1": [
  [
   "Nanimon, això és el que sóc!"
  ]
 ],
 "s082.sec6.u2": [
  [
   "Has rebut el {color 4}Clauer",
   "dimensional{color 1}! Ara pots portar",
   "fins a 20 objectes!"
  ]
 ],
 "s082.sec6.u3": [
  [
   "Has rebut el {color 4}Clauer",
   "dimensional{color 1}! Ara pots portar",
   "fins a 30 objectes!"
  ]
 ],
 "s083.sec5.u0": [
  [
   "Mare. Meva!!"
  ]
 ],
 "s083.sec6.u0": [
  [
   "Ei, noi! Fes-me passar una",
   "bona estona."
  ]
 ],
 "s083.sec7.u0": [
  [
   "Adéu..."
  ]
 ],
 "s083.sec8.u0": [
  [
   "Quina vida més curta."
  ]
 ]
