 "s168.sec82.m0.o0": "Historial",
 "s168.sec82.m0.o1": "Tornejos de grau",
 "s168.sec82.m0.o2": "Tornejos especials",
 "s168.sec82.u0": [
  [
   "Informació del Coliseu"
  ]
 ],
 "s168.sec82.u1": [
  [
   "Tornejos guanyats:",
   "{cupswon} {wins}",
   "victòries {losses} derrotes"
  ]
 ],
 "s168.sec82.u2": [
  [
   "Tothom pot participar als",
   "tornejos de grau, que es fan",
   "sovint. Evita inscriure-hi un",
   "Digimon molt per sobre del"
  ],
  [
   "nivell del torneig. Si canvia",
   "d'espècie entre la inscripció i",
   "el torneig, la inscripció queda",
   "anul·lada."
  ]
 ],
 "s168.sec82.u3": [
  [
   "Els tornejos especials tenen",
   "requisits fixos i se celebren",
   "molt de tant en tant. Si a la",
   "ciutat no hi ha bastants"
  ],
  [
   "participants que els",
   "compleixin, no se celebren.",
   "Cadascun se celebra només una",
   "o dues vegades a l'any, així"
  ],
  [
   "que mira el calendari amb",
   "temps."
  ]
 ],
 "s168.sec84.u0": [
  [
   "Je, je... {color 10}{partner}{color 1}, has",
   "salvat el món. Deixa que et",
   "busqui un títol d'heroi."
