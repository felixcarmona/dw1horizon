 "s104.sec5.m0.o0": "Fes-te més fort",
 "s104.sec5.m0.o1": "Sé un truc...",
 "s104.sec5.m0.o2": "Ànims",
 "s104.sec5.u0": [
  [
   "Jo voler guanyar a aquests",
   "Kabuterimon. Com jo guanyar?"
  ]
 ],
 "s104.sec5.u1": [
  [
   "Sí, jo pensar això. Jo",
   "entrenar."
  ]
 ],
 "s104.sec5.u2": [
  [
   "Què? Explica-m'ho."
  ]
 ],
 "s104.sec5.u3": [
  [
   "Vine a la ciutat i prou."
  ]
 ],
 "s104.sec5.u4": [
  [
   "..."
  ],
  [
   "Tu amable. Jo anar ciutat."
  ]
 ],
 "s104.sec5.u5": "Kuwagamon s'ha unit a la ciutat!",
 "s104.sec5.u6": [
  [
   "Tu no amable. Jo decebut."
  ]
 ],
 "s104.sec6.u0": [
  [
   "Mm, tu ja estar en torneig",
   "d'insectes abans. Llavors jo",
   "explicar-te cosa bona. Tu",
   "conèixer «Niu d'en Kunemon»?"
  ],
  [
   "Ser al Bosc nadiu. Digimon",
   "Novell dormir allí. Despertar",
   "com Kunemon. A vegades no.",
   "Dependre de sort."
  ]
 ],
 "s104.sec6.u1": [
  [
   "Tu, torneig d'insectes... Mm?",
   "Tu ara no poder entrar.",
   "Llavors jo explicar-te cosa",
   "bona. Tu conèixer «Llit de"
  ],
  [
   "Kunemon»? Ser al Bosc nadiu.",
   "Digimon Novell dormir allí.",
   "Despertar com Kunemon. A",
   "vegades no. Dependre de sort."
  ]
 ],
 "s104.sec6.u2": [
  [
   "Tu entrar en torneig de lluita",
   "d'insectes?"
  ]
 ],
 "s104.sec6.u3": [
  [
   "I això què és?"
  ]
 ],
 "s104.sec6.u4": [
  [
   "Apuntar-se abans de 10 en",
   "punt de dia 22, o no entrar."
  ]
 ],
 "s104.sec6.u5": [
  [
   "???"
  ]
 ],
 "s104.sec6.u6": [
  [
   "Detalls el mateix dia."
  ]
 ],
 "s104.sec6.u7": [
  [
   "No tinc ni idea de què parla."
  ]
 ],
