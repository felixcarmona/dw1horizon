 "s103.sec5.m0.o0": "En un gimnàs, suposo",
 "s103.sec5.m0.o1": "A l'arena, potser",
 "s103.sec5.u0": [
  [
   "Jo avorrit entrenar aquí. Què",
   "fer?"
  ]
 ],
 "s103.sec5.u1": [
  [
   "Que què fer, dius...?"
  ]
 ],
 "s103.sec5.u2": "On tu entrenar?",
 "s103.sec5.u3": [
  [
   "En un gimnàs, suposo."
  ]
 ],
 "s103.sec5.u4": [
  [
   "Entrenar avorrit. Jo voler",
   "fer-me fort en combats de",
   "debò."
  ]
 ],
 "s103.sec5.u5": [
  [
   "Entrenar avorrit. Jo voler",
   "fer-me fort en combats de",
   "debò."
  ]
 ],
 "s103.sec5.u6": [
  [
   "Jo anar allí. Jo entrenar."
  ]
 ],
 "s103.sec5.u7": "Kabuterimon s'ha unit a la ciutat!",
 "s103.sec6.u0": [
  [
   "Cada any, en dia amb dos 2,",
   "torneig de lluita d'insectes",
   "aquí. Guanyador portar cosa"
  ],
  [
   "genial."
  ],
  [
   "Però només Digimon insecte",
   "poder entrar."
  ]
 ],
 "s103.sec6.u1": [
  [
   "Kabuterimon, Kuwagamon,",
   "Kunemon i una altra classe",
   "d'insecte. Però Numemon no.",
   "Cada any, dia amb dos 2,"
  ],
  [
   "torneig de lluita d'insectes",
   "aquí... Mm? Tu ja guanyar",
   "torneig abans."
  ]
 ],
 "s103.sec6.u2": [
  [
   "Kabuterimon, Kuwagamon,",
   "Kunemon i una altra classe",
   "d'insecte: HerculesKabuterimon.",
   "Hercules molt fort. Guanyador"
  ],
  [
   "de torneig rebre objecte per",
   "evolucionar a Hercules. Tu",
   "poder entrar en torneig",
   "d'insectes moltes vegades."
  ]
 ],
 "s103.sec7.m0.o0": "I tant!",
 "s103.sec7.m0.o1": "No, gràcies",
 "s103.sec7.u0": [
  [
   "Tu fort. Jo res a",
   "ensenyar-te."
  ]
 ],
 "s103.sec7.u1": [
  [
   "Nosaltres estudiar tècniques.",
   "Tècniques fortes difícil",
   "aprendre."
  ],
  [
   "Si tu tenir capacitat, potser",
   "tu aprendre tècnica. Tu voler",
   "tècnica forta?"
  ]
 ],
 "s103.sec7.u2": [
  [
   "Llavors provar."
  ]
 ],
 "s103.sec7.u3": [
  [
   "A tu faltar Defensa. Entrenar",
   "més."
  ]
 ],
 "s103.sec7.u4": [
  [
   "A tu faltar Velocitat.",
   "Entrenar més."
  ]
 ],
 "s103.sec7.u5": [
  [
   "A tu faltar HP. Entrenar més."
  ]
 ],
 "s103.sec7.u6": "Tu aprendre tècnica.",
 "s103.sec7.u7": [
  [
   "Ha après Bestiola!"
  ]
 ],
 "s103.sec81.u0": [
  [
   "{color 5}Entrenament: Empènyer roca{color 1}"
  ]
 ],
 "s103.sec81.u1": [
  [
   "Empènyer la roca desenvolupa",
   "una força oculta. Els HP màx.",
   "pugen molt."
  ]
 ],
 "s103.sec81.u2": [
  [
   "{color 7}Escurabutxaques{color 1}",
   "Atura els tres rodets amb {color 6}×{color 1} i",
   "alinea els dibuixos."
  ]
 ],
 "s103.sec83.u0": [
  [
   "{color 5}Entrenament: Cops al ninot{color 1}"
  ]
 ],
 "s103.sec83.u1": [
  [
   "Practica tècniques de cop amb",
   "un ninot. L'Atac puja molt."
  ]
 ],
 "s103.sec83.u2": [
  [
   "{color 7}Escurabutxaques{color 1}",
   "Atura els tres rodets amb {color 6}×{color 1} i",
