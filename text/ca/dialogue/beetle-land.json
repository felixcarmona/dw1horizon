 "s102.sec81.m0.o0": "Explica-m'ho",
 "s102.sec81.m0.o1": "No cal explicar-ho",
 "s102.sec81.m1.o0": "Inscriure'm",
 "s102.sec81.m1.o1": "No inscriure'm",
 "s102.sec81.m2.o0": "No cancel·lar",
 "s102.sec81.m2.o1": "Cancel·lar",
 "s102.sec81.u0": [
  [
   "Llàstima. Inscripció ja tancar.",
   "Esperar un altre any."
  ]
 ],
 "s102.sec81.u1": [
  [
   "Ara no època de torneig. Jo",
   "avorrit."
  ]
 ],
 "s102.sec81.u2": [
  [
   "Torneig acabar ara mateix.",
   "Esperar un altre any."
  ]
 ],
 "s102.sec81.u3": [
  [
   "Tu no insecte. No entrar",
   "torneig."
  ]
 ],
 "s102.sec81.u4": [
  [
   "Tu inscriure't en torneig?"
  ]
 ],
 "s102.sec81.u5": [
  [
   "Dia 22, torneig de lluita només",
   "per a Digimon insecte. Ara tu",
   "poder inscriure't. Si no",
   "Digimon insecte, no entrar. Si"
  ],
  [
   "guanyar, tu rebre premi molt",
   "bo. Provar no fer mal."
  ]
 ],
 "s102.sec81.u6": [
  [
   "Ara no època de torneig. Jo",
   "avorrit."
  ]
 ],
 "s102.sec81.u7": [
  [
