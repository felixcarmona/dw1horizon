{
 "s026.sec5.u0": [
  [
   "Je, je, je, gràcies per les",
   "molèsties!"
  ]
 ],
 "s026.sec5.u1": [
  [
   "Què passa? Cerques baralla?"
  ]
 ],
 "s026.sec6.u0": [
  [
   "Vaja, vaja, gràcies per venir!"
  ]
 ],
 "s026.sec6.u1": [
  [
   "Deixa'm en pau!"
  ]
 ],
 "s026.sec7.u0": [
  [
   "No t'esforcis massa!"
  ]
 ],
 "s026.sec7.u1": [
  [
   "Au, vine per mi!"
  ]
 ],
 "s026.sec9.u0": [
  [
   "Val, val, em rendeixo!"
  ]
 ],
 "s026.sec10.u0": [
  [
   "El cap ha marxat..."
  ]
 ],
 "s026.sec51.u0": [
  [
   "Gue, je, je! Si voleu passar",
   "per aquí, panda de mocosos,",
   "deixeu totes les vostres coses!"
  ]
 ],
 "s026.sec51.u1": [
  [
   "Tu i jo ja ens coneixem des de",
   "fa molt, eh?"
  ]
 ],
 "s026.sec51.u2": [
  [
   "Ngh! Una altra vegada",
   "vosaltres, panda de mocosos...!"
  ]
 ],
 "s026.sec51.u3": [
  [
   "Això dic jo! Amagar-te en un",
   "lloc tan fàcil de trobar..."
  ],
  [
   "Sembla que ja estàs llest per",
   "al final!"
  ]
 ],
 "s026.sec51.u4": [
  [
   "Fua, ja, ja! Llest, dius? Ara",
   "veureu el que passa quan em",
   "poso seriós!"
  ]
 ],
 "s026.sec51.u5": [
  [
   "Acabem amb això!"
  ]
 ],
 "s026.sec51.u6": [
  [
   "...Per què... no puc",
   "guanyar...?"
  ]
 ],
 "s026.sec51.u7": [
  [
   "Què et passa? No sortiràs",
   "corrent?"
  ]
 ],
 "s026.sec51.u8": [
  [
   "Estic fet pols..."
  ]
 ],
 "s026.sec51.u9": [
  [
   "........."
  ]
 ],
 "s026.sec51.u10": [
  [
   "Em vaig fer bandit perquè vaig",
   "pensar que aquesta illa estava",
   "acabada..."
  ],
  [
   "Així que, total, podia fer el",
   "que em donés la gana..."
  ]
 ],
 "s026.sec51.u11": [
  [
   "Sabies que l'illa tenia",
   "problemes?"
  ]
 ],
 "s026.sec51.u12": [
  [
   "Doncs clar. Però després vau",
   "aparèixer tipus com",
   "vosaltres..."
  ],
  [
   "Unir-me ara a tots seria d'allò",
   "més patètic..."
  ]
 ],
 "s026.sec51.u13": [
  [
   "No, no ho seria. Vine't a la",
   "ciutat."
  ]
 ],
 "s026.sec51.u14": [
  [
   "No serveix de res... Un tipus",
   "com jo no li serveix a ningú..."
  ],
  [
   "A més, no hi ha manera que em",
   "perdonin..."
  ]
 ],
 "s026.sec51.u15": [
  [
   "Calla ja!!! Deixa de",
   "ploriquejar i vine't!!!"
  ]
 ],
 "s026.sec51.u16": [
  [
   "Tu SÍ QUE serveixes! Ara",
   "mateix en aquesta illa no sobra",
   "ningú! Tots som iguals!"
  ]
 ],
 "s026.sec51.u17": [
  [
   "!!!"
  ]
 ],
 "s026.sec51.u18": [
  [
   "Salvar-se...? Aquesta illa es",
   "pot salvar!? Vosaltres la",
   "salvareu, veritat? Eh!?"
  ]
 ],
 "s026.sec51.u19": [
  [
   "Doncs clar que sí!!! ...Saps on",
   "està la ciutat, no?"
  ]
 ],
 "s026.sec51.u20": [
  [
   "Ohhhhh! Espera'm, treball nou!"
