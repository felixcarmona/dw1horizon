   "Espeeera!"
  ]
 ],
 "s070.sec6.u0": [
  [
   "Vinga, vinga, ataca'm!"
  ]
 ],
 "s070.sec7.u0": [
  [
   "Ja, ja, ja, quin valor tens!"
  ]
 ],
 "s070.sec8.u0": [
  [
   "Kua, kua!"
  ]
 ],
 "s070.sec9.u0": [
  [
   "Jo... arribar aquí primer."
  ]
 ],
 "s070.sec10.u0": [
  [
   "Jo fort, tu res!"
  ]
 ],
 "s070.sec11.u0": [
  [
