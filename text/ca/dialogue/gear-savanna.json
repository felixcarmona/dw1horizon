 "s072.sec7.u0": [
  [
   "La veritat, m'has decebut!"
  ]
 ],
 "s072.sec8.u0": [
  [
   "Tingues la bondat de no fer-me",
   "enfadar."
  ]
 ],
 "s072.sec9.u0": [
  [
   "Menjar?"
  ]
 ],
 "s072.sec10.u0": [
  [
   "Jo fam!"
  ]
 ],
 "s073.sec8.u0": [
  [
   "Tot això, casa meva. Tu, fora!"
  ]
 ],
 "s073.sec9.u0": [
  [
   "Jo, Shamamon... Tu, què...?"
  ]
 ],
 "s073.sec51.u0": [
  [
   "Eh? Què és això?"
  ]
 ],
 "s073.sec51.u1": [
  [
   "A-a-ajudaaa!"
  ]
 ],
 "s073.sec51.u2": [
  [
   "Ui, l'he d'ajudar!"
  ]
 ],
 "s073.sec51.u3": [
  [
   "{color 7}??? {color 1}",
   "Ja n'hi ha prou d'abusar del",
   "feble!"
  ]
 ],
 "s073.sec51.u4": [
  [
   "Eh? Qui és aquest?"
  ]
 ],
 "s073.sec51.u5": [
  [
   "Estàs bé!?"
  ]
 ],
 "s073.sec51.u6": [
  [
   "Uuuf... G-gràcies."
  ]
 ],
 "s073.sec51.u7": [
  [
   "No hi ha de què. Quan tinguis",
   "problemes, crida'm. Jo, Leomon,",
   "acudiré de seguida!"
  ],
  [
   "Fins a la pròxima!"
  ]
 ],
 "s073.sec51.u8": [
  [
   "Ah, espera'm!"
  ]
 ],
 "s073.sec51.u9": [
  [
   "......Hala... Com un heroi de",
   "debò. Ens ha robat el",
   "protagonisme."
  ]
 ],
 "s074.sec5.u0": [
  [
   "Inútil, inútil, inútiiil!"
  ]
 ],
 "s074.sec6.u0": [
  [
   "Dóna'm menjar!"
  ]
 ],
 "s074.sec7.u0": [
  [
   "Ritual... començar."
  ]
 ],
 "s074.sec8.u0": [
  [
   "Per què no proves de confiar",
   "en mi?"
  ]
 ],
 "s074.sec9.u0": [
  [
   "Geja, geja, geja?"
  ]
 ],
 "s074.sec10.u0": [
  [
   "Jo guanyar, tu perdre."
  ]
 ],
 "s075.sec5.u0": [
  [
   "Hi ha alguna cosa que haig de",
   "trobar... Perdona'm..."
  ]
 ],
 "s075.sec51.u0": [
  [
   "He sentit parlar de tu. Has",
   "fet grans coses."
  ]
 ],
 "s075.sec51.u1": [
  [
   "Si has sentit parlar de",
   "nosaltres i de la ciutat,",
   "vindràs a la ciutat?"
  ]
 ],
 "s075.sec51.u2": [
  [
   "...Deixa que ho pensi. Tinc les",
   "meves pròpies idees sobre el",
   "futur de l'illa."
  ],
  [
   "I... hi ha alguna cosa que",
   "porto molt temps buscant."
  ]
 ],
 "s075.sec51.u3": [
  [
   "Què és el que cerques?"
  ]
 ],
 "s075.sec51.u4": [
  [
   "Un objecte que els meus",
   "avantpassats van deixar per al",
   "futur, segons diuen. Què és, no",
   "ho sé..."
  ]
 ],
 "s075.sec51.u5": [
  [
   "Ja veig... Si ho trobem,",
   "t'avisarem."
  ]
 ],
 "s075.sec51.u6": [
  [
   "Je... Porto molts anys",
   "buscant-ho. Ni tan sols per a",
   "tu serà fàcil trobar-ho."
  ]
 ],
 "s075.sec51.u7": [
  [
   "Però et prometo una cosa. Si",
   "apareix, aniré a la teva",
   "ciutat."
  ]
 ],
 "s075.sec51.u8": [
  [
   "...No serà això?"
  ]
 ],
 "s075.sec51.u9": [
  [
   "Oh, això és...!"
  ]
 ],
 "s075.sec51.u10": [
  [
   "Mmm... Sí, això ho van escriure",
   "els meus avantpassats! Vegem..."
  ]
 ],
 "s075.sec51.u11": [
  [
   "\"Quan el perill arribi a",
   "l'illa... vés al seu centre...",
   "i uneix forces...!\""
  ]
 ],
 "s075.sec51.u12": [
  [
   "Això és...! Els meus",
   "avantpassats em diuen que vagi",
   "a la ciutat...!"
  ]
 ],
 "s075.sec51.u13": [
  [
   "...!! ...Llavors, això vol",
   "dir... que ens ajudaràs?"
  ]
 ],
 "s075.sec51.u14": [
  [
   "Clar. Deixa-m'ho a mi!"
  ]
 ],
 "s075.sec51.u15": "Leomon s'ha unit a la ciutat!",
