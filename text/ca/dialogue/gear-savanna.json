  [
   "{color 6}{player}{color 1}",
   "s'ha esforçat molt per",
   "convèncer-la!"
  ]
 ],
 "s070.sec54.u9": [
  [
   "Ja ho veig, piu... Ho havia",
   "entès tot malament, piu."
  ]
 ],
 "s070.sec54.u10": [
  [
   "D'acord, piu. Aniré a la",
   "ciutat, piu!"
