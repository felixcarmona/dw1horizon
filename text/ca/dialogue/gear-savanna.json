{
 "s066.sec5.u0": [
  [
   "El mar és bonic, oi...?"
  ]
 ],
 "s066.sec6.u0": [
  [
   "Treu-te del mig!"
  ]
 ],
 "s066.sec7.u0": [
  [
   "Ah, ja ho sé! Et diré una cosa",
   "bona..."
  ]
 ],
 "s066.sec8.u0": [
  [
   "Caram, gens malament."
  ]
 ],
 "s067.sec5.u0": [
  [
   "Tens bon instint."
  ]
 ],
 "s067.sec6.u0": [
  [
   "Ajá, ajá, pot ser que tinguis",
   "fusta."
  ]
 ],
 "s067.sec7.u0": [
  [
   "Així que tu ets aquest...",
   "Interessant!"
  ]
 ],
 "s067.sec8.u0": [
  [
   "Vols que et doni això? Ji,",
   "ji..."
  ]
 ],
 "s067.sec9.u0": [
  [
   "Ara tu i jo som amics,",
   "veritat...?"
  ]
 ],
 "s067.sec10.u0": [
  [
   "Tu enemic? Tu voler baralla?"
  ]
 ],
 "s068.sec5.u0": [
  [
   "Ha, ha, si em toques et clavaré",
   "una bona DESCÀRREGA, eh?"
  ]
 ],
 "s068.sec5.u1": [
  [
   "Sent, sent, tu... no et dol?"
  ]
 ],
 "s068.sec5.u2": [
  [
   "Hala, quina passada, tens",
   "coratge! Tens fusta! Vinga, et",
   "donaré un cop de mà."
  ]
 ],
 "s068.sec5.u3": [
  [
   "...I si uses aquesta energia",
   "elèctrica per a construir la",
   "ciutat?"
  ]
 ],
 "s068.sec5.u4": [
  [
   "...La ciutat? Caram, què deu",
   "ser...? Em sona d'alguna cosa.",
   "Per què deu ser? Mmm.",
   "D'acord, t'ajudaré. Sóc"
  ],
  [
   "Elecmon. Encantat!"
  ]
 ],
 "s068.sec5.u5": "Elecmon s'ha unit a la ciutat!",
 "s068.sec6.u0": [
  [
   "Kueh, kuehhh!"
  ]
 ],
 "s068.sec7.u0": [
  [
   "Kiiiiiiieh!!"
  ]
 ],
 "s068.sec8.u0": [
  [
   "Tu... sacrifici!"
  ]
 ],
 "s068.sec9.u0": [
  [
   "Vas per bon camí. Tu..."
  ]
 ],
 "s068.sec10.u0": [
  [
   "Ai... quin mal gust tens."
  ]
 ],
 "s068.sec11.u0": [
  [
   "Què descarat! Et guanyaré!"
  ]
 ],
 "s068.sec51.u0": [
  [
   "Una porta de ferro ben",
   "sòlida... Si no s'obre, no hi",
   "ha manera d'entrar."
  ]
 ],
 "s069.sec5.m0.o0": "D'acord",
 "s069.sec5.m0.o1": "Ni parlar-ne",
 "s069.sec5.m1.o0": "Bé, d'acord",
 "s069.sec5.m1.o1": "Nooo",
 "s069.sec5.u0": [
  [
   "Et guanyaré!"
  ]
 ],
 "s069.sec5.u1": [
  [
   "Maleït sigui, tornem-hi."
  ]
 ],
 "s069.sec5.u2": [
  [
   "Gairebé ho tenia! Vinga, una",
   "altra vegada!"
  ]
 ],
 "s069.sec5.u3": [
  [
   "No puc guanyaaar! Buaaa!"
  ]
 ],
 "s069.sec5.u4": [
  [
   "I què faràs si ganes?"
  ]
 ],
 "s069.sec5.u5": [
  [
   "Eh? Això, mmm... No sé."
  ]
 ],
 "s069.sec5.u6": [
  [
   "No saps... És a dir, que no hi",
   "ha cap motiu?"
  ]
 ],
 "s069.sec5.u7": [
  [
   "Cap motiu, la veritat.",
   "M'avorreixo."
  ]
 ],
 "s069.sec5.u8": [
  [
   "Ai... Si t'avorreixes, vine a",
   "la ciutat. Hi ha Digimon de",
   "tota mena."
  ]
 ],
 "s069.sec5.u9": [
  [
   "Caram, sona bé. Hi aniré. Sóc",
   "Patamon. Fins ara!"
  ]
 ],
 "s069.sec5.u10": "Patamon s'ha unit a la ciutat!",
 "s069.sec5.u11": [
  [
   "Jo, que fat ets!"
  ]
 ],
 "s069.sec6.u0": [
  [
   "Oh, véns?"
  ]
 ],
 "s069.sec7.u0": [
  [
   "Tu... no fer olor!"
  ]
 ],
 "s069.sec8.u0": [
  [
   "Semblar bo. Jo, a tu, menjar!"
  ]
 ],
 "s069.sec9.u0": [
  [
   "Ga, ja, ja, ja! Tu graciós!"
  ]
 ],
 "s070.sec5.u0": [
  [
   "Ai, has tornat, piu!"
  ]
 ],
 "s070.sec5.u1": [
  [
   "Adéééu, piu!"
  ]
 ],
 "s070.sec5.u2": [
  [
   "Mmm... a aquest pas no pararem",
   "de donar voltes."
  ]
 ],
 "s070.sec5.u3": [
  [
   "Potser hauríem de tendir-li una",
   "emboscada..."
  ]
 ],
 "s070.sec5.u4": [
  [
   "Mmm? Qui hi ha, piu?"
  ]
 ],
 "s070.sec5.u5": [
  [
   "N-no pot ser..."
  ]
 ],
 "s070.sec5.u6": [
  [
   "Aaaaaai, piu!"
  ]
 ],
 "s070.sec5.u7": [
  [
   "Ah, sent, espera!"
  ]
 ],
 "s070.sec5.u8": [
  [
   "Ah, una altra vegada!",
   "Espeeera!"
  ]
 ],
 "s070.sec5.u9": [
  [
   "Ah, una altra vegada!",
   "Espeeera!"
  ]
 ],
