{
 "s177.sec5.u0": [
  [
   "Bla, bla. Hola a tots. A veure,",
   "quina botiga és aquesta? Eh?",
   "L'he obert jo? Mmm. Bla. Tu",
   "compra alguna cosa, o el que"
  ],
  [
   "sigui."
  ]
 ],
 "s177.sec5.u1": [
  [
   "Vaja, si és {color 6}{player}{color 1}! He",
   "obert una botiga que ven coses",
   "ben estranyes. Tracta'm bé, em",
   "sents, noi?"
  ]
 ],
 "s177.sec5.u2": [
  [
   "Eeei, benvingut, benvingut! El",
   "que venc aquí no és gaire",
   "normal! Així que compra",
   "mooooltes coses!"
  ]
 ],
 "s177.sec5.u3": [
  [
   "He, he, he... Al final has",
   "vingut, {color 6}{player}{color 1}. No facis",
   "aquesta cara de sorpresa.",
   "Saber treure partit dels meus"
  ],
  [
   "objectes... això posarà a prova",
   "la teva força com a Domador.",
   "He, he..."
  ]
 ],
 "s177.sec5.u4": [
  [
   "Bla, bla. On estic? Sí,",
   "m'encanten els llocs foscos.",
   "Així és aquesta botiga!"
  ]
 ],
 "s177.sec5.u5": [
  [
   "Vaja, {color 6}{player}{color 1}, has passat",
   "per aquí! Què et sembla",
   "comprar alguna cosa per",
   "saludar?"
  ]
 ],
 "s177.sec5.u6": [
  [
   "Eeeh, {color 6}{player}{color 1}! Has",
   "vingut! Compra els meus",
   "objectes súuuper útils!"
  ]
 ],
 "s177.sec5.u7": [
  [
   "He, he, he... Al final has",
   "vingut, {color 6}{player}{color 1}. No facis",
   "aquesta cara de sorpresa.",
   "Saber treure partit dels meus"
  ],
  [
   "objectes... això posarà a prova",
   "la teva força com a Domador.",
   "He, he..."
  ]
 ],
 "s177.sec6.u0": [
  [
   "Aquest humil servidor sap una",
   "mica d'objectes. Hi ha 128",
   "classes d'objectes en total,",
   "segons diuen. D'aquests, 32 són"
  ],
  [
   "menjar! Alguns només creixen en",
   "una regió. Són ben rars! Per",
   "exemple, la Poma blava es troba",
   "al Bosc nadiu. Aquests aliments"
  ],
  [
   "tenen efectes especials. Pensa",
   "bé quan te'ls menges!"
  ]
 ],
 "s177.sec6.u1": [
  [
   "Aquest cop, aquest humil",
   "servidor parlarà dels objectes",
   "de digievolució. Com diu el",
   "nom, fan digievolucionar un"
  ],
  [
   "Digimon. N'hi ha de moltes",
   "menes, un per cada Digimon,",
   "segons diuen. Per exemple, usa",
   "Arpes grises i et tornaràs"
  ],
  [
   "Greymon! Són objectes",
   "llegendaris. D'alguns només",
   "n'hi ha un al món! Però, en",
   "comparació amb la digievolució"
  ],
  [
   "normal, no donen cap extra",
   "d'atributs i fan baixar la",
   "felicitat. No surt gaire a",
   "compte! Tot i així, tornar-se"
  ],
  [
   "de seguida el Digimon que vols",
   "té el seu encant! Però només",
   "funcionen des del nivell",
   "immediatament anterior. Compte!"
  ]
 ]
}
