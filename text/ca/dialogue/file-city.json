 "s192.sec51.u0": [
  [
   "Així que... per fi ha arribat",
   "el moment."
  ]
 ],
 "s192.sec51.u1": [
  [
   "Sí... La veritat és que em",
   "quedaria aquí per sempre. Però",
   "la meva mare estarà",
   "preocupada..."
  ]
 ],
 "s192.sec51.u2": [
  [
   "L'única cosa que puc dir-te,",
   "{color 6}{player}{color 1}, és gràcies. Tant",
   "de bo hagués pogut fer més per",
   "tu, per a tornar-te el favor..."
  ]
 ],
 "s192.sec51.u3": [
  [
   "{color 7}Tokomon {color 1}",
   "Snif... No t'oblidis de",
   "nosaltres, val...?"
  ]
 ],
 "s192.sec51.u4": [
  [
   "Algun dia ens tornarem a",
   "veure... Aquest dia arribarà...",
   "veritat...?"
  ]
 ],
 "s192.sec51.u5": [
  [
   "...Nois, m'ho he passat genial.",
   "Gràcies."
  ]
 ],
 "s192.sec51.u6": [
  [
   "Vinga, vinga... Abans que el",
   "comiat es faci encara més",
   "dur... comencem la cerimònia..."
  ]
 ],
 "s192.sec51.u7": [
  [
   "{color 10}{partner}{color 1}, el meu millor",
   "amic... la nostra aventura ha",
   "estat la millor de totes!!"
  ]
 ],
 "s193.sec54.u0": [
  [
   "Mmm... està tornant en si?",
   "Sembla que ha funcionat!"
  ]
 ],
 "s193.sec54.u1": [
  [
   "Un humà... just com va dir",
   "Jiji!"
  ]
 ],
 "s193.sec54.u2": [
  [
   "Mmmmmm..."
  ]
 ],
 "s193.sec54.u3": [
  [
   "Xxt! Es desperta!"
  ]
 ],
 "s193.sec54.u4": [
  [
   "Eh...? On... estic?"
  ]
 ],
 "s193.sec54.u5": [
  [
   "Benvingut a Digimon World!"
  ]
 ],
 "s193.sec54.u6": [
  [
   "Eh?"
  ]
 ],
 "s193.sec54.u7": [
  [
   "Aaaaah!!"
  ]
 ],
 "s193.sec54.u8": [
  [
   "Eh? Què? Què passa?"
  ]
 ],
 "s193.sec54.u9": [
  [
   "Q-q-què sou vosaltres!?"
  ]
 ],
 "s193.sec54.u10": [
  [
   "Som Digimon."
  ]
 ],
 "s193.sec54.u11": [
  [
   "Digimon!? O sigui..."
  ]
 ],
 "s193.sec54.u12": [
  [
   "Mm? Tu saps el que són els",
   "Digimon, no...?"
  ]
 ],
 "s193.sec54.u13": [
  [
   "Mmm? Aha, ja ho entenc. Això",
   "és un somni, oi? Sí, això és."
  ]
 ],
 "s193.sec54.u14": [
  [
   "No és un somni! Som de debò!"
  ]
 ],
 "s193.sec54.u15": [
  [
   "Camina, si ets Tokomon! És a",
   "dir, que sí que sou Digimon.",
   "Quin somni més realista..."
  ]
 ],
 "s193.sec54.u16": [
  [
   "Ejem. Escolta'm bé,",
   "{color 6}{player}{color 1}. Això no és un",
   "somni. Encara que tampoc és",
   "del tot la realitat..."
  ]
 ],
 "s193.sec54.u17": [
  [
   "Però què dius? Llavors com",
   "saps el meu nom? I tu qui ets,",
   "a tot això?"
  ]
 ],
 "s193.sec54.u18": [
  [
   "Sóc Jijimon."
  ]
 ],
 "s193.sec54.u19": [
  [
   "Eh? Alguna vegada ha existit",
   "un Digimon que es digui així?"
  ]
 ],
 "s193.sec54.u20": [
  [
   "Jo, jo. Els Digimon que tu",
   "coneixes no són els únics que",
   "hi ha. Això és Digimon World,",
   "al cap i a la fi."
  ]
 ],
 "s193.sec54.u21": [
  [
   "Digimon... World..."
  ]
 ],
 "s193.sec54.u22": [
  [
   "Un món que no és ni somni ni",
   "realitat. El món dels Digimon!"
  ]
 ],
 "s193.sec54.u23": [
  [
   "Bé... ara que ho dius... per a",
   "ser un somni, és MASSA real..."
  ]
 ],
 "s193.sec54.u24": [
  [
   "Mira darrere de tu. Amb això",
   "ho veuràs clar."
  ]
 ],
 "s193.sec54.u25": [
  [
   "Eh?"
  ]
 ],
 "s193.sec54.u26": [
  [
   "No pot ser... Aquest és",
   "{color 10}{partner}{color 1}, el que he estat",
   "criant?"
  ]
 ],
 "s193.sec54.u27": [
  [
   "Això és...! M'ha absorbit el",
   "meu clauer Digimon..."
  ]
 ],
 "s193.sec54.u28": [
  [
   "Així és. Ara ho entens."
  ]
 ],
 "s193.sec54.u29": [
  [
   "Val, ho entenc, però... per què",
   "estic... aquí?"
  ]
 ],
 "s193.sec54.u30": [
  [
   "Mmm... Bé, ara que ho entens,",
   "vine a casa nostra. Allà",
   "parlarem amb calma."
  ]
 ],
 "s193.sec55.u0": [
  [
   "Bé, per on anava? Jo sóc qui",
   "t'ha portat fins aquí, saps?",
   "Necessitem que ens salvis."
  ]
 ],
 "s193.sec55.u1": [
  [
   "Que us salvi?? Per què? Passa",
   "alguna cosa dolenta?"
  ]
 ],
 "s193.sec55.u2": [
  [
   "Estem en Ciutat File, just en",
   "el centre d'una illa anomenada",
   "Illa File."
  ]
 ],
 "s193.sec55.u3": [
  [
   "Una ciutat? Això? És bastant",
   "petita i està feta pols."
  ]
 ],
 "s193.sec55.u4": [
  [
   "Ho, ho... Bé, suposo que hauria",
   "de dir que ERA una ciutat.",
   "Abans hi vivien Digimon de tota",
   "mena."
  ]
 ],
 "s193.sec55.u5": [
  [
   "Però un bon dia, els Digimon",
   "van començar a perdre el seu",
   "«cor»... i es van dispersar",
   "fora de la ciutat."
  ]
 ],
 "s193.sec55.u6": [
  [
   "Què vols dir?"
  ]
 ],
 "s193.sec55.u7": [
  [
   "No sabem per què... Els Digimon",
   "estan perdent el do de la",
   "paraula..."
  ]
 ],
 "s193.sec55.u8": [
  [
   "Alguns encara parlen una",
   "mica... però han oblidat per",
   "complet que vivien a la ciutat."
  ]
 ],
 "s193.sec55.u9": [
  [
   "Ja veig. Així que això és",
   "perdre el seu «cor»."
  ]
 ],
 "s193.sec55.u10": [
  [
   "Així és. I és perillós."
  ],
  [
   "Diu la llegenda que si Ciutat",
   "File perilla, perillen tots els",
   "Digimon..."
  ]
 ],
 "s193.sec55.u11": [
  [
   "Però per què jo? No valdria",
   "qualsevol?"
  ]
 ],
 "s193.sec55.u12": [
  [
   "A tu se't dóna bé criar",
   "Digimon, no és així?"
  ]
 ],
 "s193.sec55.u13": [
  [
   "Eh? ...Ah, sí! Se'm dóna molt",
   "bé! He, he."
  ]
 ],
 "s193.sec55.u14": [
  [
   "No t'has adonat? Estàs",
   "parlant l'idioma dels Digimon."
  ]
 ],
 "s193.sec55.u15": [
  [
   "Què? Jo diria que estic parlant",
   "en català normal."
  ]
 ],
 "s193.sec55.u16": [
  [
   "A nosaltres ens sona igual que",
   "la parla dels Digimon."
  ]
 ],
 "s193.sec55.u17": [
  [
   "Sí, sí!"
  ]
 ],
 "s193.sec55.u18": [
  [
   "Veuràs, l'afecte que sents pels",
   "Digimon en el teu món es",
   "converteix aquí en un poder de",
   "debò."
  ]
 ],
 "s193.sec55.u19": [
  [
   "H-hala...! Em trauràs els",
   "colors."
  ]
 ],
 "s193.sec55.u20": [
  [
   "Per això et vaig triar a tu.",
   "Tu pots portar de tornada aquí",
   "als Digimon de tota l'Illa",
   "File!"
  ]
 ],
 "s193.sec55.u21": [
  [
   "Oh..."
  ]
 ],
 "s193.sec55.u22": [
  [
   "Ooh..."
  ]
 ],
 "s193.sec55.u23": [
  [
   "Oooh! C-clar, ja veig! Per fi",
   "ho entenc tot! Ja, ja! Tu",
   "deixa-m'ho a mi!"
  ]
 ],
 "s193.sec55.u24": [
  [
   "Molt bé! Visca, visca!"
  ]
 ],
 "s193.sec55.u25": [
  [
   "Ajá, ajá, gràcies, noi. Sé que",
   "és molt demanar, però ets",
   "l'única cosa que ens queda."
  ]
 ],
 "s193.sec55.u26": [
  [
   "He, he. Bé, què faig primer?"
  ]
 ],
 "s193.sec55.u27": [
  [
   "A partir d'ara, tu i el teu",
   "company {color 10}{partner}{color 1}",
   "recorrereu junts l'Illa File."
  ]
 ],
 "s193.sec55.u28": [
  [
   "Esbrineu què hi ha darrere de",
   "tot això i convenceu els",
   "Digimon perquè tornin a la",
   "ciutat."
  ]
 ],
 "s193.sec55.u29": [
  [
   "D'acord, entès. Vinga, some-hi,",
   "{color 10}{partner}{color 1}!"
  ]
 ],
 "s193.sec55.u30": [
  [
   "E-eh, espera, que no he",
   "acabat...!"
  ]
 ]
}
