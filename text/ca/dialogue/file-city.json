{
 "s162.sec5.u0": [
  [
   "Ja has vist el guardià del",
   "llac? Si no, espera'l amb",
   "moooolta calma a la riba sud!"
  ]
 ],
 "s162.sec5.u1": [
  [
   "Prova de llevar-te moooolt",
   "d'hora i passejar entre la",
   "boira. Et passarà una cosa",
   "bona!"
  ]
 ],
 "s162.sec5.u2": [
  [
   "Ep, ho sabies? Moooolt al nord",
   "hi ha un lloc que es diu Platja",
   "Iceberg. Diuen que últimament",
   "hi apareix molt un Digimon"
  ],
  [
   "enooorme."
  ]
 ],
 "s162.sec5.u3": [
  [
   "Ja has derrotat els bandits?",
   "Diuen que encara tenen un",
   "«cau» en algun lloc."
  ]
 ],
 "s162.sec5.u4": [
  [
   "Ja has anat al Gran Canyó?",
   "Diuen per aquí que allí",
   "apareixen bandits."
  ]
 ],
 "s162.sec5.u5": [
  [
   "Són dolents?"
  ]
 ],
 "s162.sec5.u6": [
  [
   "Quan passes pel congost,",
   "t'envolten i et «atraquen».",
   "Tant de bo algú acabés amb",
   "ells."
  ]
 ],
 "s162.sec5.u7": [
  [
   "Mmm. Sembla que no podem",
   "quedar-nos de braços plegats."
  ]
 ],
 "s162.sec5.u8": [
  [
   "Ja has anat al Gran Canyó?"
  ],
  [
   "Diuen per aquí que allí hi ha",
   "un «pont invisible»."
  ]
 ],
 "s162.sec5.u9": [
  [
   "Diuen que Machinedramon ha",
   "tornat a la vida!"
  ]
 ],
 "s162.sec5.u10": [
  [
   "Has tornat a derrotar",
   "Machinedramon? Increïïïble."
  ]
 ],
 "s162.sec5.u11": [
  [
   "He, he, t'explicaré què hi ha",
   "fora de la ciutat. La volta el",
   "Bosc nadiu. Els Digimon d'allà",
   "no són gaire forts. Just a"
  ],
  [
   "l'oest hi ha el Gimnàs verd. Hi",
   "aniràs sovint, crec. Travessant",
   "el riu a l'est hi ha la Selva",
   "tropical. No sé què"
  ],
  [
   "hi ha més enllà. A l'oest, una",
   "muntanya i un llac tallen el",
   "pas, però potser hi ha més",
   "terres darrere. Molt al sud hi"
  ],
  [
   "ha el mar. Al nord hi ha una",
   "muntanya moooolt alta. Per",
   "aquests costats no es pot",
   "continuar. És tot el que sé."
  ],
  [
   "Però la ciutat és el centre de",
   "l'illa, així que crec que al",
   "nord hi ha més coses. Aniré",
   "buscant rumors de fora, així"
  ],
  [
   "que vine a escoltar-los de tant",
   "en tant."
  ]
 ],
 "s162.sec6.u0": [
  [
   "Mmm? He vingut a veure què tal",
   "està això, sí, senyor! El vàter",
   "no m'agrada, però la resta està",
   "bastant bé, sí, senyor!"
  ]
 ],
 "s162.sec7.u0": [
  [
   "Mmm... Sembla que aquí hi ha...",
   "bastant animació. Que si no",
   "hauria de tornar a Ciutat de",
   "les fàbriques... diu vostè? La"
  ],
  [
   "meva"
  ],
  [
   "funció de planificació opera",
   "amb normalitat. No hi ha cap",
   "problema."
  ]
 ],
 "s162.sec8.u0": [
  [
   "Oh, arribes en el moment just!",
   "Contempla aquesta estàtua!",
   "Eh? Oi? Quina obra d'art tan",
   "magnífica... És el que cal"
  ],
  [
   "esperar de mi. Mmm? Què",
   "passa? Què has dit!? Quèèè!?",
   "Et burles de mi!? I... què era",
   "el que volia dir? Mmm. Bé, és"
  ],
  [
   "igual."
  ]
 ],
 "s162.sec8.u1": [
  [
   "Mmmmm... Què dimonis...",
   "m'estava imaginant...? Ai. Si",
   "ho esbrines, m'ho diràs?"
  ]
 ],
 "s162.sec55.m0.o0": "A Ciutat de les fàbriques",
 "s162.sec55.m0.o1": "A la cova de la platja secreta",
 "s162.sec55.m0.o2": "Deixa-ho",
 "s162.sec55.u0": [
  [
   "Hola! Ha, ha, t'he espantat,",
   "oi? Portar tothom de viatge",
   "per mar: aquesta és la meva",
   "feina, saps? I tu? Et puc"
  ],
  [
   "portar a llocs on només",
   "s'arriba per mar. Bé, doncs..."
  ]
 ],
 "s162.sec55.u1": [
  [
   "Mmm, on anem? A Ciutat de les",
   "fàbriques... o potser a la cova",
   "de la cala?"
  ]
 ],
 "s162.sec57.u0": [
  [
   "T'he trobat!"
  ]
 ],
 "s162.sec57.u1": [
  [
   "Q-què!? Ve cap a nosaltres!?"
  ]
 ],
 "s162.sec57.u2": [
  [
   "Per fi ens veiem! Sóc Greymon,",
   "un rodamón. Anem al gra!"
  ]
 ],
 "s162.sec57.u3": "Què!?",
 "s162.sec57.u4": [
  [
   "Els rumors sobre vosaltres",
   "m'han portat fins aquí.",
   "Barallaràs amb mi! I si",
   "guanyo..."
  ],
  [
   "...el cartell d'aquesta ciutat",
   "serà meu!"
  ]
 ],
 "s162.sec57.u5": [
  [
   "Però si no hi ha cap cartell."
  ]
 ],
 "s162.sec57.u6": [
  [
   "M'és igual! Baralla!"
  ]
 ],
 "s162.sec57.u7": [
  [
   "He, ens ho has posat difícil...",
   "Gens malament. Però encara",
   "esteu verds per assolir el",
   "vostre objectiu!"
  ]
 ],
 "s162.sec57.u8": [
  [
   "Hmpf..."
  ]
 ],
 "s162.sec57.u9": [
  [
   "Em quedaré aquí per a",
   "posar-vos en forma. Sereu",
   "molt, molt més forts!"
  ]
 ],
 "s162.sec57.u10": "Greymon s'ha unit a la ciutat!",
 "s162.sec57.u11": [
  [
   "Je, je, per fi et trobo,",
   "{color 6}{player}{color 1}!"
  ]
 ],
 "s162.sec57.u12": [
  [
   "Un atac per sorpresa!?"
  ]
 ],
 "s162.sec57.u13": [
  [
   "El meu objectiu és",
   "derrotar-vos... i per a",
   "aconseguir-ho, usaré qualsevol",
   "mitjà!"
  ]
 ],
 "s162.sec57.u14": [
  [
   "...Aquests ulls! Algú l'està",
   "controlant!"
  ]
 ],
 "s162.sec57.u15": [
  [
   "Ngh... així... encara que em",
   "costi la vida...",
   "derrotar-los... aquestes",
   "eren... les meves ordres..."
  ]
 ],
 "s162.sec57.u16": [
  [
   "Però què dius? Així et moriràs",
   "de debò! Necessites que et",
   "curin, ràpid..."
  ]
 ],
 "s162.sec81.u0": "Zzz...",
 "s162.sec81.u1": [
  [
   "Sent, t'has assabentat? En la",
   "Selva tropical està creixent",
   "una planta molt estranya."
  ]
 ],
 "s162.sec81.u2": [
  [
   "Ah, és veritat! He plantat una",
   "{color 6}Planta pluja{color 1} aquí al costat.",
   "Dóna fruit cap al dia 15 de",
   "cada any. Agafa'n quan vulguis."
  ],
  [
   "Que per a què serveix? Per",
   "fer ploure, és clar."
  ]
 ],
 "s162.sec81.u3": [
  [
   "Aaah, quin gust! Fotosíntesi,",
   "fotosíntesi."
  ]
 ],
 "s162.sec81.u4": [
  [
   "Aaah, quin gust! Fotosíntesi,",
   "fotosíntesi."
  ]
 ],
 "s162.sec82.u0": [
  [
   "Uf... quina glòria, quina",
   "glòria."
  ]
 ],
 "s162.sec83.u0": [
  [
   "Oh, què és això...?"
  ]
 ],
 "s162.sec83.u1": [
  [
   "Portes massa objectes."
  ]
 ],
 "s162.sec83.u2": [
  [
   "Has aconseguit un fruit de",
   "{color 6}Planta pluja{color 1}!"
  ]
 ],
 "s162.sec254.u0": [
  [
   "Uuuf, ja sóc a caaasa!"
  ]
 ],
 "s162.sec254.u1": [
  [
   "Gràcies per tornar a",
   "cridar-me! Una altra vegada",
   "junts, {color 10}{partner}{color 1}!"
  ]
 ],
 "s162.sec254.u2": [
  [
   "{color 7}El teu Nivell de Domador ha pujat!{color 1}",
   ""
  ]
 ],
 "s162.sec254.u3": [
  [
   "{color 7}Enhorabona! Per les teves grans gestes, has rebut una medalla!{color 1}",
   ""
  ]
 ],
 "s162.sec254.u4": [
  [
   "Has aconseguit la carta de",
   "Machinedramon!"
  ]
 ],
 "s163.sec5.u0": [
  [
   "Bu. Bu-bu?"
  ]
 ],
 "s163.sec5.u1": [
  [
   "Com sempre... no li entenc ni",
   "una paraula."
  ]
 ],
 "s163.sec5.u2": [
  [
   "Eh? Ja, ja. Ah, ja veig, estàs",
   "fent la ronda per nosaltres."
  ]
 ],
 "s163.sec6.u0": [
  [
   "Je, je, je... Mira això: el meu",
   "propi tauler d'anuncis."
  ]
 ],
 "s163.sec6.u1": [
  [
   "Una ciutat que creix necessita",
   "notícies, oi? Així que he",
   "decidit escriure un diari! Sóc",
   "ben llest, eh?"
  ]
 ],
 "s163.sec6.u2": [
  [
   "Bé, tu espera i veuràs del que",
   "és capaç la meva xarxa de",
   "notícies."
  ]
 ],
 "s163.sec6.u3": [
  [
   "Hola! Estàs llegint el meu",
   "periòdic?"
  ]
 ],
 "s163.sec7.u0": [
  [
   "Aaah, quina fresqueta. Quan",
   "ets en un lloc agradable, també",
   "et puja l'ànim, oi?"
  ]
 ],
 "s163.sec7.u1": [
  [
   "Ji, ji, i bé? Què et sembla la",
   "meva botiga? No se'm dóna molt",
   "bé vendre, però ara mateix no",
   "hi ha ningú més que ho faci!"
  ],
  [
   "Afanya't i porta aquí a molts",
   "Digimon, val?"
  ]
 ],
 "s163.sec7.u2": [
  [
   "Ji, ji, i bé? Què et sembla?"
  ]
 ],
 "s163.sec7.u3": [
  [
   "{color 7}Coelamon {color 1}",
   "Ens hem ajuntat tots per a",
   "vendre objectes, saps?"
  ]
 ],
 "s163.sec8.u0": [
  [
   "Mmm. Aquí creixia una herba",
   "boníssima, així que me l'he",
   "menjat."
  ],
  [
   "Això sí, ara a la ciutat corre",
   "més aire."
  ]
 ],
 "s163.sec8.u1": [
  [
   "Ara que ho penso, l'altre dia",
   "em vaig trobar per casualitat",
   "una cosa anomenada {color 6}Bolet",
   "feliç{color 1}. Segons sembla, és"
  ],
  [
   "estranya."
  ]
 ],
 "s163.sec8.u2": [
  [
   "Diuen que també hi ha una cosa",
   "que es diu {color 6}Bolet de luxe{color 1}. Si",
   "en trobes un, sí que podràs",
   "presumir."
  ]
 ],
 "s163.sec8.u3": [
  [
   "Ara que ho penso, la {color 6}Poma",
   "blava{color 1} del Bosc nadiu està",
   "riquíssima."
  ]
 ],
 "s163.sec8.u4": [
  [
   "Ara que ho penso, el {color 6}Plàtan",
   "taronja{color 1} de la Selva tropical",
   "està riquíssim."
  ]
 ],
 "s163.sec8.u5": [
  [
   "Ara que ho penso, la {color 6}Maduixa",
   "grossa{color 1} de la Muntanya",
   "Panorama està riquíssima."
  ]
 ],
 "s163.sec8.u6": [
  [
   "Ara que ho penso, la {color 6}Castanya",
   "dolça{color 1} de la Sabana dels",
   "engranatges està riquíssima."
  ]
 ],
 "s163.sec8.u7": [
  [
   "Ara que ho penso, la",
   "{color 6}Superverdura{color 1} del Cementiri",
   "d'Overdell està riquíssima."
  ]
 ],
 "s163.sec8.u8": [
  [
   "Ara que ho penso, la {color 6}Baia",
   "vermella{color 1} de l'Antiga Regió",
   "Dino està riquíssima."
  ]
 ],
 "s163.sec8.u9": [
  [
   "Ara que hi penso, la {color 6}Figa",
   "palera{color 1} del Gran Canyó és",
   "boníssima."
  ]
 ],
 "s163.sec8.u10": [
  [
   "Ara que hi penso, la",
   "{color 6}Digipinya{color 1} del Bosc boirós és",
   "boníssima."
  ]
 ],
 "s163.sec8.u11": [
  [
   "Ara que ho penso, la {color 6}Herba",
   "espinosa{color 1} del Pantà Geko està",
   "riquíssima."
  ]
 ],
 "s163.sec8.u12": [
  [
   "Ara que hi penso, el {color 6}Bolet de",
   "gel{color 1} de Terra gelada és",
   "boníssim."
  ]
 ],
 "s163.sec8.u13": [
  [
   "Ara que ho penso, la {color 6}Gla d'or{color 1}",
   "de Terra dels escarabats està",
   "riquíssima."
  ]
 ],
 "s163.sec9.m0.o0": "Què passa?",
 "s163.sec9.m0.o1": "Més tard, d'acord?",
 "s163.sec9.u0": [
  [
   "Sent, escolta'm un moment."
  ]
 ],
 "s163.sec9.u1": [
  [
   "Has vist el pont de l'est?",
   "Està arreglat! Hem treballat",
   "moltíssim."
  ]
 ],
 "s163.sec9.u2": [
  [
   "Encara estem arreglant el Pont",
   "Digimon. Espera una miqueta",
   "més, val? Ah, i, saps?, diuen",
   "que al sud, en Cap Coela, hi"
  ],
  [
   "ha un Digimon molt estrany.",
   "Segons sembla apunta el cap un",
   "moment tots els dies, cap al",
   "capvespre."
  ]
 ],
 "s163.sec9.u3": [
  [
   "Saps el pont trencat que hi ha",
   "a l'est de la ciutat? Com que",
   "pensàvem que ningú l'usaria, el",
   "vam deixar així. Però ja no"
  ],
  [
   "podem, oi? Ens esforçarem per",
   "arreglar-lo nosaltres mateixos.",
   "Mentrestant, explora l'oest i",
   "el sud. Quan hagis fet un volt,"
  ],
  [
   "torna a veure'm."
  ]
 ],
 "s163.sec9.u4": [
  [
   "Has anat al Pantà Geko?"
  ],
  [
   "Diuen que allí hi ha un Digimon",
   "entremaliat que a vegades es",
   "fica amb tu."
  ]
 ],
 "s163.sec9.u5": [
  [
   "Sent, saps?, quan un Digimon",
   "digievoluciona, les seves",
   "tècniques equipades es",
   "reinicien. Així que no ho"
  ],
  [
   "oblidis!"
  ]
 ],
 "s163.sec9.u6": [
  [
   "Jo, quina pena."
  ]
 ],
 "s163.sec10.u0": [
  [
   "Què tal? He encès les llums. Hi",
   "ha prou llum?"
  ]
 ],
 "s163.sec10.u1": [
  [
   "Fem entre tots una ciutat",
   "radiant!"
  ]
 ],
 "s163.sec10.u2": [
  [
   "Que si canvia alguna cosa per",
   "encendre les llums?"
  ]
 ],
 "s163.sec10.u3": [
  [
   "Tot està en l'actitud!"
  ]
 ],
 "s163.sec11.u0": [
  [
   "Sóc el més fort... No em",
   "considero derrotat per tu.",
   "Vine al Coliseu i ho veuràs..."
  ]
 ],
 "s163.sec12.u0": [
  [
   "Ep, {color 6}{player}{color 1}! Patrullo la",
   "ciutat per si hi ha tipus",
   "sospitosos. Q-què passa? No",
   "t'estic molestant ni res!"
  ]
 ],
 "s163.sec81.u0": [
  [
   "Bé, benvingut a la meva botiga!",
   "A tu, {color 6}{player}{color 1}, t'ho deixo",
   "baratet. La veritat és que no",
   "se'm dóna gaire bé vendre."
  ],
  [
   "Però sembla que als altres",
   "tampoc... Per això em toca",
   "vendre objectes una temporada.",
   "Encantat de tenir-te per aquí."
  ],
  [
   "I tu, {color 6}{player}{color 1}, segueix",
   "així i porta molts Digimon de",
   "tornada!"
  ]
 ],
 "s163.sec81.u1": [
  [
