{
 "s122.sec5.u0": [
  [
   "Ah, m'has salvat!"
  ]
 ],
 "s122.sec5.u1": [
  [
   "Així que eres tu el que estava",
   "atrapat."
  ]
 ],
 "s122.sec5.u2": [
  [
   "Però això em ve de perles."
  ]
 ],
 "s122.sec5.u3": [
  [
   "El què?"
  ]
 ],
 "s122.sec5.u4": [
  [
   "Anava de camí a la teva ciutat,",
   "per a posar els meus talents al",
   "seu servei!"
  ]
 ],
 "s122.sec5.u5": [
  [
   "Això... quins talents?"
  ]
 ],
 "s122.sec5.u6": [
  [
   "Vaja, no em coneixes? Entre",
   "els Digimon sóc famós per",
   "saber-ho tot!"
