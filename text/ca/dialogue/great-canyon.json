 ],
 "s122.sec5.u7": [
  [
   "Doncs no. Mai he sentit parlar",
   "de tu."
  ]
 ],
 "s122.sec5.u8": [
  [
   "Bé, doncs me'n vaig a la",
   "ciutat."
  ]
 ],
 "s122.sec5.u9": [
  [
