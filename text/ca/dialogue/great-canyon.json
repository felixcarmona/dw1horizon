   "alguna cosa?"
  ]
 ],
 "s122.sec5.u10": [
  [
   "Bon dia tingui vostè!"
  ]
 ],
 "s122.sec5.u11": "Shellmon s'ha unit a la ciutat!",
 "s122.sec6.u0": [
  [
