{
 "s160.sec5.u0": [
  [
   "Deixa-m'ho a miii!"
  ]
 ],
 "s160.sec6.u0": [
  [
   "Abans hauràs de vèncer-me!"
  ]
 ],
 "s160.sec7.u0": [
  [
   "Ordres. No desobeir."
  ]
 ],
 "s160.sec8.u0": [
  [
   "Uoooooooooh!"
  ]
 ],
 "s160.sec9.u0": [
  [
   "Torna enrere."
  ]
 ],
 "s161.sec5.u0": [
  [
   "Haig de guiar-te!"
  ]
 ],
 "s161.sec6.u0": [
  [
   "Ara, penedeix-te dels teus",
   "pecats."
  ]
 ],
 "s161.sec7.u0": [
  [
   "Així que per fi has arribat",
   "fins aquí!"
  ]
 ],
 "s161.sec8.u0": [
  [
   "Fes el que et dic."
  ]
 ],
 "s161.sec9.u0": [
  [
   "No passaràs, encara que em",
   "costi la vida!"
  ]
 ],
 "s170.sec5.u0": [
  [
   "No. Alt."
  ]
 ],
 "s170.sec6.u0": [
  [
   "Així ho volen els déus..."
  ]
 ],
 "s170.sec7.u0": [
  [
   "Jo vigilo aquí."
  ]
 ],
 "s170.sec8.u0": [
  [
   "Creeees en els déus?"
  ]
 ],
 "s170.sec9.u0": [
  [
   "Gens de violència! La violència",
   "està malament!"
  ]
 ],
 "s172.sec5.u0": [
  [
   "Tu deixa-m'ho tot a miii!"
  ]
 ],
 "s172.sec6.u0": [
  [
   "Fuig d'aquí!"
  ]
 ],
 "s172.sec7.u0": [
  [
   "Com si poguessis parar-me!"
  ]
 ],
 "s172.sec8.u0": [
  [
   "Doncs vinga, endavant!"
  ]
 ],
 "s172.sec9.u0": [
  [
   "Vinga, ataca'm amb totes les",
   "teves forces!"
  ]
 ],
 "s179.sec5.u0": [
  [
   "Vine a buscar-me amb tot el",
   "que tinguis!"
  ]
 ],
 "s179.sec6.u0": [
  [
   "Si deixar passar, rebre reny."
  ]
 ],
 "s179.sec7.u0": [
  [
   "Últim treball d'avui."
  ]
 ],
 "s182.sec53.u0": [
  [
   "Així que... per fi has arribat",
   "fins aquí."
  ]
 ],
 "s182.sec53.u1": [
  [
   "Ets tu el capitost!?"
  ]
 ],
 "s182.sec53.u2": [
  [
   "Ho sento, però no. Sóc",
   "MetalGreymon!"
  ]
 ],
 "s182.sec53.u3": [
  [
   "Amb tu ja me les veuré",
   "després! Treu-te del mig!"
  ]
 ],
 "s182.sec53.u4": [
  [
   "Això no passarà. El meu treball",
   "és impedir que segueixis",
   "endavant."
  ]
 ],
 "s182.sec53.u5": [
  [
   "Uf... Volia estalviar forces,",
   "però aquest no em deixa..."
  ]
 ],
 "s182.sec53.u6": [
  [
   "Allà vaig!"
  ]
 ],
 "s182.sec53.u7": [
  [
   "Uf... Mmm... On estic...?"
  ]
 ],
 "s182.sec53.u8": [
  [
   "Has tornat en tu!"
  ]
 ],
 "s182.sec53.u9": [
  [
   "Això sembla... Je... Si el",
   "vences, potser ens tornarem a",
   "veure algun dia. Fins llavors,",
   "marxo."
  ]
 ],
 "s184.sec51.u0": [
  [
   "!!!"
  ]
 ],
 "s184.sec51.u1": [
  [
   "Un ou!"
  ],
  [
   "No serà de Machinedramon...?"
  ]
 ],
 "s184.sec51.u2": [
  [
   "Hala! Això pinta malament!?"
  ]
 ],
 "s184.sec51.u3": "Digitamamon s'ha unit a la ciutat!",
 "s184.sec51.u4": [
  [
   "!!!"
  ]
 ],
 "s184.sec51.u5": [
  [
   "A-aquí estàs! T'he trobat!"
  ]
 ],
 "s184.sec51.u6": [
  [
   "Així que tu ets el capitost!?"
  ]
 ],
 "s184.sec51.u7": [
  [
   "Je, je, je... Per fi tinc el",
   "plaer de conèixer-te. Sóc",
   "Analogman."
  ]
 ],
 "s184.sec51.u8": [
  [
   "Ho sé tot de tu... Mmm, vist de",
   "prop, no ets més que un mocós."
  ],
  [
   "Pensar que un mocós així ha",
   "arruïnat les meves ambicions...",
   "Gairebé tenia la Xarxa a la",
   "meva mà..."
  ]
 ],
 "s184.sec51.u9": [
  [
   "Sent, tu... ets un humà adult,",
   "no? Quines ambicions ni quines",
   "ambicions? Quina ximpleria!",
   "Estàs fotent a tothom!"
  ]
 ],
 "s184.sec51.u10": [
  [
   "Fotent? Als Digimon? Je, je,",
   "je, je..."
  ]
 ],
 "s184.sec51.u11": [
  [
   "Els Digimon només han de fer el",
   "que els manin els humans. El",
   "que a mi em plagui... com a",
   "eines!"
  ]
 ],
 "s184.sec51.u12": [
  [
   "T'equivoques! Els Digimon també",
   "tenen cor! Són tots els",
   "nostres amics!"
  ]
 ],
 "s184.sec51.u13": [
  [
   "Hmpf. Doncs vegem què és",
   "millor: els teus amics o les",
   "meves eines!"
  ]
 ],
 "s184.sec51.u14": [
  [
   "Et toca! El Digimon definitiu,",
   "el més fort... Machinedramon!"
  ]
 ],
 "s184.sec51.u15": [
  [
   "Ho hem aconseguit, ho hem",
   "aconseguit, {color 10}{partner}{color 1}!"
  ]
 ],
 "s184.sec51.u16": [
  [
   "Im... impossible! La meva arma",
   "més poderosa!"
  ]
 ],
 "s184.sec51.u17": [
  [
   "Ho veus? El que s'equivocava",
   "eres tu."
  ]
 ],
 "s184.sec51.u18": [
  [
   "Oh... ohhh..."
  ]
 ],
 "s184.sec51.u19": [
  [
   "...Escolta. Deixa l'illa com",
   "estava i demana perdó a tots",
   "els de la ciutat, i et",
   "perdonaré. Segur que ells"
  ],
  [
   "també..."
  ]
 ],
 "s184.sec51.u20": [
  [
   "Je... je, je... Així és. No es",
   "pot confiar en els Digimon...",
   "Només puc confiar en el meu",
   "propi poder..."
  ]
 ],
 "s184.sec51.u21": [
  [
   "Eh! Què estàs fent!?"
  ]
 ],
 "s184.sec51.u22": [
  [
   "{color 7}Analogman {color 1}",
   "Volaré aquest lloc per l'aire i",
   "escaparé a un altre món... Mala",
   "sort, mocós!"
  ]
 ],
 "s184.sec51.u23": [
  [
   "Oh, no! No pot fer això!"
  ]
 ],
 "s184.sec51.u24": [
  [
   "{color 7}Analogman {color 1}",
   "Je, ja, ja, ja, ja! Adéu!"
  ]
 ],
 "s184.sec51.u25": [
  [
   "Maleït sigui! Ho sento,",
   "amics..."
  ]
 ],
 "s184.sec51.u26": [
  [
   "{color 7}??? {color 1}",
   "No passa res."
  ]
 ],
 "s184.sec51.u27": [
  [
   "Eh...?"
  ]
 ],
 "s184.sec51.u28": [
  [
   "{color 7}Analogman {color 1}",
   "Què...? La transferència no",
   "comença... A-alguna cosa va",
   "malament... el programa... Què"
  ],
  [
   "{color 7}Analogman {color 1}",
   "és això!?"
  ]
 ],
 "s184.sec51.u29": [
  [
   "Sento... les veus de tots...!"
  ]
 ],
 "s184.sec51.u30": [
  [
   "{color 7}Jijimon {color 1}",
   "Us estem enviant les nostres",
   "forces ara mateix."
  ]
 ],
 "s184.sec51.u31": [
  [
   "{color 7}Tokomon {color 1}",
   "Ens sentiu?"
  ]
 ],
 "s184.sec51.u32": [
  [
   "{color 7}Agumon {color 1}",
   "Hem arribat just a temps!"
  ]
 ],
 "s184.sec51.u33": [
  [
   "Amics..."
  ]
 ],
 "s184.sec51.u34": [
  [
   "{color 7}Analogman {color 1}",
   "Impossible... A aquest pas...",
   "No... A-ajuda... Ugh...",
   "Aaaaaaaaaaahhh!!!"
  ]
 ],
 "s184.sec51.u35": [
  [
   "Ha desaparegut!? Què li ha",
   "passat?"
  ]
 ],
 "s184.sec51.u36": [
  [
   "{color 7}Jijimon {color 1}",
   "No ho sé. Però així i tot..."
  ]
 ],
 "s184.sec51.u37": [
  [
   "Ah, és veritat! Jijimon, em",
   "sents? Aquest lloc explotarà!",
   "Fes alguna cosa!!!"
  ]
 ],
 "s184.sec51.u38": [
  [
   "{color 7}Jijimon {color 1}",
   "Mmm. Ja hauria de ser aquí, no",
   "creus?"
  ]
 ],
 "s184.sec51.u39": [
  [
   "Airdramon!!!"
  ]
 ],
 "s184.sec51.u40": [
  [
   "Ràpid, puja!"
  ]
 ],
 "s184.sec51.u41": [
  [
   "Analogman havia desaparegut..."
  ]
 ],
 "s184.sec51.u42": [
  [
   "La pau va tornar a l'Illa",
   "File..."
  ]
 ],
 "s184.sec51.u43": [
  [
   "I llavors..."
  ]
 ]
}
