{
 "s173.sec6.u0": [
  [
   "Bé... Descansar sovint per",
   "treure's el cansament és el",
   "secret de la bona salut."
  ]
 ],
 "s173.sec6.u1": [
  [
   "T'explico com creix la",
   "prosperitat? Un Novell que",
   "arriba a la ciutat suma 1, un",
   "Campió suma 2 i un Perfecte"
  ],
  [
   "suma 3, segons diuen. Però",
   "tres dels Campions, els menys",
   "útils, només sumen 1."
  ]
 ],
 "s173.sec6.u2": [
  [
   "Bé, bo, et parlo dels tipus?"
  ],
  [
   "Primer, els enemics del mateix",
   "tipus que el teu company rares",
   "vegades s'uneixen a un combat."
  ],
  [
   "I hi ha dos llocs que et",
   "tanquen la porta si el teu",
   "tipus no és l'adequat."
  ],
  [
   "A part d'això, bo, no fa falta",
   "que et preocupis molt, jovenet."
  ]
 ],
 "s173.sec6.u3": [
  [
   "T'explico el nivell de domador?",
   "Si cries un Digimon fins a",
   "Perfecte, segur que puges un",
   "nivell. També ajuda guanyar"
  ],
  [
   "tornejos d'alt grau. Puja tot",
   "sol, sense pensar-hi gaire.",
   "Vigila que no baixi: perdre",
   "totes les vides el fa baixar"
  ],
  [
   "segur. És rar, però els errors",
   "de cura també el poden fer",
   "baixar. Estigues atent!"
  ]
 ]
}
