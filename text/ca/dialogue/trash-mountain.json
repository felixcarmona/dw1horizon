 ],
 "s158.sec8.u0": [
  [
   "Bopiiii!"
  ]
 ],
 "s158.sec9.u0": [
  [
   "De debò això és tot el que",
   "tens?"
  ]
 ],
 "s158.sec10.u0": [
  [
   "Vés a rentar-te la cara i",
   "torna a intentar-ho!"
  ]
 ],
 "s159.sec6.m0.o0": "Intercanviar",
 "s159.sec6.m0.o1": "No intercanviar",
 "s159.sec6.u0": [
  [
   "Mmm, col·lecciono cartes",
   "Digimon. Vull una carta de",
   "KingSukamon. Me la canvies per",
   "una d'Etemon?"
  ]
 ],
 "s159.sec6.u1": [
  [
   "Ho sento, no en tinc cap."
  ]
 ],
 "s159.sec6.u2": [
  [
   "Puaj, quina pesta... Això és un",
   "abocador? Així que al món",
   "Digimon també n'hi ha."
  ]
 ],
 "s159.sec6.u3": [
  [
   "Mmm? Benvinguts! Aquí els nous",
   "amics sempre són benvinguts, sí",
   "senyor!"
  ]
 ],
 "s159.sec6.u4": [
  [
   "Això és un poble de la tribu",
   "Sukamon?"
  ]
 ],
 "s159.sec6.u5": [
  [
   "Així és. Això és el paradís",
   "dels Sukamon, el Regne Dust.",
   "Aquí també viu Sa Majestat",
   "KingSukamon."
  ]
 ],
 "s159.sec6.u6": [
  [
   "KingSukamon..."
  ]
 ],
 "s159.sec6.u7": [
  [
   "Sa Majestat és increïble. Si li",
   "portes la contrària, et",
   "converteix en una altra",
   "espècie!"
  ]
 ],
 "s159.sec6.u8": [
  [
   "Hala!? És a dir, que deixaries",
   "de ser un Sukamon? Llavors...",
   "també pot retornar-te a com",
   "eres!?"
  ]
 ],
 "s159.sec6.u9": [
  [
   "Sí... mmm, és una història que",
   "fa por. Horrible."
  ]
 ],
 "s159.sec6.u10": [
  [
   "Que bé saber-ho!"
  ]
 ],
 "s159.sec6.u11": [
  [
   "Eh, un Sukamon!?"
  ]
 ],
 "s159.sec6.u12": [
  [
   "Mmm? Saps qui sóc?"
  ]
 ],
 "s159.sec6.u13": [
  [
   "B-bé, més o menys. Mmm, també",
   "hem de portar els Sukamon a la",
   "ciutat...?"
  ]
 ],
 "s159.sec6.u14": [
  [
   "Mmm? Vagi, això sí que no es",
   "veu tots els dies, sí, senyor!"
  ]
 ],
 "s159.sec6.u15": [
  [
   "Puaj, la caca es mou i parla!"
  ]
 ],
 "s159.sec6.u16": [
  [
   "Mmm? Ho dius per mi? Sóc",
   "Sukamon, un Digimon mutant."
  ]
 ],
 "s159.sec6.u17": [
  [
   "És a dir, que no ets caca?"
  ]
 ],
 "s159.sec6.u18": [
  [
   "En certa manera, sí. Estem",
   "fets de restes de dades",
   "digitals."
  ]
 ],
 "s159.sec6.u19": [
  [
   "Mmm... També el convidem a la",
   "ciutat? Bé, no està bé",
   "discriminar."
  ]
 ],
 "s159.sec6.u20": [
  [
   "Penseu viure aquí?"
  ]
 ],
 "s159.sec6.u21": [
  [
   "Eh? Ni se m'havia passat pel",
   "cap."
  ]
 ],
 "s159.sec6.u22": [
  [
   "Mmm, això és un paradís només",
   "per a la tribu Sukamon. Em sap",
   "greu, però aquí no hi poden",
   "viure altres espècies, sí"
  ],
  [
   "senyor."
  ]
 ],
 "s159.sec6.u23": [
  [
   "Llavors, vosaltres no podeu",
   "viure en cap altre lloc?"
  ]
 ],
 "s159.sec6.u24": [
  [
   "Doncs clar!"
  ]
 ],
 "s159.sec6.u25": [
  [
   "Ah, clar, ja m'ho imaginava...",
   "Uf."
  ]
 ],
 "s159.sec6.u26": [
  [
   "Mmm? Aquí no podeu viure, però",
   "podeu donar un cop d'ull,",
   "distingits convidats, sí,",
   "senyor."
  ]
 ],
 "s159.sec6.u27": [
  [
   "Ah, sí. Només estem mirant."
  ]
 ],
 "s159.sec6.u28": [
  [
   "Ah, per cert: no enfadeu Sa",
   "Majestat. Si la seva màgia us",
   "converteix en una cosa penosa,",
   "no em tireu la culpa, sí"
  ],
  [
   "senyor!"
  ]
 ],
 "s159.sec6.u29": [
  [
   "Eh, eh, tens massa cartes de",
   "Etemon! Millor no."
  ]
 ],
 "s159.sec6.u30": [
  [
   "Oh, gràcies!"
  ]
 ],
 "s159.sec7.u0": [
  [
   "Mmm, escolteu. Veniu d'aquesta",
   "ciutat o com es digui? Entre",
   "nosaltres, em té una mica",
   "intrigat. Un dia d'aquests hi"
  ],
  [
   "passaré."
  ]
 ],
 "s159.sec7.u1": [
  [
   "Mmm? Sent, vosaltres. Sabeu",
   "quin és el talent especial de",
   "la tribu Sukamon?"
  ],
  [
   "Fiquem en el cos la caca que hi",
   "ha en el camí i la convertim en",
   "energia!"
  ]
 ],
 "s159.sec8.u0": [
  [
   "Mmm? Això és el Regne Dust.",
   "Per a tu segur que és només",
   "un munt d'escombraries."
  ],
  [
   "Però pot ser que hi hagi coses",
   "útils per aquí."
  ],
  [
   "Ara que ho penso, per allí he",
   "vist alguna cosa com un pal",
   "llarg, sí, senyor."
  ]
 ],
 "s159.sec51.u0": [
  [
   "Eh, una {color 6}Canya vella{color 1}!"
  ]
 ],
 "s159.sec81.m0.o0": "Volem viure aquí",
 "s159.sec81.m0.o1": "Fes-lo tornar a ser com era!",
 "s159.sec81.u0": [
  [
   "Hmpf! Una altra vegada tu!",
   "Fora de la meva vista!"
  ]
 ],
 "s159.sec81.u1": [
  [
   "Això..."
  ]
 ],
 "s159.sec81.u2": [
  [
   "Bah, quin pesat! Ja està!",
   "Content?"
  ]
 ],
 "s159.sec81.u3": [
  [
   "Hmpf! Una altra vegada tu!",
   "Fora de la meva vista!"
  ]
 ],
 "s159.sec81.u4": [
  [
   "Mmm! Benvingut, germà Sukamon.",
   "Si desitges viure aquí, et",
   "concedeixo el meu permís."
  ]
 ],
 "s159.sec81.u5": [
  [
   "Mmm! Molt bé, molt bé. Mm? Tu",
   "no, criatura analògica."
  ]
 ],
 "s159.sec81.u6": [
  [
   "Hem d'estar junts!"
  ]
 ],
 "s159.sec81.u7": [
  [
   "Hmpf, doncs fora d'aquí, junts!"
  ]
 ],
 "s159.sec81.u8": [
  [
   "Q-què? Què estàs dient?"
  ]
 ],
 "s159.sec81.u9": [
  [
   "Ell no era un Sukamon abans.",
   "Rei, si us plau, fes-lo tornar",
   "a ser com era!"
  ]
 ],
 "s159.sec81.u10": [
  [
   "Però no és meravellós? Ha",
   "arribat a ser un Sukamon."
  ]
 ],
 "s159.sec81.u11": [
  [
   "No, ara mateix és un problema.",
   "Si us plau!"
  ]
 ],
 "s159.sec81.u12": [
  [
   "Si creus que un es converteix",
   "en Sukamon així, sense més,",
   "estàs molt equivocat! Només qui",
   "s'esforça arriba a ser Sukamon!"
  ]
 ],
 "s159.sec81.u13": [
  [
   "Doncs ell s'ha convertit en",
   "Sukamon així, sense més.",
   "Aquest és el problema..."
  ]
 ],
 "s159.sec81.u14": [
  [
   "Hmpf, no tens remei! Prou!",
   "Això és el que mereixes!"
  ]
 ],
 "s159.sec81.u15": [
  [
   "Hala, gràcies, Rei!"
  ]
 ],
 "s159.sec81.u16": [
  [
   "I ara, fora de la meva vista!"
  ]
 ],
 "s159.sec81.u17": [
  [
   "Hmpf! Què se t'ofereix?"
  ]
 ],
 "s159.sec81.u18": [
  [
   "Això..."
  ]
 ],
 "s159.sec81.u19": [
  [
   "Hmpf, no atenc peticions! Sóc",
   "el rei dels Sukamon, i només",
   "dels Sukamon!"
  ]
 ],
 "s159.sec81.u20": [
  [
   "Així doncs, no el puc convidar",
   "a la ciutat..."
  ]
 ],
