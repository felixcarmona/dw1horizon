   "Grrraaaaaaah!"
  ]
 ],
 "s076.sec7.u0": [
  [
   "Molt bééé, allà vaig!"
  ]
 ],
 "s076.sec8.u0": [
  [
   "Ssssssss!"
  ]
 ],
 "s076.sec9.u0": [
  [
   "Bzzzzzz!"
  ]
 ],
 "s076.sec51.u0": [
  [
   "I tu qui nassos ets!? Aquí no",
   "es fica ningú mentre jo estigui",
   "de guàrdia!"
  ]
 ],
 "s076.sec51.u1": [
  [
   "No, si estem recorrent l'illa",
   "per a salvar-la..."
  ]
 ],
 "s076.sec51.u2": [
  [
   "Et creus que m'empassaré una",
   "mentida tan ximple? Té!"
  ]
 ],
 "s076.sec51.u3": [
  [
   "E-eh, espera...!"
  ]
 ],
 "s076.sec51.u4": [
  [
   "Un moment... dius la veritat?"
  ]
 ],
 "s076.sec51.u5": [
  [
   "És el que t'estic dient!"
  ]
 ],
 "s076.sec51.u6": [
  [
   "Je, perdona. Per aquí gairebé",
   "mai vénen forasters. Era el meu",
   "primer treball en segles i m'he",
   "vingut a dalt."
  ]
 ],
 "s076.sec51.u7": [
  [
   "Treball?"
  ]
 ],
 "s076.sec51.u8": [
  [
   "Sí. Jo vigilo aquest lloc,",
   "l'Antiga Regió Dino, la terra",
   "més remota de l'illa!"
  ]
 ],
 "s076.sec51.u9": [
  [
   "Vaja... Doncs ens podries",
   "ensenyar el lloc?"
  ]
 ],
 "s076.sec51.u10": [
  [
   "L'Antiga Regió Dino es divideix",
   "en dues grans parts. Primer,",
   "on vivim els Digimon dinosaure:",
   "la Regió Glacial. És un lloc"
  ],
  [
   "especial on el temps passa més",
   "a poc a poc."
  ]
 ],
 "s076.sec51.u11": [
  [
   "El temps passa més a poc a",
   "poc...? Que estrany."
  ]
 ],
 "s076.sec51.u12": [
  [
   "I l'altra és la Regió Speedy.",
   "És una zona perillosa que està",
   "passada la Regió Glacial. Que",
   "per què és perillosa? Perquè"
  ],
  [
   "allí el temps passa rapidíssim.",
   "Per això la terra està tota",
   "desgastada, amb ossos i fòssils",
   "tirats pertot arreu."
  ]
 ],
 "s076.sec51.u13": [
  [
   "Clar, perquè allí ha passat més",
   "temps que en cap altre lloc."
  ]
 ],
 "s076.sec51.u14": [
  [
   "Exacte. Si no vols morir, no",
   "t'acostis. ...Encara que tampoc",
   "et deixaria passar, que per a",
   "això estic jo tallant el camí."
  ]
 ],
 "s076.sec51.u15": [
  [
   "Però si acabes de perdre",
   "contra nosaltres."
  ]
 ],
 "s076.sec51.u16": [
  [
   "Argh... Ha estat sort!",
   "Normalment no passa!"
  ]
 ],
 "s076.sec51.u17": [
  [
   "Si tu ho dius..."
  ]
 ],
 "s076.sec51.u18": [
  [
   "B-bé... Hauria de tornar al",
   "meu lloc! Per a la resta,",
   "pregunta als Digimon d'aquí.",
   "Fins aviat!"
  ]
 ]
}
