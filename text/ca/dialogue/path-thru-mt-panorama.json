{
 "s019.sec5.u0": [
  [
   "D'aquí no passa ningú!"
  ]
 ],
 "s019.sec6.u0": [
  [
   "M'ho quedaré tot!"
  ]
 ],
 "s019.sec7.u0": [
  [
   "Em temo que no puc deixar-te",
   "passar."
  ]
 ],
 "s019.sec8.u0": [
  [
   "Et creus que pots guanyar? No",
   "em facis riure!"
  ]
 ],
 "s019.sec9.u0": [
  [
   "Et deixaré sense res!"
  ]
 ],
 "s019.sec10.u0": [
  [
   "Et doblegaré com un paper!"
  ]
 ],
 "s019.sec11.u0": [
  [
   "De debò, ja no puc més!"
  ]
 ],
 "s019.sec12.u0": [
  [
   "Vols que acabi amb tu?"
  ]
 ],
 "s021.sec5.u0": [
  [
   "Quina crueltat!"
  ]
 ],
 "s021.sec6.u0": [
  [
   "Deixa alguna cosa aquí, home,",
   "no siguis així!"
  ]
 ],
 "s021.sec7.u0": [
  [
   "Veuràs, col·lega!"
  ]
 ],
 "s021.sec8.u0": [
  [
   "Alt aquí!"
  ]
 ]
}
