   "No saps quin és el teu lloc!"
  ]
 ],
 "s010.sec7.u0": [
  [
   "Però què t'he fet jo!?"
  ]
 ],
 "s010.sec8.m0.o0": "Pagar",
 "s010.sec8.m0.o1": "No pagar",
 "s010.sec8.u0": [
  [
   "Uk-uk-uuuk!"
  ],
  [
   "Que què faig aquí, dius!?"
  ],
  [
   "Escolta, {color 6}{player}{color 1}! Vaig",
   "intentar muntar-me el meu",
   "harem en la ciutat i em van",
   "tirar!"
  ]
 ],
 "s010.sec8.u1": [
  [
   "Tsc... Ah, sí. Diuen que ara",
   "nedes en diners, oi? Et vendré",
   "una cosa bonica, uk! La més",
   "rara del món: el {color 6}Plàtan d'or{color 1}."
  ],
  [
   "Només 50000 Bits! No fio, uk."
  ]
 ],
 "s010.sec8.u2": [
  [
   "Estàs ximple? Portes massa",
   "coses!"
  ]
 ],
 "s010.sec8.u3": [
  [
   "Ups! Porto la bossa plena."
  ]
 ],
 "s010.sec8.u4": [
  [
   "Uk, un plaer fer negocis amb",
   "tu!"
  ]
 ],
 "s010.sec8.u5": [
  [
   "Els diners no serveixen de res",
   "si no els gastes, company."
  ]
 ],
 "s010.sec51.m0.o0": "D'acord",
 "s010.sec51.m0.o1": "Un altre dia",
 "s010.sec51.u0": [
  [
