   "Atura't aquí mateeeix!!!"
  ]
 ],
 "s010.sec51.u1": [
  [
   "Aquest humil servidor es diu",
   "Ninjamon!"
  ]
 ],
 "s010.sec51.u2": [
  [
   "Deveu ser {color 6}{player}{color 1}... i",
