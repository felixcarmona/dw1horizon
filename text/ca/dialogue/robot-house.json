{
 "s140.sec5.m0.o0": "Sí",
 "s140.sec5.m0.o1": "No",
 "s140.sec5.u0": [
  [
   "Però què...!?"
  ]
 ],
 "s140.sec5.u1": [
  [
   "Ah, benvingut a casa,",
   "Hagurumon!"
  ]
 ],
 "s140.sec5.u2": [
  [
   "Hagurumon!?"
  ]
 ],
 "s140.sec5.u3": [
  [
   "Què està passant!?"
  ]
 ],
 "s140.sec5.u4": [
  [
   "{color 7}Joguines {color 1}",
   "\"Aquesta és una història de fa",
   "molt de temps. Un malvat de",
   "molt lluny va arribar a aquesta"
  ],
  [
   "{color 7}Joguines {color 1}",
   "illa.\""
  ]
 ],
 "s140.sec5.u5": [
  [
   "{color 7}Joguines {color 1}",
   "\"El malvat va dir als Digimon:",
   "Aquesta illa és meva.\""
  ]
 ],
 "s140.sec5.u6": [
  [
   "{color 7}Joguines {color 1}",
   "\"Els Digimon van dir al malvat:",
   "No és veritat. Aquesta illa és",
   "de tothom.\""
  ]
 ],
 "s140.sec5.u7": [
  [
   "{color 7}Joguines {color 1}",
   "\"El van desafiar a lluitar. Els",
   "Digimon van unir forces i el",
   "malvat va rebre el seu càstig.\""
  ]
 ],
 "s140.sec5.u8": [
  [
   "{color 7}Joguines {color 1}",
   "\"Però el malvat va dir: Ja",
   "veureu! I va marxar a algun",
   "lloc.\""
  ]
 ],
 "s140.sec5.u9": [
  [
   "{color 7}Joguines {color 1}",
   "\"Aquesta és una història de fa",
   "molt de temps.\""
  ]
 ],
 "s140.sec5.u10": [
  [
   "Iupiii... Que content que",
   "estic... Ui, no! Aquesta cançó",
   "parlava del passat de l'illa,",
   "oi? Els Digimon van vèncer un"
  ],
  [
   "malvat fa molt de temps...",
   "Mmm... Un malvat... Qui devia",
   "ser?"
  ]
 ],
 "s140.sec5.u11": [
  [
   "Gràcies per salvar-nos. Això",
   "és un regalet d'agraïment."
  ]
 ],
 "s140.sec5.u12": [
  [
   "El Monzaemon de peluix s'ha",
   "unit a la ciutat!"
  ]
 ],
 "s140.sec5.u13": [
  [
   "Escolta, no li ha caigut alguna",
   "cosa a WaruMonzaemon?"
  ]
 ],
 "s140.sec5.u14": [
  [
   "Sort! És la casa del costat!"
  ]
 ],
 "s140.sec5.u15": [
  [
   "......"
  ]
 ],
 "s140.sec5.u16": [
  [
   "Vols sentir el nostre cor una",
   "altra vegada?"
  ]
 ],
 "s140.sec5.u17": [
  [
   "Ah, Monzaemon! Has tornat a",
   "la vida!"
  ]
 ],
 "s140.sec5.u18": [
  [
   "Hala, i això què és?"
  ]
 ],
 "s140.sec5.u19": [
  [
   "Corre, venç WaruMonzaemon!",
   "Tothom ha deixat de moure's!",
   "Ràpid, ràpid!"
  ]
 ],
 "s140.sec5.u20": [
  [
   "E-espera un moment! Aquest",
   "no és el Monzaemon que tu",
   "coneixes."
  ]
 ],
 "s140.sec5.u21": [
  [
   "Eh? Ai, caram. Però continua",
   "sent Monzaemon, oi?"
  ]
 ],
 "s140.sec5.u22": [
  [
   "Bé... Monzaemon sí que és."
  ]
 ],
 "s140.sec5.u23": [
  [
   "Doncs, si us plau! Un tipus",
   "moooolt dolent anomenat",
   "WaruMonzaemon ha segrestat el",
   "meu amic."
  ]
 ],
 "s140.sec5.u24": [
  [
   "Monzaemon deu ser l'únic que el",
   "pot vèncer!"
  ]
 ],
 "s140.sec5.u25": [
  [
   "Mmm... Això no ho puc",
   "consentir. Val, on està?"
  ]
 ],
 "s140.sec5.u26": [
  [
   "És a la casa del costat.",
   "Trencaré el segell de la porta,",
   "així que vés a veure'l!"
  ]
 ],
 "s140.sec5.u27": [
  [
   "Entesos. Et donarem un cop de",
   "mà!"
  ]
 ],
