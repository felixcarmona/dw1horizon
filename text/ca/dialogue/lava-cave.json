{
 "s031.sec51.u0": [
  [
   "!"
  ]
 ],
 "s031.sec51.u1": [
  [
   "Quan va començar a canviar",
   "aquesta illa...? Dia a dia les",
   "espècies es distancien...",
   "perden la memòria i es tornen"
  ],
  [
   "salvatges... Ni jo sé quant",
   "temps conservaré la raó... Això",
   "no pot seguir així! Cal fer-los",
   "veure què passa a l'illa!"
  ],
  [
   "Encara que hagi de ser una",
   "mica brusc..."
  ]
 ],
 "s031.sec51.u2": [
  [
   "Para! És que vols destrossar",
   "l'illa!?"
  ]
 ],
 "s031.sec51.u3": [
  [
   "Qui ets!? No t'interposis! És",
   "l'únic camí que queda!"
  ]
 ],
 "s031.sec51.u4": [
  [
   "Ah... ah... Insensat... M'estàs",
   "dient que hi ha un altre camí?"
  ]
 ],
 "s031.sec51.u5": [
  [
   "Si l'illa queda destrossada, de",
   "què serveix!? Escolta'm un",
   "moment."
  ]
 ],
 "s031.sec51.u6": [
  [
   "Què has dit...?"
  ]
 ],
 "s031.sec51.u7": [
  [
   "Estem construint una ciutat",
   "per a l'illa i reunint Digimon",
   "de tot arreu. Diuen que si els",
   "Digimon s'uneixen, podrem fer"
  ],
  [
   "alguna cosa per resoldre la",
   "crisi de l'illa."
  ]
 ],
 "s031.sec51.u8": [
  [
   "Mmm... Crec que aquesta idea",
   "és encertada. Però reunir els",
   "Digimon de tota l'illa..."
  ]
 ],
 "s031.sec51.u9": [
  [
   "És el que estem fent ara",
   "mateix. No és impossible!"
  ]
 ],
 "s031.sec51.u10": [
  [
   "Però què... Una història tan",
   "grandiosa... Com la creuré...?"
  ],
  [
   "I no obstant això, el meu cor",
   "dubta... Potser tu... siguis",
   "capaç d'aconseguir-ho..."
  ]
 ],
 "s031.sec51.u11": [
  [
   "Si creus en nosaltres, vine a",
   "la ciutat."
  ]
 ],
 "s031.sec51.u12": [
  [
   "...Molt bé. Aniré a la ciutat.",
   "Aquest ha de ser el meu nou",
   "camí!"
  ]
 ],
 "s031.sec51.u13": "Meramon s'ha unit a la ciutat!",
 "s031.sec51.u14": [
  [
   "Què estrany... Sempre vaig",
   "sentir que tornaries aquí...",
   "Vull una resposta!"
  ]
 ],
 "s031.sec51.u15": [
  [
   "Així que... he perdut, després",
   "de tot..."
  ]
 ],
 "s031.sec51.u16": [
  [
   "Hi ha alguna cosa que vull que",
   "escoltis."
  ]
 ],
 "s033.sec5.u0": [
  [
   "Que encara fa calor, dius? Sí,",
   "un Digimon que no aguanti la",
   "calor es podria posar malalt."
  ]
 ],
 "s033.sec6.u0": [
  [
   "La lava ja s'ha endurit del",
   "tot! Hmpf!"
  ]
 ],
 "s119.sec5.u0": [
  [
   "Eh! Què tal?"
  ]
 ],
 "s121.sec5.m0.o0": "Donar-ho",
 "s121.sec5.m0.o1": "Quedar-m'ho",
 "s121.sec5.u0": [
  [
   "Hola, hola! Coneixes les cartes",
   "Digimon?"
  ],
  [
   "Col·lecciono cartes de Meramon.",
   "Si em portes una, te la compro",
   "per 1500 Bits!"
  ]
 ],
 "s121.sec5.u1": [
  [
   "Hala, quina il·lusió! Gràcies!"
  ]
 ]
}
