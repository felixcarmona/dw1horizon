{
 "s136.sec6.u0": [
  [
   "Espera!"
  ]
 ],
 "s136.sec6.u1": [
  [
   "Ni boig t'espero!"
  ]
 ],
 "s136.sec6.u2": [
  [
   "Gua, ja, ja, ja!"
  ]
 ],
 "s136.sec6.u3": [
  [
   "Uy, quin esglai m'has donat!"
  ]
 ],
 "s136.sec6.u4": [
  [
   "Ben fet, Whamon! És la nostra",
   "oportunitat!"
  ]
 ],
 "s136.sec6.u5": [
  [
   "Vinga, rendiu-vos!"
  ]
 ],
 "s136.sec6.u6": [
  [
   "Ngh, nnngh..."
  ]
 ],
 "s136.sec6.u7": [
  [
   "Vine a la ciutat i treballa per",
   "compensar el que has fet."
  ]
 ],
 "s136.sec6.u8": [
  [
   "V-val... Aniré a la ciutat..."
  ]
 ],
 "s136.sec6.u9": [
  [
   "Buahaha, com si hi hagués",
   "d'anar! Adéééu!"
  ]
 ],
 "s136.sec6.u10": [
  [
   "Argh, me l'ha colat! Grrr."
  ]
 ],
 "s136.sec6.u11": [
  [
   "En fi. Almenys hem recuperat la",
   "cova, així que val més això que",
   "res."
  ]
 ],
 "s136.sec6.u12": [
  [
   "Ja està. Crec que la cova ja",
   "és segura."
  ]
 ],
 "s136.sec6.u13": [
  [
   "...... Sembla que de debò tens",
   "bon cor. Aquesta colla acabarà",
   "veient els seus errors."
  ]
 ],
 "s136.sec6.u14": [
  [
   "M'agradaria que et quedessis el",
   "meu tresor. És al fons."
  ]
 ],
 "s136.sec6.u15": [
  [
   "Eh? Espera, aquest és el teu",
   "tresor, no? No puc",
   "acceptar-ho."
  ]
 ],
 "s136.sec6.u16": [
  [
   "No, ja no el necessito. He",
   "decidit que vull anar a la teva",
   "ciutat."
  ]
 ],
 "s136.sec6.u17": [
  [
   "Eh? I això de sobte? Llavors",
   "no ha servit de res recuperar",
   "la cova!"
  ]
 ],
 "s136.sec6.u18": [
  [
   "Em sap greu si et molesta.",
   "Però vull correspondre a la",
   "teva bondat. De debò vull",
   "ajudar."
  ]
 ],
 "s136.sec6.u19": [
  [
   "Ja veig. Gràcies. Tu també ets",
   "un bon tipus."
  ]
 ],
 "s136.sec6.u20": [
  [
   "Doncs aniré directe a la",
   "ciutat. Et portaré un tros del",
   "camí."
  ]
 ],
 "s136.sec6.u21": "Whamon s'ha unit a la ciutat!",
 "s136.sec60.u0": [
  [
   "Se sent una veu al fons...",
   "Aquesta veu!"
  ]
 ],
 "s136.sec81.m0.o0": "Tornar",
 "s136.sec81.m0.o1": "No tornar",
 "s136.sec81.u0": [
  [
   "Tornes a la ciutat?"
  ]
 ],
 "s137.sec51.u0": [
  [
   "Oh, oh!"
  ]
 ],
 "s137.sec51.u1": [
  [
   "Mm?"
  ]
 ],
 "s137.sec51.u2": [
  [
   "Guah!?"
  ]
 ],
 "s137.sec51.u3": [
  [
   "C-cap, tenim problemes!"
  ]
 ],
 "s137.sec51.u4": [
  [
   "Què esteu tramant!?"
  ]
 ],
 "s137.sec51.u5": [
  [
   "Gue, he, he, així que has",
   "trobat la Nova Fortalesa dels",
   "ogres, eh?"
  ]
 ],
 "s137.sec51.u6": [
  [
   "Planejant més malifetes!?"
  ]
 ],
 "s137.sec51.u7": [
  [
   "Doncs clar! Gui, ji, ji, ji!"
  ]
 ],
 "s137.sec51.u8": [
  [
   "Hmpf, no ho penso permetre!",
   "Sortireu d'aquesta cova."
  ]
 ],
 "s137.sec51.u9": [
  [
   "Je, aquesta vegada no serà",
   "com l'altra..."
  ]
 ],
 "s137.sec51.u10": [
  [
   "Cap, vol dir...?"
  ]
 ],
 "s137.sec51.u11": [
  [
   "Això mateix. Endavant!"
  ]
 ],
 "s137.sec51.u12": "Q-què!?",
 "s137.sec51.u13": [
  [
   "Senyor WaruSeadramon!",
   "Doneu-los el que es mereixen!"
  ]
 ],
 "s137.sec51.u14": [
  [
   "Així que has contractat un",
   "guardaespatlles!"
  ]
 ],
 "s137.sec51.u15": [
  [
   "Guajajaja! Estàs acabat!"
  ]
 ],
 "s137.sec51.u16": [
  [
   "M-maleïda sigui!"
  ]
 ],
 "s137.sec51.u17": [
  [
   "Aaaaaay!"
  ]
 ],
 "s137.sec51.u18": [
  [
   "No us escapareu!"
  ]
 ]
}
