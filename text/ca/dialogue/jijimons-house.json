 "s178.sec5.u18": [
  [
   "Ejem, ejem. Juntament amb els",
   "Digimon que vagin tornant,",
   "reconstruiré Ciutat File."
  ]
 ],
 "s178.sec5.u19": [
  [
   "Penso construir botigues que",
   "us vagin bé a tu i a",
   "{color 10}{partner}{color 1}."
  ]
 ],
 "s178.sec5.u20": [
  [
   "Per a començar... vegem. Per",
   "què no explores el Bosc nadiu,",
   "aquí mateix, als afores de la",
   "ciutat?"
  ]
 ],
 "s178.sec6.u0": [
  [
   "Això és per a tu. Molta sort!"
  ]
 ],
 "s178.sec6.u1": [
  [
   "Has aconseguit un munt",
   "d'objectes!"
  ]
 ],
 "s178.sec6.u2": [
  [
   "Per a veure els teus objectes,",
   "prem {color 5}△{color 1}, tria Objectes i",
   "mira'ls amb {color 6}×{color 1}."
  ]
 ],
 "s178.sec6.u3": [
  [
   "Sembla que Yuramon s'ha",
   "assabentat de rumors nous."
  ]
 ],
 "s178.sec6.u4": [
  [
   "Ah, sí! Yuramon diu que sap",
   "rumors nous."
  ]
 ],
 "s178.sec6.u5": [
  [
   "La ciutat té cada vegada més",
   "vida, i el que se sent per aquí",
   "també està canviant una mica."
  ]
 ],
 "s178.sec6.u6": [
  [
   "T'ensenyaré les coses bàsiques",
   "del nostre món! Un dia té 24",
   "hores: matí, dia i nit. Potser",
   "et sembla que passa una mica"
  ],
  [
   "ràpid. Un any té 30 dies.",
   "Mesos? Què són? Estacions...?",
   "Això es menja? És clar que",
   "tenim diners. Es diuen Bits."
  ],
  [
   "Com més en tinguis, millor! En",
   "aquesta illa, «la ciutat» és",
   "això d'aquí, encara que hi ha",
   "alguns pobles i llogarets. Ah,"
  ],
  [
   "i el rellotge! El punt groc",
   "marca les hores i l'agulla, els",
   "minuts. La mitjanit és a dalt i",
   "el migdia, a baix. El vermell,"
  ],
  [
   "a l'esquerra, és el vespre: de",
   "les 16 a les 20 h. El morat, a",
   "la dreta, és el matí: de les 4",
   "a les 8 h. Els Digimon tenen"
  ],
  [
   "els seus horaris. La majoria es",
   "lleven al matí i dormen de nit,",
   "però no tots. Si no trobes un",
   "Digimon que vols veure, prova"
  ],
  [
   "de venir a una altra hora."
  ]
 ],
 "s178.sec7.u0": [
  [
   "Passa sovint a veure Tsunomon",
   "i Yuramon, val?"
  ]
 ],
 "s178.sec7.u1": [
  [
   "T'explicaré el Nivell de Domador!"
  ],
  [
   "Amb un Nivell de Domador alt,",
   "quan un Digimon mor de vell",
   "s'hereten més atributs."
  ],
  [
   "Al principi puja poquet, però",
   "si cries Digimon a poc a poc,",
   "anirà pujant, val?"
  ]
 ],
 "s178.sec7.u2": [
  [
   "Quan uses una tècnica final,",
   "piques L1 i R1 com has de fer?"
  ],
  [
   "Amb la barra plena es fa el",
   "doble de mal que amb la barra",
   "buida. El doble!"
  ]
 ],
 "s178.sec7.u3": [
  [
   "T'explicaré com viuen els",
   "Digimon! Primer, és clar,",
   "mengen. Quan tenen gana,",
   "t'avisen. Després fan caca. El"
  ],
  [
   "millor és que la facin en un",
   "vàter sempre que puguin. Quan",
   "tenen son, dormen. Esperen que",
   "{color 6}{player}{color 1} els ho digui, però"
  ],
  [
   "és millor no fer-los esperar.",
   "També es cansen, es posen",
   "malalts i s'enfaden. Són força",
   "delicats, saps? Els Digimon són"
  ],
  [
   "salvatges de cor, així que unes",
   "vegades els has de lloar i",
   "d'altres, renyar. Sobretot,",
   "observa bé el teu Digimon i"
  ],
  [
   "cuida'l molt."
  ]
 ],
 "s178.sec20.u0": [
  [
   "Així que has tornat en tu... Ho",
   "sento moltíssim, noi."
  ]
 ],
 "s178.sec82.m0.o0": "Descansar una estona",
 "s178.sec82.m0.o1": "No descansar",
 "s178.sec82.u0": [
  [
   "Punimon no està, però suposo",
   "que puc descansar igualment."
  ]
 ],
 "s178.sec82.u1": [
  [
   "{color 7}Punimon {color 1}",
   "Sóc Punimon! Per què no",
   "descanses aquí una estoneta?"
  ],
  [
   "{color 7}Punimon {color 1}",
   "Una hora de descans"
  ],
  [
   "{color 7}Punimon {color 1}",
   "recupera una mica de HP i MP",
   "i redueix una mica el",
   "Cansament."
  ]
 ],
