{
 "s165.sec5.u0": [
  [
   "Ah, arribes en el moment just!"
  ],
  [
   "Haig de demanar-te un favor",
   "important, un que només tu",
   "pots fer."
  ]
 ],
 "s165.sec5.u1": [
  [
   "Què passa?"
  ]
 ],
 "s165.sec5.u2": [
  [
   "Acabo de sentir-ho una altra",
   "vegada: la mateixa maldat que",
   "amb Analogman i Machinedramon.",
   "Però segueixo sense saber d'on"
  ],
  [
   "ve..."
  ]
 ],
 "s165.sec5.u3": [
  [
   "Una altra vegada!? Val,",
   "deixa-m'ho a mi!"
  ]
 ],
 "s165.sec5.u4": [
  [
   "Ah, gràcies, noi. Per cert..."
  ]
 ],
 "s165.sec5.u5": [
  [
   "M'han dit que has derrotat",
   "Machinedramon!"
  ]
 ],
 "s165.sec5.u6": [
  [
   "Sí. Però no ho entenc gaire.",
   "Semblava una mena de maledicció",
   "d'Analogman."
  ]
 ],
 "s165.sec5.u7": [
  [
   "El seu rancor ha de seguir",
   "aquí, i amb una força",
   "tremenda..."
  ],
  [
   "En fi, amb això potser tornem a",
   "tenir pau."
  ]
 ],
 "s165.sec5.u8": [
  [
   "Si Machinedramon torna, el",
   "tornarem a derrotar. Serà com",
   "una festa anual. Divertit, oi?"
  ]
 ],
 "s165.sec5.u9": [
  [
   "Ho, ho, quina tranquil·litat em",
   "dónes. Ah, és veritat! Té, en",
   "agraïment. Ha crescut per",
   "casualitat a la granja de Carn."
  ]
 ],
 "s165.sec5.u10": [
  [
   "Hala! Un {color 6}Meló passat{color 1}?"
  ]
 ],
 "s165.sec5.u11": [
  [
   "Ups! Porto la bossa plena."
  ]
 ],
 "s165.sec5.u12": [
  [
   "M'ho quedo, gràcies!"
  ]
 ],
 "s165.sec5.u13": [
  [
   "Ah, has vingut! És un assumpte",
   "important, saps?, i només t'ho",
   "puc demanar a tu."
  ]
 ],
 "s165.sec5.u14": [
  [
   "Je, je, no hi ha de què. I què",
   "és això que ha tornat",
   "Analogman?"
  ]
 ],
 "s165.sec5.u15": [
  [
   "Ajá, ho noto. Una cosa idèntica",
   "a la seva maldat."
  ],
  [
   "Encara que no aconsegueixo",
   "saber d'on ve..."
  ]
 ],
 "s165.sec5.u16": [
  [
   "Val, deixa-m'ho a mi! El",
   "trobaré i acabaré amb ell."
  ]
 ],
 "s165.sec5.u17": [
  [
   "Ah, gràcies, noi. Per cert..."
  ]
 ],
 "s165.sec7.u0": [
  [
   "Sembla que Yuramon s'ha",
   "assabentat de rumors nous."
  ]
 ],
 "s165.sec7.u1": [
  [
   "Ah, sí! Yuramon diu que sap",
   "rumors nous."
  ]
 ],
 "s165.sec7.u2": [
  [
   "La ciutat té cada vegada més",
   "vida, i el que se sent per aquí",
   "també està canviant una mica."
  ]
 ],
 "s165.sec7.u3": [
  [
   "{color 6}{player}{color 1}",
   ", la teva manera d'anar",
   "d'aventures és bastant",
   "estranya, saps?"
  ]
 ],
 "s165.sec20.u0": [
  [
   "Així que has tornat en tu... Ho",
   "sento moltíssim, noi."
  ]
 ],
 "s165.sec85.m0.o0": "Fer-lo servir",
 "s165.sec85.m0.o1": "No fer-lo servir",
 "s165.sec85.u0": [
  [
   "Oh? Què és aquesta màquina?"
  ]
 ],
 "s165.sec85.u1": [
  [
   "Mmm, això? És la {color 4}Màquina de",
   "Registre de Combat a la",
   "Memory Card{color 1}. Desa les dades",
   "del teu company actual per"
  ],
  [
   "combatre. Prem {color 6}×{color 1} aquí i la",
   "màquina et dirà què has de fer."
  ]
 ],
 "s165.sec85.u2": [
  [
   "Vols usar la {color 4}Màquina de",
   "Registre de Combat a la",
   "Memory Card{color 1}?"
  ]
 ],
 "s166.sec5.u0": [
  [
   "Tots estan treballant",
   "moltíssim!"
  ]
 ],
 "s166.sec6.u0": [
  [
   "Sembla que no hi ha res dins."
  ]
 ],
 "s166.sec7.u0": [
  [
   "Airdramon està dormint..."
  ]
 ],
 "s166.sec60.u0": [
  [
   "Ajá, sembla que de moment està",
   "bé."
  ]
 ],
 "s166.sec60.u1": [
  [
   "Uf, encara sort..."
  ]
 ],
 "s166.sec60.u2": [
  [
   "Pel seu bé també, hem de",
   "derrotar el seu cap com més",
   "aviat millor."
  ]
 ],
 "s166.sec60.u3": [
  [
   "...Ja ho sé, ja ho sé."
  ]
 ],
