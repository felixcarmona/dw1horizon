 "s054.sec5.u0": [
  [
   "Ens has ajudat moltes vegades.",
   "Deixa'm compartir amb tu els",
   "fruits de la meva recerca.",
   "Sembla que, quan MetalGreymon"
  ],
  [
   "mor en combat o de malaltia, a",
   "vegades pot convertir-se en",
   "SkullGreymon. D'altres també",
   "poden digievolucionar així:"
  ],
  [
   "Bakemon, Devimon, Phoenixmon...",
   "A partir de quins, no t'ho",
   "sabria dir. Les taules de",
   "digievolució no mostren"
  ],
  [
   "aquestes digievolucions, així",
   "que recorda-ho bé."
  ]
 ],
 "s054.sec5.u1": [
  [
   "Des que els meus homes van",
   "començar a combatre en el",
   "Coliseu, han anat tornant a",
   "ser els d'abans. Sembla que els"
  ],
  [
   "senti de meravella. I per a mi,",
   "un combat en el Coliseu entre",
   "estudi i estudi és també un",
   "agradable canvi d'aires."
  ]
 ],
 "s054.sec5.u2": [
  [
   "I en què CONSISTEIX",
   "aquesta recerca seva...?"
  ]
 ],
 "s054.sec5.u3": [
  [
   "Myotismon, han obert un",
   "Coliseu a la ciutat!"
  ]
 ],
 "s054.sec5.u4": [
  [
   "Mmm. Creus que els meus homes",
   "podrien ser d'utilitat allí?"
  ]
 ],
 "s054.sec5.u5": [
  [
   "Ja et dic! Que es desfoguin!"
  ]
 ],
 "s054.sec5.u6": [
  [
   "Els meus homes van com més va",
   "pitjor... Pot ser que només",
   "sigui qüestió de temps que",
   "abandonin aquesta mansió."
  ]
 ],
 "s054.sec60.u0": [
  [
   "Nyam, nyam..."
  ]
 ],
 "s054.sec60.u1": [
  [
   "Bé..."
  ]
 ],
 "s054.sec60.u2": [
  [
   "Potser vols escoltar el que",
   "haig de dir."
  ]
 ],
 "s054.sec60.u3": [
  [
   "Nyac, nyac..."
  ]
 ],
 "s054.sec60.u4": [
  [
   "Últimament els meus homes han",
   "deixat d'obeir-me. No és que",
   "es rebel·lin... senzillament",
   "semblen oblidar les seves"
  ],
  [
   "ordres per complet. A vegades",
   "ni tan sols les entenen.",
   "Veuràs, se suposa que els meus",
   "homes han de portar-me el"
  ],
  [
   "menjar, però..."
  ]
 ],
 "s054.sec60.u5": [
  [
   "Glu, glu..."
  ]
 ],
 "s054.sec60.u6": [
  [
   "Mentre estava absort en la",
   "meva recerca, no va arribar",
   "cap menjar... i estava tan",
   "absort que vaig oblidar que"
  ],
  [
   "tenia gana. I així va ser com",
   "va ocórrer allò."
  ]
 ],
 "s054.sec60.u7": [
  [
   "...Això és estar MASSA",
   "absort."
  ]
 ],
 "s054.sec60.u8": [
  [
   "Oh, quina vergonya."
  ]
 ],
 "s054.sec60.u9": [
  [
   "És a dir que aquí dins també",
   "passen les mateixes coses",
   "estranyes que fora."
  ]
 ],
 "s054.sec60.u10": [
  [
   "Oh? Amb els problemes de l'illa",
   "vols dir que tots s'estan",
   "tornant com els meus homes?"
  ]
 ],
 "s054.sec60.u11": [
  [
   "Sí. Cada espècie va al seu aire",
   "i perden la memòria. Encara no",
   "els passa a tots, però si això",
   "segueix així..."
  ]
 ],
 "s054.sec60.u12": [
  [
   "Podria haver-hi algú que ho",
   "provoqués? Mmm... I, si fos",
   "així, amb quina finalitat...?"
  ]
 ],
 "s054.sec60.u13": [
  [
   "Mmm..."
  ]
 ],
 "s054.sec60.u14": [
  [
   "Què puc fer jo per l'illa?"
  ]
 ],
 "s054.sec60.u15": [
  [
   "Estem construint una ciutat",
   "per a unir els cors dels",
   "Digimon. Per això recorrem",
   "l'illa: per a trobar amics."
  ]
 ],
 "s054.sec60.u16": [
  [
   "Comprenc. Però això suposa un",
   "problema. A part de mi, els",
   "meus homes a penes serveixen",
   "per a una altra cosa que no"
  ],
  [
   "sigui barallar. I, així i tot,",
   "no puc abandonar-los sense",
   "més..."
  ]
 ],
 "s054.sec60.u17": [
  [
   "Ja veig..."
  ]
 ],
 "s054.sec60.u18": [
  [
   "Et donaré una resposta al seu",
   "degut temps. Veuràs, aquí tinc",
   "treball pendent. Ho lamento de",
   "bo de bo..."
  ]
 ],
 "s054.sec60.u19": [
  [
   "Val. Doncs ja tornaré. I menja",
   "com cal, eh!"
  ]
 ],
 "s054.sec60.u20": [
  [
   "Llavors, per què no combateu",
   "en el Coliseu?"
  ]
 ],
 "s054.sec60.u21": [
  [
   "Oh... el Coliseu? Això sí que",
   "és interessant. Just el que",
   "necessiten els meus homes per a",
   "posar-se en forma. I a mi"
  ],
  [
   "tampoc em vindria malament",
   "estirar les cames de tant en",
   "tant."
  ]
 ],
 "s054.sec60.u22": [
  [
   "Llavors t'uneixes a nosaltres!?"
  ]
 ],
 "s054.sec60.u23": [
  [
   "Sí. Encara que encara haig",
   "d'acabar aquí part de la meva",
   "recerca, així que aniré a la",
   "ciutat entre estudi i estudi."
  ],
  [
   "Ho espero amb impaciència."
  ]
 ],
 "s054.sec81.u0": [
  [
   "Oh!"
  ]
 ],
 "s054.sec81.u1": [
  [
   "Sí, una clau! Potser obre",
   "aquestes portes que no",
   "s'obrien."
  ]
 ],
 "s054.sec81.u2": [
  [
   "Has aconseguit la {color 6}Clau de",
   "mansió{color 1}!"
  ]
 ],
 "s054.sec81.u3": [
  [
   "Ups! Haig de tirar alguna cosa."
  ]
 ],
 "s054.sec82.u0": [
  [
   "Has usat la {color 6}Clau de mansió{color 1}!"
  ]
 ],
 "s054.sec82.u1": [
  [
   "No s'obre... Està tancada amb",
   "clau."
  ]
 ],
 "s054.sec83.u0": [
  [
   "Has usat la {color 6}Clau de mansió{color 1}!"
  ]
 ],
 "s054.sec83.u1": [
  [
   "No s'obre... Està tancada amb",
   "clau."
  ]
 ],
 "s054.sec254.u0": [
  [
   "...Myotismon no hi és."
  ]
 ],
 "s055.sec5.u0": [
  [
   "Et cuinaré!"
  ]
 ],
 "s055.sec6.u0": [
  [
   "Et cuinaré!"
  ]
 ],
 "s055.sec7.u0": [
  [
   "Et cuinaré!"
  ]
 ],
 "s055.sec83.u0": [
  [
   "A veure, la nota deia..."
  ]
 ],
 "s055.sec83.u1": [
  [
   "\"Torna on li vas llevar punts",
   "al ximple.\""
  ]
 ],
 "s055.sec83.u2": [
  [
   "Has usat la {color 6}Clau de la",
   "nevera{color 1}!"
  ]
 ],
 "s055.sec83.u3": [
  [
   "Eh? No és aquí? Ha",
   "desaparegut?"
  ]
 ],
 "s055.sec83.u4": [
  [
   "Oh? Té una nota pegada..."
  ]
 ],
 "s055.sec83.u5": [
  [
   "\"Torna on li vas llevar punts",
   "al ximple.\""
  ]
 ],
 "s055.sec83.u6": [
  [
   "Mmm, sembla que de moment",
   "només tinc aquesta nota per a",
   "seguir. Mmm."
  ]
 ],
 "s055.sec83.u7": [
  [
   "Oh, una nevera."
  ]
 ],
 "s055.sec83.u8": [
  [
   "Uf, està tancada amb clau. A",
   "qui se li ocorre tancar una",
   "nevera?"
  ]
 ],
 "s056.sec53.u0": [
  [
   "Ai, ai... quin mal!"
  ]
 ],
 "s056.sec81.u0": [
  [
   "Has usat la {color 6}Clau de mansió{color 1}!"
