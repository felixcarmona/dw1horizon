 ],
 "s057.sec5.u0": [
  [
   "Amo...? No, tu no ets!"
  ]
 ],
 "s058.sec5.u0": [
  [
   "Encara no està llest el",
   "sopaaaar?"
  ]
 ],
 "s060.sec82.u0": [
  [
   "Aha, és aquí!"
  ]
 ],
 "s061.sec52.u0": [
  [
   "Ai, ai... Estàs bé,",
   "{color 10}{partner}{color 1}?"
  ]
 ],
 "s061.sec52.u1": [
  [
   "Mm? On estem...?"
  ]
 ],
 "s061.sec52.u2": [
  [
   "Sembla que hem entrat en una",
   "habitació on mai havíem estat."
  ]
 ],
 "s061.sec52.u3": [
  [
   "Sí, aterratge perfecte!"
  ]
 ],
 "s061.sec82.u0": [
  [
   "Mmm, està tancada amb clau?"
  ]
 ],
 "s061.sec82.u1": [
  [
   "S'obrirà si giro aquest pom?"
  ]
 ],
 "s061.sec82.u2": [
  [
   "Val, ja està oberta."
  ]
 ],
