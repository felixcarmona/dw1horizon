{
 "s050.sec5.u0": [
  [
   "Haig de vigilar aquest lloc."
  ]
 ],
 "s050.sec6.u0": [
  [
   "Quines eren les meves ordres?"
  ]
 ],
 "s050.sec51.u0": [
  [
   "Mm?"
  ]
 ],
 "s050.sec51.u1": [
  [
   "Aaaaaaaah!?"
  ]
 ],
 "s050.sec51.u2": [
  [
   "Allà vaig!"
  ]
 ],
 "s051.sec57.u0": [
  [
   "...! Noto les ànsies de sang",
   "d'algú..."
  ]
 ],
 "s051.sec57.u1": [
  [
   "Je, je... ja, ja... Així que al",
   "final has vingut!"
  ]
 ],
 "s051.sec57.u2": [
  [
   "Qui hi ha!?"
  ]
 ],
 "s051.sec57.u3": [
  [
   "Sóc Devimon! Un àngel caigut,",
   "esclau del poder de les",
   "tenebres. Je, je, je..."
  ]
 ],
 "s051.sec57.u4": [
  [
   "Sembla que tu saps alguna",
   "cosa!"
  ]
 ],
 "s051.sec57.u5": [
  [
   "Myotismon està en algun lloc de",
   "la mansió. I segurament",
   "continua viu."
  ]
 ],
 "s051.sec57.u6": [
  [
   "Així que això és cosa teva!"
  ]
 ],
 "s051.sec57.u7": [
  [
   "Qui sap? Però sóc el teu",
   "enemic. Això és segur."
  ]
 ],
 "s051.sec57.u8": [
  [
   "Eh, no t'escaparàs!"
  ]
 ],
 "s051.sec57.u9": [
  [
   "Je, je, je... Fua, ja, ja,",
   "ja...!"
  ]
 ],
 "s051.sec57.u10": [
  [
   "Oh, no!"
  ]
 ],
 "s051.sec57.u11": [
  [
   "Je, je... Dóna-li records a",
   "Myotismon de la meva part."
  ]
 ],
 "s051.sec57.u12": [
  [
   "S'ha escapat... Maleït sigui!",
   "Quin tipus més sinistre."
  ]
 ],
 "s051.sec57.u13": [
  [
   "Hala, aquesta mansió sembla",
   "enorme."
  ]
 ],
 "s051.sec57.u14": [
  [
   "Que hi ha algú a caaasaaa?"
  ]
 ],
 "s051.sec57.u15": [
  [
   "No hi ha ningú? O és que la",
   "casa és tan gran que no em",
   "senten?"
  ]
 ],
 "s051.sec57.u16": [
  [
   "Bé, és igual. Vinga, a",
   "explorar!"
  ]
 ],
 "s051.sec81.u0": [
  [
   "No s'obre... Un poder misteriós",
   "l'ha segellat."
  ]
 ],
 "s051.sec82.u0": [
  [
