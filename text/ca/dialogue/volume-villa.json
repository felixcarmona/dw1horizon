{
 "s135.sec5.u0": [
  [
   "Així que vosaltres sou",
   "{color 6}{player}{color 1} i {color 10}{partner}{color 1}?",
   "Benvinguts a la Vil·la Volume!"
  ]
 ],
 "s135.sec5.u1": [
  [
   "...... Sento que ens fiquéssim",
   "amb Otamamon."
  ]
 ],
 "s135.sec5.u2": [
  [
   "Això no té importància."
  ]
 ],
 "s135.sec5.u3": [
  [
   "Eh?"
  ]
 ],
 "s135.sec5.u4": [
  [
   "Us estic agraït a tots dos. He",
   "sentit parlar de tot el que heu",
   "fet per salvar l'illa."
  ]
 ],
 "s135.sec5.u5": [
  [
   "Ah, sí?"
  ]
 ],
 "s135.sec5.u6": [
  [
   "Jo també us he volgut donar un",
   "cop de mà des de fa temps. Ja",
   "heu anat al bosc del nord, el",
   "Bosc boirós?"
  ]
 ],
 "s135.sec5.u7": [
  [
   "Encara no."
  ]
 ],
 "s135.sec5.u8": [
  [
   "Ja hi he estat."
  ]
 ],
 "s135.sec5.u9": [
  [
   "Una boira cobreix aquest lloc,",
   "així que avançar serà difícil."
  ],
  [
   "Però hauríeu de conèixer a",
   "Cherrymon, l'ancià d'aquest",
   "bosc."
  ]
 ],
 "s135.sec5.u10": [
  [
   "Cherrymon? Mai he sentit",
   "parlar d'aquest Digimon..."
  ]
 ],
 "s135.sec5.u11": [
  [
   "La boira del Bosc boirós és",
   "obra de Cherrymon. Ell coneix",
   "els problemes de l'illa i crea",
   "la boira per protegir el bosc."
  ]
 ],
 "s135.sec5.u12": [
  [
   "Doncs a nosaltres ens fot, la",
   "veritat."
  ]
 ],
 "s135.sec5.u13": [
  [
   "Cherrymon sembla saber alguna",
   "cosa de la causa dels",
   "problemes. Val la pena veure'l,",
   "encara que calgui travessar la"
  ],
  [
   "boira."
  ]
 ],
 "s135.sec5.u14": [
  [
   "Si almenys poguéssim fer alguna",
   "cosa amb la boira..."
  ]
 ],
 "s135.sec5.u15": [
  [
   "La boira no s'anirà tret que",
   "Cherrymon la detingui. Però hi",
   "ha una manera."
  ],
  [
   "Us posaré un encanteri."
  ]
 ],
 "s135.sec5.u16": [
  [
   "I què farà?"
  ]
 ],
 "s135.sec5.u17": [
  [
   "Podreu veure el camí, fins i",
   "tot en la boira."
  ]
 ],
 "s135.sec5.u18": [
  [
   "Que bé!"
  ]
 ],
 "s135.sec5.u19": [
  [
   "Comencem, doncs, sense demora."
  ]
 ],
 "s135.sec5.u20": [
  [
   "Croac-croac-croooac!!"
  ]
 ],
 "s135.sec5.u21": [
  [
   "Fet. Aneu ara mateix al Bosc",
   "boirós."
  ]
 ],
 "s135.sec5.u22": [
  [
   "Ja l'he conegut. I la boira ja",
   "ha desaparegut."
  ]
 ],
 "s135.sec5.u23": [
  [
   "Q-què!? Impressionant. Mmm, i",
   "com us puc ajudar, doncs...?",
   "Ah, ja ho sé. Us donaré això."
  ]
 ],
 "s135.sec5.u24": [
  [
   "Has aconseguit un",
   "{color 6}Digillobarro{color 1}!"
  ]
 ],
 "s135.sec5.u25": [
  [
   "Tira alguna cosa per a fer",
   "lloc."
  ]
 ],
 "s135.sec5.u26": [
  [
   "És una cosa valuosa. Us serà",
   "d'utilitat."
  ]
 ],
 "s135.sec5.u27": [
  [
   "Gràcies. Per cert, no vindreu",
   "a la ciutat, Senyoria?"
  ]
 ],
 "s135.sec5.u28": [
  [
   "Sóc el cap dels cent Gekomon",
   "del Pantà Geko. Per desgràcia,",
   "no puc."
  ],
  [
   "Però us ajudaré quant pugui",
   "des d'aquí. Torneu quan",
   "vulgueu."
  ]
 ],
 "s135.sec6.u0": [
  [
   "Només es pot pescar a la riba",
   "del Llac Ull de Drac."
  ]
 ],
 "s135.sec6.u1": [
  [
   "Inclineu-vos, inclineu-vos!"
  ]
 ],
 "s135.sec7.u0": [
  [
   "Sa Senyoria col·lecciona",
   "rareses. Abans, objectes; ara",
   "li encanten les cartes Digimon."
  ]
 ],
 "s135.sec7.u1": [
  [
   "A qui li porta una carta rara",
   "li dóna punts de Mèrit."
  ]
 ],
 "s135.sec7.u2": [
  [
   "Després pots canviar els",
   "Mèrits que hagis estalviat per",
   "objectes."
  ]
 ],
 "s135.sec8.u0": [
  [
   "Això... No, res, croac."
  ]
 ],
 "s135.sec8.u1": [
  [
   "Això...! Vull anar a la ciutat,",
   "croac!"
  ]
 ],
 "s135.sec8.u2": [
  [
   "Clar, val, però què et passa?"
  ]
 ],
 "s135.sec8.u3": [
  [
   "Vull provar de lluitar a",
   "l'arena, croac. Sembla que ens",
   "prenen per uns pagesots, als",
   "Gekomon, croac... Però els"
  ],
  [
   "pagesots també tenim orgull,",
   "croac! Si us plau, t'ho",
   "suplico, croac."
  ]
 ],
 "s135.sec8.u4": [
  [
   "Ja ho veig. T'entenc... Doncs",
   "endavant, dóna-ho tot."
  ]
 ],
 "s135.sec8.u5": [
  [
   "Gekomon s'ha unit a l'arena!"
  ]
 ],
 "s135.sec81.u0": [
  [
   "Sembles preocupat. Sí, sí, ja",
   "ho sé. És per la disfressa, no",
   "és així?"
  ]
 ],
 "s135.sec81.u1": [
  [
   "Camina! Ho saps?"
  ]
 ],
 "s135.sec81.u2": [
  [
   "No em subestimis. Sobre la",
   "disfressa: Numemon se la pot",
   "posar, saps? Sorprès? I",
   "encara hi ha més: quan se la"
  ],
  [
   "posa... increïble......! Bé, no",
   "es perd res per provar-ho."
  ]
 ],
 "s135.sec81.u3": [
  [
   "Mmm, això em recorda que la",
   "{color 6}Canya increïble{color 1} és un objecte",
   "especial, així que la llevaré"
  ],
  [
   "dels teus objectes."
  ]
 ],
 "s135.sec81.u4": [
  [
   "Esforça't!"
  ]
 ]
}
