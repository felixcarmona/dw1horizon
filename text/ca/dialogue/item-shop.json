{
 "s176.sec7.u0": [
  [
   "Ah, sí! Tens la bossa plena?",
   "Boing! Diuen que hi ha un",
   "clauer que la connecta amb una",
   "altra dimensió per poder portar"
  ],
  [
   "més objectes! Potser cal",
   "tornar als llocs on ja has",
   "estat!"
  ]
 ],
 "s176.sec7.u1": [
  [
   "T'explicaré els meus trucs",
   "secrets per comprar objectes!",
   "Prem START a la llista per",
   "veure'n els efectes. En triar"
  ],
  [
   "la quantitat, {color 4}□{color 1} selecciona",
   "tot el que pots pagar. Mantén",
   "{color 10}○{color 1} i prem amunt o avall per",
   "canviar de deu en deu! Si la"
  ],
  [
   "llista és llarga, mantén R1 i",
   "prem amunt o avall per moure't",
   "de pressa! Un altre secret:",
   "compra alguna cosa just"
  ],
  [
   "després que el teu Digimon",
   "reneixi. Segur que passa una",
   "cosa bona! Boing!"
  ]
 ],
 "s176.sec81.u0": [
  [
   "Benvingut, {color 6}{player}{color 1}! Mira,",
   "la meva pròpia botiga! Vendré",
   "objectes sense parar!",
   "L'assortiment... Ja ho"
  ],
  [
   "resoldré. M'agradaria que",
   "portessis Digimon per",
   "ajudar-me."
  ]
 ],
 "s176.sec81.u1": [
  [
   "Benvingut, piulo! He decidit",
   "comprar i vendre objectes,",
   "piulo. Encantat, piulo! Encara",
   "no hi ha molt de gènere... però"
  ],
  [
   "si vingués algun Digimon a",
   "ajudar, potser m'apanyaria,",
   "piulo."
  ]
 ],
 "s176.sec81.u2": [
  [
   "Benvingut. Si em permets",
   "l'atreviment, he obert una",
   "botiga d'objectes. Espero",
   "comptar amb la teva visita."
  ],
  [
   "L'assortiment encara és",
   "bastant pobre, però penso",
   "engrandir la botiga. Tingues",
   "paciència amb mi de moment."
  ]
 ],
 "s176.sec81.u3": [
  [
   "{color 6}{player}{color 1}, {color 10}{partner}{color 1},",
   "per fi he obert la botiga",
   "d'objectes. Pressento que el",
   "negoci anirà molt bé! Amb més"
  ],
  [
   "Digimon a la ciutat, tindré més",
   "bon assortiment. Tingueu",
   "paciència fins llavors."
  ]
 ],
 "s176.sec81.u4": [
  [
   "Eh, {color 6}{player}{color 1}! He començat",
   "a ajudar en aquesta botiga.",
   "Compra molt, val?"
  ]
 ],
 "s176.sec81.u5": [
  [
   "Benvingut, piu! Des d'avui",
   "ajudo a la botiga, piu.",
   "Encantat, piu!"
  ]
 ],
 "s176.sec81.u6": [
  [
   "Benvingut, {color 6}{player}{color 1}. Si em",
   "permets l'atreviment, he",
   "decidit ajudar en aquesta",
   "botiga. Espero comptar amb la"
  ],
  [
   "teva visita."
  ]
 ],
 "s176.sec81.u7": [
  [
   "Ah, {color 6}{player}{color 1}. Al cap i a la",
   "fi, aquí és on millor llueix el",
   "meu talent. A partir d'ara",
   "donaré el millor de mi."
  ]
 ],
 "s176.sec82.m0.o0": "Comprar",
 "s176.sec82.m0.o1": "No comprar",
 "s176.sec82.u0": [
  [
   "Oooh, senyor! Com et va? Jo",
   "estic taaan ocupat venent",
   "objectes... És broma! Sóc molt",
   "gandul i no crec que pari gaire"
  ],
  [
   "per la botiga. Però tinc una",
   "cosa increïble: el Manual",
   "d'entrenar! Només de dur-lo,",
   "l'entrenament fa meravelles! És"
  ],
  [
   "molt valuós. Te'l venc per",
   "50000 Bits. Si no el compres,",
   "te'n penediràs!"
  ]
 ],
 "s176.sec82.u1": [
  [
   "Et falten moooolts Bits!"
  ]
 ],
 "s176.sec82.u2": [
  [
   "Vaja, tens la bossa plena!"
  ]
 ],
 "s176.sec82.u3": [
  [
   "Has aconseguit el {color 6}Manual",
   "d'entrenar{color 1}!"
  ]
 ],
 "s176.sec82.u4": [
  [
   "Ni un Bit de descompte,",
   "senyor!"
  ]
 ]
