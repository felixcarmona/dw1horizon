{
 "s171.sec6.u0": [
  [
   "Més xerrada de digievolució!",
   "Ara, sobre la fase que ve",
   "després de Campió. Es diu",
   "Perfecte, diuen. Sembla que no"
  ],
  [
   "tots els Campions hi arriben.",
   "Les condicions són súuuper",
   "dures! Però, si es torna",
   "Perfecte, viu més temps. En"
  ],
  [
   "canvi, si digievoluciona amb un",
   "objecte, la seva vida no",
   "s'allarga, crec."
  ]
 ],
 "s171.sec6.u1": [
  [
   "Més xerrada de digievolució!",
   "Ara, sobre les condicions per",
   "digievolucionar. Primer, el pes",
   "ha de ser semblant al del"
  ],
  [
   "Digimon en què es convertirà.",
   "Després, els atributs: com més",
   "alts, millor! Però els que",
   "importen depenen del cas. I els"
  ],
  [
   "errors de cura... De vegades",
   "és millor cometre'n moooolts",
   "expressament. Ah, sí! Alguns",
   "Digimon tenen condicions"
  ],
  [
   "especials, només seves. Com una",
   "disciplina altíssima, o molts",
   "combats... Si en compleix una,",
   "pot digievolucionar encara que"
  ],
  [
   "no compleixi les tres bàsiques."
  ]
 ],
 "s171.sec6.u2": [
  [
   "Jiji m'ha dit que {color 10}{partner}{color 1}",
   "pot digievolucionar, saaaaps?",
   "De Bebè a Infantil només triga",
   "sis hores, ha dit. La següent,"
  ],
  [
   "a Novell, triga més o menys un",
   "diaaa. I després, a Campió,",
   "triga uns tres dieees. I",
   "desprééés... Què era? Ho he"
  ],
  [
   "oblidat, però encara n'hi ha",
   "més. Digievolucionar té a veure",
   "amb el pes, els atributs i els",
   "errors de cura, diuen. Aquesta"
  ],
  [
   "part encara no l'entenc. Ja ho",
   "preguntaré a Jiji un altre",
   "cooop."
  ]
 ],
 "s171.sec81.u0": [
  [
   "Ei, que bé que hagis vingut! He",
   "obert un dipòsit per guardar",
   "els objectes de la gent. Els",
   "teus els guardo gratis. Una"
  ],
  [
   "oferta especial per a tu!"
  ]
 ]
}
