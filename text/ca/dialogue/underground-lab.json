{
 "s064.sec5.u0": [
  [
   "Tornarem a participar a",
   "l'arena. Segur que alguns em",
   "trobarien a faltar. He, he..."
  ]
 ],
 "s064.sec5.u1": [
  [
   "Els meus homes són descurats",
   "comparats amb mi, així que",
   "portaré SkullGreymon a l'arena."
  ]
 ],
 "s064.sec5.u2": [
  [
   "Ah, i queda't tranquil: a",
   "diferència d'abans,",
   "SkullGreymon ara obeeix."
  ]
 ],
 "s064.sec5.u3": [
  [
   "Myotismon, estàs bé!?"
  ]
 ],
 "s064.sec5.u4": [
  [
   "Ugh... uhh... Oh? Ets tu!",
   "Sempre acudeixes a",
   "rescatar-me."
  ]
 ],
 "s064.sec5.u5": [
  [
   "Què ha passat?"
  ]
 ],
 "s064.sec5.u6": [
  [
   "Mmm... digues-me, t'has trobat",
   "amb Devimon?"
  ]
 ],
 "s064.sec5.u7": [
  [
   "Sí. Aquest tipus tan fastigós."
  ]
 ],
 "s064.sec5.u8": [
  [
   "Ha infós energia fosca en el",
   "material que jo estava",
   "investigant."
  ]
 ],
 "s064.sec5.u9": [
  [
   "La teva recerca... et",
   "refereixes a SkullGreymon!?",
   "Això és perillós..."
  ]
 ],
 "s064.sec5.u10": [
  [
   "Era més una col·lecció que una",
   "recerca. Recollia ossos i els",
   "muntava... He après la lliçó."
  ]
 ],
 "s064.sec5.u11": [
  [
   "Però aquí el dolent és Devimon."
  ]
 ],
 "s064.sec5.u12": [
  [
   "...La veritat és que el conec."
  ]
 ],
 "s064.sec5.u13": [
  [
   "Quèèè!?"
  ]
 ],
 "s064.sec5.u14": [
  [
   "Sempre ha estat retorçat...",
   "però no era dels que fan una",
   "cosa així. Potser algú l'està",
   "controlant."
  ]
 ],
 "s064.sec5.u15": [
  [
   "...Així que és això..."
  ]
 ],
 "s064.sec5.u16": [
  [
   "Si torna a ser el d'abans...",
   "recorda que fins i tot ell",
   "podria unir-se al teu bàndol."
  ]
 ],
 "s064.sec6.u0": [
  [
   "Bu!"
  ]
 ],
 "s064.sec6.u1": [
  [
   "......"
  ]
 ],
