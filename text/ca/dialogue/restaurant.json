  ]
 ],
 "s174.sec81.u4": [
  [
   "Je... {color 6}{player}{color 1}, treballaré",
   "com a xef d'aquest restaurant.",
   "Vosaltres dos assaborireu amb",
   "calma la meva cuina ardent."
  ]
 ],
 "s174.sec81.u5": [
  [
   "Ja, ja! {color 6}{player}{color 1},",
