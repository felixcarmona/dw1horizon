   "restaurant. Vosaltres dos"
  ],
  [
   "assaborireu amb calma la meva",
   "cuina de flames... Je, je,",
   "je..."
  ]
 ],
 "s174.sec81.u1": [
  [
   "Ja, ja, ja! {color 6}{player}{color 1},",
   "{color 10}{partner}{color 1}, veniu a provar el",
   "meu menjar! Mai vaig pensar que",
   "el meu talent ocult em seria"
  ],
  [
   "útil. Això és menjar de debò,",
   "no objectes! Que aprofiti!"
  ]
 ],
 "s174.sec81.u2": [
  [
   "Bones, {color 6}{player}{color 1},",
   "{color 10}{partner}{color 1}! He decidit",
   "guanyar-me la vida cuinant.",
   "Que no us enganyi la meva"
  ],
  [
   "aparença: sóc un cuiner de",
   "primera. El menjar de viatge",
   "cansa, oi? Seure a taula en un",
   "restaurant de tant en tant és"
  ],
  [
   "tot un luxe!"
  ]
 ],
 "s174.sec81.u3": [
  [
   "Holaaa! {color 6}{player}{color 1},",
   "{color 10}{partner}{color 1}. Per fi he obert",
