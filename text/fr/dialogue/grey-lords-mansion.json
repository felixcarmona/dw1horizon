 "s050.sec5.u0": [
  [
   "Je dois garder cet endroit."
  ]
 ],
 "s050.sec6.u0": [
  [
   "Quels étaient mes ordres, déjà",
   "?"
  ]
 ],
 "s050.sec51.u0": [
  [
   "Mm?"
  ]
 ],
 "s050.sec51.u1": [
  [
   "Aaaaaah! ?"
  ]
 ],
 "s050.sec51.u2": [
  [
   "J'arrive !"
  ]
 ],
 "s051.sec57.u0": [
  [
   "...! Je sens l'envie de tuer de",
   "quelqu'un..."
  ]
 ],
 "s051.sec57.u1": [
  [
   "Hé hé... ha ha... Tu es donc",
   "venu !"
  ]
 ],
 "s051.sec57.u2": [
  [
   "Qui est là !?"
  ]
 ],
 "s051.sec57.u3": [
  [
   "Je suis Devimon ! Un ange",
   "déchu, esclave de la puissance",
   "des ténèbres. Hé hé hé..."
  ]
 ],
 "s051.sec57.u4": [
  [
   "Tu as l'air de savoir quelque",
   "chose !"
  ]
 ],
 "s051.sec57.u5": [
  [
   "Myotismon est quelque part",
   "dans le manoir. Probablement",
   "encore en vie, aussi."
  ]
 ],
 "s051.sec57.u6": [
  [
   "Alors, c'est toi qui as fait ça",
   "!"
  ]
 ],
 "s051.sec57.u7": [
  [
   "Qui sait ? Mais je suis ton",
   "ennemi. C'est sûr."
  ]
 ],
 "s051.sec57.u8": [
  [
   "Hé, tu ne m'échapperas pas !"
  ]
 ],
 "s051.sec57.u9": [
  [
   "Hé hé hé... Ha ha ha ha !"
  ]
 ],
 "s051.sec57.u10": [
  [
   "Oh non !"
  ]
 ],
 "s051.sec57.u11": [
  [
   "Hé hé... Passe le bonjour à",
   "Myotismon."
  ]
 ],
 "s051.sec57.u12": [
  [
   "Il s'est échappé... Mince !",
   "Quel sale type."
  ]
 ],
 "s051.sec57.u13": [
  [
   "Waouh, ce manoir a l'air",
   "immense."
  ]
 ],
 "s051.sec57.u14": [
  [
   "Il y a quelqu'uuun ?"
  ]
 ],
 "s051.sec57.u15": [
  [
   "Personne ? Ou c'est trop",
   "grand pour qu'on m'entende ?"
  ]
 ],
 "s051.sec57.u16": [
  [
   "Tant pis. Allez, explorons !"
  ]
 ],
 "s051.sec81.u0": [
