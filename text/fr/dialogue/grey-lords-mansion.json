 "s052.sec83.u0": [
  [
   "Ça ne s'ouvre pas... C'est",
   "fermé à clé. Et il n'y a pas de",
   "serrure !"
  ]
 ],
 "s054.sec5.u0": [
  [
   "Tu nous as aidés bien des fois.",
   "Permets-moi de partager les",
   "fruits de mes recherches."
  ],
  [
   "Quand MetalGreymon meurt au",
   "combat ou de maladie, il peut",
   "parfois devenir SkullGreymon."
  ],
  [
   "D'autres peuvent digivoluer",
   "ainsi : Bakemon, Devimon,",
   "Phoenixmon... À partir de"
  ],
  [
   "quelles formes, je l'ignore.",
   "Les arbres de digivolution",
   "n'indiquent pas ces voies,"
  ],
  [
   "alors retiens bien cela."
  ]
 ],
 "s054.sec5.u1": [
  [
   "Depuis que mes hommes",
   "combattent à l'arène, ils",
   "redeviennent eux-mêmes. Cela"
  ],
  [
   "semble leur faire le plus grand",
   "bien. Et un combat entre deux",
   "séances d'étude me change"
  ],
  [
   "agréablement les idées, à moi",
   "aussi."
  ]
 ],
 "s054.sec5.u2": [
  [
   "Mais en quoi consistent ses",
   "recherches, au juste... ?"
  ]
 ],
 "s054.sec5.u3": [
  [
   "Myotismon, une arène a ouvert",
   "en ville !"
  ]
 ],
 "s054.sec5.u4": [
  [
   "Hmm. Tu crois que mes hommes",
   "pourraient y être utiles ?"
  ]
 ],
 "s054.sec5.u5": [
  [
   "Et comment ! Qu'ils se",
   "défoulent !"
  ]
 ],
 "s054.sec5.u6": [
  [
   "Mes hommes vont de plus en",
   "plus mal... Ce n'est peut-être",
   "qu'une question de temps avant"
  ],
  [
   "qu'ils quittent ce manoir."
  ]
 ],
 "s054.sec60.u0": [
  [
   "Miam, miam..."
  ]
 ],
 "s054.sec60.u1": [
  [
   "Très bien..."
  ]
 ],
 "s054.sec60.u2": [
  [
   "Tu voudras peut-être écouter",
   "ce que j'ai à dire."
  ]
 ],
 "s054.sec60.u3": [
  [
   "Croc, croc..."
  ]
 ],
 "s054.sec60.u4": [
  [
   "Ces derniers temps, mes hommes",
   "n'obéissent plus. Ils ne se",
   "rebellent pas... ils semblent"
  ],
  [
   "simplement oublier tous leurs",
   "ordres. Parfois, ils ne les",
   "comprennent même pas."
  ],
  [
   "Normalement, ils doivent",
   "m'apporter mes repas, mais..."
  ]
 ],
 "s054.sec60.u5": [
  [
   "Glu, glu. . ."
  ]
 ],
 "s054.sec60.u6": [
  [
   "Absorbé par mes recherches, je",
   "ne recevais aucun repas... Et",
   "j'étais si absorbé que"
  ],
  [
   "j'oubliais ma faim. Voilà",
   "comment c'est arrivé."
  ]
 ],
 "s054.sec60.u7": [
  [
   "...Là, c'est être BEAUCOUP",
   "trop absorbé."
  ]
 ],
 "s054.sec60.u8": [
  [
   "Oh, quelle honte."
  ]
 ],
 "s054.sec60.u9": [
  [
   "Alors, les mêmes choses",
   "bizarres se produisent ici",
   "comme dehors."
  ]
 ],
 "s054.sec60.u10": [
  [
   "Oh ? Tu veux dire que tout le",
   "monde devient comme mes",
   "hommes, à cause des troubles"
  ],
  [
   "de l'île ?"
  ]
 ],
 "s054.sec60.u11": [
  [
   "Oui. Chaque espèce reste",
   "entre elle et perd la mémoire.",
   "Pas encore tout le monde, mais"
  ],
  [
   "si ça continue..."
  ]
 ],
 "s054.sec60.u12": [
  [
   "Quelqu'un provoquerait-il tout",
   "cela ? Hmm... Et dans quel",
   "but... ?"
  ]
 ],
 "s054.sec60.u13": [
  [
   "Hmm..."
  ]
 ],
 "s054.sec60.u14": [
  [
   "Que puis-je faire pour l'île ?"
  ]
 ],
 "s054.sec60.u15": [
  [
   "Nous construisons une ville",
   "pour unir les coeurs des",
   "Digimon. C'est pourquoi nous"
  ],
  [
   "parcourons l'île à la recherche",
   "d'amis."
  ]
 ],
 "s054.sec60.u16": [
  [
   "Je vois. Mais c'est un",
   "problème. À part moi, mes",
   "hommes ne savent guère faire"
  ],
  [
   "autre chose que se battre. Et",
   "pourtant, je ne peux pas les",
   "abandonner..."
  ]
 ],
 "s054.sec60.u17": [
  [
   "Je vois..."
  ]
 ],
 "s054.sec60.u18": [
  [
   "Je te donnerai une réponse en",
   "temps voulu. J'ai du travail",
   "ici, vois-tu. Je suis vraiment"
  ],
  [
   "désolé..."
  ]
 ],
 "s054.sec60.u19": [
  [
   "D'accord, je reviendrai. Et",
   "pense à bien manger !"
  ]
 ],
 "s054.sec60.u20": [
  [
   "Alors, pourquoi ne pas",
   "combattre à l'arène ?"
  ]
 ],
 "s054.sec60.u21": [
  [
   "Oh... L'arène ? Intéressant.",
   "Voilà de quoi remettre mes",
   "hommes en forme. Moi aussi,"
  ],
  [
   "j'aimerais me dégourdir les",
   "jambes de temps en temps."
  ]
 ],
 "s054.sec60.u22": [
  [
   "Alors, tu nous rejoins ?!"
  ]
 ],
 "s054.sec60.u23": [
  [
   "Oui. Il me reste des",
   "recherches à terminer ici,",
   "alors je viendrai en ville"
  ],
  [
   "entre deux séances d'étude.",
   "J'ai hâte."
  ]
 ],
