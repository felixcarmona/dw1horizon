 "s168.sec82.u0": [
  [
   "Informations sur l'arène"
  ]
 ],
 "s168.sec82.u1": [
  [
   "Tournois remportés :",
   "{cupswon} {wins}",
   "victoires, {losses} défaites"
  ]
 ],
 "s168.sec82.u2": [
  [
   "Les tournois de rang sont",
   "fréquents et ouverts à tous.",
   "Évite toutefois d'y inscrire un"
  ],
  [
   "Digimon bien plus fort que le",
   "niveau du tournoi. Si ton",
   "Digimon change d'espèce entre"
  ],
  [
   "son inscription et le tournoi,",
   "son inscription est annulée."
  ]
 ],
 "s168.sec82.u3": [
  [
   "Les tournois spéciaux ont des",
   "conditions d'entrée précises et",
   "sont rares. Sans assez de"
  ],
  [
   "participants admissibles en",
   "ville, ils n'ont pas lieu.",
   "Chacun ne se tient qu'une ou"
  ],
  [
   "deux fois par an. Consulte donc",
   "le calendrier bien à l'avance."
  ]
 ],
 "s168.sec84.u0": [
