{
 "s028.sec5.u0": [
  [
   "J'ai remis le panneau de",
   "l'entrée à sa place.",
   "Franchement..."
  ]
 ],
 "s028.sec5.u1": [
  [
   "Chaud ! Brûlant !! Je cuis !!!",
   "Que quelqu'un fasse quelque",
   "chose !"
  ]
 ],
 "s028.sec5.u2": [
  [
   "Qu'est-ce qui te prend... ?"
  ]
 ],
 "s028.sec5.u3": [
  [
   "Il fait trop chaud ! Je n'en",
   "peux plus !"
  ]
 ],
 "s028.sec5.u4": [
  [
   "D-désolé. La chaleur a dû me",
   "faire perdre la tête."
  ]
 ],
 "s028.sec5.u5": [
  [
   "C'est vrai qu'il fait chaud,",
   "mais..."
  ]
 ],
 "s028.sec5.u6": [
  [
   "Ce tunnel... Plus on creuse,",
   "plus il fait chaud. C'est",
   "normal, on est dans un volcan."
  ]
 ],
 "s028.sec5.u7": [
  [
   "Mais ces derniers temps, il y a",
   "autre chose. La chaleur a",
   "augmenté d'un coup, vraiment"
  ],
  [
   "d'un coup. Comme si un feu",
   "brûlait quelque part..."
  ]
 ],
 "s028.sec5.u8": [
  [
   "Hmmm."
  ]
 ],
 "s028.sec5.u9": [
  [
   "Enfin, je n'ai qu'à prendre sur",
   "moi et creuser. Allez, je ferai",
   "de mon mieux."
  ]
 ],
 "s028.sec5.u10": [
  [
   "Je vois. Nous chercherons",
   "aussi la cause. Ce serait",
   "vraiment utile que ce tunnel"
  ],
  [
   "débouche."
  ]
 ],
 "s028.sec5.u11": [
  [
   "Tu es vraiment sympa, tu sais",
   "? Allez, je vais vite finir de",
   "creuser ce tunnel !"
  ]
 ],
 "s028.sec5.u12": [
  [
   "Aujourd'hui, c'est moi qui fais",
   "la cuisine."
  ]
 ]
}
