 "s178.sec5.u18": [
  [
   "Ah, hum. Avec les Digimon qui",
   "reviendront, je vais",
   "reconstruire File City."
  ]
 ],
 "s178.sec5.u19": [
  [
   "Je compte construire des",
   "boutiques utiles pour toi et",
   "{color 10}{partner}{color 1}."
  ]
 ],
 "s178.sec5.u20": [
  [
   "Pour commencer... Voyons.",
   "Pourquoi ne pas explorer la",
   "Forêt natale, juste à la sortie"
  ],
  [
   "de la ville ?"
  ]
 ],
 "s178.sec6.u0": [
  [
   "C'est pour toi. Bonne chance."
  ]
 ],
 "s178.sec6.u1": [
  [
   "Tu reçois toutes sortes",
   "d'objets !"
  ]
 ],
 "s178.sec6.u2": [
  [
   "Pour voir tes objets, appuie",
   "sur {color 5}△{color 1}, choisis Objets, puis",
   "regarde-les avec {color 6}×{color 1}."
  ]
 ],
 "s178.sec6.u3": [
  [
   "On dirait que Yuramon a",
   "entendu de nouvelles rumeurs."
  ]
 ],
 "s178.sec6.u4": [
  [
   "Ah oui, Yuramon dit connaître",
   "de nouvelles rumeurs."
  ]
 ],
 "s178.sec6.u5": [
  [
   "La ville s'anime de plus en",
   "plus, et les conversations",
   "changent un peu, elles aussi."
  ]
 ],
 "s178.sec6.u6": [
  [
   "Je vais t'apprendre les bases",
   "de notre monde ! Une journée",
   "compte 24 heures : matin, jour"
  ],
  [
   "et nuit. Ça te semblera",
   "peut-être un peu rapide. Une",
   "année dure 30 jours. Les mois"
  ],
  [
   "? Qu'est-ce que c'est ? Les",
   "saisons... ? Ça se mange ? Bien",
   "sûr, on a de l'argent. On"
  ],
  [
   "l'appelle les Bits. On n'en a",
   "jamais assez ! Sur cette île,",
   "quand on dit \"la ville\", on"
  ],
  [
   "parle d'ici, même s'il y a",
   "quelques petits bourgs et",
   "villages. Ah, et l'horloge : le"
  ],
  [
   "point jaune indique l'heure, et",
   "l'aiguille les minutes. Minuit",
   "est en haut, midi en bas. Le"
  ],
  [
   "rouge à gauche, c'est le soir :",
   "de 16 h à 20 h. Le violet à",
   "droite, c'est le matin : de 4 h"
  ],
  [
   "à 8 h. Les Digimon ont chacun",
   "leur rythme. La plupart se",
   "lèvent le matin et dorment la"
  ],
  [
   "nuit, mais pas tous. Si tu ne",
   "trouves pas un Digimon que tu",
   "veux rencontrer, reviens à une"
  ],
  [
   "autre heure."
  ]
 ],
 "s178.sec7.u0": [
  [
   "Va souvent voir Tsunomon et",
   "Yuramon, d'accord ?"
  ]
 ],
 "s178.sec7.u1": [
  [
   "Je vais t'expliquer le niveau",
   "de Dresseur ! Plus il est",
   "élevé, plus un Digimon transmet"
  ],
  [
   "ses stats quand il meurt de",
   "vieillesse. Au début, le niveau",
   "monte peu, mais continue à"
  ],
  [
   "élever des Digimon et il finira",
   "par augmenter, d'accord ?"
  ]
 ],
 "s178.sec7.u2": [
  [
   "Quand tu utilises une technique",
   "finale, tu appuies bien sans",
   "arrêt sur L1 et R1 ? Avec la"
  ],
  [
   "jauge pleine, les dégâts sont",
   "deux fois plus élevés qu'avec",
   "une jauge vide. Deux fois !"
  ]
 ],
 "s178.sec7.u3": [
  [
   "Je vais t'expliquer la vie des",
   "Digimon ! D'abord, bien sûr,",
   "ils mangent. Quand ils ont"
  ],
  [
   "faim, ils te le font savoir.",
   "Ensuite, ils font leurs",
   "besoins. Mieux vaut les emmener"
  ],
  [
   "aux toilettes dès que possible.",
   "Quand ils ont sommeil, ils",
   "dorment. Ils attendent que toi,"
  ],
  [
   "{color 6}{player}{color 1}, tu leur en",
   "donnes l'ordre, mais le plus",
   "tôt sera le mieux. Ils se"
  ],
  [
   "fatiguent, tombent malades et",
   "deviennent grognons aussi. Ils",
   "sont assez fragiles, tu sais !"
  ],
  [
   "Les Digimon gardent un coeur",
   "sauvage : parfois, il faut les",
   "féliciter, et parfois les"
  ],
  [
   "gronder. Quoi que tu fasses,",
   "observe bien ton Digimon et",
   "prends soin de lui."
  ]
 ],
 "s178.sec20.u0": [
  [
   "Alors, tu as repris",
   "connaissance... Je suis désolé,",
   "mon garçon."
  ]
 ],
