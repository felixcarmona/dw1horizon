{
 "s165.sec5.u0": [
  [
   "Ah, tu tombes à pic ! J'ai une",
   "faveur importante à te",
   "demander, une tâche que toi"
  ],
  [
   "seul peux accomplir."
  ]
 ],
 "s165.sec5.u1": [
  [
   "De quoi s'agit-il ?"
  ]
 ],
 "s165.sec5.u2": [
  [
   "Je viens de la ressentir : la",
   "même présence maléfique que",
   "celle d'Analogman et de"
  ],
  [
   "Machinedramon. Mais j'ignore",
   "encore d'où elle vient..."
  ]
 ],
 "s165.sec5.u3": [
  [
   "Encore ?! D'accord, je m'en",
   "occupe !"
  ]
 ],
 "s165.sec5.u4": [
  [
   "Oh, merci. Au fait..."
  ]
 ],
 "s165.sec5.u5": [
  [
   "Il paraît que tu as vaincu",
   "Machinedramon !"
  ]
 ],
 "s165.sec5.u6": [
  [
   "Oui. Mais je ne comprends pas",
   "bien. On aurait dit une sorte",
   "de malédiction d'Analogman."
  ]
 ],
 "s165.sec5.u7": [
  [
   "Sa rancoeur doit encore",
   "persister, terriblement",
   "forte... Enfin, avec ça, nous"
  ],
  [
   "retrouverons peut-être la",
   "paix."
  ]
 ],
 "s165.sec5.u8": [
  [
   "Si Machinedramon revient, on le",
   "battra encore. Ce sera comme",
   "une fête annuelle. Sympa, non ?"
  ]
 ],
 "s165.sec5.u9": [
  [
   "Ha ha, voilà qui me rassure.",
   "Ah, oui, prends ceci en",
   "remerciement. Ça a poussé par"
  ],
  [
   "hasard à la ferme à viande."
  ]
 ],
 "s165.sec5.u10": [
  [
   "Ouah, un {color 6}Melon trop mûr{color 1} ?"
  ]
 ],
 "s165.sec5.u11": [
  [
   "Oups, mon sac est plein."
  ]
 ],
 "s165.sec5.u12": [
  [
   "Je le prends, merci !"
  ]
 ],
 "s165.sec5.u13": [
  [
   "Ah, te voilà ! C'est une",
   "affaire importante, que je ne",
   "peux confier qu'à toi."
  ]
 ],
 "s165.sec5.u14": [
  [
   "Hé hé, pas de quoi. Alors,",
   "c'est quoi cette histoire de",
   "retour d'Analogman ?"
  ]
 ],
 "s165.sec5.u15": [
  [
   "Hmm, je la sens. Une présence",
   "tout aussi maléfique que la",
   "sienne. Mais je n'arrive pas à"
  ],
  [
   "savoir d'où elle vient..."
  ]
 ],
 "s165.sec5.u16": [
  [
   "D'accord, je m'en occupe ! Je",
   "le trouverai et je le vaincrai."
  ]
 ],
 "s165.sec5.u17": [
  [
   "Oh, merci. Au fait..."
  ]
 ],
 "s165.sec7.u0": [
  [
   "On dirait que Yuramon a",
   "entendu de nouvelles rumeurs."
  ]
 ],
 "s165.sec7.u1": [
  [
   "Ah oui, Yuramon dit connaître",
   "de nouvelles rumeurs."
  ]
 ],
 "s165.sec7.u2": [
  [
   "La ville s'anime de plus en",
   "plus, et les conversations",
   "changent un peu, elles aussi."
  ]
 ],
 "s165.sec7.u3": [
  [
   "{color 6}{player}{color 1}, ta façon de vivre",
   "l'aventure est assez originale,",
   "tu sais."
  ]
 ],
 "s165.sec20.u0": [
  [
   "Alors, tu as repris",
   "connaissance... Je suis désolé,",
   "mon garçon."
  ]
 ],
 "s165.sec85.m0.o0": "L'utiliser",
 "s165.sec85.m0.o1": "Ne pas l'utiliser",
 "s165.sec85.u0": [
  [
   "Oh ? C'est quoi, cette machine",
   "?"
  ]
 ],
 "s165.sec85.u1": [
  [
   "Hmm, ça ? C'est la {color 4}machine de",
   "sauvegarde des données de",
   "combat sur carte mémoire{color 1}. Elle"
  ],
  [
   "enregistre les données de ton",
   "partenaire actuel pour les",
   "combats. Appuie sur {color 6}×{color 1} devant"
  ],
  [
   "elle et suis ses instructions."
  ]
 ],
 "s165.sec85.u2": [
  [
   "Utiliser la {color 4}machine de",
   "sauvegarde des données de",
   "combat{color 1} ?"
  ]
 ],
 "s166.sec5.u0": [
  [
   "Ils travaillent tous si dur !"
  ]
 ],
 "s166.sec6.u0": [
  [
   "On dirait que rien n'est là."
  ]
 ],
 "s166.sec7.u0": [
  [
   "Airdramon est endormi. . ."
  ]
 ],
 "s166.sec60.u0": [
  [
   "Hmm, il a l'air d'aller bien",
   "pour le moment."
  ]
 ],
 "s166.sec60.u1": [
  [
   "Ouf, tant mieux..."
  ]
 ],
 "s166.sec60.u2": [
  [
   "Pour lui aussi, nous devons",
   "vaincre leur chef au plus vite."
  ]
 ],
 "s166.sec60.u3": [
  [
   "...Je sais, je sais."
  ]
 ],
