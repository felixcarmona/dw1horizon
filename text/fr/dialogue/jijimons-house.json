 "s178.sec82.m0.o1": "Ne pas se reposer",
 "s178.sec82.u0": [
  [
   "Punimon n'est pas là, mais je",
   "peux quand même me reposer."
  ]
 ],
 "s178.sec82.u1": [
  [
   "{color 7}Punimon {color 1}",
   "Je suis Punimon ! Pourquoi ne",
   "pas te reposer un peu ici ?"
  ],
  [
   "{color 7}Punimon {color 1}",
   "Une heure de repos rend",
   "quelques HP et MP, et réduit",
   "un peu la fatigue."
  ]
 ],
