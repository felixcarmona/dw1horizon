 ],
 "s151.sec5.u0": [
  [
   "Tout est normal ici. Fais de",
   "ton mieux."
  ]
 ],
 "s151.sec5.u1": [
  [
   "Moi aussi, je dois aider. Quand",
   "j'en aurai le temps, je ferai",
   "l'aller-retour entre ici et la"
  ],
  [
   "ville."
  ]
 ],
 "s151.sec5.u2": "Andromon a rejoint la ville !",
 "s151.sec5.u3": [
  [
   "La réparation des données est",
   "terminée. Lisons-les",
   "maintenant."
  ]
 ],
 "s151.sec5.u4": [
  [
   "Allez-y."
  ]
 ],
 "s151.sec5.u5": [
  [
   "Il y a 100 ans : des humains",
   "analogiques apparaissent sur",
   "l'île des Digimon. Ils livrent"
  ],
  [
   "de violents combats aux Digimon",
   "natifs. Après 10 ans de guerre,",
   "les humains sont vaincus et"
  ],
  [
   "disparaissent sans laisser de",
   "trace. Au cours des 10 années",
   "suivantes, l'île double presque"
  ],
  [
   "de taille. Cause inconnue."
  ]
 ],
 "s151.sec5.u6": [
  [
   "Les humains... ont combattu les",
   "Digimon..."
  ]
 ],
 "s151.sec5.u7": [
  [
   "C'est tout ce que j'ai pu",
   "réparer. Je suis désolé."
  ]
 ],
 "s151.sec5.u8": [
  [
   "Non, c'est une information",
   "précieuse. Ça explique beaucoup",
   "de choses."
  ]
 ],
 "s151.sec5.u9": [
  [
   "Ah, Oui ?"
  ]
 ],
 "s151.sec5.u10": [
  [
   "Celui qui a semé le chaos sur",
   "l'île est sans doute cet humain",
   "disparu."
  ]
 ],
 "s151.sec5.u11": [
  [
   "Les humains peuvent-ils vivre",
   "100 ans?"
  ]
 ],
 "s151.sec5.u12": [
  [
   "Dans ce monde, le temps semble",
   "passer très lentement pour les",
   "humains seulement. C'est"
  ],
  [
   "pourquoi je me porte bien sans",
   "manger ni dormir. Mais 100 ans,",
   "ça reste long. Il doit être"
  ],
  [
   "coriace."
  ]
 ],
 "s151.sec5.u13": [
  [
   "Il se cache peut-être quelque",
   "part ?"
  ]
 ],
 "s151.sec5.u14": [
  [
   "Je le trouverai... et je",
   "m'occuperai de lui. Maintenant,",
   "je comprends. On m'a appelé ici"
  ],
  [
   "pour le vaincre, car je suis",
   "humain moi aussi."
  ]
 ],
 "s151.sec5.u15": [
  [
   "...Nous te présentons nos",
   "sincères excuses pour ce qui",
   "s'est passé. L'usine fermera"
  ],
  [
   "quelque temps."
  ]
 ],
 "s151.sec5.u16": [
  [
   "L'île est devenue si étrange",
   "que personne ne peut prévoir",
   "ce qui arrivera. Ce n'est pas"
  ],
  [
   "ta faute."
  ]
 ],
 "s151.sec5.u17": [
  [
   "Quelqu'un devait contrôler",
   "Giromon à distance.",
   "L'ordinateur est détruit... et"
  ],
  [
   "des déchets qui rendent les",
   "Digimon fous se déversent. Ce",
   "n'est sûrement pas une"
  ],
  [
   "coïncidence."
  ]
 ],
 "s151.sec5.u18": [
  [
   "Cet ordinateur est très",
   "important. Quelqu'un l'a sans",
   "doute pris pour cible. Même"
  ],
  [
   "s'il est un peu tard pour le",
   "dire..."
  ]
 ],
 "s151.sec5.u19": [
  [
   "Qu'est-ce que tu as dit ?"
  ]
 ],
 "s151.sec5.u20": [
