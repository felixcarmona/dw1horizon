{
 "s025.sec5.u0": [
  [
   "Allez, mets-y du tien !"
  ]
 ],
 "s025.sec5.u1": [
  [
   "Tu n'es pas d'ici !"
  ]
 ],
 "s025.sec51.u0": [
  [
   "Vous avez vidé la terre."
  ]
 ],
 "s025.sec52.u0": [
  [
   "Oups, je dois rendre la caisse",
   "de terre à Drimogemon !"
  ]
 ],
 "s032.sec52.u0": [
  [
   "Hé, on y est presque !"
  ]
 ],
 "s032.sec52.u1": [
  [
   "Hé, te voilà ! Le tunnel est",
   "enfin percé !"
  ]
 ],
 "s032.sec52.u2": [
  [
   "Nous n'aurons plus besoin de",
   "traverser la montagne. Je vous",
   "remercie."
  ]
 ],
 "s032.sec52.u3": [
  [
   "Non, c'est moi qui dois te",
   "remercier. Je ne pouvais rien",
   "faire contre ce gros rocher."
  ]
 ],
 "s032.sec52.u4": [
  [
   "Mais... qu'est-ce que je vais",
   "faire, maintenant ?"
  ]
 ],
 "s032.sec52.u5": [
  [
   "Alors viens en ville. Tu y",
   "trouveras sûrement quelque",
   "chose à faire !"
  ]
 ],
 "s032.sec52.u6": [
  [
   "Oh, j'ai encore de l'énergie à",
   "revendre. J'accepte ton offre !"
  ]
 ],
 "s032.sec52.u7": [
  [
   "On y est presque, encore un",
   "peu de patience !"
  ]
 ],
 "s032.sec52.u8": "Drimogemon a rejoint la ville !"
}
