{
 "s064.sec5.u0": [
  [
   "Nous retournerons à l'arène.",
   "Je suis sûr que je manquerais",
   "à certains. Hé hé..."
  ]
 ],
 "s064.sec5.u1": [
  [
   "Mes hommes sont négligents à",
