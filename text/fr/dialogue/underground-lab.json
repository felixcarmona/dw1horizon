   "SkullGreymon obéit maintenant."
  ]
 ],
 "s064.sec5.u3": [
  [
   "Myotismon, tu vas bien ?!"
  ]
 ],
 "s064.sec5.u4": [
  [
   "Ugh... uhh... Oh ? C'est toi !",
   "Tu viens toujours à mon",
   "secours."
  ]
 ],
 "s064.sec5.u5": [
  [
   "Que s'est-il passé ?"
