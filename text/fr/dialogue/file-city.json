 "s162.sec55.m0.o1": "À la grotte plage secrète",
 "s162.sec55.m0.o2": "Laisse tomber",
 "s162.sec55.u0": [
  [
   "Bonjour ! Ha ha, je t'ai fait",
   "peur, hein ? Emmener les gens",
   "en voyage en mer, c'est mon"
  ],
  [
   "métier. Et toi ? Je peux te",
   "conduire dans des lieux",
   "accessibles seulement par la"
  ],
  [
   "mer. Alors..."
  ]
 ],
 "s162.sec55.u1": [
  [
   "Hmm, où allons-nous ? À la",
   "Ville des usines... ou à la",
   "grotte de la Plage secrète ?"
  ]
 ],
 "s162.sec57.u0": [
  [
   "Je te tiens !"
  ]
 ],
 "s162.sec57.u1": [
  [
   "Q-quoi ? Il nous fonce dessus",
   "?!"
  ]
 ],
 "s162.sec57.u2": [
  [
   "Enfin, nous nous rencontrons !",
   "Je suis Greymon, un voyageur.",
   "Passons aux choses sérieuses !"
  ]
 ],
 "s162.sec57.u3": "Quoi ?!",
 "s162.sec57.u4": [
  [
   "Les rumeurs à ton sujet m'ont",
   "mené ici. Tu vas te battre",
   "contre moi ! Et si je gagne..."
  ],
  [
   "l'enseigne de cette ville sera",
   "à moi !"
  ]
 ],
 "s162.sec57.u5": [
  [
   "Il n'y a pas d'enseigne."
  ]
 ],
 "s162.sec57.u6": [
  [
   "Peu importe ! Bats-toi !"
  ]
 ],
 "s162.sec57.u7": [
  [
   "Hé, tu me donnes du fil à",
   "retordre... pas mal du tout.",
   "Mais tu es encore trop novice"
  ],
  [
   "pour atteindre ton but !"
  ]
 ],
 "s162.sec57.u8": [
  [
   "Hmpf..."
  ]
 ],
 "s162.sec57.u9": [
  [
   "Je vais rester ici pour",
   "t'endurcir. Tu vas devenir",
   "beaucoup, beaucoup plus fort !"
  ]
 ],
 "s162.sec57.u10": "Greymon a rejoint la ville !",
 "s162.sec57.u11": [
  [
   "Hé hé, je t'ai trouvé,",
   "{color 6}{player}{color 1} !"
  ]
 ],
 "s162.sec57.u12": [
  [
   "Une embuscade ?!"
  ]
 ],
 "s162.sec57.u13": [
  [
   "Mon but est de te vaincre... et",
   "pour cela, tous les moyens sont",
   "bons !"
  ]
 ],
 "s162.sec57.u14": [
  [
   "...Ces yeux ! Quelqu'un le",
   "contrôle !"
  ]
 ],
 "s162.sec57.u15": [
  [
   "Ngh... comme ça... même au prix",
   "de ma vie... les vaincre...",
   "tels étaient... mes ordres..."
  ]
 ],
 "s162.sec57.u16": [
  [
   "Qu'est-ce que tu racontes ?",
   "Tu vas vraiment mourir ! Il te",
   "faut des soins, vite..."
  ]
 ],
