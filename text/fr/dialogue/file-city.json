{
 "s162.sec5.u0": [
  [
   "Tu as déjà rencontré le",
   "gardien du lac ? Sinon,",
   "attends-le trèèès patiemment"
  ],
  [
   "sur la rive sud !"
  ]
 ],
 "s162.sec5.u1": [
  [
   "Essaie de te lever trèèès tôt",
   "et de te promener dans la",
   "brume. Il t'arrivera quelque"
  ],
  [
   "chose de bien !"
  ]
 ],
 "s162.sec5.u2": [
  [
   "Hé, tu sais quoi ? Tout au",
   "nooord, il y a la Plage des",
   "icebergs. Il paraît qu'un"
  ],
  [
   "Digimon énooorme y apparaît",
   "souvent ces derniers temps."
  ]
 ],
 "s162.sec5.u3": [
  [
   "Tu as déjà battu les bandits ?",
   "Il paraît qu'ils ont encore une",
   "cachette quelque part."
  ]
 ],
 "s162.sec5.u4": [
  [
   "Tu es déjà allé au Grand",
   "Canyon ? Il paraît que des",
   "bandits y rôdent."
  ]
 ],
 "s162.sec5.u5": [
  [
   "Sont-ils mauvais?"
  ]
 ],
 "s162.sec5.u6": [
  [
   "Quand tu traverses la gorge,",
   "ils t'encerclent et te",
   "dévalisent. J'aimerais que"
  ],
  [
   "quelqu'un nous en débarrasse."
  ]
 ],
 "s162.sec5.u7": [
  [
   "Hmm. On ne peut pas laisser",
   "faire ça."
  ]
 ],
 "s162.sec5.u8": [
  [
   "Tu es déjà allé au Grand",
   "Canyon ? Il paraît qu'il y a un",
   "pont invisible là-bas."
  ]
 ],
 "s162.sec5.u9": [
  [
   "Ils disent que Machinedramon",
   "est revenu à la vie!"
  ]
 ],
 "s162.sec5.u10": [
  [
   "Tu as encore battu",
   "Machinedramon ? Incroyaaaable."
  ]
 ],
 "s162.sec5.u11": [
  [
   "Hé hé, je vais te parler des",
   "environs. La Forêt natale",
   "entoure la ville. Les Digimon"
  ],
  [
   "qui y vivent ne sont pas très",
   "forts. Juste à l'ouest, il y a",
   "le Gymnase vert. Tu iras"
  ],
  [
   "souvent, je pense. De l'autre",
   "côté de la rivière, à l'est,",
   "c'est la Jungle tropicale."
  ],
  [
   "J'ignore ce qu'il y a plus",
   "loin. À l'ouest, une montagne",
   "et un lac bloquent le passage,"
  ],
  [
   "mais il y a peut-être des",
   "terres derrière. Tout au sud,",
   "c'est la mer. Au nord, une"
  ],
  [
   "trèèès haute montagne. Des",
   "deux côtés, le chemin s'arrête.",
   "Voilà tout ce que je sais. Mais"
  ],
  [
   "la ville est au centre de",
   "l'île, alors il doit y avoir",
   "d'autres régions au nord. Je"
  ],
  [
   "me renseignerai sur les rumeurs",
   "du dehors. Viens les écouter",
   "de temps en temps."
  ]
 ],
 "s162.sec6.u0": [
  [
   "Mmm, je suis venu voir comment",
   "ça se passe ici, oui ! Je",
   "n'aime pas les toilettes, mais"
  ],
  [
   "le reste est plutôt bien, oui !"
  ]
 ],
 "s162.sec7.u0": [
  [
   "Hmm... Il semble que... ce soit",
   "assez animé ici. Si je ne",
   "devrais pas rentrer à la Ville"
  ],
  [
   "des usines... demandes-tu ? Ma",
   "fonction de planification",
   "fonctionne normalement. Aucun"
  ],
  [
   "problème."
  ]
 ],
 "s162.sec8.u0": [
  [
   "Oh, tu tombes à pic ! Admire",
   "cette statue ! Hein ? Alors ?",
   "Quelle oeuvre magnifique..."
  ],
  [
   "Rien d'étonnant venant de moi.",
   "Hm ? Quoi ? Qu'as-tu dit ?!",
   "Quoiii ! Tu te moques de moi ?!"
  ],
  [
   "Alors... de quoi parlait-on,",
   "déjà ? Hmm. Bah, laisse tomber."
  ]
 ],
 "s162.sec8.u1": [
