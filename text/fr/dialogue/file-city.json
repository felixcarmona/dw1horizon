 "s192.sec51.u7": [
  [
   "{color 10}{partner}{color 1}, mon meilleur ami...",
   "Notre aventure était la",
   "meilleure de toutes !!"
  ]
 ],
 "s193.sec54.u0": [
  [
   "Hmm... Il reprend connaissance",
   "? On dirait que ça a marché !"
  ]
 ],
 "s193.sec54.u1": [
  [
   "Un humain... comme Jiji l'a",
   "dit!"
  ]
 ],
 "s193.sec54.u2": [
  [
   "Mmmmm. . ."
  ]
 ],
 "s193.sec54.u3": [
  [
   "Chut ! Il se réveille !"
  ]
 ],
 "s193.sec54.u4": [
  [
   "Hein... ? Où... suis-je ?"
  ]
 ],
 "s193.sec54.u5": [
  [
   "Bienvenue dans le monde des",
   "Digimon !"
  ]
 ],
 "s193.sec54.u6": [
  [
   "HU?"
  ]
 ],
 "s193.sec54.u7": [
  [
   "Aaaaah! !"
  ]
 ],
 "s193.sec54.u8": [
  [
   "HU? Quoi ? Quoi de neuf ?"
  ]
 ],
 "s193.sec54.u9": [
  [
   "M-mais qu'est-ce que vous",
   "êtes ?!"
  ]
 ],
 "s193.sec54.u10": [
  [
   "Nous sommes Digimon."
  ]
 ],
 "s193.sec54.u11": [
  [
   "Des Digimon ?! Vous voulez",
   "dire..."
  ]
 ],
 "s193.sec54.u12": [
  [
   "Hm ? Tu connais bien les",
   "Digimon, non... ?"
  ]
 ],
 "s193.sec54.u13": [
  [
   "Hmm ? Ah, je comprends. C'est",
   "un rêve, non ? Oui, c'est ça."
  ]
 ],
 "s193.sec54.u14": [
  [
   "Ce n'est pas un rêve ! Nous",
   "sommes réels !"
  ]
 ],
 "s193.sec54.u15": [
  [
   "Oh, tu es Tokomon ! Vous êtes",
   "donc vraiment des Digimon. Quel",
   "rêve réaliste..."
  ]
 ],
 "s193.sec54.u16": [
  [
   "Hum. Écoute, {color 6}{player}{color 1}. Ce",
   "n'est pas un rêve. Même si ce",
   "n'est pas tout à fait la"
  ],
  [
   "réalité non plus..."
  ]
 ],
 "s193.sec54.u17": [
  [
   "Qu'est-ce que tu racontes ?",
   "Alors comment connais-tu mon",
   "nom ? Et puis, qui es-tu ?"
  ]
 ],
 "s193.sec54.u18": [
  [
   "Je suis Jijimon."
  ]
 ],
 "s193.sec54.u19": [
  [
   "Hein ? Il existe un Digimon qui",
   "s'appelle comme ça ?"
  ]
 ],
 "s193.sec54.u20": [
  [
   "Hé hé. Les Digimon que tu",
   "connais ne sont pas les seuls.",
   "Après tout, tu es dans le"
  ],
  [
   "monde des Digimon."
  ]
 ],
 "s193.sec54.u21": [
  [
   "Digimon... Monde. . ."
  ]
 ],
 "s193.sec54.u22": [
  [
   "Un monde qui n'est ni un rêve",
   "ni une réalité. Le monde de",
   "Digimon!"
  ]
 ],
 "s193.sec54.u23": [
  [
   "Eh bien... Maintenant que tu le",
   "dis... c'est bien trop réel",
   "pour un rêve..."
  ]
 ],
 "s193.sec54.u24": [
  [
   "Regarde derrière toi. Tu",
   "devrais comprendre."
  ]
 ],
 "s193.sec54.u25": [
  [
   "HU?"
  ]
 ],
 "s193.sec54.u26": [
  [
   "Impossible... C'est",
   "{color 10}{partner}{color 1}, le Digimon que",
   "j'élève ?"
  ]
 ],
 "s193.sec54.u27": [
  [
   "C'est ça... ! J'ai été aspiré",
   "dans mon porte-clés Digimon..."
  ]
 ],
 "s193.sec54.u28": [
  [
   "C'est ça. Maintenant, tu",
   "comprends."
  ]
 ],
 "s193.sec54.u29": [
  [
   "Je comprends, mais... pourquoi",
   "suis-je... ici ?"
  ]
 ],
 "s193.sec54.u30": [
  [
   "Hmm... Maintenant que tu",
   "comprends, viens chez nous. On",
   "en parlera là-bas."
  ]
 ],
 "s193.sec55.u0": [
  [
   "Bon, où en étais-je ? C'est",
   "moi qui t'ai appelé ici. Nous",
   "avons besoin que tu nous"
  ],
  [
   "sauves."
  ]
 ],
 "s193.sec55.u1": [
  [
   "Vous sauver ?? Pourquoi ?",
   "Qu'est-ce qui ne va pas ?"
  ]
 ],
 "s193.sec55.u2": [
  [
   "Nous sommes à File City, au",
   "centre de l'île File."
  ]
 ],
 "s193.sec55.u3": [
  [
   "Une ville ? Ça ? C'est plutôt",
   "petit et délabré."
  ]
 ],
 "s193.sec55.u4": [
  [
   "Hé... Disons plutôt que c'était",
   "une ville. Autrefois, des",
   "Digimon de toutes sortes"
  ],
  [
   "vivaient ici."
  ]
 ],
 "s193.sec55.u5": [
  [
   "Mais un jour, les Digimon ont",
   "commencé à perdre leur",
   "\"coeur\"... et se sont dispersés"
  ],
  [
   "hors de la ville."
  ]
 ],
 "s193.sec55.u6": [
  [
   "Que veux-tu dire ?"
  ]
 ],
 "s193.sec55.u7": [
  [
   "Nous ignorons pourquoi... Les",
   "Digimon perdent la parole..."
  ]
 ],
 "s193.sec55.u8": [
  [
   "Certains parlent encore un",
   "peu... mais ils ont oublié",
   "avoir vécu en ville."
  ]
 ],
 "s193.sec55.u9": [
  [
   "Je vois. C'est donc ça, perdre",
   "leur \"coeur\"."
  ]
 ],
 "s193.sec55.u10": [
  [
   "Exactement. Et c'est",
   "dangereux. Selon la légende, si",
   "File City est en péril, tous"
  ],
  [
   "les Digimon le sont aussi..."
  ]
 ],
 "s193.sec55.u11": [
  [
   "Mais pourquoi moi ? N'importe",
   "qui pourrait le faire, non ?"
  ]
 ],
 "s193.sec55.u12": [
  [
   "Tu sais bien élever les",
   "Digimon, n'est-ce pas ?"
  ]
 ],
 "s193.sec55.u13": [
  [
   "Hein ? ...Ah oui. Je suis très",
   "doué ! Hé hé."
  ]
 ],
 "s193.sec55.u14": [
  [
   "Tu n'as pas remarqué ? Tu",
   "parles la langue des Digimon."
  ]
 ],
 "s193.sec55.u15": [
  [
   "Quoi ? Je suis pourtant sûr de",
   "parler français normalement."
  ]
 ],
 "s193.sec55.u16": [
  [
   "Pour nous, c'est exactement la",
   "langue des Digimon."
  ]
 ],
 "s193.sec55.u17": [
  [
   "Oui, oui!"
  ]
 ],
 "s193.sec55.u18": [
  [
   "Tu vois, l'amour que tu portes",
   "aux Digimon dans ton monde se",
   "manifeste ici sous forme de"
  ],
  [
   "véritable pouvoir."
  ]
 ],
 "s193.sec55.u19": [
  [
   "O-oh... Tu me fais rougir."
  ]
 ],
 "s193.sec55.u20": [
  [
   "C'est pour cela que je t'ai",
   "choisi. Tu peux ramener ici les",
   "Digimon de toute l'île File !"
  ]
 ],
 "s193.sec55.u21": [
  [
   "Oh..."
  ]
 ],
 "s193.sec55.u22": [
  [
   "Ohh..."
  ]
 ],
 "s193.sec55.u23": [
  [
   "Ohhh ! D-d'accord, je vois !",
   "Maintenant, j'ai tout compris !",
   "Ha ha ! Je m'en occupe !"
  ]
 ],
 "s193.sec55.u24": [
  [
   "Youpi ! Hourra, hourra !"
  ]
 ],
 "s193.sec55.u25": [
  [
   "Hmm, hmm, merci. Je sais que",
   "cette demande est égoïste, mais",
   "tu es notre dernier espoir."
  ]
 ],
 "s193.sec55.u26": [
  [
   "Hé hé. Alors, je commence par",
   "quoi ?"
  ]
 ],
 "s193.sec55.u27": [
  [
   "Désormais, toi et ton",
   "partenaire {color 10}{partner}{color 1}, vous",
   "parcourrez l'île File ensemble."
  ]
 ],
 "s193.sec55.u28": [
  [
   "Découvre ce qui se cache",
   "derrière tout ça et convaincs",
   "les Digimon de revenir en"
  ],
  [
   "ville."
  ]
 ],
 "s193.sec55.u29": [
  [
   "D'accord, compris. Allez, c'est",
   "parti, {color 10}{partner}{color 1} !"
  ]
 ],
 "s193.sec55.u30": [
  [
   "H-hé, attends, je n'ai pas",
   "fini..."
  ]
 ]
