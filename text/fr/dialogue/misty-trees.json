 "s115.sec51.u6": [
  [
   "Ho ho. C'est donc ça. Comme",
   "je le pensais."
  ]
 ],
 "s115.sec51.u7": [
  [
   "...Tu ne peux pas ?"
  ]
 ],
 "s115.sec51.u8": [
  [
   "D'abord, tu dois écouter ce",
   "que j'ai à dire. Alors... par",
   "où commencer ?"
  ]
 ],
 "s115.sec51.u9": [
  [
   "Si tu sais quelque chose sur",
   "les troubles de l'île,",
   "j'aimerais que tu me le dises."
  ]
 ],
 "s115.sec51.u10": [
  [
   "Hmm. Oui, oui. Les troubles."
  ]
 ],
 "s115.sec51.u11": [
  [
   "Tout a commencé à aller mal sur",
   "l'île il y a environ 80 ans.",
   "D'abord, les terres ont changé."
  ],
  [
   "Terres gelées, le Manoir du",
   "Seigneur Gris, le Grand",
   "Canyon... Ces régions du"
  ],
  [
   "nord-est sont apparues",
   "soudainement, il y a environ 80",
   "ans. Puis les Digimon se sont"
  ],
  [
   "peu à peu installés dans les",
   "régions qui leur convenaient.",
   "Les espèces se sont"
  ],
  [
   "dispersées. Les Digimon, qui",
   "parlaient tous la même langue,",
   "ont commencé à parler chacun la"
  ],
  [
   "leur."
  ]
 ],
 "s115.sec51.u12": [
  [
   "Ils ont oublié la langue de la",
   "ville... Ainsi, File City, où",
   "vivaient autrefois tant"
  ],
  [
   "d'espèces, a perdu la plupart",
   "de ses Digimon et est tombée",
   "en ruine. Puis, chose terrible,"
  ],
  [
   "les Digimon ont commencé à",
   "perdre la mémoire ! Leur passé,",
   "celui de l'île, leur raison..."
  ],
  [
   "Même moi, je ne me souviens",
   "plus d'une chose importante...",
   "quelque chose que je dois te"
  ],
  [
   "dire."
  ]
 ],
 "s115.sec51.u13": [
  [
   "Mais tout est lié. Quelqu'un a",
   "provoqué tout cela ! Pour que",
   "tout se plie à ses désirs..."
  ],
  [
   "Bientôt, les Digimon ne verront",
   "même plus ce qui est anormal,",
   "je le crains. Seul le lien"
  ],
  [
   "entre toi et File City peut",
   "l'empêcher ! Rassemble les",
   "Digimon en ville et accomplis"
  ],
  [
   "un miracle. Un miracle se",
   "produira, j'en suis sûr. Tout",
   "le monde compte sur toi !!!"
  ],
  [
   "...Oh, je me suis emporté.",
   "Ouf... Voilà tout ce que j'ai à",
   "te dire..."
  ]
 ],
 "s115.sec51.u14": [
  [
   "Bien, dissipons le brouillard."
