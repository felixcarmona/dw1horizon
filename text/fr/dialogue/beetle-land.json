   "entraîner."
  ]
 ],
 "s103.sec5.u7": "Kabuterimon a rejoint la ville !",
 "s103.sec6.u0": [
  [
   "Chaque année, jour avec deux",
   "2, tournoi d'insectes ici.",
   "Gagnant recevoir super prix."
  ],
  [
   "Mais seuls Digimon insectes",
   "pouvoir entrer."
  ]
 ],
 "s103.sec6.u1": [
  [
