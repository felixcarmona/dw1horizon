 "s076.sec6.u0": [
  [
   "Grraaaaaaah !"
  ]
 ],
 "s076.sec7.u0": [
  [
   "C'est partiii, j'arriiive !!"
  ]
 ],
 "s076.sec8.u0": [
  [
   "Ssssssss!"
  ]
 ],
 "s076.sec9.u0": [
  [
   "Bzzzzzzzzz!"
  ]
 ],
 "s076.sec51.u0": [
  [
   "T'es qui, toi ?! Personne ne",
   "saccagera cet endroit tant que",
   "je monte la garde !"
  ]
 ],
 "s076.sec51.u1": [
  [
   "Non, nous parcourons l'île pour",
   "la sauver..."
  ]
 ],
 "s076.sec51.u2": [
  [
   "Tu crois que je vais gober un",
   "mensonge aussi bête ? Prends",
   "ça !"
  ]
 ],
 "s076.sec51.u3": [
  [
   "H-hé, attends..."
  ]
 ],
 "s076.sec51.u4": [
  [
   "Attends... tu dis la vérité ?"
  ]
 ],
 "s076.sec51.u5": [
  [
   "C'est ce que je te dis depuis",
   "le début !"
  ]
 ],
 "s076.sec51.u6": [
  [
   "Hé, désolé. On voit rarement",
   "des étrangers ici. C'est ma",
   "première mission depuis"
  ],
  [
   "longtemps, je me suis emporté."
  ]
 ],
 "s076.sec51.u7": [
  [
   "Travail ?"
  ]
 ],
 "s076.sec51.u8": [
  [
   "Oui. Je garde cet endroit, la",
   "Région Dino antique, la contrée",
   "la plus reculée de l'île !"
  ]
 ],
 "s076.sec51.u9": [
  [
   "Ah... Et si tu nous faisais",
   "visiter ?"
  ]
 ],
 "s076.sec51.u10": [
  [
   "La Région Dino antique se",
   "divise en deux grandes parties.",
   "D'abord, la Région glaciaire"
  ],
  [
   "antique, où vivent les Digimon",
   "dinosaures comme nous. C'est",
   "un endroit spécial où le temps"
  ],
  [
   "passe plus lentement."
  ]
 ],
 "s076.sec51.u11": [
  [
   "Le temps passe-t-il plus",
   "lentement? . . ? C'est bizarre."
  ]
 ],
 "s076.sec51.u12": [
  [
   "L'autre, c'est la Région rapide",
   "antique. Elle se trouve après",
   "la région glaciaire et elle est"
  ],
  [
   "dangereuse. Pourquoi ? Le",
   "temps y passe à toute vitesse.",
   "Le sol est usé, et des os et"
  ],
  [
   "fossiles traînent partout."
  ]
 ],
 "s076.sec51.u13": [
  [
   "Bien sûr, il s'y est écoulé",
   "plus de temps qu'ailleurs."
  ]
 ],
 "s076.sec51.u14": [
  [
   "Exactement. Si tu tiens à la",
   "vie, n'y va pas. ...De toute",
   "façon, je bloque le chemin, je"
  ],
  [
   "ne te laisserais pas passer."
  ]
 ],
 "s076.sec51.u15": [
  [
   "Mais tu viens de perdre contre",
   "nous."
  ]
 ],
 "s076.sec51.u16": [
  [
   "Argh... C'était un coup de",
   "chance ! D'habitude, ça ne se",
   "passe pas comme ça !"
  ]
 ],
 "s076.sec51.u17": [
  [
   "Si tu le dis..."
  ]
 ],
 "s076.sec51.u18": [
  [
   "Euh... B-bon, je ferais mieux",
   "de retourner à mon poste !",
   "Pour le reste, demande aux"
  ],
  [
   "Digimon du coin. Salut !"
  ]
 ]
}
