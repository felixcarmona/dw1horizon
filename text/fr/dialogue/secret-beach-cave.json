{
 "s136.sec6.u0": [
  [
   "Attends !"
  ]
 ],
 "s136.sec6.u1": [
  [
   "Comme si j'allais t'attendre !"
  ]
 ],
 "s136.sec6.u2": [
  [
   "Gwah ha ha ha !"
  ]
 ],
 "s136.sec6.u3": [
  [
   "Hé, tu m'as fait peur !"
  ]
 ],
 "s136.sec6.u4": [
  [
   "Bien joué, Whamon! C'est notre",
   "opportunité !"
  ]
 ],
 "s136.sec6.u5": [
  [
   "Allez, rends-toi !"
  ]
 ],
 "s136.sec6.u6": [
  [
   "Ngh, nnngh. . ."
  ]
 ],
 "s136.sec6.u7": [
  [
   "Viens en ville et travaille",
   "pour réparer tes torts."
  ]
 ],
 "s136.sec6.u8": [
  [
   "D-d'accord... J'irai en",
   "ville..."
  ]
 ],
 "s136.sec6.u9": [
  [
   "Bouahaha, comme si j'allais y",
   "aller ! Salut les nuls !"
  ]
 ],
 "s136.sec6.u10": [
  [
   "Argh, il m'a eu ! Grrr."
  ]
 ],
 "s136.sec6.u11": [
  [
   "Tant pis. Au moins, on a",
   "récupéré la grotte. C'est déjà",
   "ça."
  ]
 ],
 "s136.sec6.u12": [
  [
   "C'est ça. Je pense que la",
   "grotte est sécurisée."
  ]
 ],
 "s136.sec6.u13": [
  [
   "...... Tu as vraiment bon",
   "coeur. Ces types finiront par",
   "comprendre leurs erreurs."
  ]
 ],
 "s136.sec6.u14": [
  [
   "J'aimerais te donner mon",
   "trésor. Il est au fond."
  ]
 ],
 "s136.sec6.u15": [
  [
   "Hein ? Attends, c'est ton",
   "trésor, non ? Je ne peux pas",
   "l'accepter."
  ]
 ],
 "s136.sec6.u16": [
  [
   "Non, je n'en ai plus besoin.",
   "Vois-tu, j'ai décidé de",
   "rejoindre ta ville."
  ]
 ],
 "s136.sec6.u17": [
  [
   "Hein ? Pourquoi ce changement",
   "soudain ? Alors, ça n'a servi à",
   "rien de récupérer la grotte !"
  ]
 ],
 "s136.sec6.u18": [
  [
   "Pardon si cela te contrarie.",
   "Mais je veux te rendre ta",
   "gentillesse. Je tiens vraiment"
  ],
  [
   "à vous aider."
  ]
 ],
 "s136.sec6.u19": [
  [
   "Je vois. Merci. Tu es vraiment",
   "quelqu'un de bien, toi aussi."
  ]
 ],
 "s136.sec6.u20": [
  [
   "Alors, je vais aller",
   "directement en ville. Je vous",
   "porterai une partie du chemin."
  ]
 ],
 "s136.sec6.u21": "Whamon a rejoint la ville !",
 "s136.sec60.u0": [
  [
   "Une voix vient du fond... Cette",
   "voix !"
  ]
 ],
 "s136.sec81.m0.o0": "Revenir",
 "s136.sec81.m0.o1": "Ne pas revenir",
 "s136.sec81.u0": [
  [
   "On retourne en ville ?"
  ]
 ],
 "s137.sec51.u0": [
  [
   "Oh, Oh!"
  ]
 ],
 "s137.sec51.u1": [
  [
   "Mm?"
  ]
 ],
 "s137.sec51.u2": [
  [
   "Gwah ?!"
  ]
 ],
 "s137.sec51.u3": [
  [
   "C-chef, on a des ennuis !"
  ]
 ],
 "s137.sec51.u4": [
  [
   "Qu'est-ce que vous fabriquez",
   "?!"
  ]
 ],
 "s137.sec51.u5": [
  [
   "Gwah hé hé, vous avez trouvé",
   "la nouvelle forteresse Ogre,",
   "hein !"
  ]
 ],
 "s137.sec51.u6": [
  [
   "Vous préparez encore un",
   "mauvais coup ?!"
  ]
 ],
 "s137.sec51.u7": [
  [
   "Bien sûr ! Gyuh hé hé hé !"
  ]
 ],
 "s137.sec51.u8": [
  [
   "Hmpf, pas question ! Vous allez",
   "quitter cette grotte."
  ]
 ],
 "s137.sec51.u9": [
  [
   "Hé, cette fois, ça ne se",
   "passera pas comme la dernière",
   "fois..."
  ]
 ],
 "s137.sec51.u10": [
  [
   "Chef, tu veux dire... ?"
  ]
 ],
 "s137.sec51.u11": [
  [
   "Oui, c'est ça. Vas-y !"
  ]
 ],
 "s137.sec51.u12": "Qu-quoi ?!",
 "s137.sec51.u13": [
  [
   "Monsieur WaruSeadramon !",
   "Donnez-leur une bonne leçon !"
  ]
 ],
 "s137.sec51.u14": [
  [
   "Alors vous avez engagé un",
   "garde du corps !"
  ]
 ],
 "s137.sec51.u15": [
  [
   "Gyahahaha ! Vous êtes fichus !"
  ]
 ],
 "s137.sec51.u16": [
  [
   "Mince !"
  ]
 ],
 "s137.sec51.u17": [
  [
   "Aaaay!"
  ]
 ],
 "s137.sec51.u18": [
  [
   "Vous ne vous échapperez pas !"
  ]
 ]
}
