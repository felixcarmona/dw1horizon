{
 "s049.sec81.m0.o0": "Je vais essayer.",
 "s049.sec81.m0.o1": "Pas maintenant",
 "s049.sec81.u0": [
  [
   "Bienvenue... Oh ? Je ne t'ai",
   "jamais vu ici. Tu viens de loin",
   "?"
  ]
 ],
 "s049.sec81.u1": [
  [
   "Je viens de la ville. Et bien,",
   "En fait, d'un autre monde."
  ]
 ],
 "s049.sec81.u2": [
  [
   "Alors tu comprends ce que je",
   "dis."
  ]
 ],
 "s049.sec81.u3": [
  [
   "Bien sûr... Ah, attends, ce",
   "n'est pas normal, si... Comment",
   "tiens-tu une boutique si"
  ],
  [
   "personne ne te comprend ?"
  ]
 ],
 "s049.sec81.u4": [
  [
   "Oh, avec l'expérience et des",
   "gestes. Mais c'est parfois",
   "difficile. Les ventes ne"
  ],
  [
   "décollent pas..."
  ]
 ],
 "s049.sec81.u5": [
  [
   "Ah, je vois."
  ]
 ],
 "s049.sec81.u6": [
  [
   "Les affaires marchent mal ces",
   "derniers temps. Mes anciens",
   "clients ne viennent plus..."
  ]
 ],
 "s049.sec81.u7": [
  [
   "Ce doit être à cause des",
   "troubles sur l'île..."
  ]
 ],
 "s049.sec81.u8": [
  [
   "Alors, j'aimerais te demander",
   "de l'aide pour quelque chose."
  ]
 ],
 "s049.sec81.u9": [
  [
   "De quoi s'agit-il ?"
  ]
 ],
 "s049.sec81.u10": [
  [
   "Que dirais-tu de travailler",
   "dans ma boutique ?"
  ]
 ],
 "s049.sec81.u11": [
  [
   "Hein ? Dans la boutique ?"
  ]
 ],
 "s049.sec81.u12": [
  [
   "Juste une demi-journée. Ta",
   "paie augmente avec les ventes.",
   "Tu comprends la langue et je"
  ],
  [
   "sens que tu as du talent pour",
   "ça."
  ]
 ],
 "s049.sec81.u13": [
  [
   "Hmm. Ne m'en veux pas si tu",
   "perds de l'argent..."
  ]
 ],
 "s049.sec81.u14": [
  [
   "Ne t'en fais pas. Quoi qu'il",
   "arrive, j'apprendrai quelque",
   "chose. Cela dure environ huit"
  ],
  [
   "heures. Tu acceptes ?"
  ]
 ],
 "s049.sec81.u15": [
  [
   "Je vois... Tant pis. Reviens",
   "quand tu auras le temps."
  ]
 ],
 "s049.sec81.u16": [
  [
   "Oh, tu es prêt pour le petit",
   "boulot ?"
  ]
 ],
 "s049.sec82.u0": [
  [
   "Très bien. On vient de passer",
   "la moitié."
  ]
 ],
 "s049.sec82.u1": [
  [
   "Hmm, à ce rythme... nous ne",
   "ferons peut-être pas de",
   "bénéfice. Continue tes efforts."
  ]
 ],
 "s049.sec82.u2": [
  [
   "Bien, les ventes marchent",
   "assez bien. On fera peut-être",
   "un bénéfice, finalement."
  ]
 ],
 "s049.sec82.u3": [
  [
   "Eh bien ! Des ventes pareilles,",
   "c'est rare. Continuons comme",
   "ça jusqu'au bout."
  ]
 ],
 "s049.sec82.u4": [
  [
   "Très bien. On dirait que le",
   "temps est écoulé."
  ]
 ],
 "s049.sec82.u5": [
  [
   "Hmm, je pensais que tu ferais",
   "un peu mieux. Mais certains",
   "jours, la chance n'est pas au"
  ],
  [
   "rendez-vous... Viens encore",
   "m'aider."
  ]
 ],
 "s049.sec82.u6": [
  [
   "500 Bits obtenus !"
  ]
 ],
 "s049.sec82.u7": [
  [
   "Oui, les ventes sont conformes",
   "à mes attentes. Mais pour",
   "quelqu'un de ton talent, ce"
  ],
  [
   "n'est pas encore assez. Viens",
   "encore m'aider."
  ]
 ],
 "s049.sec82.u8": [
  [
   "1500 Bits obtenus !"
  ]
 ],
 "s049.sec82.u9": [
  [
   "Que dire sinon : splendide !",
   "Ton esprit, ta volonté et ton",
   "caractère suffisent à sauver"
  ],
  [
   "l'île."
  ]
 ],
 "s049.sec82.u10": [
  [
   "HU?"
  ]
 ],
 "s049.sec82.u11": [
  [
   "Pardonne-moi. Je te mettais à",
   "l'épreuve pour savoir si tu",
   "étais capable de sauver l'île."
  ],
  [
   "Bien sûr, il faut être fort au",
   "combat."
  ]
 ],
 "s049.sec82.u12": [
  [
   "Mais je pensais que la force",
   "seule ne suffirait pas à sauver",
   "l'île. Il faut aussi de"
  ],
  [
   "l'esprit et du courage."
  ]
 ],
 "s049.sec82.u13": [
  [
   "Désolé de te l'avoir caché."
  ]
 ],
 "s049.sec82.u14": [
  [
   "Alors, on a réussi l'épreuve ?"
  ]
 ],
 "s049.sec82.u15": [
  [
   "Bien au-delà de mes attentes.",
   "Désormais, je vous aiderai de",
   "toutes mes forces."
  ]
 ],
 "s049.sec82.u16": [
  [
   "Alors tu viendras en ville !",
   "Hmm ? Et cette boutique ?"
  ]
 ],
 "s049.sec82.u17": [
  [
   "Oh, je peux ouvrir une boutique",
   "quand je veux. Celle-ci a",
   "rempli son rôle."
  ]
 ],
 "s049.sec82.u18": [
  [
   "Monochromon a rejoint la ville",
   "! 2000 Bits obtenus !"
  ]
 ]
