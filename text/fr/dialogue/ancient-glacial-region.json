 "s078.sec82.u1": [
  [
   "Ici, le temps passe lentement.",
   "Une journée à l'extérieur ne",
   "dure qu'une demi-journée ici."
  ]
 ],
 "s078.sec82.u2": [
  [
   "C'est un bel endroit pour ceux",
   "qui aiment prendre leur temps."
  ]
 ],
 "s078.sec82.u3": [
  [
   "Plus loin, dans la Région",
   "rapide antique, le temps",
   "s'accélère. Deux jours y"
  ],
  [
   "passent pendant qu'un seul",
   "s'écoule dehors."
  ]
 ],
 "s078.sec82.u4": [
  [
   "On peut dire que ça permet de",
   "grandir plus vite... mais une",
   "fois réduit à l'état d'os,"
  ],
  [
   "c'est trop tard."
  ]
 ],
 "s079.sec6.u0": [
  [
   "Après ce point, le temps passe",
   "deux fois plus vite que dehors.",
   "Emporte assez de nourriture."
  ],
  [
   "Et surveille ta durée de vie,",
   "bien sûr."
  ]
 ],
 "s079.sec6.u1": [
  [
