{
 "s108.sec5.m0.o0": "Qu'est-ce que l'entraînement ?",
 "s108.sec5.m0.o1": "Comment m'entraîner ?",
 "s108.sec5.m0.o2": "Rien, merci.",
 "s108.sec5.u0": [
  [
   "Hé, hé, du nouveau ! Euh...",
   "Tant que ton Digimon est",
   "encore un bébé, essaie de"
  ],
  [
   "répéter le même entraînement.",
   "Il paraît que ça donne un bon",
   "résultat !"
  ]
 ],
 "s108.sec5.u1": [
  [
   "Hé, hé, du nouveau ! Euh...",
   "Pendant un entraînement bonus,",
   "si tu alignes les mêmes images"
  ],
  [
   "que sur le panneau, tes stats",
   "augmentent encore plus !"
  ]
 ],
 "s108.sec5.u2": [
  [
   "Ah oui, je devais te parler des",
   "techniques ! En général, après",
   "un combat, ton Digimon peut"
  ],
  [
   "apprendre une technique que",
   "l'ennemi a utilisée contre lui.",
   "Mais seulement une qu'il peut"
  ],
  [
   "équiper sous sa forme actuelle.",
   "Ça ne marche pas à chaque",
   "fois, mais c'est le moyen le"
  ],
  [
   "plus rapide d'en apprendre",
   "davantage. Et puis... c'est",
   "très rare, mais l'entraînement"
  ],
  [
   "permet aussi d'en apprendre.",
   "Quand son Esprit est assez",
   "élevé, les cours de"
  ],
  [
   "{color 6}{player}{color 1} peuvent lui en",
   "enseigner, paraît-il. Je me",
   "répète, mais les chances sont"
  ],
  [
   "vraiment faibles, alors ne",
   "compte pas trop dessus. Tout",
   "est une question d'équilibre !"
  ]
 ],
 "s108.sec5.u3": [
  [
   "Hé, hé, je suis Koromon ! Jiji",
   "m'a demandé de t'expliquer",
   "l'entraînement. Tu veux savoir"
  ],
  [
   "quelque chose ?"
  ]
 ],
 "s108.sec5.u4": [
  [
   "L'entraînement ici augmente les",
   "stats de ton Digimon. Mais il",
   "le fatigue et prend du temps."
  ],
  [
   "Ça reste un moyen plus sûr",
   "d'améliorer ses stats que les",
   "combats. Et très rarement, ton"
  ],
  [
   "Digimon apprend une nouvelle",
   "technique ! Je t'en parlerai",
   "une autre fois."
  ]
 ],
 "s108.sec5.u5": [
  [
   "Il y a six appareils",
   "d'entraînement ici, chacun avec",
   "un panneau à côté."
  ]
 ],
 "s108.sec5.u6": [
  [
   "D'abord, place-toi devant un",
   "panneau et appuie sur {color 6}×{color 1}.",
   "Lis-le pour savoir quelles"
  ],
  [
   "stats augmentent. Certains",
   "Digimon améliorent facilement",
   "certaines stats, et d'autres"
  ],
  [
   "moins. Il faut essayer pour le",
   "savoir ! Choisis S'entraîner,",
   "puis Entraînement normal : ton"
  ],
  [
   "Digimon s'entraînera une heure.",
   "Tu peux accélérer le temps",
   "avec {color 5}△{color 1}. Ah oui, parlons de"
  ],
  [
   "l'entraînement bonus ! Si tu",
   "réussis, la stat augmente",
   "beaucoup. Mais si tu rates..."
  ],
  [
   "elle augmente à peine. Essaie,",
   "tu verras."
  ]
 ],
 "s108.sec5.u7": [
  [
   "Ah, d'accord... Je vais te",
   "dénicher de nouvelles infos."
  ]
 ],
 "s108.sec6.u0": [
  [
   "Moi aller en ville. Ville trop",
   "ville pour moi. Moi pas à ma",
   "place. Alors moi venir ici. Moi"
  ],
  [
   "refaire machines ici. Mieux",
   "marcher qu'avant. Toi beaucoup",
   "entraîner."
  ]
 ],
 "s108.sec7.u0": [
