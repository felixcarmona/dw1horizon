 "s115.sec51.u11": [
  [
   "Tutto iniziò ad andare storto",
   "sull'isola circa 80 anni fa.",
   "Cominciò con il cambiamento"
  ],
  [
   "delle terre. Terra gelata, la",
   "Villa del Signore Grigio, il",
   "Gran Canyon... Le regioni a"
  ],
  [
   "nord-est apparvero",
   "all'improvviso, circa 80 anni",
   "fa. Poi i Digimon si spostarono"
  ],
  [
   "poco alla volta nelle terre più",
   "adatte a loro. Le specie si",
   "dispersero. E i Digimon, che"
  ],
  [
   "prima parlavano tutti la stessa",
   "lingua, iniziarono a parlare",
   "ciascuno la propria."
  ]
 ],
 "s115.sec51.u12": [
  [
   "Dimenticarono la lingua della",
   "città... Così File City, dove",
   "un tempo vivevano insieme tante"
  ],
  [
   "specie, perse gran parte dei",
   "suoi Digimon e cadde in rovina.",
   "Poi accadde una cosa terribile:"
  ],
  [
   "i Digimon iniziarono a perdere",
   "la memoria! Il loro passato,",
   "quello dell'isola, la"
  ],
  [
   "ragione... Persino io non",
   "ricordo qualcosa di",
   "importante... qualcosa che devo"
  ],
  [
   "dirti."
  ]
 ],
 "s115.sec51.u13": [
  [
   "Ma in fondo è tutto collegato.",
