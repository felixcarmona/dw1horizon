  [
   "di ogni anno, quindi serviti",
   "pure. A cosa serve? A far",
   "piovere, ovviamente."
  ]
 ],
 "s162.sec81.u3": [
  [
   "Ah, che bello! Fotosintesi,",
   "fotosintesi."
  ]
 ],
 "s162.sec81.u4": [
  [
   "Ah, che bello! Fotosintesi,",
   "fotosintesi."
  ]
 ],
 "s162.sec82.u0": [
  [
   "Uff... che pace, che pace."
