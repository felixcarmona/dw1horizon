 "s163.sec5.u0": [
  [
   "Bu. Bu-bu?"
  ]
 ],
 "s163.sec5.u1": [
  [
   "Come sempre... Non capisco una",
   "parola di quello che dice."
  ]
 ],
 "s163.sec5.u2": [
  [
   "Eh? Ah, sì, sì. Oh, capisco,",
   "fai la ronda per noi."
  ]
 ],
 "s163.sec6.u0": [
  [
   "Eh eh eh... Guarda: la mia",
   "bacheca personale."
  ]
 ],
 "s163.sec6.u1": [
  [
   "Una città che cresce ha",
   "bisogno di notizie, no? Così ho",
   "deciso di scrivere un giornale!"
  ],
  [
   "Ingegnoso, eh?"
  ]
 ],
 "s163.sec6.u2": [
  [
   "Vedrai cosa sa fare la mia rete",
   "di informazioni."
  ]
 ],
 "s163.sec6.u3": [
  [
   "Ehi, leggi il mio giornale?"
  ]
 ],
 "s163.sec7.u0": [
  [
   "Aaah. Bello fresco. Quando stai",
   "in un posto comodo, migliora",
   "anche l'umore, vero?"
  ]
 ],
 "s163.sec7.u1": [
  [
   "Ih ih, allora? Ti piace il mio",
   "negozio? Non sono molto bravo",
   "a vendere, ma per ora non c'è"
  ],
  [
   "nessun altro! Porta qui tanti",
   "Digimon, presto, va bene?"
  ]
 ],
 "s163.sec7.u2": [
  [
   "Ih ih, allora? Che te ne pare?"
  ]
 ],
 "s163.sec7.u3": [
  [
   "{color 7}Coelamon {color 1}",
   "Ci siamo messi insieme per",
   "vendere oggetti."
  ]
 ],
 "s163.sec8.u0": [
  [
   "Mmm. Qui cresceva dell'erba",
   "davvero gustosa, così l'ho",
   "mangiata. In compenso, adesso"
  ],
  [
   "in città circola più aria."
  ]
 ],
 "s163.sec8.u1": [
  [
   "Ora che ci penso, l'altro",
   "giorno ho trovato un {color 6}Fungo",
   "felice{color 1}. Pare che sia raro."
  ]
 ],
 "s163.sec8.u2": [
  [
   "Pare che esista anche un",
   "{color 6}Fungo di lusso{color 1}. Se ne trovi",
   "uno, potrai vantartene."
  ]
 ],
 "s163.sec8.u3": [
  [
   "Ora che ci penso, la {color 6}Mela blu{color 1}",
   "della Foresta natia è davvero",
   "gustosa."
  ]
 ],
 "s163.sec8.u4": [
  [
   "Ora che ci penso, la {color 6}Banana",
   "arancio{color 1} della Giungla",
   "tropicale è davvero gustosa."
  ]
 ],
 "s163.sec8.u5": [
  [
   "Ora che ci penso, la {color 6}Fragola",
   "gigante{color 1} del Monte Panorama è",
   "davvero gustosa."
  ]
 ],
 "s163.sec8.u6": [
  [
   "Ora che ci penso, la {color 6}Castagna",
   "dolce{color 1} della Savana ingranaggi",
   "è davvero gustosa."
  ]
 ],
 "s163.sec8.u7": [
  [
   "Ora che ci penso, la",
