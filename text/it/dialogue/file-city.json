  ]
 ],
 "s163.sec9.m0.o0": [
  [
   "Di cosa si tratta?"
  ]
 ],
 "s163.sec9.m0.o1": "Più tardi, va bene?",
 "s163.sec9.u0": [
  [
   "Ehi, Ascoltami un attimo."
  ]
 ],
 "s163.sec9.u1": [
  [
   "Hai visto il ponte a est? È",
   "riparato! Abbiamo lavorato",
   "sodo."
  ]
 ],
 "s163.sec9.u2": [
  [
   "Stiamo ancora riparando il",
   "Ponte digitale. Aspetta ancora",
   "un po', va bene? Ah, pare che"
  ],
  [
   "a sud, a Punta Coela, ci sia un",
   "Digimon raro. Ogni giorno verso",
   "sera fa capolino per un"
  ],
  [
   "momento."
  ]
 ],
 "s163.sec9.u3": [
  [
   "Sai il ponte rotto a est della",
   "città? Pensavamo che nessuno",
   "lo usasse, così l'abbiamo"
  ],
  [
   "lasciato com'era. Ma ora non",
   "possiamo più farlo, no? Quindi",
   "faremo del nostro meglio per"
  ],
  [
   "ripararlo da soli. Intanto",
   "esplora l'ovest e il sud.",
   "Quando avrai fatto un giro,"
  ],
  [
   "torna da me."
  ]
 ],
 "s163.sec9.u4": [
  [
   "Sei stato alla Palude Geko?",
   "Pare che lì un Digimon",
   "dispettoso ti faccia degli"
  ],
  [
   "scherzi."
  ]
 ],
 "s163.sec9.u5": [
  [
