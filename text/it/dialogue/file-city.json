 "s192.sec51.u0": [
  [
   "Allora... E' arrivato il",
   "momento."
  ]
 ],
 "s192.sec51.u1": [
  [
   "Sì... A dire il vero, vorrei",
   "restare qui per sempre. Ma mia",
   "madre sarà preoccupata..."
  ]
 ],
 "s192.sec51.u2": [
  [
   "Tutto quello che posso dirti,",
   "{color 6}{player}{color 1}, è grazie. Avrei",
   "voluto fare di più per te, per"
  ],
  [
   "ricambiarti..."
  ]
 ],
 "s192.sec51.u3": [
  [
   "{color 7}Tokomon {color 1}",
   "Snif... Non dimenticarci, va",
   "bene...?"
  ]
 ],
 "s192.sec51.u4": [
  [
   "Un giorno ci rivedremo... Quel",
   "giorno arriverà... vero...?"
  ]
 ],
 "s192.sec51.u5": [
  [
   "...Amici, mi sono divertito",
   "tantissimo. Grazie."
  ]
 ],
 "s192.sec51.u6": [
  [
   "Su, su... Prima che separarci",
   "diventi ancora più difficile...",
   "iniziamo la cerimonia..."
  ]
 ],
 "s192.sec51.u7": [
  [
   "{color 10}{partner}{color 1}, il mio migliore",
   "amico... La nostra avventura è",
   "stata la più bella di tutte!!"
  ]
 ],
 "s193.sec54.u0": [
  [
   "Mh... riprende conoscenza?",
   "Sembra che abbia funzionato!"
  ]
 ],
 "s193.sec54.u1": [
  [
   "Un umano... come ha detto Jiji!"
  ]
 ],
 "s193.sec54.u2": [
  [
   ". ."
  ]
 ],
 "s193.sec54.u3": [
  [
   "Ssst! Si sta svegliando!"
  ]
 ],
 "s193.sec54.u4": [
  [
   "Eh...? Dove... sono?"
  ]
 ],
 "s193.sec54.u5": [
  [
   "Benvenuto nel mondo dei",
   "Digimon!"
  ]
 ],
 "s193.sec54.u6": [
  [
   "Huh?"
  ]
 ],
 "s193.sec54.u7": [
  [
   "Aaaaah! !"
  ]
 ],
 "s193.sec54.u8": [
  [
   "Huh? Cosa? Che succede?"
  ]
 ],
 "s193.sec54.u9": [
  [
   "M-ma cosa siete voi?!"
  ]
 ],
 "s193.sec54.u10": [
  [
   "Noi siamo Digimon."
  ]
 ],
 "s193.sec54.u11": [
  [
   "Digimon?! Cioè..."
  ]
 ],
 "s193.sec54.u12": [
  [
   "Mh? Saprai cosa sono i",
   "Digimon...?"
  ]
 ],
 "s193.sec54.u13": [
  [
   "Mmm? Ah, capisco. È un sogno,",
   "vero? Sì, è così."
  ]
 ],
 "s193.sec54.u14": [
  [
   "Non è un sogno! Siamo veri!"
  ]
 ],
 "s193.sec54.u15": [
  [
   "Oh, sei Tokomon! Allora siete",
   "davvero Digimon. Che sogno",
   "realistico..."
  ]
 ],
 "s193.sec54.u16": [
  [
   "Ehm. Ascolta, {color 6}{player}{color 1}.",
   "Questo non è un sogno. Ma",
   "nemmeno proprio la realtà..."
  ]
 ],
 "s193.sec54.u17": [
  [
   "Ma cosa dici? Allora come fai a",
   "sapere il mio nome? E tu chi",
   "sei, poi?"
  ]
 ],
 "s193.sec54.u18": [
  [
   "Sono Jijimon."
  ]
 ],
 "s193.sec54.u19": [
  [
   "Eh? Esisteva un Digimon con",
   "quel nome?"
  ]
 ],
 "s193.sec54.u20": [
  [
   "Eheh. I Digimon che conosci",
   "non sono gli unici. Dopotutto,",
   "questo è il mondo dei Digimon."
  ]
 ],
 "s193.sec54.u21": [
  [
   "Digimon... Mondo. . ."
  ]
 ],
 "s193.sec54.u22": [
  [
   "Un mondo che non è né sogno",
   "né realtà. Il mondo di Digimon!"
  ]
 ],
 "s193.sec54.u23": [
  [
   "Beh... Ora che lo dici... è",
   "troppo reale per un sogno..."
  ]
 ],
 "s193.sec54.u24": [
  [
   "Guarda dietro di te. Dovrebbe",
   "chiarirti le idee."
  ]
 ],
 "s193.sec54.u25": [
  [
   "Huh?"
  ]
 ],
 "s193.sec54.u26": [
  [
   "Non può essere... È",
   "{color 10}{partner}{color 1}, il Digimon che",
   "stavo allevando?"
  ]
 ],
 "s193.sec54.u27": [
  [
   "Ecco...! Sono stato risucchiato",
   "nel mio portachiavi Digimon..."
  ]
 ],
 "s193.sec54.u28": [
  [
   "Esatto. Ora lo capisci."
  ]
 ],
 "s193.sec54.u29": [
  [
   "Capisco, ma... perché sono...",
   "qui?"
  ]
 ],
 "s193.sec54.u30": [
  [
   "Mh... Ora che hai capito, vieni",
   "a casa nostra. Ne parleremo lì."
  ]
 ],
 "s193.sec55.u0": [
  [
   "Bene, dov'ero rimasto? Sono io",
   "che ti ho chiamato qui. Abbiamo",
   "bisogno che tu ci salvi."
  ]
 ],
 "s193.sec55.u1": [
  [
   "Salvarvi?? Perché? C'è",
   "qualcosa che non va?"
  ]
 ],
 "s193.sec55.u2": [
  [
   "Siamo a File City, proprio al",
   "centro dell'Isola di File."
  ]
 ],
 "s193.sec55.u3": [
  [
   "Una città? Questa? È",
   "piuttosto piccola e malridotta."
  ]
 ],
 "s193.sec55.u4": [
  [
   "Eh... Beh, dovrei dire che ERA",
   "una città. Un tempo qui",
   "vivevano Digimon di ogni tipo."
  ]
 ],
 "s193.sec55.u5": [
  [
   "Ma a un certo punto i Digimon",
   "hanno iniziato a perdere il",
   "loro \"cuore\"... e si sono"
  ],
  [
   "dispersi fuori città."
  ]
 ],
 "s193.sec55.u6": [
  [
   "Cosa vuoi dire?"
  ]
 ],
 "s193.sec55.u7": [
  [
   "Non sappiamo perché... I",
   "Digimon stanno perdendo la",
   "parola..."
  ]
 ],
 "s193.sec55.u8": [
  [
   "Alcuni parlano ancora un po'...",
   "ma hanno dimenticato di aver",
   "vissuto in città."
  ]
 ],
 "s193.sec55.u9": [
  [
   "Capisco. Ecco cosa significa",
   "perdere il loro \"cuore\"."
  ]
 ],
 "s193.sec55.u10": [
  [
   "Esatto. Ed è pericoloso. La",
   "leggenda dice che, quando File",
   "City è in pericolo, lo sono"
  ],
  [
   "anche tutti i Digimon..."
  ]
 ],
 "s193.sec55.u11": [
  [
   "Ma perché io? Non potrebbe",
   "farlo chiunque?"
  ]
 ],
 "s193.sec55.u12": [
  [
   "Sei bravo ad allevare Digimon,",
   "vero?"
  ]
 ],
 "s193.sec55.u13": [
  [
   "Eh? ...Ah, sì. Sono bravissimo!",
   "Eheh."
  ]
 ],
 "s193.sec55.u14": [
  [
   "Non te ne sei accorto? Parli la",
   "lingua dei Digimon."
  ]
 ],
 "s193.sec55.u15": [
  [
   "Cosa? Sono sicuro di parlare",
   "italiano normalmente."
  ]
 ],
 "s193.sec55.u16": [
  [
   "Per noi suona proprio come la",
   "lingua dei Digimon."
  ]
 ],
 "s193.sec55.u17": [
  [
   "Sì, sì!"
  ]
 ],
 "s193.sec55.u18": [
  [
   "Vedi, l'amore che provi per i",
   "Digimon nel tuo mondo si",
   "manifesta qui come un potere"
  ],
  [
   "reale."
  ]
 ],
 "s193.sec55.u19": [
  [
   "O-oh... Mi fai arrossire."
  ]
 ],
 "s193.sec55.u20": [
  [
   "Ecco perché ho scelto te. Puoi",
   "riportare qui i Digimon di",
   "tutta l'Isola di File!"
  ]
 ],
 "s193.sec55.u21": [
  [
   "Oh..."
  ]
 ],
 "s193.sec55.u22": [
  [
   "Ohh..."
  ]
 ],
 "s193.sec55.u23": [
  [
   "Ohhh! G-giusto, capisco! Ora",
   "ho capito tutto! Ah ah! Ci",
   "penso io!"
  ]
 ],
 "s193.sec55.u24": [
  [
   "Evviva! Urrà, urrà!"
  ]
 ],
 "s193.sec55.u25": [
  [
   "Mh, mh, grazie. So che è una",
   "richiesta egoista, ma sei la",
   "nostra ultima speranza."
  ]
 ],
 "s193.sec55.u26": [
  [
   "Eheh. Allora, cosa faccio per",
   "prima cosa?"
  ]
 ],
 "s193.sec55.u27": [
  [
   "D'ora in poi tu e il tuo",
   "compagno {color 10}{partner}{color 1}",
   "viaggerete insieme per l'Isola"
  ],
  [
   "di File."
  ]
 ],
 "s193.sec55.u28": [
  [
   "Scopri cosa c'è dietro tutto",
   "questo e convinci i Digimon a",
   "tornare in città."
  ]
 ],
 "s193.sec55.u29": [
  [
   "Va bene, capito. Forza,",
   "andiamo, {color 10}{partner}{color 1}!"
  ]
 ],
 "s193.sec55.u30": [
  [
   "E-ehi, aspetta, non ho",
   "finito..."
  ]
 ]
}
