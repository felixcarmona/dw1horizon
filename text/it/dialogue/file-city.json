   "digievolve, le tecniche",
   "equipaggiate vengono azzerate."
  ],
  [
   "Non dimenticarlo!"
  ]
 ],
 "s163.sec9.u6": [
  [
   "Oh, accidenti."
  ]
 ],
 "s163.sec10.u0": [
  [
   "Allora? Ho acceso le luci. C'è",
   "abbastanza luce?"
  ]
 ],
 "s163.sec10.u1": [
  [
