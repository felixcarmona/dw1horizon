{
 "s162.sec5.u0": [
  [
   "Hai già incontrato il guardiano",
   "del lago? Altrimenti aspettalo",
   "con mooolta calma sulla riva"
  ],
  [
   "sud!"
  ]
 ],
 "s162.sec5.u1": [
  [
   "Prova ad alzarti prestiiissimo",
   "e a passeggiare nella nebbia.",
   "Succederà qualcosa di bello!"
  ]
 ],
 "s162.sec5.u2": [
  [
   "Ehi, lo sapevi? Molto a nooord",
   "c'è la Spiaggia degli iceberg.",
   "Pare che ultimamente vi compaia"
  ],
  [
   "spesso un Digimon enooorme."
  ]
 ],
 "s162.sec5.u3": [
  [
   "Hai già sconfitto i banditi?",
   "Pare che abbiano ancora un",
   "nascondiglio da qualche parte."
  ]
 ],
 "s162.sec5.u4": [
  [
   "Sei già stato al Gran Canyon?",
   "Pare che vi compaiano dei",
   "banditi."
  ]
 ],
 "s162.sec5.u5": [
  [
   "Sono cattivi?"
  ]
 ],
 "s162.sec5.u6": [
  [
   "Quando attraversi la gola, ti",
   "circondano e ti derubano.",
   "Vorrei che qualcuno li"
  ],
  [
   "togliesse di mezzo."
  ]
 ],
 "s162.sec5.u7": [
  [
   "Mh. Non possiamo restare a",
   "guardare."
  ]
 ],
 "s162.sec5.u8": [
  [
   "Sei già stato al Gran Canyon?",
   "Pare che ci sia un ponte",
   "invisibile."
  ]
 ],
 "s162.sec5.u9": [
  [
   "Dicono che Machinedramon è",
   "tornato alla vita!"
  ]
 ],
 "s162.sec5.u10": [
  [
   "Hai sconfitto di nuovo",
   "Machinedramon? Incrediiibile."
  ]
 ],
 "s162.sec5.u11": [
  [
   "Eheh, ti spiego cosa c'è fuori",
   "città. Tutto intorno c'è la",
   "Foresta natia. I Digimon che"
  ],
  [
   "ci vivono non sono molto forti.",
   "Appena a ovest c'è la Palestra",
   "verde. Credo che ci andrai"
  ],
  [
   "spesso. Oltre il fiume, a est,",
   "c'è la Giungla tropicale. Non",
   "so cosa ci sia più in là. A"
  ],
  [
   "ovest una montagna e un lago",
   "bloccano il passaggio, ma forse",
   "c'è altro territorio dietro."
  ],
  [
   "Lontano a sud c'è il mare. A",
   "nord una montagna moooolto",
   "alta. Da entrambe le parti non"
  ],
  [
   "si passa. È tutto quello che",
   "so. Ma la città è al centro",
   "dell'isola, quindi penso ci sia"
  ],
  [
   "altro a nord. Cercherò notizie",
   "da fuori: vieni ad ascoltarle",
   "ogni tanto."
  ]
 ],
 "s162.sec6.u0": [
  [
   "Mmm, sono venuto a vedere",
   "come vanno le cose qui, sì! Non",
   "mi piace il bagno, ma il resto"
  ],
  [
   "va piuttosto bene, sì!"
  ]
 ],
 "s162.sec7.u0": [
  [
   "Mh... Sembra che qui... ci sia",
   "parecchio movimento. Mi chiedi",
   "se non dovrei tornare alla"
  ],
  [
   "Città fabbrica...? La mia",
   "funzione di pianificazione",
   "opera normalmente. Non c'è"
  ],
  [
   "alcun problema."
  ]
 ],
 "s162.sec8.u0": [
  [
   "Oh, arrivi al momento giusto!",
   "Ammira questa statua! Eh?",
   "Allora? Che magnifica opera"
  ],
  [
   "d'arte... C'era da aspettarselo",
   "da me. Mh? Che c'è? Cos'hai",
   "detto?! Cooosa! Mi prendi in"
  ],
  [
   "giro?! Dunque... di cosa",
   "parlavamo? Mh. Va beh, lascia",
   "stare."
  ]
 ],
 "s162.sec8.u1": [
  [
   "Hmmmm... Ma cosa... stavo",
   "immaginando... Aaah. Se lo",
   "capisci, me lo dici?"
  ]
 ],
 "s162.sec55.m0.o0": "Alla città fabbrica",
 "s162.sec55.m0.o1": "Alla grotta segreta",
 "s162.sec55.m0.o2": "Lascia stare",
 "s162.sec55.u0": [
  [
   "Ciao! Ah ah, ti ho spaventato,",
   "vero? Portare tutti in viaggio",
   "per mare è il mio mestiere. E"
  ],
  [
   "tu? Posso portarti in posti",
   "raggiungibili solo via mare.",
   "Allora..."
  ]
 ],
 "s162.sec55.u1": [
  [
   "Mh, dove andiamo? Alla Città",
   "fabbrica... o alla grotta della",
   "Spiaggia segreta?"
  ]
 ],
 "s162.sec57.u0": [
  [
   "Ti ho trovato!"
  ]
 ],
 "s162.sec57.u1": [
  [
   "C-cosa? Ci viene addosso?!"
  ]
 ],
 "s162.sec57.u2": [
  [
   "Finalmente ci incontriamo! Sono",
   "Greymon, un viandante. Veniamo",
   "subito al dunque!"
  ]
 ],
 "s162.sec57.u3": "Cosa?!",
 "s162.sec57.u4": [
  [
   "Le voci su di te mi hanno",
   "condotto qui. Combatterai",
   "contro di me! E se vinco..."
  ],
  [
   "l'insegna di questa città sarà",
   "mia!"
  ]
 ],
 "s162.sec57.u5": [
  [
   "Non c'è nessuna insegna."
  ]
 ],
 "s162.sec57.u6": [
  [
   "Non importa! Combatti!"
  ]
 ],
 "s162.sec57.u7": [
  [
   "Eh, mi dai del filo da",
   "torcere... niente male. Ma sei",
   "ancora troppo inesperto per"
  ],
  [
   "raggiungere il tuo obiettivo!"
  ]
 ],
 "s162.sec57.u8": [
  [
   "Umpf..."
  ]
 ],
 "s162.sec57.u9": [
  [
   "Resterò qui a rimetterti in",
   "forma. Diventerai molto, molto",
   "più forte!"
  ]
 ],
 "s162.sec57.u10": "Greymon si è unito alla città!",
 "s162.sec57.u11": [
  [
   "Eheh, ti ho trovato,",
   "{color 6}{player}{color 1}!"
  ]
 ],
 "s162.sec57.u12": [
  [
   "Un attacco a sorpresa?!"
  ]
 ],
 "s162.sec57.u13": [
  [
   "Il mio obiettivo è",
   "sconfiggerti... e per riuscirci",
   "userò ogni mezzo!"
  ]
 ],
 "s162.sec57.u14": [
  [
   "...Quegli occhi! Qualcuno lo",
   "controlla!"
  ]
 ],
 "s162.sec57.u15": [
  [
   "Ngh... così... anche a costo",
   "della vita... sconfiggerli...",
   "questi erano... i miei"
  ],
  [
   "ordini..."
  ]
 ],
 "s162.sec57.u16": [
  [
   "Ma cosa dici? Così morirai",
   "davvero! Hai bisogno di cure,",
   "presto..."
  ]
 ],
 "s162.sec81.u0": "Zzz...",
 "s162.sec81.u1": [
  [
   "Ehi, hai sentito? Nella Giungla",
   "tropicale cresce una strana",
   "pianta."
  ]
 ],
 "s162.sec81.u2": [
  [
   "Ah, giusto. Ho piantato una",
