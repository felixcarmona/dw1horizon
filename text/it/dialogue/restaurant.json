 ],
 "s174.sec81.u1": [
  [
   "Ah ah ah! {color 6}{player}{color 1},",
   "{color 10}{partner}{color 1}, venite a mangiare",
   "i miei piatti! Non pensavo che"
  ],
  [
   "il mio talento nascosto sarebbe",
   "servito. Questo è cibo vero,",
   "mica oggetti! Buon appetito!"
  ]
 ],
 "s174.sec81.u2": [
  [
   "Ehi, {color 6}{player}{color 1},",
   "{color 10}{partner}{color 1}! Ho deciso di fare",
   "il cuoco. Non fatevi ingannare"
  ],
  [
   "dall'aspetto, sono bravissimo.",
   "Le razioni da viaggio stancano,",
   "vero? Ogni tanto sedersi a"
  ],
  [
   "mangiare al ristorante è una",
   "vera gioia!"
  ]
 ],
 "s174.sec81.u3": [
  [
   "Ciaooo! {color 6}{player}{color 1},",
   "{color 10}{partner}{color 1}. Il mio ristorante",
