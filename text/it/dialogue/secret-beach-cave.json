{
 "s136.sec6.u0": [
  [
   "Aspetta!"
  ]
 ],
 "s136.sec6.u1": [
  [
   "Come se avessi intenzione di",
   "aspettarti!"
  ]
 ],
 "s136.sec6.u2": [
  [
   "Guahahah!"
  ]
 ],
 "s136.sec6.u3": [
  [
   "Ehi, mi hai spaventato!"
  ]
 ],
 "s136.sec6.u4": [
  [
   "Ben fatto, Whamon! E' la",
   "nostra occasione!"
  ]
 ],
 "s136.sec6.u5": [
  [
   "Avanti, arrenditi!"
  ]
 ],
 "s136.sec6.u6": [
  [
   "Ngh, nnngh. . ."
  ]
 ],
 "s136.sec6.u7": [
  [
   "Vieni in città e lavora per",
   "rimediare a ciò che hai fatto."
  ]
 ],
 "s136.sec6.u8": [
  [
   "V-va bene... Andrò in città..."
  ]
 ],
 "s136.sec6.u9": [
  [
   "Buahahah, come se ci andassi!",
   "Ciaooo!"
  ]
 ],
 "s136.sec6.u10": [
  [
   "Argh, mi ha ingannato! Grrr."
  ]
 ],
 "s136.sec6.u11": [
  [
   "Pazienza. Almeno abbiamo",
   "recuperato la grotta. Direi che",
   "può bastare."
  ]
 ],
 "s136.sec6.u12": [
  [
   "Ecco. Credo che la grotta sia",
   "al sicuro."
  ]
 ],
 "s136.sec6.u13": [
  [
   "...... Hai davvero un buon",
   "cuore. Quei tipi prima o poi",
   "capiranno i loro errori."
  ]
 ],
 "s136.sec6.u14": [
  [
   "Vorrei che avessi il mio",
   "tesoro. E' in fondo."
  ]
 ],
 "s136.sec6.u15": [
  [
   "Eh? Aspetta, è il tuo tesoro,",
   "no? Non posso accettarlo."
  ]
 ],
 "s136.sec6.u16": [
  [
   "No, non mi serve più. Vedi, ho",
   "deciso di trasferirmi nella tua",
   "città."
  ]
 ],
 "s136.sec6.u17": [
  [
   "Eh? Perché così all'improvviso?",
   "Allora non è servito a niente",
   "recuperare la grotta!"
  ]
 ],
 "s136.sec6.u18": [
  [
   "Mi dispiace se ti dispiace. Ma",
   "voglio ricambiare la tua bontà.",
   "Desidero davvero aiutarvi."
  ]
 ],
 "s136.sec6.u19": [
  [
   "Capisco. Grazie. Anche tu sei",
   "un bravo ragazzo."
  ]
 ],
 "s136.sec6.u20": [
  [
   "Allora andrò direttamente in",
   "città. Vi porterò per un",
   "tratto."
  ]
 ],
 "s136.sec6.u21": "Whamon si è unito alla città!",
 "s136.sec60.u0": [
  [
   "Una voce viene dal fondo...",
   "Quella voce!"
  ]
 ],
 "s136.sec81.m0.o0": "Torna indietro",
 "s136.sec81.m0.o1": "Non tornare",
 "s136.sec81.u0": [
  [
   "Torniamo in città?"
  ]
 ],
 "s137.sec51.u0": [
  [
   "Oh, oh!"
  ]
 ],
