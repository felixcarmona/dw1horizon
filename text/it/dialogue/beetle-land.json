 "s103.sec5.m0.o0": "In palestra, credo",
 "s103.sec5.m0.o1": "Nell'arena, forse",
 "s103.sec5.u0": [
  [
   "Io annoiato di allenarmi qui.",
   "Cosa fare?"
  ]
 ],
 "s103.sec5.u1": [
  [
   "Cosa fare, dici..."
  ]
 ],
 "s103.sec5.u2": "Tu dove allenarti?",
 "s103.sec5.u3": [
  [
   "In una palestra, Credo di si'."
  ]
 ],
 "s103.sec5.u4": [
  [
   "Allenamento noioso. Io volere",
   "diventare forte in vere lotte."
  ]
 ],
 "s103.sec5.u5": [
  [
   "Allenamento noioso. Io volere",
   "diventare forte in vere lotte."
  ]
 ],
 "s103.sec5.u6": [
  [
   "Io andare lì. Io allenarmi."
  ]
 ],
 "s103.sec5.u7": "Kabuterimon si è unito alla città!",
 "s103.sec6.u0": [
  [
   "Ogni anno, giorno con due 2,",
   "torneo di insetti qui.",
   "Vincitore ricevere grande"
  ],
  [
   "premio. Ma solo Digimon insetto",
   "possono entrare."
  ]
 ],
 "s103.sec6.u1": [
  [
   "Kabuterimon, Kuwagamon,",
   "Kunemon e un altro tipo di",
   "insetto. Ma non Numemon. Ogni"
  ],
  [
   "anno, giorno con due 2, torneo",
   "di insetti qui... Mmm? Tu già",
   "vinto torneo."
  ]
 ],
 "s103.sec6.u2": [
  [
   "Kabuterimon, Kuwagamon,",
   "Kunemon e un altro insetto:",
   "HerculesKabuterimon. Hercules"
  ],
  [
   "fortissimo. Vincitore ricevere",
   "oggetto che trasforma in",
   "Hercules. Tu potere"
  ],
  [
   "partecipare tante volte."
  ]
 ],
 "s103.sec7.m0.o0": "Puoi scommetterci!",
 "s103.sec7.m0.o1": "No, grazie",
 "s103.sec7.u0": [
  [
   "Tu forte. Io niente da",
   "insegnarti."
  ]
 ],
 "s103.sec7.u1": [
  [
   "Noi studiare tecniche. Tecniche",
   "forti difficili da imparare. Se",
   "tu capace, forse imparare"
  ],
  [
   "tecnica. Tu volere tecnica",
   "forte?"
  ]
 ],
 "s103.sec7.u2": [
  [
   "Allora noi provare."
  ]
 ],
 "s103.sec7.u3": [
  [
   "Tu non abbastanza Difesa.",
   "Allenarti di più."
  ]
 ],
 "s103.sec7.u4": [
  [
   "Tu non abbastanza Velocità.",
   "Allenarti di più."
  ]
 ],
 "s103.sec7.u5": [
  [
   "Tu non abbastanza HP.",
   "Allenarti di più."
  ]
 ],
 "s103.sec7.u6": "Tu imparato tecnica.",
 "s103.sec7.u7": [
  [
   "Insetto appreso!"
  ]
 ],
