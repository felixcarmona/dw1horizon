   "torneo di insetti. Allora io",
   "dire cosa buona. Conosci «Nido"
  ],
  [
   "di Kunemon»? Nella Foresta",
   "natia. Digimon bambino dormire",
   "lì, svegliarsi Kunemon. A volte"
  ],
  [
   "no. Dipende da fortuna."
  ]
 ],
 "s104.sec6.u1": [
  [
