  ]
 ],
 "s104.sec7.m0.o0": "Riposa un po'",
 "s104.sec7.m0.o1": "Non riposare",
 "s104.sec7.u0": [
  [
   "Noi allenarci tanto, ma riposo",
   "importante. Tu riposare un'ora?"
  ]
 ],
 "s104.sec84.u0": [
  [
   "{color 5}Allenamento: Macchina a",
   "martelli{color 1}"
  ]
 ],
 "s104.sec84.u1": [
  [
   "Incassa i colpi della macchina",
   "a martelli per irrobustirti. La",
   "Difesa aumenta molto."
  ]
 ],
 "s104.sec84.u2": [
  [
   "{color 7}Slot machine{color 1}",
   "Ferma i tre rulli con"
  ],
