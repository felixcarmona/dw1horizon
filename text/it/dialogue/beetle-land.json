 "s104.sec5.m0.o0": "Diventa più forte",
 "s104.sec5.m0.o1": "Conosco un trucco...",
 "s104.sec5.m0.o2": "Tieni duro",
 "s104.sec5.u0": [
  [
   "Io volere battere quei",
   "Kabuterimon. Come vincere?"
  ]
 ],
 "s104.sec5.u1": [
  [
   "Sì, io pensato così. Io",
   "allenarmi."
  ]
 ],
 "s104.sec5.u2": [
  [
   "Cosa? Dimmelo."
  ]
 ],
 "s104.sec5.u3": [
  [
   "Allora vieni in città."
  ]
 ],
 "s104.sec5.u4": [
  [
   "...Tu gentile. Io andare città."
  ]
 ],
 "s104.sec5.u5": "Kuwagamon si è unito alla città!",
 "s104.sec5.u6": [
  [
   "Tu non gentile. Io deluso."
  ]
 ],
 "s104.sec6.u0": [
  [
   "Mmm, tu già partecipato a",
   "torneo di insetti. Allora io",
   "dire cosa buona. Conosci «Nido"
  ],
  [
   "di Kunemon»? Nella Foresta",
   "natia. Digimon bambino dormire",
   "lì, svegliarsi Kunemon. A volte"
  ],
  [
   "no. Dipende da fortuna."
  ]
 ],
 "s104.sec6.u1": [
  [
   "Tu, torneo di insetti... Mmm?",
   "Ora tu non potere entrare.",
   "Allora io dire cosa buona."
  ],
  [
   "Conosci «Nido di Kunemon»?",
   "Nella Foresta natia. Digimon",
   "bambino dormire lì, svegliarsi"
  ],
  [
   "Kunemon. A volte no. Dipende",
   "da fortuna."
  ]
 ],
 "s104.sec6.u2": [
  [
   "Tu entrare nel torneo di",
   "insetti?"
  ]
 ],
 "s104.sec6.u3": [
  [
   "Che cos'è?"
