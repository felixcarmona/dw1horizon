  ]
 ],
 "s168.sec82.u1": [
  [
   "Tornei vinti: {cupswon}",
   "{wins} vittorie,",
   "{losses} sconfitte"
  ]
 ],
 "s168.sec82.u2": [
  [
   "I tornei di grado si tengono",
   "spesso e sono aperti a tutti.",
   "Evita però di iscrivere un"
  ],
  [
   "Digimon di livello molto",
   "superiore a quello del torneo.",
   "Se il tuo Digimon cambia specie"
  ],
  [
   "tra l'iscrizione e il torneo,",
   "l'iscrizione viene annullata."
  ]
 ],
 "s168.sec82.u3": [
  [
   "I tornei speciali hanno",
   "requisiti precisi e si tengono",
   "raramente. Se in città non ci"
  ],
  [
   "sono abbastanza partecipanti",
   "idonei, non si disputano.",
   "Ognuno si tiene solo una o due"
  ],
  [
   "volte all'anno: controlla il",
   "calendario con largo anticipo."
  ]
 ],
