{
 "s022.sec5.u0": [
  [
   "La mia ala..."
  ]
 ],
 "s022.sec5.u1": [
  [
   "Che problema hai?"
  ]
 ],
 "s022.sec5.u2": [
  [
   "Mi sono... ferito a un'ala...",
   "Hai qualcosa per curare una",
   "ferita?"
  ]
 ],
 "s022.sec5.u3": [
  [
   "Sembra grave...! Aspetta.",
   "Vediamo..."
  ]
 ],
 "s022.sec5.u4": [
  [
   "Ah, E' vero. Non ho niente",
   "ora..."
  ]
 ],
 "s022.sec5.u5": [
  [
   "Non va bene. Non con questo."
  ]
 ],
 "s022.sec5.u6": [
  [
   "Fiuu... Va molto meglio.",
   "Grazie."
  ]
 ],
 "s022.sec5.u7": [
  [
   "Puoi volare?"
  ]
 ],
 "s022.sec5.u8": [
  [
   "...Non lontano, credo..."
  ]
 ],
 "s022.sec5.u9": [
  [
   "Capisco... Oh, ho un'idea! In",
   "città c'è una clinica. Fatti",
   "visitare lì. Non è lontano."
  ]
 ],
 "s022.sec5.u10": [
  [
   "Notevole. Avevo sentito",
   "parlare della città, ma non",
   "sapevo che fosse cresciuta"
  ],
  [
   "tanto."
  ]
 ],
 "s022.sec5.u11": [
  [
   "Eheh. Prenditela comoda e",
   "riposati in città."
  ]
 ],
 "s022.sec5.u12": [
  [
   "Mi dispiace per il disturbo...",
   "Ricambierò questa gentilezza,",
   "promesso."
  ]
 ],
 "s022.sec5.u13": "Unimon si è unito alla città!",
 "s022.sec5.u14": [
  [
   "Qualcosa per guarire una",
   "ferita... Ok. Ti prendo una",
   "cosa."
  ]
 ],
 "s022.sec5.u15": [
  [
   "Mi dispiace... Per favore.",
   "Sbrigati..."
  ]
 ],
 "s022.sec51.u0": [
  [
   "Sul terreno ci sono strani",
   "disegni..."
  ]
 ],
 "s022.sec51.u1": [
  [
   "È uno di quei cerchi nel grano?",
   "Non sembra molto vecchio."
  ]
 ],
 "s022.sec51.u2": [
  [
   "Ce ne sono più dell'ultima",
   "volta! Avrà a che fare con",
   "quell'UFO di cui parlano"
  ],
  [
   "tutti...?"
  ]
 ],
 "s022.sec51.u3": [
  [
   "Uau!? Ce ne sono altri!",
   "MOLTI altri! Allora ci siamo..."
  ]
 ],
 "s022.sec51.u4": [
  [
   "?"
  ]
 ],
 "s022.sec51.u5": [
  [
   "Appare l'UFO di Vademon!"
  ]
 ],
 "s022.sec51.u6": [
  [
   "U-un alieno!?"
  ]
 ],
 "s022.sec51.u7": [
  [
   "........."
  ]
 ],
 "s022.sec51.u8": [
  [
   "Sei... un Digimon...?"
  ]
 ],
 "s022.sec51.u9": [
  [
   "........."
  ]
 ],
 "s022.sec51.u10": [
  [
   "Ehm..."
  ]
 ],
 "s022.sec51.u11": [
  [
   "........."
  ]
 ],
 "s022.sec51.u12": [
  [
   "Vademon alza una pistola!"
  ]
 ],
 "s022.sec51.u13": [
  [
   "Oh no, aspetta! Non siamo tuoi",
   "nemici!"
  ]
 ],
 "s022.sec51.u14": [
  [
   "Vademon abbassa la pistola."
  ]
 ],
 "s022.sec51.u15": [
  [
   "Ha capito? Bene..."
  ]
 ],
 "s022.sec51.u16": [
  [
   "{color 6}{player}{color 1} ha fatto di tutto",
   "per convincerlo!!"
  ]
 ],
 "s022.sec51.u17": [
  [
   "........."
  ]
 ],
 "s022.sec51.u18": [
  [
   "Non funziona...?"
  ]
 ],
 "s022.sec51.u19": [
  [
   "Va beeene."
  ]
 ],
 "s022.sec51.u20": "Vademon si è unito alla città!",
 "s022.sec51.u21": [
  [
   "M-ma... quel tipo... SA",
   "parlare!!"
  ]
 ],
