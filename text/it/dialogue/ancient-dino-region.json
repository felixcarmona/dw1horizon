 "s076.sec9.u0": [
  [
   "Bzzzzzzzz!"
  ]
 ],
 "s076.sec51.u0": [
  [
   "Chi diavolo sei?! Nessuno",
   "rovina questo posto finché ci",
   "sono io di guardia!"
  ]
 ],
 "s076.sec51.u1": [
  [
   "No, stiamo viaggiando per",
   "salvare l'isola..."
  ]
 ],
 "s076.sec51.u2": [
  [
   "Pensi che mi beva una bugia",
   "così stupida? Prendi questo!"
  ]
 ],
 "s076.sec51.u3": [
  [
   "E-ehi, aspetta..."
  ]
 ],
 "s076.sec51.u4": [
  [
   "Aspetta... dici la verità?"
  ]
 ],
 "s076.sec51.u5": [
  [
   "E' quello che ti stavo dicendo!"
  ]
 ],
 "s076.sec51.u6": [
  [
   "Eh, scusa. Qui non arrivano",
   "quasi mai degli estranei. Era",
   "il mio primo incarico da tanto"
  ],
  [
   "tempo, mi sono lasciato",
   "prendere."
  ]
 ],
 "s076.sec51.u7": [
  [
   "Lavoro?"
  ]
 ],
 "s076.sec51.u8": [
  [
   "Sì. Sorveglio questo posto,",
   "l'Antica regione Dino, la terra",
   "più remota dell'isola!"
  ]
 ],
 "s076.sec51.u9": [
  [
   "Ah... Allora ci fai fare un",
   "giro?"
  ]
 ],
 "s076.sec51.u10": [
  [
   "L'Antica regione Dino è divisa",
   "in due grandi parti. La prima è",
   "l'Antica zona glaciale, dove"
  ],
  [
   "viviamo noi Digimon dinosauro.",
   "È un posto speciale dove il",
   "tempo scorre più lentamente."
  ]
 ],
 "s076.sec51.u11": [
  [
   "Il tempo va più lento. . . ? E'",
   "strano."
  ]
 ],
 "s076.sec51.u12": [
  [
   "L'altra è l'Antica zona veloce,",
   "una zona pericolosa oltre",
   "quella glaciale. Perché è"
  ],
  [
   "pericolosa? Il tempo scorre a",
   "una velocità pazzesca. Così il",
   "terreno è consumato, con ossa"
  ],
  [
   "e fossili ovunque."
  ]
 ],
 "s076.sec51.u13": [
  [
   "Giusto, perché lì è passato più",
   "tempo che altrove."
  ]
 ],
 "s076.sec51.u14": [
  [
   "Esatto. Se non vuoi morire,",
   "stanne alla larga. ...Comunque",
   "non ti lascerei passare, sono"
  ],
  [
   "qui a bloccare la strada."
  ]
 ],
 "s076.sec51.u15": [
  [
   "Ma hai appena perso contro di",
   "noi."
  ]
 ],
 "s076.sec51.u16": [
  [
   "Argh... È stato un caso! Di",
   "solito non va così!"
  ]
 ],
 "s076.sec51.u17": [
  [
   "Se lo dici tu..."
  ]
 ],
 "s076.sec51.u18": [
  [
   "Ehm... B-bene, meglio tornare",
   "al mio posto! Per il resto",
   "chiedi ai Digimon di qui. Ciao!"
  ]
 ]
