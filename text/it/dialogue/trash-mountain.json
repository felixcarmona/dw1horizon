  ]
 ],
 "s158.sec6.u0": [
  [
   "Biepiié!"
  ]
 ],
 "s158.sec7.u0": [
  [
   "Baupi, Bosupi!"
  ]
 ],
 "s158.sec8.u0": [
  [
   "Bopiiiié!"
  ]
 ],
 "s158.sec9.u0": [
  [
   "È davvero tutto ciò che hai?"
  ]
 ],
 "s158.sec10.u0": [
  [
   "Vai a lavarti la faccia e",
   "riprova!"
  ]
 ],
 "s159.sec6.m0.o0": "Scambia",
 "s159.sec6.m0.o1": "Non scambiare",
 "s159.sec6.u0": [
  [
   "Mmm, colleziono carte Digimon.",
   "Vorrei una carta KingSukamon.",
   "Me ne scambi una con una carta"
  ],
  [
   "Etemon?"
  ]
 ],
 "s159.sec6.u1": [
  [
   "Mi dispiace, Non ne ho."
  ]
 ],
 "s159.sec6.u2": [
  [
   "Uff, che puzza... È una",
   "discarica? Quindi ci sono anche",
   "nel mondo dei Digimon."
  ]
 ],
 "s159.sec6.u3": [
  [
   "Mmm? Oh, benvenuti. I nuovi",
   "amici sono sempre benvenuti,",
   "sì!"
  ]
 ],
 "s159.sec6.u4": [
  [
   "È un villaggio della tribù",
   "Sukamon?"
  ]
 ],
 "s159.sec6.u5": [
  [
   "Esatto. Questo è il paradiso",
   "dei Sukamon, il Regno della",
   "Polvere. Qui vive anche Sua"
  ],
  [
   "Maestà KingSukamon."
  ]
 ],
 "s159.sec6.u6": [
  [
   "KingSukamon..."
  ]
 ],
 "s159.sec6.u7": [
  [
   "Sua Maestà è incredibile. Se",
   "gli disobbedisci, ti trasforma",
   "in un'altra specie!"
  ]
 ],
 "s159.sec6.u8": [
  [
   "Cosa?! Smetteresti di essere",
   "un Sukamon? Quindi... può farti",
   "tornare com'eri?!"
  ]
 ],
 "s159.sec6.u9": [
  [
   ". . mmm, è una storia",
   "spaventosa. Orribile."
  ]
 ],
 "s159.sec6.u10": [
  [
   "Buono a sapersi!"
  ]
 ],
 "s159.sec6.u11": [
  [
   "Eh, un Sukamon?!"
  ]
 ],
 "s159.sec6.u12": [
  [
   "Mmm? Sai chi sono?"
  ]
 ],
 "s159.sec6.u13": [
  [
   "B-be', più o meno. Mmm,",
   "dobbiamo portare anche Sukamon",
   "in città...?"
  ]
 ],
 "s159.sec6.u14": [
  [
   "Mmm? Una vista rara, sì!"
  ]
 ],
 "s159.sec6.u15": [
  [
   "Bleah, la cacca si muove e",
   "parla!"
  ]
 ],
 "s159.sec6.u16": [
  [
   "Mmm? Dici a me? Sono Sukamon,",
   "un Digimon mutante."
  ]
 ],
 "s159.sec6.u17": [
  [
   "Quindi non sei cacca?"
  ]
 ],
 "s159.sec6.u18": [
  [
   "In un certo senso, è vero.",
   "Siamo fatti di scarti di dati",
   "digitali."
  ]
 ],
 "s159.sec6.u19": [
  [
   "Mmm... Dovremmo invitare anche",
   "lui in città? Be', non è bello",
   "discriminare."
  ]
 ],
 "s159.sec6.u20": [
  [
   "Avete intenzione di vivere qui?"
  ]
 ],
 "s159.sec6.u21": [
  [
   "Eh? Non mi è neanche passato",
   "per la testa."
  ]
 ],
 "s159.sec6.u22": [
  [
   "Mmm, questo paradiso è solo",
   "per la tribù Sukamon. Mi",
   "dispiace, le altre specie non"
  ],
  [
   "possono vivere qui, sì."
  ]
 ],
 "s159.sec6.u23": [
  [
   "Quindi non potete vivere",
   "altrove?"
  ]
 ],
 "s159.sec6.u24": [
  [
   "Naturalmente!"
  ]
 ],
 "s159.sec6.u25": [
  [
   "Ah, sì, lo immaginavo... Uff."
  ]
 ],
 "s159.sec6.u26": [
  [
   "Mmm? Non potete vivere qui, ma",
   "potete dare un'occhiata, ospiti",
   "d'onore, sì."
  ]
 ],
 "s159.sec6.u27": [
  [
   "Ah, questo... Si'. Stiamo solo",
   "cercando."
  ]
 ],
 "s159.sec6.u28": [
  [
   "Ah, non fate arrabbiare Sua",
   "Maestà. Se la sua magia vi",
   "trasforma in qualcosa di"
  ],
  [
   "misero, non incolpatemi, sì!"
  ]
 ],
 "s159.sec6.u29": [
  [
   "Ehi, ehi, hai troppe carte",
   "Etemon! Meglio di no."
  ]
 ],
 "s159.sec6.u30": [
  [
   "Oh, Grazie!"
  ]
 ],
 "s159.sec7.u0": [
  [
   "Mmm, sentite. Venite da quella",
   "città, vero? Tra noi, mi",
   "incuriosisce un po'. Un giorno"
  ],
  [
   "passerò a trovarvi."
  ]
 ],
 "s159.sec7.u1": [
  [
   "Mmm, sentite. Conoscete il",
   "talento speciale dei Sukamon?",
   "Assorbiamo nel nostro corpo la"
  ],
  [
   "cacca ai bordi della strada e",
   "la trasformiamo in energia!"
  ]
 ],
 "s159.sec8.u0": [
  [
   "Mmm? Questo è il Regno della",
   "Polvere. Per voi è solo un",
   "mucchio di rifiuti, scommetto."
  ],
  [
   "Ma potrebbero esserci cose",
   "utili. Ora che ci penso, laggiù",
   "ho visto una specie di lungo"
  ],
  [
   "bastone, sì."
  ]
 ],
 "s159.sec51.u0": [
  [
   "Ehi, una {color 6}Canna vecchia{color 1}!"
  ]
 ],
 "s159.sec81.m0.o0": "Vogliamo vivere qui",
 "s159.sec81.m0.o1": "Rimettilo com'era!",
 "s159.sec81.u0": [
  [
   "Umpf! Ancora voi! Sparite dalla",
   "mia vista!"
  ]
 ],
 "s159.sec81.u1": [
  [
   "Ehm..."
  ]
 ],
 "s159.sec81.u2": [
  [
   "Bah, quanto insistete! Ecco!",
   "Contenti?"
  ]
 ],
 "s159.sec81.u3": [
  [
   "Umpf! Ancora voi! Sparite dalla",
   "mia vista!"
  ]
 ],
 "s159.sec81.u4": [
  [
   "Mmm! Benvenuto, fratello",
   "Sukamon. Se desideri vivere",
   "qui, ti concedo il permesso."
  ]
 ],
 "s159.sec81.u5": [
  [
   "Mmm! Molto bene, molto bene.",
   "Mmm? Tu no, creatura",
   "analogica."
  ]
 ],
 "s159.sec81.u6": [
  [
   "Dobbiamo stare insieme!"
  ]
 ],
 "s159.sec81.u7": [
  [
   "Umpf, allora andatevene",
   "insieme!"
  ]
 ],
 "s159.sec81.u8": [
  [
   "Cosa? Cosa stai dicendo?"
  ]
 ],
 "s159.sec81.u9": [
  [
   "Prima non era un Sukamon.",
   "Sire, fallo tornare com'era!"
  ]
 ],
 "s159.sec81.u10": [
  [
   "Ma non è meraviglioso? È",
   "potuto diventare un Sukamon."
  ]
 ],
 "s159.sec81.u11": [
  [
   "No, al momento è un problema.",
   "Ti prego!"
  ]
 ],
 "s159.sec81.u12": [
  [
   "Se credete che si diventi",
   "Sukamon senza sforzo, vi",
   "sbagliate di grosso! Solo chi"
  ],
  [
   "si impegna può diventare",
   "Sukamon!"
  ]
 ],
 "s159.sec81.u13": [
  [
   "È proprio diventato Sukamon",
   "senza sforzo. È questo il",
   "problema..."
  ]
 ],
 "s159.sec81.u14": [
  [
   "Umpf, siete senza speranza!",
   "Basta! Questo è ciò che fa per",
   "voi!"
  ]
 ],
 "s159.sec81.u15": [
  [
   "Wow, grazie, Sire!"
  ]
 ],
 "s159.sec81.u16": [
  [
   "Ora sparite dalla mia vista!"
  ]
 ],
 "s159.sec81.u17": [
  [
   "Umpf, cosa volete da me?"
  ]
 ],
 "s159.sec81.u18": [
  [
   "Ehm..."
  ]
 ],
 "s159.sec81.u19": [
  [
   "Umpf, non ascolto richieste.",
   "Sono il re dei Sukamon, e solo",
   "dei Sukamon!"
  ]
 ],
 "s159.sec81.u20": [
  [
   "Quindi non posso invitarlo in",
   "città..."
  ]
 ],
