{
 "s025.sec5.u0": [
  [
   "Dai, mettici forza!"
  ]
 ],
 "s025.sec5.u1": [
  [
   "Non sei di qui!"
  ]
 ],
 "s025.sec51.u0": [
  [
   "Hai svuotato la terra."
  ]
 ],
 "s025.sec52.u0": [
  [
   "Ops, devo restituire la cassa",
   "per la terra a Drimogemon!"
  ]
 ],
 "s032.sec52.u0": [
  [
   "Ehi, ci siamo quasi!"
  ]
 ],
 "s032.sec52.u1": [
  [
   "Ehi, eccoti! Il tunnel è",
   "finalmente aperto!"
  ]
 ],
 "s032.sec52.u2": [
  [
   "Non dovremo più attraversare",
   "la montagna. Grazie."
  ]
 ],
 "s032.sec52.u3": [
  [
   "No, sono io a doverti",
   "ringraziare. Non potevo fare",
   "nulla contro quella grossa"
  ],
  [
   "roccia."
  ]
 ],
 "s032.sec52.u4": [
  [
   "Però... adesso cosa farò?"
  ]
 ],
 "s032.sec52.u5": [
  [
   "Allora vieni in città. Sono",
   "sicuro che troverai qualcosa da",
   "fare lì!"
  ]
 ],
 "s032.sec52.u6": [
  [
   "Oh, ho ancora tanta voglia di",
   "fare. Accetto la tua offerta!"
  ]
 ],
 "s032.sec52.u7": [
  [
   "Ci siamo quasi, aspetta ancora",
   "un po'!"
  ]
 ],
 "s032.sec52.u8": "Drimogemon si è unito alla città!"
}
