{
 "s031.sec51.u0": [
  [
   "!"
  ]
 ],
 "s031.sec51.u1": [
  [
   "Quando ha iniziato a cambiare",
   "quest'isola...? Ogni giorno le",
   "specie si allontanano..."
  ],
  [
   "perdono i ricordi e diventano",
   "selvagge... Persino io potrei",
   "non restare lucido ancora a"
  ],
  [
   "lungo... Così non può",
   "continuare! Devono capire cosa",
   "non va nell'isola! Anche a"
  ],
  [
   "costo di usare un po' di",
   "forza..."
  ]
 ],
 "s031.sec51.u2": [
  [
   "Fermo! Vuoi distruggere",
   "l'isola?!"
  ]
 ],
 "s031.sec51.u3": [
  [
   "Chi sei!? Non ti intromettere!",
   "È l'unica via rimasta!"
  ]
 ],
 "s031.sec51.u4": [
  [
   "Ah... ah... Sciocco... Mi stai",
   "dicendo che esiste un'altra",
   "via?"
  ]
 ],
 "s031.sec51.u5": [
  [
   "A che serve, se l'isola viene",
   "distrutta?! Ascoltami un",
   "attimo."
  ]
 ],
 "s031.sec51.u6": [
  [
   "Che cosa hai detto. . . ?"
  ]
 ],
 "s031.sec51.u7": [
  [
   "Stiamo costruendo una città",
   "per l'isola, radunando Digimon",
   "da ogni parte. Dicono che, se i"
  ],
  [
   "Digimon restano uniti, possiamo",
   "fare qualcosa per la crisi",
   "dell'isola."
  ]
 ],
 "s031.sec51.u8": [
  [
   "Mh... Credo che l'idea sia",
   "giusta. Ma radunare i Digimon",
   "di tutta l'isola..."
  ]
 ],
 "s031.sec51.u9": [
  [
   "E' quello che stiamo facendo",
   "adesso. Non è impossibile!"
  ]
 ],
 "s031.sec51.u10": [
  [
   "Che storia... Un progetto così",
   "grandioso... Come potrei",
   "crederci... Eppure il mio cuore"
  ],
  [
   "vacilla... Voi potreste...",
   "riuscirci davvero..."
  ]
 ],
 "s031.sec51.u11": [
  [
   "Se credi in noi, Vieni in",
   "città."
  ]
 ],
 "s031.sec51.u12": [
  [
   "..Bene. Vado in citta'.",
   "Dev'essere il mio nuovo",
   "percorso!"
  ]
 ],
 "s031.sec51.u13": "Meramon si è unito alla città!",
 "s031.sec51.u14": [
  [
   "E' strano... Ho sempre sentito",
   "che saresti tornato qui...",
   "Voglio una risposta!"
  ]
 ],
 "s031.sec51.u15": [
  [
   "Allora... Ho perso,",
   "Dopotutto..."
  ]
 ],
 "s031.sec51.u16": [
  [
   "C'e' qualcosa che voglio che",
   "ascolti."
  ]
 ],
 "s033.sec5.u0": [
  [
   "Dici che fa ancora caldo? Sì,",
   "un Digimon che non sopporta il",
   "calore potrebbe ammalarsi."
  ]
 ],
 "s033.sec6.u0": [
  [
   "La lava si è tutta",
   "solidificata! Hmpf!"
  ]
 ],
 "s119.sec5.u0": [
  [
   "Hey! Che succede?"
  ]
 ],
 "s121.sec5.m0.o0": "Consegnalo",
 "s121.sec5.m0.o1": "Tienilo",
 "s121.sec5.u0": [
  [
   "Ciao, ciao. Conosci le carte",
   "Digimon? Colleziono carte di",
   "Meramon. Portamene una e la"
  ],
  [
   "compro per 1500 Bit!"
  ]
 ],
 "s121.sec5.u1": [
  [
   "Uau, che bello. Grazie!"
  ]
 ]
}
