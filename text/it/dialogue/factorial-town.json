 ],
 "s151.sec5.u24": [
  [
   "Ancora un po'... Rimuoverò il",
   "blocco all'ingresso principale",
   "della città. Torna più tardi."
  ]
 ],
 "s151.sec5.u25": [
  [
   "Grazie. Torno allora."
  ]
 ],
 "s151.sec5.u26": [
  [
   "Hai riparato i dati?"
  ]
 ],
 "s151.sec5.u27": [
  [
