 ],
 "s151.sec5.u0": [
  [
   "Qui è tutto normale. Impegnati",
   "al massimo."
  ]
 ],
 "s151.sec5.u1": [
  [
   "Devo aiutare anch'io. Quando",
   "avrò tempo, farò la spola tra",
   "qui e la città."
  ]
 ],
 "s151.sec5.u2": "Andromon si è unito alla città!",
 "s151.sec5.u3": [
  [
   "La riparazione dei dati è",
   "completa. Leggiamoli ora."
  ]
 ],
 "s151.sec5.u4": [
  [
   "Avanti."
  ]
 ],
 "s151.sec5.u5": [
  [
   "100 anni fa: umani analogici",
   "appaiono sull'isola dei",
   "Digimon. Si scontrano"
  ],
  [
   "ferocemente con i Digimon",
   "nativi. Dopo 10 anni di lotte,",
   "gli umani sono sconfitti e"
  ],
  [
   "scompaiono senza lasciare",
   "traccia. Nei 10 anni seguenti,",
   "l'isola quasi raddoppia di"
  ],
  [
   "dimensioni. Causa sconosciuta."
  ]
 ],
 "s151.sec5.u6": [
  [
   "Gli umani... hanno combattuto",
   "contro i Digimon..."
  ]
 ],
 "s151.sec5.u7": [
  [
   "E' tutto quello che ho potuto",
   "sistemare. Mi dispiace."
  ]
 ],
 "s151.sec5.u8": [
  [
   "No, è un'informazione preziosa.",
   "Spiega molte cose."
  ]
 ],
 "s151.sec5.u9": [
  [
   "Ah, Si'?"
  ]
 ],
 "s151.sec5.u10": [
  [
   "Chi ha gettato l'isola nel caos",
   "è probabilmente quell'umano",
   "scomparso."
  ]
 ],
 "s151.sec5.u11": [
  [
   "Gli umani possono vivere 100",
   "anni?"
  ]
 ],
 "s151.sec5.u12": [
  [
   "In questo mondo il tempo",
   "sembra scorrere molto",
   "lentamente solo per gli umani."
  ],
  [
   "Per questo sto bene senza",
   "mangiare o dormire. Però 100",
   "anni sono tanti. Dev'essere un"
  ],
  [
   "tipo davvero tosto."
  ]
 ],
 "s151.sec5.u13": [
  [
   "Forse si nasconde da qualche",
   "parte?"
  ]
 ],
 "s151.sec5.u14": [
  [
   "Lo troverò... e farò qualcosa",
   "per fermarlo. Ora capisco. Sono",
   "stato chiamato qui per"
  ],
  [
   "sconfiggerlo, perché sono umano",
   "anch'io."
  ]
 ],
 "s151.sec5.u15": [
  [
   "...Ti porgiamo le nostre",
   "sincere scuse per quanto è",
   "accaduto. La fabbrica resterà"
  ],
  [
   "chiusa per un po'."
  ]
 ],
 "s151.sec5.u16": [
  [
   "L'isola è diventata così strana",
   "che nessuno sa cosa succederà.",
   "Non è colpa tua."
  ]
 ],
 "s151.sec5.u17": [
  [
   "Credo che qualcuno, da qualche",
   "parte, controllasse Giromon. Il",
   "computer viene distrutto... ed"
  ],
  [
   "escono rifiuti che fanno",
   "impazzire i Digimon. Non credo",
   "sia una coincidenza."
  ]
 ],
 "s151.sec5.u18": [
  [
   "Questo computer è molto",
   "importante. Possiamo supporre",
   "che qualcuno lo abbia preso di"
  ],
  [
   "mira. Anche se ormai è tardi",
   "per dirlo..."
  ]
 ],
 "s151.sec5.u19": [
  [
   "Che cosa hai detto?"
  ]
 ],
 "s151.sec5.u20": [
  [
   "Qui erano conservati dati sul",
   "passato dell'isola. Ma la furia",
   "di Giromon li ha danneggiati."
  ]
 ],
 "s151.sec5.u21": [
  [
   "Non hai visto i dati?"
