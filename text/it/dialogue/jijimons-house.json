{
 "s165.sec5.u0": [
  [
   "Ah, arrivi al momento giusto!",
   "Ho un favore importante da",
   "chiederti, una cosa che solo tu"
  ],
  [
   "puoi fare."
  ]
 ],
 "s165.sec5.u1": [
  [
   "Di cosa si tratta?"
  ]
 ],
 "s165.sec5.u2": [
  [
   "L'ho appena avvertita di nuovo:",
   "la stessa presenza maligna di",
   "Analogman e Machinedramon. Ma"
  ],
  [
   "non capisco ancora da dove",
   "provenga..."
  ]
 ],
 "s165.sec5.u3": [
  [
   "Di nuovo?! Va bene, ci penso",
   "io!"
  ]
 ],
 "s165.sec5.u4": [
  [
   "Oh, grazie. A proposito..."
  ]
 ],
 "s165.sec5.u5": [
  [
   "Ho sentito che hai sconfitto",
   "Machinedramon!"
  ]
 ],
 "s165.sec5.u6": [
  [
   "Sì. Ma non ci capisco molto.",
   "Sembrava una specie di",
   "maledizione di Analogman."
  ]
 ],
 "s165.sec5.u7": [
  [
   "Il suo rancore deve persistere",
   "ancora, fortissimo... Beh,",
   "forse adesso ritroveremo la"
  ],
  [
   "pace."
  ]
 ],
 "s165.sec5.u8": [
  [
   "Se Machinedramon torna, lo",
   "batteremo di nuovo. Sarà come",
   "una festa annuale. Divertente,"
  ],
  [
   "no?"
  ]
 ],
 "s165.sec5.u9": [
  [
   "Ah ah, mi rassicuri. Ah,",
   "giusto, prendi questo come",
   "ringraziamento. È cresciuto per"
  ],
  [
   "caso alla fattoria della carne."
  ]
 ],
 "s165.sec5.u10": [
  [
   "Uau, un {color 6}Melone stramaturo{color 1}?"
  ]
 ],
 "s165.sec5.u11": [
  [
   "Ops, ho la borsa piena."
  ]
 ],
 "s165.sec5.u12": [
  [
   "Lo prendo, grazie!"
  ]
 ],
 "s165.sec5.u13": [
  [
   "Ah, sei arrivato! È una",
   "questione importante, una cosa",
   "che posso chiedere solo a te."
  ]
 ],
 "s165.sec5.u14": [
  [
   "Eheh, figurati. Allora, cos'è",
   "questa storia del ritorno di",
   "Analogman?"
  ]
 ],
 "s165.sec5.u15": [
  [
   "Mh, lo sento. Qualcosa con la",
   "sua stessa presenza maligna.",
   "Ma non riesco a capire da dove"
  ],
  [
   "provenga..."
  ]
 ],
 "s165.sec5.u16": [
  [
   "Va bene, ci penso io! Lo",
   "troverò e lo sconfiggerò."
  ]
 ],
 "s165.sec5.u17": [
  [
   "Oh, grazie. A proposito..."
  ]
 ],
 "s165.sec7.u0": [
  [
   "Sembra che Yuramon abbia",
   "sentito nuove voci."
  ]
 ],
 "s165.sec7.u1": [
  [
   "Ah sì, Yuramon dice di",
   "conoscere nuove voci."
  ]
 ],
 "s165.sec7.u2": [
  [
   "La città è sempre più vivace, e",
   "anche i discorsi in giro stanno",
   "un po' cambiando."
  ]
 ],
 "s165.sec7.u3": [
  [
   "{color 6}{player}{color 1}, il tuo modo di",
   "affrontare le avventure è",
   "piuttosto insolito, sai."
  ]
 ],
 "s165.sec20.u0": [
  [
   "Dunque hai ripreso",
   "conoscenza... Mi dispiace",
   "tanto, ragazzo mio."
  ]
 ],
 "s165.sec85.m0.o0": "Usalo",
 "s165.sec85.m0.o1": "Non usarlo",
 "s165.sec85.u0": [
  [
   "Oh? Cos'è questa macchina?"
  ]
 ],
 "s165.sec85.u1": [
  [
   "Mh, quella? È la {color 4}macchina di",
   "salvataggio dei dati di",
   "battaglia su Memory Card{color 1}."
  ],
  [
   "Registra i dati del tuo attuale",
   "compagno per le battaglie.",
   "Premi {color 6}×{color 1} lì davanti e segui le"
  ],
  [
   "istruzioni."
  ]
 ],
 "s165.sec85.u2": [
  [
   "Usare la {color 4}macchina di",
   "salvataggio dei dati di",
   "battaglia{color 1}?"
  ]
 ],
 "s166.sec5.u0": [
  [
   "Stanno lavorando tutti così",
   "duramente!"
  ]
 ],
 "s166.sec6.u0": [
  [
   "Sembra che non ci sia niente."
  ]
 ],
 "s166.sec7.u0": [
  [
   "Airdramon è addormentato. . ."
  ]
 ],
 "s166.sec60.u0": [
  [
   "Mh, sembra che per ora stia",
   "bene."
  ]
 ],
 "s166.sec60.u1": [
  [
   "Fiuu, meno male..."
  ]
 ],
 "s166.sec60.u2": [
  [
   "Anche per il suo bene, dobbiamo",
   "sconfiggere il loro capo al più",
   "presto."
  ]
 ],
 "s166.sec60.u3": [
  [
   "...Lo so, lo so."
  ]
 ],
