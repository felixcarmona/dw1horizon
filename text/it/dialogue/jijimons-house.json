 "s178.sec5.u18": [
  [
   "Ah, ehm. Insieme ai Digimon che",
   "torneranno, ricostruirò File",
   "City."
  ]
 ],
 "s178.sec5.u19": [
  [
   "Voglio costruire negozi utili a",
   "te e a {color 10}{partner}{color 1}."
  ]
 ],
 "s178.sec5.u20": [
  [
   "Per cominciare... Vediamo.",
   "Perché non esplori la Foresta",
   "natia, appena fuori città?"
  ]
 ],
 "s178.sec6.u0": [
  [
   "E' per te. Buona fortuna."
  ]
 ],
 "s178.sec6.u1": [
  [
   "Hai ricevuto oggetti di ogni",
   "tipo!"
  ]
 ],
 "s178.sec6.u2": [
  [
   "Per vedere gli oggetti, premi",
   "{color 5}△{color 1}, scegli Oggetti, poi",
   "esaminali con {color 6}×{color 1}."
  ]
 ],
 "s178.sec6.u3": [
  [
   "Sembra che Yuramon abbia",
   "sentito nuove voci."
  ]
 ],
 "s178.sec6.u4": [
  [
   "Ah sì, Yuramon dice di",
   "conoscere nuove voci."
  ]
 ],
 "s178.sec6.u5": [
  [
   "La città è sempre più vivace, e",
   "anche i discorsi in giro stanno",
   "un po' cambiando."
  ]
 ],
 "s178.sec6.u6": [
  [
   "Ti spiego le basi del nostro",
   "mondo! Un giorno ha 24 ore:",
   "mattina, giorno e notte. Forse"
  ],
  [
   "ti sembrerà un po' veloce. Un",
   "anno dura 30 giorni. I mesi?",
   "Cosa sono? Le stagioni...? Si"
  ],
  [
   "mangiano? Certo che abbiamo dei",
   "soldi. Si chiamano Bit. Non",
   "sono mai abbastanza! Su"
  ],
  [
   "quest'isola, \"la città\" è",
   "questa qui, anche se ci sono",
   "alcuni piccoli centri e"
  ],
  [
   "villaggi. Ah, l'orologio: il",
   "punto giallo indica l'ora e la",
   "lancetta i minuti. Mezzanotte è"
  ],
  [
   "in alto, mezzogiorno in basso.",
   "Il rosso a sinistra è la sera:",
   "dalle 16 alle 20. Il viola a"
  ],
  [
   "destra è il mattino: dalle 4",
   "alle 8. I Digimon hanno i loro",
   "orari. Quasi tutti si alzano al"
  ],
  [
   "mattino e dormono di notte, ma",
   "non tutti. Se non trovi un",
   "Digimon che vuoi incontrare,"
  ],
  [
   "prova a tornare a un'altra ora."
  ]
 ],
 "s178.sec7.u0": [
  [
   "Vai spesso a parlare con",
   "Tsunomon e Yuramon, va bene?"
  ]
 ],
 "s178.sec7.u1": [
  [
   "Ti spiego il livello del",
   "Domatore! Più è alto, più",
   "statistiche un Digimon"
  ],
  [
   "trasmette quando muore di",
   "vecchiaia. All'inizio sale",
   "poco, ma continua ad allevare"
  ],
  [
   "Digimon e aumenterà un po' alla",
   "volta, va bene?"
  ]
 ],
 "s178.sec7.u2": [
  [
   "Quando usi una tecnica finale,",
   "premi ripetutamente L1 e R1",
   "come si deve? Con la barra"
  ],
  [
   "piena infliggi il doppio dei",
   "danni rispetto a una barra",
   "vuota. Il doppio!"
  ]
 ],
 "s178.sec7.u3": [
  [
   "Ti spiego come vivono i",
   "Digimon! Prima di tutto,",
   "ovviamente, mangiano. Quando"
  ],
  [
   "hanno fame, te lo fanno sapere.",
   "Poi fanno i bisogni: meglio",
   "portarli in bagno appena"
  ],
  [
   "possibile. Quando hanno sonno,",
   "dormono. Aspettano che sia tu,",
   "{color 6}{player}{color 1}, a dirglielo, ma"
  ],
  [
   "prima lo fai, meglio è. Si",
   "stancano, si ammalano e",
   "diventano scontrosi. Sono"
  ],
  [
   "piuttosto delicati, sai? I",
   "Digimon hanno un cuore",
   "selvaggio: a volte vanno lodati"
  ],
  [
   "e a volte sgridati. Qualunque",
   "cosa tu faccia, osserva bene il",
   "tuo Digimon e prenditene cura."
  ]
 ],
 "s178.sec20.u0": [
  [
   "Dunque hai ripreso",
   "conoscenza... Mi dispiace",
   "tanto, ragazzo mio."
  ]
 ],
 "s178.sec82.m0.o0": "Riposa un po'",
 "s178.sec82.m0.o1": "Non riposare",
 "s178.sec82.u0": [
  [
   "Punimon non c'è, ma posso",
   "riposare lo stesso."
  ]
 ],
 "s178.sec82.u1": [
  [
   "{color 7}Punimon {color 1}",
   "Sono Punimon! Perché non ti",
   "riposi un po' qui?"
  ],
  [
   "{color 7}Punimon {color 1}",
   "Un'ora di riposo recupera un",
   "po' di HP e MP e riduce un",
   "po' la stanchezza."
  ]
 ],
