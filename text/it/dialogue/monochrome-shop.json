{
 "s049.sec81.m0.o0": "Ci provero'.",
 "s049.sec81.m0.o1": "Ora ho da fare",
 "s049.sec81.u0": [
  [
   "Benvenuto... Oh? Non ti ho mai",
   "visto qui. Vieni da lontano?"
  ]
 ],
 "s049.sec81.u1": [
  [
   "Vengo dalla citta'. Beh, In",
   "realta', da un altro mondo."
  ]
 ],
 "s049.sec81.u2": [
  [
   "Quindi capisci quello che sto",
   "dicendo."
  ]
 ],
 "s049.sec81.u3": [
  [
   "Certo... Oh, aspetta, non è",
   "normale, vero... Come gestisci",
   "un negozio se nessuno ti"
  ],
  [
   "capisce?"
  ]
 ],
 "s049.sec81.u4": [
  [
   "Con l'esperienza e i gesti. Ma",
   "a volte è dura. Le vendite non",
   "decollano..."
  ]
 ],
 "s049.sec81.u5": [
  [
   "Ah, capisco."
  ]
 ],
 "s049.sec81.u6": [
  [
   "Gli affari vanno a rilento",
   "ultimamente. I vecchi clienti",
   "non vengono più..."
  ]
 ],
 "s049.sec81.u7": [
  [
   "Dev'essere per via dei",
   "disordini sull'isola..."
  ]
 ],
 "s049.sec81.u8": [
  [
   "Quindi vorrei chiederti aiuto",
   "per una cosa."
  ]
 ],
 "s049.sec81.u9": [
  [
   "Di cosa si tratta?"
  ]
 ],
 "s049.sec81.u10": [
  [
   "Ti andrebbe di lavorare nel mio",
   "negozio?"
  ]
 ],
 "s049.sec81.u11": [
  [
   "Eh? Nel negozio?"
  ]
 ],
 "s049.sec81.u12": [
  [
   "Solo mezza giornata. La paga",
   "aumenta con le vendite. Capisci",
   "la lingua e sento che hai un"
  ],
  [
   "certo talento."
  ]
 ],
 "s049.sec81.u13": [
  [
   "Mmm. Se perdi soldi, Non",
   "incolparmi..."
  ]
 ],
 "s049.sec81.u14": [
  [
   "Non preoccuparti. Comunque",
   "vada, imparerò qualcosa. Dura",
   "circa otto ore. Ci stai?"
  ]
 ],
 "s049.sec81.u15": [
  [
   "Capisco... Pazienza. Torna",
   "quando avrai tempo."
  ]
 ],
 "s049.sec81.u16": [
  [
   "Oh! Sei pronto per il lavoro di",
   "mezza giornata?"
  ]
 ],
 "s049.sec82.u0": [
  [
   "Ok, Abbiamo appena superato la",
   "meta'."
  ]
 ],
 "s049.sec82.u1": [
  [
   "Mmm, di questo passo... forse",
   "non avremo profitti. Continua a",
   "impegnarti."
  ]
 ],
 "s049.sec82.u2": [
  [
   "Bene, le vendite vanno",
   "abbastanza bene. Forse avremo",
   "un profitto, dopotutto."
  ]
 ],
 "s049.sec82.u3": [
  [
   "Accidenti! Vendite così buone",
   "sono rare. Continuiamo così",
   "fino alla fine."
  ]
 ],
 "s049.sec82.u4": [
  [
   "Ok, Sembra che il tempo sia",
   "scaduto."
  ]
 ],
 "s049.sec82.u5": [
  [
   "Mmm, pensavo avresti fatto un",
   "po' meglio. Be', certi giorni",
   "la fortuna non ti assiste..."
  ],
  [
   "Torna ad aiutarmi."
  ]
 ],
 "s049.sec82.u6": [
  [
   "500 Bits ottenuti!"
  ]
 ],
 "s049.sec82.u7": [
  [
   "Sì, le vendite sono andate come",
   "previsto. Ma per una persona",
   "del tuo talento non è ancora"
  ],
  [
   "abbastanza. Torna ad aiutarmi."
  ]
 ],
 "s049.sec82.u8": [
  [
   "1500 Bits ottenuti!"
  ]
 ],
 "s049.sec82.u9": [
  [
   "Che dire, se non: splendido! Il",
   "tuo ingegno, la tua grinta e il",
   "tuo carattere bastano a"
  ],
  [
   "salvare l'isola."
  ]
 ],
 "s049.sec82.u10": [
  [
   "Huh?"
  ]
 ],
 "s049.sec82.u11": [
  [
   "Perdonami. Ti mettevo alla",
   "prova per vedere se avevi la",
   "stoffa per salvare l'isola."
  ],
  [
   "Essere forti in battaglia è",
   "importante, certo."
  ]
 ],
 "s049.sec82.u12": [
  [
   "Ma credevo che la sola forza",
   "non bastasse a salvare l'isola.",
   "Servono anche ingegno e"
  ],
  [
   "coraggio."
  ]
 ],
 "s049.sec82.u13": [
  [
   "Mi dispiace di avertelo",
   "nascosto."
  ]
 ],
 "s049.sec82.u14": [
  [
   "Allora, abbiamo superato la",
   "prova?"
  ]
 ],
 "s049.sec82.u15": [
  [
   "Ben oltre ogni mia aspettativa.",
   "D'ora in poi vi aiuterò con",
   "tutte le mie forze."
  ]
 ],
 "s049.sec82.u16": [
  [
   "Allora verrai in città! Mmm? E",
   "questo negozio?"
  ]
 ],
 "s049.sec82.u17": [
  [
   "Oh, posso aprire un negozio",
   "quando voglio. Questo ha fatto",
   "il suo dovere."
  ]
 ],
 "s049.sec82.u18": [
  [
   "Monochromon si è unito alla",
   "città! 2000 Bits ottenuti!"
  ]
 ]
}
