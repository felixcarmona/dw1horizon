 "s078.sec82.u0": [
  [
   "...Immagino che tu l'abbia già",
   "sentito."
  ]
 ],
 "s078.sec82.u1": [
  [
   "Qui il tempo scorre lentamente.",
   "Mentre fuori passa un giorno,",
   "qui ne passa solo metà."
  ]
 ],
 "s078.sec82.u2": [
  [
   "È un bel posto per chi ama",
   "prendersela comoda."
  ]
 ],
 "s078.sec82.u3": [
  [
   "Più avanti, nell'Antica zona",
   "veloce, il tempo scorre in",
   "fretta. Lì passano due giorni"
  ],
  [
   "mentre fuori ne passa uno."
  ]
 ],
 "s078.sec82.u4": [
  [
   "Si potrebbe dire che fa",
   "crescere più in fretta... ma",
   "quando sei ridotto a ossa, è"
  ],
  [
   "troppo tardi."
  ]
 ],
 "s079.sec6.u0": [
  [
   "Da qui in poi il tempo scorre",
   "al doppio della velocità",
   "rispetto a fuori. Porta tanto"
  ],
  [
   "cibo. E attento alla durata",
   "della vita, ovviamente."
  ]
 ],
 "s079.sec6.u1": [
  [
   "Allora? Hai trovato qualcosa?"
  ]
 ],
 "s079.sec6.u2": [
  [
   "No, non ancora..."
  ]
 ],
 "s079.sec6.u3": [
  [
   "Il mio maestro, che sorvegliava",
   "questo posto prima di me,",
   "diceva che qui c'è un passaggio"
  ],
  [
   "segreto. Ma non chiedermi dove."
  ]
 ],
 "s079.sec6.u4": [
  [
   "Ah, Come va?..?"
  ]
 ],
 "s079.sec6.u5": [
  [
   "Il meteorite... Alla fine non",
   "c'entrava nulla. Uff..."
  ]
 ],
 "s079.sec6.u6": [
  [
   "Ah, capisco. Beh, che sfortuna.",
   "Mi dispiace, ma non so altro."
  ]
 ],
 "s079.sec6.u7": [
  [
   "...Beh, Ci vediamo dopo."
  ]
 ],
 "s079.sec6.u8": [
  [
   "Eeehi, tuuu!!"
  ]
 ],
 "s079.sec6.u9": [
  [
   "ECCO perché ti dico sempre",
   "che sei ancora a metà",
   "dell'addestramento!"
  ]
 ],
 "s079.sec6.u10": [
  [
   "M-m-maestro?!"
  ]
 ],
 "s079.sec6.u11": [
  [
   "Testone! Non posso credere",
   "che tu stia ancora a",
   "bighellonare qui!"
  ]
 ],
 "s079.sec6.u12": [
  [
   "Il suo maestro?! Che succede?!"
  ]
 ],
 "s079.sec6.u13": [
  [
   "M-ma chi sorveglierà l'Antica",
   "regione Dino..."
  ]
 ],
 "s079.sec6.u14": [
  [
   "Testone! L'isola è in grave",
   "pericolo! Va' in città e",
   "renditi utile a tutti, sciocco!"
  ]
 ],
 "s079.sec6.u15": [
  [
   "S... Sì, signore..."
  ]
 ],
 "s079.sec6.u16": [
  [
   "Eh, davvero?!"
  ]
 ],
 "s079.sec6.u17": [
  [
   "Ragazzo del mondo analogico, è",
   "ancora inesperto, ma lo farai",
   "lavorare nella tua città? Farò"
  ],
  [
   "io la guardia qui."
  ]
 ],
 "s079.sec6.u18": [
  [
   "Maestro..."
  ]
 ],
 "s079.sec6.u19": [
  [
   "Ecco come stanno le cose,",
   "{color 6}{player}{color 1}. Posso venire in",
   "città?"
  ]
 ],
 "s079.sec6.u20": [
  [
   "Certo. Ma fa' la tua parte."
  ]
 ],
 "s079.sec6.u21": [
  [
   "Contaci! Maestro, io vado!"
  ]
 ],
 "s079.sec6.u22": "Tyrannomon si è unito alla città!",
 "s079.sec6.u23": [
  [
   "Vediamo quanta strada farà...",
   "Eh."
  ]
 ],
