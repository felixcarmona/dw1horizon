   "Aspetta... Ora che lo dici,",
   "tempo fa è caduta un'enorme"
  ],
  [
   "roccia dal cielo... Era..."
  ]
 ],
 "s079.sec51.u6": [
  [
   "Eh? Dove è caduta?!"
  ]
 ],
 "s079.sec51.u7": [
  [
   "...Nell'Antica zona veloce.",
   "Proprio da questa parte..."
  ]
 ],
 "s079.sec51.u8": [
  [
