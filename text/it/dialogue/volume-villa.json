{
 "s135.sec5.u0": [
  [
   "Dunque siete {color 6}{player}{color 1} e",
   "{color 10}{partner}{color 1}? Benvenuti a Villa",
   "Volume!"
  ]
 ],
 "s135.sec5.u1": [
  [
   "...... Scusa se ce la siamo",
   "presa con Otamamon."
  ]
 ],
 "s135.sec5.u2": [
  [
   "Non è importante."
  ]
 ],
 "s135.sec5.u3": [
  [
   "Huh?"
  ]
 ],
 "s135.sec5.u4": [
  [
   "Sono grato a entrambi. Ho",
   "saputo di tutto ciò che avete",
   "fatto per salvare l'isola."
  ]
 ],
 "s135.sec5.u5": [
  [
   "Ah, Si'?"
  ]
 ],
 "s135.sec5.u6": [
  [
   "Anch'io desidero aiutarvi da",
   "tempo. Siete già stati nella",
   "foresta a nord, gli Bosco"
  ],
  [
   "nebbioso?"
  ]
 ],
 "s135.sec5.u7": [
  [
   "Non ancora."
  ]
 ],
 "s135.sec5.u8": [
  [
   "Ci sono passato."
  ]
 ],
 "s135.sec5.u9": [
  [
   "La nebbia avvolge quel luogo,",
   "rendendo arduo il cammino. Ma",
   "dovreste incontrare Cherrymon,"
  ],
  [
   "l'anziano della foresta."
  ]
 ],
 "s135.sec5.u10": [
  [
   "Cherrymon? Non ho mai sentito",
   "parlare di questo Digimon..."
  ]
 ],
 "s135.sec5.u11": [
  [
   "È Cherrymon a creare la nebbia",
   "degli Bosco nebbioso. Sa dei",
   "disordini sull'isola e usa la"
  ],
  [
   "nebbia per proteggere la",
   "foresta."
  ]
 ],
 "s135.sec5.u12": [
  [
   "Per noi però è un problema."
  ]
 ],
 "s135.sec5.u13": [
  [
   "Cherrymon sembra sapere cosa",
   "si nasconde dietro i disordini.",
   "Vale la pena incontrarlo, anche"
  ],
  [
   "attraversando la nebbia."
  ]
 ],
 "s135.sec5.u14": [
  [
   "Se potessimo almeno fare",
   "qualcosa con la nebbia..."
  ]
 ],
 "s135.sec5.u15": [
  [
   "La nebbia non si diraderà",
   "finché Cherrymon non la",
   "fermerà. Ma c'è un modo: vi"
  ],
  [
   "lancerò un incantesimo."
  ]
 ],
 "s135.sec5.u16": [
  [
   "Che effetto avrà?"
  ]
 ],
 "s135.sec5.u17": [
  [
   "Potrete vedere il sentiero",
   "anche nella nebbia."
  ]
 ],
 "s135.sec5.u18": [
  [
   "E' fantastico!"
  ]
 ],
 "s135.sec5.u19": [
  [
   "Cominciamo, Allora... senza",
   "indugio."
  ]
 ],
 "s135.sec5.u20": [
  [
   "Croac-croac! !"
  ]
 ],
 "s135.sec5.u21": [
  [
   "Ecco fatto. Andate subito agli",
   "Bosco nebbioso."
  ]
 ],
 "s135.sec5.u22": [
  [
   "L'ho visto. E la nebbia e'",
   "sparita."
  ]
 ],
 "s135.sec5.u23": [
  [
   "C-cosa! Davvero notevole.",
   "Mmm, come posso aiutarvi",
   "allora... Ah, lo so. Vi darò"
  ],
  [
   "questo."
  ]
 ],
 "s135.sec5.u24": [
  [
   "{color 6}Digispigola{color 1} ottenuta!"
  ]
 ],
 "s135.sec5.u25": [
  [
   "Getta qualcosa per fare spazio."
  ]
 ],
 "s135.sec5.u26": [
  [
   "E' qualcosa di prezioso. Sarà",
   "utile."
  ]
 ],
 "s135.sec5.u27": [
  [
   "Grazie. A proposito, non",
   "verreste in città, Vostra",
   "Signoria?"
  ]
 ],
 "s135.sec5.u28": [
  [
   "Sono il capo dei cento Gekomon",
   "della Palude Geko. Purtroppo",
   "non posso. Ma da qui vi aiuterò"
  ],
  [
   "con ogni mezzo. Tornate quando",
   "volete."
  ]
 ],
 "s135.sec6.u0": [
  [
   "Puoi pescare solo sulla riva",
   "del Lago Occhio di Drago."
  ]
 ],
 "s135.sec6.u1": [
  [
   "Inchinatevi, inchinatevi!"
  ]
 ],
 "s135.sec7.u0": [
  [
   "Sua Signoria colleziona rarità.",
   "Prima raccoglieva oggetti, ma",
   "ora va pazzo per le carte"
  ],
  [
   "Digimon."
  ]
 ],
 "s135.sec7.u1": [
  [
   "Chiunque gli porti una carta",
   "rara riceve punti Merito."
  ]
 ],
 "s135.sec7.u2": [
  [
   "Poi puoi scambiare i punti",
   "Merito accumulati con degli",
   "oggetti."
  ]
 ],
 "s135.sec8.u0": [
  [
   "Ehm... No, niente, cra."
  ]
 ],
 "s135.sec8.u1": [
  [
   "Ehm...! Voglio andare in città,",
   "cra!"
  ]
 ],
 "s135.sec8.u2": [
  [
   "Certo, va bene, ma che",
   "succede?"
  ]
 ],
 "s135.sec8.u3": [
  [
   "Voglio combattere in un posto",
   "chiamato arena, cra. Pare che",
   "ci considerino dei campagnoli,"
  ],
  [
   "noi Gekomon, cra... Ma anche i",
   "campagnoli hanno il loro",
   "orgoglio, cra! Ti prego, te lo"
  ],
  [
   "chiedo in ginocchio, cra."
  ]
 ],
 "s135.sec8.u4": [
  [
   "Capisco. So come ti senti...",
   "Allora vai e dai il massimo."
  ]
 ],
 "s135.sec8.u5": [
  [
   "Gekomon si è unito all'arena!"
  ]
 ],
 "s135.sec81.u0": [
  [
   "Sembri preoccupato. Sì, sì, lo",
   "so. È per via del costume,",
   "vero?"
  ]
 ],
 "s135.sec81.u1": [
  [
   "Eh! Lo sai?"
  ]
 ],
 "s135.sec81.u2": [
  [
   "Non sottovalutarmi. Numemon",
   "può indossare quel costume,",
   "sai? Sorpreso? E quando lo"
  ],
  [
   "indossa... incredibile......!",
   "Be', tentar non nuoce."
  ]
 ],
 "s135.sec81.u3": [
  [
   "Mmm, a proposito: la {color 6}Canna",
   "incredibile{color 1} è un oggetto",
   "speciale, quindi la toglierò"
  ],
  [
   "dai tuoi oggetti."
  ]
 ],
 "s135.sec81.u4": [
  [
   "Dai il massimo!"
  ]
 ]
}
