{
 "s064.sec5.u0": [
  [
   "Torneremo a gareggiare",
   "nell'arena. Sono certo che a",
   "qualcuno mancherei. Eh eh..."
  ]
 ],
 "s064.sec5.u1": [
  [
   "I miei uomini sono trascurati",
   "rispetto a me, quindi porterò",
   "SkullGreymon nell'arena."
  ]
 ],
 "s064.sec5.u2": [
  [
   "Ah, e stai tranquillo: a",
   "differenza di prima, ora",
   "SkullGreymon obbedisce."
  ]
 ],
 "s064.sec5.u3": [
  [
   "Myotismon, stai bene?!"
  ]
 ],
 "s064.sec5.u4": [
  [
   "Ugh... uhh... Oh? Sei tu!",
   "Continui a venire in mio",
   "soccorso."
  ]
 ],
 "s064.sec5.u5": [
  [
   "Che è successo?"
  ]
 ],
 "s064.sec5.u6": [
  [
   "Mmm... Dimmi, hai incontrato",
   "Devimon?"
  ]
 ],
 "s064.sec5.u7": [
  [
   "Sì. Quel brutto tipo."
  ]
 ],
 "s064.sec5.u8": [
  [
   "Ha infuso energia oscura nel",
   "materiale che stavo studiando."
  ]
 ],
 "s064.sec5.u9": [
  [
   "La tua ricerca... intendi",
   "SkullGreymon?! È pericoloso..."
  ]
 ],
 "s064.sec5.u10": [
  [
   "Era più una collezione che una",
   "ricerca. Raccoglievo ossa e le",
   "assemblavo... Ho imparato la"
  ],
  [
   "lezione."
  ]
 ],
 "s064.sec5.u11": [
  [
   "Ma qui il cattivo è Devimon."
  ]
 ],
 "s064.sec5.u12": [
  [
   "...In realtà, lo conosco."
  ]
 ],
 "s064.sec5.u13": [
  [
   "Cosaaa?!"
  ]
 ],
 "s064.sec5.u14": [
  [
   "È sempre stato contorto... ma",
   "non era tipo da fare una cosa",
   "simile. Forse qualcuno lo"
  ],
  [
   "controlla."
  ]
 ],
 "s064.sec5.u15": [
  [
   "...Quindi è così..."
  ]
 ],
 "s064.sec5.u16": [
  [
   "Se torna quello di prima...",
   "ricorda che persino lui",
   "potrebbe unirsi a voi."
  ]
 ],
 "s064.sec6.u0": [
  [
   "Bu!"
  ]
 ],
 "s064.sec6.u1": [
  [
   "......"
  ]
 ],
 "s064.sec81.u0": [
  [
   "Myotismon! Che cosa è",
   "successo...?"
  ]
 ],
 "s065.sec6.u0": [
  [
   "........."
  ]
 ],
 "s065.sec7.u0": [
  [
   "........."
  ]
 ],
 "s065.sec8.u0": [
  [
   "........."
  ]
 ],
 "s065.sec9.u0": [
  [
   "........."
  ]
 ],
 "s065.sec10.u0": [
  [
   "........."
  ]
 ],
 "s065.sec51.u0": [
  [
   "Io... ti... ucciderò...!"
  ]
 ],
 "s065.sec81.u0": [
  [
   "Agh, una parete nera! Sono",
   "stato ingannato!"
  ]
 ],
 "s181.sec51.u0": [
  [
   "!"
  ]
 ],
 "s181.sec51.u1": [
  [
   "...Sei tu... {color 6}{player}{color 1}?"
  ]
 ],
 "s181.sec51.u2": "Un Digimon scheletro!",
 "s181.sec51.u3": [
  [
   "...Sei tu... {color 10}{partner}{color 1}?"
  ]
 ],
 "s181.sec51.u4": [
  [
   "Non sento vita in questa",
   "creatura... ma sento la sua",
   "intenzione di uccidere...! È"
  ],
  [
   "stato lui a fare questo a",
   "Myotismon?!"
  ]
 ],
 "s181.sec51.u5": [
  [
   "Nessuna... risposta... Attacco."
  ]
 ],
 "s181.sec51.u6": [
  [
   "...Attacco... tacco...",
   "Attacco... at..."
  ]
 ],
 "s181.sec51.u7": [
  [
   "Devo salvare Myotismon,",
   "presto."
  ]
 ]
