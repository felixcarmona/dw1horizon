{
 "s185.sec5.u0": [
  [
   "Ti mostrerò il mio vero potere."
  ]
 ],
 "s185.sec6.u0": [
  [
   "Pensare che è giunto il momento",
   "di combattere con tutte le mie",
   "forze..."
  ]
 ],
 "s185.sec7.u0": [
  [
   "...Tu... morirai."
  ]
 ],
 "s185.sec8.u0": [
  [
   "E' qui che inizia il vero",
   "inferno..."
  ]
 ],
 "s185.sec60.u0": [
  [
   "Questo posto...!"
  ]
 ],
 "s185.sec60.u1": [
  [
   "Capisco. Più avanti, oltre",
   "questo punto..."
  ]
 ],
 "s186.sec5.u0": [
  [
   "...Ti... farò... a... pezzi..."
  ]
 ],
 "s186.sec6.u0": [
  [
   "UCCIDERE!"
  ]
 ],
 "s186.sec7.u0": [
  [
   "Contorciti e soffri. È il tuo",
   "destino."
  ]
 ],
 "s186.sec8.u0": [
  [
   "Cosa cerchi, gettando via la",
   "tua vita?"
  ]
 ],
 "s187.sec5.u0": [
  [
   "Iniziare il combattimento!"
  ]
 ],
 "s187.sec6.u0": [
  [
   "Puntare... FUOCO!"
  ]
 ],
 "s187.sec7.u0": [
  [
   "...Il mio... lavoro."
  ]
 ],
 "s187.sec8.u0": [
  [
   "Sono gli ordini."
  ]
 ]
}
