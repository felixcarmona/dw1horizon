{
 "s140.sec5.m0.o0": "Sì",
 "s140.sec5.m0.o1": "No",
 "s140.sec5.u0": [
  [
   "Ma che...?!"
  ]
 ],
 "s140.sec5.u1": [
  [
   "Ah, Bentornato a casa,",
   "Hagurumon!"
  ]
 ],
 "s140.sec5.u2": [
  [
   "Hagurumon!?"
  ]
 ],
 "s140.sec5.u3": [
  [
   "Che succede??"
  ]
 ],
 "s140.sec5.u4": [
  [
   "{color 7}Giocattoli {color 1}",
   "«È una storia di tanto tempo",
   "fa. Un cattivo venuto da",
   "lontano arrivò su quest'isola.»"
  ]
 ],
 "s140.sec5.u5": [
  [
   "{color 7}Giocattoli {color 1}",
   "«Il cattivo disse ai Digimon:",
   "Quest'isola mi appartiene.»"
  ]
 ],
 "s140.sec5.u6": [
  [
   "{color 7}Giocattoli {color 1}",
   "«I Digimon gli risposero: Non è",
   "vero. Quest'isola appartiene a",
   "tutti.»"
  ]
 ],
 "s140.sec5.u7": [
  [
   "{color 7}Giocattoli {color 1}",
   "«Lo sfidarono a combattere.",
   "Tutti i Digimon si unirono e il",
   "cattivo fu punito.»"
  ]
 ],
 "s140.sec5.u8": [
  [
   "{color 7}Giocattoli {color 1}",
   "«Ma il cattivo disse: Aspettate",
   "e vedrete! Poi se ne andò da",
   "qualche parte.»"
  ]
 ],
 "s140.sec5.u9": [
  [
   "{color 7}Giocattoli {color 1}",
   "«È una storia di tanto tempo",
   "fa.»"
  ]
 ],
 "s140.sec5.u10": [
  [
   "Evviva... Mi sento tutto",
   "felice... Oh, no! Quella",
   "canzone parlava del passato"
  ],
  [
   "dell'isola, vero? Di come i",
   "Digimon sconfissero un cattivo",
   "tanto tempo fa... Mmm... Un"
  ],
  [
   "cattivo... Chi poteva essere?"
  ]
 ],
 "s140.sec5.u11": [
  [
   "Grazie per averci salvato. E'",
   "un regalo di ringraziamento."
  ]
 ],
 "s140.sec5.u12": "Il peluche Monzaemon si è unito alla città!",
 "s140.sec5.u13": [
  [
   "Ehi, WaruMonzaemon non ha",
   "lasciato cadere qualcosa?"
  ]
 ],
 "s140.sec5.u14": [
  [
   "Buona fortuna! È la casa",
   "accanto!"
  ]
 ],
 "s140.sec5.u15": [
  [
   "......"
  ]
 ],
 "s140.sec5.u16": [
  [
   "Vuoi sentire di nuovo il nostro",
   "coro?"
  ]
 ],
 "s140.sec5.u17": [
  [
   "Ah, Monzaemon! Sei tornato in",
   "vita!"
  ]
 ],
 "s140.sec5.u18": [
  [
   "Oh, cos'è questo?"
  ]
 ],
 "s140.sec5.u19": [
  [
   "Presto, sconfiggi",
   "WaruMonzaemon! Hanno tutti",
   "smesso di muoversi! Presto,"
  ],
  [
   "presto!"
  ]
 ],
 "s140.sec5.u20": [
  [
   "A-aspetta! Questo non è il",
   "Monzaemon che conosci."
  ]
 ],
 "s140.sec5.u21": [
  [
   "Eh? Oh, cielo. Ma è pur sempre",
   "un Monzaemon, no?"
  ]
 ],
 "s140.sec5.u22": [
  [
   "Be'... è proprio un Monzaemon."
  ]
 ],
 "s140.sec5.u23": [
  [
   "Allora, ti prego! Un tipo",
   "mooolto cattivo chiamato",
   "WaruMonzaemon ha rapito il mio"
  ],
  [
   "amico."
  ]
 ],
 "s140.sec5.u24": [
  [
   "Probabilmente Monzaemon è",
   "l'unico che può batterlo!"
  ]
 ],
 "s140.sec5.u25": [
  [
   "Mmm... Non posso lasciar",
   "correre. Va bene, dov'è?"
  ]
 ],
 "s140.sec5.u26": [
  [
   "È nella casa accanto. Spezzerò",
   "il sigillo sulla porta, vai a",
   "vedere!"
  ]
 ],
 "s140.sec5.u27": [
  [
   "Capito. Va bene, ti aiuteremo!"
  ]
 ],
 "s140.sec6.u0": [
  [
   "Grazie!"
