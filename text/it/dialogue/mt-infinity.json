  ]
 ],
 "s182.sec53.u0": [
  [
   "Allora... Finalmente sei",
   "arrivato fino a qui."
  ]
 ],
 "s182.sec53.u1": [
  [
   "Sei tu il grande capo?!"
  ]
 ],
 "s182.sec53.u2": [
  [
   "Mi dispiace, ma no. Sono",
   "MetalGreymon!"
  ]
 ],
 "s182.sec53.u3": [
  [
   "Mi occuperò di te dopo! Levati",
   "di mezzo!"
  ]
 ],
 "s182.sec53.u4": [
  [
   "Non succedera'. Il mio lavoro",
   "e' impedirti di andare avanti."
  ]
 ],
 "s182.sec53.u5": [
  [
   "Ugh... Volevo risparmiare le",
   "nostre forze, ma questo qui non",
   "me lo permette..."
  ]
 ],
 "s182.sec53.u6": [
  [
   "Arrivo!"
  ]
 ],
 "s182.sec53.u7": [
  [
   "Ugh... Mmm... Dove sono...?"
  ]
 ],
 "s182.sec53.u8": [
  [
   "Sei tornato in te!"
  ]
 ],
 "s182.sec53.u9": [
  [
   "Così pare... Eh... Se lo",
   "sconfiggi, forse ci rivedremo",
   "un giorno. Fino ad allora, me"
  ],
  [
   "ne vado."
  ]
 ],
 "s184.sec51.u0": [
  [
   "!!!"
  ]
 ],
 "s184.sec51.u1": [
  [
   "Un uovo! Non sarà quello di",
   "Machinedramon..."
  ]
 ],
 "s184.sec51.u2": [
  [
   "Oh! È un brutto segno?!"
  ]
 ],
 "s184.sec51.u3": "Digitamamon si è unito alla città!",
 "s184.sec51.u4": [
  [
   "!!!"
  ]
 ],
 "s184.sec51.u5": [
  [
   "E-eccoti! Ti ho trovato!"
  ]
 ],
 "s184.sec51.u6": [
  [
   "Quindi sei tu il grande capo?!"
  ]
 ],
 "s184.sec51.u7": [
  [
   "Eh eh eh... Finalmente ci",
   "incontriamo. Sono Analogman."
  ]
 ],
 "s184.sec51.u8": [
  [
   "So tutto di te... Mmm, visto da",
   "vicino sei proprio solo un",
   "moccioso. Pensare che un"
  ],
  [
   "moccioso simile ha rovinato le",
   "mie ambizioni... Il mondo della",
   "Rete era quasi mio..."
  ]
 ],
 "s184.sec51.u9": [
  [
   "Ehi, tu... sei un umano adulto,",
   "no? Quali ambizioni? È stupido.",
   "Stai creando problemi a tutti!"
  ]
 ],
 "s184.sec51.u10": [
  [
   "Problemi? Ai Digimon? Eh eh eh",
   "eh..."
  ]
 ],
 "s184.sec51.u11": [
  [
   "I Digimon devono solo fare ciò",
   "che gli umani ordinano. Come",
   "piace a me... come strumenti!"
  ]
 ],
 "s184.sec51.u12": [
  [
   "Ti sbagli! Anche i Digimon",
   "hanno un cuore! Sono tutti",
   "nostri amici!"
  ]
 ],
 "s184.sec51.u13": [
  [
   "Umpf. Vediamo cosa vale di più:",
   "i tuoi amici o i miei",
   "strumenti!"
  ]
 ],
 "s184.sec51.u14": [
  [
   "Tocca a te! Il Digimon",
   "supremo, il più forte...",
   "Machinedramon!"
  ]
 ],
 "s184.sec51.u15": [
  [
   "Ce l'abbiamo fatta, ce",
   "l'abbiamo fatta, {color 10}{partner}{color 1}!"
  ]
 ],
 "s184.sec51.u16": [
  [
   "Im... impossibile! La mia arma",
   "più potente!"
  ]
 ],
 "s184.sec51.u17": [
  [
   "Vedi? Eri tu quello che si",
   "sbagliava."
  ]
 ],
 "s184.sec51.u18": [
  [
   "Oh... Ohhh..."
  ]
 ],
 "s184.sec51.u19": [
  [
   "...Ascolta. Riporta l'isola",
   "com'era e chiedi scusa a tutti",
   "in città, e ti perdonerò."
  ],
  [
   "Scommetto che lo faranno anche",
   "loro..."
  ]
 ],
 "s184.sec51.u20": [
  [
   "Eh... eh eh... È vero. Non ci",
   "si può fidare dei Digimon...",
   "Posso fidarmi solo del mio"
  ],
  [
   "potere..."
  ]
 ],
 "s184.sec51.u21": [
  [
   "Hey! Che stai facendo??"
  ]
 ],
 "s184.sec51.u22": [
  [
   "{color 7}Analogman {color 1}",
   "Farò saltare in aria questo",
   "posto e fuggirò in un altro",
   "mondo... Peggio per te,"
  ],
  [
   "{color 7}Analogman {color 1}",
   "moccioso!"
  ]
 ],
 "s184.sec51.u23": [
  [
   "Oh, no, non può farlo!"
  ]
 ],
 "s184.sec51.u24": [
  [
   "{color 7}Analogman {color 1}",
   "Eh, ah ah ah ah! Addio!"
  ]
 ],
 "s184.sec51.u25": [
  [
   "Mannaggia! Mi dispiace,",
   "amici..."
  ]
 ],
 "s184.sec51.u26": [
  [
   "{color 7}??? {color 1}",
   "Va bene."
  ]
 ],
 "s184.sec51.u27": [
  [
   "Eh...?"
  ]
 ],
 "s184.sec51.u28": [
  [
   "{color 7}Analogman {color 1}",
   "Cosa...? Il trasferimento non",
   "parte... Q-qualcosa non va...",
   "il programma... Cos'è questo?!"
  ]
 ],
 "s184.sec51.u29": [
  [
   "Sento... le voci di tutti...!"
  ]
 ],
 "s184.sec51.u30": [
  [
   "{color 7}Jijimon {color 1}",
   "Vi stiamo inviando la nostra",
   "forza."
  ]
 ],
 "s184.sec51.u31": [
  [
   "{color 7}Tokomon {color 1}",
   "Ci sentite?"
