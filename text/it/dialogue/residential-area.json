{
 "s028.sec5.u0": [
  [
   "Ho rimesso a posto il cartello",
   "all'ingresso. Ma insomma..."
  ]
 ],
 "s028.sec5.u1": [
  [
   "Caldo! Rovente!! Sto",
   "bollendo!!! Qualcuno faccia",
   "qualcosa!"
  ]
 ],
 "s028.sec5.u2": [
  [
   "Che ti prende...?"
  ]
 ],
 "s028.sec5.u3": [
  [
   "Fa troppo caldo! Non ce la",
   "faccio più!"
  ]
 ],
 "s028.sec5.u4": [
  [
   "S-scusa. Il caldo deve avermi",
   "fatto perdere la testa."
  ]
 ],
 "s028.sec5.u5": [
  [
   "Sì, fa caldo, ma..."
  ]
 ],
 "s028.sec5.u6": [
  [
   "Questo tunnel... Più scaviamo a",
   "fondo, più fa caldo. È normale,",
   "siamo dentro un vulcano."
  ]
 ],
 "s028.sec5.u7": [
  [
   "Ma ultimamente c'è dell'altro.",
   "Il caldo è aumentato di colpo,",
   "davvero all'improvviso. Come se"
  ],
  [
   "ci fosse un incendio da qualche",
   "parte..."
  ]
 ],
 "s028.sec5.u8": [
  [
   "Mmmm."
  ]
 ],
 "s028.sec5.u9": [
  [
   "Alla fine devo solo stringere i",
   "denti e scavare. Va bene, farò",
   "del mio meglio."
  ]
 ],
 "s028.sec5.u10": [
  [
   "Capisco. Anche noi cercheremo",
   "la causa. Ci farebbe davvero",
   "comodo se questo tunnel"
  ],
  [
   "passasse dall'altra parte."
  ]
 ],
 "s028.sec5.u11": [
  [
   "Sei proprio un bravo ragazzo,",
   "sai? Bene, finirò di scavare",
   "questo tunnel in un lampo!"
  ]
 ],
 "s028.sec5.u12": [
  [
   "Oggi tocca a me cucinare."
  ]
 ]
}
