 ],
 "s055.sec83.u3": [
  [
   "Huh? non è qui? è scomparso?"
  ]
 ],
 "s055.sec83.u4": [
  [
   "Oh? C'è un biglietto",
   "attaccato..."
  ]
 ],
 "s055.sec83.u5": [
  [
   "«Torna dove hai sottratto",
   "punti allo sciocco.»"
  ]
 ],
 "s055.sec83.u6": [
  [
   "Mmm, per ora questo biglietto è",
   "il mio unico indizio. Mmm."
  ]
 ],
 "s055.sec83.u7": [
  [
   "Oh, un frigorifero."
  ]
 ],
 "s055.sec83.u8": [
  [
   "Uff, è chiuso a chiave. Chi",
   "chiude un frigo a chiave?"
  ]
 ],
