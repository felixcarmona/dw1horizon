 "s052.sec83.u0": [
  [
   "Non si apre... È chiusa a",
   "chiave. E non c'è il buco della",
   "serratura!"
  ]
 ],
 "s054.sec5.u0": [
  [
   "Ci hai aiutati tante volte.",
   "Lascia che condivida i frutti",
   "della mia ricerca. Quando"
  ],
  [
   "MetalGreymon muore in battaglia",
   "o per malattia, può diventare",
   "SkullGreymon. Anche Bakemon,"
  ],
  [
   "Devimon e Phoenixmon possono",
   "nascere così... Da quali forme,",
   "non so dirlo. Gli alberi di"
  ],
  [
   "digievoluzione non mostrano",
   "queste vie, quindi ricordatelo",
   "bene."
  ]
 ],
 "s054.sec5.u1": [
  [
   "Da quando i miei uomini",
   "combattono nell'arena, stanno",
   "tornando quelli di prima."
  ],
  [
   "Sembra fargli molto bene. E",
   "anche a me un incontro tra una",
   "ricerca e l'altra offre un"
  ],
  [
   "piacevole diversivo."
  ]
 ],
 "s054.sec5.u2": [
  [
   "Ma in cosa consiste questa sua",
   "ricerca...?"
  ]
 ],
 "s054.sec5.u3": [
  [
   "Myotismon, hanno aperto",
   "un'arena in città!"
  ]
 ],
 "s054.sec5.u4": [
  [
   "Mmm. Pensi che i miei uomini",
   "potrebbero essere utili lì?"
  ]
 ],
 "s054.sec5.u5": [
  [
   "Eccome! Lasciali scatenare!"
  ]
 ],
 "s054.sec5.u6": [
  [
   "I miei uomini stanno sempre",
   "peggio... Forse è solo",
   "questione di tempo prima che"
  ],
  [
   "lascino questa villa."
  ]
 ],
 "s054.sec60.u0": [
  [
   "Gnam, gnam..."
  ]
 ],
 "s054.sec60.u1": [
  [
   "Bene..."
  ]
 ],
 "s054.sec60.u2": [
  [
   "Forse ascolterai quello che",
   "devo dire."
  ]
 ],
 "s054.sec60.u3": [
  [
   "Croc, croc..."
  ]
 ],
 "s054.sec60.u4": [
  [
   "Ultimamente i miei uomini non",
   "fanno più ciò che dico. Non si",
   "ribellano... sembrano"
  ],
  [
   "semplicemente dimenticare del",
   "tutto gli ordini. A volte non",
   "li capiscono neppure."
  ],
  [
   "Dovrebbero portarmi i pasti,",
   "ma..."
  ]
 ],
 "s054.sec60.u5": [
  [
   "Glu, glu. . ."
  ]
 ],
 "s054.sec60.u6": [
  [
   "Mentre ero assorto nella",
   "ricerca, non arrivava alcun",
   "pasto... Ed ero così assorto da"
  ],
  [
   "dimenticare la fame. Così è",
   "successo."
  ]
 ],
 "s054.sec60.u7": [
  [
   "...Questo è essere TROPPO",
   "assorti."
  ]
 ],
 "s054.sec60.u8": [
  [
   "Oh, che imbarazzo."
  ]
 ],
 "s054.sec60.u9": [
  [
   "Quindi anche qui succedono le",
   "stesse strane cose che",
   "avvengono fuori."
  ]
 ],
 "s054.sec60.u10": [
  [
   "Oh? Con i disordini sull'isola",
   "intendi che tutti stanno",
   "diventando come i miei uomini?"
  ]
 ],
 "s054.sec60.u11": [
  [
   "Sì. Ogni specie sta per conto",
   "suo e perde la memoria. Non",
   "ancora tutti, ma se continua"
  ],
  [
   "così..."
  ]
 ],
 "s054.sec60.u12": [
  [
   "Qualcuno potrebbe esserne la",
   "causa? Mmm... E se sì, a che",
   "scopo...?"
  ]
 ],
 "s054.sec60.u13": [
  [
   "Mh..."
  ]
 ],
 "s054.sec60.u14": [
  [
   "Cosa posso fare per l'isola?"
  ]
 ],
 "s054.sec60.u15": [
  [
   "Stiamo costruendo una città",
   "per unire i cuori dei Digimon.",
   "Per questo giriamo l'isola: per"
  ],
  [
   "trovare amici."
  ]
 ],
 "s054.sec60.u16": [
  [
   "Capisco. Ma c'è un problema. A",
   "parte me, i miei uomini sanno",
   "fare poco altro oltre a"
  ],
  [
   "combattere. Eppure non posso",
   "abbandonarli..."
  ]
 ],
 "s054.sec60.u17": [
  [
   "Capisco..."
  ]
 ],
 "s054.sec60.u18": [
  [
   "Ti darò una risposta a tempo",
   "debito. Ho del lavoro da fare",
   "qui, vedi. Mi dispiace"
  ],
  [
   "davvero..."
  ]
 ],
 "s054.sec60.u19": [
  [
   "Va bene, allora tornerò. E mi",
   "raccomando, mangia come si",
   "deve!"
  ]
 ],
 "s054.sec60.u20": [
  [
   "Allora perché non combatti",
   "nell'arena?"
  ]
 ],
 "s054.sec60.u21": [
  [
   "Oh... l'arena? Interessante.",
   "Proprio ciò che serve per",
   "rimettere in forma i miei"
  ],
  [
   "uomini. E anche a me piacerebbe",
   "sgranchirmi le gambe ogni",
   "tanto."
  ]
 ],
 "s054.sec60.u22": [
  [
   "Quindi ti unirai a noi?!"
  ]
 ],
 "s054.sec60.u23": [
  [
   "Sì. Ho ancora delle ricerche da",
   "finire qui, quindi verrò in",
   "città tra uno studio e l'altro."
  ],
  [
   "Non vedo l'ora."
  ]
 ],
 "s054.sec81.u0": [
  [
   "Oh!"
  ]
 ],
 "s054.sec81.u1": [
  [
   "Sì, una chiave! Forse apre",
   "quelle porte che non si",
   "aprivano."
  ]
 ],
 "s054.sec81.u2": [
  [
   "{color 6}Chiave villa{color 1} ottenuta!"
  ]
 ],
 "s054.sec81.u3": [
  [
   "Ops, devo buttare via qualcosa."
  ]
 ],
 "s054.sec82.u0": [
  [
