  ]
 ],
 "s051.sec57.u0": [
  [
   "...! Sento la sete di sangue di",
   "qualcuno..."
  ]
 ],
 "s051.sec57.u1": [
  [
   "Eh eh... ah ah... Alla fine sei",
   "venuto!"
  ]
 ],
 "s051.sec57.u2": [
  [
   "Chi c'è!?"
  ]
 ],
 "s051.sec57.u3": [
  [
   "Sono Devimon! Un angelo",
   "caduto, asservito al potere",
   "delle tenebre. Eh eh eh..."
  ]
 ],
 "s051.sec57.u4": [
  [
   "Sembra che tu sappia qualcosa!"
  ]
 ],
 "s051.sec57.u5": [
  [
   "Myotismon è da qualche parte",
   "nella villa. Probabilmente è",
   "ancora vivo."
  ]
 ],
 "s051.sec57.u6": [
  [
   "Quindi è opera tua!"
  ]
 ],
 "s051.sec57.u7": [
  [
   "Chissà? Ma io sono il tuo",
   "nemico. E' sicuro."
  ]
 ],
 "s051.sec57.u8": [
  [
   "Ehi, non mi scappi!"
  ]
 ],
 "s051.sec57.u9": [
  [
   "Eh eh eh... Ah ah ah ah!"
  ]
 ],
 "s051.sec57.u10": [
  [
   "Oh, No!"
  ]
 ],
 "s051.sec57.u11": [
  [
   "Eh eh... Portagli i miei",
   "saluti, a Myotismon."
  ]
 ],
 "s051.sec57.u12": [
  [
   "È scappato... Mannaggia! Che",
   "viscido."
  ]
 ],
 "s051.sec57.u13": [
  [
   "Wow, questa villa sembra",
   "enorme."
  ]
 ],
 "s051.sec57.u14": [
  [
   "C'è nessunooo?"
  ]
 ],
 "s051.sec57.u15": [
  [
   "Non c'è nessuno? O è troppo",
   "grande perché mi sentano?"
  ]
 ],
 "s051.sec57.u16": [
  [
   "Pazienza. Bene, esploriamo!"
  ]
 ],
