 "s177.sec6.u0": [
  [
   "Il tuo umile servitore sa",
   "qualcosa sugli oggetti. Ne",
   "esistono 128 tipi, dicono. Di"
  ],
  [
   "questi, 32 sono cibi! Alcuni",
   "crescono solo in una regione.",
   "Sono rari! Per esempio, nella"
  ],
  [
   "Foresta natia trovi la Mela",
   "blu. Questi cibi hanno effetti",
   "speciali. Pensa bene a quando"
  ],
  [
   "mangiarli!"
  ]
 ],
 "s177.sec6.u1": [
  [
   "Stavolta il tuo umile servitore",
   "parlerà degli oggetti di",
   "digievoluzione. Fanno"
  ],
  [
   "digievolvere un Digimon. Ce ne",
   "sono di ogni tipo, uno per ogni",
   "forma, dicono. Per esempio, gli"
  ],
  [
   "Artigli grigi danno un Greymon!",
   "Sono oggetti leggendari; alcuni",
   "sono unici al mondo. Ma"
  ],
  [
   "rispetto alla digievoluzione",
   "normale non danno bonus ai",
   "parametri e abbassano l'umore."
  ],
  [
   "Poco conveniente! Eppure",
   "ottenere subito la forma voluta",
   "ha il suo fascino. Attento:"
  ],
  [
   "funziona solo dal livello",
   "subito precedente!"
  ]
 ]
