{
 "s173.sec6.u0": [
  [
   "Beh... Riposare spesso per",
   "smaltire la stanchezza è il",
   "segreto della buona salute."
  ]
 ],
 "s173.sec6.u1": [
  [
   "Beh, ti spiego come cresce la",
   "prosperità della città. Un",
   "Intermedio che arriva dà 1"
  ],
  [
   "punto, un Campione 2. Un",
   "Evoluto ne dà 3, a quanto",
   "pare. Ma tre dei Campioni,"
  ],
  [
   "quelli meno utili, danno solo 1",
   "punto."
  ]
 ],
 "s173.sec6.u2": [
  [
   "Beh, parliamo un po' dei tipi.",
   "I nemici dello stesso tipo del",
   "tuo compagno si uniscono"
  ],
  [
   "raramente a una battaglia. E ci",
   "sono due posti che non ti",
   "lasciano entrare se il tuo tipo"
  ],
  [
   "non è quello giusto. Per il",
   "resto non devi preoccupartene",
   "troppo."
  ]
 ],
 "s173.sec6.u3": [
  [
   "Beh, ti parlo del livello del",
   "Domatore. Prima di tutto, la",
   "digievoluzione: porta un"
  ],
  [
   "Digimon fino al livello Evoluto",
   "e salirà di un livello di",
   "sicuro. Aiuta anche vincere un"
  ],
  [
   "torneo di grado alto. Insomma,",
   "sale quasi da solo. Devi stare",
   "attento a non farlo scendere."
  ],
  [
   "Per esempio, esaurire tutte le",
   "vite lo fa scendere di sicuro.",
   "Raramente, anche gli errori"
  ],
  [
   "nelle cure quotidiane possono",
   "abbassarlo. Fai sempre",
   "attenzione, eh?"
  ]
 ]
}
