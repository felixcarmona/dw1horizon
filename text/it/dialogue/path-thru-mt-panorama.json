{
 "s019.sec5.u0": [
  [
   "Nessuno mi supera!"
  ]
 ],
 "s019.sec6.u0": [
  [
   "Ti prenderò tutto quello che",
   "hai!"
  ]
 ],
 "s019.sec7.u0": [
  [
   "Temo di non poterti far",
   "passare."
  ]
 ],
 "s019.sec8.u0": [
  [
   "Pensi di poter vincere? Non",
   "farmi ridere!"
  ]
 ],
 "s019.sec9.u0": [
  [
   "Ti ripulisco da cima a fondo!"
  ]
 ],
 "s019.sec10.u0": [
  [
   "Ti piego in due!"
  ]
 ],
 "s019.sec11.u0": [
  [
   "Davvero, non ne posso più!"
  ]
 ],
 "s019.sec12.u0": [
  [
   "Vuoi che ti dia il colpo di",
   "grazia?"
  ]
 ],
 "s021.sec5.u0": [
  [
   "Ma che crudeltà!"
  ]
 ],
 "s021.sec6.u0": [
  [
   "Lascia qui qualcosa, dai!"
  ]
 ],
 "s021.sec7.u0": [
  [
   "Ti affronto io, amico!"
  ]
 ],
 "s021.sec8.u0": [
  [
   "Fermo lì!"
  ]
 ]
}
