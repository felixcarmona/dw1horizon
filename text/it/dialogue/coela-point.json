   "pesca rara! Sono Coelamon, il"
  ],
  [
   "Digimon pesce. Hai fatto tanta",
   "strada solo per vedermi?"
  ]
 ],
 "s006.sec51.u7": [
  [
   "Oh oh, capisco, capisco!"
  ]
 ],
 "s006.sec51.u8": [
  [
