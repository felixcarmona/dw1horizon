 ],
 "s006.sec51.u2": [
  [
   "Costruire una città significa",
   "salvare quest'isola. Si salvano",
   "tutti, me compreso. Capisci?"
  ]
 ],
 "s006.sec51.u3": [
  [
   "Vuoi dire che vieni in citta'?"
  ]
 ],
 "s006.sec51.u4": [
  [
   "Ah. Vado in quella tua città."
  ]
 ],
 "s006.sec51.u5": "Coelamon si è unito alla città!",
 "s006.sec51.u6": [
  [
   "Mh? Dimmi, sei un umano?",
