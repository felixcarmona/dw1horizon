 "s006.sec51.m0.o0": "Ti stavo cercando!",
 "s006.sec51.m0.o1": "Per caso",
 "s006.sec51.u0": [
  [
   "Mh? Ma guarda, {color 6}{player}{color 1}.",
   "Sembra che il ponte sia",
