 ],
 "s122.sec5.u3": "O quê?",
 "s122.sec5.u4": "Eu estava a caminho da sua cidade, para usar meus talentos!",
 "s122.sec5.u5": "Que talentos?",
 "s122.sec5.u6": "Meu Deus, você não me conhece? Entre Digimon sou famoso por saber de tudo!",
 "s122.sec5.u7": "Huh. Nunca ouvi falar de você.",
 "s122.sec5.u8": "Bem, então, eu vou para a cidade.",
 "s122.sec5.u9": "Esse cara vai ser útil?",
 "s122.sec5.u10": "Bom dia para você!",
 "s122.sec5.u11": "Shellmon veio para a cidade!",
 "s122.sec6.u0": "Estou atrapalhando?",
 "s123.sec5.u0": "Hrrraaaah!",
 "s123.sec6.u0": "Haaaaaah!",
 "s123.sec7.u0": "Kyeeeeh!",
