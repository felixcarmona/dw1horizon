 ],
 "s123.sec51.u1": "Yahoooooo!",
 "s123.sec51.u2": "Gwahahaha!",
 "s123.sec51.u3": "Whoopeee!",
 "s123.sec51.u4": "Nuhahaha, desista e deixe suas coisas! Ou você vai se machucar!",
 "s123.sec51.u5": "Vocês é que deveriam desistir!",
 "s123.sec51.u6": "Huh? Vocês são...",
 "s123.sec51.u7": "Não me diga...",
 "s123.sec51.u8": "Chefe, o que faremos?",
 "s123.sec51.u9": [
  [
   "Parem de gritar! Somos mais",
