 "s103.sec5.m0.o0": "Num ginásio, talvez",
 "s103.sec5.m0.o1": "Na Arena, talvez",
 "s103.sec5.u0": "Eu cansei de treinar aqui. O que fazer?",
 "s103.sec5.u1": "O que fazer, você diz...",
 "s103.sec5.u2": "Onde você treina?",
 "s103.sec5.u3": "Um campo de treinamento, eu acho.",
 "s103.sec5.u4": "Treinar é chato. Eu quero ficar forte em lutas de verdade.",
 "s103.sec5.u5": "Treinar é chato. Eu quero ficar forte em lutas de verdade.",
 "s103.sec5.u6": "Eu vou lá. Eu treino.",
 "s103.sec5.u7": "Kabuterimon veio para a cidade!",
 "s103.sec6.u0": [
  [
   "Todo ano, no dia com dois 2,",
   "tem torneio de luta de insetos",
   "aqui. Vencedor ganha coisa",
   "incrível. Mas só Digimon"
  ],
  [
   "insetos podem entrar."
  ]
 ],
 "s103.sec6.u1": [
  [
   "Kabuterimon, Kuwagamon,",
   "Kunemon e mais um tipo de",
   "inseto. Mas Numemon não. Todo",
   "ano, no dia com dois 2, tem"
  ],
  [
   "torneio de luta de insetos",
   "aqui... Hum? Você já ganhou o",
   "torneio antes."
  ]
 ],
 "s103.sec6.u2": [
  [
   "Kabuterimon, Kuwagamon,",
   "Kunemon e mais um tipo de",
   "inseto: HerculesKabuterimon.",
   "Hércules muito forte. Vencedor"
  ],
  [
   "ganha item que faz digievoluir",
   "para Hércules. Pode entrar no",
   "torneio de insetos muitas",
   "vezes."
  ]
 ],
 "s103.sec7.m0.o0": "Pode apostar!",
 "s103.sec7.m0.o1": "Não, obrigado",
 "s103.sec7.u0": "Você é forte. Nada para eu te ensinar.",
 "s103.sec7.u1": [
  [
   "Estudamos técnicas. Técnicas fortes, difíceis",
   "de aprender."
  ],
  [
   "Se você tem habilidade, talvez aprenda",
   "técnica. Quer técnica forte?"
  ]
 ],
 "s103.sec7.u2": "Então nós tentamos.",
 "s103.sec7.u3": [
  [
   "Sua Defesa não é suficiente.",
   "Treine mais."
  ]
 ],
 "s103.sec7.u4": [
  [
   "Sua Velocidade não é",
   "suficiente. Treine mais."
  ]
 ],
 "s103.sec7.u5": [
  [
   "Seu HP não é suficiente.",
   "Treine mais."
  ]
 ],
 "s103.sec7.u6": "Você aprendeu a técnica.",
 "s103.sec7.u7": [
  [
   "Aprendeu Inseto!"
  ]
 ],
