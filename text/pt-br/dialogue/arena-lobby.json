 "s168.sec53.u0": "Calma aí, esses são os assentos do público.",
 "s168.sec82.m0.o0": "Histórico",
 "s168.sec82.m0.o1": "Sobre torneios de classe",
 "s168.sec82.m0.o2": "Sobre torneios especiais",
 "s168.sec82.u0": "Informações da Arena",
 "s168.sec82.u1": [
  [
   "Torneios vencidos:",
   "{cupswon} {wins}",
   "vitórias {losses} derrotas"
  ]
 ],
 "s168.sec82.u2": [
  [
   "Qualquer Digimon pode",
   "participar dos frequentes",
   "torneios de classe. Evite",
   "inscrever um muito acima do"
  ],
  [
   "nível do torneio. Se o Digimon",
   "mudar de espécie entre a",
   "inscrição e o torneio, a",
   "inscrição será cancelada."
  ]
 ],
 "s168.sec82.u3": [
  [
   "Torneios especiais têm",
   "requisitos de entrada e são",
   "raros. Se não houver Digimon",
   "suficientes na cidade que"
  ],
  [
   "cumpram as condições, eles nem",
   "acontecem. Cada um ocorre só",
   "uma ou duas vezes por ano.",
   "Consulte a programação com"
  ],
  [
   "antecedência."
  ]
 ],
