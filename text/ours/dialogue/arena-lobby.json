 "s168.sec82.u2": [
  [
   "Anyone may enter the grade tournaments,",
   "which are held often."
  ],
  [
   "However, please avoid entering a Digimon far",
   "above a tournament's level."
  ],
  [
   "Also, if your Digimon has changed species",
   "between entry and the tournament, its entry",
   "is cancelled."
  ]
 ],
 "s168.sec82.u3": "Special tournaments have set entry rules and are held only rarely. If there are not enough eligible members in the city, they are not held at all. Each one is held only once or twice a year, so check the schedule well in advance.",
