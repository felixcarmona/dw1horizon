// Who stands on screen 150 (Toy Mansion), and when. Read out of MAPHEAD.SCN section 150 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(150) {                              // Toy Mansion
            npc Clearagumon slot 0 autotalk;
            npc Clearagumon slot 1 autotalk;
            npc Clearagumon slot 2 autotalk;
        }
    }
}
