// Who stands on screen 69 (Gear Savanna), and when. Read out of MAPHEAD.SCN section 69 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(69) {                              // Gear Savanna
            npc Shimaunimon slot 0 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Shimaunimon slot 1 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Tsukaimon slot 2 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Nisedrimogemon slot 3 autotalk when clock.hour <= 6 or clock.hour >= 19;
        }
    }
}
