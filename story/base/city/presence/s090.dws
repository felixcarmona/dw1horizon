// Who stands on screen 90 (Freezeland), and when. Read out of MAPHEAD.SCN section 90 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(90) {                              // Freezeland
            npc Snowagumon slot 0 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Snowagumon slot 1 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Snowgoblimon slot 2 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Snowgoblimon slot 3 autotalk when clock.hour <= 6 or clock.hour >= 19;
        }
    }
}
