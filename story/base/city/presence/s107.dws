// Who stands on screen 107 (Beetle Land), and when. Read out of MAPHEAD.SCN section 107 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(107) {                              // Beetle Land
            npc 141 slot 0 when not recruited(Kabuterimon);
            npc 141 slot 1;
            npc 141 slot 2;
        }
    }
}
