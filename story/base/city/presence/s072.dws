// Who stands on screen 72 (Gear Savanna), and when. Read out of MAPHEAD.SCN section 72 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(72) {                              // Gear Savanna
            npc 151 slot 0 autotalk when not recruited(Patamon);
            npc Shimaunimon slot 1 autotalk when recruited(Patamon) and clock.hour >= 7 and clock.hour <= 18;
            npc Shamamon slot 2 autotalk when recruited(Patamon) and clock.hour >= 7 and clock.hour <= 18;
            npc Shamamon slot 3 autotalk when recruited(Patamon) and clock.hour <= 6 or recruited(Patamon) and clock.hour >= 19;
            npc Shamamon slot 4 autotalk when recruited(Patamon) and clock.hour <= 6 or recruited(Patamon) and clock.hour >= 19;
        }
    }
}
