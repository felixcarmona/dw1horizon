// Who stands on screen 67 (Underground Lab), and when. Read out of MAPHEAD.SCN section 67 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(67) {                              // Underground Lab
            npc 177 slot 0 when not trigger(129);
            npc 157 slot 1 when not trigger(129);
        }
    }
}
