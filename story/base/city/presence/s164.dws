// Who stands on screen 164 (Trash Mountain), and when. Read out of MAPHEAD.SCN section 164 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(164) {                              // Trash Mountain
            npc Psychemon slot 0 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Geremon slot 1 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Geremon slot 2 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Geremon slot 3 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Psychemon slot 4 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Psychemon slot 5 autotalk when clock.hour <= 6 or clock.hour >= 19;
        }
    }
}
