// Who stands on screen 12 (Tropical Jungle), and when. Read out of MAPHEAD.SCN section 12 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(12) {                              // Tropical Jungle
            npc 173 slot 0 autotalk when not recruited(Piximon) and roll(1) <= 2;
            npc Muchomon slot 1 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Muchomon slot 2 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc 78 slot 3 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc 78 slot 4 autotalk when clock.hour <= 6 or clock.hour >= 19;
        }
    }
}
