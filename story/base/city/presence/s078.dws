// Who stands on screen 78 (Gear Savanna), and when. Read out of MAPHEAD.SCN section 78 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(78) {                              // Gear Savanna
            npc 166 slot 0 autotalk when trigger(196) and not recruited(Leomon);
        }
    }
}
