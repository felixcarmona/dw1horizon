// Who stands on screen 137 (Freezeland), and when. Read out of MAPHEAD.SCN section 137 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(137) {                              // Freezeland
            npc 145 slot 0 when not recruited(Frigimon);
        }
    }
}
