// Who stands on screen 9 (Digimon Bridge), and when. Read out of MAPHEAD.SCN section 9 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(9) {                              // Digimon Bridge
            npc Aruraumon slot 0 autotalk when not recruited(Etemon) and recruited(Ninjamon) and clock.hour >= 7 and clock.hour <= 18;
            npc Tsukaimon slot 2 autotalk when not recruited(Etemon) and recruited(Ninjamon) and clock.hour <= 6 or not recruited(Etemon) and recruited(Ninjamon) and clock.hour >= 19;
            npc 162 slot 3 when recruited(Etemon) and recruited(Ninjamon);
        }
    }
}
