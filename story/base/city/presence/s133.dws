// Who stands on screen 133 (Freezeland), and when. Read out of MAPHEAD.SCN section 133 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(133) {                              // Freezeland
            npc 170 slot 0 when not trigger(108);
            npc 170 slot 1 when not trigger(109);
        }
    }
}
