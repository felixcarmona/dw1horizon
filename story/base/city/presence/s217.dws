        screen(217) {                              // Secret Item Shop
            let r1 = recruited(Ninjamon);
            let r2 = not recruited(Ninjamon) or r1;
            let r3 = r2 and not (recruited(Numemon) and not trigger(70)) and not (recruited(Mojyamon) and not trigger(71)) and not (recruited(Mamemon) and not trigger(72)) and not (recruited(Devimon) and not trigger(73)) and not (trigger(70) and clock.hour >= 0 and clock.hour < 6) and not (trigger(71) and clock.hour >= 6 and clock.hour < 12) and not (trigger(72) and clock.hour >= 12 and clock.hour < 18) and not (trigger(73) and clock.hour >= 18) and not recruited(Numemon) and not recruited(Mojyamon) and not recruited(Mamemon) and recruited(Devimon);
