            let r6 = r2 and not (recruited(Numemon) and not trigger(70)) and not (recruited(Mojyamon) and not trigger(71)) and not (recruited(Mamemon) and not trigger(72)) and not (recruited(Devimon) and not trigger(73)) and not (trigger(70) and clock.hour >= 0 and clock.hour < 6) and not (trigger(71) and clock.hour >= 6 and clock.hour < 12) and not (trigger(72) and clock.hour >= 12 and clock.hour < 18) and not (trigger(73) and clock.hour >= 18) and recruited(Numemon);
            let r7 = r2 and not (recruited(Numemon) and not trigger(70)) and not (recruited(Mojyamon) and not trigger(71)) and not (recruited(Mamemon) and not trigger(72)) and not (recruited(Devimon) and not trigger(73)) and not (trigger(70) and clock.hour >= 0 and clock.hour < 6) and not (trigger(71) and clock.hour >= 6 and clock.hour < 12) and not (trigger(72) and clock.hour >= 12 and clock.hour < 18) and trigger(73) and clock.hour >= 18;
            let r8 = r2 and not (recruited(Numemon) and not trigger(70)) and not (recruited(Mojyamon) and not trigger(71)) and not (recruited(Mamemon) and not trigger(72)) and not (recruited(Devimon) and not trigger(73)) and not (trigger(70) and clock.hour >= 0 and clock.hour < 6) and not (trigger(71) and clock.hour >= 6 and clock.hour < 12) and trigger(72) and clock.hour >= 12 and clock.hour < 18;
            let r9 = r2 and not (recruited(Numemon) and not trigger(70)) and not (recruited(Mojyamon) and not trigger(71)) and not (recruited(Mamemon) and not trigger(72)) and not (recruited(Devimon) and not trigger(73)) and not (trigger(70) and clock.hour >= 0 and clock.hour < 6) and trigger(71) and clock.hour >= 6 and clock.hour < 12;
            let r10 = r2 and not (recruited(Numemon) and not trigger(70)) and not (recruited(Mojyamon) and not trigger(71)) and not (recruited(Mamemon) and not trigger(72)) and not (recruited(Devimon) and not trigger(73)) and trigger(70) and clock.hour >= 0 and clock.hour < 6;
