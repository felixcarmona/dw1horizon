// Who stands on screen 47 (Ogre Fortress), and when. Read out of MAPHEAD.SCN section 47 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(47) {                              // Ogre Fortress
            npc Agumon slot 0 autotalk when not trigger(175) and pstat(16) <= 2 or not trigger(175) and pstat(16) >= 4;
            npc Agumon slot 1 autotalk when not trigger(175) and pstat(16) <= 2 or not trigger(175) and pstat(16) >= 4;
            npc Agumon slot 2 autotalk when not trigger(175) and pstat(16) <= 2 or not trigger(175) and pstat(16) >= 4;
            npc Machinedramon slot 3 autotalk when pstat(16) == 3;
            npc Analogman slot 4 autotalk when pstat(16) == 3;
        }
    }
}
