// Who stands on screen 49 (Monochrome Shop), and when. Read out of MAPHEAD.SCN section 49 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(49) {                              // Monochrome Shop
            npc 165 slot 0 when not recruited(Monochromon);
        }
    }
}
