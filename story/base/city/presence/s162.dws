// Who stands on screen 162 (Factorial Town), and when. Read out of MAPHEAD.SCN section 162 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(162) {                              // Factorial Town
            npc Guardromon slot 0;
            npc Guardromon slot 1 autotalk;
            npc Guardromon slot 2 autotalk;
        }
    }
}
