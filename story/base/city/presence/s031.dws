// Who stands on screen 31 (Lava Cave), and when. Read out of MAPHEAD.SCN section 31 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(31) {                              // Lava Cave
            npc 133 slot 0 autotalk when not recruited(Meramon);
        }
    }
}
