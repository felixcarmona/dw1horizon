// Who stands on screen 138 (Geko Swamp), and when. Read out of MAPHEAD.SCN section 138 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(138) {                              // Geko Swamp
            npc Yanmamon slot 0 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Yanmamon slot 1 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Yanmamon slot 2 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Gekomon slot 3 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Gekomon slot 4 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Gekomon slot 5 autotalk when clock.hour <= 6 or clock.hour >= 19;
        }
    }
}
