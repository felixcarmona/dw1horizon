// Who stands on screen 105 (Beetle Land), and when. Read out of MAPHEAD.SCN section 105 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(105) {                              // Beetle Land
            npc Tentomon slot 0 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Tentomon slot 1 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Tentomon slot 2 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Dokunemon slot 3 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Dokunemon slot 4 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Dokunemon slot 5 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Tentomon slot 6 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Tentomon slot 7 autotalk when clock.hour <= 6 or clock.hour >= 19;
        }
    }
}
