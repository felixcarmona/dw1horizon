// Who stands on screen 159 (Factorial Town), and when. Read out of MAPHEAD.SCN section 159 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(159) {                              // Factorial Town
            npc 161 slot 0 when not recruited(Giromon);
        }
    }
}
