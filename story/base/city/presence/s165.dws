// Who stands on screen 165 (Trash Mountain), and when. Read out of MAPHEAD.SCN section 165 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(165) {                              // Trash Mountain
            npc Kingsukamon slot 0;
            npc Sukamon slot 1;
            npc Sukamon slot 2;
            npc Sukamon slot 3;
        }
    }
}
