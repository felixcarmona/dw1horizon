// Who stands on screen 33 (Lava Cave), and when. Read out of MAPHEAD.SCN section 33 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(33) {                              // Lava Cave
            npc Demimeramon slot 0;
            npc Demimeramon slot 1;
        }
    }
}
