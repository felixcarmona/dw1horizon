// Who stands on screen 29 (Drill Tunnel 2nd floor), and when. Read out of MAPHEAD.SCN section 29 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(29) {                              // Drill Tunnel 2nd floor
            npc 158 slot 0 when not recruited(Meramon);
        }
    }
}
