// Who stands on screen 112 (Green Gym), and when. Read out of MAPHEAD.SCN section 112 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(112) {                              // Green Gym
            npc Koromon slot 0;
            npc 141 slot 1 when recruited(Kabuterimon);
            npc 169 slot 2 when recruited(Kuwagamon);
        }
    }
}
