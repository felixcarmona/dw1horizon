// Who stands on screen 212 (Mt. Infinity), and when. Read out of MAPHEAD.SCN section 212 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(212) {                              // Mt. Infinity
            npc Vermilimon slot 0 autotalk;
            npc Gururumon slot 1 autotalk;
            npc Vermilimon slot 2 autotalk;
            npc Gururumon slot 4 autotalk;
        }
    }
}
