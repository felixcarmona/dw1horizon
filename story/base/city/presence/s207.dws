// Who stands on screen 207 (Birdra Transport), and when. Read out of MAPHEAD.SCN section 207 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(207) {                              // Birdra Transport
            npc 143 slot 0;
            npc 166 slot 1 when recruited(Leomon);
        }
    }
}
