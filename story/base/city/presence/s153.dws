// Who stands on screen 153 (Factorial Town), and when. Read out of MAPHEAD.SCN section 153 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(153) {                              // Factorial Town
            npc Guardromon slot 0 autotalk when recruited(Metalmamemon) and clock.hour >= 7 and clock.hour <= 18 or clock.hour >= 7 and clock.hour <= 18 and roll(1) >= 3;
            npc Guardromon slot 1 autotalk when recruited(Metalmamemon) and clock.hour >= 7 and clock.hour <= 18 or clock.hour >= 7 and clock.hour <= 18 and roll(1) >= 3;
            npc Geremon slot 2 autotalk when recruited(Metalmamemon) and clock.hour <= 6 or recruited(Metalmamemon) and clock.hour >= 19 or clock.hour <= 6 and roll(1) >= 3 or clock.hour >= 19 and roll(1) >= 3;
            npc Geremon slot 3 autotalk when recruited(Metalmamemon) and clock.hour <= 6 or recruited(Metalmamemon) and clock.hour >= 19 or clock.hour <= 6 and roll(1) >= 3 or clock.hour >= 19 and roll(1) >= 3;
            npc 149 slot 4 autotalk when not recruited(Metalmamemon) and roll(1) <= 2;
        }
    }
}
