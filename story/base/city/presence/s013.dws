// Who stands on screen 13 (Tropical Jungle), and when. Read out of MAPHEAD.SCN section 13 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(13) {                              // Tropical Jungle
            npc Yanmamon slot 0 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Yanmamon slot 1 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Yanmamon slot 2 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Tsukaimon slot 3 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc 78 slot 4 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc 78 slot 5 autotalk when clock.hour <= 6 or clock.hour >= 19;
        }
    }
}
