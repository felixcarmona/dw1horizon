// Who stands on screen 222 (Mt. Infinity), and when. Read out of MAPHEAD.SCN section 222 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(222) {                              // Mt. Infinity
            npc 136 slot 0 autotalk when not trigger(326);
        }
    }
}
