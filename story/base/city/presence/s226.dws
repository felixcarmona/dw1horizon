// Who stands on screen 226 (Back Dimension), and when. Read out of MAPHEAD.SCN section 226 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(226) {                              // Back Dimension
            npc Piddomon slot 0 autotalk;
            npc Piddomon slot 1 autotalk;
            npc Icedevimon slot 2 autotalk;
            npc Icedevimon slot 3 autotalk;
        }
    }
}
