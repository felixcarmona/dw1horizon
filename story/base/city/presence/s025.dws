// Who stands on screen 25 (Drill Tunnel 2nd floor), and when. Read out of MAPHEAD.SCN section 25 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(25) {                              // Drill Tunnel 2nd floor
            npc Goblimon slot 0 autotalk when not trigger(150) or recruited(Ogremon);
            npc Goblimon slot 1 autotalk when not trigger(150) or recruited(Ogremon);
            npc Goblimon slot 2 autotalk when not trigger(150) or recruited(Ogremon);
            npc 154 slot 3 when trigger(150) and not recruited(Ogremon);
            npc Agumon slot 4 when trigger(150) and not recruited(Ogremon);
            npc Agumon slot 5 when trigger(150) and not recruited(Ogremon);
        }
    }
}
