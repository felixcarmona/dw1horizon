// Who stands on screen 236 (File City), and when. Read out of MAPHEAD.SCN section 236 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(236) {                              // File City
            npc Jijimon slot 0;
            npc 129 slot 1;
            npc 131 slot 2;
        }
    }
}
