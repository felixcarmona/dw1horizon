// Who stands on screen 76 (Gear Savanna), and when. Read out of MAPHEAD.SCN section 76 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(76) {                              // Gear Savanna
            npc Shamamon slot 3 autotalk when trigger(196);
            npc Shamamon slot 4 autotalk when trigger(196);
        }
    }
}
