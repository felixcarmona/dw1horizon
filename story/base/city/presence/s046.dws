// Who stands on screen 46 (Ogre Fortress), and when. Read out of MAPHEAD.SCN section 46 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(46) {                              // Ogre Fortress
            npc 139 slot 0 autotalk when not trigger(175);
            npc 139 slot 1 autotalk when not trigger(175);
            npc Agumon slot 2 autotalk when not trigger(175);
        }
    }
}
