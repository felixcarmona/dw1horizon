// Who stands on screen 79 (Ancient Dino Region), and when. Read out of MAPHEAD.SCN section 79 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(79) {                              // Ancient Dino Region
            npc 132 slot 0 autotalk when not trigger(144);
            npc Vermilimon slot 1 autotalk when trigger(144) and clock.hour >= 7 and clock.hour <= 18;
            npc Vermilimon slot 2 autotalk when trigger(144) and clock.hour >= 7 and clock.hour <= 18;
            npc Yanmamon slot 3 autotalk when trigger(144) and clock.hour <= 6 or trigger(144) and clock.hour >= 19;
            npc Yanmamon slot 4 autotalk when trigger(144) and clock.hour <= 6 or trigger(144) and clock.hour >= 19;
        }
    }
}
