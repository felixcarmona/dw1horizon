// Who stands on screen 20 (Path Thru Mt. Panorama), and when. Read out of MAPHEAD.SCN section 20 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(20) {                              // Path Thru Mt. Panorama
            npc Gotsumon slot 0 autotalk;
            npc Goblimon slot 1 autotalk;
            npc Gotsumon slot 2 autotalk;
            npc Goblimon slot 3 autotalk;
        }
    }
}
