// Who stands on screen 75 (Gear Savanna), and when. Read out of MAPHEAD.SCN section 75 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(75) {                              // Gear Savanna
            npc Psychemon slot 2 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Psychemon slot 3 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Shamamon slot 4 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Shamamon slot 5 autotalk when clock.hour <= 6 or clock.hour >= 19;
        }
    }
}
