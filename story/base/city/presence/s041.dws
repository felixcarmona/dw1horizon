// Who stands on screen 41 (Great Canyon Bot. Area), and when. Read out of MAPHEAD.SCN section 41 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(41) {                              // Great Canyon Bot. Area
            npc Muchomon slot 0 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Muchomon slot 1 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Weedmon slot 2 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Weedmon slot 3 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Weedmon slot 4 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Goblimon slot 5 autotalk when clock.hour <= 6 or clock.hour >= 19;
        }
    }
}
