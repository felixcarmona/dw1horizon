// Who stands on screen 218 (Jijimon's house), and when. Read out of MAPHEAD.SCN section 218 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(218) {                              // Jijimon's house
            npc Jijimon slot 0;
            npc Tokomon slot 1;
            npc Botamon slot 2;
        }
    }
}
