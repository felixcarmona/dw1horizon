// Who stands on screen 0 (Native Forest), and when. Read out of MAPHEAD.SCN section 0 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(0) {                              // Native Forest
            npc Modokibetamon slot 0 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Modokibetamon slot 1 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Redvegiemon slot 2 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Redvegiemon slot 3 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Modokibetamon slot 4 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Dokunemon slot 5 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Dokunemon slot 6 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Dokunemon slot 7 autotalk when clock.hour <= 6 or clock.hour >= 19;
        }
    }
}
