// Who stands on screen 227 (Back Dimension), and when. Read out of MAPHEAD.SCN section 227 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(227) {                              // Back Dimension
            npc Tekkamon slot 0 autotalk;
            npc Tekkamon slot 1 autotalk;
            npc Bluemeramon slot 2 autotalk;
            npc Bluemeramon slot 3 autotalk;
        }
    }
}
