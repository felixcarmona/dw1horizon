// Who stands on screen 135 (Freezeland), and when. Read out of MAPHEAD.SCN section 135 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(135) {                              // Freezeland
            npc Snowgoblimon slot 0 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc 146 slot 1 when trigger(175) and not recruited(Whamon);
            npc Icedevimon slot 2 autotalk when clock.hour <= 6 or clock.hour >= 19;
        }
    }
}
