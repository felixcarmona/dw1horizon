// Who stands on screen 100 (Ice Sanctuary), and when. Read out of MAPHEAD.SCN section 100 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(100) {                              // Ice Sanctuary
            npc Hyogamon slot 0 autotalk;
            npc Hyogamon slot 1 autotalk;
            npc Gururumon slot 2 autotalk;
        }
    }
}
