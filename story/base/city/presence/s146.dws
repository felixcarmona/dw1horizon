// Who stands on screen 146 (Robot House), and when. Read out of MAPHEAD.SCN section 146 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(146) {                              // Robot House
            npc Tinmon slot 0;
            npc Tinmon slot 2;
            npc Tinmon slot 3;
        }
    }
}
