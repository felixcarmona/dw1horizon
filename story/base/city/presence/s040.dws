// Who stands on screen 40 (Fortress Entrance), and when. Read out of MAPHEAD.SCN section 40 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(40) {                              // Fortress Entrance
            npc Agumon slot 0 when not recruited(0);
        }
    }
}
