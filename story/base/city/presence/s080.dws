// Who stands on screen 80 (Ancient Glacial Region), and when. Read out of MAPHEAD.SCN section 80 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(80) {                              // Ancient Glacial Region
            npc Vermilimon slot 0 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Yanmamon slot 1 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Vermilimon slot 2 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Yanmamon slot 3 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Vermilimon slot 4 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Vermilimon slot 5 autotalk when clock.hour <= 6 or clock.hour >= 19;
        }
    }
}
