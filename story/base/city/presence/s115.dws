// Who stands on screen 115 (Misty Trees), and when. Read out of MAPHEAD.SCN section 115 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(115) {                              // Misty Trees
            npc Fugamon slot 0 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Fugamon slot 1 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Morishellmon slot 2 autotalk when clock.hour >= 7 and clock.hour <= 18;
            npc Darklizardmon slot 3 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Darklizardmon slot 4 autotalk when clock.hour <= 6 or clock.hour >= 19;
            npc Tsukaimon slot 5 autotalk when clock.hour <= 6 or clock.hour >= 19;
        }
    }
}
