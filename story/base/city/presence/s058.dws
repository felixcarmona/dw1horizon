// Who stands on screen 58 (Grey Lord's Mansion), and when. Read out of MAPHEAD.SCN section 58 by `dws city-extract`;
// `dws city-verify` proves it against the original instructions (docs/mods/city-rules.md).

city {
    presence {                                     // who is on which screen, and when (MAPHEAD setup sections, one rule per NPC)
        screen(58) {                              // Grey Lord's Mansion
            npc Tsukaimon slot 0 autotalk;
        }
    }
}
