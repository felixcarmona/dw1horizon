// Readable form of script 139 of DG.SCN, made by `dws decompile --readable`. Every event below was compiled and proven equivalent to the
// original section (control-flow bisimulation, tools/dws/flowcmp.py); sections that cannot be an event stay in the port form.
// Text is by key (text/us/dialogue.json), never the game's own words.
import "../../../../core/engine.dws";
import "../../../../core/scene.dws";
import "../../../names.dws";
script 139 {
    npc monzaemon = 5;

    // the section table, in the order of the original header
    sections 254, 5, 81;

    on enter replace {    // section 254
        monzaemon_costume_tried = false;
        store_digimon_type(partner_type);
        unless (partner_type != 14 && !is_recruited(species("Monzaemon"))) return;
        animate(monzaemon, 31);
        wait(5);
    }

    on talk(monzaemon) replace {    // section 5
        goto sec81;
    }

    on use(1) replace {    // section 81
        engine.cutscene = true;
        store_digimon_type(partner_type);
        unless (!is_recruited(species("WaruMonzaemon")) && partner_type != 14) return;
        animate(tamer, 16);
        wait(15);
        say(tamer, text("s139.sec81.u0"));
        fadeout_hud(0);
        animate(tamer, anim.idle);
        unless (!monzaemon_costume_tried) return;
        monzaemon_costume_tried = true;
        animate(monzaemon, 28);
        animate(tamer, 15);
        wait(2s);
        walk(tamer, 1079, -180);
        await tamer;
        face(tamer, monzaemon);
        wait(10);
        say(tamer, text("s139.sec81.u1"));
        fadeout_hud(0);
        if (partner_type == 11) {
            entity_walk_to_entity(partner, 0, monzaemon);
            await partner;
            face(tamer, partner);
            wait(5);
            say(tamer, text("s139.sec81.u2"));
            fadeout_hud(0);
            wait(10);
            await monzaemon;
            remove(monzaemon);
            engine.arg = 14;
            call_digimon_routine(routine("forced_evolution"));
            await narrator;
            wait(10);
            say(tamer, text("s139.sec81.u3"));
            return;
        }
        say(tamer, text("s139.sec81.u4"));
        face(tamer, partner);
        walk(partner, 900, 90);
        await partner;
        animate(partner, 25);
        wait(1s);
        animate(partner, anim.refuse);
        wait(30);
        say(tamer, text("s139.sec81.u5"));
        return;
    }
}
