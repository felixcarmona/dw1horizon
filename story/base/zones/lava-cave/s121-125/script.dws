// Readable form of script 121 of DG.SCN, made by `dws decompile --readable`. Every event below was compiled and proven equivalent to the
// original section (control-flow bisimulation, tools/dws/flowcmp.py); sections that cannot be an event stay in the port form.
// Text is by key (text/us/dialogue.json), never the game's own words.
script 121 {
    npc demimeramon = 5;

    // the section table, in the order of the original header
    sections 254, 5;

    on enter replace {    // section 254
        spawn_chest(item("S.Def.disk"), 515, 0, 1428, 3072, 679);
    }

    on talk(demimeramon) replace {    // section 5
        say(demimeramon, text("s121.sec5.u0"));
        unless (has_card(30) >= 1) return;
        choice {
            text("s121.sec5.m0.o0") => {
                say(demimeramon, text("s121.sec5.u1"));
                take_card(30);
                give_bits(1500);
                return;
            }
            text("s121.sec5.m0.o1") => {
                return;
            }
            cancel => {
                return;
            }
        }
    }
}
