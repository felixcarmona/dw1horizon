// Text is by key (text/us/dialogue.json), never the game's own words.
import "../../../names.dws";
script 133 {
    npc yanmamon0 = 5;
    npc yanmamon1 = 6;
    npc yanmamon2 = 7;
    npc gekomon3 = 8;
    npc gekomon4 = 9;
    npc gekomon5 = 10;

    // the section table, in the order of the original header
    sections 254, 5, 6, 7, 8, 9, 10;

    on enter replace {    // section 254
        store_random(random_roll, 99);
        if (random_roll <= 15) {
            spawn_item(item("Digimushrm"), 58, 71);
        }
        store_random(random_roll, 99);
        if (random_roll <= 6) {
            spawn_item(item("Digimushrm"), 32, 37);
        }
        store_random(random_roll, 99);
        if (random_roll <= 3) {
            spawn_item(item("Spiny green"), 31, 48);
        }
        store_random(random_roll, 99);
        if (random_roll <= 0) {
            spawn_item(item("Muscle Yam"), 84, 35);
        }
    }

    on talk(yanmamon0) replace {    // section 5
        say(yanmamon0, text("s133.sec5.u0"));
        battle();
        recruit(species("Yanmamon"));
    }

    on talk(yanmamon1) replace {    // section 6
        say(yanmamon1, text("s133.sec6.u0"));
        battle();
        recruit(species("Yanmamon"));
    }

    on talk(yanmamon2) replace {    // section 7
        say(yanmamon2, text("s133.sec7.u0"));
        battle();
        recruit(species("Yanmamon"));
    }

    on talk(gekomon3) replace {    // section 8
        say(gekomon3, text("s133.sec8.u0"));
        battle();
    }

    on talk(gekomon4) replace {    // section 9
        say(gekomon4, text("s133.sec9.u0"));
        battle();
    }

    on talk(gekomon5) replace {    // section 10
        say(gekomon5, text("s133.sec10.u0"));
        battle();
        return;
    }
}
