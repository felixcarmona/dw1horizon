        wait(10);
        engine.no_escape = true;
        battle(foes: [agumon0, agumon1, agumon2], escape: true);
        engine.no_escape = false;
        run(agumon0, 550, -2050);
        run(agumon1, 550, -2050);
        run(agumon2, 550, -2050);
        await agumon0;
        await agumon1;
        await agumon2;
        remove(agumon0);
        remove(agumon1);
        remove(agumon2);
