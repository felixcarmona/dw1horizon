    npc agumon2 = 7;
    npc machinedramon = 8;
    npc analogman = 9;
    npc slot5 = 10;

    // the section table, in the order of the original header
    sections 254, 5, 6, 7, 60;

    on enter replace {    // section 254
    }

    on talk(agumon0) replace {    // section 5
        say(agumon0, text("s047.sec5.u0"));
        run(agumon1, -230, 547);
