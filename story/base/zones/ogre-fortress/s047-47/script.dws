        engine.no_escape = false;
        run(agumon0, 550, -2050);
        run(agumon1, 550, -2050);
        run(agumon2, 550, -2050);
        await agumon0;
        await agumon1;
        await agumon2;
        remove(agumon0);
        remove(agumon1);
        remove(agumon2);
        camera_on(tamer, speed: 10);
        await camera;
    }

