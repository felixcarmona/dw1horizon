        battle(foes: [machinedramon]);
        walk(machinedramon, -156, 1092);
        await machinedramon;
        animate(machinedramon, 43);
        wait(2s);
        say(tamer, text("s047.sec60.u4"));
        face(tamer, machinedramon);
        await machinedramon;
