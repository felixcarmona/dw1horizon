    on step(9) replace {    // section 60
        wait(2s);
        camera_to(-200, 320, speed: 20);
        animate(tamer, 15);
        wait(1s);
        say(tamer, text("s047.sec60.u0"));
        say(analogman, text("s047.sec60.u1"));
        say(tamer, text("s047.sec60.u2"));
        await analogman;
        remove(analogman);
        wait(1s);
