    }

    on talk(yanmamon4) replace {    // section 9
        say(yanmamon4, text("s076.sec9.u0"));
        battle();
        recruit(species("Yanmamon"));
    }

    on step(0) replace {    // section 51
        if (!dino_region_guard_beaten) {
            run(tyrannomon, -421, 374);
            await tyrannomon;
            face(tyrannomon, tamer);
            face(tamer, tyrannomon);
            face(partner, tyrannomon);
            await tyrannomon;
            sound(8, 10);
            say(tyrannomon, text("s076.sec51.u0"));
            animate(tamer, 19);
            wait(15);
            say(tamer, text("s076.sec51.u1"));
            animate(tamer, anim.idle);
            sound(8, 10);
            say(tyrannomon, text("s076.sec51.u2"));
            say(tamer, text("s076.sec51.u3"));
            battle(foes: [tyrannomon]);
            walk(tamer, -97, -448);
            walk(partner, -597, -443);
            run(tyrannomon, -421, 374);
            await tamer;
            await partner;
            await tyrannomon;
            face(tamer, tyrannomon);
            face(tyrannomon, tamer);
            face(partner, tyrannomon);
            say(tyrannomon, text("s076.sec51.u4"));
            animate(tamer, 7);
            wait(15);
            say(tamer, text("s076.sec51.u5"));
            animate(tamer, anim.idle);
            say(tyrannomon, text("s076.sec51.u6"));
            say(tamer, text("s076.sec51.u7"));
            say(tyrannomon, text("s076.sec51.u8"));
            say(tamer, text("s076.sec51.u9"));
            say(tyrannomon, text("s076.sec51.u10"));
            animate(tamer, 16);
            wait(15);
            say(tamer, text("s076.sec51.u11"));
            animate(tamer, anim.idle);
            say(tyrannomon, text("s076.sec51.u12"));
            say(tamer, text("s076.sec51.u13"));
            say(tyrannomon, text("s076.sec51.u14"));
            say(tamer, text("s076.sec51.u15"));
            sound(8, 10);
            say(tyrannomon, text("s076.sec51.u16"));
            say(tamer, text("s076.sec51.u17"));
            say(tyrannomon, text("s076.sec51.u18"));
            dino_region_guard_beaten = true;
            walk_away(tyrannomon, -293, 1172, looks: 3);
            remove(tyrannomon);
            glances = 0;
