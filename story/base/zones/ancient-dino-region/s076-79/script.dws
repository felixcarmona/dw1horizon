    }

    on talk(vermilimon1) replace {    // section 6
        say(vermilimon1, text("s076.sec6.u0"));
        battle();
        recruit(species("Vermilimon"));
    }

    on talk(vermilimon2) replace {    // section 7
        say(vermilimon2, text("s076.sec7.u0"));
        battle();
        recruit(species("Vermilimon"));
    }

