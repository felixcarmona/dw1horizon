            unless (engine.item_did_not_fit) break;
            say(slot1, text("s206.sec12.u4"));
            engine.picker_mode = false;
            call_routine(routine("choose_item"));
            call_routine(routine("remove_all_chosen_item"));
        }
        say(narrator, text("s206.sec12.u5"));
