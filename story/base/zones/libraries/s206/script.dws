        say(slot1, text("s206.sec10.u3"));
        say(tamer, text("s206.sec10.u4"));
        say(slot1, text("s206.sec10.u5"));
        walk_away(slot1, -105, 1821, looks: 3);
        join_city_camera(slot1, species("Penguinmon"), 8, 11, text("s206.sec10.u6"));
    }

    on talk(slot6) replace {    // section 11
        if (curling_result == 0) {
            say(slot1, text("s206.sec11.u0"));
            return;
        }
        if (curling_result == 2) {
            say(slot1, text("s206.sec11.u1"));
