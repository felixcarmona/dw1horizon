        say(slot1, text("s206.sec12.u3"));
        store_random(prize_roll, 49);
        loop {
            if (prize_roll <= 0) {
                give_item(item("Silver ball"), 1);
                random_roll = 103;
            } else if (prize_roll <= 1) {
