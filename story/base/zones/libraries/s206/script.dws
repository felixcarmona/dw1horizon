    sections 254, 6, 10, 11, 7, 12;

    on enter replace {    // section 254
    }

    on talk(slot1) replace {    // section 6
        curling_opponent = 0;
        if (!is_recruited(species("Penguinmon")) && !penguinmon_curling_offered) {
            say(slot1, text("s206.sec6.u0"));
            say(tamer, text("s206.sec6.u1"));
            say(slot1, text("s206.sec6.u2"));
            say(tamer, text("s206.sec6.u3"));
            say(slot1, text("s206.sec6.u4"));
            say(tamer, text("s206.sec6.u5"));
            say(slot1, text("s206.sec6.u6"));
            penguinmon_curling_offered = true;
            walk(slot1, 1905, 1667);
            wait(10);
            walk(tamer, 1905, 1667);
            wait(10);
            walk(partner, 1905, 1667);
            wait(10);
            warp_to(136, 1, 255);
            return;
        }
        if (!is_recruited(species("Penguinmon"))) {
            say(slot1, text("s206.sec6.u7"));
            choice {
                text("s206.sec6.m0.o0") => {}
                text("s206.sec6.m0.o1") => {
                    curling_match_pending = 0;
                    say(slot1, text("s206.sec6.u10"));
                    return;
                }
                cancel => {
                    return;
                }
            }
        } else {
            if (!curling_rink_intro_seen) {
                curling_rink_intro_seen = true;
                say(slot1, text("s206.sec6.u8"));
            }
            curling_opponent = 0;
            say(slot1, text("s206.sec6.u9"));
            choice {
                text("s206.sec6.m1.o0") => {}
                text("s206.sec6.m1.o1") => {
                    curling_match_pending = 0;
                    say(slot1, text("s206.sec6.u10"));
                    return;
                }
                cancel => {
                    return;
                }
            }
        }
        say(slot1, text("s206.sec6.u11"));
        engine.picker_mode = true;
        call_routine(routine("choose_item"));
        if (engine.picker_mode) {
            say(tamer, text("s206.sec6.u12"));
        } else {
            if (engine.arg in [item("Digianchovy"), item("Digisnapper"), item("DigiTrout"), item("Black trout")]) {
                call_routine(routine("remove_chosen_item"));
            } else if (engine.arg in [item("Digicatfish"), item("Digiseabass")]) {
                call_routine(routine("remove_chosen_item"));
            } else {
                if (engine.arg != 255) {
                    say(tamer, text("s206.sec6.u13"));
                }
                curling_match_pending = 0;
                say(slot1, text("s206.sec6.u15"));
                return;
            }
            say(slot1, text("s206.sec6.u14"));
            warp_to(136, 1, 255);
            return;
        }
        curling_match_pending = 0;
        say(slot1, text("s206.sec6.u15"));
    }

    on talk(slot5) replace {    // section 10
        if (curling_result == 0) {
            say(slot1, text("s206.sec10.u0"));
            return;
        }
        if (curling_result == 2) {
            say(slot1, text("s206.sec10.u1"));
            if (!medal.perfect_curling) {
                medal.perfect_curling = true;
