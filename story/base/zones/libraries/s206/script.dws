                random_roll = 104;
            } else if (prize_roll <= 2) {
                give_item(item("Chainsaw"), 1);
                random_roll = 105;
            } else if (prize_roll <= 3) {
                give_item(item("Small spear"), 1);
                random_roll = 106;
            } else if (prize_roll <= 11) {
