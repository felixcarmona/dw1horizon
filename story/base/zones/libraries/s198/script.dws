// Text is by key (text/us/dialogue.json), never the game's own words.
import "../../../../core/engine.dws";
import "../../../../core/scene.dws";
script 198 {
    npc piddomon0 = 5;
    npc gururumon1 = 6;
    npc piddomon2 = 7;
    npc gururumon3 = 8;
    npc piddomon4 = 9;
    npc gururumon5 = 10;
    npc megadramon = 11;

    // the section table, in the order of the original header
    sections 254, 51, 52, 5, 6, 7, 8, 9, 10, 53;

    on enter replace {    // section 254
        spawn_chest(item("HP Chip"), -373, 0, 4348, 0, 690);
        spawn_chest(item("MP Chip"), 384, 0, 4392, 0, 691);
    }

    on step(0) replace {    // section 51
        walk(tamer, -2748, 3453);
        warp_to(222, 0, 255);
    }

    on step(1) replace {    // section 52
        walk(tamer, 2801, 3497);
        warp_to(253, 1, 255);
    }

    on talk(piddomon0) replace {    // section 5
        say(piddomon0, text("s198.sec5.u0"));
        battle();
        recruit(species("Piddomon"));
    }

    on talk(gururumon1) replace {    // section 6
        say(gururumon1, text("s198.sec6.u0"));
        battle();
        recruit(species("Gururumon"));
    }

    on talk(piddomon2) replace {    // section 7
        say(piddomon2, text("s198.sec7.u0"));
        battle();
        recruit(species("Piddomon"));
    }

    on talk(gururumon3) replace {    // section 8
        say(gururumon3, text("s198.sec8.u0"));
        battle();
        recruit(species("Gururumon"));
    }

    on talk(piddomon4) replace {    // section 9
        say(piddomon4, text("s198.sec9.u0"));
        battle();
        recruit(species("Piddomon"));
    }

    on talk(gururumon5) replace {    // section 10
        say(gururumon5, text("s198.sec10.u0"));
        battle();
        recruit(species("Gururumon"));
    }

    on step(2) replace {    // section 53
        unless (!is_recruited(species("Megadramon"))) return;
        face(tamer, megadramon);
        wait(5);
        say(tamer, text("s198.sec53.u0"));
        say(megadramon, text("s198.sec53.u1"));
        say(tamer, text("s198.sec53.u2"));
        say(megadramon, text("s198.sec53.u3"));
        say(tamer, text("s198.sec53.u4"));
        choice {
            text("s198.sec53.m0.o0") => {
                run(tamer, 43, 1754, camera: true);
                await tamer;
                return;
            }
            text("s198.sec53.m0.o1") or cancel => {
                say(tamer, text("s198.sec53.u5"));
                battle(foes: [megadramon]);
                face(tamer, megadramon);
                face(megadramon, tamer);
                face(partner, megadramon);
                say(megadramon, text("s198.sec53.u6"));
                walk_away(megadramon, 0, 0, looks: 3);
                remove(megadramon);
                glances = 0;
                say(tamer, text("s198.sec53.u7"));
                recruit(species("Megadramon"));
                engine.prosperity += 3;
                camera_on(tamer, speed: 15);
                await camera;
                return;
            }
        }
    }
}
