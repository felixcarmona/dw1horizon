            say(narrator, text("s039.sec51.u2"));
            wait(10);
            say(tamer, text("s039.sec51.u3"));
            wait(10);
            say(narrator, text("s039.sec51.u4"));
            wait(10);
            say(tamer, text("s039.sec51.u5"));
            wait(10);
            sound(8, 11);
            say(narrator, text("s039.sec51.u6"));
            wait(10);
            animate(tamer, 16);
            wait(15);
            say(tamer, text("s039.sec51.u7"));
            animate(tamer, anim.idle);
            wait(10);
            say(narrator, text("s039.sec51.u8"));
            wait(10);
            say(tamer, text("s039.sec51.u9"));
            wait(10);
            sound(8, 11);
            say(narrator, text("s039.sec51.u10"));
            wait(10);
            shellmon_plea_heard = true;
            return;
