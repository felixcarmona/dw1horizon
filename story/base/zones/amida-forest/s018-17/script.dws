        store_random(random_roll, 99);
        if (random_roll <= 29) {
            spawn_item(item("Giant Meat"), 33, 49);
        } else if (random_roll <= 49) {
            spawn_item(item("Off. Disk"), 33, 49);
        }
        store_random(random_roll, 99);
        if (random_roll <= 29) {
            spawn_item(item("MP Floppy"), 49, 53);
        } else if (random_roll <= 49) {
            spawn_item(item("sm.recovery"), 49, 53);
        }
        store_random(random_roll, 99);
