            spawn_item(item("Def. Disk"), 67, 42);
        } else if (random_roll <= 49) {
            spawn_item(item("Meat"), 67, 42);
        }
        store_random(random_roll, 99);
        if (random_roll <= 9) {
            spawn_item(item("Port. potty"), 34, 29);
        } else if (random_roll <= 29) {
            spawn_item(item("Hispeed dsk"), 34, 29);
        }
        store_random(random_roll, 99);
        if (random_roll <= 9) {
            spawn_item(item("med.recovery"), 50, 34);
        } else if (random_roll <= 29) {
            spawn_item(item("Moldy Meat"), 50, 34);
        }
        store_random(random_roll, 99);
        if (random_roll <= 1) {
            spawn_item(item("Orange bana"), 49, 18);
        } else if (random_roll <= 9) {
            spawn_item(item("Happymushrm"), 49, 18);
        } else if (random_roll <= 29) {
            spawn_item(item("Auto Pilot"), 49, 18);
        }
        store_random(random_roll, 99);
        if (random_roll <= 4) {
            spawn_item(item("Omni Disk"), 65, 22);
            return;
        }
        if (random_roll <= 29) {
            spawn_item(item("Medium MP"), 65, 22);
        }
    }

