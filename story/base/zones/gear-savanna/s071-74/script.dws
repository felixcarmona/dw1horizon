import "../../../../core/engine.dws";
import "../../../../core/scene.dws";
import "../../../../core/recruit.dws";
import "../../../names.dws";
script 71 {
    npc psychemon0 = 5;
    npc psychemon1 = 6;
    npc akatorimon = 7;
    npc tsukaimon3 = 8;
    npc tsukaimon4 = 9;
    npc shamamon = 10;
    sections 254, 5, 6, 7, 8, 9, 10, 81, 82;
    on enter replace {    // enter
        store_random(random_roll, 99);
        if (random_roll <= 11) {
            spawn_item(item(44), 68, 50);
        }
        store_random(random_roll, 99);
        if (random_roll <= 17) {
            spawn_item(item(44), 46, 29);
        }
        store_random(random_roll, 99);
        if (random_roll <= 3) {
            spawn_item(item(52), 46, 73);
        }
        store_random(random_roll, 99);
        if (random_roll <= 0) {
            spawn_item(item(70), 57, 83);
        }
    }
    on talk(psychemon0) replace {    // talk
        say(psychemon0, text("s071.sec5.u0"));
        battle();
        recruit(species(82));
    }
    on talk(psychemon1) replace {    // talk
        say(psychemon1, text("s071.sec6.u0"));
        battle();
        recruit(species(82));
    }
    on talk(akatorimon) replace {    // talk
        say(akatorimon, text("s071.sec7.u0"));
        battle();
        recruit(species(95));
    }
    on talk(tsukaimon3) replace {    // talk
        say(tsukaimon3, text("s071.sec8.u0"));
        battle();
        recruit(species(96));
    }
    on talk(tsukaimon4) replace {    // talk
        say(tsukaimon4, text("s071.sec9.u0"));
        battle();
        recruit(species(96));
    }
    on talk(shamamon) replace {    // talk
        say(shamamon, text("s071.sec10.u0"));
        battle();
        recruit(species(97));
    }
    on use(1) replace {    // use1
        rotate(tamer, 1536);
        loop {
            say(narrator, text("s071.sec81.vend_prompt"));
            choice {
                text("s071.sec81.vend_buy0") => {
                    if (bits < 118) {
                        say(narrator, text("s071.sec81.vend_poor"));
                        return;
                    }
                    give(item(0));
                    if (engine.item_did_not_fit) {
                        say(narrator, text("s071.sec81.vend_full"));
                        return;
                    }
                    take_bits(118);
                    say(narrator, text("s071.sec81.vend_getSmRecovery"));
                    store_random(random_roll, 99);
                    if (random_roll < 9) {
                        give(item(7));
                        if (!engine.item_did_not_fit) {
                            say(narrator, text("s071.sec81.vend_bonus"));
                        }
                    }
                    return;
                }
                text("s071.sec81.vend_buy1") => {
                    if (bits < 318) {
                        say(narrator, text("s071.sec81.vend_poor"));
                        return;
                    }
                    give(item(1));
                    if (engine.item_did_not_fit) {
                        say(narrator, text("s071.sec81.vend_full"));
                        return;
                    }
                    take_bits(318);
                    say(narrator, text("s071.sec81.vend_getMedRecovery"));
                    store_random(random_roll, 99);
                    if (random_roll < 9) {
                        give(item(7));
                        if (!engine.item_did_not_fit) {
                            say(narrator, text("s071.sec81.vend_bonus"));
                        }
                    }
                    return;
                }
                text("s071.sec81.vend_more") => {
                    say(narrator, text("s071.sec81.vend_prompt"));
                    choice {
                        text("s071.sec81.vend_buy2") => {
                            if (bits < 218) {
                                say(narrator, text("s071.sec81.vend_poor"));
                                return;
                            }
                            give(item(4));
                            if (engine.item_did_not_fit) {
                                say(narrator, text("s071.sec81.vend_full"));
                                return;
                            }
                            take_bits(218);
                            say(narrator, text("s071.sec81.vend_getMPFloppy"));
                            store_random(random_roll, 99);
                            if (random_roll < 9) {
                                give(item(7));
                                if (!engine.item_did_not_fit) {
                                    say(narrator, text("s071.sec81.vend_bonus"));
                                }
                            }
                            return;
                        }
                        text("s071.sec81.vend_buy3") => {
                            if (bits < 500) {
                                say(narrator, text("s071.sec81.vend_poor"));
                                return;
                            }
                            give(item(5));
                            if (engine.item_did_not_fit) {
                                say(narrator, text("s071.sec81.vend_full"));
                                return;
                            }
                            take_bits(500);
                            say(narrator, text("s071.sec81.vend_getMediumMP"));
                            store_random(random_roll, 99);
                            if (random_roll < 9) {
                                give(item(7));
                                if (!engine.item_did_not_fit) {
                                    say(narrator, text("s071.sec81.vend_bonus"));
                                }
                            }
                            return;
                        }
                        text("s071.sec81.vend_back") => {}
                        cancel => {
                            return;
                        }
                    }
                }
                cancel => {
                    return;
                }
            }
        }
    }
    on use(2) replace {    // use2
        say(narrator, text("s071.sec82.u0"));
        rotate(tamer, 2048);
        say(tamer, text("s071.sec82.u1"));
        choice {
            text("s071.sec82.m0.o0") => {
                if (bits >= 200) {
                    add_stat(7, 100);
                    take_bits(200);
                    say(narrator, text("s071.sec82.u2"));
                } else {
                    say(tamer, text("s071.sec82.u3"));
                    return;
                }
                return;
            }
            text("s071.sec82.m0.o1") => {
                if (bits >= 1800) {
                    add_stat(7, 1000);
                    take_bits(1800);
                    say(narrator, text("s071.sec82.u4"));
                } else {
                    say(tamer, text("s071.sec82.u5"));
                    return;
                }
                return;
            }
            text("s071.sec82.m0.o2") => {}
        }
        return;
    }
}
