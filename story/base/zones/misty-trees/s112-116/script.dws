// Readable form of script 112 of DG.SCN, made by `dws decompile --readable`. Every event below was compiled and proven equivalent to the
// original section (control-flow bisimulation, tools/dws/flowcmp.py); sections that cannot be an event stay in the port form.
// Text is by key (text/us/dialogue.json), never the game's own words.
import "../../../names.dws";
script 112 {
    npc morishellmon0 = 5;
    npc morishellmon1 = 6;
    npc morishellmon2 = 7;
    npc fugamon3 = 8;
    npc fugamon4 = 9;
    npc darklizardmon5 = 10;
    npc darklizardmon6 = 11;

    // the section table, in the order of the original header
    sections 254, 5, 6, 7, 8, 9, 10, 11, 51, 52;

    on enter replace {    // section 254
        store_random(random_roll, 99);
        if (random_roll <= 11) {
            spawn_item(item("Digimushrm"), 31, 56);
        }
        store_random(random_roll, 99);
        if (random_roll <= 17) {
            spawn_item(item("Digimushrm"), 55, 52);
        }
        store_random(random_roll, 99);
        if (random_roll <= 1) {
            spawn_item(item("Happymushrm"), 40, 80);
        }
    }

    on talk(morishellmon0) replace {    // section 5
        say(morishellmon0, text("s112.sec5.u0"));
        battle();
        recruit(species("MoriShellmon"));
    }

    on talk(morishellmon1) replace {    // section 6
        say(morishellmon1, text("s112.sec6.u0"));
        battle();
        recruit(species("MoriShellmon"));
    }

    on talk(morishellmon2) replace {    // section 7
        say(morishellmon2, text("s112.sec7.u0"));
        battle();
        recruit(species("MoriShellmon"));
    }

    on talk(fugamon3) replace {    // section 8
        say(fugamon3, text("s112.sec8.u0"));
        battle();
        recruit(species("Fugamon"));
    }

    on talk(fugamon4) replace {    // section 9
        say(fugamon4, text("s112.sec9.u0"));
        battle();
        recruit(species("Fugamon"));
    }

    on talk(darklizardmon5) replace {    // section 10
        say(darklizardmon5, text("s112.sec10.u0"));
        battle();
        recruit(species("DarkLizardmon"));
    }

    on talk(darklizardmon6) replace {    // section 11
        say(darklizardmon6, text("s112.sec11.u0"));
        battle();
        recruit(species("DarkLizardmon"));
    }

    on step(0) replace {    // section 51
        walk(tamer, 2200, -2600);
        if (misty_trees_fog_spell_cast || cherrymon_met) {
            warp_to(117, 0, 255);
        }
        store_random(random_roll, 99);
        if (random_roll < 69) {
            warp_to(117, 0, 255);
            goto sec52;
        }
        warp_to(121, 0, 255);
        goto sec52;
    }

    on step(1) replace {    // section 52
        walk(tamer, 1600, 1800);
        if (misty_trees_fog_spell_cast || cherrymon_met) {
            warp_to(118, 0, 255);
        }
        store_random(random_roll, 99);
        if (random_roll < 49) {
            warp_to(118, 0, 255);
        } else {
            warp_to(121, 0, 255);
        }
        end_script();
    }
}
