// Readable form of script 113 of DG.SCN, made by `dws decompile --readable`. Every event below was compiled and proven equivalent to the
// original section (control-flow bisimulation, tools/dws/flowcmp.py); sections that cannot be an event stay in the port form.
// Text is by key (text/us/dialogue.json), never the game's own words.
import "../../../../core/engine.dws";
import "../../../../core/scene.dws";
import "../../../names.dws";
script 113 {
    npc kokatorimon = 5;
    npc goblimon1 = 6;
    npc goblimon2 = 7;
    npc goblimon3 = 8;
    npc morishellmon4 = 9;
    npc morishellmon5 = 10;
    npc goblimon6 = 11;
    npc goblimon7 = 12;

    // the section table, in the order of the original header
    sections 254, 6, 7, 8, 9, 10, 11, 12, 5, 54, 52, 51, 53;

    on enter replace {    // section 254
        store_random(random_roll, 99);
        if (random_roll <= 19) {
            spawn_item(item("Digimushrm"), 37, 84);
        }
        store_random(random_roll, 99);
        if (random_roll <= 16) {
            spawn_item(item("Digimushrm"), 33, 67);
        }
        store_random(random_roll, 99);
        if (random_roll <= 12) {
            spawn_item(item("Digimushrm"), 56, 63);
        }
        store_random(random_roll, 99);
        if (random_roll <= 2) {
            spawn_item(item("Digipine"), 56, 83);
        }
    }

    on talk(goblimon1) replace {    // section 6
        say(goblimon1, text("s113.sec6.u0"));
        battle();
        recruit(species("Goblimon"));
    }

    on talk(goblimon2) replace {    // section 7
        say(goblimon2, text("s113.sec7.u0"));
        battle();
        recruit(species("Goblimon"));
    }

    on talk(goblimon3) replace {    // section 8
        say(goblimon3, text("s113.sec8.u0"));
        battle();
        recruit(species("Goblimon"));
    }

    on talk(morishellmon4) replace {    // section 9
        say(morishellmon4, text("s113.sec9.u0"));
        battle();
        recruit(species("MoriShellmon"));
    }

    on talk(morishellmon5) replace {    // section 10
        say(morishellmon5, text("s113.sec10.u0"));
        battle();
        recruit(species("MoriShellmon"));
    }

    on talk(goblimon6) replace {    // section 11
        say(goblimon6, text("s113.sec11.u0"));
        battle();
        recruit(species("Goblimon"));
    }

    on talk(goblimon7) replace {    // section 12
        say(goblimon7, text("s113.sec12.u0"));
        battle();
        recruit(species("Goblimon"));
    }

    on talk(kokatorimon) replace {    // section 5
        sound(8, 11);
        say(kokatorimon, text("s113.sec5.u0"));
        battle(foes: [kokatorimon]);
        face(kokatorimon, tamer);
        face(tamer, kokatorimon);
        face(partner, kokatorimon);
        wait(10);
        say(kokatorimon, text("s113.sec5.u1"));
        animate(tamer, 16);
        wait(1s);
        say(tamer, text("s113.sec5.u2"));
        say(kokatorimon, text("s113.sec5.u3"));
        animate(tamer, 19);
        wait(1s);
        say(tamer, text("s113.sec5.u4"));
        say(kokatorimon, text("s113.sec5.u5"));
        animate(tamer, 7);
        wait(1s);
        say(tamer, text("s113.sec5.u6"));
        say(kokatorimon, text("s113.sec5.u7"));
        animate(tamer, 7);
        wait(1s);
        say(tamer, text("s113.sec5.u8"));
        animate(partner, 11);    // slot 11: the partner reaction in the sleep scene (partner.c:295)
        wait(5);
        say(kokatorimon, text("s113.sec5.u9"));
        fadeout_hud(0);
        walk_away(kokatorimon, -330, -2751, looks: 10, pause: 10);
        remove(kokatorimon);
        glances = 0;
        sound(8, 10);
        say(narrator, text("s113.sec5.u10"));
        animate(tamer, 16);
        wait(1s);
        say(tamer, text("s113.sec5.u11"));
        camera_on(tamer, speed: 10);
        await camera;
        recruit(species("Kokatorimon"));
        engine.prosperity += 2;
    }

    on step(3) replace {    // section 54
        animate(tamer, 24);
        wait(1s);
        say(tamer, text("s113.sec54.u0"));
    }

    on step(1) replace {    // section 52
        store_date(date_year);
        if (!misty_trees_dawn_visitor_spawned && !is_recruited(species("Kokatorimon")) && date_hour >= 4 && date_hour <= 6) {
            set_digimon(species("Devimon"), 0, 1);
            misty_trees_dawn_visitor_spawned = true;
        }
    }

    on step(0) replace {    // section 51
        walk(tamer, -2500, -2900);
        if (misty_trees_fog_spell_cast || cherrymon_met) {
            warp_to(116, 1, 255);
        }
        store_random(random_roll, 99);
        if (random_roll < 49) {
            warp_to(116, 1, 255);
            goto sec53;
        }
        warp_to(121, 2, 255);
        goto sec53;
    }

    on step(2) replace {    // section 53
        walk(tamer, 2600, -2550);
        if (misty_trees_fog_spell_cast || cherrymon_met) {
            warp_to(121, 0, 255);
        }
        store_random(random_roll, 99);
        if (random_roll < 69) {
            warp_to(121, 0, 255);
        } else {
            warp_to(116, 0, 255);
        }
        end_script();
    }
}
