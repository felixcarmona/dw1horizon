// Readable form of script 111 of DG.SCN, made by `dws decompile --readable`. Every event below was compiled and proven equivalent to the
// original section (control-flow bisimulation, tools/dws/flowcmp.py); sections that cannot be an event stay in the port form.
// Text is by key (text/us/dialogue.json), never the game's own words.
import "../../../names.dws";
script 111 {
    npc fugamon0 = 5;
    npc fugamon1 = 6;
    npc morishellmon = 7;
    npc darklizardmon3 = 8;
    npc darklizardmon4 = 9;
    npc tsukaimon = 10;

    // the section table, in the order of the original header
    sections 254, 5, 6, 7, 8, 9, 10;

    on enter replace {    // section 254
        store_random(random_roll, 99);
        if (random_roll <= 16) {
            spawn_item(item("Digimushrm"), 50, 39);
        }
        store_random(random_roll, 99);
        if (random_roll <= 4) {
            spawn_item(item("Digimushrm"), 34, 78);
        }
        store_random(random_roll, 99);
        if (random_roll <= 7) {
            spawn_item(item("Digimushrm"), 32, 41);
        }
        store_random(random_roll, 99);
        if (random_roll <= 3) {
            spawn_item(item("Happymushrm"), 49, 74);
        }
        misty_trees_visited = true;
    }

    on talk(fugamon0) replace {    // section 5
        say(fugamon0, text("s111.sec5.u0"));
        battle();
        recruit(species("Fugamon"));
    }

    on talk(fugamon1) replace {    // section 6
        say(fugamon1, text("s111.sec6.u0"));
        battle();
        recruit(species("Fugamon"));
    }

    on talk(morishellmon) replace {    // section 7
        say(morishellmon, text("s111.sec7.u0"));
        battle();
        recruit(species("MoriShellmon"));
    }

    on talk(darklizardmon3) replace {    // section 8
        say(darklizardmon3, text("s111.sec8.u0"));
        battle();
        recruit(species("DarkLizardmon"));
    }

    on talk(darklizardmon4) replace {    // section 9
        say(darklizardmon4, text("s111.sec9.u0"));
        battle();
        recruit(species("DarkLizardmon"));
    }

    on talk(tsukaimon) replace {    // section 10
        say(tsukaimon, text("s111.sec10.u0"));
        battle();
        recruit(species("Tsukaimon"));
        return;
    }
}
