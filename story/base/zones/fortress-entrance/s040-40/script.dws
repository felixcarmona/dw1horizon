// Readable form of script 40 of DG.SCN, made by `dws decompile --readable`. Every event below was compiled and proven equivalent to the
// original section (control-flow bisimulation, tools/dws/flowcmp.py); sections that cannot be an event stay in the port form.
// Text is by key (text/us/dialogue.json), never the game's own words.
import "../../../../core/scene.dws";
import "../../../names.dws";
script 40 {
    npc agumon = 5;

    // the section table, in the order of the original header
    sections 254, 5, 51;

    on enter replace {    // section 254
        store_random(random_roll, 99);
        if (random_roll <= 9) {
            spawn_item(item("Digimushrm"), 76, 78);
        }
        store_random(random_roll, 99);
        if (random_roll <= 4) {
            spawn_item(item("Digimushrm"), 31, 68);
        }
        store_random(random_roll, 99);
        if (random_roll <= 6) {
            spawn_item(item("Pricklypear"), 66, 68);
        }
        store_random(random_roll, 99);
        if (random_roll <= 2) {
            spawn_item(item("Happymushrm"), 22, 75);
        }
        rotate_3d_object(0, 0, 1);
        wait(1s);
    }

    on talk(agumon) replace {    // section 5 (partial)
        unless (fortress_guard_met || canyon_bandits_beaten) goto l1;
        unless (fortress_guard_met || !canyon_bandits_beaten) goto l4;
        unless (!fortress_guard_met || !canyon_bandits_beaten) goto l5;
        goto l6;
        l1:
        fortress_guard_met = true;
        say(agumon, text("s040.sec5.u0"));
        animate(tamer, 24);
        wait(15);
        say(tamer, text("s040.sec5.u1"));
        animate(tamer, anim.idle);
        say(agumon, text("s040.sec5.u2"));
        say(tamer, text("s040.sec5.u3"));
        say(agumon, text("s040.sec5.u4"));
        choice {
            text("s040.sec5.m0.o0") => {
                l2:
                battle(foes: [agumon]);
                say(agumon, text("s040.sec5.u5"));
                run(agumon, -356, -1058);
                wait(2s);
                run(tamer, -349, -1355);
                run(partner, -345, -1751);
                await tamer;
                await partner;
                face(tamer, agumon);
                face(partner, agumon);
                run(agumon, -250, -950);
                await agumon;
                remove(agumon);
                sound(8, 2);
                rotate_3d_object(0, 0, 255);
                wait(2s);
                sound(8, 3);
                wait(10);
                run(tamer, -350, -1145);
                run(partner, -359, -1355);
                say(tamer, text("s040.sec5.u6"));
                say(narrator, text("s040.sec5.u7"));
                say(tamer, text("s040.sec5.u8"));
                say(narrator, text("s040.sec5.u9"));
                say(tamer, text("s040.sec5.u10"));
                camera_on(tamer, speed: 10);
                await camera;
                return;
            }
            text("s040.sec5.m0.o1") => {}
        }
        l3:
        loop {
            say(tamer, text("s040.sec5.u11"));
            return;
            l4:
            say(tamer, text("s040.sec5.u12"));
            say(agumon, text("s040.sec5.u13"));
            animate(tamer, 7);
            wait(15);
            say(tamer, text("s040.sec5.u14"));
            animate(tamer, anim.idle);
            loop {
                say(agumon, text("s040.sec5.u15"));
                run(agumon, -356, -1058);
                wait(2s);
                run(tamer, -349, -1375);
                run(partner, -355, -1761);
                await tamer;
                await partner;
                face(tamer, agumon);
                face(partner, agumon);
                run(agumon, -250, -930);
                await agumon;
                remove(agumon);
                run(tamer, -250, -930);
                await tamer;
                run(partner, -250, -930);
                await partner;
                recruit(species("main character"));
                warp_to(45, 0, 255);
                l5:
                say(tamer, text("s040.sec5.u16"));
                say(agumon, text("s040.sec5.u17"));
                animate(tamer, 7);
                wait(15);
                say(tamer, text("s040.sec5.u18"));
                animate(tamer, anim.idle);
            }
            l6:
            say(tamer, text("s040.sec5.u19"));
            say(agumon, text("s040.sec5.u20"));
            set_dialog_owner(tamer);
            set_selection(l2, l3, text("s040.sec5.m1.o0"), text("s040.sec5.m1.o1"));
            end_selection();
        }
    }

    on step(0) replace {    // section 51
        if (back_dimension_portal == 3) {
            walk(tamer, -250, -250);
            warp_to(226, 0, 60);
        }
        if (is_recruited(species("main character"))) {
            walk(tamer, -250, -250);
            warp_to(45, 0, 255);
        }
        return;
    }
}
