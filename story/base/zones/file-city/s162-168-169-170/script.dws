                warp_to(182, 1, 255);
                return;
            }
            if (is_recruited(species("Centarumon"))) {
                if (is_recruited(species("Greymon"))) {
                    warp_to(187, 1, 255);
                    return;
                }
                warp_to(186, 1, 255);
                return;
