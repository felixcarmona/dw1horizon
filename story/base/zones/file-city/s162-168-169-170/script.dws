    on step(4) replace {    // section 55
        unless (is_recruited(species("Whamon"))) return;
        run(tamer, 2594, 630);
        run(partner, 2189, 545);
        await tamer;
        await partner;
        entity_set_rotation(tamer, 2128);
        entity_set_rotation(partner, 2128);
        wait(5);
        if (!whamon_ferry_explained) {
