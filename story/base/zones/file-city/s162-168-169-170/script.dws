        }
        if (engine.prosperity >= 20) {
            say(entity(204), text("s162.sec81.u2"));
            return;
        }
        if (engine.prosperity < 10) {
            say(entity(204), text("s162.sec81.u3"));
            return;
        }
        say(entity(204), text("s162.sec81.u4"));
    }

    on use(2) replace {    // section 82
