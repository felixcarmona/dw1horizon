    on talk(yuramon) replace {    // section 5
        if (!is_recruited(species("Seadramon")) && engine.prosperity >= 40 && !is_recruited(species("Whamon")) && ogre_fortress_cleared) {
            if (!is_recruited(species("Kokatorimon"))) {
                say(yuramon, text("s162.sec5.u0"));
                return;
            }
        }
        if (!is_recruited(species("Kokatorimon")) && engine.prosperity >= 25 && !is_recruited(species("Whamon")) && ogre_fortress_cleared) {
            say(yuramon, text("s162.sec5.u1"));
            return;
        }
        if (!is_recruited(species("Whamon")) && ogre_fortress_cleared) {
            say(yuramon, text("s162.sec5.u2"));
            return;
        }
        if (!ogre_fortress_cleared && canyon_bandits_beaten) {
            say(yuramon, text("s162.sec5.u3"));
            return;
        }
        if (!canyon_bandits_beaten && invisible_bridge_crossed) {
