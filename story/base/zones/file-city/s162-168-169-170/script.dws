                return;
            }
            warp_to(197, 1, 255);
            return;
        }
        if (is_recruited(species("Centarumon"))) {
            if (is_recruited(species("Greymon"))) {
                warp_to(202, 1, 255);
                return;
            }
            warp_to(201, 1, 255);
            return;
