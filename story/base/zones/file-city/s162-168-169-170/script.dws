            if (is_recruited(species("Greymon"))) {
                warp_to(188, 1, 255);
                return;
            }
            warp_to(181, 1, 255);
            return;
        }
        if (is_recruited(species("Meramon")) || is_recruited(species("Tyrannomon")) || is_recruited(species("Garurumon")) || is_recruited(species("Frigimon"))) {
            if (is_recruited(species("Centarumon"))) {
