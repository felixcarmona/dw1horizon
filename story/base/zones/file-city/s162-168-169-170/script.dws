            return;
        }
        set_obj_visibility(72, 1);
        say(narrator, text("s162.sec83.u2"));
        rain_plant_picked = true;
    }

    on step(1) replace {    // section 52
        walk(tamer, 171, -327);
        if (is_recruited(species("Angemon")) || is_recruited(species("Monzaemon")) || engine.prosperity >= 50) {
            warp_to(205, 0, 255);
            goto sec53;
