            animate(tamer, anim.offer_item);
            wait(10);
            animate(partner, 11);    // slot 11: the partner reaction in the sleep scene (partner.c:295)
            wait(2s);
            ending_homecoming_seen = true;
            camera_on(tamer, speed: 10);
            await camera;
            if (stat(21) != 10) {
                add_stat(21, 1);
                say(narrator, text("s162.sec254.u2"));
            }
            medal.ending = true;
            sound(0, 7);
            say(narrator, text("s162.sec254.u3"));
            give_card(65);
            say(narrator, text("s162.sec254.u4"));
