            damage_percent = 10;
            deal_damage(damage_percent);
            wait(15);
            run(slot5, 432, -2236);
            camera_to(410, -1474, speed: 2);
            await camera;
            run(slot5, 432, -2236);
            await slot5;
            face(tamer, slot5);
            face(partner, slot5);
            face(slot5, tamer);
