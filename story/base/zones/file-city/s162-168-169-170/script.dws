        set_textbox_origin(600, 0, 1502);
        say(entity(205), text("s162.sec82.u0"));
    }

    on use(3) replace {    // section 83
        unless (!rain_plant_picked && is_recruited(species("Palmon"))) return;
        unless (date_day == 14) return;
        say(tamer, text("s162.sec83.u0"));
        give_item(item("Rain Plant"), 1);
