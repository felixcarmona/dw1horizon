// Authored script, synchronized with script.py. Text stays in the keyed banks.
import "../../../../core/engine.dws";
import "../../../../core/scene.dws";
import "../../../../core/recruit.dws";
import "../../../names.dws";
script 26 {
    npc goblimon0 = 5;
    npc goblimon1 = 6;
    npc goblimon2 = 7;
    npc ogremon = 8;
    npc agumon4 = 9;
    npc agumon5 = 10;
    sections 254, 5, 6, 7, 9, 10, 51, 52, 53;
    on enter replace {    // enter
        call_routine(routine("load_dirt_cart"));
        if (drill_tunnel_progress == 3) {
            engine.arg = 0;
            call_routine(routine("dirt_cart_model"));
            set_autotalk(goblimon0, 0);
            set_autotalk(goblimon1, 0);
            set_autotalk(goblimon2, 0);
        }
        if (drill_tunnel_progress == 4) {
            engine.arg = 1;
            call_routine(routine("dirt_cart_model"));
            set_autotalk(goblimon0, 0);
            set_autotalk(goblimon1, 0);
            set_autotalk(goblimon2, 0);
        }
    }
    on talk(goblimon0) replace {    // talk
        if (drill_tunnel_progress >= 3) {
            say(goblimon0, text("s026.sec5.u0"));
            return;
        }
        say(goblimon0, text("s026.sec5.u1"));
        battle();
        recruit(species(80));
    }
    on talk(goblimon1) replace {    // talk
        if (drill_tunnel_progress >= 3) {
            say(goblimon1, text("s026.sec6.u0"));
            return;
        }
        say(goblimon1, text("s026.sec6.u1"));
        battle();
        recruit(species(80));
    }
    on talk(goblimon2) replace {    // talk
        if (drill_tunnel_progress >= 3) {
            say(goblimon2, text("s026.sec7.u0"));
            return;
        }
        say(goblimon2, text("s026.sec7.u1"));
        battle();
        recruit(species(80));
    }
    on talk(agumon4) replace {    // talk
        say(agumon4, text("s026.sec9.u0"));
    }
    on talk(agumon5) replace {    // talk
        say(agumon5, text("s026.sec10.u0"));
    }
    on step(0) replace {    // step0
        unless (new_ogre_fortress_cleared && !is_recruited(species(34))) return;
        walk(tamer, -165, 221, camera: true);
        walk(partner, 171, 615);
        await tamer;
        await partner;
        walk(agumon4, -323, 93);
        walk(agumon5, 498, -51);
        walk(ogremon, 160, -193);
        await goblimon0;
        await goblimon1;
        await ogremon;
        rotate(tamer, 100);
        rotate(partner, 100);
        face(agumon4, tamer);
        face(agumon5, tamer);
        face(ogremon, tamer);
        say(ogremon, text("s026.sec51.u0"));
        say(tamer, text("s026.sec51.u1"));
        say(ogremon, text("s026.sec51.u2"));
        say(tamer, text("s026.sec51.u3"));
        animate(ogremon, 32);
        say(ogremon, text("s026.sec51.u4"));
        animate(ogremon, anim.idle);
        say(tamer, text("s026.sec51.u5"));
        battle(foes: [agumon4, agumon5, ogremon]);
        walk(agumon4, -1800, 500);
        walk(agumon5, 1500, -500);
        walk(ogremon, 89, -659);
        await ogremon;
        await agumon4;
        await agumon5;
        animate(agumon4, 43);
        animate(agumon5, 43);
        rotate(ogremon, 100);
        face(tamer, ogremon);
        face(partner, ogremon);
        await ogremon;
        animate(ogremon, 28);
        wait(30);
        say(ogremon, text("s026.sec51.u6"));
        animate(ogremon, 29);
        animate(tamer, 19);
        wait(20);
        say(tamer, text("s026.sec51.u7"));
        animate(tamer, anim.idle);
        say(ogremon, text("s026.sec51.u8"));
        say(tamer, text("s026.sec51.u9"));
        say(ogremon, text("s026.sec51.u10"));
        say(tamer, text("s026.sec51.u11"));
        say(ogremon, text("s026.sec51.u12"));
        animate(tamer, 19);
        wait(15);
        say(tamer, text("s026.sec51.u13"));
        animate(tamer, anim.idle);
        say(ogremon, text("s026.sec51.u14"));
        animate(tamer, 7);
        wait(15);
        say(tamer, text("s026.sec51.u15"));
        animate(tamer, anim.idle);
        run(tamer, 150, -150, camera: true);    // Horizon: tile centre, was (160, -193)
        await tamer;
        rotate(tamer, 100);
        show_textbox(text("s026.sec51.u16"));
        say(ogremon, text("s026.sec51.u17"));
        animate(ogremon, 30);
        face(ogremon, tamer);
        say(ogremon, text("s026.sec51.u18"));
        run(ogremon, 119, -494);
        await ogremon;
        face(ogremon, tamer);
        say(tamer, text("s026.sec51.u19"));
        say(ogremon, text("s026.sec51.u20"));
        run(ogremon, 155, 873);
        if (glances < 6) {
            glances += 1;
            wait(10);
            face(tamer, ogremon);
            face(partner, ogremon);
        }
        await ogremon;
        join_city(ogremon, species(34), 8, 8, text("s026.sec51.u21"), prosperity: 2);
        camera_on(tamer, speed: 10);
        await camera;
    }
    on step(1) replace {    // step1
        if (drill_tunnel_progress == 3) {
            say(tamer, text("s026.sec52.u0"));
            run(tamer, -51, -1550);
            await tamer;
            camera_on(tamer, speed: 10);
            await camera;
            return;
        }
        if (drill_tunnel_progress == 4) {
            say(tamer, text("s026.sec52.u1"));
            run(tamer, -51, -1550);
            await tamer;
            camera_on(tamer, speed: 10);
            await camera;
            return;
        }
        if (is_recruited(species(9)) && engine.prosperity >= 45) {
            walk(tamer, -105, -2200);
            warp_to(126, 0, 255);
        }
        walk(tamer, -105, -2200);
        warp_to(26, 0, 255);
        goto sec53;
    }
    on step(2) replace {    // step2
        if (drill_tunnel_progress == 3) {
            say(tamer, text("s026.sec53.u0"));
            run(tamer, -2253, 359);
            await tamer;
            camera_on(tamer, speed: 10);
            await camera;
            return;
        }
        if (drill_tunnel_progress == 4) {
            say(tamer, text("s026.sec53.u1"));
            run(tamer, -2253, 359);
            await tamer;
            camera_on(tamer, speed: 10);
            await camera;
            return;
        }
        return;
    }
}
