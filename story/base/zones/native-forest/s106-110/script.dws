// Readable form of script 106 of DG.SCN, made by `dws decompile --readable`. Every event below was compiled and proven equivalent to the
// original section (control-flow bisimulation, tools/dws/flowcmp.py); sections that cannot be an event stay in the port form.
// Text is by key (text/us/dialogue.json), never the game's own words.
import "../../../names.dws";
script 106 {
    npc sukamon0 = 5;
    npc sukamon1 = 6;

    // the section table, in the order of the original header
    sections 254, 81, 5, 6;

    on enter replace {    // section 254
        store_random(random_roll, 99);
        if (random_roll <= 19) {
            spawn_item(item("Digimushrm"), 61, 54);
        }
        store_random(random_roll, 99);
        if (random_roll <= 4) {
            spawn_item(item("Happymushrm"), 39, 46);
        }
        store_random(random_roll, 99);
        if (random_roll <= 14) {
            spawn_item(item("Digimushrm"), 55, 63);
        }
    }

    on use(1) replace {    // section 81
        entity_set_rotation(tamer, 1536);
        say(narrator, text("s106.sec81.u0"));
    }

    on talk(sukamon0) replace {    // section 5
        say(sukamon0, text("s106.sec5.u0"));
        remove(sukamon0);
    }

    on talk(sukamon1) replace {    // section 6
        say(sukamon1, text("s106.sec6.u0"));
        choice {
            text("s106.sec6.m0.o0") => {}
            text("s106.sec6.m0.o1") => {
                choice {
                    text("s106.sec6.m2.o0") => {
                        store_date(date_year);
                        add_minutes_to_date_at(date_year, 60);
                        advance_to_date_at(date_year);
                        return;
                    }
                    text("s106.sec6.m2.o1") => {
                        store_date(date_year);
                        add_minutes_to_date_at(date_year, 360);
                        advance_to_date_at(date_year);
                        return;
                    }
                    text("s106.sec6.m2.o2") => {
                        store_date(date_year);
                        add_minutes_to_date_at(date_year, 1440);
                        advance_to_date_at(date_year);
                        return;
                    }
                    cancel => {
                        return;
                    }
                }
            }
            text("s106.sec6.m0.o2") => {
                learn_move(tech("Fire Tower"));
                learn_move(tech("Prominence Beam"));
                learn_move(tech("Spit Fire"));
                learn_move(tech("Red Inferno"));
                learn_move(tech("Magma Bomb"));
                learn_move(tech("Heat Laser"));
