                            reduce_stat(1, 100);
                            reduce_stat(2, 100);
                            reduce_stat(3, 100);
                            reduce_stat(4, 1000);
                            reduce_stat(5, 1000);
                            reduce_stat(6, 1000);
                            reduce_stat(7, 1000);
                        }
                        text("s106.sec6.m4.o2") => {
                            reduce_stat(0, 200);
                            reduce_stat(1, 200);
                            reduce_stat(2, 200);
                            reduce_stat(3, 200);
                            reduce_stat(4, 2000);
                            reduce_stat(5, 2000);
                            reduce_stat(6, 2000);
                            reduce_stat(7, 2000);
