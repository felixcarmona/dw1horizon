// Readable form of script 5 of DG.SCN, made by `dws decompile --readable`. Every event below was compiled and proven equivalent to the
// original section (control-flow bisimulation, tools/dws/flowcmp.py); sections that cannot be an event stay in the port form.
// Text is by key (text/us/dialogue.json), never the game's own words.
script 5 {
    npc slot0 = 5;
    npc slot1 = 6;
    npc slot2 = 7;
    npc slot3 = 8;

    // the section table, in the order of the original header
    sections 5, 6, 7, 8;

    on talk(slot0) replace {    // section 5
        goto sec6;
    }

    on talk(slot1) replace {    // section 6
        goto sec7;
    }

    on talk(slot2) replace {    // section 7
        goto sec8;
    }

    on talk(slot3) replace {    // section 8
        end_script();
    }
}
