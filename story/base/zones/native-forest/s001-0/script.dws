// Readable form of script 1 of DG.SCN, made by `dws decompile --readable`. Every event below was compiled and proven equivalent to the
// original section (control-flow bisimulation, tools/dws/flowcmp.py); sections that cannot be an event stay in the port form.
// Text is by key (text/us/dialogue.json), never the game's own words.
import "../../../names.dws";
script 1 {
    npc modokibetamon0 = 5;
    npc modokibetamon1 = 6;
    npc redvegiemon2 = 7;
    npc redvegiemon3 = 8;
    npc modokibetamon4 = 9;
    npc dokunemon5 = 10;
    npc dokunemon6 = 11;
    npc dokunemon7 = 12;

    // the section table, in the order of the original header
    sections 254, 5, 6, 7, 8, 9, 10, 11, 12, 51;

    on enter replace {    // section 254
        store_random(random_roll, 99);
        if (random_roll <= 39) {
            spawn_item(item("Digimushrm"), 78, 31);
        }
        store_random(random_roll, 99);
        if (random_roll <= 1) {
            spawn_item(item("Deluxmushrm"), 39, 43);
        }
        store_random(random_roll, 99);
        if (random_roll <= 9) {
            spawn_item(item("Digimushrm"), 35, 88);
            spawn_item(item("Digimushrm"), 31, 85);
            spawn_item(item("Digimushrm"), 30, 79);
        }
        store_random(random_roll, 99);
        if (random_roll <= 14) {
            spawn_item(item("Digimushrm"), 68, 84);
        }
        store_random(random_roll, 99);
        if (random_roll <= 24) {
            spawn_item(item("Digimushrm"), 49, 46);
        }
    }

    on talk(modokibetamon0) replace {    // section 5
        say(modokibetamon0, text("s001.sec5.u0"));
        battle();
        recruit(species("ModokiBetamon"));
    }

    on talk(modokibetamon1) replace {    // section 6
        say(modokibetamon1, text("s001.sec6.u0"));
        battle();
        recruit(species("ModokiBetamon"));
    }

    on talk(redvegiemon2) replace {    // section 7
        say(redvegiemon2, text("s001.sec7.u0"));
        battle();
        recruit(species("RedVegiemon"));
    }

    on talk(redvegiemon3) replace {    // section 8
        say(redvegiemon3, text("s001.sec8.u0"));
        battle();
        recruit(species("RedVegiemon"));
    }

    on talk(modokibetamon4) replace {    // section 9
        say(modokibetamon4, text("s001.sec9.u0"));
        battle();
        recruit(species("ModokiBetamon"));
    }

    on talk(dokunemon5) replace {    // section 10
        say(dokunemon5, text("s001.sec10.u0"));
        battle();
        recruit(species("Dokunemon"));
    }

    on talk(dokunemon6) replace {    // section 11
        say(dokunemon6, text("s001.sec11.u0"));
        battle();
        recruit(species("Dokunemon"));
    }

    on talk(dokunemon7) replace {    // section 12
        say(dokunemon7, text("s001.sec12.u0"));
        battle();
        recruit(species("Dokunemon"));
    }

    on step(0) replace {    // section 51
        if (native_forest_rockslide_cleared) {
            walk(tamer, -2315, 4000);
            warp_to(111, 3, 255);
        }
        walk(tamer, -2315, 4000);
        warp_to(110, 2, 255);
        return;
    }
}
