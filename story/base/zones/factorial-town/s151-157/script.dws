        }
        if (factorial_town_reopened) {
            say(tamer, text("s151.sec5.u26"));
            say(andromon, text("s151.sec5.u27"));
            say(tamer, text("s151.sec5.u28"));
            return;
        }
        if (factory_giromon_beaten && !is_recruited(species("Numemon")) && !factory_shut_down) {
            animate(tamer, 7);
