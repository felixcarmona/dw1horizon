            say(tamer, text("s151.sec5.u29"));
            say(andromon, text("s151.sec5.u30"));
            animate(tamer, 7);
            wait(15);
            say(tamer, text("s151.sec5.u31"));
            animate(tamer, anim.idle);
            say(andromon, text("s151.sec5.u32"));
            entity_set_rotation(andromon, 2048);
            wait(1s);
            sound(8, 5);
            say(andromon, text("s151.sec5.u33"));
            say(tamer, text("s151.sec5.u34"));
