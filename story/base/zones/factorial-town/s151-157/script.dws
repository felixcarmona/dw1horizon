            say(andromon, text("s151.sec5.u7"));
            entity_set_rotation(andromon, 0);
            wait(1s);
            say(tamer, text("s151.sec5.u8"));
            say(andromon, text("s151.sec5.u9"));
            animate(tamer, 25);
            wait(15);
            say(tamer, text("s151.sec5.u10"));
            animate(tamer, anim.idle);
            say(andromon, text("s151.sec5.u11"));
            say(tamer, text("s151.sec5.u12"));
            say(andromon, text("s151.sec5.u13"));
            say(tamer, text("s151.sec5.u14"));
            island_history_read = true;
            return;
        }
        if (is_recruited(species("Numemon")) && !factorial_town_reopened) {
            say(andromon, text("s151.sec5.u15"));
            animate(tamer, 19);
            wait(15);
            say(tamer, text("s151.sec5.u16"));
            animate(tamer, anim.idle);
            say(tamer, text("s151.sec5.u17"));
            say(andromon, text("s151.sec5.u18"));
            say(tamer, text("s151.sec5.u19"));
            say(andromon, text("s151.sec5.u20"));
            say(tamer, text("s151.sec5.u21"));
            say(andromon, text("s151.sec5.u22"));
            say(tamer, text("s151.sec5.u23"));
            say(andromon, text("s151.sec5.u24"));
            say(tamer, text("s151.sec5.u25"));
            factorial_town_reopened = true;
