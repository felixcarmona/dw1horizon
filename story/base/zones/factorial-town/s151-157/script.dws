        }
        if (!factory_giromon_beaten && factory_permit_required && !factory_check_refused) {
            say(tamer, text("s151.sec5.u42"));
            say(andromon, text("s151.sec5.u43"));
            say(tamer, text("s151.sec5.u44"));
            say(andromon, text("s151.sec5.u45"));
            say(tamer, text("s151.sec5.u46"));
            animate(tamer, 19);
