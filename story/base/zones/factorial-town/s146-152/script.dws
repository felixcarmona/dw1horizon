import "../../../../core/engine.dws";
script 146 {
    npc guardromon0 = 5;
    npc guardromon1 = 6;
    npc platinumsukamon2 = 7;
    npc platinumsukamon3 = 8;
    npc whamon = 9;

    // the section table, in the order of the original header
    sections 254, 51, 5, 6, 7, 8, 81;

    on enter replace {    // section 254
    }

    on step(0) replace {    // section 51
    }

    on talk(guardromon0) replace {    // section 5
        say(guardromon0, text("s146.sec5.u0"));
        battle();
        recruit(species("Guardromon"));
    }

    on talk(guardromon1) replace {    // section 6
        say(guardromon1, text("s146.sec6.u0"));
        battle();
        recruit(species("Guardromon"));
    }

