    section(1245) replace {    // section 1245
        sound(0, 9);
        if (!is_recruited(species("Agumon"))) {
            warp_to(204, 0, 255);
        }
        if (!is_recruited(species("Angemon")) && !is_recruited(species("Monzaemon")) && engine.prosperity < 50) {
            if (!is_recruited(species("Birdramon"))) {
                if (is_recruited(species("Vegiemon"))) {
                    warp_to(170, 0, 255);
                }
                if (is_recruited(species("Palmon"))) {
                    warp_to(169, 0, 255);
                }
                warp_to(168, 0, 255);
            }
            if (is_recruited(species("Vegiemon"))) {
                warp_to(173, 0, 255);
            }
            if (is_recruited(species("Palmon"))) {
                warp_to(172, 0, 255);
            }
            warp_to(171, 0, 255);
        }
        if (!is_recruited(species("Birdramon"))) {
            if (is_recruited(species("Vegiemon"))) {
                warp_to(176, 0, 255);
            }
            if (is_recruited(species("Palmon"))) {
                warp_to(175, 0, 255);
            }
            warp_to(174, 0, 255);
        }
        if (is_recruited(species("Vegiemon"))) {
            warp_to(179, 0, 255);
        }
        if (is_recruited(species("Palmon"))) {
            warp_to(178, 0, 255);
        }
        warp_to(177, 0, 255);
    }

    section(1246) replace {    // section 1246
        engine.no_escape = false;
        partner_death_started = true;
        if (stat(22) == 0 && stat(6) == 0) {
            section_on_exit(73);
            call_digimon_routine(routine("sickness_death"));
            await narrator;
            return;
        }
        if (stat(22) == 0 && stat(6) != 0) {
            section_on_exit(73);
            call_digimon_routine(routine("sickness_death"));
            await narrator;
            return;
        }
        if (stat(13) <= 0) {
            section_on_exit(71);
            call_digimon_routine(routine("dying_a"));
            await narrator;
            return;
        }
        section_on_exit(72);
        call_digimon_routine(routine("battle_death"));
        await narrator;
    }

    section(1250) replace {    // section 1250
        call_digimon_routine(routine("toilet"));
        await narrator;
        sound(0, 10);
    }

