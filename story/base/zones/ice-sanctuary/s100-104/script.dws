import "../../../../core/engine.dws";
import "../../../../core/scene.dws";
import "../../../names.dws";
script 100 {
    npc machinedramon = 5;
    npc analogman = 6;
    npc slot2 = 7;

    // the section table, in the order of the original header
    sections 254, 60;

    on enter replace {    // section 254
    }

    on step(9) replace {    // section 60
        wait(2s);
        camera_to(0, 1000, speed: 20);
        animate(tamer, 15);
        wait(1s);
        say(tamer, text("s100.sec60.u0"));
        say(analogman, text("s100.sec60.u1"));
        say(tamer, text("s100.sec60.u2"));
        await analogman;
        remove(analogman);
        wait(1s);
        say(tamer, text("s100.sec60.u3"));
        animate(machinedramon, 28);
        wait(2s);
        wait(2s);
        battle(foes: [machinedramon]);
        walk(machinedramon, 0, 950);
        await machinedramon;
        animate(machinedramon, 43);
        wait(2s);
        say(tamer, text("s100.sec60.u4"));
        face(tamer, machinedramon);
        await machinedramon;
        await tamer;
        remove(machinedramon);
        say(tamer, text("s100.sec60.u5"));
        load_digimon(species("SnowAgumon"));
        set_digimon(species("SnowAgumon"), 2, 0);
        say(slot2, text("s100.sec60.u6"));
        face(slot2, tamer);
        wait(1s);
        say(slot2, text("s100.sec60.u7"));
        recruit(species("Koromon"));
        back_dimension_portal = 0;
        recruit(species("Yuramon"));
        days_since_passed_out = 0;
        walk_away(slot2, 3050, 950, looks: 3);
        remove(slot2);
        glances = 0;
        animate(tamer, 16);
        wait(2s);
        say(tamer, text("s100.sec60.u8"));
        wait(1s);
        if (!is_recruited(species("Angemon")) && !is_recruited(species("Monzaemon")) && engine.prosperity < 50) {
            if (!is_recruited(species("Birdramon"))) {
                if (is_recruited(species("Vegiemon"))) {
                    warp_to(170, 0, 255);
                }
                if (is_recruited(species("Palmon"))) {
                    warp_to(169, 0, 255);
                }
                warp_to(168, 0, 255);
            }
            if (is_recruited(species("Vegiemon"))) {
                warp_to(173, 0, 255);
            }
            if (is_recruited(species("Palmon"))) {
                warp_to(172, 0, 255);
            }
            warp_to(171, 0, 255);
        }
        if (!is_recruited(species("Birdramon"))) {
            if (is_recruited(species("Vegiemon"))) {
                warp_to(176, 0, 255);
            }
            if (is_recruited(species("Palmon"))) {
                warp_to(175, 0, 255);
            }
            warp_to(174, 0, 255);
        }
        if (is_recruited(species("Vegiemon"))) {
            warp_to(179, 0, 255);
        }
        if (is_recruited(species("Palmon"))) {
            warp_to(178, 0, 255);
        }
        warp_to(177, 0, 255);
    }
}
