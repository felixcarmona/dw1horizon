import "../../../../core/engine.dws";
import "../../../../core/scene.dws";
import "../../../../core/recruit.dws";
import "../../../names.dws";
script 9 {
    sections 254, 81, 82;
    on enter replace {    // enter
        spawn_chest(item(5), -1511, 0, 1093, 0, 706);
        store_random(random_roll, 99);
        if (random_roll <= 14) {
            spawn_item(item(44), 74, 62);
        }
        store_random(random_roll, 99);
        if (random_roll <= 24) {
            spawn_item(item(44), 31, 45);
        }
    }
    on use(1) replace {    // use1
        rotate(tamer, 2048);
        say(narrator, text("s009.sec81.vend_daily"));
        loop {
            say(narrator, text("s009.sec81.vend_prompt"));
            choice {
                text("s009.sec81.vend_buy0") => {
                    if (bits < 51) {
                        say(narrator, text("s009.sec81.vend_poor"));
                        return;
                    }
                    give(item(44));
                    if (engine.item_did_not_fit) {
                        say(narrator, text("s009.sec81.vend_full"));
                        return;
                    }
                    take_bits(51);
                    say(narrator, text("s009.sec81.vend_getDigimushrm"));
                    return;
                }
                text("s009.sec81.vend_buy1") => {
                    if (engine.vending_happy_sold) {
                        say(narrator, text("s009.sec81.vend_sold"));
                        return;
                    }
                    if (bits < 1500) {
                        say(narrator, text("s009.sec81.vend_poor"));
                        return;
                    }
                    give(item(69));
                    if (engine.item_did_not_fit) {
                        say(narrator, text("s009.sec81.vend_full"));
                        return;
                    }
                    take_bits(1500);
                    engine.vending_happy_sold = true;
                    say(narrator, text("s009.sec81.vend_getHappymushrm"));
                    return;
                }
                text("s009.sec81.vend_more") => {
                    say(narrator, text("s009.sec81.vend_prompt"));
                    choice {
                        text("s009.sec81.vend_buy2") => {
                            if (engine.vending_ice_sold) {
                                say(narrator, text("s009.sec81.vend_sold"));
                                return;
                            }
                            if (bits < 1000) {
                                say(narrator, text("s009.sec81.vend_poor"));
                                return;
                            }
                            give(item(45));
                            if (engine.item_did_not_fit) {
                                say(narrator, text("s009.sec81.vend_full"));
                                return;
                            }
                            take_bits(1000);
                            engine.vending_ice_sold = true;
                            say(narrator, text("s009.sec81.vend_getIceMushrm"));
                            return;
                        }
                        text("s009.sec81.vend_back") => {}
                        text("s009.sec81.vend_leave") => {}
                        cancel => {
                            return;
                        }
                    }
                }
                cancel => {
                    return;
                }
            }
        }
    }
    on use(2) replace {    // use2
        rotate(tamer, 2048);
        wait(5);
        set_textbox_size(entity(0), 19, 7);
        show_textbox(text("s009.sec82.u0"));
        hide_hud();
        return;
    }
}
