import "../../../../core/engine.dws";
import "../../../names.dws";
script 78 {
    npc monochromon = 5;
    npc saberdramon = 6;
    npc brachiomon2 = 7;
    npc brachiomon3 = 8;

    // the section table, in the order of the original header
    sections 254, 5, 6, 82, 7, 8, 81;

    on enter replace {    // section 254
        store_random(random_roll, 99);
        if (random_roll <= 10) {
            spawn_item(item("Digimushrm"), 31, 84);
        }
        store_random(random_roll, 99);
        if (random_roll <= 7) {
            spawn_item(item("Digimushrm"), 48, 27);
        }
        store_random(random_roll, 99);
        if (random_roll <= 3) {
            spawn_item(item("Red Berry"), 25, 55);
        }
    }

    on talk(monochromon) replace {    // section 5
        match (p34, clamp) {
            0 => {
                say(monochromon, text("s078.sec5.u0"));
                p34 += 1;
            }
            1 => {
                say(monochromon, text("s078.sec5.u1"));
                p34 = 0;
            }
        }
    }

    on talk(saberdramon) replace {    // section 6
        face(tamer, saberdramon);
        sound(8, 3);
        wait(15);
        match (leomon_talks, clamp) {
            0 => {
                say(saberdramon, text("s078.sec6.u0"));
                leomon_talks += 1;
            }
            1 => {
                say(saberdramon, text("s078.sec6.u1"));
                leomon_talks += 1;
            }
            2 => {
                say(saberdramon, text("s078.sec6.u2"));
                leomon_talks += 1;
            }
            3 => {
                say(saberdramon, text("s078.sec6.u3"));
                leomon_talks += 1;
            }
            4 => {
                say(saberdramon, text("s078.sec6.u4"));
                leomon_talks += 1;
            }
            5 => {
                say(saberdramon, text("s078.sec6.u5"));
                leomon_talks = 0;
            }
        }
    }

    on use(2) replace {    // section 82
        animate(brachiomon2, 29);
        wait(5);
        say(brachiomon2, text("s078.sec82.u0"));
        match (p36, clamp) {
            0 => {
                animate(brachiomon2, 30);
                wait(5);
                say(brachiomon2, text("s078.sec82.u1"));
                animate(brachiomon2, 30);
                wait(5);
                say(brachiomon2, text("s078.sec82.u2"));
                p36 += 1;
                animate(brachiomon2, 31);
                wait(5);
            }
            1 => {
                animate(brachiomon2, 30);
                wait(5);
                say(brachiomon2, text("s078.sec82.u3"));
                animate(brachiomon2, 30);
                wait(5);
                say(brachiomon2, text("s078.sec82.u4"));
                p36 = 0;
                animate(brachiomon2, 31);
                wait(5);
            }
        }
    }

    on talk(brachiomon2) replace {    // section 7
    }

    on talk(brachiomon3) replace {    // section 8
    }

    on use(1) replace {    // section 81
        say(narrator, text("s078.sec81.u0"));
        say(tamer, text("s078.sec81.u1"));
        choice {
            text("s078.sec81.m0.o0") => {
                if (bits >= 200) {
                    store_random(prize_roll, 99);
                    if (prize_roll < 29) {
                        take_bits(200);
                        say(narrator, text("s078.sec81.u3"));
                        give_item(item("Meat"), 1);
                        if (engine.item_did_not_fit) {
                            say(tamer, text("s078.sec81.u4"));
                            engine.picker_mode = true;
                            call_routine(routine("choose_item"));
                            call_routine(routine("remove_all_chosen_item"));
                            give_item(item("Meat"), 1);
                        }
                    } else {
                        if (prize_roll < 59) {
                            set_dialog_owner(narrator);
                            take_bits(200);
                            say(narrator, text("s078.sec81.u5"));
                            give_item(item("sm.recovery"), 1);
                            if (engine.item_did_not_fit) {
                                say(tamer, text("s078.sec81.u6"));
                                engine.picker_mode = true;
                                call_routine(routine("choose_item"));
                                call_routine(routine("remove_all_chosen_item"));
                                give_item(item("sm.recovery"), 1);
                            }
                        } else {
                            if (prize_roll < 79) {
                                set_dialog_owner(narrator);
                                take_bits(200);
                                say(narrator, text("s078.sec81.u7"));
                                give_item(item("Moldy Meat"), 1);
                                if (engine.item_did_not_fit) {
                                    say(tamer, text("s078.sec81.u8"));
                                    engine.picker_mode = true;
                                    call_routine(routine("choose_item"));
                                    call_routine(routine("remove_all_chosen_item"));
                                    give_item(item("Moldy Meat"), 1);
                                }
                            } else {
                                if (prize_roll <= 99) {
                                    set_dialog_owner(narrator);
                                    take_bits(200);
                                    say(narrator, text("s078.sec81.u9"));
                                    if (engine.item_did_not_fit) {
                                        say(tamer, text("s078.sec81.u10"));
                                        engine.picker_mode = true;
                                        call_routine(routine("choose_item"));
                                        call_routine(routine("remove_all_chosen_item"));
                                        give_item(item("MP Floppy"), 1);
                                        return;
                                    }
                                }
                                return;
                            }
                            return;
                        }
                        return;
                    }
                    return;
                }
                say(tamer, text("s078.sec81.u2"));
                return;
            }
            text("s078.sec81.m0.o1") => {}
