import "../../../../core/engine.dws";
import "../../../../core/scene.dws";
import "../../../../core/recruit.dws";
import "../../../names.dws";
script 78 {
    npc monochromon = 5;
    npc saberdramon = 6;
    npc brachiomon2 = 7;
    npc brachiomon3 = 8;
    sections 254, 5, 6, 82, 7, 8, 81;
    on enter replace {    // enter
        store_random(random_roll, 99);
        if (random_roll <= 10) {
            spawn_item(item(44), 31, 84);
        }
        store_random(random_roll, 99);
        if (random_roll <= 7) {
            spawn_item(item(44), 48, 27);
        }
        store_random(random_roll, 99);
        if (random_roll <= 7) {
            spawn_item(item(49), 25, 55);
        }
    }
    on talk(monochromon) replace {    // talk
        match (p34, clamp) {
            0 => {
                say(monochromon, text("s078.sec5.u0"));
                p34 += 1;
            }
            1 => {
                say(monochromon, text("s078.sec5.u1"));
                p34 = 0;
            }
        }
    }
    on talk(saberdramon) replace {    // talk
        face(tamer, saberdramon);
        sound(8, 3);
        wait(15);
        match (leomon_talks, clamp) {
            0 => {
                say(saberdramon, text("s078.sec6.u0"));
                leomon_talks += 1;
            }
            1 => {
                say(saberdramon, text("s078.sec6.u1"));
                leomon_talks += 1;
            }
            2 => {
                say(saberdramon, text("s078.sec6.u2"));
                leomon_talks += 1;
            }
            3 => {
                say(saberdramon, text("s078.sec6.u3"));
                leomon_talks += 1;
            }
            4 => {
                say(saberdramon, text("s078.sec6.u4"));
                leomon_talks += 1;
            }
            5 => {
                say(saberdramon, text("s078.sec6.u5"));
                leomon_talks = 0;
            }
        }
    }
    on use(2) replace {    // use2
        animate(brachiomon2, 29);
        wait(5);
        say(brachiomon2, text("s078.sec82.u0"));
        match (p36, clamp) {
            0 => {
                animate(brachiomon2, 30);
                wait(5);
                say(brachiomon2, text("s078.sec82.u1"));
                animate(brachiomon2, 30);
                wait(5);
                say(brachiomon2, text("s078.sec82.u2"));
                p36 += 1;
                animate(brachiomon2, 31);
                wait(5);
            }
            1 => {
                animate(brachiomon2, 30);
                wait(5);
                say(brachiomon2, text("s078.sec82.u3"));
                animate(brachiomon2, 30);
                wait(5);
                say(brachiomon2, text("s078.sec82.u4"));
                p36 = 0;
                animate(brachiomon2, 31);
                wait(5);
            }
        }
    }
    on talk(brachiomon2) replace {    // talk
    }
    on talk(brachiomon3) replace {    // talk
    }
    on use(1) replace {    // use1
        rotate(tamer, 2048);
        loop {
            say(narrator, text("s078.sec81.vend_prompt"));
            choice {
                text("s078.sec81.vend_buy0") => {
                    if (bits < 26) {
                        say(narrator, text("s078.sec81.vend_poor"));
                        return;
                    }
                    give(item(68));
                    if (engine.item_did_not_fit) {
                        say(narrator, text("s078.sec81.vend_full"));
                        return;
                    }
                    take_bits(26);
                    say(narrator, text("s078.sec81.vend_getMoldyMeat"));
                    return;
                }
                text("s078.sec81.vend_buy1") => {
                    if (bits < 20) {
                        say(narrator, text("s078.sec81.vend_poor"));
                        return;
                    }
                    give(item(38));
                    if (engine.item_did_not_fit) {
                        say(narrator, text("s078.sec81.vend_full"));
                        return;
                    }
                    take_bits(20);
                    say(narrator, text("s078.sec81.vend_getMeat"));
                    return;
                }
                text("s078.sec81.vend_more") => {
                    say(narrator, text("s078.sec81.vend_prompt"));
                    choice {
                        text("s078.sec81.vend_buy2") => {
                            if (bits < 300) {
                                say(narrator, text("s078.sec81.vend_poor"));
                                return;
                            }
                            give(item(39));
                            if (engine.item_did_not_fit) {
                                say(narrator, text("s078.sec81.vend_full"));
                                return;
                            }
                            take_bits(300);
                            say(narrator, text("s078.sec81.vend_getGiantMeat"));
                            return;
                        }
                        text("s078.sec81.vend_buy3") => {
                            if (bits < 1000) {
                                say(narrator, text("s078.sec81.vend_poor"));
                                return;
                            }
                            give(item(40));
                            if (engine.item_did_not_fit) {
                                say(narrator, text("s078.sec81.vend_full"));
                                return;
                            }
                            take_bits(1000);
                            say(narrator, text("s078.sec81.vend_getSirloin"));
                            return;
                        }
                        text("s078.sec81.vend_back") => {}
                        cancel => {
                            return;
                        }
                    }
                }
                cancel => {
                    return;
                }
            }
        }
    }
}
