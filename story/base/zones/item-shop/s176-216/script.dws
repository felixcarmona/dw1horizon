        }
        if (item_shop_keeper == 1) {
            shop_stock.sup_recovery = true;
        }
        if (item_shop_keeper == 2) {
            shop_stock.sup_restore = true;
        }
        if (item_shop_keeper == 3) {
            shop_stock.protection = true;
        }
        if (item_shop_intros == 4) {
            shop_stock.sm_recovery = true;
            shop_stock.med_recovery = true;
