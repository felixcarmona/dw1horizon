            shop_stock.def_disk = true;
            shop_stock.hispeed_dsk = true;
            shop_stock.auto_pilot = true;
            shop_stock.port_potty = true;
            shop_stock.meat = true;
        }
        if (item_shop_keeper == 0) {
            shop_stock.omnipotent = true;
        }
        if (item_shop_keeper == 1) {
            shop_stock.sup_recovery = true;
        }
        if (item_shop_keeper == 2) {
            shop_stock.sup_restore = true;
        }
        if (item_shop_keeper == 3) {
            shop_stock.protection = true;
        }
        engine.picker_mode = false;
        if (item_shop_intros in [2, 3]) {
            shop_stock.sm_recovery = true;
            shop_stock.med_recovery = true;
            shop_stock.mp_floppy = true;
            shop_stock.various = true;
            shop_stock.off_disk = true;
            shop_stock.def_disk = true;
            shop_stock.hispeed_dsk = true;
            shop_stock.auto_pilot = true;
            shop_stock.port_potty = true;
