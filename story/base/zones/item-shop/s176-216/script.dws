        if (is_recruited(species("Patamon")) && !item_shop_keeper_met.patamon && item_shop_keeper == 0) {
            say(keeper, text("s176.sec81.u4"));
            item_shop_keeper_met.patamon = true;
            item_shop_intros += 1;
            if (item_shop_intros >= 3) {
                set_obj_visibility(18, 1);
