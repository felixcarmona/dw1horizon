    on use(2) replace {    // section 82
        unless (piximon_in_item_shop) return;
        face(tamer, piximon);
        face(piximon, tamer);
        say(piximon, text("s176.sec82.u0"));
        choice(open) {
            text("s176.sec82.m0.o0") => {
                if (bits >= 50000) {
                    take_bits(50000);
                    give_item(item("Trn. manual"), 1);
                    if (engine.item_did_not_fit) {
                        say(piximon, text("s176.sec82.u2"));
                        give_bits(50000);
                        return;
                    }
                    sound(0, 5);
                    say(narrator, text("s176.sec82.u3"));
                } else {
                    say(piximon, text("s176.sec82.u1"));
                    return;
                }
            }
            text("s176.sec82.m0.o1") => {}
        }
        say(piximon, text("s176.sec82.u4"));
    }

    on use(3) replace {    // section 83
        unless (item_shop_intros >= 3) return;
        entity_set_rotation(tamer, 2048);
        jump_to_file(219, 51);
    }

    on talk(punimon) replace {    // section 7
        store_random(random_roll, 2);
        if (engine.prosperity >= 20) {
            if (random_roll == 0) {
                say(punimon, text("s176.sec7.u0"));
                return;
            }
        }
        say(punimon, text("s176.sec7.u1"));
    }

    on step(1) replace {    // section 52
        warp_to(217, 0, 255);
        return;
