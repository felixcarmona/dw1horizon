        if (is_recruited(species("Monochromon")) && !item_shop_keeper_met.monochromon && item_shop_keeper == 3) {
            say(keeper, text("s176.sec81.u7"));
            item_shop_keeper_met.monochromon = true;
            item_shop_intros += 1;
            if (item_shop_intros >= 3) {
                set_obj_visibility(18, 1);
                set_obj_visibility(20, 1);
            }
