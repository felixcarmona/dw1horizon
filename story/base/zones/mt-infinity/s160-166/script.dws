// Text is by key (text/us/dialogue.json), never the game's own words.
import "../../../../core/engine.dws";
script 160 {
    npc vermilimon0 = 5;
    npc vermilimon1 = 6;
    npc golemon2 = 7;
    npc vermilimon3 = 8;
    npc golemon4 = 9;

    // the section table, in the order of the original header
    sections 254, 51, 52, 5, 6, 7, 8, 9;

    on enter replace {    // section 254
        spawn_chest(item("Omni Disk"), -2663, 0, 277, 3072, 680);
    }

    on step(0) replace {    // section 51
        walk(tamer, 2099, -558);
        warp_to(167, 1, 255);
    }

    on step(1) replace {    // section 52
        walk(tamer, -1958, 2679);
        if (!is_recruited(species("Agumon"))) {
            warp_to(204, 0, 255);
        }
        if (!is_recruited(species("Angemon")) && !is_recruited(species("Monzaemon")) && engine.prosperity < 50) {
            if (!is_recruited(species("Birdramon"))) {
                if (is_recruited(species("Vegiemon"))) {
                    warp_to(170, 9, 255);
                }
                if (is_recruited(species("Palmon"))) {
                    warp_to(169, 9, 255);
                }
                warp_to(168, 9, 255);
            }
            if (is_recruited(species("Vegiemon"))) {
                warp_to(173, 9, 255);
            }
            if (is_recruited(species("Palmon"))) {
                warp_to(172, 9, 255);
            }
            warp_to(171, 9, 255);
        }
        if (!is_recruited(species("Birdramon"))) {
            if (is_recruited(species("Vegiemon"))) {
                warp_to(176, 9, 255);
            }
            if (is_recruited(species("Palmon"))) {
                warp_to(175, 9, 255);
            }
            warp_to(174, 9, 255);
        }
        if (is_recruited(species("Vegiemon"))) {
            warp_to(179, 9, 255);
        }
        if (is_recruited(species("Palmon"))) {
            warp_to(178, 9, 255);
        }
        warp_to(177, 9, 255);
    }

    on talk(vermilimon0) replace {    // section 5
        say(vermilimon0, text("s160.sec5.u0"));
        battle();
        recruit(species("Vermilimon"));
    }

    on talk(vermilimon1) replace {    // section 6
        say(vermilimon1, text("s160.sec6.u0"));
        battle();
        recruit(species("Vermilimon"));
    }

    on talk(golemon2) replace {    // section 7
        say(golemon2, text("s160.sec7.u0"));
        battle();
        recruit(species("Golemon"));
    }

    on talk(vermilimon3) replace {    // section 8
        say(vermilimon3, text("s160.sec8.u0"));
        battle();
        recruit(species("Vermilimon"));
    }

    on talk(golemon4) replace {    // section 9
        say(golemon4, text("s160.sec9.u0"));
        battle();
        recruit(species("Golemon"));
        return;
    }
}
