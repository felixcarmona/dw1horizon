            entity_set_rotation(tamer, 1627);
            wait(10);
            entity_set_rotation(tamer, 1115);
            wait(10);
            say(tamer, text("s062.sec81.u1"));
            choice {
                text("s062.sec81.m0.o0") => {
                    walk(tamer, -314, -603);
                    walk(partner, -298, -335);
                    await tamer;
                    await partner;
                    entity_set_rotation(tamer, 1115);
                    entity_set_rotation(partner, 91);
                    say(narrator, text("s062.sec81.u2"));
