        say(tamer, text("s190.sec51.u7"));
        say(slot0, text("s190.sec51.u8"));
        say(tamer, text("s190.sec51.u9"));
        say(slot0, text("s190.sec51.u10"));
        say(tamer, text("s190.sec51.u11"));
        say(slot0, text("s190.sec51.u12"));
        sound(8, 6);
