            set_obj_visibility(16, 0);
            set_obj_visibility(17, 0);
            set_obj_visibility(18, 0);
        }
    }

    on step(1) replace {    // section 52
        unless (mystery_circles_grown_seen || !ufo_report_read || vademon_encounter_ready) goto L13;
        unless (!vademon_encounter_ready || is_recruited(species("Vademon"))) goto L14;
        goto L17;
    }

    on step(0) replace {    // section 51
        if (!mystery_circles_first_seen) {
            say(narrator, text("s190.sec51.u0"));
            say(tamer, text("s190.sec51.u1"));
            mystery_circles_first_seen = true;
            return;
        }
        unless (mystery_circles_grown_seen || !ufo_report_read || vademon_encounter_ready) goto L13;
        unless (!vademon_encounter_ready || is_recruited(species("Vademon"))) goto L14;
        goto L17;
