            }
            warp_to(197, 2, 255);
            return;
        }
        if (is_recruited(species("Centarumon"))) {
            if (is_recruited(species("Greymon"))) {
                warp_to(202, 2, 255);
                return;
            }
            warp_to(201, 2, 255);
            return;
        }
        if (is_recruited(species("Greymon"))) {
            warp_to(203, 2, 255);
