                return;
            }
            if (is_recruited(species("Greymon"))) {
                warp_to(196, 2, 255);
                return;
            }
            warp_to(189, 2, 255);
            return;
        }
        if (is_recruited(species("Betamon")) || is_recruited(species("Coelamon"))) {
