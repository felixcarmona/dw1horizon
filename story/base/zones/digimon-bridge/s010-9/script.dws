        unless (bits >= 50000) return;
        say(etemon, text("s010.sec8.u1"));
        choice {
            text("s010.sec8.m0.o0") => {
                take_bits(50000);
                give_item(item("Gold banana"), 1);
                if (engine.item_did_not_fit) {
                    if (has(item("Gold banana")) >= 99) {
                        say(etemon, text("s010.sec8.u2"));
                        give_bits(50000);
                        return;
                    }
                    say(tamer, text("s010.sec8.u3"));
                    engine.picker_mode = true;
                    call_routine(routine("choose_item"));
                    call_routine(routine("remove_all_chosen_item"));
                    give_item(item("Gold banana"), 1);
                }
                say(etemon, text("s010.sec8.u4"));
                return;
            }
            text("s010.sec8.m0.o1") => {}
        }
        say(etemon, text("s010.sec8.u5"));
    }

    on step(1) replace {    // section 52
        walk(tamer, -2800, 3000);
        if (is_recruited(species("Patamon")) || is_recruited(species("Biyomon")) || is_recruited(species("Unimon")) || is_recruited(species("Monochromon"))) {
