// Readable form of script 165 of DG.SCN, made by `dws decompile --readable`. Every event below was compiled and proven equivalent to the
// original section (control-flow bisimulation, tools/dws/flowcmp.py); sections that cannot be an event stay in the port form.
// Text is by key (text/us/dialogue.json), never the game's own words.
import "../../../../core/engine.dws";
import "../../../../core/scene.dws";
import "../../../names.dws";
script 165 {
    npc jijimon = 5;
    npc angemon = 6;
    npc tokomon = 7;

    // the section table, in the order of the original header
    sections 254, 54, 5, 6, 20, 71, 72, 73, 85, 7, 51;

    on enter replace {    // section 254
    }

    on step(3) replace {    // section 54
        jump_to_file(193, 55);
    }

    on talk(jijimon) replace {    // section 5
        if (!is_recruited(species("Koromon")) && !is_recruited(species("Punimon")) && back_dimension_portal != 0) {
            if (is_recruited(species("Botamon")) && is_recruited(species("Yuramon"))) {
                say(jijimon, text("s165.sec5.u0"));
                say(tamer, text("s165.sec5.u1"));
                say(jijimon, text("s165.sec5.u2"));
                say(tamer, text("s165.sec5.u3"));
                say(jijimon, text("s165.sec5.u4"));
                unless (is_recruited(species("Agumon"))) return;
                jump_to_file(210, 51);
            }
        }
        if (is_recruited(species("Koromon")) && !is_recruited(species("Punimon"))) {
            say(jijimon, text("s165.sec5.u5"));
            say(tamer, text("s165.sec5.u6"));
            say(jijimon, text("s165.sec5.u7"));
            say(tamer, text("s165.sec5.u8"));
            say(jijimon, text("s165.sec5.u9"));
            say(tamer, text("s165.sec5.u10"));
            give_item(item("Chain melon"), 1);
            if (engine.item_did_not_fit) {
                unless (has(item("Spike Club")) < 99) return;
                say(tamer, text("s165.sec5.u11"));
                engine.picker_mode = true;
                call_routine(routine("choose_item"));
                call_routine(routine("remove_all_chosen_item"));
                give_item(item("Chain melon"), 1);
            }
            say(tamer, text("s165.sec5.u12"));
            days_since_passed_out = 0;
            recruit(species("Punimon"));
            return;
        }
        if (engine.game_beaten && !is_recruited(species("Botamon"))) {
            say(jijimon, text("s165.sec5.u13"));
            say(tamer, text("s165.sec5.u14"));
            say(jijimon, text("s165.sec5.u15"));
            say(tamer, text("s165.sec5.u16"));
            say(jijimon, text("s165.sec5.u17"));
            recruit(species("Botamon"));
        }
        unless (is_recruited(species("Agumon"))) return;
        jump_to_file(210, 51);
    }

    on talk(angemon) replace {    // section 6
        jump_to_file(211, 8);
    }

    section(20) replace {    // section 20
        camera_to(183, 221, speed: 20);
        await camera;
        wait(1s);
        add_stat(6, 9999);
        add_stat(7, 9999);
        engine.no_escape = false;
        animate(jijimon, 29);
        wait(5);
        say(jijimon, text("s165.sec20.u0"));
        animate(jijimon, anim.idle);
    }

    on step(20) replace {    // section 71
        jump_to_file(212, 71);
    }

    on step(21) replace {    // section 72
        jump_to_file(212, 72);
    }

    on step(22) replace {    // section 73
        jump_to_file(212, 73);
    }

    on use(5) replace {    // section 85
        if (!save_machine_explained) {
            save_machine_explained = true;
            say(tamer, text("s165.sec85.u0"));
            face(jijimon, tamer);
            face(tamer, jijimon);
            wait(5);
            say(jijimon, text("s165.sec85.u1"));
            entity_set_rotation(tamer, 0);
            wait(5);
            return;
        }
        say(narrator, text("s165.sec85.u2"));
        choice(narrator) {
            text("s165.sec85.m0.o0") => {
                fadeout_hud(0);
                call_routine(routine("save_machine"));
                return;
            }
            text("s165.sec85.m0.o1") => {
                return;
            }
            cancel => {
                return;
            }
        }
    }

    on talk(tokomon) replace {    // section 7
        if (!is_recruited(species("Whamon")) && ogre_fortress_cleared) {
            say(tokomon, text("s165.sec7.u0"));
            return;
        }
        if (invisible_bridge_rumor_heard && invisible_bridge_crossed) {
            say(tokomon, text("s165.sec7.u1"));
            return;
        }
        if (engine.prosperity >= 6) {
            say(tokomon, text("s165.sec7.u2"));
            return;
        }
        say(tokomon, text("s165.sec7.u3"));
    }

    on step(0) replace {    // section 51
        walk(tamer, -470, -1970);
        if (!is_recruited(species("Agumon"))) {
            warp_to(204, 2, 255);
        }
        if (!is_recruited(species("Angemon")) && !is_recruited(species("Monzaemon")) && engine.prosperity < 50) {
            if (!is_recruited(species("Birdramon"))) {
                if (is_recruited(species("Vegiemon"))) {
                    warp_to(170, 2, 255);
                }
                if (is_recruited(species("Palmon"))) {
                    warp_to(169, 2, 255);
                }
                warp_to(168, 2, 255);
            }
            if (is_recruited(species("Vegiemon"))) {
                warp_to(173, 2, 255);
            }
            if (is_recruited(species("Palmon"))) {
                warp_to(172, 2, 255);
            }
            warp_to(171, 2, 255);
        }
        if (!is_recruited(species("Birdramon"))) {
            if (is_recruited(species("Vegiemon"))) {
                warp_to(176, 2, 255);
            }
            if (is_recruited(species("Palmon"))) {
                warp_to(175, 2, 255);
            }
            warp_to(174, 2, 255);
        }
        if (is_recruited(species("Vegiemon"))) {
            warp_to(179, 2, 255);
        }
        if (is_recruited(species("Palmon"))) {
            warp_to(178, 2, 255);
        }
        warp_to(177, 2, 255);
    }
}
