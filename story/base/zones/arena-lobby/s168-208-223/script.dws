            if (is_recruited(species("Greymon"))) {
                warp_to(200, 6, 255);
                return;
            }
            warp_to(197, 6, 255);
            return;
        }
        if (is_recruited(species("Centarumon"))) {
            if (is_recruited(species("Greymon"))) {
                warp_to(202, 6, 255);
                return;
            }
            warp_to(201, 6, 255);
            return;
        }
        if (is_recruited(species("Greymon"))) {
            warp_to(203, 6, 255);
            return;
        }
        warp_to(180, 6, 255);
        return;
    }

