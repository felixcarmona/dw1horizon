    // the section table, in the order of the original header
    sections 254, 81, 54, 61, 51, 82, 83, 84, 6, 53, 52, 10, 11;

    on enter replace {    // section 254
        curling_opponent = 255;
        if (!is_recruited(species("Penguinmon"))) {
            set_obj_visibility(0, 0);
            set_obj_visibility(1, 0);
            set_obj_visibility(2, 0);
            set_obj_visibility(3, 0);
        } else {
            set_obj_visibility(0, 1);
            set_obj_visibility(1, 1);
            set_obj_visibility(2, 1);
            set_obj_visibility(3, 1);
            set_obj_visibility(5, 0);
            set_obj_visibility(6, 0);
        }
        if (is_recruited(species("Penguinmon")) && !engine.game_beaten) {
            set_obj_visibility(4, 0);
        }
        if (is_recruited(species("Penguinmon")) && engine.game_beaten) {
            set_obj_visibility(4, 1);
        }
        if (engine.game_beaten) {
            set_obj_visibility(7, 0);
            set_obj_visibility(8, 0);
        }
    }

    on use(1) replace {    // section 81
        jump_to_file(213, 81);
    }

    on step(3) replace {    // section 54
        jump_to_file(213, 54);
    }

    on step(10) replace {    // section 61
        jump_to_file(214, 51);
    }

    on step(0) replace {    // section 51
        if (is_recruited(species("Penguinmon"))) {
            warp_to(235, 0, 255);
            curling_opponent = 255;
        }
    }

    on use(2) replace {    // section 82
        say(narrator, text("s168.sec82.u0"));
        choice(narrator) {
            text("s168.sec82.m0.o0") => {
                say(narrator, text("s168.sec82.u1"));
                fadeout_hud(0);
                return;
            }
            text("s168.sec82.m0.o1") => {
                say(narrator, text("s168.sec82.u2"));
                return;
            }
            text("s168.sec82.m0.o2") => {
                say(narrator, text("s168.sec82.u3"));
                return;
            }
            cancel => {
                return;
            }
        }
    }

    on use(3) replace {    // section 83
        jump_to_file(215, 6);
    }

    on use(4) replace {    // section 84
        face(metalgreymonvirus, tamer);
        face(tamer, metalgreymonvirus);
        wait(10);
        say(metalgreymonvirus, text("s168.sec84.u0"));
        store_random(random_roll, 9);
        if (random_roll == 0) {
            say(metalgreymonvirus, text("s168.sec84.u1"));
            return;
        }
        if (random_roll == 1) {
            say(metalgreymonvirus, text("s168.sec84.u2"));
            return;
        }
        if (random_roll == 2) {
            say(metalgreymonvirus, text("s168.sec84.u3"));
            return;
        }
        if (random_roll == 3) {
            say(metalgreymonvirus, text("s168.sec84.u4"));
            return;
        }
        if (random_roll == 4) {
            say(metalgreymonvirus, text("s168.sec84.u5"));
            return;
        }
        if (random_roll == 5) {
            say(metalgreymonvirus, text("s168.sec84.u6"));
            return;
        }
        if (random_roll == 6) {
            say(metalgreymonvirus, text("s168.sec84.u7"));
            return;
        }
        if (random_roll == 7) {
            say(metalgreymonvirus, text("s168.sec84.u8"));
            return;
        }
        if (random_roll == 8) {
            say(metalgreymonvirus, text("s168.sec84.u9"));
            return;
        }
        unless (random_roll == 9) goto sec6;
        say(metalgreymonvirus, text("s168.sec84.u10"));
    }

    on talk(airdramon) replace {    // section 6
