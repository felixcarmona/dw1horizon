// Readable form of script 87 of DG.SCN, made by `dws decompile --readable`. Every event below was compiled and proven equivalent to the
// original section (control-flow bisimulation, tools/dws/flowcmp.py); sections that cannot be an event stay in the port form.
// Text is by key (text/us/dialogue.json), never the game's own words.
import "../../../names.dws";
script 87 {
    npc snowgoblimon0 = 5;
    npc snowgoblimon1 = 6;
    npc hyogamon = 7;
    npc icedevimon3 = 8;
    npc icedevimon4 = 9;
    npc icedevimon5 = 10;

    // the section table, in the order of the original header
    sections 254, 5, 6, 7, 8, 9, 10, 51;

    on enter replace {    // section 254
        store_random(random_roll, 99);
        if (random_roll <= 17) {
            spawn_item(item("Digimushrm"), 49, 27);
        }
        store_random(random_roll, 99);
        if (random_roll <= 8) {
            spawn_item(item("Digimushrm"), 39, 50);
        }
        store_random(random_roll, 99);
        if (random_roll <= 1) {
            spawn_item(item("Ice mushrm"), 53, 70);
        }
    }

    on talk(snowgoblimon0) replace {    // section 5
        say(snowgoblimon0, text("s087.sec5.u0"));
        battle();
        recruit(species("SnowGoblimon"));
    }

    on talk(snowgoblimon1) replace {    // section 6
        say(snowgoblimon1, text("s087.sec6.u0"));
        battle();
        recruit(species("SnowGoblimon"));
    }

    on talk(hyogamon) replace {    // section 7
        say(hyogamon, text("s087.sec7.u0"));
        battle();
        recruit(species("Hyogamon"));
    }

    on talk(icedevimon3) replace {    // section 8
        say(icedevimon3, text("s087.sec8.u0"));
        battle();
        recruit(species("IceDevimon"));
    }

    on talk(icedevimon4) replace {    // section 9
        say(icedevimon4, text("s087.sec9.u0"));
        battle();
        recruit(species("IceDevimon"));
    }

    on talk(icedevimon5) replace {    // section 10
        say(icedevimon5, text("s087.sec10.u0"));
        battle();
        recruit(species("IceDevimon"));
    }

    on step(0) replace {    // section 51
        unless (condition(64) && !digivolve_scene_seen) return;
        store_digimon_type(partner_type);
        if (partner_type in [3, 5, 8, 9, 47]) {
            jump_to_file(203, 51);
        }
        if (partner_type in [19, 32, 51, 1, 2]) {
            jump_to_file(203, 51);
        }
        if (partner_type in [15, 16, 29, 30, 43]) {
            jump_to_file(203, 51);
        }
        if (partner_type in [44, 21]) {
            jump_to_file(203, 51);
        }
        return;
    }
}
