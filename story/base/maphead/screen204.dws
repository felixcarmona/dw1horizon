// Readable form of MAPHEAD.SCN, made by `dws decompile --readable`. Every event below was compiled and proven equivalent to the
// original section (control-flow bisimulation, tools/dws/flowcmp.py); sections that cannot be an event stay in the port form.
// Text is by key (text/us/dialogue.json), never the game's own words.
import "../../core/engine.dws";
import "../names.dws";
maphead {
    section(204) replace {    // section 204
        set_script(164, 204);
        engine.music_mode = 0;
        set_bgm(28);
        if (debug_test_npcs) {
            load_digimon(species("Jijimon"));
            load_digimon(species("Tokomon"));
            set_digimon(species("Tokomon"), 5, 0);
            set_digimon(species("Jijimon"), 3, 0);
            return;
        }
        if (!debug_mode) {
            load_digimon(species("Jijimon"));
            load_digimon(species("Tokomon"));
            set_digimon(species("Jijimon"), 0, 0);
            set_digimon(species("Tokomon"), 1, 0);
            set_digimon(species("Jijimon"), 2, 0);
            set_digimon(species("Jijimon"), 3, 0);
            return;
        }
        load_digimon(species("Yuramon"));
        load_digimon(species("Tanemon"));
        set_digimon(species("Yuramon"), 4, 0);
        set_digimon(species("Tanemon"), 6, 0);
    }
}
