// Readable form of MAPHEAD.SCN, made by `dws decompile --readable`. Every event below was compiled and proven equivalent to the
// original section (control-flow bisimulation, tools/dws/flowcmp.py); sections that cannot be an event stay in the port form.
// Text is by key (text/us/dialogue.json), never the game's own words.
import "../../core/engine.dws";
import "../names.dws";
maphead {
    section(73) replace {    // section 73
        set_script(70, 73);
        engine.music_mode = 0;
        set_bgm(11);
        if (!is_recruited(species("Biyomon"))) {
            gear_savanna.chase_stage = 0;
            load_digimon(species(163));
            set_digimon(species(163), 0, 1);
            return;
        }
        store_date(date_year);
        if (date_hour >= 7 && date_hour < 19) {
            load_digimon(species("ShimaUnimon"));
            load_digimon(species("Akatorimon"));
            set_digimon(species("ShimaUnimon"), 1, 1);
            set_digimon(species("ShimaUnimon"), 2, 1);
            set_digimon(species("Akatorimon"), 3, 1);
        } else {
            load_digimon(species("Shamamon"));
            load_digimon(species("Tsukaimon"));
            set_digimon(species("Shamamon"), 4, 1);
            set_digimon(species("Shamamon"), 5, 1);
            set_digimon(species("Tsukaimon"), 6, 1);
        }
    }
}
