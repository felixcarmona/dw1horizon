// Readable form of MAPHEAD.SCN, made by `dws decompile --readable`. Every event below was compiled and proven equivalent to the
// original section (control-flow bisimulation, tools/dws/flowcmp.py); sections that cannot be an event stay in the port form.
// Text is by key (text/us/dialogue.json), never the game's own words.
import "../../core/engine.dws";
import "../names.dws";
maphead {
    section(79) replace {    // section 79
        set_script(76, 79);
        engine.music_mode = 0;
        set_bgm(14);
        load_digimon(species(132));
        if (!dino_region_guard_beaten) {
            set_digimon(species(132), 0, 1);
            return;
        }
        store_date(date_year);
        if (date_hour >= 7 && date_hour < 19) {
            load_digimon(species("Vermilimon"));
            set_digimon(species("Vermilimon"), 1, 1);
            set_digimon(species("Vermilimon"), 2, 1);
        } else {
            load_digimon(species("Yanmamon"));
            set_digimon(species("Yanmamon"), 3, 1);
            set_digimon(species("Yanmamon"), 4, 1);
        }
    }
}
