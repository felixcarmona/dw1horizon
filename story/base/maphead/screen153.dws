// Readable form of MAPHEAD.SCN, made by `dws decompile --readable`. Every event below was compiled and proven equivalent to the
// original section (control-flow bisimulation, tools/dws/flowcmp.py); sections that cannot be an event stay in the port form.
// Text is by key (text/us/dialogue.json), never the game's own words.
import "../../core/engine.dws";
import "../names.dws";
maphead {
    section(153) replace {    // section 153
        set_script(147, 153);
        engine.music_mode = 0;
        set_bgm(22);
        store_random(random_roll, 99);
        if (random_roll <= 2 && !is_recruited(species("MetalMamemon"))) {
            load_digimon(species(149));
            set_digimon(species(149), 4, 1);
            return;
        }
        store_date(date_year);
        if (date_hour >= 7 && date_hour < 19) {
            load_digimon(species("Guardromon"));
            set_digimon(species("Guardromon"), 0, 1);
            set_digimon(species("Guardromon"), 1, 1);
        } else {
            load_digimon(species("Geremon"));
            set_digimon(species("Geremon"), 2, 1);
            set_digimon(species("Geremon"), 3, 1);
        }
    }
}
