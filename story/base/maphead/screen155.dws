// Readable form of MAPHEAD.SCN, made by `dws decompile --readable`. Every event below was compiled and proven equivalent to the
// original section (control-flow bisimulation, tools/dws/flowcmp.py); sections that cannot be an event stay in the port form.
// Text is by key (text/us/dialogue.json), never the game's own words.
import "../../core/engine.dws";
import "../names.dws";
maphead {
    section(155) replace {    // section 155
        set_script(149, 155);
        engine.music_mode = 0;
        set_bgm(22);
        store_date(date_year);
        unless (date_hour != 11 || date_minute < 55) return;
        unless (date_hour != 12 || date_minute > 5) return;
        unless (date_hour != 23 || date_minute < 55) return;
        unless (date_hour != 0 || date_minute > 5) return;
        if (!factory_guards_passed) {
            load_digimon(species("Guardromon"));
            set_digimon(species("Guardromon"), 6, 0);
            set_digimon(species("Guardromon"), 7, 0);
            return;
        }
        store_date(date_year);
        if (date_hour >= 7 && date_hour < 19) {
            load_digimon(species("Geremon"));
            set_digimon(species("Geremon"), 0, 1);
            set_digimon(species("Geremon"), 1, 1);
            set_digimon(species("Geremon"), 2, 1);
        } else {
            load_digimon(species("PlatinumSukamon"));
            set_digimon(species("PlatinumSukamon"), 3, 1);
            set_digimon(species("PlatinumSukamon"), 4, 1);
            set_digimon(species("PlatinumSukamon"), 5, 1);
        }
    }
}
