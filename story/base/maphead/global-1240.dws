// Readable form of MAPHEAD.SCN, made by `dws decompile --readable`. Every event below was compiled and proven equivalent to the
// original section (control-flow bisimulation, tools/dws/flowcmp.py); sections that cannot be an event stay in the port form.
// Text is by key (text/us/dialogue.json), never the game's own words.
maphead {
    section(1240) replace {    // section 1240 (literal)
        goto l1;
        goto l2;
        goto l3;
        goto l4;
        goto l5;
        goto l6;
        goto l7;
        goto l8;
        l1:
        show_textbox(text("m1240.u0"));
        l2:
        show_textbox(text("m1240.u1"));
        l3:
        show_textbox(text("m1240.u2"));
        l4:
        show_textbox(text("m1240.u3"));
        l5:
        show_textbox(text("m1240.u4"));
        l6:
        show_textbox(text("m1240.u5"));
        l7:
        show_textbox(text("m1240.u6"));
        l8:
        show_textbox(text("m1240.u7"));
        end_section();
    }
}
