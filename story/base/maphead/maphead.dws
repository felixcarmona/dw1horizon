    shared L231 {    // code of sec179 that other code jumps to
        if (is_recruited(species("Whamon"))) {
            load_digimon(species(146));
            set_digimon(species(146), 7, 0);
            top_map_residents_placed += 1;
        }
        unless (!greymon_challenge_ready || is_recruited(species("Greymon"))) return;
        unless (!mt_infinity_entrance_found || trigger(355)) return;
        if (!city_resident_met.kokatorimon && is_recruited(species("Kokatorimon"))) {
            load_digimon(species(168));
            set_digimon(species(168), 3, 0);
            top_map_residents_placed += 1;
        }
        unless (top_map_residents_placed != 3) return;
        store_date(date_year);
        if (date_hour >= 7 && date_hour < 19) {
            store_random(random_roll, 3);
            if (is_recruited(species("Andromon")) && random_roll <= 0 && top_map_residents_placed <= 2) {
                load_digimon(species(160));
                set_digimon(species(160), 2, 0);
                top_map_residents_placed += 1;
            }
            unless (top_map_residents_placed != 3) return;
            load_digimon(species("Yuramon"));
            set_digimon(species("Yuramon"), 0, 0);
            return;
        }
        unless (top_map_residents_placed <= 2) return;
        if (is_recruited(species("Kokatorimon")) && city_resident_met.kokatorimon && date_hour >= 4 && date_hour < 8) {
            load_digimon(species(168));
            set_digimon(species(168), 3, 0);
            top_map_residents_placed += 1;
        }
        unless (top_map_residents_placed != 3) return;
        if (is_recruited(species("Sukamon"))) {
            load_digimon(species(159));
            set_digimon(species(159), 1, 0);
        }
        return;
    }

