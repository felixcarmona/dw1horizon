From 34801f52e6bc3ea02d2f8957585248d168589e5b Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Wed, 14 Oct 2026 16:32:53 +0000
Subject: [PATCH] Layout overruns: the Tech tab's help reads TECH_VIEW_LABELS,
 the MP bonus message counts the rows it appends and the end box stops at the
 text's end (not at '0'), EAB clears its 3 rings (not 18)

---
 src/btl/battle_hud.c | 50 +++++++++++++++++++++++++++++++++++++++++---
 src/eab/eab.c        |  5 ++++-
 src/main/game_menu.c |  5 ++++-
 3 files changed, 55 insertions(+), 5 deletions(-)

diff --git a/src/btl/battle_hud.c b/src/btl/battle_hud.c
index 7a648c7..3a121aa 100644
--- a/src/btl/battle_hud.c
+++ b/src/btl/battle_hud.c
@@ -583,11 +583,49 @@ void BTL_appendCommandLearnedText(void)
 	}
 }
 
+/* MOD (end box rows): the rows the end box draws for s, walked as BTL_drawBattleEndText walks
+ * it: each row end (#R or #W; R or W between the Japanese two-byte glyphs) is one row. */
+static int16_t BTL_countEndTextRows(const char *s)
+{
+	int16_t rows = 0;
+
+	while (*s != 0) {
+#if !VERSION_IS(US)
+		if (*s == 'C') {
+			if (*++s != 0) {
+				s++;
+			}
+		} else if ((*s == 'R') || (*s == 'W')) {
+			rows++;
+			s++;
+		} else {
+			if (*++s != 0) {
+				s++;
+			}
+		}
+#else
+		if (*s++ != '#') {
+			continue;
+		}
+		if (*s == 'C') {
+			if (*++s != 0) {
+				s++;
+			}
+		} else if ((*s == 'R') || (*s == 'W')) {
+			rows++;
+			s++;
+		}
+#endif
+	}
+	return rows;
+}
+
 void BTL_appendMPBonusText(void)
 {
 	char buf[8];
 	int16_t old;
 	int16_t total;
+	char *start; /* MOD (end box rows) */
 
 	total = INITIAL_COMBAT_STATS[0].brains + STATS_GAINS.brains;
 	if (total < 0x2bc) {
@@ -618,13 +656,17 @@ void BTL_appendMPBonusText(void)
 		return;
 	}
 
+	start = BTL_END_BOX_TEXTBUFFER + strlen(BTL_END_BOX_TEXTBUFFER);
 	strcat(BTL_END_BOX_TEXTBUFFER, BTL_STR_MP_CONSUMPTION_BONUS);
 #if VERSION_IS(US)
 	strcat(BTL_END_BOX_TEXTBUFFER, BTL_STR_REDUCED_BY);
 #endif
 	strcat(BTL_END_BOX_TEXTBUFFER, buf);
 	strcat(BTL_END_BOX_TEXTBUFFER, BTL_STR_MP_BONUS_PERCENT);
-	BATTLE_END_BOX_LINE_COUNT += 4;
+	/* MOD (end box rows): the original added 4, the rows of the Japanese text ("C1...R...W...R"
+	 * + "...W"). The US text has one row end (#W), so the box waited for three rows that never
+	 * came: BTL_isEndBoxTextFinished stayed 0 and the battle never ended. */
+	BATTLE_END_BOX_LINE_COUNT += BTL_countEndTextRows(start);
 }
 
 // clang-format off
@@ -663,7 +705,7 @@ void BTL_drawBattleEndText(int32_t flag)
 			BATTLE_END_ROWS_SHOWN++;
 			BATTLE_END_ROWS_DRAWN++;
 			return;
-		case '0':
+		case '\0': /* MOD (end box rows): the original tested '0' (0x30), never a lead byte here */
 			return;
 		default:
 			glyph = BATTLE_END_CURSOR[0] | (BATTLE_END_CURSOR[1] << 8);
@@ -701,7 +743,9 @@ void BTL_drawBattleEndText(int32_t flag)
 			continue;
 		}
 		c = *BATTLE_END_CURSOR;
-		if (c == '0') {
+		/* MOD (end box rows): the original tested c == '0' (0x30), so the "0" of the US MP bonus's
+		 * "10"/"20" stopped the text for good, and the end of the text (0) was drawn as a glyph */
+		if (c == '\0') {
 			return;
 		}
 		glyph = swapShortBytes(convertAsciiToJis(c));
diff --git a/src/eab/eab.c b/src/eab/eab.c
index 546a37b..3f9638c 100644
--- a/src/eab/eab.c
+++ b/src/eab/eab.c
@@ -211,7 +211,10 @@ void EAB_initializeRings(void)
 {
 	int32_t i;
 
-	for (i = 0; i < 18; i++) {
+	/* MOD (layout overruns): the original cleared 18 rings of the 3 in EAB_D_800617D0, writing -1
+	 * over the EabState and flash buffer that follow it on the disc; in the GCC link the array is
+	 * the overlay's last data, so the 15 extra stores went past the end of EAB_REL */
+	for (i = 0; i < 3; i++) {
 		EAB_D_800617D0[i].timer = -1;
 	}
 }
diff --git a/src/main/game_menu.c b/src/main/game_menu.c
index 05b21af..dbc5857 100644
--- a/src/main/game_menu.c
+++ b/src/main/game_menu.c
@@ -2892,7 +2892,10 @@ int32_t drawMoveViewHelpStrings(void)
 		clearTextSubArea(&rect);
 	}
 
-	drawString(STATUS_VIEW_LABELS[MENU_SUB_STATE + 9], 0, MENU_SUB_STATE * 0xc + 0x18);
+	/* The original indexed STATUS_VIEW_LABELS[MENU_SUB_STATE + 9], past its 8 entries: the
+	 * help lines are TECH_VIEW_LABELS[1..8], which follow it in the original's data. GCC
+	 * places TECH_VIEW_LABELS elsewhere, so the help read garbage pointers and hung. */
+	drawString(TECH_VIEW_LABELS[MENU_SUB_STATE + 1], 0, MENU_SUB_STATE * 0xc + 0x18);
 	MENU_SUB_STATE++;
 
 	if (MENU_SUB_STATE == 8) {
-- 
2.53.0

