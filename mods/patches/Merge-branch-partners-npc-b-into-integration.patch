-		out->positionX = 25;
-		out->positionY = 55;
-		out->positionZ = 0;
-	} else {
-		out->boneId = 2;
-		out->positionX = 0;
-		out->positionY = 0;
-		out->positionZ = -110;
-	}
-	return out;
-}
