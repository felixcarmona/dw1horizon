From a9efea2d58cb7b8e2ebd683790c496323cfb9232 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Wed, 25 Nov 2026 09:24:13 +0000
Subject: [PATCH] Remove the evolution skip: START no longer cuts the evolution
 scene short, and its hint and string are gone

---
 include/dw/evl.h       |  2 --
 include/dw/mod_qol.h   |  5 ---
 src/evl/evl.c          | 62 ------------------------------------
 src/main/evl.c         | 16 ++--------
 src/main/mod_qol.c     | 71 ++----------------------------------------
 text/main/mod_qol.yaml |  5 +--
 6 files changed, 5 insertions(+), 156 deletions(-)

diff --git a/include/dw/evl.h b/include/dw/evl.h
index 625543b6..af4ed410 100644
--- a/include/dw/evl.h
+++ b/include/dw/evl.h
@@ -89,8 +89,6 @@ typedef struct {
 
 extern EvlSpark EVL_D_80068F84[];
 extern EvoSequenceData EVO_SEQUENCE_DATA;
-/* MOD (evolution skip, main evl.c): 1 the scene may be skipped, 3 armed (START up, no pause; the hint shown), 2 START asked for it (mod_qol.c modEvoSkipInput) */
-extern int8_t MOD_EVO_SKIP;
 
 extern EvoStatsGains EVOLUTION_STATS_GAINS[NUM_ORIGINAL_DIGIMON];
 extern EvolutionPath EVOLUTION_PATHS[NUM_EVOLVING_DIGIMON - 1];
diff --git a/include/dw/mod_qol.h b/include/dw/mod_qol.h
index f1c1908c..d4047711 100644
--- a/include/dw/mod_qol.h
+++ b/include/dw/mod_qol.h
@@ -17,11 +17,6 @@ void modSpeedBeforeTick(int32_t held);
 void modSpeedInput(void);
 void modSpeedPlateAdd(void);
 void modSpeedPlateRemove(void);
-/* the evolution's skip: modEvoSkipInput each tick of the scene (arms it, draws the hint's line into the text area,
-   takes START), modSkipPlate each frame while armed */
-void modEvoSkipInput(void);
-void modSkipHintDraw(void);
-void modSkipPlate(void);
 /* the tallies' skip hint: modCountHintDraw when the counting box opens (draws the line into the text area); each frame
    modCountHintRow draws the divider at y of the box (x, w) and, when show, the line centred 4 below it */
 #define MOD_COUNT_ROW_H 17 /* what the box grows by: the divider and the line under it */
diff --git a/src/evl/evl.c b/src/evl/evl.c
index 2da9a139..414aeeed 100644
--- a/src/evl/evl.c
+++ b/src/evl/evl.c
@@ -301,59 +301,6 @@ void EVL_resetSparks(void)
 	}
 }
 
-/* MOD (evolution skip): START (MOD_EVO_SKIP, main evl.c) jumps from any frame before state 3 to the end of state 2:
- * what the scene does on the way (fades, camera, shards, sparks, flashes, sounds) is left out or removed, what the
- * evolution needs is kept: the camera saved for state 3 (state 0's end), the new model loaded, EVL_applyEvolution
- * (once) and its sounds. State 3 then restores the camera, palettes, entities, map and music as always, and state 4
- * waits for the new form's animation. */
-static void EVL_modSkipToEnd(EvoSequenceData *data)
-{
-	int32_t i;
-
-	if (data->state == 0) {
-		/* state 0's end also hides the other entities and remembers who was on the map; state 3 gives that back, so
-		 * without it the table is stale (zero) and the tamer and the NPCs stay off the map for good */
-		EVL_setOtherEntitiesVisible(0);
-		setMapLayerEnabled(0);
-		EVL_D_800688E8 = GS_VIEWPOINT;
-		MAIN_D_801351E4 = DRAWING_OFFSET_X;
-		MAIN_D_801351E8 = DRAWING_OFFSET_Y;
-		MAIN_D_801351EC = VIEWPORT_DISTANCE;
-		EVL_D_80068908 = ENTITY_TABLE[1]->posData->location;
-		MAIN_D_801351F0 = ENTITY_TABLE[1]->posData->rotation;
-		loadMMDAsync(data->digimonId, 3, MAIN_D_801349E4, &data->modelData, (uint8_t *)&data->hasFinishedLoading);
-	}
-	stopSound();
-	for (i = 0; i < 16; i++) {
-		if (EVL_D_80068F84[i].bone != -1) {
-			removeObject(0x605, i);
-			EVL_D_80068F84[i].bone = -1;
-		}
-	}
-	for (i = 0; i < 30; i++) {
-		if (MAIN_D_80135208[i].timer >= 0) {
-			removeObject(0x604, i);
-			MAIN_D_80135208[i].timer = -1;
-		}
-	}
-	EVL_releaseAllParticles();
-	PARTNER_WIREFRAME_TOTAL = 0x10;
-	for (i = 0; i < 0x28; i++) {
-		PARTNER_WIREFRAME_SUB[i] = 0x10;
-	}
-	if (data->state != 2 || data->timer <= 0x11c) { /* not applied yet */
-		while (data->hasFinishedLoading != 0) {
-			tickFileReadQueue(0);
-		}
-		EVL_applyEvolution(ENTITY_TABLE[1], &PARTNER_ENTITY.digimonEntity.stats, data->para, data->evoTarget);
-		waitForSoundBufferLoading(3);
-		data->partner = (PartnerEntity *)((uint32_t)&PARTNER_ENTITY);
-		startAnimation(&PARTNER_ENTITY.digimonEntity.entity, 0);
-	}
-	data->state = 3;
-	MOD_EVO_SKIP = 0;
-}
-
 void EVL_tickEvoSequence(int32_t instanceId)
 {
 	int32_t i;
@@ -391,12 +338,6 @@ void EVL_tickEvoSequence(int32_t instanceId)
 		startAnimation(&PARTNER_ENTITY.digimonEntity.entity, 1);
 	}
 
-	modEvoSkipInput(); /* MOD (evolution skip, mod_qol.c) */
-	if (MOD_EVO_SKIP == 2 && data->state < 3) {
-		EVL_modSkipToEnd(data);
-		partner = data->partner;
-	}
-
 	switch (data->state) {
 	case 0:
 		if (frame < 0x20) {
@@ -608,9 +549,6 @@ shards:
 
 void EVL_renderEvoSequence(void)
 {
-	if (MOD_EVO_SKIP == 3 && EVO_SEQUENCE_DATA.state < 3) {
-		modSkipPlate(); /* MOD (evolution skip): the hint (mod_qol.c) */
-	}
 }
 
 void EVL_fadeClutBank0(int16_t *srcClut, void *entity, int16_t *dstClut, int32_t startFrame, int32_t endFrame, int32_t frame)
diff --git a/src/main/evl.c b/src/main/evl.c
index fbcf9425..9abcf15a 100644
--- a/src/main/evl.c
+++ b/src/main/evl.c
@@ -5,7 +5,6 @@
 #include <dw/garbage.h>
 #include <dw/graphics.h>
 #include <dw/main.h>
-#include <dw/mod_qol.h>
 #include <dw/utils.h>
 #include <dw/world_object.h>
 
@@ -18,11 +17,6 @@ void isSoundLoaded();
 void loadVLALL();
 
 int8_t IS_LOAD_EVL_COMPLETE;
-/* MOD (evolution skip): every evolution can be skipped with START (a plate says so), from the start of the scene; the
- * loading waits end at once, and the EVL overlay jumps to the evolution itself (EVL_modSkipToEnd) */
-int8_t MOD_EVO_SKIP;
-extern uint32_t POLLED_INPUT;
-extern uint32_t POLLED_INPUT_PREVIOUS;
 
 EvoSequenceData EVO_SEQUENCE_DATA;
 
@@ -37,12 +31,10 @@ void tickEvoSequenceLoading(int32_t instanceId)
 	EvoSequenceData *data;
 
 	data = &EVO_SEQUENCE_DATA;
-	(void)data;
-	modEvoSkipInput();
 
 	switch (data->state) {
 	case 0:
-		if ((evoSequenceAlwaysTrue(500) == 1) && (data->timer > 55 || MOD_EVO_SKIP == 2)) {
+		if ((evoSequenceAlwaysTrue(500) == 1) && (data->timer > 55)) {
 			data->state = 1;
 			data->timer = 0;
 			startAnimation(&PARTNER_ENTITY.digimonEntity.entity, 1);
@@ -50,7 +42,7 @@ void tickEvoSequenceLoading(int32_t instanceId)
 		}
 		break;
 	case 1:
-		if ((data->timer > 55 || MOD_EVO_SKIP == 2) && (IS_LOAD_EVL_COMPLETE == 0)) {
+		if ((data->timer > 55) && (IS_LOAD_EVL_COMPLETE == 0)) {
 			removeObject(0x809, instanceId);
 			stopBGM();
 			EVL_initEvoSequence();
@@ -72,9 +64,6 @@ void renderEvoSequenceLoading(int32_t instanceId)
 	EvoSequenceData *data;
 
 	data = &EVO_SEQUENCE_DATA;
-	if (MOD_EVO_SKIP == 3) {
-		modSkipPlate(); /* MOD (evolution skip): the hint (mod_qol.c) */
-	}
 }
 
 GARBAGE(getEvoSequenceState, 20);
@@ -104,7 +93,6 @@ int16_t isInitialized;
 	data->evoTarget = target;
 	data->heightFactor = (DIGI_PARA(data->digimonId).height << 12) /
 			     DIGI_PARA(partner->digimonEntity.entity.type).height;
-	MOD_EVO_SKIP = 1; /* MOD (evolution skip): every evolution, armed by modEvoSkipInput */
 
 	startAnimation(&PARTNER_ENTITY.digimonEntity.entity, 0);
 	stopSound();
diff --git a/src/main/mod_qol.c b/src/main/mod_qol.c
index 8d6209f9..efa3f5ae 100644
--- a/src/main/mod_qol.c
+++ b/src/main/mod_qol.c
@@ -174,77 +174,10 @@ void modShopPlateAdd(void)
 	addObject(MOD_SHOP_PLATE_OBJECT, 0, NULL, modShopPlateRender);
 }
 
-/* the evolution's skip hint: a line of the game's font (in the language shown), drawn into a row of the text area,
-   then shown each frame in the bottom right corner */
-#define MOD_SKIP_ROW 0xD8
-static int16_t MOD_SKIP_W;
-static int16_t modSkipState;
-
-void modSkipHintDraw(void)
-{
-	RECT area;
-	char *text = QOL_STR_SKIP_EVOLUTION;
-
-	setRECT(&area, 0, MOD_SKIP_ROW, 256, 12);
-	clearTextSubArea(&area);
-	setTextColor(1);
-	MOD_SKIP_W = drawStringMode(text, 0, MOD_SKIP_ROW, fitStringMode(text, 240));
-}
-
-/* each tick of the scene: armed (3, the hint drawn and shown) once START is up and no pause is open, so the START
-   that closes a pause (the lab menu evolves under it, and the scene runs under the pause) is not a skip; a pause
-   disarms it (its box reuses the text area); START while armed asks for the skip (2) */
-void modEvoSkipInput(void)
-{
-	if (MOD_EVO_SKIP == 3 && PAUSE_STATE != 0) {
-		MOD_EVO_SKIP = 1;
-	} else if (MOD_EVO_SKIP == 1 && PAUSE_STATE == 0 && !(POLLED_INPUT & 0x800)) {
-		MOD_EVO_SKIP = 3;
-		modSkipHintDraw();
-	} else if (MOD_EVO_SKIP == 3 && (POLLED_INPUT & 0x800)) {
-		MOD_EVO_SKIP = 2;
-	} else if (MOD_EVO_SKIP == 3 && (EVO_SEQUENCE_DATA.state != modSkipState || (EVO_SEQUENCE_DATA.timer & 15) == 0)) {
-		modSkipHintDraw(); /* the scene's own loads reach the text area (the new form's textures): drawn again */
-	}
-	modSkipState = EVO_SEQUENCE_DATA.state;
-}
-
-/* one copy of the line, its colour (r, g, b) multiplying the font's white (0x80 = as drawn) */
-static void modSkipLine(int32_t x, int32_t y, int32_t r, int32_t g, int32_t b, int32_t layer)
-{
-	POLY_FT4 *p = (POLY_FT4 *)GsGetWorkBase();
-
-	initStringFT4(p);
-	setRGB0(p, r, g, b);
-	setUVDataPolyFT4(p, 0, MOD_SKIP_ROW, MOD_SKIP_W, 12);
-	setPosDataPolyFT4(p, x, y, MOD_SKIP_W, 12);
-	AddPrim(ACTIVE_ORDERING_TABLE->org + layer, p++);
-	GsSetWorkBase((PACKET *)p);
-}
-
-/* bottom right, no plate: light grey letters with a dark outline (the line eight times in black around it), so it
-   reads on the black close-up and on the white flash alike (owner's choice B, 2026-10-24) */
-void modSkipPlate(void)
-{
-	int32_t x = 0x98 - MOD_SKIP_W;
-	int32_t y = 0x68;
-	int32_t dx;
-	int32_t dy;
-
-	modSkipLine(x, y, 0x68, 0x68, 0x68, 4);
-	for (dy = -1; dy <= 1; dy++) {
-		for (dx = -1; dx <= 1; dx++) {
-			if (dx != 0 || dy != 0) {
-				modSkipLine(x + dx, y + dy, 0, 0, 0, 5);
-			}
-		}
-	}
-}
-
 /* the tallies' skip hint (patch 0333): "Press × to skip" in a row of its own at the bottom of the box that counts (the
    gym's stats box, the battle's bits box), under a divider like the battle box's. The line is drawn once into a row of
-   the text area when the box opens (the evolution's row: never on screen together), its button in the colour of the
-   button that confirms: × blue (6), with JAPANESE CONTROLS the font draws it as ○ (modButtonGlyph), red (3) */
+   the text area when the box opens, its button in the colour of the button that confirms: × blue (6), with JAPANESE
+   CONTROLS the font draws it as ○ (modButtonGlyph), red (3) */
 #define MOD_COUNT_ROW 0xD8
 #define MOD_COUNT_MAX_W 168
 static int16_t MOD_COUNT_W;
diff --git a/text/main/mod_qol.yaml b/text/main/mod_qol.yaml
index a9f956e1..eeb9b363 100644
--- a/text/main/mod_qol.yaml
+++ b/text/main/mod_qol.yaml
@@ -1,11 +1,8 @@
-# MOD (quality of life; language): the evolution's and the tallies' skip hints, ours (not the game's), keyed so a text source can
+# MOD (quality of life; language): the tallies' skip hint, ours (not the game's), keyed so a text source can
 # translate it (key main.QOL_STR_*). `storage: define`: a literal where src/main/mod_qol.c uses it.
 MOD_QOL:
   storage: define
   strings:
-    QOL_STR_SKIP_EVOLUTION:
-      ja: "Press START to skip the animation"
-      en_us: "Press START to skip the animation"
     QOL_STR_SKIP_COUNT: # △ is the Shift-JIS character of 81A2, the code the font draws as × (docs/mods/options.md)
       ja: "Press △ to skip"
       en_us: "Press △ to skip"
-- 
2.55.0

