From 2d0ef4257a6b007bf3a1c8654af75e2cada786bb Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Tue, 24 Nov 2026 20:00:00 +0000
Subject: [PATCH] Cups: Dragon's Roar and Jungle Troopers, the two Fields left
 out of the Field cups

---
 src/dget/dget.c              | 10 +++++-----
 src/main/script_common.c     |  6 ++++--
 src/std/std_setup.c          |  8 ++++----
 text/main/script_common.yaml |  6 ++++++
 4 files changed, 19 insertions(+), 11 deletions(-)

diff --git a/src/dget/dget.c b/src/dget/dget.c
index 77a27f0..2a61f13 100644
--- a/src/dget/dget.c
+++ b/src/dget/dget.c
@@ -92,15 +92,15 @@ static void *dget_sbss_order[] = {
 	&DGET_BUFFER,
 };
 
-/* MOD (cup rules): Rookie, Champion, Ultimate, Mega; Vaccine, Data, Virus; the six Fields */
-#define NEW_CUP_COUNT	13
+/* MOD (cup rules): Rookie, Champion, Ultimate, Mega; Vaccine, Data, Virus; the eight Fields */
+#define NEW_CUP_COUNT	15
 /*
  * one character each, as the calendar's cells hold (the original's are single letters too): 1..4 the level cups by their
- * order, V E U Vaccine, Data, Virus, and in small letters the Fields: n d s g e b (Nature Spirits, Deep Savers, Nightmare
- * Soldiers, Wind Guardians, Metal Empire, Virus Busters)
+ * order, V E U Vaccine, Data, Virus, and in small letters the Fields: n d s g e b r j (Nature Spirits, Deep Savers,
+ * Nightmare Soldiers, Wind Guardians, Metal Empire, Virus Busters, Dragon's Roar, Jungle Troopers)
  */
 static char NEW_CUP_GRADES[NEW_CUP_COUNT][2] = {
-	"1", "2", "3", "4", "V", "E", "U", "n", "d", "s", "g", "e", "b",
+	"1", "2", "3", "4", "V", "E", "U", "n", "d", "s", "g", "e", "b", "r", "j",
 };
 
 void fillEnabledTournamentTable(void)
diff --git a/src/main/script_common.c b/src/main/script_common.c
index 352ad6b..73c91e1 100644
--- a/src/main/script_common.c
+++ b/src/main/script_common.c
@@ -470,8 +470,8 @@ int32_t modLoadCardImage(int32_t id, void *buffer)
 	                           buffer, (id < 66 ? id : id - 66) * 14, 14);
 }
 
-/* MOD (cup rules): 36 names, was 23: the cups 23..35 */
-char *TOURNAMENT_NAMES[36] = {
+/* MOD (cup rules): 38 names, was 23: the cups 23..37 */
+char *TOURNAMENT_NAMES[38] = {
 	STR_TOURNAMENT_NAME_GRADE_D,
 	STR_TOURNAMENT_NAME_GRADE_C,
 	STR_TOURNAMENT_NAME_GRADE_B,
@@ -508,6 +508,8 @@ char *TOURNAMENT_NAMES[36] = {
 	STR_TOURNAMENT_NAME_WIND_GUARDIANS_CUP,
 	STR_TOURNAMENT_NAME_METAL_EMPIRE_CUP,
 	STR_TOURNAMENT_NAME_VIRUS_BUSTERS_CUP,
+	STR_TOURNAMENT_NAME_DRAGONS_ROAR_CUP,
+	STR_TOURNAMENT_NAME_JUNGLE_TROOPERS_CUP,
 };
 
 char *TOURNAMENT_GRADES[23] = {
diff --git a/src/std/std_setup.c b/src/std/std_setup.c
index cce5264..d82a1cc 100644
--- a/src/std/std_setup.c
+++ b/src/std/std_setup.c
@@ -150,7 +150,7 @@ static void *std_setup_sbss_order[] = {
 };
 
 // clang-format off
-/* MOD (cup rules): 36 rows, was 24: the cups 23..35 (tools/balance.py writes them from content/tables/tournaments.json) */
+/* MOD (cup rules): 38 rows, was 24: the cups 23..37 (tools/balance.py writes them from content/tables/tournaments.json) */
 int16_t STD_OPPONENT_BASE_STATS[24] = {
 	0x0064, 0x0096, 0x00c8, 0x00fa, 0x012c, 0x0000, 0x00c8, 0x00c8,
 	0x00c8, 0x00c8, 0x00c8, 0x00fa, 0x00fa, 0x00fa, 0x00fa, 0x00fa,
@@ -158,10 +158,10 @@ int16_t STD_OPPONENT_BASE_STATS[24] = {
 };
 /* MOD (cup rules): the same number for the cups after the original's, 23 onwards (content/tables/tournament-rules.json,
  * newCupStats; balance.py writes it here). */
-int16_t STD_NEW_CUP_BASE_STATS[13] = {
-	150, 200, 250, 220, 250, 250, 250, 250, 250, 250, 250, 250, 250,
+int16_t STD_NEW_CUP_BASE_STATS[15] = {
+	150, 200, 250, 220, 250, 250, 250, 250, 250, 250, 250, 250, 250, 250, 250,
 };
-#define STD_NEW_CUPS		13
+#define STD_NEW_CUPS		15
 #define STD_NEW_CUP_SECTORS	17
 static char STD_PATH_NEW_CUPS[] = "\\STDDAT\\GRADE\\NEWCUPS.BIN";
 
diff --git a/text/main/script_common.yaml b/text/main/script_common.yaml
index e92f327..dd0acd3 100644
--- a/text/main/script_common.yaml
+++ b/text/main/script_common.yaml
@@ -373,6 +373,12 @@ TOURNAMENT_NAMES:
     STR_TOURNAMENT_NAME_VIRUS_BUSTERS_CUP:
       ja: ウイルスバスターズカップ
       en_us: Virus Busters Cup
+    STR_TOURNAMENT_NAME_DRAGONS_ROAR_CUP:
+      ja: ドラゴンズロアーカップ
+      en_us: Dragon's Roar Cup
+    STR_TOURNAMENT_NAME_JUNGLE_TROOPERS_CUP:
+      ja: ジャングルトルーパーズカップ
+      en_us: Jungle Troopers Cup
 
 TOURNAMENT_GRADES:
   strings:
