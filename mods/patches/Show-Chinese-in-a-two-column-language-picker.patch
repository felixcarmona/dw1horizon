 			(*modOptionW(r, k)) = w < 0xFF ? w : 0xFF;
 			if (k == 0) {
 				MOD_OPT_LABEL_W = w > MOD_OPT_LABEL_W ? w : MOD_OPT_LABEL_W;
@@ -6290,37 +6305,48 @@ static void renderOptionsMenu(void)
