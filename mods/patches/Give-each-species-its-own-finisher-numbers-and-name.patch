diff --git a/src/main/mod_species.c b/src/main/mod_species.c
index d40ca35..f2e9ec2 100644
--- a/src/main/mod_species.c
+++ b/src/main/mod_species.c
@@ -78,10 +78,64 @@ static SpeciesMoveBalance SPECIES_MOVE_BALANCE[SPECIES_BALANCE_SWAP_MAX];
 static int32_t SPECIES_MOVE_BALANCES;
 static Move SPECIES_MOVE_COPY;
 
+SpeciesFinisher SPECIES_FINISHERS[4];
+/* the partner's finisher name in the current language: key (type + 1) | MOD_LANG << 12 */
+static int32_t SPECIES_FINISHER_NAME_KEY;
+static uint8_t SPECIES_FINISHER_NAME_TECH;
+static char SPECIES_FINISHER_NAME[28];
+extern char *MOVE_NAMES[];
+
+SpeciesRecord *modLoadFinisher(int32_t slot, int32_t type)
+{
+	SpeciesFinisher *f = &SPECIES_FINISHERS[slot];
+	SpeciesRecord *rec = getSpeciesRecord(type);
+
+	f->tech = 0;
+	if (rec != NULL && (rec->finisherFlags & SPECIES_FINISHER_PRESENT)) {
+		f->type = type;
+		f->tech = rec->finisherTech;
+		f->flags = rec->finisherFlags;
+		f->move = rec->finisherMove;
+	}
+	return rec;
+}
+
+static SpeciesFinisher *findFinisher(int32_t type, int32_t move)
+{
+	SpeciesFinisher *f;
+
+	for (f = SPECIES_FINISHERS; f < SPECIES_FINISHERS + 4; f++) {
+		if (f->tech != 0 && f->tech == move && f->type == type) return f;
+	}
+	return NULL;
+}
+
+char *modMoveName(int32_t type, int32_t move)
+{
+	SpeciesRecord *rec;
+	int32_t key = (type + 1) | MOD_LANG << 12;
+
+	if (SPECIES_FINISHER_NAME_KEY != key) {
+		SPECIES_FINISHER_NAME_KEY = key;
+		SPECIES_FINISHER_NAME_TECH = 0;
+		rec = modLoadFinisher(0, type);
+		if (rec != NULL && rec->finisherName != 0) {
+			SPECIES_FINISHER_NAME_TECH = rec->finisherTech;
+			key = rec->finisherNameOffset;
+			readSpeciesSector(rec->finisherNameSector + MOD_LANG * rec->finisherNameStride);
+			memcpy(SPECIES_FINISHER_NAME, (uint8_t *)SPECIES_SECTOR + key, sizeof(SPECIES_FINISHER_NAME));
+		}
+	}
+	return (move == SPECIES_FINISHER_NAME_TECH && move != 0) ? SPECIES_FINISHER_NAME : MOVE_NAMES[move];
+}
+
 Move *modSpeciesMove(int32_t type, int32_t move)
 {
 	int32_t i;
 	SpeciesMoveBalance *b;
+	SpeciesFinisher *f = findFinisher(type, move);
+
+	if (f != NULL) return &f->move;
 	for (i = 0; i < SPECIES_MOVE_BALANCES; i++) {
 		b = &SPECIES_MOVE_BALANCE[i];
 		if (b->type != type || b->move != move) continue;
