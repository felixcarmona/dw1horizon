From 7bd698c43bd71fe9480963d1efe7fea7b226824d Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Fri, 27 Nov 2026 07:26:15 +0000
Subject: [PATCH] Field twins keep their original's script animations, and the
 stub ends cleanly

ShogunGekomon and the other field twins (npcSpeciesType) were trimmed with the imported species' slots, so a script animation of the original type became the one-frame stub. The stub had no key at frame 1: tickAnimation took its end word for one and read on past the model, writing momentum for bones that do not exist. ShogunGekomon's first meeting in Volume Villa froze there (GsGetLw on a broken bone chain).

The keep masks store one word each (slots 32 and up are always kept), which pays for the code.
---
 src/main/npc_anim_keep.c | 36 +++++++++++++++++-------------------
 src/main/npc_anim_trim.c | 23 ++++++++++++++---------
 2 files changed, 31 insertions(+), 28 deletions(-)

diff --git a/src/main/npc_anim_keep.c b/src/main/npc_anim_keep.c
index a9759bbb..70d057ba 100644
--- a/src/main/npc_anim_keep.c
+++ b/src/main/npc_anim_keep.c
@@ -2,25 +2,25 @@
  * MOD (memreclaim): animation slots each Digimon type keeps when it is
  * loaded as an NPC (heap model).
  * GENERATED by tools/npcanims.py gen from DG.SCN, MAPHEAD.SCN and the .MAP
- * files; do not edit (see that tool for the rules). Slot s is bit s % 32
- * of word s / 32 of NPC_ANIM_KEEP_MASKS[NPC_ANIM_KEEP_INDEX[type]].
+ * files; do not edit (see that tool for the rules). Slot s < 32 is bit s
+ * of NPC_ANIM_KEEP_MASKS[NPC_ANIM_KEEP_INDEX[type]]; slots 32 and up are always kept.
  */
 #include <dw/types.h>
 
-const uint32_t NPC_ANIM_KEEP_MASKS[13][2] = {
-	{ 0xFFFFFFFF, 0xFFFFFFFF },
-	{ 0xF008001F, 0xFFFFFFFF },
-	{ 0xF04C001F, 0xFFFFFFFF },
-	{ 0xF008081F, 0xFFFFFFFF },
-	{ 0xF008183F, 0xFFFFFFFF },
-	{ 0xF008003F, 0xFFFFFFFF },
-	{ 0xF008801F, 0xFFFFFFFF },
-	{ 0xF048001F, 0xFFFFFFFF },
-	{ 0xF008011F, 0xFFFFFFFF },
-	{ 0xF028381F, 0xFFFFFFFF },
-	{ 0xF008009F, 0xFFFFFFFF },
-	{ 0xF348001F, 0xFFFFFFFF },
-	{ 0xF028001F, 0xFFFFFFFF },
+const uint32_t NPC_ANIM_KEEP_MASKS[13] = {
+	0xFFFFFFFF,
+	0xF008001F,
+	0xF04C001F,
+	0xF008081F,
+	0xF008183F,
+	0xF008003F,
+	0xF008801F,
+	0xF048001F,
+	0xF008011F,
+	0xF028381F,
+	0xF008009F,
+	0xF348001F,
+	0xF028001F,
 };
 
 const uint8_t NPC_ANIM_KEEP_INDEX[180] = {
@@ -45,6 +45,4 @@ const uint8_t NPC_ANIM_KEEP_INDEX[180] = {
 };
 
 /* Shared by imported species, including script-only slots. */
-const uint32_t NPC_ANIM_IMPORT_KEEP[2] = {
-	0xF008001F, 0xFFFFFFFF
-};
+const uint32_t NPC_ANIM_IMPORT_KEEP = 0xF008001F;
diff --git a/src/main/npc_anim_trim.c b/src/main/npc_anim_trim.c
index 3bb3f504..ed05ab6a 100644
--- a/src/main/npc_anim_trim.c
+++ b/src/main/npc_anim_trim.c
@@ -33,8 +33,8 @@ typedef struct {
 	int32_t last;		/* ... by the last one */
 } NpcTrimStats;
 
-extern const uint32_t NPC_ANIM_IMPORT_KEEP[2];
-extern const uint32_t NPC_ANIM_KEEP_MASKS[][2];
+extern const uint32_t NPC_ANIM_IMPORT_KEEP;
+extern const uint32_t NPC_ANIM_KEEP_MASKS[];	/* slots 32 and up are always kept */
 extern const uint8_t NPC_ANIM_KEEP_INDEX[NUM_ORIGINAL_DIGIMON];
 NpcTrimStats MOD_NPC_TRIM_STATS;
 int32_t MOD_NPC_STUB_HITS;	/* startAnimation landed on a stub (should stay 0) */
@@ -107,13 +107,15 @@ int32_t compactNpcModel(int32_t type, uint8_t *mmd, int32_t size)
 	int32_t stubBytes;
 	int16_t *anim0;
 	int16_t *stub;
-	const uint32_t *mask;
+	uint32_t mask;
 
 	if ((type < 0) || (type >= SPECIES_COUNT)) {
 		return size;
 	}
-	mask = type < NUM_ORIGINAL_DIGIMON
-		? NPC_ANIM_KEEP_MASKS[NPC_ANIM_KEEP_INDEX[type]] : NPC_ANIM_IMPORT_KEEP;
+	/* a field twin (npcSpeciesType) plays its original's script animations */
+	i = npcSpeciesType(type, 1);
+	mask = i < NUM_ORIGINAL_DIGIMON
+		? NPC_ANIM_KEEP_MASKS[NPC_ANIM_KEEP_INDEX[i]] : NPC_ANIM_IMPORT_KEEP;
 	tab = (uint32_t *)(mmd + ((uint32_t *)mmd)[1]);
 	animBytes = size - ((uint32_t *)mmd)[1];
 
@@ -135,7 +137,7 @@ int32_t compactNpcModel(int32_t type, uint8_t *mmd, int32_t size)
 		if ((o == 0) || (o & COLD_ANIM_FLAG)) {
 			continue;
 		}
-		isKept = (mask[i >> 5] >> (i & 31)) & 1;
+		isKept = ((mask >> (i & 31)) | (i >> 5)) & 1;	/* i < 64 */
 		for (j = 0; (j < ns) && (starts[j] != o); j++);
 		if (j == ns) {
 			for (k = ns++; (k > 0) && (starts[k - 1] > o); k--) {
@@ -154,10 +156,12 @@ int32_t compactNpcModel(int32_t type, uint8_t *mmd, int32_t size)
 		}
 	}
 
-	/* the stub: frame count 1, slot 0's first pose, end */
+	/* the stub: frame count 1, slot 0's first pose, an empty key at frame 1, end
+	 * (tickAnimation reads an instruction at frame 1: without the key it would take
+	 * the end word for one and run on into the bytes after the model) */
 	anim0 = (int16_t *)((uint8_t *)tab + tab[0]);
 	poseWords = (DIGI_PARA(type).boneCount - 1) * ((anim0[0] & 0x8000) ? 9 : 6);
-	stubBytes = (poseWords + 2) * 2;
+	stubBytes = (poseWords + 3) * 2;
 	if (dropped < (uint32_t)stubBytes + 16) {
 		return size;
 	}
@@ -186,7 +190,8 @@ int32_t compactNpcModel(int32_t type, uint8_t *mmd, int32_t size)
 	stub = (int16_t *)((uint8_t *)tab + pos);
 	stub[0] = (anim0[0] & 0x8000) | 1;
 	copyDown16((uint16_t *)&stub[1], (uint16_t *)&anim0[1], poseWords);
-	stub[poseWords + 1] = 0;
+	stub[poseWords + 1] = 1;
+	stub[poseWords + 2] = 0;
 	pos += stubBytes;
 
 	return ((uint8_t *)tab - mmd) + pos;
-- 
2.55.0

