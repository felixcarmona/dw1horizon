From 4d519da240921deb4018e1135e2701d524bf8bb8 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Sat, 21 Nov 2026 23:37:59 +0000
Subject: [PATCH] Tamer looks: small hands, and a scroll bar on the Look page

A twelfth byte of the tamer's state chooses small hands: after the model is in
memory the two hand objects' corners move to three quarters of their distance
from the wrist. The Look page gains the Hands row and a scroll bar beside its
boxes in place of the marks above and below them. The loader's first test reads
the state as three words, which makes the main executable smaller.
---
 config/us/overlay.ld   |  2 +-
 include/dw/save_tags.h |  2 +-
 include/dw/species.h   |  5 +++--
 src/main/game_menu.c   | 39 +++++++++++++++++++++------------------
 src/main/mod_species.c | 37 ++++++++++++++++++++++++++++++++-----
 text/main/mod_lab.yaml |  9 +++++++++
 6 files changed, 67 insertions(+), 27 deletions(-)

diff --git a/config/us/overlay.ld b/config/us/overlay.ld
index 9073937..564ef02 100644
--- a/config/us/overlay.ld
+++ b/config/us/overlay.ld
@@ -345,7 +345,7 @@ SECTIONS
              * KAR again), so the Player tab reads EVL to open the page. Its text is MENU's. */
             look_ui_START = .;
             BUILD_DIR/src/main/game_menu.c.o(.text.lookPage* .rodata.lookPage* .bss.lookPageState);
-            BUILD_DIR/src/main/mod_species.c.o(.text.lookTamerLoad .text.lookHairPalette .text.lookShirtPalette
+            BUILD_DIR/src/main/mod_species.c.o(.text.lookTamerLoad .text.lookTamerHands .text.lookHairPalette .text.lookShirtPalette
                 .rodata.lookShirtObjects .bss.lookShirtRecipe .bss.lookShirtRow);
             BUILD_DIR/src/main/model.c.o(.text.lookTamerRelook);
             . = ALIGN(., 4);
diff --git a/include/dw/save_tags.h b/include/dw/save_tags.h
index e516a73..40d9ca8 100644
--- a/include/dw/save_tags.h
+++ b/include/dw/save_tags.h
@@ -35,7 +35,7 @@
 #define SAVE_TAG_GROUND_PICKUP_BITS	0x000C /* bit array: stable ground pickup IDs collected today; registry content/ground-items.json */
 #define SAVE_TAG_CARD_COUNTS		0x000D /* nibbles for card ids 66..511, low nibble first */
 #define SAVE_TAG_CARD_STOCK		0x000E /* u16[6] daily shop cards, 0xffff sold */
-#define SAVE_TAG_TAMER_LOOK		0x000F /* MOD_TAMER_STATE: u8 look (0 = the original tamer), hair colour, face, shirt (0 = the original), shirt colour, trousers, their colour, shoes, their colour, backpack (0 = the original, 1 = none), its colour; older saves end earlier */
+#define SAVE_TAG_TAMER_LOOK		0x000F /* MOD_TAMER_STATE: u8 look (0 = the original tamer), hair colour, face, shirt (0 = the original), shirt colour, trousers, their colour, shoes, their colour, backpack (0 = the original, 1 = none), its colour, hands (1 = small); older saves end earlier */
 #define SAVE_TAG_REQUIRED		0x8000
 #define SAVE_TAG_TECHNIQUE_LAYOUT	0x8003 /* u8: 1 = option A animation slots; required to prevent silent downgrade substitution */
 /* engine tier 2 */
diff --git a/include/dw/species.h b/include/dw/species.h
index c0c5d76..5e00b42 100644
--- a/include/dw/species.h
+++ b/include/dw/species.h
@@ -346,8 +346,8 @@ int32_t getDigimonModelRef(int32_t type, char **file, int32_t *sector, int32_t *
 #define TAMER_HAIR_COUNT	20
 #define TAMER_FACE_COUNT	2	/* the faces of looks 1..: one texture each (tools/tamer_looks/face.py) */
 /* What the player chose, in the order of the Look page's rows and of the save record */
-#define TAMER_STATE_SIZE	11
-extern uint8_t MOD_TAMER_STATE[TAMER_STATE_SIZE] __attribute__((section(".sbss")));
+#define TAMER_STATE_SIZE	12
+extern uint8_t MOD_TAMER_STATE[TAMER_STATE_SIZE] __attribute__((section(".sbss"), aligned(4)));
 #define MOD_TAMER_LOOK		MOD_TAMER_STATE[0]
 #define MOD_TAMER_HAIR		MOD_TAMER_STATE[1]
 #define MOD_TAMER_FACE		MOD_TAMER_STATE[2]
@@ -356,6 +356,7 @@ extern uint8_t MOD_TAMER_STATE[TAMER_STATE_SIZE] __attribute__((section(".sbss")
 #define MOD_TAMER_TROUSERS	MOD_TAMER_STATE[5]
 #define MOD_TAMER_SHOES		MOD_TAMER_STATE[7]
 #define MOD_TAMER_PACK		MOD_TAMER_STATE[9]
+#define MOD_TAMER_HANDS		MOD_TAMER_STATE[11]	/* 1 = small hands */
 /* The clothes (tools/tamer_looks/shirts.py, legs.py, shoes.py): a shirt is the torso and the arms of any look, a
