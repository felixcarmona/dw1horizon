Subject: [PATCH] Blend imported poor-condition field idle transitions

---
 src/main/smooth_runtime.inc | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/main/smooth_runtime.inc b/src/main/smooth_runtime.inc
index 84a89db0..58477573 100644
--- a/src/main/smooth_runtime.inc
+++ b/src/main/smooth_runtime.inc
@@ -23,7 +23,8 @@ int32_t MOD_SMOOTH_FLOOR_ADJUSTS __attribute__((section(".bss.modSmoothStats")))
 
 static int32_t smoothSlot(int32_t s)
 {
-    return s==0 || s==2 || s==3 || s==4 || s==5 || s==18;
+    /* Slot1 is the poor-condition field idle, selected by setPartnerIdle. */
