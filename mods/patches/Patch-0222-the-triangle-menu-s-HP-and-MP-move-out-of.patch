From 62573da470fafda3d1eb2bc54342cd204764265f Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Sat, 24 Oct 2026 18:07:24 +0000
Subject: [PATCH] Patch 0222: the triangle menu's HP and MP move out of the box
 to the top right of the screen, drawn as the battle HUD draws them (frame,
 heart / MP icon, fill, current value; renderMenuVitals with the ETC texture's
 sprites, resident on the field), only while the menu is open; the box back to
 its original size and centred on the screen (triangleMenuShift: 25 pixels
 down without the fishing row, 6 with it; its lines, header, date digits,
 icons and cursor with it). Replaces 0221's rows in the box. 1184 bytes of
 heap (0221 was 1296). Tested in PCSX-Redux without the fishing row: 800/600
 and 520/170, the cursor on both rows

---
 src/main/game_menu.c | 156 ++++++++++++++++++++-----------------------
 1 file changed, 71 insertions(+), 85 deletions(-)

diff --git a/src/main/game_menu.c b/src/main/game_menu.c
index dfce3c51..ac3de870 100644
--- a/src/main/game_menu.c
+++ b/src/main/game_menu.c
@@ -1532,10 +1532,13 @@ void addGameMenu(void)
 	addObject(0xfa4, 0, (void (*)(int32_t))tickTriangleMenu, NULL);
 }
 
-/* MOD (vitals): the partner's HP and MP at the foot of the triangle menu, each a row "icon  current/max" over a bar.
-   Only what the menu already has in VRAM: the Status page's heart and MP icons (SYSTEM_W, tpage 5), the Year/Day
-   digits (tpage 0x1e), lines and flat boxes; nothing in the text area */
-#define MENU_VITALS_H 0x2c
+/* MOD (centred): the triangle menu's box centred on the screen (the original's top was -0x50 with or without the
+   fishing row: 25 pixels high without it, which put it against the HP and MP over it); everything in it moves down
+   by this */
+static int16_t triangleMenuShift(void)
+{
+	return HAS_FISHING_ROD != 0 ? 0x50 - 0x95 / 2 : 0x50 - 0x6e / 2;
+}
 
 void tickTriangleMenu(void)
 {
@@ -1544,12 +1547,11 @@ void tickTriangleMenu(void)
 	rect = MENU_TEXT_AREA;
 	switch (TRIANGLE_MENU_STATE) {
 	case 0:
-		/* MOD (vitals): MENU_VITALS_H taller, the partner's HP and MP under the commands (renderMenuVitals) */
 		if (HAS_FISHING_ROD != 0) {
-			createMenuBox(0, -0x42, -0x50, 0x84, 0x95 + MENU_VITALS_H, 2,
+			createMenuBox(0, -0x42, -0x50 + triangleMenuShift(), 0x84, 0x95, 2,
 			              tickGameMenu, renderGameMenu);
 		} else {
-			createMenuBox(0, -0x42, -0x50, 0x84, 0x6e + MENU_VITALS_H, 2,
+			createMenuBox(0, -0x42, -0x50 + triangleMenuShift(), 0x84, 0x6e, 2,
 			              tickGameMenu, renderGameMenu);
 		}
 		if (UI_BOX_DATA[0].frame == 4) {
@@ -1634,26 +1636,26 @@ void closeUIBoxIfOpen(id)
 	}
 }
 
-/* one of the menu's 7 x 12 digits (as renderDateDigits) */
-static void renderMenuDigit(int32_t x, int32_t y, int32_t digit)
+/* MOD (vitals): while the triangle menu is open, the partner's HP and MP at the top right of the screen, outside the
+   box, as the battle HUD draws them (its sprites in the ETC texture, tpage 0x1e, are resident on the field) */
+static void renderVitalsSprite(int32_t x, int32_t y, int32_t w, int32_t h, int32_t u, int32_t v, int32_t uw,
+                               int32_t vh, int32_t clutY, int32_t z)
 {
-	int16_t texX;
-	int16_t texY;
+	POLY_FT4 *prim;
 
-	texY = 0x34;
-	if (digit == 0) {
-		texX = 0x78;
-	} else if (digit < 5) {
-		texX = (digit - 1) * 8 + 0x60;
-		texY = 0x28;
-	} else {
-		texX = (digit - 5) * 8 + 0x50;
-	}
-	renderRectPolyFT4(x, y, 7, 0xc, texX + 1, texY + 0xc0, 0x1e, 0x7f10, 5, 0);
+	prim = (POLY_FT4 *)GsGetWorkBase();
+	SetPolyFT4(prim);
+	prim->tpage = GetTPage(0, 0, 896, 256);
+	prim->clut = GetClut(0x100, clutY);
+	setRGB0(prim, 0x80, 0x80, 0x80);
+	setUVWH(prim, u, v, uw, vh);
+	setXYWH(prim, x, y, w, h);
+	AddPrim(ACTIVE_ORDERING_TABLE->org + z, prim++);
+	GsSetWorkBase((PACKET *)prim);
 }
 
-/* `value` with its last digit ending at `right`; returns where its first digit starts */
-static int32_t renderMenuDigits(int32_t right, int32_t y, int32_t value)
+/* the battle HUD's 7 x 11 digits (STD_renderNumber), the last ending at `right` */
+static void renderVitalsDigits(int32_t right, int32_t y, int32_t value, int32_t z)
 {
 	int32_t digits[6];
 	int32_t count;
@@ -1661,75 +1663,52 @@ static int32_t renderMenuDigits(int32_t right, int32_t y, int32_t value)
 
 	convertValueToDigits(5, value, &count, digits);
 	for (i = 0; i < count; i++) {
-		right -= 9;
-		renderMenuDigit(right + 2, y, digits[i]);
+		right -= 7;
+		renderVitalsSprite(right, y, 7, 11, digits[i] * 7, 172, 7, 11, 492, z);
 	}
-	return right + 2;
 }
 
-/* "current/max" ending at x 0x3c; the slash drawn as lines in the digits' white with their dark outline */
-static void renderMenuVitalRow(int32_t y, int32_t iconU, int32_t current, int32_t max, uint8_t r, uint8_t g, uint8_t b)
+/* one battle HUD bar (STD_renderFighterStatusBars): frame, icon, the fill stretched to 50 px at most and the
+   current value in its box */
+static void renderVitalsBattleBar(int32_t x0, int32_t y0, int32_t mp, int32_t current, int32_t max)
 {
-	int32_t x;
-	int32_t w;
-
-	if (current < 0)
-		current = 0;
-	if (current > max)
-		current = max;
-	renderRectPolyFT4(-0x3c, y + 2, 0xb, 0xb, iconU, 0x3a + 0x80, 5, GetClut(0x60, 0x0b + 0x1e8), 5, 0);
-	x = renderMenuDigits(0x3d, y, max) - 8;
-	drawLine2P(0xf0f0f0, x + 5, y + 1, x + 1, y + 10, 5, 0);
-	drawLine2P(0xf0f0f0, x + 6, y + 1, x + 2, y + 10, 5, 0);
-	drawLine2P(0x101010, x + 4, y + 1, x, y + 10, 5, 0);
-	drawLine2P(0x101010, x + 7, y + 1, x + 3, y + 10, 5, 0);
-	renderMenuDigits(x - 1, y, current);
-	/* the bar: fill first, a later box on the same layer is drawn under it */
-	w = max > 0 ? current * 0x6a / max : 0;
-	if (w > 0) {
-		renderBox(-0x2e, y + 0xd, w, 1, r + (0xFF - r) / 3, g + (0xFF - g) / 3, b + (0xFF - b) / 3, 0, 5);
-		renderBox(-0x2e, y + 0xe, w, 2, r, g, b, 0, 5);
+	renderVitalsDigits(x0 + 0x49 + 28, y0 - 3, current, 8);
+	/* fill first: a later sprite on the same layer is drawn under it */
+	if (current > 0) {
+		renderVitalsSprite(x0 + 0x12, y0 + 3, current * 50 / max, 2, mp ? 0x84 : 0x80, 0xb0, 2, 2, 0x1eb, 8);
 	}
-	renderBox(-0x2e, y + 0xd, 0x6a, 1, 0x70, 0x70, 0x70, 0, 5);
-	renderBox(-0x2e, y + 0xe, 0x6a, 2, 0x58, 0x58, 0x58, 0, 5);
+	renderVitalsSprite(x0 + 3, y0 - 2, 11, 11, mp ? 0x9b : 0x90, 0xb0, 11, 11, 0x1eb, 8);
+	renderVitalsSprite(x0, y0, 0x68, 8, 0x80, 0xa8, 0x68, 8, 0x1ec, 8);
 }
 
-/* under the commands, from the box's original foot */
 static void renderMenuVitals(void)
 {
-	Line lines[2];
-	int32_t top;
 	int32_t hp;
 	int32_t maxHp;
-	uint8_t r;
-	uint8_t g;
+	int32_t mpv;
+	int32_t maxMp;
 
-	top = -0x50 + (HAS_FISHING_ROD != 0 ? 0x95 : 0x6e);
-	lines[0] = GAME_MENU_LINES[0];
-	lines[1] = GAME_MENU_LINES[1];
-	lines[0].y1 = lines[0].y2 = top;
-	lines[1].y1 = lines[1].y2 = top + 1;
-	renderSeparatorLines(lines, 2, 5);
 	hp = PARTNER_ENTITY.digimonEntity.stats.current.currentHP;
 	maxHp = PARTNER_ENTITY.digimonEntity.stats.base.hp;
-	/* HP green, yellow under half, red under a quarter; MP blue */
-	if (hp * 4 < maxHp) {
-		r = 0xE0;
-		g = 0x30;
-	} else if (hp * 2 < maxHp) {
-		r = 0xE0;
-		g = 0xC0;
-	} else {
-		r = 0x30;
-		g = 0xC8;
-	}
-	renderMenuVitalRow(top + 5, 0x93, hp, maxHp, r, g, 0x28);
-	renderMenuVitalRow(top + 0x18, 0x9e, PARTNER_ENTITY.digimonEntity.stats.current.currentMP,
-	                   PARTNER_ENTITY.digimonEntity.stats.base.mp, 0x30, 0x80, 0xF0);
+	mpv = PARTNER_ENTITY.digimonEntity.stats.current.currentMP;
+	maxMp = PARTNER_ENTITY.digimonEntity.stats.base.mp;
+	if (maxHp <= 0 || maxMp <= 0)
+		return;
+	if (hp < 0)
+		hp = 0;
+	if (hp > maxHp)
+		hp = maxHp;
+	if (mpv < 0)
+		mpv = 0;
+	if (mpv > maxMp)
+		mpv = maxMp;
+	renderVitalsBattleBar(0x24, -0x64, 0, hp, maxHp);
+	renderVitalsBattleBar(0x24, -0x58, 1, mpv, maxMp);
 }
 
 void renderGameMenu(void)
 {
+	Line lines[2];
 	GameMenuSprite *sprite;
 	int32_t digitCount;
 	int32_t digits[6];
@@ -1738,12 +1717,19 @@ void renderGameMenu(void)
 	int16_t yOffset;
 	int32_t i;
 
-	renderSeparatorLines(GAME_MENU_LINES, 2, 5);
+	/* MOD (centred): moved down by triangleMenuShift */
+	lines[0] = GAME_MENU_LINES[0];
+	lines[1] = GAME_MENU_LINES[1];
+	lines[0].y1 += triangleMenuShift();
+	lines[0].y2 += triangleMenuShift();
+	lines[1].y1 += triangleMenuShift();
+	lines[1].y2 += triangleMenuShift();
+	renderSeparatorLines(lines, 2, 5);
 	renderDateDigits();
 	renderMenuVitals(); /* MOD (vitals) */
-	yOffset = 0;
+	yOffset = triangleMenuShift();
 	if (MENU_OPTION_COUNT == 7) {
-		yOffset = -0x28;
+		yOffset -= 0x28;
 	}
 	sprite = &MENU_OPTIONS[1];
 	renderTriangleCursor((int8_t)MENU_OPTIONS[0].unknown, yOffset);
@@ -1773,13 +1759,13 @@ void renderGameMenu(void)
 		                  disabled);
 	}
 #if !VERSION_IS(US)
-	renderString(3, 7, -0x49, 0xc, 0xc, 0, 0xe8, 6, 1);
-	renderString(3, 0x2c, -0x49, 0xc, 0xc, 0xc, 0xe8, 6, 1);
