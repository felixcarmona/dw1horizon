 		                  texY + 0xc0, 0x1e, 0x7f10, 5, 0);
 	}
 
@@ -1819,7 +1805,7 @@ void renderDateDigits(void)
 		} else {
 			texX = (digits[i] - 5) * 8 + 0x50;
 		}
-		renderRectPolyFT4((2 - i) * 9 - 0x16, -0x4a, 8, 0xc, texX,
+		renderRectPolyFT4((2 - i) * 9 - 0x16, -0x4a + triangleMenuShift(), 8, 0xc, texX,
 		                  texY + 0xc0, 0x1e, 0x7f10, 5, 0);
 	}
 }
@@ -1845,7 +1831,7 @@ void renderDateDigits(void)
 		} else {
 			texX = (digits[i] - 5) * 8 + 0x50;
 		}
-		renderRectPolyFT4(0x25 + j * 9, -0x4a, 7, 0xc, texX + 1,
+		renderRectPolyFT4(0x25 + j * 9, -0x4a + triangleMenuShift(), 7, 0xc, texX + 1,
 		                  texY + 0xc0, 0x1e, 0x7f10, 5, 0);
 	}
 
@@ -1860,7 +1846,7 @@ void renderDateDigits(void)
 		} else {
 			texX = (digits[i] - 5) * 8 + 0x50;
 		}
-		renderRectPolyFT4(-0x16 + j * 9, -0x4a, 7, 0xc, texX + 1,
+		renderRectPolyFT4(-0x16 + j * 9, -0x4a + triangleMenuShift(), 7, 0xc, texX + 1,
