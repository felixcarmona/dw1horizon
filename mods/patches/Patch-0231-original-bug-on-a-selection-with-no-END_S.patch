From 5012bf8240efbc8bb626a91946702799c65d1550 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Sat, 24 Oct 2026 21:55:34 +0000
Subject: [PATCH] Patch 0231: original bug, cancel on a selection with no
 END_SELECTION ran misaligned script bytes. scriptShowSelection skipped 2 bytes
 after the text as the 12 00 marker it expected; 23 selections of the disc have
 none (11 already block cancel with trigger 49). Of the other 12, most stop on an
 invalid opcode or end the section; Piximon's Training Manual sale decodes as
 STORE_DATE into p0, so prosperity and the tournament day and cup were
 overwritten with the date. The marker is checked; without it cancel is refused
 (the error sound, as under trigger 49): those questions take an answer. 48 bytes
 of heap
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 src/main/script_textbox.c | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/src/main/script_textbox.c b/src/main/script_textbox.c
index bd634097..119f29dd 100644
--- a/src/main/script_textbox.c
+++ b/src/main/script_textbox.c
@@ -267,7 +267,8 @@ int32_t tickSelectionDialogue(void)
 	}
 
 	if (isKeyDown(CANCEL_BUTTON)) {
-		if (isTriggerSet(0x31) == 0) {
+		if (isTriggerSet(0x31) == 0 &&
+		    (ACTIVE_INSTRUCTION == SCRIPT_OP_CALL_ROUTINE || DIALOGUE_SELECTION.endPointer != NULL)) { /* MOD (cancel) */
 			if (ACTIVE_INSTRUCTION != SCRIPT_OP_CALL_ROUTINE) {
 				advanceTextbox(0);
 				SCRIPT_POINTER = DIALOGUE_SELECTION.endPointer;
@@ -1252,8 +1253,15 @@ void scriptShowSelection(void)
 	}
 #endif
 
-	SCRIPT_POINTER += 2;
-	DIALOGUE_SELECTION.endPointer = SCRIPT_POINTER;
+	/* MOD (cancel): the original skipped 2 bytes as the END_SELECTION (12 00) every selection was thought to end with; 23
+	 * of the disc's have none, so △ ran their next instruction from its third byte (Piximon's Buy, Meteormon,
+	 * WaruMonzaemon...). Without the marker there is no cancel path: △ is refused as under trigger 49. */
+	if (SCRIPT_POINTER[0] == 0x12 && SCRIPT_POINTER[1] == 0) {
+		SCRIPT_POINTER += 2;
+		DIALOGUE_SELECTION.endPointer = SCRIPT_POINTER;
+	} else {
+		DIALOGUE_SELECTION.endPointer = NULL;
+	}
 
 	if (CURRENT_DIALOGUE_OWNER != 0xff) {
 		DIALOGUE_SELECTION.cursorOffsetY = 0xd;
-- 
2.55.0

