From 2eeb3067c1c0dea707c4f183fc4376376e90f27e Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Fri, 27 Nov 2026 13:15:27 +0000
Subject: [PATCH] Smooth motion: the clock and the care bars slide in and out
 at every frame

modTickLerp draws a value that moves once per tick between its value before the tick and after it, at the fraction
of the tick a render pass shows. The clock's and the care bars' x are kept from before lateTickGameClock's slide;
renderStatusBars takes the x to draw at (the training overlay passes 75), and the condition ring keeps clear of the
clock where it is drawn.
---
 include/dw/clock.h      |  1 +
 include/dw/mod_fps.h    |  4 ++++
 src/main/bubble.c       |  2 +-
 src/main/clock.c        | 30 +++++++++++++++++++++---------
 src/main/main.c         |  6 ++++++
 src/main/partner_impl.c | 12 ++++++------
 src/trn/trn_block.h     |  8 ++------
 7 files changed, 41 insertions(+), 22 deletions(-)

diff --git a/include/dw/clock.h b/include/dw/clock.h
index a5f523f..0afe4fd 100644
--- a/include/dw/clock.h
+++ b/include/dw/clock.h
@@ -14,6 +14,7 @@ extern uint16_t PLAYTIME_MINUTES;
 extern uint16_t PLAYTIME_HOURS;
 extern uint16_t SUBFRAME_COUNT;
 extern int16_t CLOCK_OFFSET_X;
+int32_t modClockX(void); /* MOD (smooth motion): the x a render pass draws the clock at */
 
 void initializeClockData(void);
 void addClock(void);
diff --git a/include/dw/mod_fps.h b/include/dw/mod_fps.h
index 317db09..695ebea 100644
--- a/include/dw/mod_fps.h
+++ b/include/dw/mod_fps.h
@@ -98,5 +98,9 @@ void modSmoothForget(int32_t instance);
 void modSmoothMapReset(void);
 void modInterpUnapplyEntity(int32_t entityId);
 void modInterpInvalidate(void);
+/* MOD (smooth motion): a value that moves once per tick (prev before the tick, cur after it) drawn at the fraction of
+ * the tick this render pass shows; cur itself at 20 fps and on a tick's last pass */
+int32_t modTickLerp(int32_t prev, int32_t cur);
+extern int32_t MOD_FPS_TICKS; /* ticks presented: one more during a tick's render passes than during its logic */
 
 #endif
diff --git a/src/main/bubble.c b/src/main/bubble.c
index dd2a1b1..cb62cd4 100644
--- a/src/main/bubble.c
+++ b/src/main/bubble.c
@@ -834,7 +834,7 @@ static void renderConditionRing(int32_t x, int32_t y, int32_t depth,
 		int32_t screenLeft = x + ((left * k) >> 16) + DRAWING_OFFSET_X;
 		int32_t screenRight = x + ((right * k) >> 16) + DRAWING_OFFSET_X;
 		int32_t inset = 3;
-		int32_t clockRight = CLOCK_OFFSET_X + 160 + 50;
+		int32_t clockRight = modClockX() + 160 + 50;
 		/* The sliding clock occupies the upper-left corner, including its
 		 * digital plate. Its HUD origin is fixed at 160, independent of the
 		 * world camera offset. Keep the group beside those visible pixels. */
diff --git a/src/main/clock.c b/src/main/clock.c
index c3d01a6..0433bd8 100644
--- a/src/main/clock.c
+++ b/src/main/clock.c
@@ -21,7 +21,7 @@ void updateTimeOfDay();
 int32_t isFishing();
 void addTamerLevel(int32_t chance, int32_t amount);
 void updateBGM();
-void renderStatusBars(int32_t isGameTimeRunning);
+void renderStatusBars(int32_t x);
 void modStrengthMarks(void); /* btl.c: MOD (danger mark) */
 void tickStatusBarsSlide(int32_t isGameTimeRunning);
 
@@ -57,6 +57,9 @@ int16_t MOD_CLOCK[MOD_CLOCK_SIZE] = { -1 };       /* MOD (clock as data): writte
 static int32_t CLOCK_ACC;                       /* the fraction of a frame the clock owes (in 1/(2 x day ticks)) */
 int16_t CLOCK_OFFSET_X;
 int8_t IS_GAMETIME_RUNNING;
+extern int16_t STATUS_UI_OFFSET_X;
+/* MOD (smooth motion): the clock's and the status bars' x before this tick's slide */
+static int16_t modSlidePrev[2];
 
 static void *clock_sbss_order[] = {
 	&IS_GAMETIME_RUNNING,
@@ -245,6 +248,8 @@ void initializeClockData(void)
  * move them. */
 void lateTickGameClock(int32_t instanceId)
 {
+	modSlidePrev[0] = CLOCK_OFFSET_X;
+	modSlidePrev[1] = STATUS_UI_OFFSET_X;
 	if (IS_GAMETIME_RUNNING == 0) {
 		CLOCK_OFFSET_X -= 50;
 	} else {
@@ -335,10 +340,17 @@ static void renderDigitalClock(int32_t x, int32_t y)
 	addClockDigit(x + 27, y, minute % 10);
 }
 
+/* MOD (smooth motion): the clock's x this render pass shows (the ring keeps clear of it too) */
+int32_t modClockX(void)
+{
+	return modTickLerp(modSlidePrev[0], CLOCK_OFFSET_X);
+}
+
 void renderGameClock(int32_t instanceId)
 {
 	uint8_t isNight;
 	uint8_t frame;
+	int32_t x = modClockX();
 
 	if (MOD_DAYTIME[MOD_DT_CLOCK_TO] < 0 || (HOUR >= MOD_DAYTIME[MOD_DT_CLOCK_FROM] && HOUR < MOD_DAYTIME[MOD_DT_CLOCK_TO])) {
 		isNight = 0;
@@ -348,31 +360,31 @@ void renderGameClock(int32_t instanceId)
 
 	frame = (CURRENT_FRAME % 16) / 4;
 
-	renderRectPolyFT4(CLOCK_OFFSET_X - 2, -90, 16, 16, 192, 224,
+	renderRectPolyFT4(x - 2, -90, 16, 16, 192, 224,
 			  GetTPage(0, 0, 896, 448), GetClut(256, 497), 9, 0);
 
-	renderRectPolyFT4(CLOCK_OFFSET_X + 34, -90, 16, 16, 192, 240,
+	renderRectPolyFT4(x + 34, -90, 16, 16, 192, 240,
 			  GetTPage(0, 0, 896, 448), GetClut(256, 497), 9, 0);
 
-	renderRectPolyFT4(CLOCK_OFFSET_X + 8, -100, 32, 16,
+	renderRectPolyFT4(x + 8, -100, 32, 16,
 			  CLOCK_TEXCOORD_U[isNight][frame],
 			  CLOCK_TEXCOORD_V[isNight][frame],
 			  GetTPage(0, 0, 896, 448), GetClut(256, 498), 9, 0);
 
-	renderRectPolyFT4(CLOCK_OFFSET_X, -88, 48, 40, 208, 215,
+	renderRectPolyFT4(x, -88, 48, 40, 208, 215,
 			  GetTPage(0, 0, 896, 448), GetClut(256, 496), 10, 0);
 
-	CLOCK_SPRITE.x = CLOCK_OFFSET_X + 23;
+	CLOCK_SPRITE.x = x + 23;
 	GsSortSprite(&CLOCK_SPRITE, ACTIVE_ORDERING_TABLE, 9);
 
-	renderRectPolyFT4(CLOCK_OFFSET_X + HOUR_POINT_X[HOUR],
+	renderRectPolyFT4(x + HOUR_POINT_X[HOUR],
 			  HOUR_POINT_Y[HOUR] - 88,
 			  6, 6, 203, 216,
 			  GetTPage(0, 0, 896, 448), GetClut(256, 497), 9, 0);
 
-	renderDigitalClock(CLOCK_OFFSET_X + 6, -46);
+	renderDigitalClock(x + 6, -46);
 
-	renderStatusBars(IS_GAMETIME_RUNNING);
+	renderStatusBars(modTickLerp(modSlidePrev[1], STATUS_UI_OFFSET_X));
 	modStrengthMarks();
 }
 
diff --git a/src/main/main.c b/src/main/main.c
index ef900a8..8744449 100644
--- a/src/main/main.c
+++ b/src/main/main.c
@@ -4229,6 +4229,12 @@ int32_t MOD_FPS_TICKS;
 int32_t MOD_FPS_RENDERS;
 int32_t MOD_RENDER_PASS;
 int32_t MOD_RENDER_ALPHA = 4096; /* MOD (status-bubbles): the fraction of the tick this render pass shows (4096 = the tick's own state) */
+
+int32_t modTickLerp(int32_t prev, int32_t cur)
+{
+	return prev + (((cur - prev) * MOD_RENDER_ALPHA) >> 12);
+}
+
 /* effect render scripts not rolled back on an extra pass for lack of room
  * (BTL_renderEFEEngine): expected to stay 0 */
 int32_t MOD_FPS_EFE_NO_ROOM;
diff --git a/src/main/partner_impl.c b/src/main/partner_impl.c
index 2eb98b5..3d24f6a 100644
--- a/src/main/partner_impl.c
+++ b/src/main/partner_impl.c
@@ -479,7 +479,7 @@ void skipHours(int32_t hours);
 #endif
 void handlePostBattleTiredness(void);
 void tickConditions(void);
-void renderStatusBars(int32_t state);
+void renderStatusBars(int32_t x);
 void setImmortalHour(void);
 
 static void *partner_impl_functions[] = {
@@ -2373,7 +2373,7 @@ void tickStatusBarsSlide(int32_t state)
    frame, its icon on the frame's left cap and the native blue fill. Up to 15 FT4 packets, 600 bytes of the
    existing frame buffer. Every fill is the same blue: no colour change, blink or tint; the condition bubbles
    carry the warnings. */
-static void renderCareHUD(void)
+static void renderCareHUD(int32_t x0)
 {
 	int32_t i, value, max, icon, x, y, pixels, clut;
 	for (i = 0; i < 5; i++) {
@@ -2408,7 +2408,7 @@ static void renderCareHUD(void)
 			value = max - PARTNER_PARA.tiredness;
 		}
 		/* 56 pixels wide (a 30-pixel slot), right edge where the original bars end */
-		x = STATUS_UI_OFFSET_X + 20;
+		x = x0 + 20;
 		y = 49 + i * 12;
 		if (value < 0)
 			value = 0;
@@ -2430,11 +2430,11 @@ static void renderCareHUD(void)
 }
 
 // clang-format off
-void renderStatusBars(state)
-	int8_t state;
+void renderStatusBars(x)
+	int32_t x;
 // clang-format on
 {
-	renderCareHUD();
+	renderCareHUD(x); /* MOD (smooth motion): the bars' x this render pass shows */
 }
 
 void setImmortalHour(void)
diff --git a/src/trn/trn_block.h b/src/trn/trn_block.h
index 289976a..0da1d7c 100644
--- a/src/trn/trn_block.h
+++ b/src/trn/trn_block.h
@@ -75,15 +75,11 @@ static int32_t TB_box2Y(void)
 /* The clock slides the field gauges away while training pauses game time.
    Render the existing live HUD from the gym object without changing that clock state. */
 extern int16_t STATUS_UI_OFFSET_X;
-void renderStatusBars(int32_t state);
+void renderStatusBars(int32_t x); /* x: where the bars are drawn (smooth motion) */
 void TB(renderCareHUD)(int32_t instanceId)
 {
-	int16_t saved;
 	if (!IS_GAMETIME_RUNNING) {
-		saved = STATUS_UI_OFFSET_X;
-		STATUS_UI_OFFSET_X = 75;
-		renderStatusBars(1);
-		STATUS_UI_OFFSET_X = saved;
+		renderStatusBars(75);
 	}
 }
 
-- 
2.55.0

