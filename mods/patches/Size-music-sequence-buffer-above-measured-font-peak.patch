From b463efb59c6b41ef1254460576eb6986778b608a Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Fri, 6 Nov 2026 04:18:21 +0000
Subject: [PATCH] Size the resident music sequence buffer above the measured
 font peak

---
 include/dw/memmap.h | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/include/dw/memmap.h b/include/dw/memmap.h
index 55ef8f9..3fe68da 100644
--- a/include/dw/memmap.h
+++ b/include/dw/memmap.h
@@ -149,9 +149,10 @@
 /*
  * The SEQ block of the current music font (every track of it), copied from
  * the FAALL chunk (sound.c). Original 0x5800 (font 0xB uses 0x55F8); the
- * extra 0x2800 bytes come out of the malloc3 heap (MIN_HEAP assert below).
+ * largest built font uses 0x7284 bytes. A 0x7800 buffer leaves 0x57c
+ * bytes above that peak and returns 0x800 bytes to the malloc3 heap.
  */
-#define SEQ_BUFFER_SIZE		0x8000
+#define SEQ_BUFFER_SIZE		0x7800
 
 /*
  * SPU RAM (512 KB, sound.c): what the sound banks may use. Below it the
-- 
