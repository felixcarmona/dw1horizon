+/* MOD (item effects as data): written by tools/balance.py from the items' "effect" blocks (content/items/*.json); id -1 = unused */
+int16_t MOD_ITEM_FX[MOD_ITEM_FX_ROWS][MOD_FX_WIDTH] = { [0 ... MOD_ITEM_FX_ROWS - 1] = { [0 ... MOD_FX_WIDTH - 1] = -1 } };
+
+const int16_t *itemFx(int32_t itemId)
+{
+	int32_t i;
+
+	for (i = 0; i < MOD_ITEM_FX_ROWS; i++) {
+		if (MOD_ITEM_FX[i][0] == itemId) {
+			return MOD_ITEM_FX[i];
+		}
+	}
+	return NULL;
+}
