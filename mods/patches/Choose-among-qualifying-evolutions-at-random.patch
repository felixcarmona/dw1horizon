 include/dw/evolution.h   |   7 +-
 src/main/evolution.c     | 185 +++++++++++++--------------------------
 src/main/game_menu.c     |   7 +-
 src/main/partner_impl.c  |   6 +-
 text/main/game_menu.yaml |   3 +
 6 files changed, 77 insertions(+), 132 deletions(-)

