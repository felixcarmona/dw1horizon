+
+	x = UI_BOX_DATA[3].finalPos.x;
+	y = UI_BOX_DATA[3].finalPos.y;
+	v = TEXTBOX_DATA.box[3].vramRow * 12;
+	renderHorizontalLine(3, 4, 0x17, 0x7a);
+	renderInsetWithoutBox(3, 0x55, 0x2a, 0x1a, 0xe);
+	renderString(0, x + 0x1a, y + 7, 0x60, 0xc, 0, v, 3, 1);
+	if (AMOUNT_KIND == 1) {
+		renderItemSprite(SHOP_ITEM_TYPE, x + 8, y + 5, 3);
+		renderItemSprite(MOJYA_GOT, x + 8, y + 0x19, 3);
+		renderString(0, x + 0x1a, y + 0x1b, 0x60, 0xc, 0x60, v, 3, 1);
+		renderString(0, x + 0x59, y + 0x2b, 0x18, 0xc, 0xc0, v, 3, 1);
+	} else {
+		renderHorizontalLine(3, 0xc, 0x3c, 0x6a);
+		renderCardSprite(0, x + 10, y + 7, 3);
+		renderString(0, x + 0x4a, y + 0x1b, 0x3c, 0xc, 0x60, v, 3, 1);
+		renderString(0, x + 0x59, y + 0x2b, 0x18, 0xc, 0x9c, v, 3, 1);
+		renderString(0, x + 0x40, y + 0x41, 0x48, 0xc, 0xb4, v, 3, 1);
+	}
+}
+
+static void openAmountBox(int32_t kind)
+{
+	RECT rect;
+	RECT origin;
+
+	AMOUNT_KIND = kind;
+	SHOP_AMOUNT = 1;
+	NAMING_CURRENT_LETTER = 1;
+	setInputRepeatMask(0x5000);
+	/* the trade's question changes the dialogue box's page, so its row is past the list's (9..16 with both pages) */
+	updateItemMenuSubTextboxLine();
+	if (kind == 1) {
+		ITEM_MENU_SUB_TEXTBOX_LINE = 17;
+	}
+	setupBoxOrigin(readPStat(PSTAT_254), &origin);
+	if (kind == 1) {
+		setRECT(&rect, -0x41, -0x14, 0x82, 0x3e);
+	} else {
+		setRECT(&rect, -0x41, -0x2a, 0x82, 0x53);
+	}
+	createTextbox(3, 0xc1, &rect, &origin, tickAmountBox, renderAmountBox);
+	registerTextbox(3, ITEM_MENU_SUB_TEXTBOX_LINE, 1, 0, 0);
+	amountBoxString();
+	playSound(0, 3);
+}
+
+/*
+ * MOD (amounts): what a purchase of packs gave, all at once: every card a row (the card list's: rarity, name, colour 7
+ * and NEW when it was not in the collection before the purchase, how many came), the rarest first; a head with how
+ * many cards and how many new. The first rows come in one by one with a sound (a new card's is brighter), ✕ or △ shows
+ * them all; then UP / DOWN scroll, the card under the cursor shown at the left at half size (its picture, CARD.ALL,
+ * read as the Player screen's card list reads it, loadCardImage, to VRAM 576,256, free on the field; but into the
+ * end of TEXTURE_BUFFER, whose start holds the list, allocateArray's), turning over as
+ * it comes, and ✕ or △ closes (rollCardPack's case 10). The cards are counted into the
+ * collection as the original's dialogue boxes count them (showCardTextbox: up to MOD_ECON_CARD_MAX copies).
+ */
+uint8_t MOD_PACK_RESULTS;
+static uint8_t PACK_SHOWN;
+static uint8_t PACK_TICK;
+static uint8_t PACK_ART;  /* the card whose picture is shown (0xff none) */
+static uint8_t PACK_FLIP; /* 0..4: the picture turns over as it comes */
+extern char MAIN_D_80123E78[]; /* "\\CARD\\CARD.ALL" */
+extern uint32_t ARRAY_SECTION_OFFSET;
+int32_t loadStackedTIMEntry(char *path, void *buffer, int32_t offset, int32_t sectors);
+
+static void tickPackResults(void)
+{
+	ItemMenuBox *box;
+
+	box = ITEM_MENU_LEFT;
+	if (UI_BOX_DATA[1].state != 1 || isItemMenuBoxBusy(box) != 0) {
+		return;
+	}
+
+	if (PACK_SHOWN < box->itemCount && PACK_SHOWN < box->visibleRows) {
+		if (isKeyDown(CONFIRM_BUTTON | CANCEL_BUTTON)) {
+			PACK_SHOWN = 0xff;
+		} else if (++PACK_TICK >= 4) {
+			PACK_TICK = 0;
+			playSound(0, (box->buf[PACK_SHOWN * 2 + 1] & 0x80) ? 3 : 2);
+			PACK_SHOWN++;
+		}
+		return;
+	}
+	PACK_SHOWN = 0xff;
+	if (box->buf[(box->topRow + box->cursor) * 2] != PACK_ART) {
+		PACK_ART = box->buf[(box->topRow + box->cursor) * 2];
+		if (ARRAY_SECTION_OFFSET <= TEXTURE_BUFFER_SIZE - 0xe * 0x800) {
+			loadStackedTIMEntry(MAIN_D_80123E78, TEXTURE_BUFFER + TEXTURE_BUFFER_SIZE - 0xe * 0x800, PACK_ART * 0xe, 0xe);
+		}
+		PACK_FLIP = 0;
+	} else if (PACK_FLIP < 4) {
+		PACK_FLIP++;
+	}
+
+	if (isKeyDown(CONFIRM_BUTTON | CANCEL_BUTTON)) {
+		triggerBoxCloseFlag(1);
+		playSound(0, 4);
+		SCRIPT_STATE_2 = 10;
+	} else if (isKeyDown(0x1000)) {
+		itemMenuCursorUp(box, 1);
+	} else if (isKeyDown(0x4000)) {
+		itemMenuCursorDown(box, 1);
+	}
+}
+
+static void renderPackResults(void)
+{
+	ItemMenuBox *box;
+	TextBoxData *text;
+	int32_t u;
+	int32_t w;
+	int16_t v;
+	int16_t bx;
+	int16_t by;
+	uint8_t count;
+
+	box = ITEM_MENU_LEFT;
+	text = &TEXTBOX_DATA.box[1];
+	bx = UI_BOX_DATA[1].finalPos.x;
+	by = UI_BOX_DATA[1].finalPos.y;
+	getVRAMModeCoords(text->vramMode, &u, &w);
+	v = (9 + text->backPage * text->vramRows) * 12;
+	renderString(0, bx + 0xc, by + 5, 0xc0, 0xc, u, v, 5, 1);
+	renderHorizontalLine(1, 4, 0x15, 0xd7);
+	renderItemMenuScrollBar(box);
+	count = box->itemCount;
+	if (PACK_SHOWN < count) {
+		box->itemCount = PACK_SHOWN;
+	} else {
+		renderSelectionCursor(bx + 5, by + box->cursor * 0x12 + 0x19, 0xca, 0x12, 5);
+	}
+	renderItemMenuItemList(box, bx + 0x1a, by + 0x1b, bx + 8, by + 0x1a, 1);
+	box->itemCount = count;
+
+	if (PACK_ART != 0xff && UI_BOX_DATA[1].state == 1) {
+		POLY_FT4 *prim;
+
+		w = (75 * PACK_FLIP + 2) / 4;
+		prim = (POLY_FT4 *)GsGetWorkBase();
+		SetPolyFT4(prim);
+		setRGB0(prim, 0x80, 0x80, 0x80);
+		prim->tpage = GetTPage(1, 0, 576, 256);
+		prim->clut = GetClut(448, 511);
+		setUVDataPolyFT4(prim, 0, 0, 150, 180);
+		setPosDataPolyFT4(prim, bx - 0x50 + (75 - w) / 2, by + 0x14, w, 90);
+		AddPrim(ACTIVE_ORDERING_TABLE->org + 5, prim++);
+		GsSetWorkBase((PACKET *)prim);
+	}
+}
+
+static void openPackResults(void)
+{
+	RECT rect;
+	RECT origin;
+	uint8_t *got;
+	uint8_t *out;
+	int32_t i;
+	int32_t r;
+	int32_t n;
+	int32_t fresh;
+
+	got = (uint8_t *)allocateArray(NUM_CARDS * 2);   /* how many came, the copies before */
+	for (i = 0; i < NUM_CARDS; i++) {
+		got[i] = 0;
+		got[NUM_CARDS + i] = getCardAmount(i);
+	}
+	for (i = SHOP_AMOUNT * 3; i > 0; i--) {
+		r = rollCard();
+		if (got[r] < 99) {
+			got[r]++;
+		}
+		n = getCardAmount(r);
+		if (n < econAmt(MOD_ECON_CARD_MAX)) {
+			setCardAmount(r, n + 1);
+		}
+	}
+
+	allocateItemMenuBox(&ITEM_MENU_LEFT, NUM_CARDS * 2, 5, 0xd2, 0x1c, 6, 0x56);
+	out = ITEM_MENU_LEFT->buf;
+	fresh = 0;
+	for (r = 0; r < 5; r++) {
+		for (i = 0; i < NUM_CARDS; i++) {
+			if (got[i] != 0 && CARD_DATA[i].spriteId == r) {
+				n = got[NUM_CARDS + i] == 0;
+				fresh += n;
+				*out++ = i;
+				*out++ = got[i] | (n << 7);
+			}
+		}
+	}
+	freeArray((uint32_t *)got);
+	ITEM_MENU_LEFT->itemCount = (out - ITEM_MENU_LEFT->buf) / 2;
+
+	/* the head: row 9 of both pages, the box's first, before the rows of cards (drawn from it on, a row ends at 0xd) */
+	for (r = 9; r < 9 + 2 * 6; r += 6) {
+		out = TEXTBOX_LINES_PTR + (r << 6);
+		out = intToStringSJIS(out, SHOP_AMOUNT * 3, 3, 1);
+		strcpy(out, STR_PACK_CARDS);
+		out += strlen(STR_PACK_CARDS);
+		out = intToStringSJIS(out, fresh, 2, 1);
+		strcpy(out, STR_PACK_NEW);
+		out += strlen(STR_PACK_NEW);
+		*out = 0xd;
+	}
+
+	MOD_PACK_RESULTS = 1;
+	ITEM_MENU_TYPE = 4;
+	PACK_SHOWN = 0;
+	PACK_TICK = 0;
+	PACK_ART = 0xff;
+	triggerBoxCloseFlag(0);
+	setInputRepeatMask(0x5000);
+	setupBoxOrigin(readPStat(PSTAT_254), &origin);
+	setRECT(&rect, -0x44, -0x40, 0xde, 0x7a);
+	createTextbox(1, 0xf1, &rect, &origin, tickPackResults, renderPackResults);
+	registerTextbox(1, 9, 6, 1, 0);
+	initItemMenuBox(ITEM_MENU_LEFT, 1, 0xa);
+	updateItemMenuStrings(ITEM_MENU_LEFT, 0xa, 1);
+}
