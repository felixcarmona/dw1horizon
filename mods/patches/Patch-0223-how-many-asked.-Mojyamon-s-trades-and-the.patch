+/*
+ * MOD (amounts): how many, asked in an amount box drawn like the shop's (box 3, script_common.c): UP / DOWN one,
+ * by ten with ALT, round from 1 to the most (modAmountStep), □ the most, CONFIRM_BUTTON (✕) takes it, CANCEL_BUTTON (△) none.
+ *   1, Mojyamon's trades (openMojyamonShop): the item given and its name, the item got and its name, the amount;
+ *      ✕ goes to case 5 (the trade), △ to case 6 (his goodbye, as the original's No)
+ *   2, card packs (rollCardPack): "Card pack", the price, the amount and what they cost; ✕ goes to case 9, △ to 8
+ * The text is one row (ITEM_MENU_SUB_TEXTBOX_LINE: the dialogue box's spare page, row 17 for a trade), in columns: names at 0 and
+ * 0x60, the trade's amount at 0xc0; the pack's price at 0x60, amount at 0x9c and cost at 0xb4 (as the shop's).
+ */
+static uint8_t AMOUNT_KIND;
+
+static uint8_t *amountName(uint8_t *out, char *name)
+{
+	int32_t code;
+
+	code = textFitCode(name, ITEM_FIELD_W);
+	if (code != 1) {
+		*out++ = code;
+		*out++ = 0xff;
+	}
+	strcpy(out, name);
+
+	return out + strlen(name);
+}
+
+static void amountBoxString(void)
+{
+	uint8_t *out;
+
+	out = TEXTBOX_LINES_PTR + (ITEM_MENU_SUB_TEXTBOX_LINE << 6);
+	if (AMOUNT_KIND == 1) {
+		out = amountName(out, ITEM_NAME(SHOP_ITEM_TYPE));
+		*out++ = TEXT_COLUMN;
+		*out++ = 0x60;
+		out = amountName(out, ITEM_NAME(MOJYA_GOT));
+		*out++ = TEXT_COLUMN;
+		*out++ = 0xc0;
+	} else {
+		out = amountName(out, STR_CARD_PACK);
+		*out++ = 0x18;
+		*out++ = 0;
+		out = intToStringSJIS(out, SHOP_ITEM_PRICE, 5, 0);
+		*out++ = 0x19;
+		*out++ = 0;
+	}
+	out = intToStringSJIS(out, SHOP_AMOUNT, 2, 0);
+	if (AMOUNT_KIND != 1) {
+		*out++ = 0x1a;
+		*out++ = 0;
+		out = intToStringSJIS(out, SHOP_ITEM_PRICE * SHOP_AMOUNT, 6, 0);
+	}
+	*out++ = 0;
+	*out = 0;
+	TEXTBOX_DATA.box[3].pageReady = 1;
+	TEXTBOX_DATA.box[3].writeCount++;
+}
+
+static void tickAmountBox(void)
+{
+	if (UI_BOX_DATA[3].state != 1) {
+		return;
+	}
+
+	if (isXPressedAfterDialogue() == 0) {
+		return;
+	}
+
+	if (modAmountStep() != 0) {
+		amountBoxString();
+		return;
+	}
+
+	if (isKeyDown(0x80)) {
+		SHOP_AMOUNT = MAX_SHOP_AMOUNT;
+		playSound(0, 2);
+		amountBoxString();
+		return;
+	}
+
+	if (isKeyDown(CONFIRM_BUTTON)) {
+		SCRIPT_STATE_2 = AMOUNT_KIND == 1 ? 5 : 9;
+		playSound(0, 3);
+	} else if (isKeyDown(CANCEL_BUTTON)) {
+		SCRIPT_STATE_2 = AMOUNT_KIND == 1 ? 6 : 8;
+		playSound(0, 4);
+	} else {
+		return;
+	}
+	triggerBoxCloseFlag(3);
+}
+
