From f5f5313de3148042216162bc7a77b3fa71ff009b Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Wed, 21 Oct 2026 22:04:06 +0000
Subject: [PATCH] Patch 0155: the care menu sorted by urgency, with HP/MP and
 notes. The list is most urgent first with the cursor on it: Scold, the cures
 of what it has (the surest first: Medicine before Bandage), the Port. potty,
 food when hungry (its favourite first), what restores HP or MP short of the
 maximum (field items: itemColor 0 or 2), Sleep. Its favourite food's name is
 gold, and the description box gets a second line when there is something to
 know: "Its favourite food!" (gold), "It may not cure its sickness." / "its
 wound." (red, a cure with a chance under the die). Commands' names in white.
 The description moves to text rows 0xC0/0xCC (32 entries fill 16 rows of
 names). Comment: every other use of X on the map comes first

---
 src/main/mod_feed.c | 194 ++++++++++++++++++++++++++++++++++++--------
 1 file changed, 160 insertions(+), 34 deletions(-)

diff --git a/src/main/mod_feed.c b/src/main/mod_feed.c
index 115bf1c9..e9cd9524 100644
--- a/src/main/mod_feed.c
+++ b/src/main/mod_feed.c
@@ -3,16 +3,18 @@
  *
  * On the map, with the tamer facing the partner (within 45 degrees) and close enough (its item take distance plus
  * FEED_SLACK, as checkEatDistance measures), X opens a box laid out as the inventory's (two columns of icon, name
- * and amount, the description box under it) with what the partner's condition asks for, every need at once:
- * the triangle menu's commands a need asks for first, Scold when a scolding is fair (ITEM_SCOLD_FLAG 1: it refused
- * an item out of indiscipline, it pooped on the ground) and Sleep when it is sleepy, then in inventory order the
- * items that answer a need it has, nothing it does not need: food only when hungry (ITEM_FUNCTIONS[type] ==
- * handleFood), the Port. potty when it needs to go, what cures an injury or a sickness when it has one (handleStatusItems with a
- * cure in its effect row: Bandage, Medicine). X gives the chosen item as Items > Use does (startFeedingItem: the
- * partner comes, takes it or refuses it, one unit is used), a command does what the triangle menu's does (Scold:
- * discipline up and the next item taken; Sleep), triangle closes the box. When the partner refuses the item this
- * menu gave and a scolding is fair, the menu opens again on its own with Scold under the cursor. With nothing to
- * offer X does nothing here. While the box is open the clock stops, as with the triangle menu.
+ * and amount, the description box under it) with what the partner needs now and nothing else, every need at once,
+ * most urgent first with the cursor on it: Scold when a scolding is fair (ITEM_SCOLD_FLAG 1: it refused an item out
+ * of indiscipline, it pooped on the ground), what cures an injury or a sickness it has (handleStatusItems with a
+ * cure in its effect row: Medicine before Bandage), the Port. potty when it needs to go, food when it is hungry (its
+ * favourite first, its name in gold), what restores HP or MP short of the maximum (the items the field can use),
+ * Sleep when it is sleepy (the triangle menu's commands, with their icons). The description box adds a line when
+ * there is something to know: its favourite food, a cure that may not work. X gives the chosen item as Items > Use
+ * does (startFeedingItem: the partner comes, takes it or refuses it, one unit is used), a command does what the
+ * triangle menu's does (Scold: discipline up and the next item taken; Sleep), triangle closes the box. When the
+ * partner refuses the item this menu gave and a scolding is fair, the menu opens again on its own with Scold under
+ * the cursor. With nothing to offer X does nothing here. While the box is open the clock stops, as with the triangle
+ * menu.
  * Hooked from tamerTickWalkingState() (tamer.c), after checkMapInteraction(): talking to an NPC, a chest or a
  * press tile take the X first.
  */
@@ -48,6 +50,11 @@
 #define FEED_SLEEP	0xFF
 #define IS_COMMAND(slot)	((slot) >= FEED_SCOLD)
 #define SCOLD_PENDING	1	/* ITEM_SCOLD_FLAG: a scolding now is a fair one */
+#define FEED_FAVOURITE_COLOR	4	/* TEXT_COLORS: gold */
+#define FEED_WARNING_COLOR	6	/* TEXT_COLORS: red */
+#define FEED_COMMAND_COLOR	0	/* TEXT_COLORS: white */
+#define FEED_DESC_V	0xC0	/* text area rows of the description and the note: under the 16 rows of names */
+#define FEED_NOTE_V	0xCC
 
 enum { FEED_OPENING, FEED_OPEN, FEED_CLOSING, FEED_GIVING, FEED_WATCHING };
 
@@ -102,50 +109,143 @@ static FeedCommand FEED_COMMANDS[2] = {
 	{ FEED_SLEEP_NAME, FEED_SLEEP_DESC, 0x28, 0x28, PARTNER_SLEEP }, /* MENU_OPTIONS[6] */
 };
 
-static uint8_t feedSlots[32]; /* the commands, then the inventory slots shown, in inventory order */
+static char FEED_NOTE_FAVOURITE[] = "Its favourite food!";
+static char FEED_NOTE_MAY_NOT_CURE_SICK[] = "It may not cure its sickness.";
+static char FEED_NOTE_MAY_NOT_CURE_WOUND[] = "It may not cure its wound.";
+
+static uint8_t feedSlots[32]; /* the commands and the inventory slots shown, most urgent first */
+static int32_t feedRanks[32];
+static int32_t feedNoted; /* some entry has a note: the description box has its second line */
 static int32_t feedCount;
 static int32_t feedCursor;
 static int32_t feedRowOffset;
 static int32_t feedState;
 
-/* the item answers one of the needs in condition */
-static int32_t answersNeed(ItemId type, uint32_t condition)
+/* the list's order, most urgent first (the cursor starts on it): a rank times 0x100 plus an order inside the rank */
+#define RANK_SCOLD	1	/* walking away clears it */
+#define RANK_CURE	2	/* the surest cure of what it has first */
+#define RANK_POTTY	3
+#define RANK_FOOD	4	/* its favourite first */
+#define RANK_HEAL	5	/* HP or MP short of the maximum */
+#define RANK_SLEEP	6	/* fed and cared for first: sleeping hungry or sick costs */
+
+static int32_t isFavourite(ItemId type)
+{
+	return type == RAISE_ROW(PARTNER_ENTITY.digimonEntity.entity.type).favoriteFood;
+}
+
+/* the item's place in the list for the needs the partner has, 0 when it answers none (nothing it does not need) */
+static int32_t needRank(ItemId type)
 {
+	uint32_t condition = PARTNER_PARA.condition;
+	ItemFunction fn;
 	const int16_t *fx;
+	int32_t cure;
+	int32_t hpShort;
+	int32_t mpShort;
+	int32_t heals;
 
 	if (type == ITEM_NONE) {
 		return 0;
 	}
+	fn = ITEM_FUNCTIONS[type];
 	fx = itemFx(type);
-	if (ITEM_FUNCTIONS[type] == (ItemFunction)handleFood) {
-		return (condition & CONDITION_HUNGRY) != 0; /* eating when not hungry costs happiness and discipline */
+	if (fn == (ItemFunction)handleFood) {
+		/* eating when not hungry costs happiness and discipline */
+		return (condition & CONDITION_HUNGRY) ? RANK_FOOD * 0x100 + !isFavourite(type) : 0;
 	}
-	if (ITEM_FUNCTIONS[type] == (ItemFunction)handleStatusItems) {
-		return ((condition & CONDITION_INJURED) && MOD_FX(fx, MOD_FX_CURE_INJURY) > 0) ||
-		       ((condition & CONDITION_SICK) && MOD_FX(fx, MOD_FX_CURE_SICK) > 0);
+	if (type == PORT_POTTY) {
+		return (condition & CONDITION_POOPY) ? RANK_POTTY * 0x100 : 0;
 	}
-	return type == PORT_POTTY && (condition & CONDITION_POOPY);
+	if (fn == (ItemFunction)handleStatusItems) {
+		cure = 0;
+		if (condition & CONDITION_INJURED) {
+			cure += MOD_FX(fx, MOD_FX_CURE_INJURY) * 100 / careDie(MOD_CARE_MEDICINE_INJURY_DIE);
+		}
+		if (condition & CONDITION_SICK) {
+			cure += MOD_FX(fx, MOD_FX_CURE_SICK) * 100 / careDie(MOD_CARE_MEDICINE_SICK_DIE);
+		}
+		if (cure > 0) {
+			return RANK_CURE * 0x100 + 0xFF - (cure > 0xFF ? 0xFF : cure);
+		}
+	}
+	/* HP and MP: only what the field can use (itemColor 0 field, 2 both) */
+	if (ITEM_PARA[type].itemColor != 0 && ITEM_PARA[type].itemColor != 2) {
+		return 0;
+	}
+	hpShort = PARTNER_ENTITY.digimonEntity.stats.current.currentHP < PARTNER_ENTITY.digimonEntity.stats.base.hp;
+	mpShort = PARTNER_ENTITY.digimonEntity.stats.current.currentMP < PARTNER_ENTITY.digimonEntity.stats.base.mp;
+	heals = (hpShort && (fn == (ItemFunction)handleHPHealingItem || fn == (ItemFunction)handleRestore)) ||
+	        (mpShort && fn == (ItemFunction)handleMPHealingItem);
+	if (fn == (ItemFunction)handleDoubleFloppy || fn == (ItemFunction)handleStatusItems) {
+		heals |= (hpShort && MOD_FX(fx, MOD_FX_HEAL_HP) > 0) || (mpShort && MOD_FX(fx, MOD_FX_HEAL_MP) > 0);
+	}
+	return heals ? RANK_HEAL * 0x100 : 0;
+}
+
+static void feedAdd(uint8_t slot, int32_t rank)
+{
+	int32_t i;
+
+	/* insertion by rank; equal ranks keep the inventory order */
+	for (i = feedCount; i > 0 && feedRanks[i - 1] > rank; i--) {
+		feedSlots[i] = feedSlots[i - 1];
+		feedRanks[i] = feedRanks[i - 1];
+	}
+	feedSlots[i] = slot;
+	feedRanks[i] = rank;
+	feedCount++;
 }
 
 static int32_t feedCollect(void)
 {
 	int32_t i;
+	int32_t rank;
 
 	feedCount = 0;
 	if (ITEM_SCOLD_FLAG == SCOLD_PENDING) {
-		feedSlots[feedCount++] = FEED_SCOLD;
+		feedAdd(FEED_SCOLD, RANK_SCOLD * 0x100);
 	}
 	if (PARTNER_PARA.condition & CONDITION_SLEEPY) {
-		feedSlots[feedCount++] = FEED_SLEEP;
+		feedAdd(FEED_SLEEP, RANK_SLEEP * 0x100);
 	}
 	for (i = 0; i < INVENTORY.size; i++) {
-		if (INVENTORY.amounts.array[i] != 0 && answersNeed(INVENTORY.types.array[i], PARTNER_PARA.condition)) {
-			feedSlots[feedCount++] = i;
+		if (INVENTORY.amounts.array[i] != 0 && (rank = needRank(INVENTORY.types.array[i])) != 0) {
+			feedAdd(i, rank);
 		}
 	}
 	return feedCount;
 }
 
+/* the second line of the description: what to know before giving it, NULL for nothing (color in *color) */
+static char *feedNote(int32_t i, int32_t *color)
+{
+	ItemId type;
+	const int16_t *fx;
+
+	if (IS_COMMAND(feedSlots[i])) {
+		return NULL;
+	}
+	type = INVENTORY.types.array[feedSlots[i]];
+	if (ITEM_FUNCTIONS[type] == (ItemFunction)handleFood && isFavourite(type)) {
+		*color = FEED_FAVOURITE_COLOR;
+		return FEED_NOTE_FAVOURITE;
+	}
+	fx = itemFx(type);
+	if (ITEM_FUNCTIONS[type] == (ItemFunction)handleStatusItems) {
+		*color = FEED_WARNING_COLOR;
+		if ((PARTNER_PARA.condition & CONDITION_SICK) && MOD_FX(fx, MOD_FX_CURE_SICK) > 0 &&
+		    MOD_FX(fx, MOD_FX_CURE_SICK) < careDie(MOD_CARE_MEDICINE_SICK_DIE)) {
+			return FEED_NOTE_MAY_NOT_CURE_SICK;
+		}
+		if ((PARTNER_PARA.condition & CONDITION_INJURED) && MOD_FX(fx, MOD_FX_CURE_INJURY) > 0 &&
+		    MOD_FX(fx, MOD_FX_CURE_INJURY) < careDie(MOD_CARE_MEDICINE_INJURY_DIE)) {
+			return FEED_NOTE_MAY_NOT_CURE_WOUND;
+		}
+	}
+	return NULL;
+}
+
 static char *feedName(int32_t i)
 {
 	return IS_COMMAND(feedSlots[i]) ? FEED_COMMANDS[feedSlots[i] - FEED_SCOLD].name
@@ -176,8 +276,8 @@ static int32_t feedRows(void)
