From 27f1a601cb4ee468edb6e5db03e112a76519a4c2 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Sun, 25 Oct 2026 06:51:13 +0000
Subject: [PATCH] Patch 0236: the quick start keeps the flee bubbles (who
 joins, who runs) and the runaways: the bubbles last 2 s (40 ticks) of the
 fight instead of the load, the Digimon that do not join run off while the
 fight goes on and leave the map off the screen or after 0xC8 ticks, as the
 intro's end did (modBattleFleeTick); the fight's end removes what is left.
 The start is not delayed. 464 bytes of heap

---
 src/btl/battle_setup.c | 12 ++++----
 src/main/battle_tick.c |  2 ++
 src/main/btl.c         | 64 ++++++++++++++++++++++++++++++++++++++----
 3 files changed, 66 insertions(+), 12 deletions(-)

diff --git a/src/btl/battle_setup.c b/src/btl/battle_setup.c
index df4421af..31648088 100644
--- a/src/btl/battle_setup.c
+++ b/src/btl/battle_setup.c
@@ -208,11 +208,12 @@ void BTL_initializeCombat(void)
 
 /* MOD (quick battle start): the intro without its waits. The tamer's walk back (the loop below: along the waypoints
  * until the next step would leave the combat area, then to the screen's start tile) runs at once, unseen, with only
- * the tamer's animation ticked, so he ends where the intro would have left him; those who flee leave at once; no
- * BATTLE letters. The entity step snaps the 60 fps interpolation. */
+ * the tamer's animation ticked, so he ends where the intro would have left him; those who flee run off during the
+ * fight (modBattleFleeTick); no BATTLE letters. The entity step snaps the 60 fps interpolation. */
+void modBattleFleeStart(int16_t *ids, int32_t count); /* MOD (quick battle start), btl.c */
+
 static void BTL_quickBattleIntro(int16_t *found, int32_t count, int16_t wp)
 {
-	int32_t i;
 	int32_t timer;
 	int16_t result;
 	int16_t tileX;
@@ -254,10 +255,7 @@ static void BTL_quickBattleIntro(int16_t *found, int32_t count, int16_t wp)
 	startAnimation(ENTITY_TABLE[0], 1);
 	entityLookAtLocation(ENTITY_TABLE[0], &ENTITY_TABLE[1]->posData->location);
 
-	for (i = 0; i < count; i++) {
-		ENTITY_TABLE[found[i]]->isOnMap = 0;
-		ENTITY_TABLE[found[i]]->anim.animFlag &= 0xfb;
-	}
+	modBattleFleeStart(found, count); /* btl.c: they run off while the fight goes on */
 
 	GAME_STATE = 1;
 }
diff --git a/src/main/battle_tick.c b/src/main/battle_tick.c
index 28a02eff..8d134578 100644
--- a/src/main/battle_tick.c
+++ b/src/main/battle_tick.c
@@ -232,6 +232,7 @@ void handleFleeing(void)
 
 extern int8_t MOD_BATTLE_LOADING; /* MOD (quick battle start), btl.c */
 void modBattleLoadStep(void);
+void modBattleFleeTick(void);
 
 // clang-format off
 void tamerTickBattle(instanceId)
@@ -245,6 +246,7 @@ void tamerTickBattle(instanceId)
 	tamer = ENTITY_TABLE[instanceId];
 
 	modBattleLoadStep(); /* MOD (quick battle start), btl.c */
+	modBattleFleeTick();
 	if (GAME_STATE == 1) {
 		if (COMBAT_DATA_PTR->player.currentCommand[0] != 1) {
 			partner = ENTITY_TABLE[1];
diff --git a/src/main/btl.c b/src/main/btl.c
index c7a40591..a9320467 100644
--- a/src/main/btl.c
+++ b/src/main/btl.c
@@ -174,9 +174,6 @@ GARBAGE(setFleeBubble, 9);
 
 void setFleeBubble(int16_t id, int16_t v)
 {
-	if (MOD_OPT_QUICK_BATTLE) {
-		return; /* MOD (quick battle start): no bubbles over who joins and who flees */
-	}
 	FLEE_BUBBLE_DATA[id - 2].frame = 0;
 	FLEE_BUBBLE_DATA[id - 2].type = v;
 	addObject(0x196, id, NULL, renderFleeBubble);
@@ -351,6 +348,7 @@ extern char btl_START[];
 extern char btl_END[];
 extern int32_t IS_SCRIPT_PAUSED;
 void _tickFileReadQueue(int32_t instanceId);
+int32_t entityIsOffScreen(Entity *entity, int32_t width, int32_t height);
 int32_t isFileReadQueueIdle(void);
 
 /* MOD (quick battle start): BTL_REL read ahead in the world, at its own address (OVL_BTL_BASE..btl_END is world
@@ -564,13 +562,67 @@ void modBattleLoadStep(void)
 	}
 }
 
-/* the fight ends (BTL_battleMain, before its clean-up): whatever is still loading lands first, as before the fight */
+/* MOD (quick battle start): the Digimon that do not join run off while the fight goes on (the original intro waited
+ * for them): each leaves the map when it is off the screen, or after 0xC8 ticks wherever it is, as the intro's end did */
+static int8_t modFleeing[8];
+static int8_t modFleeingCount;
+static int16_t modFleeingTicks;
+
+void modBattleFleeStart(int16_t *ids, int32_t count)
+{
+	int32_t i;
+
+	for (i = 0; i < count; i++) {
+		modFleeing[i] = ids[i];
+	}
+	modFleeingCount = count;
+	modFleeingTicks = 0;
+}
+
+static void modBattleFleeLeave(int32_t i)
+{
+	Entity *e;
+
+	e = ENTITY_TABLE[modFleeing[i]];
+	e->isOnMap = 0;
+	e->anim.animFlag &= 0xfb;
+	removeFleeBubble(modFleeing[i]);
+	modFleeing[i] = -1;
+}
+
+/* every tick of the fight (tamerTickBattle) */
+void modBattleFleeTick(void)
+{
+	int32_t i;
+
+	for (i = 0; i < modFleeingCount; i++) {
+		if ((modFleeing[i] >= 0) &&
+		    ((modFleeingTicks >= 0xc8) || entityIsOffScreen(ENTITY_TABLE[modFleeing[i]], 0x140, 0xf0))) {
+			modBattleFleeLeave(i);
+		}
+	}
+	modFleeingTicks++;
+}
+
+/* the fight ends (BTL_battleMain, before its clean-up): whatever is still loading lands first, as before the fight;
+ * the runaways leave and no bubble outlives the fight */
 void modBattleLoadFinish(void)
 {
+	int32_t i;
+
 	while (MOD_BATTLE_LOADING) {
 		_tickFileReadQueue(0);
 		modBattleLoadStep();
 	}
+	for (i = 0; i < modFleeingCount; i++) {
+		if (modFleeing[i] >= 0) {
+			modBattleFleeLeave(i);
+		}
+	}
+	modFleeingCount = 0;
+	for (i = 2; i < 10; i++) {
+		removeFleeBubble(i);
+	}
 }
 
 void loadBattleData(int32_t entityId, int32_t count)
@@ -832,7 +884,9 @@ void renderFleeBubble(int32_t instanceId)
 	GsSetWorkBase((PACKET *)prim);
 	GsSortSprite(&sprite, ACTIVE_ORDERING_TABLE, 8);
 	FLEE_BUBBLE_DATA[instanceId - 2].frame++;
-	if ((LOAD_EFE_STATE == 0) || (FLEE_BUBBLE_DATA[instanceId - 2].frame == 0xc8)) {
+	/* MOD (quick battle start): the fight has started and the loads go on, so a bubble lasts 2 s (40 ticks) */
+	if ((MOD_OPT_QUICK_BATTLE ? (FLEE_BUBBLE_DATA[instanceId - 2].frame >= 40) : (LOAD_EFE_STATE == 0)) ||
+	    (FLEE_BUBBLE_DATA[instanceId - 2].frame == 0xc8)) {
 		/* MOD (fps): the other render passes of this tick still draw it
 		 * (frame is rolled back for them, main.c) */
 		if (MOD_RENDER_MULTIPASS) {
-- 
