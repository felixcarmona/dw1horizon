From acefc1a100f9cf3507747f0e0c45724064b57453 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Thu, 15 Oct 2026 16:22:19 +0000
Subject: [PATCH] Evolution: a Baby II's Rookie targets past its 6 "to" slots
 (getEvolutionExtraTargets, up to 12 per Baby II, from the DIGI.DAT links that
 find no free slot); getInTrainingEvolutionTarget walks them after the 6

---
 include/dw/species.h   |  8 ++++++++
 src/main/evolution.c   | 45 ++++++++++++++++++++++++------------------
 src/main/mod_species.c | 43 ++++++++++++++++++++++++++++++++++++++++
 3 files changed, 77 insertions(+), 19 deletions(-)

diff --git a/include/dw/species.h b/include/dw/species.h
index 40820de5..4487201d 100644
--- a/include/dw/species.h
+++ b/include/dw/species.h
@@ -234,6 +234,14 @@ int32_t getDigimonTextureRef(int32_t type, char **file, int32_t *sector, int32_t
 /* the evolution paths of a type (EVOLUTION_PATHS covers types 1..62, new
  * species have their own rows; any other type has none) */
 EvolutionPath *getEvolutionPath(int32_t type);
+/*
+ * MOD (evolution): a Baby II's Rookie targets past its 6 "to" slots. A link whose original has no free "to" slot and
+ * is an In-Training species goes here (up to SPECIES_EXTRA_TARGETS per Baby II); getInTrainingEvolutionTarget walks
+ * them after the 6. Returns the count and points *targets at them (0: none).
+ */
+#define SPECIES_EXTRA_PARENTS	4
+#define SPECIES_EXTRA_TARGETS	12
+int32_t getEvolutionExtraTargets(int32_t type, DigimonId **targets);
 /* MOD (dcb-import): the bone offset a technique effect of `type` starts
  * from: `borrowed` (the originalType's EFE entry) or this species' own one */
 int16_t *getSpeciesEffectOrigin(int32_t type, int16_t *borrowed);
diff --git a/src/main/evolution.c b/src/main/evolution.c
index 54f186a2..51620adf 100644
--- a/src/main/evolution.c
+++ b/src/main/evolution.c
@@ -876,35 +876,42 @@ int16_t getFreshEvolutionTarget(int32_t currentDigimon) {
   return result; // possible undefined behavior: 'result' may be uninitialized
 }
 
+/* MOD (evolution): one Rookie target of a Baby II, scored as the original loop did; the best so far in *best/*bestScore */
+static void scoreInTrainingTarget(int32_t currentDigimon, DigimonId target, int32_t *best, int8_t *bestScore)
+{
+  int8_t requirementScore;
+  int8_t isMaxCM;
+  int8_t isMaxBattles;
+
+  if (target == -1 || target == 0 || !isPartnerModelFit(target)) /* MOD (scale): a model that does not fit is no target */
+    return;
+  isMaxCM = (EVO_REQ_ROW(target).flags & 0x10) >> 4;
+  isMaxBattles = EVO_REQ_ROW(target).flags & 1;
+  requirementScore = calculateRequirementScore(currentDigimon, target, isMaxCM, isMaxBattles, *best);
+  if (*bestScore < requirementScore && requirementScore >= 3) {
+    *best = target;
+    *bestScore = requirementScore;
+  }
+}
+
 int16_t getInTrainingEvolutionTarget(int32_t currentDigimon) {
   DigimonId *targetPtr; /* MOD: was int8_t */
-  int8_t requirementScore;
+  DigimonId *extra;
   int32_t currentBest;
   int32_t i;
-  int8_t isMaxCM;
-  int8_t isMaxBattles;
+  int32_t n;
   int8_t bestScore;
 
   currentBest = -1;
   bestScore = 0;
   targetPtr = getEvolutionPath(currentDigimon)->to; /* MOD (species) */
-
   for (i = 0; i < 6; i++) {
-    if (*targetPtr == -1 || !isPartnerModelFit(*targetPtr)) { /* MOD (scale): a model that does not fit is no target */
-      targetPtr++;
-      continue;
-    }
-
-    isMaxCM = (EVO_REQ_ROW(*targetPtr).flags & 0x10) >> 4;
-    isMaxBattles = EVO_REQ_ROW(*targetPtr).flags & 1;
-    requirementScore = calculateRequirementScore(
-        currentDigimon, *targetPtr, isMaxCM, isMaxBattles, currentBest);
-
-    if (bestScore < requirementScore && requirementScore >= 3) {
-      currentBest = *targetPtr;
-      bestScore = requirementScore;
-    }
-    targetPtr++;
+    scoreInTrainingTarget(currentDigimon, targetPtr[i], &currentBest, &bestScore);
+  }
+  /* MOD (evolution): the Rookies past the 6 slots (getEvolutionExtraTargets) */
+  n = getEvolutionExtraTargets(currentDigimon, &extra);
+  for (i = 0; i < n; i++) {
+    scoreInTrainingTarget(currentDigimon, extra[i], &currentBest, &bestScore);
   }
 
   return currentBest;
diff --git a/src/main/mod_species.c b/src/main/mod_species.c
index e0ae50eb..443fbd80 100644
--- a/src/main/mod_species.c
+++ b/src/main/mod_species.c
@@ -181,6 +181,47 @@ int32_t getPartnerVlallSoundId(int32_t type)
 	return (rec != NULL && (rec->flags & SPECIES_FLAG_PARTNER)) ? rec->vlallId : 15;
 }
 
+static int16_t EXTRA_PARENT[SPECIES_EXTRA_PARENTS];		/* 0: unused */
+static DigimonId EXTRA_TO[SPECIES_EXTRA_PARENTS][SPECIES_EXTRA_TARGETS];	/* 0: empty */
+
+int32_t getEvolutionExtraTargets(int32_t type, DigimonId **targets)
+{
+	int32_t k;
+	int32_t n;
+
+	for (k = 0; k < SPECIES_EXTRA_PARENTS; k++) {
+		if (EXTRA_PARENT[k] == type && type > 0) {
+			for (n = 0; n < SPECIES_EXTRA_TARGETS && EXTRA_TO[k][n] > 0; n++) {
+			}
+			*targets = EXTRA_TO[k];
+			return n;
+		}
+	}
+	return 0;
+}
+
+/* a Baby II's Rookie target with every "to" slot taken: into its extra list */
+static void addExtraTarget(int32_t orig, int32_t other)
+{
+	int32_t k;
+	int32_t j;
+
+	if (DIGIMON_DATA[orig].level != 2) {
+		return;
+	}
+	for (k = 0; k < SPECIES_EXTRA_PARENTS && EXTRA_PARENT[k] != orig && EXTRA_PARENT[k] != 0; k++) {
+	}
+	if (k == SPECIES_EXTRA_PARENTS) {
+		return;
+	}
+	EXTRA_PARENT[k] = orig;
+	for (j = 0; j < SPECIES_EXTRA_TARGETS && EXTRA_TO[k][j] != other && EXTRA_TO[k][j] > 0; j++) {
+	}
+	if (j < SPECIES_EXTRA_TARGETS) {
+		EXTRA_TO[k][j] = other;
+	}
+}
+
 static void addEvolutionLink(int32_t orig, int32_t other, int32_t isFrom)
 {
 	EvolutionPath *path;
@@ -203,6 +244,8 @@ static void addEvolutionLink(int32_t orig, int32_t other, int32_t isFrom)
 	}
 	if (j < n) {
 		list[j] = other;
+	} else if (!isFrom) {
+		addExtraTarget(orig, other); /* MOD (evolution) */
 	}
 }
 
-- 
