From 2fa6344f33c49f5064e2fd71003c390f159123d7 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Sat, 10 Oct 2026 23:57:20 +0000
Subject: [PATCH] Screens: 16-bit CURRENT_SCREEN, PREVIOUS_SCREEN, TARGET_MAP
 and sections
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Step 3 of docs/mods/ids.md (§ 10), screens.

- CURRENT_SCREEN, PREVIOUS_SCREEN, TARGET_MAP and SAVED_STATE's screen
  fields are ScreenId (int16_t). The .MAP warps are already s16.
- runMapHeadScript takes the whole section id and changeMap no longer
  masks it to a byte, so a screen id above 255 reaches its own MAPHEAD
  section. SCRIPT_SECTION is u16; scriptPauseGame keeps using its low
  byte as the NPC script id, as before.
- Local prototypes that cut the id to a byte or sign-extended it are
  fixed: changeMap/addMapNameObject in tamer.c, checkShopMap/
  checkArenaMap in map.c, getFileCityTopMap in main_menu.c (int8_t would
  turn 0xAE-0xB3 into negative screens once CURRENT_SCREEN is 16-bit).
- The v1 save keeps the low byte (exact while ids are < 255); its layout
  is checked at compile time (size 0xF00, inventory 0x40C, screens 0x49A).
- SCREEN_LEGACY_NONE (0xCC) stays: it is a real screen and renderMap reads
  MAP_ENTRIES[CURRENT_SCREEN] before the first map is loaded.

---
 include/dw/ids.h         | 22 ++++++++++++++--------
 include/dw/main.h        |  4 ++--
 src/main/main_menu.c     | 19 ++++++++++++++++---
 src/main/map.c           | 12 ++++++------
 src/main/script_interp.c | 14 ++++++--------
 src/main/tamer.c         |  6 +++---
 6 files changed, 47 insertions(+), 30 deletions(-)

diff --git a/include/dw/ids.h b/include/dw/ids.h
index 12f7fae..8d7c7b6 100644
--- a/include/dw/ids.h
+++ b/include/dw/ids.h
@@ -7,9 +7,8 @@
  * The counts are those of the original disc. Every table and loop that
  * means "one per Digimon / screen / item / ..." uses these names, so new
  * content changes one number here (and the tables) instead of literals
- * spread over the code. The typedefs are the target widths; the carriers
- * that are still u8 (CURRENT_SCREEN, the inventory, the save) are widened
- * in later steps of the plan (ids.md § 10).
+ * spread over the code. The typedefs are the widths of the carriers in RAM;
+ * the save keeps the v1 u8 layout until step 4 of the plan (ids.md § 10).
  */
 
 #include <dw/types.h>
@@ -32,7 +31,14 @@ typedef uint16_t CardId;
 
 /* Screens (maps) */
 #define NUM_SCREENS		255	/* MAP_ENTRIES; screen ids are u8 */
-#define SCREEN_LEGACY_NONE	0xCC	/* TWNA01 doubles as "no screen" at boot */
+/*
+ * Value of CURRENT_SCREEN/PREVIOUS_SCREEN before the first map is loaded
+ * (initializeMap) and the start section of a new game (initializeDefaultSavegame). It is
+ * a real screen (TWNA01, File City) and not compared anywhere: renderMap
+ * reads MAP_ENTRIES[CURRENT_SCREEN] before the first loadMap, so it must
+ * stay a valid row and is not changed to -1 (ids.md, step 3).
+ */
+#define SCREEN_LEGACY_NONE	0xCC
 
 /* Items */
 #define NUM_ITEMS		128	/* ITEM_PARA, ITEM_FUNCTIONS, icons (16x8 grid) */
@@ -51,10 +57,10 @@ typedef uint16_t CardId;
 #define TRIGGER_RAISED_BASE	0x200	/* + Digimon type */
 
 /*
- * The current and previous screen. Still u8 (ids.md § 10 step 3 widens
- * them to ScreenId); declared once here instead of in every file.
+ * The current and previous screen, 16-bit since step 3 of ids.md § 10.
+ * The v1 save keeps them as u8 (exact while screen ids are < 255).
  */
-extern uint8_t CURRENT_SCREEN;
-extern uint8_t PREVIOUS_SCREEN;
+extern ScreenId CURRENT_SCREEN;
+extern ScreenId PREVIOUS_SCREEN;
 
 #endif
diff --git a/include/dw/main.h b/include/dw/main.h
index d88130e..5db3afd 100644
--- a/include/dw/main.h
+++ b/include/dw/main.h
@@ -20,8 +20,8 @@ typedef struct {
 	Stats partnerStats;
 	int8_t lives;
 	int8_t npcMaps[8];
-	uint8_t currentScreen;
-	uint8_t previousScreen;
+	ScreenId currentScreen; /* MOD: u8 in the save */
+	ScreenId previousScreen;
 	uint8_t currentExit;
 	uint8_t previousExit;
 	int8_t tamerWaypointX[30];
diff --git a/src/main/main_menu.c b/src/main/main_menu.c
index a22c934..b361e1b 100644
--- a/src/main/main_menu.c
+++ b/src/main/main_menu.c
@@ -134,6 +134,18 @@ typedef struct {
 	RegisteredDigimon battleRegistrationData[40];
 } SavegamePayload;
 
+/*
+ * MOD: the v1 save layout must not change while the ids widen in RAM
+ * (docs/mods/ids.md, step 3). The ids are written as their low byte.
+ */
+#define SAVE_LAYOUT_CHECK(name, cond) typedef char save_layout_##name[(cond) ? 1 : -1]
+SAVE_LAYOUT_CHECK(size, sizeof(SavegamePayload) == 0xF00);
+SAVE_LAYOUT_CHECK(inventory, __builtin_offsetof(SavegamePayload, inventory) == 0x40C);
+SAVE_LAYOUT_CHECK(inventorySize, sizeof(((SavegamePayload *)0)->inventory) == 0x5B);
+SAVE_LAYOUT_CHECK(playerName, __builtin_offsetof(SavegamePayload, playerName) == 0x467);
+SAVE_LAYOUT_CHECK(currentScreen, __builtin_offsetof(SavegamePayload, currentScreen) == 0x49A);
+SAVE_LAYOUT_CHECK(checksum, __builtin_offsetof(SavegamePayload, checksum) == 0x4FC);
+
 typedef struct {
 	char id[2];
 	uint8_t iconDisplayFlag;
@@ -220,7 +232,7 @@ extern char *MOVE_NAMES[];
 extern char *MAP_NAME_PTR[];
 #endif
 
-int8_t getFileCityTopMap(void);
+int32_t getFileCityTopMap(void);
 void renderUIBoxBorder(RECT *rect, int32_t flag);
 void SetPolyG4(POLY_G4 *prim);
 void recalculatePPandArena(void);
@@ -4025,8 +4037,9 @@ void writeSavegame(SavegamePayload *savegame)
 	memcpy(savegame->playerName, DIGIMON_NAME(0), 0x14);
 	memcpy(savegame->worldPoop, WORLD_POOP, 0x190);
 	savegame->partnerPara = PARTNER_PARA;
-	savegame->currentScreen = CURRENT_SCREEN;
-	savegame->previousScreen = PREVIOUS_SCREEN;
+	/* MOD: the v1 save keeps the low byte (exact while ids are < 255) */
+	savegame->currentScreen = (uint8_t)CURRENT_SCREEN;
+	savegame->previousScreen = (uint8_t)PREVIOUS_SCREEN;
 	savegame->currentExit = CURRENT_EXIT;
 	savegame->previousExit = PREVIOUS_EXIT;
 	savegame->merit = MERIT;
