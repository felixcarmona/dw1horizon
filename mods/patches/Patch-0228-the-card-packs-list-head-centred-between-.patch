From 324da88610a60e89ea88c0e9709a33eda94fe0cd Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Sat, 24 Oct 2026 20:44:54 +0000
Subject: [PATCH] Patch 0228: the card packs' list head centred between the
 box's top and the dividing line (by + 7): 4 free pixels above the capitals
 and 4 under the baseline (measured on the screen; 0227's by + 5 left 2 and
 6). 0 bytes of heap

---
 src/shop/script_menu.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/shop/script_menu.c b/src/shop/script_menu.c
index fc5b0e37..579874f3 100644
--- a/src/shop/script_menu.c
+++ b/src/shop/script_menu.c
@@ -3648,7 +3648,7 @@ static void renderPackResults(void)
 	by = UI_BOX_DATA[1].finalPos.y;
 	getVRAMModeCoords(text->vramMode, &u, &w);
 	v = (9 + text->backPage * text->vramRows) * 12;
-	renderString(0, bx + (0xde - PACK_HEAD_W) / 2, by + 5, PACK_HEAD_W, 0xc, u, v, 5, 1); /* the head centred */
+	renderString(0, bx + (0xde - PACK_HEAD_W) / 2, by + 7, PACK_HEAD_W, 0xc, u, v, 5, 1); /* the head centred */
 	renderHorizontalLine(1, 4, 0x15, 0xd7); /* under it, clear of the letters and of the cursor (0x19) */
 	renderItemMenuScrollBar(box);
 	count = box->itemCount;
-- 
