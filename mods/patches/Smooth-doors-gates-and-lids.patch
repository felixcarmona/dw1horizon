 {
-	switch (MAP_3D_OBJ[instance].modelId) {
-	case 0:
-		++MAP_OBJ_ROTATE_TIMER;
-		if (MAP_OBJ_ROTATE_TIMER > 32) {
-			MAP_OBJ_ROTATE_TIMER = 0;
-			return 1;
-		}
+	Map3DObject *obj = &MAP_3D_OBJ[instance];
+	int32_t kind = (uint16_t)obj->modelId < 0x21 ? MOD_DOOR_MOTION[obj->modelId] : 0;
+	int32_t timer;
+	int32_t step;
 
-		MAP_3D_OBJ[instance].rotation.vy -= target * 33;
-
-		break;
-	case 9:
-	case 0xa:
-	case 0xb:
-	case 0xc:
-	case 0xd:
-	case 0x10:
-	case 0x11:
-	case 0x12:
-	case 0x13:
-		++MAP_OBJ_ROTATE_TIMER;
-		if (MAP_OBJ_ROTATE_TIMER > 32) {
-			MAP_OBJ_ROTATE_TIMER = 0;
-			MAP_3D_OBJ[instance].rotation.vy =
-				MAP_3D_OBJ[instance].direction;
-			return 1;
-		}
-
-		MAP_3D_OBJ[instance].rotation.vy += target * 33;
-
-		break;
-	case 0xe:
-	case 0xf:
-		++MAP_OBJ_ROTATE_TIMER;
-		if (MAP_OBJ_ROTATE_TIMER > 32) {
-			MAP_OBJ_ROTATE_TIMER = 0;
-			return 1;
+	if (kind == 0) {
+		return 0;
+	}
+	modObjSave(instance);
+	timer = ++MAP_OBJ_ROTATE_TIMER;
+	if (kind == 7) {
+		step = obj->rotation.vx - target * 110;
+		if (step < -0x400) {
+			step = -0x400;
 		}
-
-		MAP_3D_OBJ[instance].rotation.vy += target * 33;
-
-		break;
-	case 5:
-	case 0x1f:
-	case 0x20:
-		++MAP_OBJ_ROTATE_TIMER;
-		if (MAP_OBJ_ROTATE_TIMER > 9) {
-			MAP_OBJ_ROTATE_TIMER = 0;
-			return 1;
+		if (step > 0) {
+			step = 0;
 		}
-
-		MAP_3D_OBJ[instance].translation.vy -= target * 200;
-
-		break;
-	case 0x15:
-	case 0x16:
-	case 0x18:
-	case 0x1b:
-	case 0x1d:
-		++MAP_OBJ_ROTATE_TIMER;
-		if (MAP_OBJ_ROTATE_TIMER > 9) {
+		obj->rotation.vx = step;
+		if (timer > 19) {
 			MAP_OBJ_ROTATE_TIMER = 0;
 			return 1;
 		}
-
-		if (CURRENT_SCREEN == 0x81) {
-			MAP_3D_OBJ[instance].translation.vz += 30;
-		} else {
-			MAP_3D_OBJ[instance].translation.vx += 30;
-		}
-
-		break;
-	case 0x14:
