+	uint16_t ids[SPECIES_MAX_PARTNERS];
+} SpeciesPartnerList;
+typedef struct {
+	uint16_t count;
+	uint16_t reserved;
+	uint16_t link[SPECIES_MAX_LINKS][2];
+} SpeciesLinks;
