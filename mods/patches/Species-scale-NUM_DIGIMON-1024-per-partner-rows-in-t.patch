+		return isTriggerSet((uint16_t)(TRIGGER_RECRUITED_BASE + type)) != 0;
+	}
+	if ((uint32_t)type >= NUM_DIGIMON) {
+		return 0;
+	}
+	return (SPECIES_RECRUITED_BITS[type >> 3] >> (type & 7)) & 1;
