From 41775bc4f82941ce870c5fc60d7edd9317866c51 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Thu, 5 Nov 2026 08:06:44 +0000
Subject: [PATCH] Keep the rebirth species fallback available after other
 overlays load

---
 config/us/overlay.ld   | 1 -
 src/main/mod_species.c | 1 +
 2 files changed, 1 insertion(+), 1 deletion(-)

diff --git a/config/us/overlay.ld b/config/us/overlay.ld
index fb0014c6..231b7b87 100644
--- a/config/us/overlay.ld
+++ b/config/us/overlay.ld
@@ -974,7 +974,6 @@ SECTIONS
             BUILD_DIR/src/main/main_menu.c.o(.text.modOptionCount* .text.setRegisteredSpecies*);
             BUILD_DIR/src/main/main_menu.c.o(.text.swapPartnerSpecies);
             BUILD_DIR/src/main/mod_options.c.o(.text.modFrameRate);
-            BUILD_DIR/src/main/mod_species.c.o(.text.getSpeciesVanillaAs);
             BUILD_DIR/src/main/sjis.c.o(.text.asciiToShiftJIS);
             . = ALIGN(., 4);
 
diff --git a/src/main/mod_species.c b/src/main/mod_species.c
index f77441d7..a102a249 100644
--- a/src/main/mod_species.c
+++ b/src/main/mod_species.c
@@ -128,6 +128,7 @@ int32_t isVanillaSpecies(int32_t type)
 	return (uint32_t)type < NUM_DIGIMON && ((SPECIES_VANILLA[type >> 3] >> (type & 7)) & 1);
 }
 
+/* Shared by MENU and DOOA; evolution and battle can replace MENU before rebirth. Keep resident. */
 int32_t getSpeciesVanillaAs(int32_t type)
 {
 	SpeciesRecord *rec;
