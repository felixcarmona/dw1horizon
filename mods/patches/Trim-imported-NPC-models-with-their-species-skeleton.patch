From 4b6844e931dbcd116c7efed39efb54f2673d7898 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Sun, 15 Nov 2026 00:24:26 +0000
Subject: [PATCH] Trim imported NPC models with their species skeleton

Keep the native per-type rows and use one shared eight-byte mask for imports. Ignore cold-animation markers while collecting and packing resident streams, leaving the markers unchanged. Build the one-frame fallback from the loaded species parameters through the existing cache, including native bindings with a different bone count.
---
 src/main/npc_anim_keep.c |  5 +++++
 src/main/npc_anim_trim.c | 25 +++++++++++++++----------
 2 files changed, 20 insertions(+), 10 deletions(-)

diff --git a/src/main/npc_anim_keep.c b/src/main/npc_anim_keep.c
index cac9b5d8..a9759bbb 100644
--- a/src/main/npc_anim_keep.c
+++ b/src/main/npc_anim_keep.c
@@ -43,3 +43,8 @@ const uint8_t NPC_ANIM_KEEP_INDEX[180] = {
 	 1,  1, 10,  1,  1,  1, 11,  1,  1,  1,  /* 160-169 */
 	 1,  1,  1,  1,  1,  1,  1, 12,  1,  1,  /* 170-179 */
 };
+
+/* Shared by imported species, including script-only slots. */
+const uint32_t NPC_ANIM_IMPORT_KEEP[2] = {
+	0xF008001F, 0xFFFFFFFF
+};
diff --git a/src/main/npc_anim_trim.c b/src/main/npc_anim_trim.c
index 9a8f1863..3bb3f504 100644
--- a/src/main/npc_anim_trim.c
+++ b/src/main/npc_anim_trim.c
@@ -18,13 +18,13 @@
  *   freed: malloc3 carves blocks from the top of a free block, so the freed
  *   part joins the free block below it instead of leaving a hole.
  * - Runs before GsMapModelingData (the TMD is still in file form) and only
- *   for types below NUM_NPC_ANIM_TYPES; partner and tamer models (fixed
+ *   for valid species; partner and tamer models (fixed
  *   buffers) are never touched.
  */
 #include <dw/params.h>
+#include <dw/species.h>
 #include <dw/types.h>
 
-#define NUM_NPC_ANIM_TYPES	180
 #define MAX_ANIM_SLOTS		64
 
 typedef struct {
@@ -33,8 +33,9 @@ typedef struct {
 	int32_t last;		/* ... by the last one */
 } NpcTrimStats;
 
+extern const uint32_t NPC_ANIM_IMPORT_KEEP[2];
 extern const uint32_t NPC_ANIM_KEEP_MASKS[][2];
-extern const uint8_t NPC_ANIM_KEEP_INDEX[NUM_NPC_ANIM_TYPES];
+extern const uint8_t NPC_ANIM_KEEP_INDEX[NUM_ORIGINAL_DIGIMON];
 NpcTrimStats MOD_NPC_TRIM_STATS;
 int32_t MOD_NPC_STUB_HITS;	/* startAnimation landed on a stub (should stay 0) */
 int32_t MOD_NPC_STUB_LAST;	/* (type << 8) | slot of the last one */
@@ -106,31 +107,35 @@ int32_t compactNpcModel(int32_t type, uint8_t *mmd, int32_t size)
 	int32_t stubBytes;
 	int16_t *anim0;
 	int16_t *stub;
+	const uint32_t *mask;
 
-	if ((type < 0) || (type >= NUM_NPC_ANIM_TYPES)) {
+	if ((type < 0) || (type >= SPECIES_COUNT)) {
 		return size;
 	}
+	mask = type < NUM_ORIGINAL_DIGIMON
+		? NPC_ANIM_KEEP_MASKS[NPC_ANIM_KEEP_INDEX[type]] : NPC_ANIM_IMPORT_KEEP;
 	tab = (uint32_t *)(mmd + ((uint32_t *)mmd)[1]);
 	animBytes = size - ((uint32_t *)mmd)[1];
 
 	/* the table has (smallest offset) / 4 slots */
 	for (i = 0; (i < MAX_ANIM_SLOTS) && ((first == 0) || (4 * (uint32_t)i < first)); i++) {
-		if ((tab[i] != 0) && ((first == 0) || (tab[i] < first))) {
+		if ((tab[i] != 0) && !(tab[i] & COLD_ANIM_FLAG) && ((first == 0) || (tab[i] < first))) {
 			first = tab[i];
 		}
 	}
 	n = first / 4;
-	if ((first == 0) || (n > MAX_ANIM_SLOTS) || (tab[0] == 0)) {
+	if ((first == 0) || (n > MAX_ANIM_SLOTS) || (tab[0] == 0) || (tab[0] & COLD_ANIM_FLAG)) {
 		return size;
 	}
 
 	/* distinct animations in file order; kept if any slot that uses it is */
 	for (i = 0; i < n; i++) {
+		/* Cold entries name external streams, never resident offsets. */
 		o = tab[i];
-		if (o == 0) {
+		if ((o == 0) || (o & COLD_ANIM_FLAG)) {
 			continue;
 		}
-		isKept = (NPC_ANIM_KEEP_MASKS[NPC_ANIM_KEEP_INDEX[type]][i >> 5] >> (i & 31)) & 1;
+		isKept = (mask[i >> 5] >> (i & 31)) & 1;
 		for (j = 0; (j < ns) && (starts[j] != o); j++);
 		if (j == ns) {
 			for (k = ns++; (k > 0) && (starts[k - 1] > o); k--) {
@@ -151,7 +156,7 @@ int32_t compactNpcModel(int32_t type, uint8_t *mmd, int32_t size)
 
 	/* the stub: frame count 1, slot 0's first pose, end */
 	anim0 = (int16_t *)((uint8_t *)tab + tab[0]);
-	poseWords = (DIGIMON_DATA[type].boneCount - 1) * ((anim0[0] & 0x8000) ? 9 : 6);
+	poseWords = (DIGI_PARA(type).boneCount - 1) * ((anim0[0] & 0x8000) ? 9 : 6);
 	stubBytes = (poseWords + 2) * 2;
 	if (dropped < (uint32_t)stubBytes + 16) {
 		return size;
@@ -171,7 +176,7 @@ int32_t compactNpcModel(int32_t type, uint8_t *mmd, int32_t size)
 		}
 	}
 	for (i = 0; i < n; i++) {
-		if (tab[i] == 0) {
+		if ((tab[i] == 0) || (tab[i] & COLD_ANIM_FLAG)) {
 			continue;
 		}
 		for (j = 0; starts[j] != tab[i]; j++);
-- 
2.55.0

