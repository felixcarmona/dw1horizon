From cd8679673b8741c49b46e68a10e224f1032be719 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Sun, 22 Nov 2026 16:25:31 +0000
Subject: [PATCH] NORMAL difficulty: late-game enemies have more HP, hit harder
 and always hurt

On NORMAL an enemy with at least 4000 maximum HP gets 250% HP and 150% Offense, and every enemy hit
does at least 25% of the same hit against Defense zero. The early game is untouched. The numbers are
data (battleFormulas.normal). EASY and two-player VS are not changed.
---
 include/dw/mod_battle.h |  4 ++++
 include/dw/mod_hard.h   | 19 +++++++++++++++++--
 src/btl/battle_main.c   |  4 ++--
 src/std/std_main.c      |  2 +-
 4 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/include/dw/mod_battle.h b/include/dw/mod_battle.h
index e70e21c4..1f791cfe 100644
--- a/include/dw/mod_battle.h
+++ b/include/dw/mod_battle.h
@@ -182,6 +182,10 @@ enum {
 	MOD_BT_HARD_FLOOR,
 	MOD_BT_DEF_KNEE,
 	MOD_BT_DEF_HALF,
+	MOD_BT_NORMAL_FROM_HP,	/* NORMAL: an enemy whose maximum HP is at least this much is a late-game enemy (0: none) */
+	MOD_BT_NORMAL_HP,	/* NORMAL: its maximum HP, in percent */
+	MOD_BT_NORMAL_OFF,	/* NORMAL: its Offense, in percent */
+	MOD_BT_NORMAL_FLOOR,	/* NORMAL: the least an enemy hit does, in percent of the same hit against Defense zero (0: none) */
 	MOD_BT_SIZE
 };
 
diff --git a/include/dw/mod_hard.h b/include/dw/mod_hard.h
index 400cc879..b78ecc56 100644
--- a/include/dw/mod_hard.h
+++ b/include/dw/mod_hard.h
@@ -17,15 +17,21 @@ static inline int32_t modHardScale(int32_t value, int32_t slot, int32_t cap)
 }
 
 /* Round the minimum upward, including after ordinary block chip rounding. */
+static inline int32_t modFloorPercent(void)
+{
+    if (MOD_OPT_DIFFICULTY == MOD_DIFF_EASY) return 0;
+    return MOD_OPT_DIFFICULTY == MOD_DIFF_HARD ? BM(HARD_FLOOR) : BM(NORMAL_FLOOR);
+}
+
 static inline int32_t modHardMinimum(int32_t zeroDamage)
 {
-    return (zeroDamage * BM(HARD_FLOOR) + 99) / 100;
+    return (zeroDamage * modFloorPercent() + 99) / 100;
 }
 
 static inline int32_t modHardBlockedFloor(int32_t damage, int32_t zeroDamage, int32_t blockPercent)
 {
     int32_t minimum;
-    if (MOD_OPT_DIFFICULTY != MOD_DIFF_HARD || zeroDamage <= 0) return damage;
+    if (modFloorPercent() <= 0 || zeroDamage <= 0) return damage;
     minimum = modHardMinimum(zeroDamage * blockPercent / 100);
     return damage < minimum ? minimum : damage;
 }
@@ -35,6 +41,15 @@ static inline int32_t modHardBlockedFloor(int32_t damage, int32_t zeroDamage, in
 static inline void modHardEnemy(Stats *stats)
 {
     int32_t oldHP = stats->base.hp;
+    if (MOD_OPT_DIFFICULTY == MOD_DIFF_NORMAL && BM(NORMAL_FROM_HP) > 0 && oldHP >= BM(NORMAL_FROM_HP)) {
+        /* NORMAL: the late-game enemies are tougher (tools/balance.py battleFormulas normal.*); the early game is untouched */
+        stats->base.hp = oldHP * modBtSpan(MOD_BT_NORMAL_HP) / 100;
+        if (stats->base.hp > HPMP_CAP) stats->base.hp = HPMP_CAP;
+        stats->current.currentHP = (int32_t)stats->current.currentHP * stats->base.hp / oldHP;
+        stats->base.off = stats->base.off * modBtSpan(MOD_BT_NORMAL_OFF) / 100;
+        if (stats->base.off > STAT_CAP) stats->base.off = STAT_CAP;
+        return;
+    }
     if (MOD_OPT_DIFFICULTY != MOD_DIFF_HARD) return;
     stats->base.hp = modHardScale(stats->base.hp, MOD_BT_HARD_HP, HPMP_CAP);
     if (oldHP > 0) stats->current.currentHP = (int32_t)stats->current.currentHP * stats->base.hp / oldHP;
diff --git a/src/btl/battle_main.c b/src/btl/battle_main.c
index 5f194c9c..2de686b7 100644
--- a/src/btl/battle_main.c
+++ b/src/btl/battle_main.c
@@ -766,7 +766,7 @@ void BTL_deinitializeCombat(void)
 		if (i != 0) {
 			stats = &((DigimonEntity *)ENTITY_TABLE[COMBAT_DATA_PTR->player.entityIds[i]])->stats;
 			src = (int16_t *)&INITIAL_COMBAT_STATS[i];
-			if (MOD_OPT_DIFFICULTY == MOD_DIFF_HARD) stats->base.hp = src[0];
+			if (MOD_OPT_DIFFICULTY != MOD_DIFF_EASY) stats->base.hp = src[0];
 			stats->current.currentHP = *src++;
 			stats->current.currentMP = *src++;
 			stats->base.off = *src++;
@@ -2075,7 +2075,7 @@ int32_t BTL_calculateDamage(DigimonEntity *attacker, DigimonEntity *defender, in
 		diff = off - def;
 		roll = randomLimit(BMS(RAND_SPAN)) + BM(RAND_MIN);
         dmg = BMD((mult[0] + mult[1] + mult[2]) * modBtDefensePower(modSpeciesMove(attacker->entity.type, move)->power, off, defender->stats.base.def, move == 0x2d), DMG_DIV) * roll / 100;
-        if (MOD_OPT_DIFFICULTY == MOD_DIFF_HARD && (Entity *)defender == ENTITY_TABLE[1] && (Entity *)attacker != ENTITY_TABLE[1]) {
+        if (modFloorPercent() > 0 && (Entity *)defender == ENTITY_TABLE[1] && (Entity *)attacker != ENTITY_TABLE[1]) {
             floorDamage = BMD((mult[0] + mult[1] + mult[2]) * modBtStatPower(modSpeciesMove(attacker->entity.type, move)->power, off), DMG_DIV) * roll / 100;
             if (floorDamage > DAMAGE_CAP) floorDamage = DAMAGE_CAP;
             BTL_HARD_ZERO_DAMAGE = floorDamage;
diff --git a/src/std/std_main.c b/src/std/std_main.c
index 12bb24cf..3826701c 100644
--- a/src/std/std_main.c
+++ b/src/std/std_main.c
@@ -5860,7 +5860,7 @@ int32_t STD_calculateDamage(DigimonEntity *attacker, DigimonEntity *defender, in
 		diff = off - def;
 		roll = randomLimit(BMS(RAND_SPAN)) + BM(RAND_MIN);
         dmg = BMD((mult[0] + mult[1] + mult[2]) * modBtDefensePower(modSpeciesMove(attacker->entity.type, move)->power, off, defender->stats.base.def, move == 0x2d), DMG_DIV) * roll / 100;
-        if (MOD_OPT_DIFFICULTY == MOD_DIFF_HARD && (Entity *)defender == ENTITY_TABLE[1] && (Entity *)attacker != ENTITY_TABLE[1]) {
+        if (modFloorPercent() > 0 && (Entity *)defender == ENTITY_TABLE[1] && (Entity *)attacker != ENTITY_TABLE[1]) {
             floorDamage = BMD((mult[0] + mult[1] + mult[2]) * modBtStatPower(modSpeciesMove(attacker->entity.type, move)->power, off), DMG_DIV) * roll / 100;
             if (floorDamage > DAMAGE_CAP) floorDamage = DAMAGE_CAP;
             STD_HARD_ZERO_DAMAGE = floorDamage;
-- 
