 #endif
 		prepareSaveFile(0); /* MOD (save v2): checksums, extension, mirror */
 		status = writeSaveFile();
@@ -3296,6 +3303,7 @@ void tickMainMenu(void)
 			memcpy(SAVE_FILE.reserved, SAVE_TITLE_RESERVED, 0x1C);
 			modTitleNameTail(); /* MOD (long names) */
