@@ -2655,7 +2660,8 @@ void tickMainMenu(void)
 				TARGET_MENU = 0x32;
 				MAIN_MENU_ACTION = 5;
 				break;
-			case 4: /* MOD (options) */
+			case 4: /* MOD (options): showing the newest save's */
+				modCardOptions();
