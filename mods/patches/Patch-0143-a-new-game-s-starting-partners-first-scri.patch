From 0669c7d765339c112d01c6b8b0bb4e69738febca Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Sun, 18 Oct 2026 21:01:13 +0000
Subject: [PATCH 143/143] Patch 0143: a new game's starting partners, first
 script, empty-save exit and species and the card shop's first stock as
 MOD_NEWGAME slots

---
 include/dw/mod_rules.h | 8 +++++++-
 src/main/main.c        | 7 ++++---
 src/main/main_menu.c   | 8 ++++----
 3 files changed, 15 insertions(+), 8 deletions(-)

diff --git a/include/dw/mod_rules.h b/include/dw/mod_rules.h
index 33587a54..57f14324 100644
--- a/include/dw/mod_rules.h
+++ b/include/dw/mod_rules.h
@@ -62,7 +62,7 @@ extern int16_t MOD_DAILY[MOD_DAILY_SIZE];
 
 /* a new game and a new partner: MOD_NEWGAME[], every slot -1 = the rule does not exist (modNewGame answers 0), written by tools/balance.py
  * from content/tables/new-game.json */
-#define MOD_NEWGAME_SIZE	9
+#define MOD_NEWGAME_SIZE	20
 #define MOD_NG_MONEY		0 /* the tamer's money in a new game */
 #define MOD_NG_START_HOUR	1 /* the game clock in a new game */
 #define MOD_NG_START_MINUTE	2
@@ -72,6 +72,12 @@ extern int16_t MOD_DAILY[MOD_DAILY_SIZE];
 #define MOD_NG_BIRTH_LIFETIME	6 /* the lifetime (hours) of every partner that is born or reborn */
 #define MOD_NG_BIRTH_DISCIPLINE	7
 #define MOD_NG_BIRTH_HAPPINESS	8
+#define MOD_NG_STARTER0		9 /* the partner the Jijimon scene gives: the first choice (pstat 0xfe = 0) ... */
+#define MOD_NG_STARTER1		10 /* ... and the second */
+#define MOD_NG_START_SCRIPT	11 /* the MAPHEAD section that starts a new game (puts the tamer on its first screen) */
+#define MOD_NG_START_EXIT	12 /* the exit stored in the empty save of a new slot */
+#define MOD_NG_FIRST_SPECIES	13 /* the partner type stored in that empty save */
+#define MOD_NG_SHOP_CARD0	14 /* the first six values of the card shop's script state (SAVE scriptState[0..5]) */
 extern int32_t MOD_NEWGAME[MOD_NEWGAME_SIZE];
 int32_t modNewGame(int32_t slot);
 
diff --git a/src/main/main.c b/src/main/main.c
index da7fed8b..6a3a1759 100644
--- a/src/main/main.c
+++ b/src/main/main.c
@@ -25,6 +25,7 @@
 #include <dw/map.h>
 #include <dw/map_object.h>
 #include <dw/mod_fps.h>
+#include <dw/mod_rules.h>
 #include <dw/model.h>
 #include <dw/params.h>
 #include <dw/partner.h>
@@ -3504,15 +3505,15 @@ int32_t main(void)
 			loadStackedTIMFile(MAIN_D_8012CE8C);
 			initializeTamer(0, 0, 0, 0, 0, 0, 0);
 			if (readPStat(0xfe) == 0) {
-				partnerId = 0x3;
+				partnerId = modNewGame(MOD_NG_STARTER0); /* MOD (new game as data): was 0x3 */
 			} else {
-				partnerId = 0x11;
+				partnerId = modNewGame(MOD_NG_STARTER1); /* was 0x11 */
 			}
 			initializePartner(partnerId, 0, 0, 0, 0, 0, 0);
 			setDigimonRaised(partnerId);
 			initializeMap();
 			initializeChest();
-			runMapHeadScript(0xcc);
+			runMapHeadScript(modNewGame(MOD_NG_START_SCRIPT)); /* was 0xcc */
 			addClock();
 			stopGameTime();
 			break;
diff --git a/src/main/main_menu.c b/src/main/main_menu.c
index a8293c5b..fec1ee7f 100644
--- a/src/main/main_menu.c
+++ b/src/main/main_menu.c
@@ -4080,7 +4080,7 @@ int32_t tickSelectSlotInput(MenuCursor *cursor, int32_t which)
 }
 
 /* MOD (new game as data): written by tools/balance.py from content/tables/new-game.json; -1 = the rule does not exist */
-int32_t MOD_NEWGAME[MOD_NEWGAME_SIZE] = { -1, -1, -1, -1, -1, -1, -1, -1, -1 };
+int32_t MOD_NEWGAME[MOD_NEWGAME_SIZE] = { [0 ... MOD_NEWGAME_SIZE - 1] = -1 };
 
 int32_t modNewGame(int32_t slot)
 {
@@ -4103,8 +4103,8 @@ void initializeDefaultSavegame(void)
 	}
 	savegame->mainState = 0;
 	savegame->currentScreen = SCREEN_LEGACY_NONE;
-	savegame->currentExit = 9;
-	savegame->partnerType = 0x72;
+	savegame->currentExit = modNewGame(MOD_NG_START_EXIT);
+	savegame->partnerType = modNewGame(MOD_NG_FIRST_SPECIES);
 	strcpy(savegame->playerName, MAIN_D_801346C4);
 	strcpy(savegame->digimonName, MAIN_D_8013468C);
 
@@ -4126,7 +4126,7 @@ void initializeDefaultSavegame(void)
 	savegame->partnerPara.remainingLifetime = modNewGame(MOD_NG_FIRST_LIFETIME);
 	savegame->partnerPara.age = modNewGame(MOD_NG_FIRST_AGE);
 	for (i = 0; i < 6; i++) {
-		savegame->scriptState[i] = 0x3A + i;
+		savegame->scriptState[i] = modNewGame(MOD_NG_SHOP_CARD0 + i);
 	}
 
 	defaultInventoryCounts = DEFAULT_INVENTORY_AMOUNTS;
-- 
2.53.0

