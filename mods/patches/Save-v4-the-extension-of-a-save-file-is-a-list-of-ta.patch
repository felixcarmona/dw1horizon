+/* the bytes of one copy's extension in the file being handled (SAVE_FILE_BYTES); a one-block file has none, but one is still built */
+static int32_t saveExtSize(void)
+{
+	int32_t n = (SAVE_FILE_BYTES - SAVE_V1_BYTES) / 2;
