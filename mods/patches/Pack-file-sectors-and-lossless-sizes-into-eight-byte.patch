From d4efe72b9fdc7a0a1ea6d5d5371bf1676bd8d18c Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Wed, 28 Oct 2026 02:55:47 +0000
Subject: [PATCH] Pack file sectors and lossless sizes into eight-byte entries

---
 include/dw/file_table.h  |   25 +-
 src/main/file.c          |   10 +-
 src/main/file_table_us.c | 1658 +++++++++++++++++++-------------------
 src/main/mod_options.c   |    4 +-
 src/main/model.c         |    2 +-
 tools/gen_lang_files.py  |   15 +-
 6 files changed, 861 insertions(+), 853 deletions(-)

diff --git a/include/dw/file_table.h b/include/dw/file_table.h
index 103ecd79..5ae0e875 100644
--- a/include/dw/file_table.h
+++ b/include/dw/file_table.h
@@ -6,18 +6,25 @@
 extern int16_t ATAN_LOOKUP_TABLE[];
 extern int16_t SIN_LOOKUP_TABLE[];
 
-/*
- * MOD (file table): the name is in the entry (8.3 names of the disc, 12 letters at most; one of 12 has no NUL), not a
- * pointer to a string: 20 bytes an entry, not 12 and a string aligned to 4 (16 at most). The mod's discs add hundreds
- * of names (new screens, language and story copies) to the executable's resident data. Compare with fileEntryIs.
- */
+/* Packed DWFH v2: exact 19-bit LBA, lossless 21-bit size code,
+ * and a collision-checked 24-bit FNV key. Sizes below 1 MiB are literal;
+ * larger archives use 64-byte units (up to 64 MiB). The disc writer rejects
+ * unrepresentable sectors/sizes; packed access is byte-aligned on R3000. */
 #define FILE_NAME_MAX 12
+#define FILE_SIZE_CODE(n) ((n) < 0x100000 ? (n) : 0x100000 | ((n) >> 6))
 
-typedef struct {
-    int32_t sector;
-    int32_t size;
-    uint32_t nameHash; /* FNV-1a of the filename; the builder rejects collisions. */
+typedef struct __attribute__((packed)) {
+    uint32_t sector : 19;
+    uint32_t sizeCode : 21;
+    uint32_t nameHash : 24;
 } FileEntry;
+_Static_assert(sizeof(FileEntry) == 8, "packed file entry must occupy eight bytes");
+
+static inline uint32_t fileEntrySize(const FileEntry *entry)
+{
+    uint32_t n = entry->sizeCode;
+    return n & 0x100000 ? (n & 0xFFFFF) << 6 : n;
+}
 
 extern FileEntry FILE_OFFSET_TABLE[];
 /* MOD (file table): 1 when the entry is the file `name` */
diff --git a/src/main/file.c b/src/main/file.c
index e920dc72..a7941510 100644
--- a/src/main/file.c
+++ b/src/main/file.c
@@ -29,7 +29,7 @@ char *modFontFile(char *path, char *originalFont)
 	if (MOD_FONT == MOD_FONT_NEW) {
 		return path;
 	}
-	for (entry = FILE_OFFSET_TABLE; entry->size != 0; ++entry) {
+	for (entry = FILE_OFFSET_TABLE; entry->sizeCode != 0; ++entry) {
 		if (fileEntryIs(entry, originalFont)) {
 			return entry->sector != 0 ? originalFont : path;
 		}
@@ -48,7 +48,7 @@ int32_t fileEntryIs(FileEntry *entry, char *name)
     } else {
         for (i = 0; name[i]; i++) hash = (hash ^ (uint8_t)name[i]) * 0x01000193;
     }
-    return hash == entry->nameHash;
+    return (hash & 0xFFFFFF) == entry->nameHash;
 }
 
 int32_t lookupFileTable(FileLookup *lookup, char *path)
@@ -64,15 +64,15 @@ int32_t lookupFileTable(FileLookup *lookup, char *path)
 	}
 	filename = modStoryFile(modLangFile(filename)); /* MOD (language, story): the language's copy, then its story's */
 
-	for (; entry->size != 0; ++entry) {
+	for (; entry->sizeCode != 0; ++entry) {
 		if (fileEntryIs(entry, filename)) {
-			lookup->size = entry->size;
+			lookup->size = fileEntrySize(entry);
 			CdIntToPos(entry->sector, &lookup->pos);
 			break;
 		}
 	}
 
-	if (entry->size) {
+	if (entry->sizeCode) {
 		return 1;
 	} else {
 		empty_800a31f0(path);
