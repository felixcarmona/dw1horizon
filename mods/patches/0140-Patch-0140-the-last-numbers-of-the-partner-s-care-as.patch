From 989f9cd61737f02d006e08bd88bd0d0399f0b988 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Sun, 18 Oct 2026 20:54:03 +0000
Subject: [PATCH] Patch 0140: the last numbers of the partner's care as
 MOD_CARE slots: the happiness a sulking partner regains, the tiredness a
 sub-tiredness counter adds (capped by the tiredness limit), the species that
 eat poop and how close the tamer must be; skipHours takes the lifetime lost
 to unhappiness from the lifetime rule

---
 include/dw/level.h      |  9 ++++++++-
 src/main/partner_impl.c | 31 ++++++++++++++++++-------------
 2 files changed, 26 insertions(+), 14 deletions(-)

diff --git a/include/dw/level.h b/include/dw/level.h
index 15be7f24..9531ad88 100644
--- a/include/dw/level.h
+++ b/include/dw/level.h
@@ -114,7 +114,7 @@ void modTamerLevelEvent(int32_t slot, int32_t amount);
  * A period or a threshold left out (-1) switches its rule off; an amount left out counts as 0. Periods are logic frames: 20 = one game minute,
  * 1200 = one game hour. The direction of each amount (a loss, a gain) is its name and stays in the code.
  */
-#define MOD_CARE_SIZE		143
+#define MOD_CARE_SIZE		150
 #define MOD_CARE_SLEEP_TIRED_PERIOD	0
 #define MOD_CARE_SLEEP_TIRED_PERCENT	1
 #define MOD_CARE_SLEEP_SLEEPY_AT	2
@@ -258,6 +258,13 @@ void modTamerLevelEvent(int32_t slot, int32_t amount);
 #define MOD_CARE_FOOD_SICK_DIE	140
 #define MOD_CARE_MEDICINE_INJURY_DIE	141
 #define MOD_CARE_MEDICINE_SICK_DIE	142
+#define MOD_CARE_SULK_RECOVER_GAIN	143 /* happiness a sulking partner regains every recover period */
+#define MOD_CARE_TIRED_SUB_GAIN	144 /* tiredness one full sub-tiredness counter makes (capped by the tiredness limit) */
+#define MOD_CARE_EAT_REACH_NEAR	145 /* how close (world units) the tamer must be to a small poop for the partner to go and eat it */
+#define MOD_CARE_EAT_REACH_FAR	146 /* the same for a poop of farFrom or more */
+#define MOD_CARE_EAT_FAR_FROM	147
+#define MOD_CARE_EAT_SPECIES0	148 /* the species that eat poop (-1 = none) */
+#define MOD_CARE_EAT_SPECIES1	149
 extern int16_t MOD_CARE[MOD_CARE_SIZE];
 /*
  * MOD (item effects as data): what an item does when it is used, MOD_ITEM_FX[row][field]: field 0 the item id (-1 = the row is unused), then the fields below
diff --git a/src/main/partner_impl.c b/src/main/partner_impl.c
index 14e0043e..5fe59142 100644
--- a/src/main/partner_impl.c
+++ b/src/main/partner_impl.c
@@ -1209,7 +1209,7 @@ void tickUnhappinessMechanics(void)
 
 	if (PARTNER_PARA.condition & 0x10) {
 		if (careEvery(MOD_CARE_SULK_RECOVER_PERIOD)) {
-			PARTNER_PARA.happiness++;
+			PARTNER_PARA.happiness += careAmt(MOD_CARE_SULK_RECOVER_GAIN);
 		}
 
 		if (careEvery(MOD_CARE_SULK_STAT_PERIOD)) {
@@ -1555,9 +1555,9 @@ void tickTirednessMechanics(void)
 		}
 	}
 	if (careHas(MOD_CARE_TIRED_SUB) && PARTNER_PARA.subTiredness >= careGet(MOD_CARE_TIRED_SUB)) {
-		PARTNER_PARA.tiredness += 1;
-		if (PARTNER_PARA.tiredness >= 0x64) {
-			PARTNER_PARA.tiredness = 0x64;
+		PARTNER_PARA.tiredness += careAmt(MOD_CARE_TIRED_SUB_GAIN);
+		if (careHas(MOD_CARE_LIM_TIRED_MAX) && PARTNER_PARA.tiredness >= careGet(MOD_CARE_LIM_TIRED_MAX)) {
+			PARTNER_PARA.tiredness = careGet(MOD_CARE_LIM_TIRED_MAX);
 		}
 		PARTNER_PARA.subTiredness = 0;
 	}
@@ -1846,8 +1846,11 @@ void tickPoopDetection(void)
 	int16_t posZ;
 	int32_t i;
 
-	if ((PARTNER_ENTITY.digimonEntity.entity.type != 0xb) &&
-	    (PARTNER_ENTITY.digimonEntity.entity.type != 0x27)) {
+	if (!careHas(MOD_CARE_EAT_SPECIES0) && !careHas(MOD_CARE_EAT_SPECIES1)) {
+		return;
+	}
+	if ((PARTNER_ENTITY.digimonEntity.entity.type != careGet(MOD_CARE_EAT_SPECIES0)) &&
+	    (PARTNER_ENTITY.digimonEntity.entity.type != careGet(MOD_CARE_EAT_SPECIES1))) {
 		return;
 	}
 
@@ -1857,10 +1860,10 @@ void tickPoopDetection(void)
 			continue;
 		}
 
-		if (WORLD_POOP[i].size < 11) {
-			radius = 200;
+		if (WORLD_POOP[i].size < careAmt(MOD_CARE_EAT_FAR_FROM)) {
+			radius = careAmt(MOD_CARE_EAT_REACH_NEAR);
 		} else {
-			radius = 300;
+			radius = careAmt(MOD_CARE_EAT_REACH_FAR);
 		}
 
 		tileX = ((WORLD_POOP[i].x - 50) * 100) + 50;
@@ -2100,9 +2103,10 @@ void skipHours(int16_t hours)
 	}
 	updateTimeOfDay();
 
-	if ((HOUR + (hours % 4) == 0) && (PARTNER_PARA.happiness < 80))
+	if ((HOUR + (hours % 4) == 0) && careHas(MOD_CARE_LIFE_BELOW) && careGet(MOD_CARE_LIFE_PER_POINTS) > 0 &&
+	    (PARTNER_PARA.happiness < careGet(MOD_CARE_LIFE_BELOW)))
 		PARTNER_PARA.remainingLifetime = PARTNER_PARA.remainingLifetime -
-			((PARTNER_PARA.happiness - 80) / -50 + 1);
+			((PARTNER_PARA.happiness - careGet(MOD_CARE_LIFE_BELOW)) / -careGet(MOD_CARE_LIFE_PER_POINTS) + 1);
 	if (PARTNER_PARA.remainingLifetime < 0)
 		PARTNER_PARA.remainingLifetime = 0;
 
@@ -2149,9 +2153,10 @@ void skipHours(int32_t hours)
 	}
 	updateTimeOfDay();
 
-	if ((HOUR + (rawHours % 4) == 0) && (PARTNER_PARA.happiness < 80))
+	if ((HOUR + (rawHours % 4) == 0) && careHas(MOD_CARE_LIFE_BELOW) && careGet(MOD_CARE_LIFE_PER_POINTS) > 0 &&
+	    (PARTNER_PARA.happiness < careGet(MOD_CARE_LIFE_BELOW)))
 		PARTNER_PARA.remainingLifetime = PARTNER_PARA.remainingLifetime -
-			((PARTNER_PARA.happiness - 80) / -50 + 1);
+			((PARTNER_PARA.happiness - careGet(MOD_CARE_LIFE_BELOW)) / -careGet(MOD_CARE_LIFE_PER_POINTS) + 1);
 	if (PARTNER_PARA.remainingLifetime < 0)
 		PARTNER_PARA.remainingLifetime = 0;
 
-- 
2.53.0

