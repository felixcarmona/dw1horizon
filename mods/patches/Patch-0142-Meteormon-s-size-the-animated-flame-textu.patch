From 29aecdd07ac725b8e532a676b7695ee80f70cc68 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Sun, 18 Oct 2026 21:00:21 +0000
Subject: [PATCH 142/143] Patch 0142: Meteormon's size, the animated flame
 textures and the last-battle music rule as data (MOD_MODEL_SCALE,
 MOD_ANIM_TEXTURE, two MOD_BATTLE slots), the defeat countdown's digit time as
 a MOD_BATTLE slot

---
 include/dw/mod_battle.h |  3 +++
 include/dw/mod_rules.h  | 10 ++++++++++
 src/btl/battle_hud.c    |  6 +++---
 src/btl/battle_main.c   | 17 ++++-------------
 src/main/anim.c         | 23 ++++-------------------
 src/main/btl.c          |  6 ++++--
 src/main/mod_species.c  | 29 +++++++++++++++++++++++++++++
 src/main/model.c        |  7 ++-----
 src/std/std_main.c      | 11 ++---------
 9 files changed, 61 insertions(+), 51 deletions(-)

diff --git a/include/dw/mod_battle.h b/include/dw/mod_battle.h
index 53e67b02..569ac957 100644
--- a/include/dw/mod_battle.h
+++ b/include/dw/mod_battle.h
@@ -166,6 +166,9 @@ enum {
 	MOD_BT_T_DEFEAT_SHOW,
 	MOD_BT_T_DEFEAT_END,
 	MOD_BT_T_SETTLE,
+	MOD_BT_T_DIGIT,		/* ticks a digit of the defeat countdown shows (it pulses 20 ticks of them; the countdown ends after 5) */
+	MOD_BT_MUSIC_LAST_SPECIES,	/* the species whose presence on the player's side (entity 1) makes the battle play the last-battle track (-1: none) */
+	MOD_BT_MUSIC_LAST_TRACK,	/* the track (font 0x21) it plays */
 	MOD_BT_SIZE
 };
 
diff --git a/include/dw/mod_rules.h b/include/dw/mod_rules.h
index 734fa300..33587a54 100644
--- a/include/dw/mod_rules.h
+++ b/include/dw/mod_rules.h
@@ -158,6 +158,16 @@ static inline const int16_t *trainGainRow(int16_t rows[][MOD_TG_WIDTH], int32_t
 	return any;
 }
 
+/* MOD (species rules as data): the few things the game does for a species by number, MOD_MODEL_SCALE[] rows {species, percent} (the model is drawn at that
+ * percent of its size; a species without a row is drawn at 100) and MOD_ANIM_TEXTURE[] rows {species, width} (the species whose texture is animated, the
+ * flames, and the width of the strip that moves). A row with species -1 is empty; written by tools/balance.py from content/tables/species-rules.json. */
+#define MOD_MODEL_SCALE_ROWS	8
+#define MOD_ANIM_TEXTURE_ROWS	16
+extern int16_t MOD_MODEL_SCALE[MOD_MODEL_SCALE_ROWS][2];
+extern int16_t MOD_ANIM_TEXTURE[MOD_ANIM_TEXTURE_ROWS][2];
+int32_t modModelScale(int32_t type);			/* the scale as GsCOORDINATE scale (0x1000 = 100 percent) */
+int32_t modAnimatedTextureWidth(int32_t type);	/* 0 = the species has no animated texture */
+
 /* the game clock: how many real seconds one game day lasts (MOD_CLOCK[0], -1: game time does not run). A frame of CURRENT_FRAME is
  * 1/20 of a game minute (3 game seconds) whatever the screen's frame rate; the logic runs at 20 ticks a second. */
 #define MOD_CLOCK_SIZE		1
diff --git a/src/btl/battle_hud.c b/src/btl/battle_hud.c
index 1575c854..6ec57118 100644
--- a/src/btl/battle_hud.c
+++ b/src/btl/battle_hud.c
@@ -444,11 +444,11 @@ void BTL_tickDeathCountdown(void)
 		spin = &BTL_DEATH_COUNTDOWN.data.sprite;
 		do {
 			BTL_DEATH_COUNTDOWN.data.timer++;
-			if ((BTL_DEATH_COUNTDOWN.data.timer % 31) == 0) {
+			if ((BTL_DEATH_COUNTDOWN.data.timer % (BMS(T_DIGIT) + 1)) == 0) {
 				BTL_DEATH_COUNTDOWN.data.step = 0;
 			}
 			BTL_DEATH_COUNTDOWN.data.step++;
-			frame = (BTL_DEATH_COUNTDOWN.data.timer + 0x1d) / 30;
+			frame = (BTL_DEATH_COUNTDOWN.data.timer + BMS(T_DIGIT) - 1) / BMS(T_DIGIT);
 			if (frame < 5) {
 				spin->u = BTL_DEATH_COUNTDOWN_DIGIT_U[frame - 1];
 				spin->v = BTL_DEATH_COUNTDOWN_DIGIT_V[frame - 1];
@@ -492,7 +492,7 @@ void BTL_renderDeathCountdown(void)
 {
 	GsSortSprite(&BTL_DEATH_COUNTDOWN.data.sprite, ACTIVE_ORDERING_TABLE, 7);
 	GsSortSprite(&BTL_DEATH_COUNTDOWN_SPRITE, ACTIVE_ORDERING_TABLE, 7);
-	if (BTL_DEATH_COUNTDOWN.data.timer >= 0x96) {
+	if (BTL_DEATH_COUNTDOWN.data.timer >= 5 * BMS(T_DIGIT)) {
 		BTL_removeDeathCountdown();
 	}
 }
