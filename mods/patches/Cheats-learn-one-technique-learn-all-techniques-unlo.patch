From dc81899e6e96f82b1ad2484544401855dfcdcc24 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Tue, 17 Nov 2026 20:15:26 +0000
Subject: [PATCH] Cheats: learn one technique, learn all techniques, unlock the
 evolution chart

---
 src/main/mod_lab_menu.inc | 30 ++++++++++++++++++++++--------
 text/main/mod_lab.yaml    | 15 +++++++++++++++
 2 files changed, 37 insertions(+), 8 deletions(-)

diff --git a/src/main/mod_lab_menu.inc b/src/main/mod_lab_menu.inc
index 3efe8cc..cd6aa2a 100644
--- a/src/main/mod_lab_menu.inc
+++ b/src/main/mod_lab_menu.inc
@@ -1,7 +1,7 @@
 /* Private laboratory implementation; included by mod_lab.c. Ten texture rows fit below UV 256; createPauseBox restores its shared last row on return. */
 #define MOD_LAB_BOX 5
 #define MOD_LAB_TEXT_Y 0x84
-#define MOD_LAB_OPTIONS 12
+#define MOD_LAB_OPTIONS 15
 #define LAB_ROW_SHORTCUTS 6
 #define MOD_LAB_OPT_EVOLVE 3
 #define PAD_SELECT 0x100
@@ -45,7 +45,7 @@ static int16_t MOD_LAB_EVO_TARGETS[] = { DIGIMON_MASTER_TYRANNOMON, DIGIMON_CHER
     DIGIMON_MYOTISMON, DIGIMON_SHOGUNGEKOMON, DIGIMON_MACHINEDRAMON, DIGIMON_JIJIMON, DIGIMON_ANALOGMAN };
 #define MOD_LAB_EVO_FIXED ((int32_t)(sizeof(MOD_LAB_EVO_TARGETS) / sizeof(MOD_LAB_EVO_TARGETS[0])))
 
-enum { LAB_HOME, LAB_VALUES, LAB_NUMBER, LAB_EVOLVE, LAB_MAPS, LAB_CONFIRM };
+enum { LAB_HOME, LAB_VALUES, LAB_NUMBER, LAB_EVOLVE, LAB_MAPS, LAB_CONFIRM, LAB_MOVES };
 int32_t MOD_LAB_VIEW, MOD_LAB_CURSOR, MOD_LAB_VALUE, MOD_LAB_TARGET;
 int32_t MOD_CHEATS_CARD_MODE, MOD_CHEATS_CARD_DONE, MOD_CHEATS_TRANSITION;
 static int32_t labAction;
@@ -57,7 +57,8 @@ static uint16_t *labChoices; /* points into modLabMenu's stack, valid until the
 static char *modLabMessage;
 static char labText[LAB_ROWS][96];
 static char *const LAB_HOME_TEXT[] = { LAB_STR_ADD_BITS, LAB_STR_SATIATE, LAB_STR_PARAMETERS,
-    LAB_STR_EVOLVE, LAB_STR_TELEPORT, LAB_STR_HEAL, LAB_STR_SHORTCUTS_OFF, LAB_STR_SAVE_GAME, LAB_STR_LOAD_GAME, LAB_STR_MAIN_MENU, LAB_STR_OLD_AGE, LAB_STR_CLOSE };
+    LAB_STR_EVOLVE, LAB_STR_TELEPORT, LAB_STR_HEAL, LAB_STR_SHORTCUTS_OFF, LAB_STR_SAVE_GAME, LAB_STR_LOAD_GAME, LAB_STR_MAIN_MENU, LAB_STR_OLD_AGE,
+    LAB_STR_LEARN, LAB_STR_LEARN_ALL, LAB_STR_UNLOCK_CHART, LAB_STR_CLOSE };
 static char *LAB_STAGES[] = { "", "Baby I", "Baby II", "Rookie", "Champion", "Ultimate", "Mega" };
 
 static char *appendStr(char *dst, const char *src)
@@ -195,7 +196,10 @@ static void modLabList(int32_t view)
     labCount = 0;
     MOD_LAB_VIEW = view;
     MOD_LAB_CURSOR = labTop = 0;
-    if (view == LAB_EVOLVE) {
+    if (view == LAB_MOVES) {
+        /* MOD (cheat techniques): every technique that has a name */
+        for (i = 0; i < NUM_MOVE_NAMES; i++) if (MOVE_NAMES[i] && MOVE_NAMES[i][0]) labChoices[labCount++] = i;
+    } else if (view == LAB_EVOLVE) {
         for (i = 1; i < NUM_ORIGINAL_DIGIMON; i++) {
             if (modRosterIsPartner(i)) labChoices[labCount++] = i;
         }
@@ -222,7 +226,7 @@ static void modLabList(int32_t view)
             } while (id >= 0 && id != first && labCount < NUM_SCREENS);
         }
     }
-    id = view == LAB_EVOLVE ? PARTNER_ENTITY.digimonEntity.entity.type : CURRENT_SCREEN;
+    id = view == LAB_EVOLVE ? PARTNER_ENTITY.digimonEntity.entity.type : view == LAB_MOVES ? 0 : CURRENT_SCREEN;
     for (i = 0; i < labCount; i++) if (labChoices[i] == id) MOD_LAB_CURSOR = i;
 }
 
@@ -309,7 +313,7 @@ static void modLabDrawText(void)
     memset(lines, 0, sizeof(lines));
     appendStr(lines[0], MOD_LAB_VIEW == LAB_HOME ? LAB_STR_TITLE :
         MOD_LAB_VIEW == LAB_VALUES ? LAB_STR_PARAMETERS : MOD_LAB_VIEW == LAB_NUMBER ? LAB_FIELDS[labField].name :
-        MOD_LAB_VIEW == LAB_EVOLVE ? LAB_STR_EVOLVE : MOD_LAB_VIEW == LAB_MAPS ? LAB_STR_TELEPORT :
+        MOD_LAB_VIEW == LAB_EVOLVE ? LAB_STR_EVOLVE : MOD_LAB_VIEW == LAB_MAPS ? LAB_STR_TELEPORT : MOD_LAB_VIEW == LAB_MOVES ? LAB_STR_LEARN :
         LAB_HOME_TEXT[labPreviousCursor]);
     if (MOD_LAB_VIEW == LAB_NUMBER) {
         labInt(lines[3], MOD_LAB_VALUE);
@@ -329,7 +333,8 @@ static void modLabDrawText(void)
             p = appendStr(p, LAB_FIELDS[n].name); p = appendStr(p, ": "); labInt(p, *modLabFieldPtr(n));
         } else {
             id = labChoices[n];
-            modLabEntry(p, id, MOD_LAB_VIEW == LAB_EVOLVE);
+            if (MOD_LAB_VIEW == LAB_MOVES) appendStr(p, MOVE_NAMES[id]);
+            else modLabEntry(p, id, MOD_LAB_VIEW == LAB_EVOLVE);
         }
     }
     p = appendStr(lines[9], "\x81\xa2 ");
@@ -538,10 +543,19 @@ void modLabMenuLoaded(uint32_t *input, uint32_t *previous)
                 case 8:
                     labPrevious = LAB_HOME; labPreviousCursor = MOD_LAB_CURSOR;
                     MOD_LAB_TARGET = 2; done = modLabPerform(); break;
-                case 11: done = 1; break;
+                case 11: modLabList(LAB_MOVES); break;
+                case 12:
+                    for (step = 0; step < NUM_MOVE_NAMES; step++) if (MOVE_NAMES[step] && MOVE_NAMES[step][0]) learnMove(step);
+                    modLabMessage = LAB_STR_MSG_LEARNED; break;
+                case 13:
+                    for (step = 1; step < NUM_DIGIMON; step++) setDigimonRaised(step);
+                    modLabMessage = LAB_STR_MSG_UNLOCKED; break;
+                case 14: done = 1; break;
                 }
             } else if (MOD_LAB_VIEW == LAB_VALUES) {
                 labField = MOD_LAB_CURSOR; MOD_LAB_VALUE = modLabClamp(labField, *modLabFieldPtr(labField)); MOD_LAB_VIEW = LAB_NUMBER; labStep = 1;
+            } else if (labCount && MOD_LAB_VIEW == LAB_MOVES) {
+                learnMove(labChoices[MOD_LAB_CURSOR]); modLabMessage = LAB_STR_MSG_LEARNED;
             } else if (labCount) {
                 labPrevious = MOD_LAB_VIEW; labPreviousCursor = MOD_LAB_CURSOR;
                 MOD_LAB_TARGET = labChoices[MOD_LAB_CURSOR];
diff --git a/text/main/mod_lab.yaml b/text/main/mod_lab.yaml
index 21b5064..9176354 100644
--- a/text/main/mod_lab.yaml
+++ b/text/main/mod_lab.yaml
@@ -310,6 +310,21 @@ MOD_LAB:
     LAB_STR_ASK_OLD_AGE:
       ja: "Let it die of old age now?"
       en_us: "Let it die of old age now?"
+    LAB_STR_LEARN:
+      ja: "Learn technique"
+      en_us: "Learn technique"
+    LAB_STR_LEARN_ALL:
+      ja: "Learn all techniques"
+      en_us: "Learn all techniques"
+    LAB_STR_UNLOCK_CHART:
+      ja: "Unlock evolution chart"
+      en_us: "Unlock evolution chart"
+    LAB_STR_MSG_LEARNED:
+      ja: "Learned!"
+      en_us: "Learned!"
+    LAB_STR_MSG_UNLOCKED:
+      ja: "Chart unlocked"
+      en_us: "Chart unlocked"
     LAB_STR_ASK_TITLE:
       ja: "Return to the main menu?"
       en_us: "Return to the main menu?"
-- 
2.55.0

