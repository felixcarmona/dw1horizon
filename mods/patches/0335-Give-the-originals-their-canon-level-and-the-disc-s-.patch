From 63f0aa3e9d6931b218594656f3596e96abc9edf8 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Tue, 3 Nov 2026 19:46:59 +0000
Subject: [PATCH] Give the originals their canon level, and the disc's with NEW
 DIGIMON off

---
 include/dw/species.h    | 12 ++++++++++++
 src/main/item.c         |  3 ++-
 src/main/main_menu.c    |  2 ++
 src/main/mod_species.c  | 34 ++++++++++++++++++++++++++++++++++
 src/main/partner_impl.c | 13 +++++++++----
 src/main/utils2.c       | 12 ++++++++----
 6 files changed, 67 insertions(+), 9 deletions(-)

diff --git a/include/dw/species.h b/include/dw/species.h
index 26a14ca..8e5fe68 100644
--- a/include/dw/species.h
+++ b/include/dw/species.h
@@ -91,6 +91,18 @@ typedef struct {
  * has no new species to keep out: every species counts as vanilla then.
  */
 #define SPECIES_HEADER_VANILLA	0x780
+/*
+ * MOD (canon levels): the originals whose species file gives them another level than the original game's (Phoenixmon,
+ * HerculesKabuterimon, MetalEtemon ... are Mega), at SPECIES_HEADER_LEVEL_OFF of the header sector: a count, then
+ * {id, level with NEW DIGIMON on, level with it off} per species. modApplySpeciesLevels writes the one of the current
+ * option into DIGIMON_DATA (at boot and whenever NEW DIGIMON changes), so with the option off the game sees the original
+ * levels and has no Mega.
+ */
+#define SPECIES_HEADER_LEVEL_OFF	0x500
+#define SPECIES_LEVEL_SWAP_MAX	32
+void modApplySpeciesLevels(void);
+/* the level the original game gives a species (its NEW DIGIMON off level): the original evolution items keep their rule with it */
+int32_t modOriginalLevel(int32_t type);
 #define SPECIES_VANILLA_BYTES	(NUM_DIGIMON / 8)
 int32_t isVanillaSpecies(int32_t type);
 /* the vanilla species a new partner species becomes with NEW DIGIMON off (its record's vanillaAs), 0 none */
diff --git a/src/main/item.c b/src/main/item.c
index 70bdab7..03ec959 100644
--- a/src/main/item.c
+++ b/src/main/item.c
@@ -5,6 +5,7 @@
 #include <libgs.h>
 
 #include <dw/mod_options.h>
+#include <dw/species.h>
 #include <dw/anim.h>
 #include <dw/btl.h>
 #include <dw/combat.h>
@@ -2209,7 +2210,7 @@ void handleEvoItems(int16_t item)
 		}
 		EVOLUTION_TARGET = modItem->target;
 	} else {
-		level = DIGI_PARA(EVOLUTION_ITEM_TARGET[item - 0x47]).level - 1;
+		level = modOriginalLevel(EVOLUTION_ITEM_TARGET[item - 0x47]) - 1; /* MOD (canon levels): the original game's level */
 		if (level != DIGI_PARA(ENTITY_TABLE[1]->type).level) {
 			return;
 		}
diff --git a/src/main/main_menu.c b/src/main/main_menu.c
index 78307f2..b2c4e8d 100644
--- a/src/main/main_menu.c
+++ b/src/main/main_menu.c
@@ -4794,6 +4794,7 @@ static void modApplyOptions(const uint8_t *d, int32_t len)
 	}
 	if (len >= 7) {
 		MOD_OPT_NEW_DIGIMON = d[6] != 0;
+		modApplySpeciesLevels(); /* MOD (canon levels) */
 	}
 	if (len >= 8) { /* MOD (language) */
 		modSetLanguage(d[7]);
@@ -6105,6 +6106,7 @@ static void modSetOption(int32_t row, int32_t value)
 		break;
 	case 4:
 		MOD_OPT_NEW_DIGIMON = value;
+		modApplySpeciesLevels(); /* MOD (canon levels) */
 		break;
 	case MOD_OPT_ROW_STORY: /* MOD (story) */
 		modSetStory(value);
diff --git a/src/main/mod_species.c b/src/main/mod_species.c
index 4840cc1..c3bfa57 100644
--- a/src/main/mod_species.c
+++ b/src/main/mod_species.c
@@ -11,6 +11,7 @@
 #include <dw/script.h>
 #include <dw/sound.h>
 #include <dw/species.h>
+#include <dw/mod_options.h>
 
 #include "common.h"
 
@@ -61,6 +62,30 @@ static EvoStatsGains NO_EVO_GAINS;
 
 static uint8_t SPECIES_VANILLA[SPECIES_VANILLA_BYTES];
 static int8_t SPECIES_HAS_VANILLA;
+/* MOD (canon levels): {id, level with NEW DIGIMON on, off} (SPECIES_HEADER_LEVEL_OFF) */
+static uint8_t SPECIES_LEVEL_SWAP[SPECIES_LEVEL_SWAP_MAX][3];
+static int32_t SPECIES_LEVEL_SWAPS;
+
+void modApplySpeciesLevels(void)
+{
+	int32_t i;
+
+	for (i = 0; i < SPECIES_LEVEL_SWAPS; i++) {
+		DIGIMON_DATA[SPECIES_LEVEL_SWAP[i][0]].level = SPECIES_LEVEL_SWAP[i][MOD_OPT_NEW_DIGIMON ? 1 : 2];
+	}
+}
+
+int32_t modOriginalLevel(int32_t type)
+{
+	int32_t i;
+
+	for (i = 0; i < SPECIES_LEVEL_SWAPS; i++) {
+		if (SPECIES_LEVEL_SWAP[i][0] == type) {
+			return SPECIES_LEVEL_SWAP[i][2];
+		}
+	}
+	return DIGI_PARA(type).level;
+}
 
 int32_t isVanillaSpecies(int32_t type)
 {
@@ -321,6 +346,7 @@ void initializeSpecies(void)
 	SPECIES_CITY_SECTOR = 0;
 	SPECIES_PARTNER_COUNT = 0;
 	SPECIES_FIRST_MEGA = 0;
+	SPECIES_LEVEL_SWAPS = 0;
 	for (i = 0; i < SPECIES_RECORD_ORIGINALS_BYTES; i++) {
 		SPECIES_RECORD_ORIGINALS[i] = 0;
 	}
@@ -370,6 +396,13 @@ void initializeSpecies(void)
 		SPECIES_VANILLA[i] = ((uint8_t *)SPECIES_SECTOR)[SPECIES_HEADER_VANILLA + i];
 		SPECIES_HAS_VANILLA |= SPECIES_VANILLA[i] != 0;
 	}
+	/* MOD (canon levels): the originals' levels with NEW DIGIMON on and off */
+	for (i = 0; i < ((uint8_t *)SPECIES_SECTOR)[SPECIES_HEADER_LEVEL_OFF] && i < SPECIES_LEVEL_SWAP_MAX; i++) {
+		SPECIES_LEVEL_SWAP[i][0] = ((uint8_t *)SPECIES_SECTOR)[SPECIES_HEADER_LEVEL_OFF + 1 + i * 3];
+		SPECIES_LEVEL_SWAP[i][1] = ((uint8_t *)SPECIES_SECTOR)[SPECIES_HEADER_LEVEL_OFF + 2 + i * 3];
+		SPECIES_LEVEL_SWAP[i][2] = ((uint8_t *)SPECIES_SECTOR)[SPECIES_HEADER_LEVEL_OFF + 3 + i * 3];
+	}
+	SPECIES_LEVEL_SWAPS = i;
 	SPECIES_FALLBACK_PORTRAIT = header->fallbackPortrait;
 	SPECIES_CHART_SECTOR = header->chartSector;
 	SPECIES_CITY_SECTOR = ((uint32_t *)header)[14];
@@ -398,6 +431,7 @@ void initializeSpecies(void)
 			copyRecordOriginal(i);
 		}
 	}
+	modApplySpeciesLevels();
 }
 
 int32_t getSpeciesPartnerCount(void)
diff --git a/src/main/partner_impl.c b/src/main/partner_impl.c
index 583f04e..51726c9 100644
--- a/src/main/partner_impl.c
+++ b/src/main/partner_impl.c
@@ -19,6 +19,7 @@
 #include <dw/ids.h>
 #include <dw/item.h>
 #include <dw/level.h>
+#include <dw/species.h>
 #include <dw/mod_rules.h>
 #include <dw/map.h>
 #include <dw/map_object.h>
@@ -1657,15 +1658,19 @@ int32_t partnerWillRefuseItem(void)
 			/* MOD (evolution rules as data): the level the partner must have is MOD_EVO_ITEMS'; an item without a row does nothing */
 			ModEvoItem *modItem = getModEvoItem(item);
 
+			/* MOD (canon levels): an item whose target is a Mega asks for an Ultimate (Metalbanana -> MetalEtemon) */
 			if (modItem == NULL ||
-			    DIGI_PARA(PARTNER_ENTITY.digimonEntity.entity.type).level != modItem->level)
+			    DIGI_PARA(PARTNER_ENTITY.digimonEntity.entity.type).level !=
+			    (DIGI_PARA(modItem->target).level == LEVEL_MEGA ? LEVEL_ULTIMATE : modItem->level))
 				return 1;
 		} else if ((DIGI_PARA(PARTNER_ENTITY.digimonEntity.entity.type).level ==
-			    DIGI_PARA(ITEM_EVOLUTION_TARGET(item)).level) ||
+			    modOriginalLevel(ITEM_EVOLUTION_TARGET(item))) ||
 			   (DIGI_PARA(PARTNER_ENTITY.digimonEntity.entity.type).level + 2 ==
-			    DIGI_PARA(ITEM_EVOLUTION_TARGET(item)).level) ||
+			    modOriginalLevel(ITEM_EVOLUTION_TARGET(item))) ||
 			   (DIGI_PARA(PARTNER_ENTITY.digimonEntity.entity.type).level - 1 ==
-			    DIGI_PARA(ITEM_EVOLUTION_TARGET(item)).level)) {
+			    modOriginalLevel(ITEM_EVOLUTION_TARGET(item)))) {
+			/* MOD (canon levels): the original items keep the original game's levels (Red Ruby and Beetlepearl on a
+			 * Champion, as the disc's routes to Phoenixmon and HerculesKabuterimon) */
 			return 1;
 		}
 	}
diff --git a/src/main/utils2.c b/src/main/utils2.c
index a225ef9..fd8cdd4 100644
--- a/src/main/utils2.c
+++ b/src/main/utils2.c
@@ -7,6 +7,7 @@
 #include <dw/btl.h>
 #include <dw/clock.h>
 #include <dw/fade.h>
+#include <dw/level.h>
 #include <dw/file.h>
 #include <dw/file_queue.h>
 #include <dw/font.h>
@@ -773,11 +774,14 @@ void startTournament(void)
 		hi = 0;
 		if (id != 0x16) {
 			while ((i = *p++) < 0xfe) {
-				if (DIGI_PARA(i).level < lo) {
-					lo = DIGI_PARA(i).level;
+				/* MOD (canon levels): a cup of the original's lists draws no Mega (Phoenixmon, HerculesKabuterimon
+				 * and MetalEtemon are Mega now; the Ultimate cups list them) */
+				k = DIGI_PARA(i).level > LEVEL_ULTIMATE ? LEVEL_ULTIMATE : DIGI_PARA(i).level;
+				if (k < lo) {
+					lo = k;
 				}
-				if (DIGI_PARA(i).level > hi) {
-					hi = DIGI_PARA(i).level;
+				if (k > hi) {
+					hi = k;
 				}
 				if (isDigimonRecruited(i)) {
 					*w++ = i;
-- 
2.55.0

