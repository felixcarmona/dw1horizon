 config/us/overlay.ld     | 89 ++++++++++++++++++++++++++++++++++++++++
 include/dw/utils.h       |  1 +
 mk/version/us.mk         |  4 ++
 src/main/file_table_us.c |  2 +
 src/main/main.c          |  2 +
 src/main/main_menu.c     | 72 +++++++++++++++++++++++---------
 src/main/partner.c       |  4 ++
 src/main/utils2.c        |  9 +++-
 9 files changed, 164 insertions(+), 22 deletions(-)

