From 6e9adc873c8abd2847854a89757a4261a4cf399d Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Fri, 6 Nov 2026 23:43:29 +0000
Subject: [PATCH] Compact card trading lists and preserve selection after
 trades

---
 src/shop/script_menu.c | 53 +++++++++++++++++++++++++++++-------------
 1 file changed, 37 insertions(+), 16 deletions(-)

diff --git a/src/shop/script_menu.c b/src/shop/script_menu.c
index f244e69..c4df797 100644
--- a/src/shop/script_menu.c
+++ b/src/shop/script_menu.c
@@ -867,6 +867,10 @@ void openSellCardMenu(void)
 
 void openMeritShop(void)
 {
+	int32_t i;
+	ItemMenuBox *box;
+	int32_t row;
+	int32_t top;
 	int32_t selection = 0;
 	uint8_t owner = readPStat(PSTAT_254);
 
@@ -929,7 +933,26 @@ void openMeritShop(void)
 		UPDATE_SHOP_BIT_BOX = 1;
 		setCardAmount(SHOP_ITEM_TYPE, getCardAmount(SHOP_ITEM_TYPE) - SHOP_AMOUNT);
 		shopFillSellCardList();
-		updateItemMenuStrings(getItemMenuFromType(), 9, 1);
+		box = ITEM_MENU_LEFT;
+		row = box->topRow + box->cursor;
+		if (row >= box->itemCount) {
+			row = box->itemCount > 0 ? box->itemCount - 1 : 0;
+		}
+		top = box->itemCount - box->visibleRows;
+		if (top < 0) {
+			top = 0;
+		}
+		if (box->topRow > top) {
+			box->topRow = top;
+		}
+		box->cursor = row - box->topRow;
+		box->prevTopRow = box->topRow;
+		box->prevCursor = box->cursor;
+		/* A shorter list must use contiguous texture rows, even after scrolling. */
+		for (i = 0; i < box->visibleRows; i++) {
+			box->itemRow[i] = i + 9;
+		}
+		updateItemMenuStrings(box, 9, 1);
 		SCRIPT_STATE_2 = 1;
 		playShopSoundOnlyInSavannah();
 		break;
@@ -1471,28 +1494,24 @@ void showCardTextbox(void)
 
 int32_t shopFillSellCardList(void)
 {
-	uint8_t *buf;
-	int32_t any;
+	uint8_t *buf = ITEM_MENU_LEFT->buf;
 	uint8_t id;
 	uint8_t amount;
 
-	any = 0;
-	buf = ITEM_MENU_LEFT->buf;
+	/* Only owned cards occupy rows; the buffer still stores the original card IDs. */
 	ITEM_MENU_LEFT->itemCount = 0;
 	for (id = 1; id < 0x41; id++) {
-		ITEM_MENU_LEFT->itemCount++;
 		amount = getCardAmount(id);
 		if (amount != 0) {
 			*buf++ = id;
 			*buf++ = amount;
-			any = 1;
-		} else {
-			*buf++ = 0xff;
-			*buf++ = 0;
+			ITEM_MENU_LEFT->itemCount++;
 		}
 	}
-
-	return any;
+	/* An empty list must never offer the previous trade again. */
+	*buf++ = 0xff;
+	*buf = 0;
+	return ITEM_MENU_LEFT->itemCount != 0;
 }
 
 int32_t fillRecycleShopItemList(void)
@@ -1959,7 +1978,7 @@ void tickCardMenu(void)
 		return;
 	}
 
-	if (isKeyDown(CONFIRM_BUTTON)) {
+	if (isKeyDown(CONFIRM_BUTTON) && box->itemCount != 0) {
 		src = &ITEM_MENU_DESCRIPTION_RECTS[ITEM_MENU_TYPE * 4];
 		if (ITEM_MENU_TYPE == 3) {
 			setRECT(&rect, src[0], src[1], src[2], src[3]);
@@ -1977,13 +1996,13 @@ void tickCardMenu(void)
 			SCRIPT_STATE_2 = 0xa;
 		}
 		playSound(0, 4);
-	} else if (isKeyDown(0x1000)) {
+	} else if (isKeyDown(0x1000) && box->itemCount != 0) {
 		if (POLLED_INPUT & 8) {
 			itemMenuCursorTop(box, 9, 1);
 		} else {
 			itemMenuCursorUp(box, 1);
 		}
-	} else if (isKeyDown(0x4000)) {
+	} else if (isKeyDown(0x4000) && box->itemCount != 0) {
 		if (POLLED_INPUT & 8) {
 			itemMenuCursorBottom(box, 9, 1);
 		} else {
@@ -2019,7 +2038,9 @@ void renderCardMenu(void)
 	y = by + box->cursor * 0x12 + 0x11;
 draw:
 	w = SELECTION_CURSOR_WIDTHS[ITEM_MENU_TYPE];
-	renderSelectionCursor(bx + 5, y, w, 0x12, 5);
+	if (box->itemCount != 0) {
+		renderSelectionCursor(bx + 5, y, w, 0x12, 5);
+	}
 	x = bx + 0x1a;
 	y = by + 0x13;
 	x2 = bx + 8;
-- 
2.55.0

