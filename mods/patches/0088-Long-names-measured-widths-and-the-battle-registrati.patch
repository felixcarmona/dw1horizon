From 92f3b07f4bbe4a3ffcc866036b5c5ba653d807d5 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Wed, 14 Oct 2026 04:00:39 +0000
Subject: [PATCH] Long names: measured widths, and the battle registration
 screens

0086 took the name's width from where drawString ended, but the status screen's strings can be drawn in a render pass
where drawString draws nothing, and the width read was another string's (the status screen showed "M").
measureString gives a text's width from the glyph advances without drawing; the status screen and the chart use it.
The battle registration (confirm) screen and the list of registered Digimon cut a long name at the text area's edge
("MetalGreymonV"): their Digimon column moves left when the name would run past 0xF0 (the text area is 256 wide and
no glyph starts past 244), and their text and box are drawn 0xF0 / 0xFA wide (were 0xD6 / 0xE0).
---
 include/dw/font.h    |  4 ++--
 src/main/font.c      | 52 ++++++++++++++++++++++++++++++++++++++++++--
 src/main/game_menu.c | 16 +++++---------
 src/main/main_menu.c | 34 +++++++++++++++++++++++------
 4 files changed, 85 insertions(+), 21 deletions(-)

diff --git a/include/dw/font.h b/include/dw/font.h
index c42d707..7bc56ad 100644
--- a/include/dw/font.h
+++ b/include/dw/font.h
@@ -17,8 +17,8 @@ int32_t drawGlyph(/* uint16_t codepoint, uint16_t x, uint16_t y */);
 #endif
 void drawString(/* char *str, uint16_t x, uint16_t y */);
 #if VERSION_IS(US)
-/* MOD (long names): the x where the last drawString ended (its width when drawn at x 0) */
-extern int16_t MOD_STRING_END_X;
+/* MOD (long names): the width drawString gives a text, in pixels (font.c) */
+int32_t measureString(char *str);
 #endif
 
 #endif
diff --git a/src/main/font.c b/src/main/font.c
index cb02512..6d0e3a6 100644
--- a/src/main/font.c
+++ b/src/main/font.c
@@ -1490,7 +1490,6 @@ void drawString(str, x, y)
 	}
 }
 #else
-int16_t MOD_STRING_END_X; /* MOD (long names): font.h */
 // clang-format off
 void drawString(str, x, y)
 	char *str;
@@ -1530,6 +1529,55 @@ void drawString(str, x, y)
 
 		x += drawGlyph(codepoint, x, y);
 	}
-	MOD_STRING_END_X = x;
+}
+
+/*
+ * MOD (long names): the width in pixels drawString gives a text, without drawing it (the glyph's advance follows
+ * its GLYPH_HEIGHT rows, as drawGlyph returns it). A screen can measure in any render pass; drawString draws
+ * only in the first.
+ */
+int32_t measureString(char *str)
+{
+	uint16_t codepoint;
+	uint16_t code;
+	uint16_t lo;
+	uint16_t hi;
+	uint16_t *p;
+	int32_t n;
+	int32_t w;
+
+	w = 0;
+	while (*str != '\0') {
+		if (isAsciiEncoded(str) != 0) {
+			if (*str == '.') {
+				codepoint = 0x8142;
+			} else if (*str == '\'') {
+				codepoint = 0x8175;
+			} else {
+				codepoint = convertAsciiToJis(*str);
+			}
+			codepoint = swapShortBytes(codepoint);
+			str++;
+		} else {
+			lo = (uint8_t)*str++;
+			hi = (uint8_t)*str++;
+			codepoint = swapShortBytes((lo << 8) | hi);
+		}
+		code = ((codepoint & 0xff) << 8) + ((codepoint & 0xff00) >> 8);
+		n = (code & 0xff) - EXTRA_GLYPH_FIRST;
+		if ((code & 0xff) > 0x7f) {
+			n--;
+		}
+		if ((code >> 8) == EXTRA_GLYPH_LEAD && n >= 0 && n < NUM_EXTRA_GLYPHS) {
+			p = (uint16_t *)EXTRA_GLYPH_DATA[n].pixelData;
+		} else {
+			CHAR_TO_GLYPH_TABLE[NUM_GLYPHS - 1] = code;
+			for (n = 0; code != CHAR_TO_GLYPH_TABLE[n]; ++n) {
+			}
+			p = GLYPH_DATA[n].pixelData;
+		}
+		w += p[GLYPH_HEIGHT];
+	}
+	return w;
 }
 #endif
