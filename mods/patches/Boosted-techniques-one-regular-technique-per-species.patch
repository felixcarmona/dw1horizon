From 888c1c69f60ce5be5001f152f2079504f842baf5 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Mon, 23 Nov 2026 17:14:03 +0000
Subject: [PATCH] Boosted techniques: one regular technique per species hits
 harder and costs less MP

The partner's damage and MP cost for its species' boosted technique (the spare
byte at the end of DigimonPara) are raised and lowered where the battle, the
tournament and VS compute them; the speed buffer, the enemies and the finishers
are untouched. The technique menu shows the two numbers in red and blue with
small up and down arrows.
---
 include/dw/params.h    |  2 +-
 include/dw/species.h   |  9 +++++++++
 src/btl/battle_main.c  | 10 ++++-----
 src/main/game_menu.c   | 46 ++++++++++++++++++++++++++++++++++++++----
 src/main/mod_species.c | 16 +++++++++++++++
 src/std/std_main.c     | 10 ++++-----
 src/vs/vs_main.c       | 10 ++++-----
 7 files changed, 83 insertions(+), 20 deletions(-)

diff --git a/include/dw/params.h b/include/dw/params.h
index 727fc66a..0a0cf5b4 100644
--- a/include/dw/params.h
+++ b/include/dw/params.h
@@ -26,7 +26,7 @@ typedef struct {
 	uint8_t dropItem;
 	uint8_t dropChance;
 	uint8_t moves[16];
-	uint8_t padding;
+	uint8_t boostedTech; /* MOD (boosted techniques): the species' boosted technique + 1, 0 none; padding in the original */
 } DigimonPara;
 
