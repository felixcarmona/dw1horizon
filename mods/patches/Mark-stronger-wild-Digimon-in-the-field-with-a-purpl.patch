 		return MOD_FONT == MOD_FONT_NEW ? 0 : MOD_FONT == MOD_FONT_CLASSIC ? 1 : 2;
@@ -6245,6 +6251,9 @@ static void __attribute__((noinline)) modSetOption(int32_t row, int32_t value)
 	case MOD_OPT_ROW_QUICK: /* MOD (quick battle start) */
