 	d[7] = MOD_LANG; /* MOD (language) */
 	d[8] = MOD_OPT_SIGNS;
 	d[9] = MOD_OPT_STORY; /* MOD (story) */
@@ -4800,6 +4802,7 @@ static void modApplyOptions(const uint8_t *d, int32_t len)
