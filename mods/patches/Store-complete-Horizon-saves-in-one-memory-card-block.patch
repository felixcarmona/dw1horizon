+	link = inlined ? inlineBaseChecksum(copy) : SAVE_FILE.saves[copy].checksum;
 	e = saveExtOf(copy);
 	h = (SaveExtHead *)e;
-	return SAVE_FILE_BYTES >= SAVE_V2_BYTES && h->magic[0] == 'D' && h->magic[1] == 'W' && h->magic[2] == '4' &&
-	       h->magic[3] == 'E' && h->version == saveLayoutVersion() && h->size == size &&
-	       *(int32_t *)(e + size - 4) == createByteSum(e, size - 4) && h->v1Checksum == SAVE_FILE.saves[copy].checksum &&
+	return (SAVE_FILE_BYTES >= SAVE_V2_BYTES || inlined) && h->magic[0] == 'D' && h->magic[1] == 'W' &&
+	       h->magic[2] == '4' && h->magic[3] == 'E' && h->version == saveLayoutVersion() && h->size == size &&
+	       *(int32_t *)(e + size - 4) == createByteSum(e, size - 4) && h->v1Checksum == link &&
 	       areRecordsWellFormed(e, size);
