+/* The original never reads or writes RegisteredDigimon.unk24. Keep all 40
+ * registrations, both payloads and the original byte-sum algorithm intact.
+ * The link excludes these bytes to avoid a checksum cycle. */
+static int32_t inlineBaseChecksum(int32_t copy)
+{
+	int32_t i, sum = createSavegameChecksum(copy);
+	for (i = 0; i < 40; i++)
+		sum -= createByteSum(SAVE_FILE.saves[copy].battleRegistrationData[i].unk24, 28);
+	return sum;
+}
+
+static void inlineExtension(int32_t copy, int32_t pack)
+{
+	int32_t i, j;
+	uint8_t *e = saveExtOf(copy);
+	for (i = 0; i < 40; i++) {
+		uint8_t *p = SAVE_FILE.saves[copy].battleRegistrationData[i].unk24;
+		for (j = 0; j < 28; j++) {
+			if (pack) p[j] = e[i * 28 + j];
+			else e[i * 28 + j] = p[j];
+		}
+	}
+}
+
 static int32_t isTaggedExtensionValid(int32_t copy)
 {
 	SaveExtHead *h;
 	uint8_t *e;
-	int32_t size;
