From 073fb9d97789333040bff22cbf6b3273ec842507 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Wed, 21 Oct 2026 21:03:43 +0000
Subject: [PATCH] Patch 0152: scold question. When the partner did something a
 scolding answers (ITEM_SCOLD_FLAG 1: it refused an item out of indiscipline,
 it pooped on the ground) a box asks "Scold it?": on its own once it refused
 the item the care menu gave, and on X in front of it before the care list.
 Yes scolds as the triangle menu's Scold (partnerSetState(4): discipline up,
 the next item taken), No clears the flag (as walking away does)

---
 src/main/mod_feed.c | 137 +++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 123 insertions(+), 14 deletions(-)

diff --git a/src/main/mod_feed.c b/src/main/mod_feed.c
index 50843b0f..57da2440 100644
--- a/src/main/mod_feed.c
+++ b/src/main/mod_feed.c
@@ -10,6 +10,10 @@
  * cure in its effect row: Bandage, Medicine). X gives the chosen item as Items > Use does (startFeedingItem: the
  * partner comes, takes it or refuses it, one unit is used) or puts it to sleep, triangle closes the box. With
  * nothing to offer X does nothing here. While the box is open the clock stops, as with the triangle menu.
+ * When the partner did something a scolding answers (ITEM_SCOLD_FLAG 1: it refused an item out of indiscipline, it
+ * pooped on the ground), a box asks "Scold it?": on its own when it refused the item this menu gave, and on X in front
+ * of it before the list. Yes scolds as the triangle menu's Scold (partnerSetState(4): discipline up, the next item
+ * taken), No lets it go (the flag cleared, as walking away clears it).
  * Hooked from tamerTickWalkingState() (tamer.c), after checkMapInteraction(): talking to an NPC, a chest or a
  * press tile take the X first.
  */
@@ -39,9 +43,12 @@
 #define PARTNER_NORMAL	1	/* PARTNER_STATE */
 #define PARTNER_SLEEP	3	/* PARTNER_STATE: partnerTickSleep, as the triangle menu's Sleep */
 #define PORT_POTTY	0x20
+#define PARTNER_SCOLD	4	/* PARTNER_STATE: partnerTickPraiseScold, as the triangle menu's Scold */
+#define PARTNER_FEEDING	5	/* PARTNER_STATE: partnerTickFeedItem */
 #define FEED_SLEEP	0xFF	/* feedSlots entry: the Sleep command, not an inventory slot */
+#define SCOLD_PENDING	1	/* ITEM_SCOLD_FLAG: a scolding now is a fair one */
 
-enum { FEED_OPENING, FEED_OPEN, FEED_CLOSING, FEED_GIVING };
+enum { FEED_OPENING, FEED_OPEN, FEED_CLOSING, FEED_GIVING, FEED_WATCHING, SCOLD_OPENING, SCOLD_OPEN, SCOLD_GIVING };
 
 extern int32_t POLLED_INPUT;
 extern int32_t POLLED_INPUT_PREVIOUS;
@@ -49,6 +56,7 @@ extern uint32_t CHANGED_INPUT;
 extern int32_t IS_IN_MENU;
 extern int8_t TAMER_STATE;
 extern int8_t PARTNER_STATE;
+extern int8_t ITEM_SCOLD_FLAG;
 extern uint8_t INVENTORY_POINTER;
 extern TamerEntity TAMER_ENTITY;
 extern char *ITEM_DESCS[];
@@ -76,6 +84,9 @@ u_short GetClut(int32_t x, int32_t y);
 
 static char FEED_SLEEP_NAME[] = "Sleep";
 static char FEED_SLEEP_DESC[] = "Put it to bed until morning.";
+static char SCOLD_QUESTION[] = "Scold it?";
+static char SCOLD_YES[] = "Yes";
+static char SCOLD_NO[] = "No";
 
 static uint8_t feedSlots[31]; /* Sleep, then the inventory slots shown, in inventory order */
 static int32_t feedCount;
@@ -238,6 +249,41 @@ static void feedOpenBoxes(void)
 	createAnimatedUIBox(FEED_DESC_BOX, 0, 2, &finalPos, &startPos, NULL, (RenderFunction)feedRenderDescription);
 }
 
+/* the question in the text area's first three rows: the question, Yes, No */
+static void scoldDrawText(void)
+{
+	clearTextArea();
+	drawString(SCOLD_QUESTION, 0, 0);
+	drawString(SCOLD_YES, 0, 0xC);
+	drawString(SCOLD_NO, 0, 0x18);
+	DrawSync(0);
+}
+
+static void scoldRender(int32_t boxId)
+{
+	UIBoxData *box = &UI_BOX_DATA[boxId];
+	int32_t i;
+
+	for (i = 0; i < 3; i++) {
+		renderString(i == 0 ? 9 : 8, box->finalPos.x + (i == 0 ? 0xA : 0x16), box->finalPos.y + 0xA + i * 0x12, 0x60,
+		             0xC, 0, i * 0xC, 6 - boxId, 1);
+	}
+	renderSelectionCursor(box->finalPos.x + 0x10, box->finalPos.y + 7 + (1 + feedCursor) * 0x12, 0x48, 0x12,
+	                      6 - boxId);
+}
+
+static void scoldOpenBox(void)
+{
+	RECT finalPos;
+	RECT startPos;
+	DVECTOR xy;
+
+	setRECT(&finalPos, -0x34, -0x68, 0x68, 0x14 + 3 * 0x12);
+	getEntityScreenPos(&PARTNER_ENTITY.digimonEntity.entity, 1, &xy);
+	setRECT(&startPos, xy.vx - 5, xy.vy - 5, 10, 10);
+	createAnimatedUIBox(FEED_LIST_BOX, 0, 2, &finalPos, &startPos, NULL, (RenderFunction)scoldRender);
+}
+
 static void feedCloseBoxes(void)
 {
 	RECT rect;
@@ -245,10 +291,33 @@ static void feedCloseBoxes(void)
 
 	getEntityScreenPos(&PARTNER_ENTITY.digimonEntity.entity, 1, &xy);
 	setRECT(&rect, xy.vx - 5, xy.vy - 5, 10, 10);
-	removeAnimatedUIBox(FEED_DESC_BOX, &rect);
+	if (UI_BOX_DATA[FEED_DESC_BOX].state != 0) {
+		removeAnimatedUIBox(FEED_DESC_BOX, &rect);
+	}
 	removeAnimatedUIBox(FEED_LIST_BOX, &rect);
 }
 
+/* the tamer stops, the clock stops, the partner waits: as the triangle menu opens */
+static void feedEnterMenu(void)
+{
+	tamerSetState(1);
+	startAnimation(&TAMER_ENTITY.entity, 0);
+	unsetCameraFollowPlayer();
+	IS_IN_MENU = 1;
+	stopGameTime();
+	setPartnerIdling();
+	playSound(0, 3);
+}
+
+static void scoldAsk(void)
+{
+	feedCursor = 0;
+	feedState = SCOLD_OPENING;
+	scoldDrawText();
+	feedEnterMenu();
+	scoldOpenBox();
+}
+
 static void feedMoveCursor(int32_t cursor)
 {
 	if (cursor < 0 || cursor >= feedCount || cursor == feedCursor) {
@@ -299,6 +368,45 @@ static void feedTick(int32_t instanceId)
 			feedState = FEED_CLOSING;
 		}
 		break;
+	case SCOLD_OPENING:
+		if (UI_BOX_DATA[FEED_LIST_BOX].state == 1) {
+			feedState = SCOLD_OPEN;
+		}
+		break;
+	case SCOLD_OPEN:
+		if ((pressed & 0x5000) != 0) {
+			playSound(0, 2);
+			feedCursor ^= 1;
+		} else if ((pressed & CONFIRM_BUTTON) && feedCursor == 0) {
+			playSound(0, 3);
+			feedCloseBoxes();
+			feedState = SCOLD_GIVING;
+		} else if (pressed & (CONFIRM_BUTTON | CANCEL_BUTTON)) {
+			playSound(0, 4);
+			ITEM_SCOLD_FLAG = 0;
+			feedCloseBoxes();
+			feedState = FEED_CLOSING;
+		}
+		break;
+	case SCOLD_GIVING:
+		if (UI_BOX_DATA[FEED_LIST_BOX].state == 0) {
+			removeObject(FEED_OBJECT_ID, 0);
+			partnerSetState(PARTNER_SCOLD); /* the tamer and the camera as Scold has them */
+			IS_IN_MENU = 0;
+			startGameTime();
+		}
+		break;
+	case FEED_WATCHING:
+		/* the item handed over: once the partner took it or refused it, ask about a refusal a scolding answers */
+		if (PARTNER_STATE == PARTNER_FEEDING) {
+			break;
+		}
+		if (ITEM_SCOLD_FLAG == SCOLD_PENDING && PARTNER_STATE == PARTNER_NORMAL && TAMER_STATE == 0) {
+			scoldAsk();
+		} else {
+			removeObject(FEED_OBJECT_ID, 0);
+		}
+		break;
 	case FEED_CLOSING:
 		if (UI_BOX_DATA[FEED_LIST_BOX].state == 0 && UI_BOX_DATA[FEED_DESC_BOX].state == 0) {
 			removeObject(FEED_OBJECT_ID, 0);
@@ -310,8 +418,8 @@ static void feedTick(int32_t instanceId)
 		break;
 	case FEED_GIVING:
 		if (UI_BOX_DATA[FEED_LIST_BOX].state == 0 && UI_BOX_DATA[FEED_DESC_BOX].state == 0) {
-			removeObject(FEED_OBJECT_ID, 0);
 			if (feedSlots[feedCursor] == FEED_SLEEP) {
+				removeObject(FEED_OBJECT_ID, 0);
 				partnerSetState(PARTNER_SLEEP); /* the tamer, the camera and the clock as Sleep has them */
 				IS_IN_MENU = 0;
 				startGameTime();
@@ -319,19 +427,27 @@ static void feedTick(int32_t instanceId)
 			}
 			INVENTORY_POINTER = feedSlots[feedCursor];
 			startFeedingItem(INVENTORY.types.array[feedSlots[feedCursor]]); /* clock back on, tamer and partner */
+			feedState = FEED_WATCHING;
 		}
 		break;
 	}
 }
 
-/* from tamerTickWalkingState: 1 when X opened the menu */
+/* from tamerTickWalkingState: 1 when X opened the menu or the scolding question */
 int32_t modFeedTick(void)
 {
 	if ((CHANGED_INPUT & CONFIRM_BUTTON) == 0 || TAMER_STATE != 0 || IS_SCRIPT_PAUSED != 1 || FADE_PROTECTION != 0 ||
 	    UI_BOX_DATA[FEED_LIST_BOX].state != 0 || UI_BOX_DATA[FEED_LIST_BOX].frame != 0 ||
 	    UI_BOX_DATA[FEED_DESC_BOX].state != 0 || UI_BOX_DATA[FEED_DESC_BOX].frame != 0 ||
-	    PARTNER_STATE != PARTNER_NORMAL || TAMER_ITEM.worldItem.type != ITEM_NONE || !feedPartnerAhead() ||
-	    feedCollect() == 0) {
+	    PARTNER_STATE != PARTNER_NORMAL || TAMER_ITEM.worldItem.type != ITEM_NONE || !feedPartnerAhead()) {
+		return 0;
+	}
+	if (ITEM_SCOLD_FLAG == SCOLD_PENDING) {
+		scoldAsk();
+		addObject(FEED_OBJECT_ID, 0, feedTick, NULL);
+		return 1;
+	}
+	if (feedCollect() == 0) {
 		return 0;
 	}
 	feedCursor = 0;
@@ -342,14 +458,7 @@ int32_t modFeedTick(void)
 	}
 	feedDrawNames();
 	feedDrawDescription();
-
-	tamerSetState(1);
-	startAnimation(&TAMER_ENTITY.entity, 0);
-	unsetCameraFollowPlayer();
-	IS_IN_MENU = 1;
-	stopGameTime();
-	setPartnerIdling();
-	playSound(0, 3);
+	feedEnterMenu();
 	feedOpenBoxes();
 	addObject(FEED_OBJECT_ID, 0, feedTick, NULL);
 	return 1;
-- 
2.53.0

