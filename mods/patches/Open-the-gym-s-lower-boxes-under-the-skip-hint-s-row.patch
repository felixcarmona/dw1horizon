-		renderString(0, LEARNED_TEXT_X + nameW + LEARNED_GAP, 24, textW + 1, 12, 0, 132, 4, 0);
+		renderString(0, LEARNED_TEXT_X + nameW + LEARNED_GAP, y, textW + 1, 12, 0, 132, 4, 0);
 	} else {
