 #define IS_GRID_MOVE(m)		((uint32_t)(m) < 0x3a || IS_NEW_MOVE(m))
 #define MOVE_GRID(m)		(IS_NEW_MOVE(m) ? (m) - NEW_MOVE_FIRST + 58 : (m))
