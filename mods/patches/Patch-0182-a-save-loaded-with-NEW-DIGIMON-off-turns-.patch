+++ b/include/dw/mod_options.h
@@ -32,6 +32,10 @@ uint16_t modButtonClut(void);
 void modSetButtons(int32_t layout);
 /* 1 when the partner may become `type` (NEW DIGIMON on, or a species the original raises: isVanillaSpecies) */
 int32_t modSpeciesAllowed(int32_t type);
+/* NEW DIGIMON off turned the loaded partner from MOD_SWAP_FROM into MOD_SWAP_TO (0: no); back on, a partner still of
+ * MOD_SWAP_TO is turned back (main_menu.c, SAVE_TAG_VANILLA_SWAP) */
+extern int16_t MOD_SWAP_FROM;
+extern int16_t MOD_SWAP_TO;
 /* FRAME RATE: the rate the game is shown at, 30 or 60 (20 in an FPS=20 build, which has no choice) */
 int32_t modFrameRate(void);
 void modSetFrameRate(int32_t fps);
diff --git a/include/dw/save_tags.h b/include/dw/save_tags.h
index e04ae6c9..5a2d8f99 100644
--- a/include/dw/save_tags.h
+++ b/include/dw/save_tags.h
@@ -29,6 +29,7 @@
 #define SAVE_TAG_SPECIES_RAISED		0x0007 /* bit array: species the tamer has raised */
 #define SAVE_TAG_SPECIES_RECRUITED	0x0008 /* bit array: species the tamer has recruited */
 #define SAVE_TAG_OPTIONS		0x0009 /* u8[n] the title menu's OPTIONS: [0] button layout (0 US, 1 Japanese) */
+#define SAVE_TAG_VANILLA_SWAP		0x000A /* i16 species, i16 vanilla species: NEW DIGIMON off turned the partner from the first into the second (main_menu.c modVanillaSwap) */
 #define SAVE_TAG_REQUIRED		0x8000
 /* engine tier 2 */
 #define SAVE_TAG_STORY_FLAGS		0x8001 /* bit array: story flag n = trigger 800 + n */
