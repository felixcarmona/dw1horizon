From 765dda983c423baed18b5946b8db276f68f5529e Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Thu, 5 Nov 2026 20:02:12 +0000
Subject: [PATCH] Allow due evolutions during load and waking grace

---
 src/main/partner_impl.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/main/partner_impl.c b/src/main/partner_impl.c
index ba44c88..29078f6 100644
--- a/src/main/partner_impl.c
+++ b/src/main/partner_impl.c
@@ -2289,8 +2289,8 @@ void tickConditions(void)
 	}
 	if (!isInDaytimeTransition())
 		return;
-	if (HAS_IMMORTAL_HOUR == 1 && IMMORTAL_HOUR == HOUR)
-		return;
+	/* Loading and waking grace protects against death, not a due evolution.
+	 * The death and sickness checks enforce their own grace period. */
 	if (HAS_IMMORTAL_HOUR == 1 && IMMORTAL_HOUR != HOUR) {
 		HAS_IMMORTAL_HOUR = 0;
 		IMMORTAL_HOUR = -1;
-- 
2.55.0

