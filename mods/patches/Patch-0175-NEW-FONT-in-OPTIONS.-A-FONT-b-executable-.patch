From 18b702f94b13da9e6bfc5676c10364147acd0332 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Fri, 23 Oct 2026 18:28:06 +0000
Subject: [PATCH] Patch 0175: NEW FONT in OPTIONS. A FONT=b executable carries
 both fonts and draws with the original one (its code, glyphs and long-name
 modes) when the row is OFF; the script text is read from copies paged for the
 original font (DGORIG.SCN, MHORIG.SCN, SCRNORIG.DAT, tools/build-full.sh)
 when the disc has them; the OPTIONS box is laid out in its font (one value a
 row when two do not fit); the original drawGlyph keeps the text's colour
 after a glyph (0167 left it 0: only the first letter showed); FONT=a left out

---
 Makefile                  |  11 +-
 include/dw/mod_font.h     |  44 ++++++--
 src/dget/dget.c           |  10 +-
 src/main/file.c           |  23 +++++
 src/main/file_table_us.c  |   8 ++
 src/main/font.c           | 204 +++++++++++++++++++++++++++-----------
 src/main/font_a.h         | 138 --------------------------
 src/main/game_menu.c      |  14 ++-
 src/main/main_menu.c      | 100 +++++++++++++++----
 src/main/map.c            |  18 ++--
 src/main/mod_lab.c        |  13 ++-
 src/main/mod_screen.c     |  18 +++-
 src/main/script_interp.c  |  34 ++++++-
 src/main/script_textbox.c |  47 +++++----
 src/main/script_value.c   |   4 +-
 text/main/main_menu.yaml  |   3 +
 16 files changed, 408 insertions(+), 281 deletions(-)
 delete mode 100644 src/main/font_a.h

diff --git a/Makefile b/Makefile
index 7bae2b62..2b52c0bc 100644
--- a/Makefile
+++ b/Makefile
@@ -44,13 +44,14 @@ $(shell mkdir -p $(GEN_DIR); printf '#define FPS %s\n' '$(FPS)' > $(GEN_DIR)/fps
 	cmp -s $(GEN_DIR)/fps.h.tmp $(GEN_DIR)/fps.h && rm $(GEN_DIR)/fps.h.tmp \
 	|| mv $(GEN_DIR)/fps.h.tmp $(GEN_DIR)/fps.h)
 
-# MOD (font): the font the US executable draws its text with (docs/mods/font.md "Fonts"), chosen at build time:
+# MOD (font): the fonts the US executable draws its text with (docs/mods/font.md "Fonts"):
 #   original  the US font on its 4-pixel grid: the original code and glyphs, byte for byte;
-#   a         the US letters placed to the pixel (src/main/font_a.h, tools/fontgen.py);
-#   b         our font redrawn in the game's style, placed to the pixel (src/main/font_b.h, tools/font/b.txt).
+#   b         our font redrawn in the game's style, placed to the pixel (src/main/font_b.h, tools/font/b.txt), and the
+#             original one too: the title menu's OPTIONS (NEW FONT) chooses between them at run time (patch 0173).
+# (FONT=a, the US letters placed to the pixel, was a test font: left out by patch 0173.)
 FONT ?= b
-ifeq ($(filter $(FONT),original a b),)
-$(error FONT=$(FONT): the font must be original, a or b)
+ifeq ($(filter $(FONT),original b),)
+$(error FONT=$(FONT): the font must be original or b)
 endif
 $(shell mkdir -p $(GEN_DIR); printf '#define FONT_%s 1\n' '$(shell echo $(FONT) | tr a-z A-Z)' > $(GEN_DIR)/font_sel.h.tmp; \
 	cmp -s $(GEN_DIR)/font_sel.h.tmp $(GEN_DIR)/font_sel.h && rm $(GEN_DIR)/font_sel.h.tmp \
