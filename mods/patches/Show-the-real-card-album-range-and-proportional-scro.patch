From 90b11414b927bce3cc1895e0341710b86cd06a18 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Wed, 18 Nov 2026 14:32:44 +0000
Subject: [PATCH] Show the real card album range and proportional scrollbar

Trim the numbered album to the existing real-card bitmap, skip sparse holes and retain the original 65 numbering convention when counting added cards. Reuse renderBox for the chart-style thumb and track. Keep MENU within 27 sectors by swapping the navigation and top-row helper placement.
---
 config/us/main.ld    |  2 +-
 config/us/overlay.ld |  5 ++--
 src/main/game_menu.c | 54 ++++++++++++++++++++++++++++++++++++++------
 3 files changed, 51 insertions(+), 10 deletions(-)

diff --git a/config/us/main.ld b/config/us/main.ld
index 5f94ced5..86740369 100644
--- a/config/us/main.ld
+++ b/config/us/main.ld
@@ -1069,7 +1069,7 @@ ASSERT(OVL_READ_END(.MOV) <= OVL_TRN_BASE, "MOV overlay overlaps TRN's slot (TEX
  * OVL_EVL_BASE except ENDI during the game-clear save (load_ending), whose first sector the last sector of MENU may
  * overlap: start_ending reads ENDI again. Whole sectors: one more would need that read to be proved again. */
 ASSERT(OVL_READ_END(.MENU) <= OVL_EVL_BASE + 0x800, "MENU overlay (in whole sectors) reaches past ENDI's first sector")
-ASSERT(renderCardsView >= OVL_BTL_BASE + 0x800 && modCardMove >= OVL_BTL_BASE + 0x800 && CARD_SPRITE_CLUT >= OVL_BTL_BASE + 0x800,
+ASSERT(renderCardsView >= OVL_BTL_BASE + 0x800 && modCardTop >= OVL_BTL_BASE + 0x800 && CARD_SPRITE_CLUT >= OVL_BTL_BASE + 0x800,
        "Card metadata sector overlaps the album renderer")
 ASSERT(title_ui_START >= OVL_READ_END(.MENU), "MENU sector read overwrites the title UI in EVL")
 ASSERT(title_ui_END <= OVL_END(.EVL), "Title UI is outside EVL")
diff --git a/config/us/overlay.ld b/config/us/overlay.ld
index 1f32dd3d..e48063e6 100644
--- a/config/us/overlay.ld
+++ b/config/us/overlay.ld
@@ -1021,8 +1021,9 @@ SECTIONS
             . = ALIGN(., 4);
             /* Album drawing runs only after Player loads MENU. Keep this code
              * and its portrait CLUT map in the tail: CARDTAB.BIN replaces only
-             * the first sector while the album is active. */
-            BUILD_DIR/src/main/game_menu.c.o(.text.renderCardsView .text.modCardMove .data.CARD_SPRITE_CLUT);
+             * the first sector while the album is active. Keep only the small top-row
+             * helper here; bitmap navigation stays resident to retain 27 sectors. */
+            BUILD_DIR/src/main/game_menu.c.o(.text.renderCardsView .text.modCardTop .data.CARD_SPRITE_CLUT);
             . = ALIGN(., 4);
 
 		}
diff --git a/src/main/game_menu.c b/src/main/game_menu.c
index 96f4437a..1a3ca12e 100644
--- a/src/main/game_menu.c
+++ b/src/main/game_menu.c
@@ -5660,13 +5660,50 @@ void renderMedalView(void)
 	}
 }
 
-int32_t modCardMove(int32_t id, int32_t input)
+/* Keep the original numbered layout (including 0/65), but trim unused capacity.
+ * Read the existing bitmap: replacement artwork adds no collection entries. */
+static __attribute__((noinline)) int32_t cardAlbumLimit(void)
 {
 	int32_t limit = MOD_OPT_NEW_CARDS ? NUM_CARDS : 66;
-	if ((input & 0x8000) && id % 11 != 0) id--;
-	if ((input & 0x2000) && id % 11 != 10 && id + 1 < limit) id++;
-	if ((input & 0x1000) && id >= 11) id -= 11;
-	if ((input & 0x4000) && id + 11 < limit) id += 11;
+	while (limit > 66 && !modCardIsReal(limit - 1)) limit--;
+	return limit;
+}
+
+static __attribute__((noinline)) int32_t cardAlbumTotal(void)
+{
+	int32_t id, total = 65; /* Preserve the original album's 65-card numbering. */
+	for (id = 66; id < NUM_CARDS; id++) total += modCardIsReal(id);
+	return total;
+}
+
+/* Same thumb-before-track renderBox helper and colours as the chart popup. */
+static __attribute__((noinline)) void cardAlbumScrollBar(int32_t rows)
+{
+	int32_t h, y;
+	if (rows <= 6) return;
+	h = 138 * 6 / rows;
+	y = -63 + (138 - h) * CARD_TOP_ROW / (rows - 6);
+	renderBox(135, y, 3, h, 120, 220, 255, 0, 5);
+	renderBox(135, -63, 3, 138, 20, 30, 38, 0, 5);
+}
+
+static int32_t cardAlbumStep(int32_t id, int32_t step, int32_t limit)
+{
+	int32_t next;
+	for (next = id + step; next >= 0 && next < limit; next += step) {
+		if ((step == -1 || step == 1) && next / 11 != id / 11) break;
+		if (next < 66 || modCardIsReal(next)) return next;
+	}
+	return id;
+}
+
+int32_t modCardMove(int32_t id, int32_t input)
+{
+	int32_t limit = cardAlbumLimit();
+	if (input & 0x8000) id = cardAlbumStep(id, -1, limit);
+	if (input & 0x2000) id = cardAlbumStep(id, 1, limit);
+	if (input & 0x1000) id = cardAlbumStep(id, -11, limit);
+	if (input & 0x4000) id = cardAlbumStep(id, 11, limit);
 	return id;
 }
 
@@ -5684,6 +5721,7 @@ void renderCardsView(void)
 	int32_t i;
 	int16_t card;
 	int8_t amount;
+	int32_t limit;
 
 	sprites = CARD_SPRITE_CLUT;
 
@@ -5701,11 +5739,13 @@ void renderCardsView(void)
 	case 1:
 		renderNumber(0, 0x35, -0x50, 3, SELECTED_CARD, 5);
 		drawLine2P(0xbebebe, 0x5e, -0x45, 0x63, -0x50, 5, 0);
-		renderNumber(0, 0x68, -0x50, 3, (MOD_OPT_NEW_CARDS ? NUM_CARDS : 66) - 1, 5);
+		renderNumber(0, 0x68, -0x50, 3, cardAlbumTotal(), 5);
+		limit = cardAlbumLimit();
+		cardAlbumScrollBar((limit + 10) / 11);
 		for (i = 0; i < 6; i++) {
 			for (j = 0; j < 11; j++) {
 				card = j + (i + CARD_TOP_ROW) * 11;
-				if (card >= NUM_CARDS) continue;
+				if (card >= limit || (card >= 66 && !modCardIsReal(card))) continue;
 				amount = getCardAmount(card);
 				if (amount > 0 && card >= 66) {
 					renderCardSprite(CARD_DATA[card].spriteId, j * 24 - 0x81, i * 24 - 0x3e, 5);
-- 
