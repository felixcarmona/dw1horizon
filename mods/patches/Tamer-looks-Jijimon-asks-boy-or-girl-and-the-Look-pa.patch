+			y = LOOK_BARE_Y + k * LOOK_BARE_STEP;
+			renderString(k == lookPageState.row ? 3 : 0, LOOK_BARE_NAME_X, y, LOOK_NAME_W, 0xc, 0, LOOK_ROW_V(i), 5, 1);
+			renderString(k == lookPageState.row ? 3 : 0, LOOK_BARE_VALUE_X + (LOOK_VALUE_W - lookPageState.width[i]) / 2, y,
+			             lookPageState.width[i], 0xc, LOOK_VALUE_U, LOOK_ROW_V(i), 5, 1);
+			if (k == lookPageState.row) {
+				for (i = 0; i < 4; i++) {
+					drawLine2P(0x73f6ff, LOOK_BARE_VALUE_X - 7 + i, y + 5 - i, LOOK_BARE_VALUE_X - 7 + i, y + 6 + i, 5, 0);
+					drawLine2P(0x73f6ff, LOOK_BARE_VALUE_X + LOOK_VALUE_W + 5 - i, y + 5 - i,
+					           LOOK_BARE_VALUE_X + LOOK_VALUE_W + 5 - i, y + 6 + i, 5, 0);
+				}
+			}
+		}
+		y = LOOK_BARE_Y + LOOK_PLACES * LOOK_BARE_STEP + 6;
+		renderString(0, LOOK_BARE_NAME_X, y, 0x7c, 0xc, 0, LOOK_HINT_Y, 5, 1);
+		renderString(0, LOOK_BARE_VALUE_X + (LOOK_VALUE_W - LOOK_KEY_W) / 2, y, LOOK_KEY_W, 0xc, LOOK_KEY_U(1), LOOK_HINT_Y, 5, 1);
+		renderString(0, -lookPageState.width[LOOK_HANDS_ROW] / 2, y + 18, lookPageState.width[LOOK_HANDS_ROW], 0xc, 0, LOOK_OPEN_Y, 5, 1);
+		return;
+	}
 	renderSeparatorLines((Line *)lookPageLines, 0xb, 5);
 	renderString(3, e->posX, e->posY + 1, e->uvWidth, 0xc, e->uvX, e->uvY, 5, 1);
 	renderString(0, -0x54, -0x50, 0x48, 0xc, 0, 0x30, 5, 1);
+	renderString(0, -0x29, 0x4e, 0x7c, 0xc, 0, LOOK_HINT_Y, 5, 1);
+	renderDigiviceEntity(ENTITY_TABLE[0], 0);
+	renderInsetBox(r->x, r->y, r->w, r->h, 5);
 	for (k = first; k < first + LOOK_SHOWN; k++) {
 		i = lookPageOrder[k];
 		y = -0x34 + (k - first) * 0x14;
@@ -3133,11 +3168,8 @@ void lookPageRender(void)
 	renderBox(LOOK_SCROLL_X, -0x34 + (LOOK_SCROLL_H - LOOK_SCROLL_H * LOOK_SHOWN / LOOK_PLACES) * first / (LOOK_PLACES - LOOK_SHOWN),
 	          2, LOOK_SCROLL_H * LOOK_SHOWN / LOOK_PLACES, 0xe6, 0xe6, 0xe6, 0, 5);
 	renderBox(LOOK_SCROLL_X, -0x34, 2, LOOK_SCROLL_H, 0x20, 0x48, 0x58, 0, 5);
-	renderString(0, -0x29, 0x4e, 0x7c, 0xc, 0, LOOK_HINT_Y, 5, 1);
 	playerKeyRender(1, LOOK_HINT_Y);
 	playerKeyRender(2, LOOK_HINT_Y);
-	renderDigiviceEntity(ENTITY_TABLE[0], 0);
-	renderInsetBox(r->x, r->y, r->w, r->h, 5);
 	for (i = 0; i < LOOK_SHOWN; i++) {
 		renderInsetBox(160 + LOOK_VALUE_X, 118 - 0x34 + i * 0x14, LOOK_VALUE_W, 14, 5);
 	}
@@ -6643,6 +6675,136 @@ void renderDigimonStatusConditions(int32_t condition)
 static VECTOR modDigiviceSavedPos;
 static SVECTOR modDigiviceSavedRot;
 
+void modTickStart(int32_t flags);
+void pollInputGame(void);
+void processInput(void);
+void fadeFromBlack(int16_t frames);
+void fadeToBlack(int16_t frames);
+extern GsOT GS_ORDERING_TABLE[2];
+extern PACKET GS_WORK_BASES[2][0x14000];
+extern int16_t FADE_OUT_CURRENT;
+
+void initializeTamer(int32_t type, int32_t posX, int32_t posY, int32_t posZ, int32_t rotX, int32_t rotY, int32_t rotZ);
+void removeEntity(int32_t objectId, int32_t entityId);
+void thunkUnloadModel(int32_t digiType, int32_t modelType);
+void showNewGameDialogue(int32_t textId, uint16_t nextState);
+void showNewGameSelection(int32_t textId, uint16_t nextState);
+void setupNewGameDialogueBox(void);
+void closeBox(int32_t boxId);
+extern uint16_t SCRIPT_STATE_2;
+#define LOOK_BARE_OBJECT	0x19c
+
+/* A new game's Look page: the tamer and every row on the black screen of Jijimon's questions, with no window. The
+ * tamer is not in memory yet: he is loaded for the page and thrown away after it (the game loads him after the
+ * opening's movie, as chosen here). Jijimon's scene goes on around it: lookPageQuiz runs the page frame by frame. */
+void loadTitleMenuOverlays(void);
+
+static void lookPageNewGameOpen(void)
+{
+	RECT pos;
+	int32_t mode;
+
+	/* the title read this code before the language was chosen: again, in the language's copy (the same code) */
+	loadTitleMenuOverlays();
+	initializeTamer(0, 0, 0, 0, 0, 0, 0);
+	removeObject(0, 0); /* he does not tick here, and only the page draws him */
+	if (lookPageOpen()) {
+		lookPageState.ask = 1;
+		setRECT(&pos, 0, LOOK_OPEN_Y, 256, 12); /* the row that is never shown: where the look is changed later */
+		clearTextSubArea(&pos);
+		mode = fitStringMode((char *)lookPageTextLater, 256);
+		drawStringMode((char *)lookPageTextLater, 0, LOOK_OPEN_Y, mode);
+		lookPageState.width[LOOK_HANDS_ROW] = measureStringMode((char *)lookPageTextLater, mode);
+		ENTITY_TABLE[2]->isOnScreen = 0;
+		DIGIVICE_ENTITY_VIEW.vpy = DIGIVICE_ENTITY_VIEW.vry = 60; /* the tamer whole, on the left of the list */
+		DIGIVICE_ENTITY_VIEW.vrx = 175;
+		addObject(LOOK_BARE_OBJECT, 0, NULL, (RenderFunction)lookPageRender);
+	}
+	fadeFromBlack(0x14);
+}
+
+static void lookPageNewGameClose(void)
+{
+	GsRVIEW2 view;
+
+	if (lookPageState.ask) {
+		removeObject(LOOK_BARE_OBJECT, 0);
+		lookPageState.ask = 0;
+		lookTurn = 0;
+		DIGIVICE_ENTITY_VIEW.vpy = DIGIVICE_ENTITY_VIEW.vry = 0;
+		DIGIVICE_ENTITY_VIEW.vrx = 0;
+		ENTITY_TABLE[2]->isOnScreen = 1;
+	}
+	removeEntity(0, 0);
+	thunkUnloadModel(0, 2);
+	/* Jijimon's view again (loadNewGameScene) */
+	GsSetProjection(0x3e8);
+	memset(&view, 0, sizeof(view));
+	view.vpz = -0x1068;
+	GsSetRefView2(&view);
+	fadeFromBlack(0x14);
+}
+
+/* A new game's questions about the tamer, among Jijimon's (newGameStateMachine sends its states from 0x30 here): boy
+ * or girl after his seven questions, and the Look page after the name. MAPHEAD 1238 lines 0x3a to 0x3c. */
+int32_t lookPageQuiz(void)
+{
+	switch (SCRIPT_STATE_2) {
+	case 0x30:
+		showNewGameDialogue(0x3a, 0x31);
+		break;
+	case 0x31:
+		showNewGameSelection(0x3b, 0x32);
+		break;
+	case 0x32: /* a boy: the original tamer */
+		memset(MOD_TAMER_STATE, 0, TAMER_STATE_SIZE);
+		SCRIPT_STATE_2 = 0x12;
+		break;
+	case 0x33: /* a girl: as she starts, to change on the page */
+		memcpy(MOD_TAMER_STATE, (uint8_t *)lookPageGirl, TAMER_STATE_SIZE);
+		SCRIPT_STATE_2 = 0x12;
+		break;
+	case 0x34: /* the name is right */
+		showNewGameDialogue(0x3c, 0x36);
+		break;
+	case 0x35: /* it is not: the keyboard again */
+		SCRIPT_STATE_2 = 0x13;
+		break;
+	case 0x36:
+		closeBox(0);
+		fadeToBlack(0x14);
+		SCRIPT_STATE_2 = 0x37;
+		break;
+	case 0x37:
+		if (FADE_OUT_CURRENT >= 0x14) {
+			lookPageNewGameOpen();
+			SCRIPT_STATE_2 = 0x38;
+		}
+		break;
+	case 0x38: /* the page, a frame of it: ask counts its first frames, when the press that answered Jijimon is not its own */
+		if (lookPageState.ask == 0) {
+			SCRIPT_STATE_2 = 0x39;
+		} else if (lookPageState.ask < 40) {
+			lookPageState.ask++;
+		} else if (isKeyDown(CONFIRM_BUTTON) != 0) {
+			playSound(0, 3);
+			fadeToBlack(0x14);
+			SCRIPT_STATE_2 = 0x39;
+		} else if (isKeyDown(CANCEL_BUTTON) == 0) {
+			lookPageInput();
+		}
+		break;
+	case 0x39:
+		if (lookPageState.ask == 0 || FADE_OUT_CURRENT >= 0x14) {
+			lookPageNewGameClose();
+			setupNewGameDialogueBox();
+			SCRIPT_STATE_2 = 0x18;
+		}
+		break;
+	}
+	return 0;
+}
+
 void renderDigiviceEntity(entity, entityId)
 	Entity *entity;
 int8_t entityId;
diff --git a/src/shop/script_menu.c b/src/shop/script_menu.c
