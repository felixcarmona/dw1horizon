+#define LOOK_ASK_X	(-0x24)	/* the answers' boxes, side by side in the rows' place */
+#define LOOK_ASK_W	80
+#define LOOK_ASK_GAP	12
 #define LOOK_SCROLL_X	(LOOK_VALUE_X + LOOK_VALUE_W + 7)	/* the scroll bar: right of the value boxes, as tall as the rows shown */
 #define LOOK_SCROLL_H	((LOOK_SHOWN - 1) * 0x14 + 14)
 #define LOOK_HEAD_OBJECT	1
@@ -2603,6 +2607,7 @@ void lookShirtPalette(uint16_t *row, LookShirtRecipe *recipe, uint8_t *rgb);
 extern LookShirtRecipe lookShirtRecipe[LOOK_GARMENTS]; /* of the clothes the tamer wears */
 extern uint16_t lookShirtRow[LOOK_GARMENTS][16]; /* their palette rows as they are in video memory */
 static int16_t lookTurn;
+void renderSelectionCursor(int32_t x, int32_t y, int16_t w, int16_t h, int32_t layer);
 static struct {
 	uint16_t palette[16]; /* the hair's palette row on its way to video memory */
 	uint8_t levels[16];
@@ -2611,6 +2616,8 @@ static struct {
 	uint32_t who[LOOK_GARMENTS][2]; /* per garment: the boy's choices and the girl's */
 	int16_t width[LOOK_ROWS];
 	uint8_t row;
+	uint8_t ask; /* a new game's question, boy or girl, before its page (lookPageNewGame) */
+	uint8_t kind[2]; /* how wide the question's two answers are */
 	uint8_t rgb[TAMER_HAIR_COUNT * 3];
 	uint8_t cloth[TAMER_CLOTH_COUNT * LOOK_CLOTH_SIZE]; /* per cloth colour: its shade, the cloth, its light, and the second colour */
 } lookPageState;
@@ -2667,6 +2674,9 @@ static const char lookPageTextPack6[] = LAB_STR_BACKPACK_ROUND;
 static const char lookPageTextKind[] = LAB_STR_TAMER_KIND;
 static const char lookPageTextCap[] = LAB_STR_CAP_COLOUR;
 static const char lookPageTextSkin[] = LAB_STR_SKIN;
+static const char lookPageTextWho[] = LAB_STR_LOOK_WHO;
+static const char lookPageTextStart[] = LAB_STR_LOOK_START;
+static const char lookPageTextBack[] = LAB_STR_LOOK_BACK;
 static const char lookPageTextBoy[] = LAB_STR_TAMER_BOY;
 static const char lookPageTextGirl[] = LAB_STR_TAMER_GIRL;
 /* The girl's shirts after the first ten are the boy's with a bust, and her shoes his on a smaller foot: the same names.
@@ -2953,6 +2963,7 @@ int32_t lookPageOpen(void)
 	}
 	free3(head);
 	lookPageState.row = 0;
+	lookPageState.ask = 0;
 	lookPageKeep();
 	lookTurn = 0;
 	setRECT(&rect, 0, LOOK_TOP_Y, 256, LOOK_END_Y - LOOK_TOP_Y);
@@ -3115,6 +3126,24 @@ void lookPageRender(void)
 	renderSeparatorLines((Line *)lookPageLines, 0xb, 5);
 	renderString(3, e->posX, e->posY + 1, e->uvWidth, 0xc, e->uvX, e->uvY, 5, 1);
 	renderString(0, -0x54, -0x50, 0x48, 0xc, 0, 0x30, 5, 1);
+	renderString(0, -0x29, 0x4e, 0x7c, 0xc, 0, LOOK_HINT_Y, 5, 1);
+	renderDigiviceEntity(ENTITY_TABLE[0], 0);
+	renderInsetBox(r->x, r->y, r->w, r->h, 5);
+	if (lookPageState.ask) { /* a new game's question: its two answers side by side, the tamer as the chosen one */
+		renderString(0, LOOK_ASK_X + (2 * LOOK_ASK_W + LOOK_ASK_GAP - lookPageState.width[LOOK_HANDS_ROW]) / 2, -0x1c,
+		             lookPageState.width[LOOK_HANDS_ROW], 0xc, 0, LOOK_ASK_V, 5, 1);
+		for (k = 0; k < 2; k++) {
+			y = LOOK_ASK_X + k * (LOOK_ASK_W + LOOK_ASK_GAP);
+			renderString(k == MOD_TAMER_FACE ? 3 : 0, y + (LOOK_ASK_W - lookPageState.kind[k]) / 2, 2, lookPageState.kind[k], 0xc,
+			             k * 0x80, LOOK_ASK_V + 12, 5, 1);
+			if (k == MOD_TAMER_FACE) {
+				renderSelectionCursor(y - 2, -2, LOOK_ASK_W + 4, 18, 5);
+			}
+			renderInsetBox(160 + y, 118, LOOK_ASK_W, 14, 5);
+		}
+		playerKeyRender(0, LOOK_OPEN_Y);
+		return;
+	}
 	for (k = first; k < first + LOOK_SHOWN; k++) {
 		i = lookPageOrder[k];
 		y = -0x34 + (k - first) * 0x14;
@@ -3133,11 +3162,8 @@ void lookPageRender(void)
 	renderBox(LOOK_SCROLL_X, -0x34 + (LOOK_SCROLL_H - LOOK_SCROLL_H * LOOK_SHOWN / LOOK_PLACES) * first / (LOOK_PLACES - LOOK_SHOWN),
 	          2, LOOK_SCROLL_H * LOOK_SHOWN / LOOK_PLACES, 0xe6, 0xe6, 0xe6, 0, 5);
 	renderBox(LOOK_SCROLL_X, -0x34, 2, LOOK_SCROLL_H, 0x20, 0x48, 0x58, 0, 5);
-	renderString(0, -0x29, 0x4e, 0x7c, 0xc, 0, LOOK_HINT_Y, 5, 1);
 	playerKeyRender(1, LOOK_HINT_Y);
 	playerKeyRender(2, LOOK_HINT_Y);
-	renderDigiviceEntity(ENTITY_TABLE[0], 0);
-	renderInsetBox(r->x, r->y, r->w, r->h, 5);
 	for (i = 0; i < LOOK_SHOWN; i++) {
 		renderInsetBox(160 + LOOK_VALUE_X, 118 - 0x34 + i * 0x14, LOOK_VALUE_W, 14, 5);
 	}
@@ -6643,6 +6669,115 @@ void renderDigimonStatusConditions(int32_t condition)
 static VECTOR modDigiviceSavedPos;
 static SVECTOR modDigiviceSavedRot;
 
+void modTickStart(int32_t flags);
+void pollInputGame(void);
+void processInput(void);
+void fadeFromBlack(int16_t frames);
+void fadeToBlack(int16_t frames);
+void createStaticUIBox(int32_t id, uint8_t color, uint8_t features, RECT *pos, TickFunction tickFunc, RenderFunction renderFunc);
+extern GsOT GS_ORDERING_TABLE[2];
+extern PACKET GS_WORK_BASES[2][0x14000];
+extern int16_t FADE_OUT_CURRENT;
+
+/* A new game: who the tamer is, before the first screen. The question, boy or girl, then the Look page with what the
+ * chosen one can wear; the confirm button starts the game, the cancel button goes back to the question. The page is the
+ * Player view's, in a window of its own: nothing else is on the screen, and nothing ticks. */
+void lookPageNewGame(void)
+{
+	RECT pos;
+	char **text = (char **)LOOK_PAGE_TEXT;
+	char *save = text[5];
+	char *leave = text[6];
+	char *str;
+	int32_t done = 0;
+	int32_t mode;
+	int32_t i;
+
+	clearTextArea();
+	text[5] = (char *)lookPageTextStart; /* the page's two buttons: what they do here */
+	text[6] = (char *)lookPageTextBack;
+	if (lookPageOpen()) {
+		lookPageState.ask = 1;
+#if FONT_SWITCH
+		if (FONT_PROPORTIONAL) {
+			drawStringPieces(PLAYER_VIEW_LABELS[2], 0, 0xc, PLAYER_LABEL_PIECES[0]);
+		} else
+#endif
+		{
+			drawString(PLAYER_VIEW_LABELS[2], 0, 0xc);
+		}
+		drawString((char *)digimonPara(0), 0, 0x30);
+		mode = fitStringMode((char *)lookPageTextWho, 2 * LOOK_ASK_W + LOOK_ASK_GAP);
+		drawStringMode((char *)lookPageTextWho, 0, LOOK_ASK_V, mode);
+		lookPageState.width[LOOK_HANDS_ROW] = measureStringMode((char *)lookPageTextWho, mode);
+		for (i = 0; i < 2; i++) {
+			str = (char *)(i ? lookPageTextGirl : lookPageTextBoy);
+			mode = fitStringMode(str, LOOK_ASK_W - 6);
+			drawStringMode(str, i * 0x80, LOOK_ASK_V + 12, mode);
+			lookPageState.kind[i] = measureStringMode(str, mode);
+		}
+		setRECT(&pos, 0, LOOK_OPEN_Y, 256, 12); /* the row that is never shown: the question's button */
+		clearTextSubArea(&pos);
+		playerKeyHint(0, LOOK_OPEN_Y);
+		TAMER_ENTITY.entity.isOnScreen = 0;
+		setRECT(&pos, -0x96, -0x59, 300, 0xbe);
+		createStaticUIBox(1, 1, 0, &pos, NULL, (RenderFunction)lookPageRender);
+		fadeFromBlack(0x14);
+		do {
+			modTickStart(MOD_PRESENT_BATTLE);
+			pollInputGame();
+			ACTIVE_FRAMEBUFFER = GsGetActiveBuff();
+			ACTIVE_ORDERING_TABLE = &GS_ORDERING_TABLE[ACTIVE_FRAMEBUFFER];
+			GsSetWorkBase(GS_WORK_BASES[ACTIVE_FRAMEBUFFER]);
+			GsClearOt(0, 0, ACTIVE_ORDERING_TABLE);
+			processInput();
+			if (done) {
+			} else if (isKeyDown(CONFIRM_BUTTON) != 0) {
+				playSound(0, 3);
+				if (lookPageState.ask) {
+					lookPageState.ask = 0;
+					lookPageState.row = 1;
+				} else {
+					done = 1;
+					fadeToBlack(0x14);
+				}
+			} else if (isKeyDown(CANCEL_BUTTON) != 0) {
+				if (!lookPageState.ask) {
+					playSound(0, 4);
+					lookPageState.ask = 1;
+					lookPageState.row = 0;
+				}
+			} else if (!lookPageState.ask) {
+				lookPageInput();
+			} else if (!(CHANGED_INPUT & 0x5000)) {
+				/* the question is the page's first row: left and right change it. The other one starts as he or she
+				 * comes: the boy the original tamer, the girl in the first clothes that are hers */
+				if (CHANGED_INPUT & 0xA000) {
+					i = MOD_TAMER_FACE;
+					memset(MOD_TAMER_STATE, 0, TAMER_STATE_SIZE);
+					MOD_TAMER_FACE = i;
+				}
+				lookPageInput();
+				if (CHANGED_INPUT & 0xA000) {
+					lookPageHairName();
+					for (i = 0; i < LOOK_ROWS; i++) {
+						if (i != LOOK_HANDS_ROW) { /* its width is the question's */
+							lookPageValue(i);
+						}
+					}
+				}
+			}
+			modPresent(MOD_PRESENT_BATTLE, NULL);
+		} while (!done || FADE_OUT_CURRENT < 0x14);
+		removeStaticUIBox(1);
+		lookTurn = 0;
+		setEntityRotation(0, 0, 0, 0);
+		TAMER_ENTITY.entity.isOnScreen = 1;
+	}
+	text[5] = save;
+	text[6] = leave;
+}
+
 void renderDigiviceEntity(entity, entityId)
 	Entity *entity;
 int8_t entityId;
