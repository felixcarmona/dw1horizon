diff --git a/include/dw/memmap.h b/include/dw/memmap.h
index 498ffe5..23dd1ef 100644
--- a/include/dw/memmap.h
+++ b/include/dw/memmap.h
@@ -95,5 +95,19 @@
 #define TAMER_MMD_MAX		0xE000	/* BOYS.MMD 0xDECC (GCC: one array, mod 0002) */
 #define MAP_SCRIPT_MAX		0x4000	/* a DG.SCN entry; the largest is 0x3800 */
 #define SCRIPT_OFFSET_TABLE_SIZE 0x2000	/* start of DG.SCN (offset table), read at boot */
+/*
+ * The SEQ block of the current music font (every track of it), copied from
+ * the FAALL chunk (sound.c). Original 0x5800 (font 0xB uses 0x55F8); the
+ * extra 0x2800 bytes come out of the malloc3 heap (MIN_HEAP assert below).
+ */
+#define SEQ_BUFFER_SIZE		0x8000
+
+/*
+ * SPU RAM (512 KB, sound.c): what the sound banks may use. Below it the
+ * libspu capture buffers and silence block, above it the STUDIO_B reverb
+ * work area (0x4840 bytes).
+ */
+#define SPU_BANKS_START		0x1010
+#define SPU_REVERB_START	0x7B7C0
 
 #endif
diff --git a/include/dw/sound.h b/include/dw/sound.h
index 0300ab7..0f98a24 100644
--- a/include/dw/sound.h
+++ b/include/dw/sound.h
@@ -16,6 +16,53 @@ typedef struct {
 	uint16_t sectorCount;
 } MapSoundPara;
 
+/*
+ * MOD (sound limits, docs/mods/sound.md § 8): the chunks of the multi-chunk
+ * sound files are found through an index instead of fixed sector strides.
+ * A file written by tools/sound.py starts with an index sector:
+ *   u32 magic "SIDX", u16 count, u16 index sectors,
+ *   then count x SoundChunk (sector from the start of the file, length).
+ * Files without it (the original disc) get the original layout: strides of
+ * 39 (FAALL), 7 (VBALL) and 15 (VLALL) sectors and MAP_SOUND_PARA (ESALL).
+ */
+#define SOUND_INDEX_MAGIC	0x58444953	/* "SIDX" */
+
+enum {
+	SOUND_FILE_FAALL,	/* music fonts: chunk = font - 1 */
+	SOUND_FILE_VBALL,	/* short voices: DIGIMON_VBALL_SOUND_ID */
+	SOUND_FILE_VLALL,	/* long voices: DIGIMON_VLALL_SOUND_ID */
+	SOUND_FILE_ESALL,	/* map effects: MAP_ENTRIES.flags & 0x1F */
+	NUM_SOUND_INDEXED_FILES
+};
+
+/* Capacity of the index tables in RAM (4 bytes per entry) */
+#define SOUND_MAX_FONTS		254	/* fonts 1..254; 0xFF stops the music */
+#define SOUND_MAX_VBALL		256	/* u8 ids in DIGIMON_VBALL_SOUND_ID */
+#define SOUND_MAX_VLALL		256	/* u8 ids in DIGIMON_VLALL_SOUND_ID */
+#define SOUND_MAX_ESALL		32	/* 5-bit MAP_ENTRIES.flags field */
+
+typedef struct {
+	uint16_t sector;
+	uint16_t sectors;
+} SoundChunk;
+
+extern int16_t SOUND_CHUNK_COUNT[];
+
+/*
+ * MOD (sound limits, step 3): SPU RAM is allocated per load instead of fixed
+ * slots. VHB_SOUNDBUFFER_START[bank] is the bank's current address and
+ * SPU_BANK_SIZE[bank] its bytes (0 = not loaded). Bank 8 (map effects /
+ * battle) grows down from the reverb area; the others keep their original
+ * slot when they fit there and otherwise take the lowest free space.
+ */
+extern unsigned long SPU_BANK_SIZE[];
+extern int32_t SPU_ALLOC_FAILS;
+
+int32_t openSoundBank(int32_t vabId, uint8_t *buffer);
+
+void loadSoundIndex(void);
+int32_t getSoundChunk(int32_t file, int32_t id, int32_t *sector, int32_t *sectors);
+
 extern void *VHB_HEADER_ADDR[];
 extern unsigned long VHB_SOUNDBUFFER_START[];
 extern int32_t ACTIVE_MAP_SOUND_ID;
diff --git a/src/main/sound.c b/src/main/sound.c
index fb787bc..266f0d1 100644
--- a/src/main/sound.c
+++ b/src/main/sound.c
@@ -354,13 +354,119 @@ int16_t SEQ_ACCESS_NUM;
 int16_t CURRENT_SEQ_FONT;
 int16_t CURRENT_SEQ_TRACK;
 
+/* MOD (sound limits, step 3): SPU allocation, see dw/sound.h */
+unsigned long SPU_BANK_SIZE[NUM_SOUND_BUFFERS];
+int32_t SPU_ALLOC_FAILS;
+
+/* the original fixed slots: where each bank goes when it fits there */
+static unsigned long SPU_HOME[NUM_SOUND_BUFFERS] = {
+	0x1010, 0xe800, 0x1b800, 0x2a000, 0x31800, 0x34000, 0x36800, 0x39000, 0, 0,
+};
+
+/* size of each VHB_HEADER_* buffer: a VAB header must fit (was unchecked) */
+static uint16_t VHB_HEADER_SIZE[NUM_SOUND_BUFFERS] = {
+	0x1000, 0x1000, 0x2000, 0x1000, 0x1000, 0x1000, 0x1000, 0x1000, 0x1800, 0,
+};
+
 char SEQ_TABLE[SS_SEQ_TABSIZ];
-uint8_t SEQ_BUFFER[0x5800];
+uint8_t SEQ_BUFFER[SEQ_BUFFER_SIZE]; /* MOD (sound limits): was 0x5800, dw/memmap.h */
 
 char VHB_EXT[] = ".VHB";
 
 int32_t ACTIVE_MAP_SOUND_ID = -1;
 
+/* MOD (sound limits): chunk index, see dw/sound.h */
+SoundChunk SOUND_CHUNKS_FAALL[SOUND_MAX_FONTS];
+SoundChunk SOUND_CHUNKS_VBALL[SOUND_MAX_VBALL];
+SoundChunk SOUND_CHUNKS_VLALL[SOUND_MAX_VLALL];
+SoundChunk SOUND_CHUNKS_ESALL[SOUND_MAX_ESALL];
+int16_t SOUND_CHUNK_COUNT[NUM_SOUND_INDEXED_FILES];
+int32_t SOUND_INDEX_LOADED;
+
+typedef struct {
+	char *name;
+	SoundChunk *chunks;
+	int16_t cap;
+	int16_t stride;		/* original layout: sectors per chunk, 0 = MAP_SOUND_PARA */
+} SoundIndexFile;
+
+static SoundIndexFile SOUND_INDEX_FILES[NUM_SOUND_INDEXED_FILES] = {
+	{ "FAALL.VHB", SOUND_CHUNKS_FAALL, SOUND_MAX_FONTS, 39 },
+	{ "VBALL.VHB", SOUND_CHUNKS_VBALL, SOUND_MAX_VBALL, 7 },
+	{ "VLALL.VHB", SOUND_CHUNKS_VLALL, SOUND_MAX_VLALL, 15 },
+	{ "ESALL.VHB", SOUND_CHUNKS_ESALL, SOUND_MAX_ESALL, 0 },
+};
+
+/*
+ * Reads the index sector of every multi-chunk file (once; GENERAL_BUFFER is
+ * free at boot) or, for a file without one, rebuilds the original layout.
+ */
+void loadSoundIndex(void)
+{
+	SoundIndexFile *f;
+	uint32_t *hdr;
+	int32_t i;
+	int32_t k;
+	int32_t count;
+
+	if (SOUND_INDEX_LOADED) {
+		return;
+	}
+	SOUND_INDEX_LOADED = 1;
+
+	hdr = (uint32_t *)GENERAL_BUFFER;
+	for (k = 0; k < NUM_SOUND_INDEXED_FILES; ++k) {
+		f = &SOUND_INDEX_FILES[k];
+		hdr[0] = 0;
+		readFileSectors(f->name, GENERAL_BUFFER, 0, 1);
+		if (hdr[0] == SOUND_INDEX_MAGIC) {
+			count = hdr[1] & 0xffff;
+			if ((hdr[1] >> 16) > 1) {
+				readFileSectors(f->name, GENERAL_BUFFER, 0, hdr[1] >> 16);
+			}
+			if (count > f->cap) {
+				count = f->cap;
+			}
+			memcpy(f->chunks, &hdr[2], count * sizeof(SoundChunk));
+		} else if (f->stride != 0) {
+			count = lookupFileSize(f->name) / (f->stride * 0x800);
+			if (count > f->cap) {
+				count = f->cap;
+			}
+			for (i = 0; i < count; ++i) {
+				f->chunks[i].sector = i * f->stride;
+				f->chunks[i].sectors = f->stride;
+			}
+		} else {
+			count = sizeof(MAP_SOUND_PARA) / sizeof(MAP_SOUND_PARA[0]);
+			for (i = 0; i < count; ++i) {
+				f->chunks[i].sector = MAP_SOUND_PARA[i].sectorId / 2;
+				f->chunks[i].sectors = MAP_SOUND_PARA[i].sectorCount / 2;
+			}
+		}
+		SOUND_CHUNK_COUNT[k] = count;
+	}
+}
+
+/* Where chunk `id` of an indexed file is; 0 if there is no such chunk */
+int32_t getSoundChunk(int32_t file, int32_t id, int32_t *sector, int32_t *sectors)
+{
+	SoundChunk *c;
+
+	if ((id < 0) || (id >= SOUND_CHUNK_COUNT[file])) {
+		return 0;
+	}
+
+	c = &SOUND_INDEX_FILES[file].chunks[id];
+	if (c->sectors == 0) {
+		return 0;
+	}
+
+	*sector = c->sector;
+	*sectors = c->sectors;
+	return 1;
+}
+
