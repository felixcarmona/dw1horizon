diff --git a/src/main/main.c b/src/main/main.c
index 8805df7..ce3bb18 100644
--- a/src/main/main.c
+++ b/src/main/main.c
@@ -22,6 +22,7 @@
 #include <dw/main.h>
 #include <dw/map.h>
 #include <dw/map_object.h>
