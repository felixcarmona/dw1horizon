 #include <dw/mod_options.h>
+#include <dw/chinese.h>
 #include <dw/sjis.h>
 #include <dw/types.h>
 #include <dw/version.h>
@@ -1410,7 +1411,7 @@ extern int32_t MOD_RENDER_PASS;
 #if FONT_SWITCH
