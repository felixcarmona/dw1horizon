From aae2f67df57b607d7d86a6e75e656c3668a834ce Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Sun, 11 Oct 2026 01:31:22 +0000
Subject: [PATCH] 60 fps step 4: effect render scripts on the extra passes

BTL_renderEFEEngine runs every effect's render script on every pass (its
primitives are needed on every frame). Render scripts write their own
variables and call rand()/customRandom (seen in a Native Forest battle),
and some opcodes reach outside the effect. On the extra passes:

- the script/data area of every slot with a running sub-effect (the file
  up to its TMD) is copied aside before its scripts and put back after
  them, into the free part of the EFE heap above the last loaded effect;
  MOD_FPS_EFE_NO_ROOM counts a slot that would not fit;
- the interpreter's target / hit / section indices are put back;
- random numbers come from modRenderRand / modRenderCustomRandom (the real
  generators on the first pass); the finisher aura's too;
- sounds, CLUT uploads, particle emitters, flashes, clouds, entity
  particles, attack objects and hit tests, turning the source entity and
  the "finished" mark do nothing.

---
 include/dw/mod_present.h |   2 +
 src/btl/battle_effect.c  | 115 +++++++++++++++++++++++++++++++++++----
 src/main/efe.c           |   6 ++
 src/main/main.c          |   3 +
 4 files changed, 114 insertions(+), 12 deletions(-)

diff --git a/include/dw/mod_present.h b/include/dw/mod_present.h
index 90b2449..e34d169 100644
--- a/include/dw/mod_present.h
+++ b/include/dw/mod_present.h
@@ -31,6 +31,8 @@ extern int32_t MOD_RENDER_PASS;
 extern int32_t MOD_RENDER_MULTIPASS;
 /* rand() for render code: the real one on the first pass of a tick */
 int32_t modRenderRand(void);
+int32_t modRenderCustomRandom(long min, long max);
 void removeObjectAfterRender(int32_t objectId, int32_t instanceId);
+extern int32_t MOD_FPS_EFE_NO_ROOM;
 
 #endif
diff --git a/src/btl/battle_effect.c b/src/btl/battle_effect.c
index ba1f32b..8757eab 100644
--- a/src/btl/battle_effect.c
+++ b/src/btl/battle_effect.c
@@ -13,6 +13,7 @@
 #include <dw/battle.h>
 #include <dw/btl.h>
 #include <dw/efe.h>
+#include <dw/mod_present.h>
 #include <dw/garbage.h>
 #include <dw/graphics.h>
 #include <dw/line.h>
@@ -1281,14 +1282,73 @@ void BTL_tickEFEEngine(void)
 	}
 }
 
+/* MOD (fps): the render scripts of the effects run on every render pass of a
+ * tick (their primitives are needed on every frame), but they also write: the
+ * effect's variables and sub-effect table (in the file's script/data area,
+ * before its TMD), random numbers, and a few opcodes reach outside the effect
+ * (sounds, CLUT uploads, particle emitters, flashes, clouds, entity particles,
+ * attack objects and hit tests, turning the source entity, the "finished"
+ * mark). On the extra passes the area is copied aside before the slot's
+ * scripts and put back after them (into the free part of the EFE heap, above
+ * the last loaded effect), those opcodes do nothing and the random numbers
+ * come from a private generator (modRenderRand), so after the passes the
+ * battle is exactly as one render per tick left it. */
+static int32_t BTL_modEfeSave(int32_t data, uint32_t **buf)
+{
+	int32_t size = ((EfeFileHeader *)(data - 0x34))->tmdStart & ~3;
+	uint32_t *b = (uint32_t *)(((int32_t)EFE_HEAP_POINTER + 3) & ~3);
+	uint32_t *s = (uint32_t *)data;
+	uint32_t *d = b;
+	int32_t k;
+
+	if (size <= 0 || (int32_t)b + size > 0x80052ae0) {
+		return 0; /* no room: not expected (MOD_FPS_EFE_NO_ROOM counts it) */
+	}
+	for (k = size >> 2; k > 0; k--) {
+		*d++ = *s++;
+	}
+	*buf = b;
+	return size;
+}
+
+static void BTL_modEfeRestore(int32_t data, uint32_t *buf, int32_t size)
+{
+	uint32_t *d = (uint32_t *)data;
+
+	for (size >>= 2; size > 0; size--) {
+		*d++ = *buf++;
+	}
+}
+
 void BTL_renderEFEEngine(void)
 {
 	int32_t i;
 	int32_t j;
 	int32_t n;
+	int32_t saved;
+	uint32_t *buf = NULL;
+	int32_t target;
+	int32_t hit;
+	int32_t section;
 
+	target = EFE_TARGET_ENTITY_INDEX;
+	hit = EFE_HIT_ENTITY_INDEX;
+	section = EFE_ACTIVE_SECTION;
 	EFE_DATA_ITERATOR = EFE_DATA_PTR;
 	for (i = 0; i < 0x10; i++) {
+		saved = 0;
+		if (MOD_RENDER_PASS != 0 && EFE_DATA_ITERATOR->data != 0L) {
+			n = EFE_DATA_ITERATOR->numSubEffects;
+			for (j = 0; j < n; j++) {
+				if (EFE_DATA_ITERATOR->subEffects[j].inst != NULL) {
+					saved = BTL_modEfeSave(EFE_DATA_ITERATOR->data, &buf);
+					if (saved == 0) {
+						MOD_FPS_EFE_NO_ROOM++;
+					}
+					break;
+				}
+			}
+		}
 		n = EFE_DATA_ITERATOR->numObjects;
 		for (j = 0; j < n; j++) {
 			EFE_DATA_ITERATOR->uvAnims[j].unk2 = 0;
@@ -1305,9 +1365,18 @@ void BTL_renderEFEEngine(void)
 				}
 			}
 		}
+		if (saved) {
+			BTL_modEfeRestore(EFE_DATA_ITERATOR->data, buf, saved);
+		}
 		EFE_DATA_ITERATOR++;
 	}
 
+	if (MOD_RENDER_PASS != 0) {
+		/* interpreter state a later tick may read */
+		EFE_TARGET_ENTITY_INDEX = target;
+		EFE_HIT_ENTITY_INDEX = hit;
+		EFE_ACTIVE_SECTION = section;
+	}
 	BTL_renderParticleEmitters();
 }
 
@@ -1993,6 +2062,9 @@ void BTL_isTargetUnhit(void)
 
 void BTL_markEFEFinished(void)
 {
+	if (MOD_RENDER_PASS != 0) { /* MOD (fps): see BTL_renderEFEEngine */
+		return;
+	}
 	UNUSED_EFE_ARRAY[COMBAT_EFFECT_ITR] = 0;
 }
 
@@ -2046,6 +2118,9 @@ void BTL_applyBoxAttackHit(void)
 	out = EFE_POP1(int32_t *);
 	ext = EFE_POP1(EfeVector *);
 	*out = 0;
+	if (MOD_RENDER_PASS != 0) { /* MOD (fps): see BTL_renderEFEEngine */
+		return;
+	}
 	if (r < 0) {
 		r = EFE_SUB_EFFECT_INDEX;
 	}
@@ -2089,6 +2164,9 @@ void BTL_applyRadiusAttackHit(void)
 	hitFlag = EFE_POP1(int32_t *);
 	r = EFE_POP1(int32_t);
 	*hitFlag = 0;
+	if (MOD_RENDER_PASS != 0) { /* MOD (fps): see BTL_renderEFEEngine */
+		return;
+	}
 	r = r * r;
 	EFE_HIT_ENTITY_INDEX = 1;
 	while (EFE_HIT_ENTITY_INDEX < 10) {
@@ -2145,6 +2223,9 @@ void BTL_applyLineAttackHit(void)
 	out = EFE_POP1(int32_t *);
 	arg = EFE_POP1(int32_t *);
 	*out = 0;
+	if (MOD_RENDER_PASS != 0) { /* MOD (fps): see BTL_renderEFEEngine */
+		return;
+	}
 	line[0].vx = ((EfeTransform *)((int32_t)EFE_CURRENT_DATA_SEGMENT + 4))->position.vx;
 	line[0].vy = *(int32_t *)((int32_t)EFE_CURRENT_DATA_SEGMENT + 0xc);
 	line[1].vx = EFE_SCRIPT_CONTEXT->sourceEntity->posData->location.vx;
@@ -2192,7 +2273,7 @@ void BTL_faceTargetEntity(void)
 {
 	PositionData *pd;
 
-	if (EFE_SCRIPT_CONTEXT->targetEntity == NULL) {
+	if (EFE_SCRIPT_CONTEXT->targetEntity == NULL || MOD_RENDER_PASS != 0) { /* MOD (fps) */
 		return;
 	}
 
@@ -2530,7 +2611,7 @@ void BTL_loadClutColors(void)
 	x = EFE_POP1(int32_t);
 	y = EFE_POP1(int32_t);
 
-	if ((count > 0) && (count <= 16)) {
+	if ((count > 0) && (count <= 16) && MOD_RENDER_PASS == 0) { /* MOD (fps) */
 		m = EFE_DATA_ITERATOR->model;
 		for (i = 0; i < count; i++) {
 			clut[i] = *src++;
@@ -2592,7 +2673,7 @@ void BTL_selectRandomTargetEntity(void)
 	int32_t n;
 
 	excludeSelf = *--EFE_DATA_STACK;
-	for (n = rand() % 8; n >= 0; n--) {
+	for (n = modRenderRand() % 8; n >= 0; n--) { /* MOD (fps): see BTL_renderEFEEngine */
 		EFE_TARGET_ENTITY_INDEX++;
 		while (1) {
 			while (EFE_TARGET_ENTITY_INDEX < 10) {
@@ -3357,7 +3438,7 @@ void BTL_getRandomInRange(void)
 	a = EFE_POP1(int32_t);
 	b = EFE_POP1(int32_t);
 	out = EFE_POP1(int32_t *);
-	*out = customRandom(b, a);
+	*out = modRenderCustomRandom(b, a); /* MOD (fps): see BTL_renderEFEEngine */
 }
 
 void BTL_interpolateValue(void)
@@ -3784,7 +3865,7 @@ void BTL_playEFESound(void)
 	EfeSound *p;
 
 	id = EFE_POP1(int32_t);
-	if (id < 0) {
+	if (id < 0 || MOD_RENDER_PASS != 0) { /* MOD (fps): see BTL_renderEFEEngine */
 		return;
 	}
 
@@ -3809,7 +3890,9 @@ void BTL_addSourceEntityParticleFX(void)
 	int32_t timer;
 
 	timer = EFE_POP1(int32_t);
-	addEntityParticleFX(EFE_SCRIPT_CONTEXT->sourceEntity, timer);
+	if (MOD_RENDER_PASS == 0) { /* MOD (fps): see BTL_renderEFEEngine */
+		addEntityParticleFX(EFE_SCRIPT_CONTEXT->sourceEntity, timer);
+	}
 }
 
 void BTL_copyFromParentTransform(void)
@@ -4015,6 +4098,9 @@ void BTL_addCloudEffect(void)
 	EfeVector *v;
 
 	v = EFE_POP1(EfeVector *);
+	if (MOD_RENDER_PASS != 0) { /* MOD (fps): see BTL_renderEFEEngine */
+		return;
+	}
 	pos.vx = v->vx;
 	pos.vy = v->vy;
 	pos.vz = v->vz;
@@ -4071,6 +4157,9 @@ void BTL_addParticleEmitter(void)
 	vec = EFE_POP1(EfeVector *);
 	n = EFE_POP1(int32_t);
 	b = EFE_POP1(int32_t);
+	if (MOD_RENDER_PASS != 0) { /* MOD (fps): see BTL_renderEFEEngine */
+		return;
+	}
 	for (i = 0; i < 4; i++) {
 		if (EFE_PARTICLE_EMITTERS[i].transform == NULL) {
 			break;
@@ -4250,9 +4339,10 @@ void BTL_getScatteredSpawnPosition(void)
 	}
 
 	if (r > 0) {
-		out->vx = out->vx + ((rand() % r) - (r >> 1));
-		out->vy = out->vy + ((rand() % r) - (r >> 1));
-		out->vz = out->vz + ((rand() % r) - (r >> 1));
+		/* MOD (fps): see BTL_renderEFEEngine */
+		out->vx = out->vx + ((modRenderRand() % r) - (r >> 1));
+		out->vy = out->vy + ((modRenderRand() % r) - (r >> 1));
+		out->vz = out->vz + ((modRenderRand() % r) - (r >> 1));
 	}
 }
 
@@ -4268,7 +4358,8 @@ void BTL_addAttackObjectToTarget(void)
 	int32_t i;
 	int32_t j;
 
-	if (((DigimonEntity *)EFE_SCRIPT_CONTEXT->targetEntity)->stats.current.isHit != 0) {
+	if (((DigimonEntity *)EFE_SCRIPT_CONTEXT->targetEntity)->stats.current.isHit != 0 ||
+	    MOD_RENDER_PASS != 0) { /* MOD (fps): see BTL_renderEFEEngine */
 		return;
 	}
 
@@ -4700,7 +4791,7 @@ void BTL_loadEFEIndexedVariable(void)
 
 void BTL_loadEFERandomValue(void)
 {
-	EFE_SCRIPT_REGISTER = rand();
+	EFE_SCRIPT_REGISTER = modRenderRand(); /* MOD (fps): see BTL_renderEFEEngine */
 	EFE_SCRIPT_PTR = (int16_t *)((int32_t)EFE_SCRIPT_PTR + 2);
 }
 
@@ -5679,7 +5770,7 @@ void BTL_renderFinisherAura(int32_t id)
 	scale.vy = sy;
 	renderTMDModel(*(uint8_t **)&BTL_FINISHER_AURA_MODEL, BTL_FINISHER_AURA_OBJECTS[fa->frame / 2 % 3], &coord, NULL, &trans, &rot, &scale);
 	renderTMDModel(*(uint8_t **)&BTL_FINISHER_AURA_MODEL, 3, &coord, NULL, &trans, &rot, &scale);
-	rot.vy = rand();
+	rot.vy = modRenderRand(); /* MOD (fps): render-side random number */
 	scale.vx = scale.vz = sx * 140 / 100;
 	renderTMDModel(*(uint8_t **)&BTL_FINISHER_AURA_MODEL, 4, &coord, NULL, &trans, &rot, &scale);
 
