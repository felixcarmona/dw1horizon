+	if (KAR_LOBBY.page == KAR_LOBBY_DRAW) {
+		return KAR_HINT_DRAW;
+	}
+	if (KAR_LOBBY.page == KAR_LOBBY_MODE) {
+		return KAR_HINT_MODE + KAR_LOBBY.cursor;
+	}
+	if (KAR_LOBBY.note != 0) {
