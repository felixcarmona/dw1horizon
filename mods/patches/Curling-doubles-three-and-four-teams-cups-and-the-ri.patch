+	}
+	if (KAR_LOBBY.cursor == 0) {
+		return KAR_quickOpen(KAR_LOBBY.mode) ? KAR_HINT_QUICK : KAR_HINT_FEW;
+	}
+	closed = KAR_cupClosed(KAR_LOBBY.mode, KAR_LOBBY.cursor);
+	return closed != 0 ? closed : KAR_HINT_ENTRY;
+}
