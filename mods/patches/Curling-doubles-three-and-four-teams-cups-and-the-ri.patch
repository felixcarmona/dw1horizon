+static const KarRival *KAR_findRival(int32_t species)
+{
+	const KarRival *rival;
+
+	for (rival = KAR_RIVALS + 1; rival < KAR_RIVALS + KAR_RIVAL_ROWS && rival->species >= 0; rival++) {
+		if (rival->species == species) {
+			return rival;
+		}
+	}
+	return KAR_RIVALS;
