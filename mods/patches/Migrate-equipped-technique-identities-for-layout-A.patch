 static int32_t loadSaveCopy(int32_t copy)
 {
 	SaveExtension *ext;
 	int32_t i;
+	int32_t layout = 0;
 
 	if (!isSaveVersionReadable(getSaveVersion(&SAVE_FILE.saves[copy]))) {
 		return 0;
@@ -5504,6 +5519,10 @@ static int32_t loadSaveCopy(int32_t copy)
 	    hasUnreadableRecord(saveExtOf(0))) {
