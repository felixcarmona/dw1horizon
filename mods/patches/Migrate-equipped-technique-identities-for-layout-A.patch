@@ -5486,10 +5498,13 @@ static void applyRecords(uint8_t *e)
  * Loads copy 0 or 1 (isSaveCopyValid): the v1 payload, then
  * the extension when it is valid. 0 = a newer format this build cannot read.
  */
+#include "coherent_slots.h"
