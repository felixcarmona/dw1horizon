 	p = &savegame->unknown4E1[3];
@@ -5387,6 +5398,7 @@ static int32_t isRecordKnown(int32_t tag)
 	case SAVE_TAG_VANILLA_SWAP:
 	case SAVE_TAG_GROUND_PICKED:
 	case SAVE_TAG_GROUND_PICKUP_BITS:
+	case SAVE_TAG_TECHNIQUE_LAYOUT:
