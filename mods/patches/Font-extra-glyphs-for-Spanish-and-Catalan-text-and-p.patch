+	/* F061 / solidus */
+	{ { 0xf7ff, 0xf7ff, 0xefff, 0xefff, 0xdfff, 0xdfff, 0xbfff, 0xbfff, 0x7fff, 0x7fff, 0xffff, }, 8 },
+	/* F062 … horizontal ellipsis */
