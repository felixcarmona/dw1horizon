From 54906c8db8b97e50a99a89eaf2cdd1bdbe2f37ed Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Sun, 11 Oct 2026 07:07:48 +0000
Subject: [PATCH] Font: extra glyphs for Spanish and Catalan text and
 punctuation (codes F040+)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

drawGlyph looks up Shift-JIS codes F040-F07E/F080-F0FC (the user-defined
area, unused by every original text) directly in a new EXTRA_GLYPH_DATA
table: á é í ó ú Á É Í Ó Ú ñ Ñ ü Ü ¿ ¡ à è ò À È Ò ï Ï ç Ç · « » (F040-F05C)
and, appended 2026-10-14, the punctuation the US font lacks:
( ) & % / … [ ] # * ~ @ – — ♪ (F05D-F06B), 44 glyphs, 1 056 bytes.
Every other code still goes through CHAR_TO_GLYPH_TABLE as before. Both
drawString (C strings, names) and drawString2 (script text boxes) pass a
byte with bit 7 set as a two-byte code, so the new glyphs work in
dialogue, menus and names.

The glyphs follow the original metrics (lowercase x-height rows 3-8,
capitals rows 0-9; accented capitals use a 7-row body so the accent fits
the 11-row cell; ( ) [ ] span rows 0-10). font_extra.h is generated by
tools/fontgen.py from tools/font/extra.txt (docs/mods/font.md).

---
 src/main/font.c       | 35 +++++++++++++---
 src/main/font_extra.h | 95 +++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 124 insertions(+), 6 deletions(-)
 create mode 100644 src/main/font_extra.h

diff --git a/src/main/font.c b/src/main/font.c
index 8a88186..f5db378 100644
--- a/src/main/font.c
+++ b/src/main/font.c
@@ -1261,6 +1261,17 @@ GlyphData GLYPH_DATA[NUM_GLYPHS] = {
 	{ { 0xffff, 0xf7ff, 0xebff, 0xebff, 0xddff, 0xddff, 0xbeff, 0xbeff, 0x7f7f, 0x007f, 0xffff, }, 12 },
 };
 // clang-format on
+
+/*
+ * MOD: extra glyphs (accents, ñ, ç, ¿¡, ·, «», and the punctuation ( ) & % / …
+ * [ ] # * ~ @ – — ♪) at Shift-JIS codes F040+N in the
+ * user-defined area, which no original text uses. Both string paths send a
+ * byte with bit 7 set as a two-byte code to drawGlyph, so scripts, names and
+ * C strings can use them. Drawn in tools/font/extra.txt (docs/mods/font.md).
+ */
+#define EXTRA_GLYPH_LEAD	0xf0
+#define EXTRA_GLYPH_FIRST	0x40
+#include "font_extra.h"
 #endif
 
 // clang-format off
@@ -1354,15 +1365,27 @@ int32_t drawGlyph(codepoint, x, y)
 	}
 #endif
 
-	CHAR_TO_GLYPH_TABLE[NUM_GLYPHS - 1] = code;
+#if VERSION_IS(US)
+	/* MOD: F040-F07E, F080-F0FC index EXTRA_GLYPH_DATA directly */
+	n = (code & 0xff) - EXTRA_GLYPH_FIRST;
+	if ((code & 0xff) > 0x7f) {
+		n--;
+	}
+	if ((code >> 8) == EXTRA_GLYPH_LEAD && n >= 0 && n < NUM_EXTRA_GLYPHS) {
+		p = (uint16_t *)EXTRA_GLYPH_DATA[n].pixelData;
+	} else
+#endif
+	{
+		CHAR_TO_GLYPH_TABLE[NUM_GLYPHS - 1] = code;
 
-	for (n = 0;; ++n) {
-		if (code == CHAR_TO_GLYPH_TABLE[n]) {
-			break;
+		for (n = 0;; ++n) {
+			if (code == CHAR_TO_GLYPH_TABLE[n]) {
+				break;
+			}
 		}
-	}
 
-	p = GLYPH_DATA[n].pixelData;
+		p = GLYPH_DATA[n].pixelData;
+	}
 	GLYPH_DRAWING_AREA_INDEX = (GLYPH_DRAWING_AREA_INDEX + 1) % NUM_RENDER_SLOTS;
 	drawRow = GLYPH_DRAWING_AREAS + GLYPH_DRAWING_AREA_INDEX * RENDER_SLOT_SIZE;
 
diff --git a/src/main/font_extra.h b/src/main/font_extra.h
new file mode 100644
index 0000000..2da72ad
--- /dev/null
+++ b/src/main/font_extra.h
@@ -0,0 +1,95 @@
+/* Generated by tools/fontgen.py from tools/font/extra.txt: do not edit. */
+/* Glyph i is Shift-JIS code 0xF040 + i (trail byte 0x7F skipped). */
+
+#define NUM_EXTRA_GLYPHS 44
+
+static const GlyphData EXTRA_GLYPH_DATA[NUM_EXTRA_GLYPHS] = {
+	/* F040 á latin small letter a with acute */
+	{ { 0xefff, 0xdfff, 0xffff, 0xcfff, 0xb7ff, 0x97ff, 0x77ff, 0x77ff, 0x8bff, 0xffff, 0xffff, }, 8 },
+	/* F041 é latin small letter e with acute */
+	{ { 0xefff, 0xdfff, 0xffff, 0x87ff, 0x7bff, 0x03ff, 0x7fff, 0x7bff, 0x87ff, 0xffff, 0xffff, }, 8 },
+	/* F042 ó latin small letter o with acute */
+	{ { 0xefff, 0xdfff, 0xffff, 0x87ff, 0x7bff, 0x7bff, 0x7bff, 0x7bff, 0x87ff, 0xffff, 0xffff, }, 8 },
+	/* F043 ú latin small letter u with acute */
+	{ { 0xefff, 0xdfff, 0xffff, 0x7bff, 0x7bff, 0x7bff, 0x7bff, 0x73ff, 0x8bff, 0xffff, 0xffff, }, 8 },
+	/* F044 à latin small letter a with grave */
+	{ { 0xdfff, 0xefff, 0xffff, 0xcfff, 0xb7ff, 0x97ff, 0x77ff, 0x77ff, 0x8bff, 0xffff, 0xffff, }, 8 },
+	/* F045 è latin small letter e with grave */
+	{ { 0xdfff, 0xefff, 0xffff, 0x87ff, 0x7bff, 0x03ff, 0x7fff, 0x7bff, 0x87ff, 0xffff, 0xffff, }, 8 },
+	/* F046 ò latin small letter o with grave */
+	{ { 0xdfff, 0xefff, 0xffff, 0x87ff, 0x7bff, 0x7bff, 0x7bff, 0x7bff, 0x87ff, 0xffff, 0xffff, }, 8 },
+	/* F047 í latin small letter i with acute */
+	{ { 0xbfff, 0x7fff, 0xffff, 0x7fff, 0x7fff, 0x7fff, 0x7fff, 0x7fff, 0x7fff, 0xffff, 0xffff, }, 4 },
+	/* F048 ï latin small letter i with diaeresis */
+	{ { 0xffff, 0x5fff, 0xffff, 0xbfff, 0xbfff, 0xbfff, 0xbfff, 0xbfff, 0xbfff, 0xffff, 0xffff, }, 4 },
+	/* F049 ü latin small letter u with diaeresis */
+	{ { 0xffff, 0xb7ff, 0xffff, 0x7bff, 0x7bff, 0x7bff, 0x7bff, 0x73ff, 0x8bff, 0xffff, 0xffff, }, 8 },
+	/* F04A ñ latin small letter n with tilde */
+	{ { 0x9bff, 0x67ff, 0xffff, 0x47ff, 0x3bff, 0x7bff, 0x7bff, 0x7bff, 0x7bff, 0xffff, 0xffff, }, 8 },
+	/* F04B ç latin small letter c with cedilla */
+	{ { 0xffff, 0xffff, 0xffff, 0x87ff, 0x7bff, 0x7fff, 0x7fff, 0x7bff, 0x87ff, 0xefff, 0xcfff, }, 8 },
+	/* F04C Á latin capital letter a with acute */
+	{ { 0xfbff, 0xf7ff, 0xffff, 0xf3ff, 0xedff, 0xdeff, 0x80ff, 0x7f7f, 0x7f7f, 0x7f7f, 0xffff, }, 12 },
+	/* F04D É latin capital letter e with acute */
+	{ { 0xfbff, 0xf7ff, 0xffff, 0x007f, 0x7fff, 0x7fff, 0x01ff, 0x7fff, 0x7fff, 0x007f, 0xffff, }, 12 },
+	/* F04E Ó latin capital letter o with acute */
+	{ { 0xfbff, 0xf7ff, 0xffff, 0xc1ff, 0xbeff, 0x7f7f, 0x7f7f, 0x7f7f, 0xbeff, 0xc1ff, 0xffff, }, 12 },
+	/* F04F Ú latin capital letter u with acute */
+	{ { 0xfbff, 0xf7ff, 0xffff, 0x7f7f, 0x7f7f, 0x7f7f, 0x7f7f, 0x7f7f, 0x9cff, 0xe3ff, 0xffff, }, 12 },
+	/* F050 À latin capital letter a with grave */
+	{ { 0xf7ff, 0xfbff, 0xffff, 0xf3ff, 0xedff, 0xdeff, 0x80ff, 0x7f7f, 0x7f7f, 0x7f7f, 0xffff, }, 12 },
+	/* F051 È latin capital letter e with grave */
+	{ { 0xefff, 0xf7ff, 0xffff, 0x007f, 0x7fff, 0x7fff, 0x01ff, 0x7fff, 0x7fff, 0x007f, 0xffff, }, 12 },
+	/* F052 Ò latin capital letter o with grave */
+	{ { 0xefff, 0xf7ff, 0xffff, 0xc1ff, 0xbeff, 0x7f7f, 0x7f7f, 0x7f7f, 0xbeff, 0xc1ff, 0xffff, }, 12 },
+	/* F053 Í latin capital letter i with acute */
+	{ { 0xf7ff, 0xefff, 0xffff, 0x00ff, 0xefff, 0xefff, 0xefff, 0xefff, 0xefff, 0x00ff, 0xffff, }, 12 },
+	/* F054 Ï latin capital letter i with diaeresis */
+	{ { 0xffff, 0xbdff, 0xffff, 0x00ff, 0xefff, 0xefff, 0xefff, 0xefff, 0xefff, 0x00ff, 0xffff, }, 12 },
+	/* F055 Ü latin capital letter u with diaeresis */
+	{ { 0xffff, 0xddff, 0xffff, 0x7f7f, 0x7f7f, 0x7f7f, 0x7f7f, 0x7f7f, 0x9cff, 0xe3ff, 0xffff, }, 12 },
+	/* F056 Ñ latin capital letter n with tilde */
+	{ { 0xceff, 0xb1ff, 0xffff, 0x3f7f, 0x5f7f, 0x677f, 0x737f, 0x797f, 0x7d7f, 0x7e7f, 0xffff, }, 12 },
+	/* F057 Ç latin capital letter c with cedilla */
+	{ { 0xe0ff, 0x9f7f, 0x7f7f, 0x7fff, 0x7fff, 0x7fff, 0x7fff, 0x7f7f, 0x9f7f, 0xe0ff, 0xf9ff, }, 12 },
+	/* F058 ¿ inverted question mark */
+	{ { 0xffff, 0xdfff, 0xffff, 0xdfff, 0xdfff, 0xbfff, 0x7fff, 0x7fff, 0x7bff, 0x7bff, 0x87ff, }, 8 },
+	/* F059 ¡ inverted exclamation mark */
+	{ { 0xffff, 0xdfff, 0xffff, 0xffff, 0xdfff, 0xdfff, 0xdfff, 0xdfff, 0xdfff, 0xdfff, 0xdfff, }, 5 },
+	/* F05A · middle dot */
+	{ { 0xffff, 0xffff, 0xffff, 0xffff, 0xffff, 0x3fff, 0x3fff, 0xffff, 0xffff, 0xffff, 0xffff, }, 4 },
+	/* F05B « left-pointing double angle quotation mark */
+	{ { 0xffff, 0xffff, 0xffff, 0xdbff, 0xb7ff, 0x6fff, 0xb7ff, 0xdbff, 0xffff, 0xffff, 0xffff, }, 8 },
+	/* F05C » right-pointing double angle quotation mark */
+	{ { 0xffff, 0xffff, 0xffff, 0x6fff, 0xb7ff, 0xdbff, 0xb7ff, 0x6fff, 0xffff, 0xffff, 0xffff, }, 8 },
+	/* F05D ( left parenthesis */
