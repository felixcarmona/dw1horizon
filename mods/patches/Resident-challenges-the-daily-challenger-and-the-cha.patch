From 634f98d5181f71e36e10ae55d4dc8be553c28f46 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Wed, 25 Nov 2026 14:57:59 +0000
Subject: [PATCH] Resident challenges: the daily challenger and the challenge
 fight's stats and bag

After the game is beaten, midnight (dailyPStatTrigger) picks one recruited resident of MOD_CHALLENGE's rows, not the
day before's and of a level at most the partner's, into a saved pstat (row + 1, 0 nobody), and clears the won and tried
flags. A battle the script arms through a scratch pstat gives every foe of that row's species, for each stat, the larger
of the partner's and the row's (the species sheet) plus a percent, at most 9999, and can empty the bag for the fight
(the bag comes back whole when it closes). Everything is read from MOD_CHALLENGE, written by tools/balance.py from
content/tables/resident-challenges.json; with the table empty nothing changes.
---
 include/dw/mod_rules.h   | 30 +++++++++++++++++++
 src/main/mod_feed.c      |  9 ++++--
 src/main/script_common.c | 64 ++++++++++++++++++++++++++++++++++++++++
 src/main/tamer.c         | 61 ++++++++++++++++++++++++++++++++++++++
 4 files changed, 161 insertions(+), 3 deletions(-)

diff --git a/include/dw/mod_rules.h b/include/dw/mod_rules.h
index a662d02..297f7a2 100644
--- a/include/dw/mod_rules.h
+++ b/include/dw/mod_rules.h
@@ -66,6 +66,36 @@ int32_t econPercent(int32_t slot);
 #define MOD_DAILY_CLEAR_MASK	6 /* ... with this mask */
 extern int16_t MOD_DAILY[MOD_DAILY_SIZE];
 
+/* resident challenges (postgame): MOD_CHALLENGE[], every slot -1 = off, written by tools/balance.py from
+ * content/tables/resident-challenges.json. At midnight, once the game is beaten, one recruited resident of the rows is
+ * written to the saved pstat MOD_CHALLENGE_VAR as row + 1 (0 = nobody) and the won and tried flags are cleared; the
+ * story does the rest. The pick is a shuffle bag: two saved pstats hold one bit per row already sent out this cycle.
+ * Stage rule 0: only residents whose level is at most the partner's can go, the partner's own level first, then the
+ * next one down; when every one that can go has gone the bag is emptied and a new cycle starts. Stage rule 1: any
+ * level, no order. Never the resident of the day before. A battle started while the scratch pstat MOD_CHALLENGE_ARMED
+ * is 1 is a challenge: every foe of the row's species gets, for each stat, the larger of the partner's times
+ * (100 + percent) / 100 and the row's (the species sheet) times (100 + sheet percent) / 100, at most 9999. */
+#define MOD_CHALLENGE_MODE	0 /* 0: max(partner + percent, sheet + sheet percent) */
+#define MOD_CHALLENGE_PERCENT	1 /* the partner's stats' bonus */
+#define MOD_CHALLENGE_NO_ITEMS	2 /* 1: the bag is empty in a challenge */
+#define MOD_CHALLENGE_STAGES	3 /* 0: level at most the partner's, own level first; 1: any level */
+#define MOD_CHALLENGE_VAR	4 /* saved pstat: today's challenger, row + 1 */
+#define MOD_CHALLENGE_WON	5 /* flag: won today */
+#define MOD_CHALLENGE_TRIED	6 /* flag: fought today */
+#define MOD_CHALLENGE_ARMED	7 /* scratch pstat: 1 = the next battle is the challenge (cleared by the battle) */
+#define MOD_CHALLENGE_USED	8 /* saved pstats: rows 1-8 sent out this cycle, one bit each */
+#define MOD_CHALLENGE_USED2	9 /* saved pstat: rows 9-16 */
+#define MOD_CHALLENGE_SHEET_PERCENT	10 /* the species sheet's bonus */
+#define MOD_CHALLENGE_NO_LATE	11 /* 1: no NORMAL late-game step (battleFormulas normal) in a challenge */
+#define MOD_CHALLENGE_ROWS	12 /* the first row: species, hp, mp, off, def, speed, brain */
+#define MOD_CHALLENGE_ROW	7
+#define MOD_CHALLENGE_MAX	16
+#define MOD_CHALLENGE_SIZE	(MOD_CHALLENGE_ROWS + MOD_CHALLENGE_ROW * MOD_CHALLENGE_MAX)
+extern int16_t MOD_CHALLENGE[MOD_CHALLENGE_SIZE];
+extern uint8_t MOD_CHALLENGE_NO_BAG; /* the bag is empty in this battle */
+void modChallengeDaily(void);
+void modChallengeBattle(int32_t count);
+
 /* a new game and a new partner: MOD_NEWGAME[], every slot -1 = the rule does not exist (modNewGame answers 0), written by tools/balance.py
  * from content/tables/new-game.json */
 #define MOD_NEWGAME_SIZE	78
diff --git a/src/main/mod_feed.c b/src/main/mod_feed.c
index 940a5cc..59ff967 100644
--- a/src/main/mod_feed.c
+++ b/src/main/mod_feed.c
@@ -4,6 +4,7 @@
  * feeding/refusal flow; opening the list never consumes it. Field Confirm belongs to map interaction.
  * The Square badge keeps the condition ring's original position, scale and animation.
  */
+#include <dw/mod_rules.h>
 #include <libgs.h>
 
 #include <dw/clock.h>
@@ -575,14 +576,14 @@ void modBagFilterForBattle(void)
 	if (MOD_BAG_HELD != 0) {
 		return;
 	}
-	MOD_BAG_HELD = 1;
+	MOD_BAG_HELD = MOD_CHALLENGE_NO_BAG ? 2 : 1; /* MOD (resident challenges): 2 = nothing shown */
 	n = 0;
 	for (i = 0; i < INVENTORY.size; i++) {
 		MOD_BAG_TYPES[i] = INVENTORY.types.array[i];
 		MOD_BAG_AMOUNTS[i] = INVENTORY.amounts.array[i];
 	}
 	for (i = 0; i < INVENTORY.size; i++) {
-		if (isBattleItem(MOD_BAG_TYPES[i])) {
+		if (MOD_BAG_HELD == 1 && isBattleItem(MOD_BAG_TYPES[i])) {
 			INVENTORY.types.array[n] = MOD_BAG_TYPES[i];
 			INVENTORY.amounts.array[n] = MOD_BAG_AMOUNTS[i];
 			INVENTORY.names.array[n] = n;
@@ -604,15 +605,17 @@ void modBagRestoreAfterBattle(void)
 	int32_t i;
 	int32_t n;
 	ItemId held;
+	int32_t shown;
 
 	if (MOD_BAG_HELD == 0) {
 		return;
 	}
+	shown = MOD_BAG_HELD == 1; /* 2: nothing was shown, the bag comes back as it was */
 	MOD_BAG_HELD = 0;
 	held = INVENTORY.types.array[INVENTORY_POINTER];
 	n = 0;
 	for (i = 0; i < INVENTORY.size; i++) {
-		if (isBattleItem(MOD_BAG_TYPES[i])) {
+		if (shown && isBattleItem(MOD_BAG_TYPES[i])) {
 			while ((n < INVENTORY.size) && (INVENTORY.types.array[n] == ITEM_NONE)) {
 				n++;
 			}
diff --git a/src/main/script_common.c b/src/main/script_common.c
index 735b36f..5b84dff 100644
--- a/src/main/script_common.c
+++ b/src/main/script_common.c
@@ -23,6 +23,7 @@
 #include <dw/params.h>
 #include <dw/pstat.h>
 #include <dw/script.h>
+#include <dw/trigger.h>
 #include <dw/sound.h>
 #include <dw/species.h>
 #include <dw/ui.h>
@@ -1427,6 +1428,68 @@ uint8_t getRecycleId(uint8_t value)
 
 int16_t MOD_DAILY[MOD_DAILY_SIZE] = { -1, -1, -1, -1, -1, -1, -1 };
 
+/* MOD (resident challenges): mod_rules.h */
+int16_t MOD_CHALLENGE[MOD_CHALLENGE_SIZE] = { [0 ... MOD_CHALLENGE_SIZE - 1] = -1 };
+
+/* can row i go out today, with the partner at that level and prev the row + 1 of yesterday's */
+/* the rows that can go out today: recruited, not yesterday's, of a level the stage rule allows, and (unless all)
+ * not yet sent out this cycle; with only, of that level alone */
+static int32_t modChallengeCan(int32_t i, int32_t prev, int32_t level, uint32_t used, int32_t only)
+{
+	int32_t type, own;
+
+	type = MOD_CHALLENGE[MOD_CHALLENGE_ROWS + MOD_CHALLENGE_ROW * i];
+	if (type <= 0 || i + 1 == prev || (used >> i & 1) || !isDigimonRecruited(type)) return 0;
+	if (MOD_CHALLENGE[MOD_CHALLENGE_STAGES] != 0) return 1;
+	own = DIGI_PARA(type).level;
+	return only ? own == level : own <= level;
+}
+
+void modChallengeDaily(void)
+{
+	int32_t i, count, pick, prev, level, only;
+	uint32_t used;
+
+	if (MOD_CHALLENGE[MOD_CHALLENGE_VAR] < 0 || MOD_CHALLENGE[MOD_CHALLENGE_WON] < 0 || MOD_CHALLENGE[MOD_CHALLENGE_TRIED] < 0 ||
+	    MOD_CHALLENGE[MOD_CHALLENGE_USED] < 0 || MOD_CHALLENGE[MOD_CHALLENGE_USED2] < 0) return;
+	prev = readPStat(MOD_CHALLENGE[MOD_CHALLENGE_VAR]);
+	writePStat(MOD_CHALLENGE[MOD_CHALLENGE_VAR], 0);
+	unsetTrigger(MOD_CHALLENGE[MOD_CHALLENGE_WON]);
+	unsetTrigger(MOD_CHALLENGE[MOD_CHALLENGE_TRIED]);
+	if (!isTriggerSet(TRIGGER_BEATEN_GAME_ONCE)) return;
+	used = readPStat(MOD_CHALLENGE[MOD_CHALLENGE_USED]) | readPStat(MOD_CHALLENGE[MOD_CHALLENGE_USED2]) << 8;
+	level = DIGI_PARA(PARTNER_ENTITY.digimonEntity.entity.type).level;
+	count = 0;
+	for (i = 0; i < MOD_CHALLENGE_MAX; i++) count += modChallengeCan(i, prev, level, used, 0);
+	if (!count) {
+		/* every one that can go has gone: a new cycle (yesterday's still stays home) */
+		used = 0;
+		for (i = 0; i < MOD_CHALLENGE_MAX; i++) count += modChallengeCan(i, prev, level, used, 0);
+		if (!count) {
+			writePStat(MOD_CHALLENGE[MOD_CHALLENGE_USED], 0);
+			writePStat(MOD_CHALLENGE[MOD_CHALLENGE_USED2], 0);
+			return;
+		}
+	}
+	/* the partner's own level first, then the next one down */
+	only = MOD_CHALLENGE[MOD_CHALLENGE_STAGES] == 0;
+	for (; level >= 0; level--) {
+		count = 0;
+		for (i = 0; i < MOD_CHALLENGE_MAX; i++) count += modChallengeCan(i, prev, level, used, only);
+		if (count || !only) break;
+	}
+	pick = randomLimit(count);
+	for (i = 0; i < MOD_CHALLENGE_MAX; i++) {
+		if (modChallengeCan(i, prev, level, used, only) && pick-- == 0) {
+			used |= 1 << i;
+			writePStat(MOD_CHALLENGE[MOD_CHALLENGE_VAR], i + 1);
+			break;
+		}
+	}
+	writePStat(MOD_CHALLENGE[MOD_CHALLENGE_USED], used & 0xff);
+	writePStat(MOD_CHALLENGE[MOD_CHALLENGE_USED2], used >> 8 & 0xff);
+}
+
 void dailyPStatTrigger(void)
 {
 	ScriptState *st;
@@ -1482,6 +1545,7 @@ void dailyPStatTrigger(void)
 			writePStat(MOD_DAILY[MOD_DAILY_CLEAR_PSTAT], v);
 		}
 	}
+	modChallengeDaily();
 }
 
 int32_t isPartnerBaby(void)
diff --git a/src/main/tamer.c b/src/main/tamer.c
index 65110dc..d60cd25 100644
--- a/src/main/tamer.c
+++ b/src/main/tamer.c
@@ -9,6 +9,8 @@
 #include <dw/anim.h>
 #include <dw/butterfly.h>
 #include <dw/clock.h>
+#include <dw/combat.h>
+#include <dw/mod_battle.h>
 #include <dw/dooa.h>
 #include <dw/eab.h>
 #include <dw/endi.h>
@@ -184,6 +186,8 @@ int32_t tickOpenChestTray(int32_t chestId);
 int32_t tickCloseChestTray(int32_t chestId);
 int32_t hasMove(int32_t moveId);
 int32_t isTriggerSet(uint16_t trigger);
+uint8_t readPStat(uint8_t index);
+void writePStat(uint8_t index, uint8_t value);
 extern int16_t TOURNAMENT_WINS;
 int32_t hasMedal(uint16_t medal);
 int32_t hasDigimonRaised(int32_t digimonId);
@@ -881,6 +885,57 @@ extern int8_t MOD_TFS_SAME_MAP; /* tfs_stream.c */
 void modResumeFieldMusic(void); /* sound_async.c */
 void tfsStreamHoldPrefetch(void); /* tfs_stream.c */
 
+/* MOD (resident challenges, mod_rules.h): a stat of a challenger */
+static int16_t modChallengeStat(int32_t partner, int32_t sheet)
+{
+	int32_t v;
+
+	v = partner * (100 + MOD_CHALLENGE[MOD_CHALLENGE_PERCENT]) / 100;
+	sheet = sheet * (100 + MOD_CHALLENGE[MOD_CHALLENGE_SHEET_PERCENT]) / 100;
+	if (v < sheet) v = sheet;
+	return v > 9999 ? 9999 : v;
+}
+
+uint8_t MOD_CHALLENGE_NO_BAG;
+static uint8_t modChallengeLateOff; /* NORMAL's late-game step was set aside for this battle */
+static int16_t modChallengeLateHP;
+
+/* the foes of a battle the script armed as a challenge take the stats of the rule; the bag empties if the rule says so */
+void modChallengeBattle(int32_t count)
+{
+	int32_t i, row, k;
+	int16_t *r;
+	Stats *s;
+	BaseStats *p;
+
+	MOD_CHALLENGE_NO_BAG = 0;
+	if (MOD_CHALLENGE[MOD_CHALLENGE_ARMED] < 0 || readPStat(MOD_CHALLENGE[MOD_CHALLENGE_ARMED]) != 1) return;
+	writePStat(MOD_CHALLENGE[MOD_CHALLENGE_ARMED], 0);
+	row = readPStat(MOD_CHALLENGE[MOD_CHALLENGE_VAR]);
+	if (row < 1 || row > MOD_CHALLENGE_MAX || MOD_CHALLENGE[MOD_CHALLENGE_MODE] != 0) return;
+	r = &MOD_CHALLENGE[MOD_CHALLENGE_ROWS + MOD_CHALLENGE_ROW * (row - 1)];
+	MOD_CHALLENGE_NO_BAG = MOD_CHALLENGE[MOD_CHALLENGE_NO_ITEMS] > 0;
+	if (MOD_CHALLENGE[MOD_CHALLENGE_NO_LATE] > 0) {
+		/* the challenger's stats are the rule's: no late-game HP and attack step, no late-game damage floor (both read
+		 * fromHp, 0 = none), on every difficulty; HARD keeps its own factors and floor */
+		modChallengeLateHP = MOD_BATTLE[MOD_BT_NORMAL_FROM_HP];
+		MOD_BATTLE[MOD_BT_NORMAL_FROM_HP] = 0;
+		modChallengeLateOff = 1;
+	}
+	p = &PARTNER_ENTITY.digimonEntity.stats.base;
+	for (i = 1; i <= count; i++) {
+		k = COMBAT_DATA_PTR->player.entityIds[i];
+		if (ENTITY_TABLE[k]->type != r[0]) continue;
+		s = &((DigimonEntity *)ENTITY_TABLE[k])->stats;
+		s->current.currentHP = s->base.hp = modChallengeStat(p->hp, r[1]);
+		s->current.currentMP = s->base.mp = modChallengeStat(p->mp, r[2]);
+		s->base.off = modChallengeStat(p->off, r[3]);
+		s->base.def = modChallengeStat(p->def, r[4]);
+		s->base.speed = modChallengeStat(p->speed, r[5]);
+		s->base.brain = modChallengeStat(p->brain, r[6]);
+	}
+}
+
 int8_t startBattle(int16_t instanceId)
 {
 	int8_t result;
@@ -895,8 +950,14 @@ int8_t startBattle(int16_t instanceId)
 	stopGameTime();
 
 	battleData = handleBattleStart(instanceId);
+	modChallengeBattle(battleData); /* MOD (resident challenges) */
 	loadBattleData(instanceId, battleData);
 	result = BTL_battleMain();
+	MOD_CHALLENGE_NO_BAG = 0;
+	if (modChallengeLateOff) { /* won, lost or fled: every other battle has the step again */
+		MOD_BATTLE[MOD_BT_NORMAL_FROM_HP] = modChallengeLateHP;
+		modChallengeLateOff = 0;
+	}
 
 	GAME_STATE = 0;
 
-- 
