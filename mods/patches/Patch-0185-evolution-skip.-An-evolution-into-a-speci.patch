From 8b67e083e6d7a9afb7aa10741cd37084b1af93d4 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Fri, 23 Oct 2026 21:18:10 +0000
Subject: [PATCH 185/189] Patch 0185: evolution skip. An evolution into a
 species raised before can be skipped with START (a START plate in the corner
 while it can): the loading waits end at once and the scene jumps to the
 evolution itself (model loaded, EVL_applyEvolution, its sounds), its shards,
 sparks and particles removed; state 3 restores the camera, palettes, map and
 music as always

---
 include/dw/evl.h     |   2 +
 src/btl/battle_hud.c |   1 +
 src/evl/evl.c        | 101 +++++++++++++++++++++++++++++++++++++++++++
 src/main/evl.c       |  14 +++++-
 4 files changed, 116 insertions(+), 2 deletions(-)

diff --git a/include/dw/evl.h b/include/dw/evl.h
index 61b9595d..9493764b 100644
--- a/include/dw/evl.h
+++ b/include/dw/evl.h
@@ -89,6 +89,8 @@ typedef struct {
 
 extern EvlSpark EVL_D_80068F84[];
 extern EvoSequenceData EVO_SEQUENCE_DATA;
+/* MOD (evolution skip, main evl.c): 1 the scene may be skipped (its species was raised before), 2 START asked for it */
+extern int8_t MOD_EVO_SKIP;
 
 extern EvoStatsGains EVOLUTION_STATS_GAINS[NUM_ORIGINAL_DIGIMON];
 extern EvolutionPath EVOLUTION_PATHS[NUM_EVOLVING_DIGIMON - 1];
diff --git a/src/btl/battle_hud.c b/src/btl/battle_hud.c
index f57f3735..710bece9 100644
--- a/src/btl/battle_hud.c
+++ b/src/btl/battle_hud.c
@@ -18,6 +18,7 @@
 #include <dw/model.h>
 #include <dw/params.h>
 #include <dw/script.h>
+#include <dw/sound.h>
 #include <dw/sjis.h>
 #include <dw/swap.h>
 #include <dw/lang.h>
diff --git a/src/evl/evl.c b/src/evl/evl.c
index a77800c7..f2d3af90 100644
--- a/src/evl/evl.c
+++ b/src/evl/evl.c
@@ -300,6 +300,96 @@ void EVL_resetSparks(void)
 	}
 }
 
+/* MOD (evolution skip): START (MOD_EVO_SKIP, main evl.c) jumps from any frame before state 3 to the end of state 2:
+ * what the scene does on the way (fades, camera, shards, sparks, flashes, sounds) is left out or removed, what the
+ * evolution needs is kept: the camera saved for state 3 (state 0's end), the new model loaded, EVL_applyEvolution
+ * (once) and its sounds. State 3 then restores the camera, palettes, entities, map and music as always, and state 4
+ * waits for the new form's animation. */
+static void EVL_modSkipToEnd(EvoSequenceData *data)
+{
+	int32_t i;
+
+	if (data->state == 0) {
+		EVL_D_800688E8 = GS_VIEWPOINT;
+		MAIN_D_801351E4 = DRAWING_OFFSET_X;
+		MAIN_D_801351E8 = DRAWING_OFFSET_Y;
+		MAIN_D_801351EC = VIEWPORT_DISTANCE;
+		loadMMDAsync(data->digimonId, 3, MAIN_D_801349E4, &data->modelData, (uint8_t *)&data->hasFinishedLoading);
+	}
+	stopSound();
+	for (i = 0; i < 16; i++) {
+		if (EVL_D_80068F84[i].bone != -1) {
+			removeObject(0x605, i);
+			EVL_D_80068F84[i].bone = -1;
+		}
+	}
+	for (i = 0; i < 30; i++) {
+		if (MAIN_D_80135208[i].timer >= 0) {
+			removeObject(0x604, i);
+			MAIN_D_80135208[i].timer = -1;
+		}
+	}
+	EVL_releaseAllParticles();
+	PARTNER_WIREFRAME_TOTAL = 0x10;
+	for (i = 0; i < 0x28; i++) {
+		PARTNER_WIREFRAME_SUB[i] = 0x10;
+	}
+	if (data->state != 2 || data->timer <= 0x11c) { /* not applied yet */
+		while (data->hasFinishedLoading != 0) {
+			tickFileReadQueue(0);
+		}
+		EVL_applyEvolution(ENTITY_TABLE[1], &PARTNER_ENTITY.digimonEntity.stats, data->para, data->evoTarget);
+		waitForSoundBufferLoading(3);
+		data->partner = (PartnerEntity *)((uint32_t)&PARTNER_ENTITY);
+		startAnimation(&PARTNER_ENTITY.digimonEntity.entity, 0);
+	}
+	data->state = 3;
+	MOD_EVO_SKIP = 0;
+}
+
+/* the hint: "START" on a plate in the bottom right corner, in the digital clock's style (3x5 letters, each row 3
+ * bits, bit 2 the left column) */
+static const uint8_t EVL_START_GLYPHS[5][5] = {
+	{ 7, 4, 7, 1, 7 }, /* S */
+	{ 7, 2, 2, 2, 2 }, /* T */
+	{ 2, 5, 7, 5, 5 }, /* A */
+	{ 6, 5, 6, 5, 5 }, /* R */
+	{ 7, 2, 2, 2, 2 }, /* T */
+};
+
+static void EVL_addHintRect(int32_t x, int32_t y, int32_t w, int32_t h, int32_t r, int32_t g, int32_t b, int32_t z)
+{
+	POLY_F4 *p;
+
+	p = (POLY_F4 *)GsGetWorkBase();
+	SetPolyF4(p);
+	setRGB0(p, r, g, b);
+	setXYWH(p, x, y, w, h);
+	AddPrim(ACTIVE_ORDERING_TABLE->org + z, p++);
+	GsSetWorkBase((PACKET *)p);
+}
+
+static void EVL_renderSkipHint(void)
+{
+	int32_t x = 0x80;
+	int32_t y = 0x60;
+	int32_t i;
+	int32_t row;
+	int32_t col;
+
+	EVL_addHintRect(x, y, 23, 9, 0x62, 0xB4, 0xF6, 6);
+	EVL_addHintRect(x + 1, y + 1, 21, 7, 0x18, 0x18, 0x18, 5);
+	for (i = 0; i < 5; i++) {
+		for (row = 0; row < 5; row++) {
+			for (col = 0; col < 3; col++) {
+				if (EVL_START_GLYPHS[i][row] & (4 >> col)) {
+					EVL_addHintRect(x + 2 + i * 4 + col, y + 2 + row, 1, 1, 0xF0, 0xF0, 0xF0, 4);
+				}
+			}
+		}
+	}
+}
+
 void EVL_tickEvoSequence(int32_t instanceId)
 {
 	int32_t i;
@@ -337,6 +427,14 @@ void EVL_tickEvoSequence(int32_t instanceId)
 		startAnimation(&PARTNER_ENTITY.digimonEntity.entity, 1);
 	}
 
+	if (MOD_EVO_SKIP == 1 && ((POLLED_INPUT & ~POLLED_INPUT_PREVIOUS) & 0x800)) {
+		MOD_EVO_SKIP = 2; /* MOD (evolution skip) */
+	}
+	if (MOD_EVO_SKIP == 2 && data->state < 3) {
+		EVL_modSkipToEnd(data);
+		partner = data->partner;
+	}
+
 	switch (data->state) {
 	case 0:
 		if (frame < 0x20) {
@@ -548,6 +646,9 @@ shards:
 
 void EVL_renderEvoSequence(void)
 {
+	if (MOD_EVO_SKIP == 1 && EVO_SEQUENCE_DATA.state < 3) {
+		EVL_renderSkipHint(); /* MOD (evolution skip) */
+	}
 }
 
 void EVL_fadeClutBank0(int16_t *srcClut, void *entity, int16_t *dstClut, int32_t startFrame, int32_t endFrame, int32_t frame)
diff --git a/src/main/evl.c b/src/main/evl.c
index 9abcf15a..bc762c16 100644
--- a/src/main/evl.c
+++ b/src/main/evl.c
@@ -17,6 +17,12 @@ void isSoundLoaded();
 void loadVLALL();
 
 int8_t IS_LOAD_EVL_COMPLETE;
+/* MOD (evolution skip): an evolution into a species raised before can be skipped with START, from the start of the
+ * scene; the loading waits end at once, and the EVL overlay jumps to the evolution itself (EVL_modSkipToEnd) */
+int8_t MOD_EVO_SKIP;
+extern uint32_t POLLED_INPUT;
+extern uint32_t POLLED_INPUT_PREVIOUS;
+int32_t hasDigimonRaised(int32_t digimonId);
 
 EvoSequenceData EVO_SEQUENCE_DATA;
 
@@ -31,10 +37,13 @@ void tickEvoSequenceLoading(int32_t instanceId)
 	EvoSequenceData *data;
 
 	data = &EVO_SEQUENCE_DATA;
+	if (MOD_EVO_SKIP == 1 && ((POLLED_INPUT & ~POLLED_INPUT_PREVIOUS) & 0x800)) {
+		MOD_EVO_SKIP = 2;
+	}
 
 	switch (data->state) {
 	case 0:
-		if ((evoSequenceAlwaysTrue(500) == 1) && (data->timer > 55)) {
+		if ((evoSequenceAlwaysTrue(500) == 1) && (data->timer > 55 || MOD_EVO_SKIP == 2)) {
 			data->state = 1;
 			data->timer = 0;
 			startAnimation(&PARTNER_ENTITY.digimonEntity.entity, 1);
@@ -42,7 +51,7 @@ void tickEvoSequenceLoading(int32_t instanceId)
 		}
 		break;
 	case 1:
-		if ((data->timer > 55) && (IS_LOAD_EVL_COMPLETE == 0)) {
+		if ((data->timer > 55 || MOD_EVO_SKIP == 2) && (IS_LOAD_EVL_COMPLETE == 0)) {
 			removeObject(0x809, instanceId);
 			stopBGM();
 			EVL_initEvoSequence();
@@ -93,6 +102,7 @@ int16_t isInitialized;
 	data->evoTarget = target;
 	data->heightFactor = (DIGI_PARA(data->digimonId).height << 12) /
 			     DIGI_PARA(partner->digimonEntity.entity.type).height;
+	MOD_EVO_SKIP = hasDigimonRaised(data->digimonId) ? 1 : 0;
 
 	startAnimation(&PARTNER_ENTITY.digimonEntity.entity, 0);
 	stopSound();
