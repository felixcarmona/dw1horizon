 }
 
+/* the evolution's cancel (EVL overlay, src/evl/evl.c): bit 0 says the evolution that is starting came from the hours
+   and the requirements (or is the Rookie's fallback) and may be cancelled; bit 1 that one was cancelled, so none is
+   offered again until the partner has slept. The hint's line lives here, where the language's text is switched */
+int8_t MOD_EVO_CANCEL;
+char MOD_EVO_CANCEL_TEXT[] = QOL_STR_EVO_CANCEL;
+
 /* the tallies' skip hint (patch 0333): "Press × to skip" in a row of its own at the bottom of the box that counts (the
    gym's stats box, the battle's bits box), under a divider like the battle box's. The line is drawn once into a row of
    the text area when the box opens, its button in the colour of the button that confirms: × blue (6), with JAPANESE
diff --git a/src/main/partner.c b/src/main/partner.c
index d37aa0b..b0f2e71 100644
--- a/src/main/partner.c
+++ b/src/main/partner.c
@@ -25,6 +25,7 @@
 #include <dw/mod_options.h>
 #include <dw/species.h>
 #include <dw/screen.h>
+#include <dw/mod_qol.h>
 
 extern int32_t HAS_BUTTERFLY;
 extern int32_t BUTTERFLY_ID;
@@ -323,6 +324,7 @@ void partnerTickSleep(void)
 		if (FADE_OUT_CURRENT > 39) {
 			sleepRegen();
 			handleSleeping();
+			MOD_EVO_CANCEL = 0; /* MOD (evolution cancel): a cancelled evolution is offered again after the night */
 			if (UI_BOX_DATA[0].state == 0) {
 				CHECKED_MEMORY_CARD = 0x10;
 				if ((MEMORY_CARD_ID == -1) ||
@@ -779,6 +781,7 @@ void partnerTickEvolving(void)
 		if (value == -1) {
 			startGameTime();
 			EVOLUTION_TARGET = -1;
+			MOD_EVO_CANCEL &= ~MOD_EVO_CANCEL_ALLOWED; /* MOD (evolution cancel) */
 			loadMapSounds(getMapSoundId(CURRENT_SCREEN));
 			checkShopMap(CURRENT_SCREEN);
 			checkArenaMap(CURRENT_SCREEN);
diff --git a/src/main/partner_impl.c b/src/main/partner_impl.c
index 150bdbd..2eb98b5 100644
--- a/src/main/partner_impl.c
+++ b/src/main/partner_impl.c
