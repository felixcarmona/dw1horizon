From 30fa823a3a1666029504e97f58c40ca096b00e2c Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Wed, 25 Nov 2026 12:43:49 +0000
Subject: [PATCH] New Game Plus: the save machine starts the adventure again,
 keeping the chart, medals and cards

With pstat 126 set, openSaveMachine builds a new game from the one being played (modNewGamePlusReset) and
leaves the world through MOD_CHEATS_TRANSITION 3 into the new-game path. The raised Digimon, medals, cups,
tournament counters, fish, curling cups, cards, techniques learned, tamer level, play time, tamer look and battle registrations
carry over; trigger 642 replaces the game beaten for the save machine.
---
 config/us/overlay.ld |  1 +
 src/main/main.c      | 12 +++++++
 src/main/main_menu.c | 82 +++++++++++++++++++++++++++++++++++++++++---
 3 files changed, 91 insertions(+), 4 deletions(-)

diff --git a/config/us/overlay.ld b/config/us/overlay.ld
index 1e38dd22..6a175461 100644
--- a/config/us/overlay.ld
+++ b/config/us/overlay.ld
@@ -885,6 +885,7 @@ SECTIONS
 				.text.getSaveFileBytes
 				.text.getSaveVersion
 				.text.initializeDefaultSavegame
+				.text.modNewGamePlusReset
 				.text.isExtensionValid
 				.text.isMoveAbsent
 				.text.loadSaveCopy
diff --git a/src/main/main.c b/src/main/main.c
index bfcd0302..3fa9d0df 100644
--- a/src/main/main.c
+++ b/src/main/main.c
@@ -3605,10 +3605,22 @@ int32_t main(void)
 		if (MOD_CHEATS_TRANSITION) {
 			partnerId = MOD_CHEATS_TRANSITION;
 			MOD_CHEATS_TRANSITION = 0;
+			if (partnerId == 3) { /* MOD (New Game Plus): the script waits while the screen goes black */
+				fadeToBlack(0x28);
+				while (FADE_OUT_CURRENT < 0x28) {
+					gameLoop();
+				}
+			}
 			modCheatsCleanup();
 			cleanupGame();
 			finalizeMusic();
 			if (partnerId == 1) { MAIN_STATE = 1; initializeMusic(); goto cheats_loaded; }
+			if (partnerId == 3) { /* MOD (New Game Plus): the new game's scene, as from the title */
+				MAIN_STATE = 0;
+				loadStackedTIMFile(MAIN_D_8012CE8C);
+				initializeMusic();
+				goto cheats_loaded;
+			}
 			goto cheats_title;
 		}
 		cleanupGame();
diff --git a/src/main/main_menu.c b/src/main/main_menu.c
index b1d5ca37..abde73d9 100644
--- a/src/main/main_menu.c
+++ b/src/main/main_menu.c
@@ -475,6 +475,7 @@ int32_t createByteSum(uint8_t *data, int32_t len);
 void appendWideDigit(int32_t digit, char **dst, int32_t *started);
 #endif
 void openSaveMachine(void);
+void modNewGamePlusReset(void);
 int32_t tickSaveMachine(void);
 void awardMachinedramonData();
 void gameClearSave();
@@ -4307,9 +4308,21 @@ int32_t modNewGame(int32_t slot)
 	return MOD_NEWGAME[slot] > 0 ? MOD_NEWGAME[slot] : 0;
 }
 
+/*
+ * MOD (New Game Plus): 1 while modNewGamePlusReset builds the new game from the one being played.
+ * The triggers that carry over: the cups won (15-36), the medals (364-383 and 641) and the Digimon ever raised
+ * (512-574, 582 and 649). The game beaten (50) starts clear, so the story runs whole again; trigger 642 takes its
+ * place for the save machine, which keeps the option from then on.
+ */
+static int32_t modNgPlus;
+extern int32_t MOD_CHEATS_TRANSITION;
+#define NG_PLUS_UNLOCKED 642 /* the island was saved in an earlier run: the save machine keeps the option */
+#define NG_PLUS_KEPT(t) (((t) >= 15 && (t) <= 36) || ((t) >= 364 && (t) <= 383) || ((t) >= 512 && (t) <= 574) || \
+			 (t) == 582 || (t) == 641 || (t) == NG_PLUS_UNLOCKED || (t) == TRIGGER_RAISED_MYOTISMON)
+
 void initializeDefaultSavegame(void)
 {
-	resetSpeciesFlags(); /* MOD (scale) */
+	if (!modNgPlus) resetSpeciesFlags(); /* MOD (scale) */
 	InventoryTable defaultInventoryCounts;
 	InventoryTable defaultInventoryItems;
 	SavegamePayload *savegame;
@@ -4318,7 +4331,8 @@ void initializeDefaultSavegame(void)
 
 	savegame = &SAVE_FILE.saves[0];
 	cursor = (uint8_t *)savegame;
-	for (i = 0; i < 0xF00; i++) {
+	/* MOD (New Game Plus): the battle registrations, from 0x500 on, stay */
+	for (i = 0; i < (modNgPlus ? 0x500 : 0xF00); i++) {
 		*cursor++ = 0;
 	}
 	savegame->mainState = 0;
@@ -4357,6 +4371,57 @@ void initializeDefaultSavegame(void)
 		savegame->inventory.names.array[i] = i;
 	}
 	savegame->inventory.size = 30;
+	if (modNgPlus) { /* MOD (New Game Plus): what the tamer keeps */
+		ScriptState *live = SCRIPT_STATE_PTR;
+		ScriptState *saved = (ScriptState *)savegame->scriptState;
+		int32_t t;
+
+		for (i = 0; i < NUM_DIGIMON / 8; i++) {
+			SPECIES_RECRUITED_BITS[i] = 0;
+		}
+		memcpy(savegame->playerName, DIGIMON_NAME(0), 0x14);
+		savegame->tamerLevel = TAMER_ENTITY.tamerLevel;
+		savegame->raisedCount = TAMER_ENTITY.raisedCount < 99 ? TAMER_ENTITY.raisedCount + 1 : 99;
+		savegame->playtimeFrames = PLAYTIME_FRAMES;
+		savegame->playtimeHours = PLAYTIME_HOURS;
+		savegame->playtimeMinutes = PLAYTIME_MINUTES;
+		savegame->tournamentsWon = TOURNAMENTS_WON;
+		savegame->tournamentWins = TOURNAMENT_WINS;
+		savegame->tournamentsLost = TOURNAMENTS_LOST;
+		savegame->partnerPara.fishCaught = PARTNER_PARA.fishCaught;
+		memcpy(saved->cards, live->cards, sizeof(saved->cards));
+		memcpy(savegame->partnerData, &PARTNER_ENTITY.learnedMoves, 0x10); /* the techniques learned */
+		for (t = 15; t <= TRIGGER_RAISED_MYOTISMON; t++) {
+			if (NG_PLUS_KEPT(t)) {
+				saved->triggers[t >> 3] |= live->triggers[t >> 3] & (1 << (t & 7));
+			}
+		}
+		saved->triggers[NG_PLUS_UNLOCKED >> 3] |= 1 << (NG_PLUS_UNLOCKED & 7);
+		saved->pstats[7] = live->pstats[7]; /* the curling cups won */
+	}
+}
+
+/*
+ * MOD (New Game Plus): the save machine's restart (openSaveMachine with pstat 126 set). The game being played
+ * becomes a new game in RAM: story, city, partner, bag and bits as a new game has them; the chart, the medals,
+ * the cups, the cards, the techniques learned, the tamer (name, look, level, play time), the fish count and the
+ * battle registrations stay. Nothing is written to the card: the next save does that.
+ */
+void modNewGamePlusReset(void)
+{
+	int32_t i;
+
+	modNgPlus = 1;
+	initializeDefaultSavegame();
+	loadSavegame(&SAVE_FILE.saves[0]);
+	modNgPlus = 0;
+	for (i = 0; i < SCRIPT_NUM_WREGS; i++) {
+		SCRIPT_STATE_PTR->wregs[i] = 0;
+	}
+	for (i = 35; i < 256; i++) { /* the unsaved pstats, as a boot leaves them */
+		SCRIPT_STATE_PTR->pstats[i] = 0;
+	}
+	MOD_SWAP_FROM = MOD_SWAP_TO = 0;
 }
 
 char *_strncpy(char *dst, char *src, int32_t n)
@@ -4444,7 +4509,7 @@ void loadSavegame(SavegamePayload *savegame)
 	int32_t i;
 
 	modForgetGroundPicked(); /* A missing new record, in any old layout, means no pickups today. */
-	memset(MOD_TAMER_STATE, 0, TAMER_STATE_SIZE); /* MOD (tamer looks): and the original tamer */
+	if (!modNgPlus) memset(MOD_TAMER_STATE, 0, TAMER_STATE_SIZE); /* MOD (tamer looks): and the original tamer */
 
 	SAVED_STATE.playerPos = savegame->tamerPosition;
 	SAVED_STATE.money = savegame->money;
@@ -4498,7 +4563,7 @@ void loadSavegame(SavegamePayload *savegame)
 	TOURNAMENT_WINS = savegame->tournamentWins;
 	TOURNAMENTS_LOST = savegame->tournamentsLost;
 	memcpy(SCRIPT_STATE_PTR, savegame->scriptState, 0x17C);
-	memset(MOD_CARD_EXTRA, 0, sizeof(MOD_CARD_EXTRA));
+	if (!modNgPlus) memset(MOD_CARD_EXTRA, 0, sizeof(MOD_CARD_EXTRA));
 	for (i = 0; i < 6; i++) {
 		MOD_CARD_STOCK[i] = SCRIPT_STATE_PTR->smth[i] == 255 ? CARD_NONE : SCRIPT_STATE_PTR->smth[i];
 	}
@@ -5965,6 +6030,11 @@ void modMenuVsBattle(int32_t trial)
 void openSaveMachine(void)
 {
 	loadMenuOverlay();
+	if (readPStat(126)) { /* MOD (New Game Plus): asked by the save machine's script */
+		modNewGamePlusReset();
+		MOD_CHEATS_TRANSITION = 3;
+		return;
+	}
 	CHECKED_MEMORY_CARD = 0x10;
 	CURRENT_MENU = -2;
 	MAIN_STATE = 1;
@@ -5996,6 +6066,10 @@ void modReplayMainMenu(void)
 
 int32_t tickSaveMachine(void)
 {
+	if (MOD_CHEATS_TRANSITION == 3) { /* MOD (New Game Plus): no menu was opened */
+		closeMenuOverlay();
+		return 1;
+	}
 	tickMainMenu();
 	modMainMenuScrollBefore = SAVE_SLOT_SCROLL_TENTHS;
 	renderMainMenu();
-- 
2.55.0

