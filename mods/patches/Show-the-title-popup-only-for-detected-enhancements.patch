From c2796bbfe0f268a3c4ce931148685edf48c722c6 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Sun, 8 Nov 2026 22:38:38 +0000
Subject: [PATCH] Show the title popup only for detected enhancements

---
 config/us/overlay.ld     |  5 ++-
 src/main/main_menu.c     | 89 ++++++++++++++++++++++------------------
 text/main/main_menu.yaml | 21 ++++++----
 3 files changed, 63 insertions(+), 52 deletions(-)

diff --git a/config/us/overlay.ld b/config/us/overlay.ld
index 516e6124..c50870ad 100644
--- a/config/us/overlay.ld
+++ b/config/us/overlay.ld
@@ -321,8 +321,7 @@ SECTIONS
             /* Detection display only runs while the title owns EVL and MENU. */
             BUILD_DIR/src/main/main_menu.c.o(
                 .text.modNoticeDraw* .text.modNoticeRender* .text.modNoticeString*
-                .text.modNoticePercent* .rodata.modNoticeDraw*
-                .rodata.MOD_NOTICE_CALIBRATION .rodata.widths*
+                .rodata.modNoticeDraw*
                 .bss.MOD_NOTICE_CACHE
             );
             . = ALIGN(., 4);
@@ -909,6 +908,8 @@ SECTIONS
 				.text.writeSaveFile
 				.text.writeSavegame
 			);
+            /* Localized enhancement-popup text; title callbacks also own MENU. */
+            BUILD_DIR/src/main/main_menu.c.o(.data.MOD_NOTICE_TEXT);
 			. = ALIGN(., 4);
 			/* their switch tables and literals, which only they read */
 			BUILD_DIR/src/main/main_menu.c.o(.rodata.tickMainMenu .rodata.renderMainMenu .rodata.drawMainMenuStrings
diff --git a/src/main/main_menu.c b/src/main/main_menu.c
index 4626c4dd..002875ed 100644
--- a/src/main/main_menu.c
+++ b/src/main/main_menu.c
@@ -4947,46 +4947,42 @@ void modBootOptions(void)
 	modNoticeProbe();
 }
 
-/* MOD (detected settings): polling counts calibrated in docs/reference/frame-rate.md.
- * RAM stays boot-only. The title redraws when the selector's latest reading or mode changes.
- * Drawing, calibration and scratch live in the title overlay; the boot probe stays resident.
+/* MOD (enhancement popup): keep the earlier two-column notice, but only
+ * show detected enhancements. A plain 2 MB / normal-CPU boot stays clear.
+ * Drawing and scratch stay in the title overlay; boot probes stay resident.
  */
 #define MOD_NOTICE_NO_RAM	1
 #define MOD_NOTICE_SLOW_CPU	2
 #define MOD_NOTICE_LEFT		-148
 #define MOD_NOTICE_TOP		12
 #define MOD_NOTICE_WIDTH	296
-#define MOD_NOTICE_HEIGHT	66
-#define MOD_NOTICE_STRS		5
-#define MOD_NOTICE_V(i)		((i) * 0xC) /* stop before the version's row at 0x3C */
+#define MOD_NOTICE_HEIGHT	72
+#define MOD_NOTICE_STRS		6
+#define MOD_NOTICE_NAME_W	0x96
+#define MOD_NOTICE_STATE_W	0x78
+#define MOD_NOTICE_V(i)		(((i) + ((i) == 5)) * 0xC) /* leave the version's row at 0x3C */
 void modPlateRect(int32_t x, int32_t y, int32_t w, int32_t h, int32_t r, int32_t g, int32_t b, int32_t z);
 void renderString(int32_t color, int16_t x, int16_t y, int16_t width, int16_t height, int16_t u, int16_t v, int32_t depth, int32_t shadow);
 
 int32_t MOD_CPU_SPINS;
 static int32_t MOD_NOTICE;
-/* One object above the compiler's eight-byte small-data cutoff, so it can
- * live in the title overlay without gp-relative accesses to resident RAM. */
+/* Keep the object above the eight-byte small-data cutoff for overlay storage. */
 static struct {
 	int32_t spins, mode;
 	uint8_t widths[MOD_NOTICE_STRS];
 } MOD_NOTICE_CACHE;
-static const int16_t MOD_NOTICE_CALIBRATION[][2] = {{3801, 100}, {7389, 200}, {9303, 250}, {10977, 300}};
-
-static int32_t modNoticePercent(int32_t spins)
-{
-	int32_t i, percent;
-	const int16_t *lo, *hi;
+/* Keep localized bytes in MENU, which remains loaded alongside the title UI.
+ * One aggregate avoids gp-relative small-data accesses for the short labels.
+ * sizeof includes the shared language padding supplied by gen_text. */
+static struct {
+	char head[sizeof(MOD_NOTICE_STR_HEAD1)], fps[sizeof(MOD_NOTICE_STR_FPS)];
+	char ram[sizeof(MOD_NOTICE_STR_RAM)], cpu[sizeof(MOD_NOTICE_STR_CPU)];
+	char missing[sizeof(MOD_NOTICE_STR_MISSING)], ready[sizeof(MOD_NOTICE_STR_READY)];
+} MOD_NOTICE_TEXT = {
+	MOD_NOTICE_STR_HEAD1, MOD_NOTICE_STR_FPS, MOD_NOTICE_STR_RAM,
+	MOD_NOTICE_STR_CPU, MOD_NOTICE_STR_MISSING, MOD_NOTICE_STR_READY,
+};
 
-	/* Stay within the measured range, including a corrupt/restored reading. */
-	if (spins <= 3801) return 100;
-	if (spins >= 10977) return 300;
-	for (i = 1; i < 3 && spins > MOD_NOTICE_CALIBRATION[i][0]; i++) { }
-	lo = MOD_NOTICE_CALIBRATION[i - 1];
-	hi = MOD_NOTICE_CALIBRATION[i];
-	percent = lo[1] + (spins - lo[0]) * (hi[1] - lo[1]) / (hi[0] - lo[0]);
-	percent = ((percent + 12) / 25) * 25;
-	return percent;
-}
 
 /* Keep this loop identical at boot and during idle presentation waits. */
 int32_t modCpuProbe(void)
@@ -5017,28 +5013,32 @@ void modNoticeDraw(void)
 {
 	RECT rect;
 	int32_t i, mode;
-	char ram[32], cpu[32], fps[32];
+	char fps[32];
 	char *text[MOD_NOTICE_STRS];
-	static const int16_t widths[MOD_NOTICE_STRS] = {254, 254, 80, 104, 64};
 
+	if (MOD_NOTICE == (MOD_NOTICE_NO_RAM | MOD_NOTICE_SLOW_CPU)) {
+		return;
+	}
 	MOD_NOTICE_CACHE.spins = MOD_CPU_SPINS;
 #if FPS != 20
 	MOD_NOTICE_CACHE.mode = modFrameRateLevel();
 #else
 	MOD_NOTICE_CACHE.mode = 0;
 #endif
-	sprintf(ram, MOD_NOTICE_STR_RAM, MOD_NOTICE & MOD_NOTICE_NO_RAM ? 2 : 8);
-	sprintf(cpu, MOD_NOTICE_STR_CPU, modNoticePercent(MOD_NOTICE_CACHE.spins));
-	sprintf(fps, MOD_NOTICE_STR_FPS, MOD_NOTICE_CACHE.mode == 2 ? 60 : MOD_NOTICE_CACHE.mode == 1 ? 30 : 20);
-	text[0] = MOD_NOTICE_STR_HEAD1;
-	text[1] = MOD_NOTICE_STR_HEAD2;
-	text[2] = ram;
-	text[3] = cpu;
-	text[4] = fps;
-	setRECT(&rect, 0, 0, 0x100, MOD_NOTICE_V(MOD_NOTICE_STRS));
+	sprintf(fps, MOD_NOTICE_TEXT.fps, MOD_NOTICE_CACHE.mode == 2 ? 60 : MOD_NOTICE_CACHE.mode == 1 ? 30 : 20);
+	text[0] = MOD_NOTICE_TEXT.head;
+	text[1] = fps;
+	text[2] = MOD_NOTICE_TEXT.ram;
+	text[3] = MOD_NOTICE_TEXT.cpu;
+	text[4] = MOD_NOTICE_TEXT.missing;
+	text[5] = MOD_NOTICE_TEXT.ready;
+	/* Clear both text spans without erasing the version between them. */
+	setRECT(&rect, 0, 0, 0x100, 0x3C);
+	clearTextSubArea(&rect);
+	setRECT(&rect, 0, MOD_NOTICE_V(5), 0x100, 0xC);
 	clearTextSubArea(&rect);
 	for (i = 0; i < MOD_NOTICE_STRS; i++) {
-		mode = fitStringMode(text[i], widths[i]);
+		mode = fitStringMode(text[i], i < 2 ? 0xFE : i < 4 ? MOD_NOTICE_NAME_W : MOD_NOTICE_STATE_W);
 		drawStringMode(text[i], 0, MOD_NOTICE_V(i), mode);
 		DrawSync(0);
 		mode = measureStringMode(text[i], mode) + 1;
@@ -5053,6 +5053,11 @@ static void modNoticeString(int32_t color, int32_t x, int32_t y, int32_t i)
 
 void modNoticeRender(void)
 {
+	int32_t i, missing;
+
+	if (MOD_NOTICE == (MOD_NOTICE_NO_RAM | MOD_NOTICE_SLOW_CPU)) {
+		return;
+	}
 	if (MOD_NOTICE_CACHE.spins != MOD_CPU_SPINS
 #if FPS != 20
 	    || MOD_NOTICE_CACHE.mode != modFrameRateLevel()
@@ -5063,11 +5068,13 @@ void modNoticeRender(void)
 	modPlateRect(MOD_NOTICE_LEFT, MOD_NOTICE_TOP - 0x78, MOD_NOTICE_WIDTH, MOD_NOTICE_HEIGHT, 0x46, 0xBE, 0xEB, 2);
 	modPlateRect(MOD_NOTICE_LEFT + 1, MOD_NOTICE_TOP - 0x77, MOD_NOTICE_WIDTH - 2, MOD_NOTICE_HEIGHT - 2, 8, 10, 0x38, 1);
 	modNoticeString(4, -MOD_NOTICE_CACHE.widths[0] / 2, MOD_NOTICE_TOP + 8, 0);
-	modNoticeString(4, -MOD_NOTICE_CACHE.widths[1] / 2, MOD_NOTICE_TOP + 22, 1);
-	/* Separate crops and fixed columns include a pixel for each shadow. */
-	modNoticeString(MOD_NOTICE & MOD_NOTICE_NO_RAM ? 6 : 7, -136, MOD_NOTICE_TOP + 48, 2);
-	modNoticeString(MOD_CPU_SPINS >= MOD_CPU_SPINS_FAST ? 7 : 6, -48, MOD_NOTICE_TOP + 48, 3);
-	modNoticeString(MOD_NOTICE_CACHE.mode == 2 ? 7 : 6, 136 - MOD_NOTICE_CACHE.widths[4], MOD_NOTICE_TOP + 48, 4);
+	modNoticeString(4, -MOD_NOTICE_CACHE.widths[1] / 2, MOD_NOTICE_TOP + 20, 1);
+	for (i = 0; i < 2; i++) {
+		missing = (MOD_NOTICE >> i) & 1;
+		modNoticeString(0, MOD_NOTICE_LEFT + 12, MOD_NOTICE_TOP + 38 + i * 14, 2 + i);
+		modNoticeString(missing ? 6 : 7, MOD_NOTICE_LEFT + MOD_NOTICE_WIDTH - 12 - MOD_NOTICE_CACHE.widths[5 - missing],
+				MOD_NOTICE_TOP + 38 + i * 14, 5 - missing);
+	}
 }
 
 static void prepareSaveFile(int32_t fromRam)
diff --git a/text/main/main_menu.yaml b/text/main/main_menu.yaml
index 174a191a..837c416f 100644
--- a/text/main/main_menu.yaml
+++ b/text/main/main_menu.yaml
@@ -378,17 +378,20 @@ MOD_OPTIONS:
       ja: "NORMAL"
       en_us: "NORMAL"
     MOD_NOTICE_STR_HEAD1:
-      ja: "CPU 250%: 60 FPS"
-      en_us: "CPU 250%: 60 FPS"
-    MOD_NOTICE_STR_HEAD2:
-      ja: "8 MB: Chinese only"
-      en_us: "8 MB: Chinese only"
+      ja: "Detected emulator enhancements"
+      en_us: "Detected emulator enhancements"
     MOD_NOTICE_STR_RAM:
-      ja: "RAM %d MB"
-      en_us: "RAM %d MB"
+      ja: "8 MB RAM"
+      en_us: "8 MB RAM"
     MOD_NOTICE_STR_CPU:
-      ja: "CPU ～%d％"
-      en_us: "CPU ～%d％"
+      ja: "CPU overclock at 250%"
+      en_us: "CPU overclock at 250%"
+    MOD_NOTICE_STR_MISSING:
+      ja: "NOT DETECTED"
+      en_us: "NOT DETECTED"
+    MOD_NOTICE_STR_READY:
+      ja: "READY"
+      en_us: "READY"
     MOD_NOTICE_STR_FPS:
       ja: "%d FPS"
       en_us: "%d FPS"
-- 
2.55.0

