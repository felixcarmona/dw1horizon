From 52b533c961a212085c649e7233e9520ba2a3459a Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Mon, 9 Nov 2026 10:16:14 +0000
Subject: [PATCH] Mix the hardware timers into the evolution roll

Retain a four-byte entropy pool and four-byte pad snapshot in unsaved
RAM. An unused VBlank callback slot samples the existing BIOS pad
destination every refresh, so input changes between 20 Hz field polls
contribute root counters 0/2 and the refresh count. Preserve the sound
and card callback slots.

Avalanche the pool with live root-counter reads and the same refresh
count that VSync(-1) returns. Keep the 15-bit RNG XOR and modulo-tail
rejection; previews do not roll. Share field/menu polling with unchanged
repeat intervals. Matching padded language builds gain 32 bytes of
aligned heap; MENU size is unchanged.
---
 include/dw/evolution.h |  2 ++
 src/main/evolution.c   | 44 ++++++++++++++++++++++++++++++++++++++----
 src/main/main.c        | 36 ++++++++++++++--------------------
 3 files changed, 57 insertions(+), 25 deletions(-)

diff --git a/include/dw/evolution.h b/include/dw/evolution.h
index 8a747f31..e5d255c5 100644
--- a/include/dw/evolution.h
+++ b/include/dw/evolution.h
@@ -8,6 +8,8 @@
 /* Callers check the due hour. The lookup previews eligibility without RNG/state changes. */
 int16_t getNaturalEvolutionTarget(int32_t currentDigimon);
 int16_t rollNaturalEvolutionTarget(int32_t currentDigimon);
+/* VBlank callback: fold physical pad changes into unsaved evolution entropy. */
+void mixEvolutionInput(void);
 int16_t getFreshEvolutionTarget(int32_t currentDigimon);
 int16_t getInTrainingEvolutionTarget(int32_t currentDigimon);
 int16_t getRookieEvolutionTarget(int32_t currentDigimon, int32_t roll);
diff --git a/src/main/evolution.c b/src/main/evolution.c
index 671c0629..8cb30d9e 100644
--- a/src/main/evolution.c
+++ b/src/main/evolution.c
@@ -966,9 +966,46 @@ int16_t getInTrainingEvolutionTarget(int32_t currentDigimon) {
   return currentBest;
 }
 
+/* Ordinary evolution entropy only: RAM, never written to the memory card.
+ * COUNT reads match Psy-Q GetRCnt; leave MODE/TARGET and IRQ ownership alone. */
+static uint32_t evolutionEntropy;
+static uint32_t evolutionPad;
+/* PadInit supplies this destination to the BIOS, which refreshes it on VBlank. */
+extern volatile uint32_t pad_buf;
+/* Psy-Q VSync(-1) returns this existing refresh counter. */
+extern volatile uint32_t Vcount[];
+
+static uint32_t evolutionTimers(void)
+{
+  uint32_t ticks = *(volatile uint16_t *)0x1F801100;
+  ticks |= (uint32_t)*(volatile uint16_t *)0x1F801120 << 16;
+  return ticks ^ Vcount[0];
+}
+
+void mixEvolutionInput(void)
+{
+  uint32_t buttons = pad_buf;
+  if (buttons != evolutionPad) {
+    evolutionPad = buttons;
+    evolutionEntropy = ((evolutionEntropy << 5) | (evolutionEntropy >> 27)) ^
+                       evolutionTimers();
+  }
+}
+
+static int32_t evolutionTimingSample(void)
+{
+  uint32_t mix = evolutionEntropy ^ evolutionTimers();
+  /* Spread a one-frame difference through the low 15 bits before the XOR.
+   * XOR with an independent uniform RNG draw preserves its uniformity. */
+  mix ^= mix >> 16;
+  mix *= 0x45d9f3bu;
+  mix ^= mix >> 16;
+  return mix & 32767;
+}
+
 /* Admission is independent of the roll, including the route-order raised filter.
  * A first unraised qualifier becomes the history anchor, excluding later raised
- * targets. Earlier admitted targets remain eligible. No persistent pool or data. */
+ * targets. Earlier admitted targets remain eligible. Qualifiers live on the stack. */
 static int16_t chooseQualifiedEvolution(int32_t currentDigimon, int32_t roll)
 {
   DigimonId *targets = getEvolutionPath(currentDigimon)->to;
@@ -993,12 +1030,11 @@ static int16_t chooseQualifiedEvolution(int32_t currentDigimon, int32_t roll)
   /* Training only asks whether a target exists. Never consume RNG there. */
   if (!roll || count == 1)
     return qualified[0];
-  /* The existing RNG has 15 bits. Mix the live refresh counter at evolution,
-   * not saved age/time or a new-game seed: reload timing can change the choice.
+  /* Mix input timing retained since load plus the live sub-frame timers.
    * Reject the short tail rather than give the first slots extra probability. */
   ceiling = 32768 - 32768 % count;
   do {
-    sample = randomLimit(32768) ^ (VSync(-1) & 32767);
+    sample = randomLimit(32768) ^ evolutionTimingSample();
   } while (sample >= ceiling);
   return qualified[sample % count];
 }
diff --git a/src/main/main.c b/src/main/main.c
index ad9b98d7..b3778a9f 100644
--- a/src/main/main.c
+++ b/src/main/main.c
@@ -1,5 +1,7 @@
 extern int MOD_CHEATS_TRANSITION;
 void modCheatsCleanup(void);
+/* Psy-Q has eight VBlank slots: sound uses 4, memory cards use 7. */
+int VSyncCallbacks(int slot, void (*callback)(void));
 #include <stdlib.h>
 
 #include <__rts_info_t__.h>
@@ -18,6 +20,7 @@ void modCheatsCleanup(void);
 #include <dw/combat.h>
 #include <dw/efe.h>
 #include <dw/entity.h>
+#include <dw/evolution.h>
 #include <dw/fade.h>
 #include <dw/font.h>
 #include <dw/garbage.h>
@@ -3457,6 +3460,7 @@ int32_t main(void)
 	SetGraphDebug(0);
 	initializeFramebuffer();
 	PadInit(0);
+	VSyncCallbacks(6, mixEvolutionInput);
 	CdInit();
 	MemCardInit(1);
 	MemCardStart();
@@ -5945,7 +5949,8 @@ void applyDrawOffset(int32_t offset)
 		&DR_OFFSETS[offset]);
 }
 
-void pollInputGame(void)
+/* Share the polling path so the entropy pool costs no additional heap budget. */
+static __attribute__((noinline)) void pollInput(int32_t *timer, int32_t delay, int32_t repeat)
 {
 	int32_t held;
 
@@ -5955,36 +5960,25 @@ void pollInputGame(void)
 	held = POLLED_INPUT & POLLED_INPUT_PREVIOUS;
 	held &= 0xf000f000;
 	if (held != 0) {
-		if (++GAME_INPUT_REPEAT_TIMER >= 5) {
-			GAME_INPUT_REPEAT_TIMER -= 2;
+		if (++*timer >= delay) {
+			*timer -= repeat;
 		} else {
 			held = 0;
 		}
 	} else {
-		GAME_INPUT_REPEAT_TIMER = 0;
+		*timer = 0;
 	}
 	CHANGED_INPUT |= held;
 }
 
-void pollInputMenu(void)
+void pollInputGame(void)
 {
-	int32_t held;
+	pollInput(&GAME_INPUT_REPEAT_TIMER, 5, 2);
+}
 
-	POLLED_INPUT_PREVIOUS = POLLED_INPUT;
-	POLLED_INPUT = PadRead(0);
-	CHANGED_INPUT = POLLED_INPUT & ~POLLED_INPUT_PREVIOUS;
-	held = POLLED_INPUT & POLLED_INPUT_PREVIOUS;
-	held &= 0xf000f000;
-	if (held != 0) {
-		if (++MENU_INPUT_REPEAT_TIMER >= 0xf) {
-			MENU_INPUT_REPEAT_TIMER -= 6;
-		} else {
-			held = 0;
-		}
-	} else {
-		MENU_INPUT_REPEAT_TIMER = 0;
-	}
-	CHANGED_INPUT |= held;
+void pollInputMenu(void)
+{
+	pollInput(&MENU_INPUT_REPEAT_TIMER, 15, 6);
 }
 
