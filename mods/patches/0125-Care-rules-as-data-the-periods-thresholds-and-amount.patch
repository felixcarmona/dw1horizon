From 1b1b5f33c275e086b4cc8587e72377d7ee67d0f7 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Fri, 16 Oct 2026 18:17:56 +0000
Subject: [PATCH] Care rules as data: the periods, thresholds and amounts of
 sleep, sulking, tiredness, hunger, poop, sickness and the lifetime lost to
 unhappiness are MOD_CARE slots (-1 = the rule does not exist) written by
 tools/balance.py from content/tables/care-rules.json

---
 include/dw/level.h      |  64 +++++++++++++++
 src/main/partner_impl.c | 174 ++++++++++++++++++++++------------------
 2 files changed, 158 insertions(+), 80 deletions(-)

diff --git a/include/dw/level.h b/include/dw/level.h
index b66463c6..6d0fdb96 100644
--- a/include/dw/level.h
+++ b/include/dw/level.h
@@ -108,6 +108,70 @@ extern int16_t MOD_EVO_SPECIAL[MOD_EVO_SPECIAL_SIZE];
 extern int16_t MOD_TAMER_LEVEL[MOD_TAMER_LEVEL_SIZE];
