From e254e5b0a5a2d7807d4518449b01ea79fc6944aa Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Fri, 6 Nov 2026 05:46:58 +0000
Subject: [PATCH] Blink impending care needs and hold active gauges full red

---
 src/main/partner_impl.c | 138 ++++++++++++++++++++++------------------
 1 file changed, 75 insertions(+), 63 deletions(-)

diff --git a/src/main/partner_impl.c b/src/main/partner_impl.c
index a31f75fc..61703e6d 100644
--- a/src/main/partner_impl.c
+++ b/src/main/partner_impl.c
@@ -2367,10 +2367,11 @@ static void renderCareHUD(void)
 		{1,1,1,1,39,39,39},
 		{72,72,86,86,65,79,93}
 	};
-	int32_t i, value, max, red, icon, x, y, pixels;
+	int32_t i, value, max, red, icon, x, y, pixels, active, warn, period;
 	for (i = 0; i < 5; i++) {
 		max = 100;
 		icon = i + 2;
+		active = warn = 0;
 		switch (i) {
 		case 0:
 			value = PARTNER_PARA.happiness + 100;
@@ -2384,34 +2385,62 @@ static void renderCareHUD(void)
 			icon = 2 + red;
 			break;
 		case 2:
-			red = (PARTNER_PARA.condition & 4) != 0;
-			value = red ? PARTNER_PARA.starvationTimer : PARTNER_PARA.foodLevel;
+			value = PARTNER_PARA.foodLevel;
+			period = careGet(MOD_CARE_HUNGER_FOOD_PERIOD);
+			active = (PARTNER_PARA.condition & 4) != 0;
+			if (period > 0) {
+				active |= value <= 0;
+				warn = value * period <= 1200;
+			}
+			red = active;
 			max = 180;
 			break;
 		case 3:
-			red = (PARTNER_PARA.condition & 8) != 0;
+			period = careGet(MOD_CARE_POOP_PERIOD);
+			active = (PARTNER_PARA.condition & 8) != 0;
 			max = RAISE_ROW(PARTNER_ENTITY.digimonEntity.entity.type).poopTimer * 2;
-			value = red ? max : max - PARTNER_PARA.poopLevel;
-			/* An invalid baseline is empty, except for active POOPY. */
-			if (max <= 0) {
+			value = 0;
+			if (max <= 0)
 				max = 1;
-				value = red;
+			else {
+				value = max - PARTNER_PARA.poopLevel;
+				if (period > 0) {
+					active |= PARTNER_PARA.poopLevel <= 0;
+					warn = PARTNER_PARA.poopLevel * period <= 1200;
+				}
 			}
+			red = active;
 			break;
 		default:
 			value = PARTNER_PARA.tiredness;
 			red = value >= 50;
+			period = careGet(MOD_CARE_TIRED_EXHAUSTED_AT);
+			active = (PARTNER_PARA.condition & 2) != 0;
+			if (period >= 0) {
+				active |= value >= period;
+				/* ceil(100 / 18): the last native gauge step before exhaustion. */
+				warn = value + 6 >= period;
+			}
 		}
+		/* Need warnings blink only the fill; active needs stay full red. */
 		x = STATUS_UI_OFFSET_X + uv[2][icon];
 		y = uv[3][icon];
-		if (value < 0)
-			value = 0;
-		if (value > max)
-			value = max;
-		pixels = (value * 18 + max / 2) / max;
-		if (value && !pixels)
-			pixels = 1;
-		renderRectPolyFT4(x, y, 34, 13, uv[0][icon], uv[1][icon], 31, GetClut(272, 500 + icon), 14, 0);
+		if (active) {
+			pixels = 18;
+			red = 1;
+		} else {
+			if (value < 0)
+				value = 0;
+			if (value > max)
+				value = max;
+			pixels = ((uint32_t)value * 18 + (uint32_t)max / 2) / (uint32_t)max;
+			if (value && !pixels)
+				pixels = 1;
+			/* Real play ticks keep the one-Hz blink running while gym time is paused. */
+			if (warn && PLAYTIME_FRAMES % 20 >= 10)
+				pixels = 0;
+		}
+		renderRectPolyFT4(x, y, 34, 13, uv[0][icon], uv[1][icon], 31, GetClut(272, 500 + icon + active * 4), 14, 0);
 		if (pixels)
 			renderRectPolyFT4(x + 15, y + 6, pixels, 2, 144, 251 + red * 2, 31, GetClut(272, 507), 13, 0);
 	}
@@ -2422,59 +2451,42 @@ void renderStatusBars(state)
 	int8_t state;
 // clang-format on
 {
-	int32_t i;
-	uint8_t happinessTexX;
-	uint8_t happinessTexY;
-	int32_t happinessCount;
-	int32_t disciplineCount;
-	uint8_t disciplineTexX;
-	uint8_t disciplineTexY;
+	int32_t i, row, value, pass, count;
+	uint8_t texX, texY;
 
 	if (MOD_OPT_BARS) {
 		renderCareHUD();
 		return;
 	}
-	/* MOD (fps): the slide is in tickStatusBarsSlide (late tick) */
-	renderRectPolyFT4(STATUS_UI_OFFSET_X, 85, 75, 8, 0, 236, 5, 0x7D06, 15, 0);
-	renderRectPolyFT4(STATUS_UI_OFFSET_X, 97, 75, 8, 0, 236, 5, 0x7D06, 15, 0);
-	if (PARTNER_PARA.happiness >= 0)
-		happinessTexX = 64;
-	else
-		happinessTexX = 97;
-	if (PLAYTIME_FRAMES % 10 < 5) {
-		if (MAP_TILE_DATA.partnerAreaResponse == 2)
-			happinessTexX += 11;
-		else if (MAP_TILE_DATA.partnerAreaResponse == 1)
-			happinessTexX -= 11;
-	}
-	renderRectPolyFT4(STATUS_UI_OFFSET_X + 3, 83, 11, 11, happinessTexX, 244, 5, GetClut(96, 503), 14, 0);
-	if (PARTNER_PARA.discipline >= 50)
-		disciplineTexX = 22;
-	else
-		disciplineTexX = 33;
-	renderRectPolyFT4(STATUS_UI_OFFSET_X + 3, 95, 11, 11, disciplineTexX, 244, 5, GetClut(96, 498), 14, 0);
-	if (PARTNER_PARA.happiness >= 0) {
-		happinessTexY = 153;
-		happinessCount = PARTNER_PARA.happiness / 4;
-		for (i = 0; i < 25; i++)
-			renderRectPolyFT4(STATUS_UI_OFFSET_X + 18 + i * 2, 88, 2, 2, 232, 151, 5, GetClut(96, 503), 14, 0);
-	} else {
-		happinessTexY = 151;
-		happinessCount = (PARTNER_PARA.happiness + 100) / 4;
-	}
-	for (i = 0; i < happinessCount; i++)
-		renderRectPolyFT4(STATUS_UI_OFFSET_X + 18 + i * 2, 88, 2, 2, 232, happinessTexY, 5, GetClut(96, 503), 13, 0);
-	if (PARTNER_PARA.discipline >= 50) {
-		disciplineTexY = 153;
-		disciplineCount = (PARTNER_PARA.discipline - 50) / 2;
-		for (i = 0; i < 25; i++)
-			renderRectPolyFT4(STATUS_UI_OFFSET_X + 18 + i * 2, 100, 2, 2, 232, 151, 5, GetClut(96, 503), 14, 0);
-	} else {
-		disciplineTexY = 151;
-		disciplineCount = PARTNER_PARA.discipline / 2;
+	/* Share the original OFF rows without changing their GPU call order. */
+	for (row = 0; row < 2; row++)
+		renderRectPolyFT4(STATUS_UI_OFFSET_X, 85 + row * 12, 75, 8, 0, 236, 5, 0x7D06, 15, 0);
+	for (row = 0; row < 2; row++) {
+		if (row == 0) {
+			texX = PARTNER_PARA.happiness >= 0 ? 64 : 97;
+			if (PLAYTIME_FRAMES % 10 < 5) {
+				if (MAP_TILE_DATA.partnerAreaResponse == 2)
+					texX += 11;
+				else if (MAP_TILE_DATA.partnerAreaResponse == 1)
+					texX -= 11;
+			}
+		} else
+			texX = PARTNER_PARA.discipline >= 50 ? 22 : 33;
+		renderRectPolyFT4(STATUS_UI_OFFSET_X + 3, 83 + row * 12, 11, 11, texX, 244, 5, GetClut(96, row ? 498 : 503), 14, 0);
+	}
+
+	for (row = 0; row < 2; row++) {
+		value = row ? PARTNER_PARA.discipline * 2 - 100 : PARTNER_PARA.happiness;
+		texY = value >= 0 ? 153 : 151;
+		count = (value >= 0 ? value : value + 100) / 4;
+		for (pass = 0; pass < 2; pass++) {
+			value = pass ? count : (texY == 153 ? 25 : 0);
+			for (i = 0; i < value; i++)
+				renderRectPolyFT4(STATUS_UI_OFFSET_X + 18 + i * 2, 88 + row * 12,
+				                 pass ? 2 << row : 2, 2, 232, pass ? texY : 151,
+				                 5, GetClut(96, 503), 14 - pass, 0);
+		}
 	}
-	for (i = 0; i < disciplineCount; i++)
-		renderRectPolyFT4(STATUS_UI_OFFSET_X + 18 + i * 2, 100, 4, 2, 232, disciplineTexY, 5, GetClut(96, 503), 13, 0);
 }
 
 void setImmortalHour(void)
-- 
2.55.0

