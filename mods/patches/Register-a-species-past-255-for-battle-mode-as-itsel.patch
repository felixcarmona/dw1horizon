From d9e9b8ea9c8bc28cc0a1e0bb60757794200b382d Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Wed, 4 Nov 2026 15:00:36 +0000
Subject: [PATCH] Register a species past 255 for battle mode as itself

The battle registration kept the species in one byte, so a partner past
255 was registered as the original it borrows its effects from:
Gazimon fought as Garurumon, Gargoylemon as Ogremon, SkullSatamon as
Leomon, with that species' techniques at the equipped slots.

The record's unused bytes now keep the species itself (wideId), a copy
of the byte (wideCheck) and a tag. The byte keeps the stand-in, so the
original game and older builds read the record as before, and a slot
that an older build registers over again is read by its new byte.
registeredSpecies() gives the species everywhere a record is read: the
save machine's list, the battle mode's lists, portraits, techniques,
models and stats. A species the build does not have falls back to the
stand-in.
---
 include/dw/vs.h      | 23 +++++++++++++++++++++--
 src/main/main_menu.c | 27 +++++++++++++++++++--------
 src/vs/vs_scene.c    | 14 +++++++-------
 src/vs/vs_select.c   |  8 ++++----
 4 files changed, 51 insertions(+), 21 deletions(-)

diff --git a/include/dw/vs.h b/include/dw/vs.h
index b596796..5aba0ed 100644
--- a/include/dw/vs.h
+++ b/include/dw/vs.h
@@ -8,6 +8,7 @@
 #include <dw/efe.h>
 #include <dw/entity.h>
 #include <dw/graphics.h>
+#include <dw/ids.h>
 #include <dw/memmap.h>
 #include <dw/types.h>
 #include <dw/version.h>
@@ -27,11 +28,29 @@ typedef struct {
 	int16_t brains;
 	int16_t discipline;
 	char name[14];
-	uint8_t digimonId;
+	uint8_t digimonId;	/* MOD (wide registered species): a species past 255 keeps here the original it is based on */
 	uint8_t moves[3];
-	uint8_t unk20[32];
+	/* MOD (wide registered species): the species itself, which the byte above cannot hold past 255. The original game
+	 * never writes these bytes (zero on its cards); wideCheck repeats digimonId, so a slot that a build without this
+	 * field registers over again (it writes digimonId only) is read by its new byte */
+	uint16_t wideId;
+	uint8_t wideCheck;
+	uint8_t wideTag;	/* REGISTERED_WIDE_TAG when wideId is set */
+	uint8_t unk24[28];
 } RegisteredDigimon;
 
+#define REGISTERED_WIDE_TAG 0xD7
+
+/* MOD (wide registered species): the species a registered Digimon fights as; 0 for an empty slot */
+static inline int32_t registeredSpecies(const RegisteredDigimon *r)
+{
+	if (r->digimonId != 0 && r->wideTag == REGISTERED_WIDE_TAG && r->wideCheck == r->digimonId && r->wideId != 0 &&
+	    r->wideId < NUM_DIGIMON) {
+		return r->wideId;
+	}
+	return r->digimonId;
+}
+
 typedef struct {
 	uint8_t fighters[2][5];
 	uint8_t stage;
