From d6faf032c1cd18a0edf2a8a4ce5c49db5e592cae Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Tue, 27 Oct 2026 17:00:00 +0000
Subject: [PATCH] Patch 0243: seven languages and our Japanese bitmap font

Add French, German, Italian and our own Japanese from Spanish to the runtime
selector, language files, battle lettering and skip prompts. Keep the old save
values and store the selected language label in one VRAM row.

Share Japanese glyph rows through nine-bit dictionary indices and one cached
decoded glyph. Preserve every existing private-use code. Alias executable
strings only when all selected language banks agree, including their padding.
---
 Makefile                 |    4 +-
 include/dw/lang.h        |    6 +-
 src/btl/battle_effect.c  |  626 ++++++++++++++++++++++-
 src/main/font.c          |   39 +-
 src/main/font_b.h        |    5 +-
 src/main/font_extra.h    | 1019 +++++++++++++++++++++++++++++++++++++-
 src/main/main_menu.c     |   10 +-
 src/main/mod_options.c   |    8 +-
 src/std/std_hud.c        |  626 ++++++++++++++++++++++-
 src/vs/vs_hud.c          |  626 ++++++++++++++++++++++-
 text/main/main_menu.yaml |   12 +
 tools/gen_lang_files.py  |   12 +-
 tools/gen_text.py        |    7 +-
 13 files changed, 2969 insertions(+), 31 deletions(-)

diff --git a/Makefile b/Makefile
index f28229f9..c4a7fbf9 100644
--- a/Makefile
+++ b/Makefile
@@ -62,8 +62,8 @@ $(shell mkdir -p $(GEN_DIR); printf '#define FONT_%s 1\n' '$(shell echo $(FONT)
 # MOD (language): the language the executable's own strings are in at boot (docs/mods/language.md): en or es. A
 # two-language disc carries the other one as a patch (LANGEN.BIN / LANGES.BIN) and OPTIONS (LANGUAGE) switches.
 LANG_BASE ?= en
-ifeq ($(filter $(LANG_BASE),en es pt-br),)
-$(error LANG_BASE=$(LANG_BASE): en, es or pt-br)
+ifeq ($(filter $(LANG_BASE),en es pt-br fr de it ja),)
+$(error LANG_BASE=$(LANG_BASE): en, es, pt-br, fr, de, it or ja)
 endif
 # LANG_BUILD: the language of this build's strings and language tables (tools/build-full.sh builds the tree twice, once
 # per language; the two builds differ only in data, tools/langpatch.py checks it). Default: LANG_BASE.
