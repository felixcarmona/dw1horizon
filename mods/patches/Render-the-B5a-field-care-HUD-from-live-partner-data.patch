From fd63e3c4366ea42ea4d6faec7ccea184ccefeb05 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Fri, 6 Nov 2026 03:00:59 +0000
Subject: [PATCH] Render the B5a field care HUD from live partner data

NEW STATUS BARS selects five outlined gauges: the centred happiness/discipline pair and hunger/toilet/tiredness on the right. Keep the original field rendering when off and retain the existing tick-owned slide. Read native timers and RAISE_ROW for imported species; no new timer or persistent state.

The common icon housings, empty tracks and native status colours occupy unused cells of the existing ETCTIM texture. Replace the old flat-row helpers rather than retaining a second new-bar renderer; no new RAM or VRAM buffer is allocated.
---
 src/main/partner_impl.c | 148 +++++++++++++++++++++++++++---------------------
 1 file changed, 82 insertions(+), 66 deletions(-)

diff --git a/src/main/partner_impl.c b/src/main/partner_impl.c
index 29078f6..a31f75f 100644
--- a/src/main/partner_impl.c
+++ b/src/main/partner_impl.c
@@ -2356,43 +2356,65 @@ void tickStatusBarsSlide(int32_t state)
 		STATUS_UI_OFFSET_X = 75;
 }
 
-/* MOD (status bars): one flat 1-pixel row of a status bar */
-static void addStatusBarRow(int32_t x, int32_t y, int32_t w, int32_t r, int32_t g, int32_t b, int32_t z)
+/* B5a: tile art and fills live in unused ETCTIM cells, never in main RAM.
+   The 10 possible FT4 packets use 400 bytes of the existing frame buffer. */
+static void renderCareHUD(void)
 {
-	POLY_F4 *p;
-
-	p = (POLY_F4 *)GsGetWorkBase();
-	SetPolyF4(p);
-	setRGB0(p, r, g, b);
-	setXYWH(p, x, y, w, 1);
-	AddPrim(ACTIVE_ORDERING_TABLE->org + z, p++);
-	GsSetWorkBase((PACKET *)p);
-}
-
-/* MOD (status bars): one bar's 2-pixel-high track: the grey track (50 px) and `segments` segments (2 px each) of a
-   flat colour, red below half the range and green from half up (where the icons change), the top row lighter */
-static void renderStatusBarFill(int32_t x, int32_t y, int32_t segments, int32_t value, int32_t max)
-{
-	int32_t r;
-	int32_t g;
-
-	if (value < 0)
-		value = 0;
-	if (value > max)
-		value = max;
-	addStatusBarRow(x, y, 50, 0x70, 0x70, 0x70, 14);
-	addStatusBarRow(x, y + 1, 50, 0x58, 0x58, 0x58, 14);
-	if (segments <= 0)
-		return;
-	if (value * 2 < max) {
-		r = 0xE0;
-		g = 0x30;
-	} else {
-		r = 0x30;
-		g = 0xC8;
+	/* Texture u/v and screen x/y offsets for the seven icon variants. */
+	static const uint8_t uv[4][7] = {
+		{144,178,212,144,178,212,110},
+		{224,224,224,237,237,237,242},
+		{1,1,1,1,39,39,39},
+		{72,72,86,86,65,79,93}
+	};
+	int32_t i, value, max, red, icon, x, y, pixels;
+	for (i = 0; i < 5; i++) {
+		max = 100;
+		icon = i + 2;
+		switch (i) {
+		case 0:
+			value = PARTNER_PARA.happiness + 100;
+			max = 200;
+			red = PARTNER_PARA.happiness < 0;
+			icon = red;
+			break;
+		case 1:
+			value = PARTNER_PARA.discipline;
+			red = value < 50;
+			icon = 2 + red;
+			break;
+		case 2:
+			red = (PARTNER_PARA.condition & 4) != 0;
+			value = red ? PARTNER_PARA.starvationTimer : PARTNER_PARA.foodLevel;
+			max = 180;
+			break;
+		case 3:
+			red = (PARTNER_PARA.condition & 8) != 0;
+			max = RAISE_ROW(PARTNER_ENTITY.digimonEntity.entity.type).poopTimer * 2;
+			value = red ? max : max - PARTNER_PARA.poopLevel;
+			/* An invalid baseline is empty, except for active POOPY. */
+			if (max <= 0) {
+				max = 1;
+				value = red;
+			}
+			break;
+		default:
+			value = PARTNER_PARA.tiredness;
+			red = value >= 50;
+		}
+		x = STATUS_UI_OFFSET_X + uv[2][icon];
+		y = uv[3][icon];
+		if (value < 0)
+			value = 0;
+		if (value > max)
+			value = max;
+		pixels = (value * 18 + max / 2) / max;
+		if (value && !pixels)
+			pixels = 1;
+		renderRectPolyFT4(x, y, 34, 13, uv[0][icon], uv[1][icon], 31, GetClut(272, 500 + icon), 14, 0);
+		if (pixels)
+			renderRectPolyFT4(x + 15, y + 6, pixels, 2, 144, 251 + red * 2, 31, GetClut(272, 507), 13, 0);
 	}
-	addStatusBarRow(x, y, segments * 2, r + (0xFF - r) / 3, g + (0xFF - g) / 3, 0x60, 13);
-	addStatusBarRow(x, y + 1, segments * 2, r, g, 0x28, 13);
 }
 
 // clang-format off
@@ -2408,6 +2430,10 @@ void renderStatusBars(state)
 	uint8_t disciplineTexX;
 	uint8_t disciplineTexY;
 
+	if (MOD_OPT_BARS) {
+		renderCareHUD();
+		return;
+	}
 	/* MOD (fps): the slide is in tickStatusBarsSlide (late tick) */
 	renderRectPolyFT4(STATUS_UI_OFFSET_X, 85, 75, 8, 0, 236, 5, 0x7D06, 15, 0);
 	renderRectPolyFT4(STATUS_UI_OFFSET_X, 97, 75, 8, 0, 236, 5, 0x7D06, 15, 0);
@@ -2427,38 +2453,28 @@ void renderStatusBars(state)
 	else
 		disciplineTexX = 33;
 	renderRectPolyFT4(STATUS_UI_OFFSET_X + 3, 95, 11, 11, disciplineTexX, 244, 5, GetClut(96, 498), 14, 0);
-	/* MOD (status bars): each bar is one colour over its whole range, empty to full (happiness -100..100, 8 a
-	   segment; discipline 0..100, 4 a segment), red below the midpoint, green from it up, on a grey
-	   track; the original filled each half again in a second colour. The icons still change at the midpoint */
-	if (!MOD_OPT_BARS) { /* MOD (options): NEW STATUS BARS off, the original's */
-		if (PARTNER_PARA.happiness >= 0) {
-			happinessTexY = 153;
-			happinessCount = PARTNER_PARA.happiness / 4;
-			for (i = 0; i < 25; i++)
-				renderRectPolyFT4(STATUS_UI_OFFSET_X + 18 + i * 2, 88, 2, 2, 232, 151, 5, GetClut(96, 503), 14, 0);
-		} else {
-			happinessTexY = 151;
-			happinessCount = (PARTNER_PARA.happiness + 100) / 4;
-		}
-		for (i = 0; i < happinessCount; i++)
-			renderRectPolyFT4(STATUS_UI_OFFSET_X + 18 + i * 2, 88, 2, 2, 232, happinessTexY, 5, GetClut(96, 503), 13, 0);
-		if (PARTNER_PARA.discipline >= 50) {
-			disciplineTexY = 153;
-			disciplineCount = (PARTNER_PARA.discipline - 50) / 2;
-			for (i = 0; i < 25; i++)
-				renderRectPolyFT4(STATUS_UI_OFFSET_X + 18 + i * 2, 100, 2, 2, 232, 151, 5, GetClut(96, 503), 14, 0);
-		} else {
-			disciplineTexY = 151;
-			disciplineCount = PARTNER_PARA.discipline / 2;
-		}
-		for (i = 0; i < disciplineCount; i++)
-			renderRectPolyFT4(STATUS_UI_OFFSET_X + 18 + i * 2, 100, 4, 2, 232, disciplineTexY, 5, GetClut(96, 503), 13, 0);
-		return;
+	if (PARTNER_PARA.happiness >= 0) {
+		happinessTexY = 153;
+		happinessCount = PARTNER_PARA.happiness / 4;
+		for (i = 0; i < 25; i++)
+			renderRectPolyFT4(STATUS_UI_OFFSET_X + 18 + i * 2, 88, 2, 2, 232, 151, 5, GetClut(96, 503), 14, 0);
+	} else {
+		happinessTexY = 151;
+		happinessCount = (PARTNER_PARA.happiness + 100) / 4;
+	}
+	for (i = 0; i < happinessCount; i++)
+		renderRectPolyFT4(STATUS_UI_OFFSET_X + 18 + i * 2, 88, 2, 2, 232, happinessTexY, 5, GetClut(96, 503), 13, 0);
+	if (PARTNER_PARA.discipline >= 50) {
+		disciplineTexY = 153;
+		disciplineCount = (PARTNER_PARA.discipline - 50) / 2;
+		for (i = 0; i < 25; i++)
+			renderRectPolyFT4(STATUS_UI_OFFSET_X + 18 + i * 2, 100, 2, 2, 232, 151, 5, GetClut(96, 503), 14, 0);
+	} else {
+		disciplineTexY = 151;
+		disciplineCount = PARTNER_PARA.discipline / 2;
 	}
-	happinessCount = (PARTNER_PARA.happiness + 100) / 8;
-	renderStatusBarFill(STATUS_UI_OFFSET_X + 18, 88, happinessCount, PARTNER_PARA.happiness + 100, 200);
-	disciplineCount = PARTNER_PARA.discipline / 4;
-	renderStatusBarFill(STATUS_UI_OFFSET_X + 18, 100, disciplineCount, PARTNER_PARA.discipline, 100);
+	for (i = 0; i < disciplineCount; i++)
+		renderRectPolyFT4(STATUS_UI_OFFSET_X + 18 + i * 2, 100, 4, 2, 232, disciplineTexY, 5, GetClut(96, 503), 13, 0);
 }
 
 void setImmortalHour(void)
-- 
2.55.0
