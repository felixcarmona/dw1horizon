 char *formatInteger(int32_t, char *, int32_t);
 int32_t giveItem(ItemId, uint8_t);
 int32_t isFileReadQueueBusy(void);
@@ -255,20 +255,17 @@ static void modLabDrawText(void)
     char *p;
     int32_t row, n, id, level, count = modLabRowCount();
     int32_t picker = MOD_LAB_VIEW == LAB_EVOLVE || MOD_LAB_VIEW == LAB_MAPS;
-    int32_t firstRow = picker ? 3 : 2, visible = picker ? 5 : 6;
+    int32_t firstRow = picker ? 2 : 1, visible = picker ? 6 : 8;
     if (MOD_LAB_CURSOR < labTop) labTop = MOD_LAB_CURSOR;
     if (MOD_LAB_CURSOR >= labTop + visible) labTop = MOD_LAB_CURSOR - visible + 1;
     memset(lines, 0, sizeof(lines));
     appendStr(lines[0], MOD_LAB_VIEW == LAB_HOME ? LAB_STR_TITLE :
         MOD_LAB_VIEW == LAB_VALUES ? LAB_STR_PARAMETERS : MOD_LAB_VIEW == LAB_NUMBER ? LAB_FIELDS[labField].name :
         MOD_LAB_VIEW == LAB_EVOLVE ? LAB_STR_EVOLVE : MOD_LAB_VIEW == LAB_MAPS ? LAB_STR_TELEPORT : LAB_STR_CONFIRM);
-    if (MOD_LAB_VIEW == LAB_HOME) {
