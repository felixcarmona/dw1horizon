-    } else if (MOD_LAB_VIEW == LAB_VALUES) appendStr(lines[1], LAB_STR_CHOOSE_FIELD);
     if (picker || MOD_LAB_VIEW == LAB_CONFIRM) {
         if (picker) appendStr(lines[1], labFilter == 0 ? LAB_STR_FILTER_ALL : labFilter == 1 ? LAB_STR_FILTER_ORIGINAL : LAB_STR_FILTER_NEW);
         id = picker ? (labCount ? labChoices[MOD_LAB_CURSOR] : 0) : MOD_LAB_TARGET;
