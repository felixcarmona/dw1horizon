From 25b315e0c98d92e8fd782f8c6a7ce7f832576b43 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Wed, 18 Nov 2026 23:50:40 +0000
Subject: [PATCH] Item Bank lists show each item's icon

---
 src/main/script_common.c  |  2 +-
 src/main/script_textbox.c | 14 +++++++++++---
 src/shop/script_menu.c    |  5 +++--
 3 files changed, 15 insertions(+), 6 deletions(-)

diff --git a/src/main/script_common.c b/src/main/script_common.c
index 90125187..025187a5 100644
--- a/src/main/script_common.c
+++ b/src/main/script_common.c
@@ -2680,7 +2680,7 @@ void calculateItemMenuStrings(ItemMenuBox *box, uint8_t row, int32_t isLast)
 		/* MOD (item names): the colour code, or a fit code for a name that would come closer than a glyph's cell (12
 		 * pixels) to the price (0x16: column 0x69; a price of 4 digits starts at its edge) or, in the keeper (type
 		 * 5), than 4 to the count (0x1c: 0x64; its tens are a space below 10) */
-		*out++ = textFitCode(ITEM_NAME(type), ITEM_MENU_TYPE == 5 ? ITEM_FIELD_W : 0x69 - 12);
+		*out++ = textFitCode(ITEM_NAME(type), ITEM_MENU_TYPE == 5 ? ITEM_FIELD_W - 8 : 0x69 - 12);
 #else
 		*out++ = 1;
 #endif
diff --git a/src/main/script_textbox.c b/src/main/script_textbox.c
index 9fea61e2..5b92f461 100644
--- a/src/main/script_textbox.c
+++ b/src/main/script_textbox.c
@@ -911,10 +911,18 @@ int32_t drawString2(uint8_t *str, int16_t x, int16_t y, int32_t flag)
 			/* The keeper shares each row with the inventory at x = 128.
 			 * Clear only the gap to the count column, not 100 pixels
 			 * beyond the name: a left-list redraw must preserve it. */
-			if (pos < 0x64) {
-				CLEAR_FROM_PEN(x + pos, y, 0x64 - pos);
+			/* MOD (bank icons): the keeper's text starts 12 pixels further right to leave room for each item's icon, so its
+			 * count column moves 8 pixels left, and a name longer than that keeps its place */
+			{
+				int32_t col = ITEM_MENU_TYPE == 5 ? 0x5c : 0x64;
+
+				if (pos < col) {
+					CLEAR_FROM_PEN(x + pos, y, col - pos);
+					pos = col;
+				} else if (ITEM_MENU_TYPE != 5) {
+					pos = col;
+				}
 			}
-			pos = 0x64;
 			break;
 		case 0x18:
 			str++;
diff --git a/src/shop/script_menu.c b/src/shop/script_menu.c
index f25facce..9478d1d0 100644
--- a/src/shop/script_menu.c
+++ b/src/shop/script_menu.c
@@ -2524,9 +2524,10 @@ draw:
 		rect.h = 0x12;
 		GsSortBoxFill(&rect, ACTIVE_ORDERING_TABLE, 6 - boxId);
 	}
-	x2 = bx + 8;
+	/* MOD (bank icons): each row gets its item's icon at the box's edge; the names shift right 12 pixels */
+	x2 = bx + 0x14;
 	y = by + 0x24;
-	renderItemMenuItemList(box, x2, y, 0, 0, 2);
+	renderItemMenuItemList(box, x2, y, bx + 4, by + 0x23, 0);
 }
 
 void tickJukeboxMenu(void)
-- 
2.55.0

