+	int32_t shown = 0;
+	int32_t lateCount = 0;
+	int32_t xcost = 0;
 
 	if (flags & MOD_PRESENT_PAUSE) {
 		extra = modLoopRollback;
@@ -5460,8 +5666,11 @@ void modPresent(int32_t flags, ModRollbackSet *extra)
 	}
 	tickV = modTickV;
 	l0 = modTickL0;
+#if FPS != 20
+	level = modCadArm(flags, period, force);
+#endif
 	/* the thirds of the tick at which a frame is shown */
-	if (MOD_FPS_MODE <= 0 || period < 3) { /* a fast battle tick: one frame */
+	if (MOD_FPS_MODE <= 0 || period < 3 || (MOD_RENDER_CADENCE & 16)) { /* a fast battle tick or the 20 fps level: one frame */
 		n = 1;
 		thirds[0] = 3;
 	} else if (MOD_FPS_MODE == 1 || (MOD_RENDER_CADENCE & 3)) {
@@ -5481,7 +5690,7 @@ void modPresent(int32_t flags, ModRollbackSet *extra)
 		thirds[2] = 3;
 	}
 	/* at 20 fps nothing below touches the interpolation */
-	interp = (MOD_FPS_MODE > 0) && (MOD_FPS_INTERP != 0);
+	interp = (MOD_FPS_MODE > 0) && (MOD_FPS_INTERP != 0) && !(MOD_RENDER_CADENCE & 16);
 	if (!interp) {
 		modInterpInvalidate();
 	}
@@ -5561,7 +5770,7 @@ void modPresent(int32_t flags, ModRollbackSet *extra)
 		}
 		modRandLogPos = 0;
 		renderObjects();
-		if (MOD_RENDER_CADENCE) {
+		if (MOD_RENDER_CADENCE && !(MOD_RENDER_CADENCE & 0x18)) { /* armed by curling (1, 2, 4): the ladder's 8 | half and 16 must not reach its overlay */
 			KAR_flushTiles();
 		}
 		modRandLogging = 0;
@@ -5595,18 +5804,23 @@ void modPresent(int32_t flags, ModRollbackSet *extra)
 			MOD_PERF_XPASSES++;
 			MOD_PERF_XEND = (l3 - l0) & 0xFFFF;
 			MOD_PERF_XENDV = VSync(-1) - tickV;
+			if (((l3 - lc) & 0xFFFF) > xcost) {
+				xcost = (l3 - lc) & 0xFFFF; /* the extra pass with its setup */
+			}
 		}
 		if (discard) {
 			break; /* the next tick clears this ordering table and draws over the work area */
 		}
 		if (VSync(-1) >= endV) {
 			MOD_PERF_LATE++;
+			lateCount++;
 		}
 		do {
 			modWaitVblank(); /* like VSync(3): always swap on a vertical blank */
 		} while (VSync(-1) < endV);
 		vLast = VSync(-1);
 		GsSwapDispBuff();
+		shown++;
 		GsSortClear(0, 0, 0, &GS_ORDERING_TABLE[ACTIVE_FRAMEBUFFER]);
 		GsDrawOt(&GS_ORDERING_TABLE[ACTIVE_FRAMEBUFFER]);
 		MOD_FPS_RENDERS++;
@@ -5627,8 +5841,16 @@ void modPresent(int32_t flags, ModRollbackSet *extra)
 	MOD_RENDER_MULTIPASS = 0;
 	modExtraRollback = NULL;
 	modFlushRemovals();
-	modLastEndV = MOD_RENDER_CADENCE ? tickV + period : VSync(-1);
+	/* a steady pair or curling counts from the nominal end; the 20 fps level (16) from the refresh reached, as mode 0 */
+	modLastEndV = (MOD_RENDER_CADENCE & ~16) ? tickV + period : VSync(-1);
 	modLastEndLines = modLines();
+#if FPS != 20
+	/* MOD (fps ladder): what this tick cost and showed; not a fast, pumped, paused or stalled tick */
+	if (level >= 0 && !discard && !MOD_TICK_FAST && !MOD_LOAD_PUMP && !(flags & MOD_PRESENT_PAUSE) &&
+	    tickLines <= 3 * MOD_CAD_LINES) {
+		modCadRecord(n, shown, lateCount, MOD_PERF_P0END, xcost);
+	}
+#endif
 }
 
