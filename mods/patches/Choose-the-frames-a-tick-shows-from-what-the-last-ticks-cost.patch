+/* MOD (fps ladder): how many frames a tick shows is decided from what the last ticks cost, not from a CPU probe.
+ * Three cadences: 60 (three passes, best effort: a pass that does not fit is skipped), steady 30 (the curling pair:
+ * one frame at 2/3 of an even tick, which ends one refresh early, then two frames at 1/3 and 3/3 of the odd tick
+ * computed in that spare refresh; every frame two refreshes apart) and 20 (one frame at 3/3, the original).
+ * Every tick records its cost in lines (tick + first pass, extra pass) and its outcome (frames planned, shown,
+ * late) in a window of the last MOD_CAD_WINDOW ticks. The level steps down as soon as 16 ticks show the cadence
+ * does not pay (60: fewer than MOD_CAD_KEEP60 frames per 32 ticks; 30: more than MOD_CAD_KEEP30 late or skipped
+ * frames) and up only after a full window whose line costs predict the higher cadence (then it is tried; a try that
+ * fails doubles the wait before the next, up to 1024 ticks). The world and the battle loops each remember their
+ * level, so a battle starts from the last battle's level, not from a trial; a map change clears the evidence but
+ * keeps the level. Fast battle ticks, pause frames, battle data loads, the test tick length and curling (which arms
+ * MOD_RENDER_CADENCE itself) neither count nor change anything. The pass budget checks stay: no cadence slows the
+ * logic, which runs at 20 Hz in every cadence. */
+#define MOD_CAD_WINDOW 32
+#define MOD_CAD_LINES 263 /* lines per refresh */
+#define MOD_CAD_MARGIN 12 /* a pass must end this far before the vblank it is shown at */
+int8_t MOD_FPS_POLICY; /* MOD_FPS_POLICY_*: 0 the ladder, 1/2/3 lock 60 / steady 30 / 20, 4 the 0.0.7 CPU probe */
+int8_t MOD_CAD_LEVEL = 2; /* 2 = 60, 1 = steady 30, 0 = 20 */
+int8_t MOD_CAD_KEEP60 = 60; /* frames per 32 ticks to stay at 60 (60 = 37.5 fps); +4 to step up to it */
+int8_t MOD_CAD_KEEP30 = 4; /* late or skipped frames per 32 ticks tolerated at steady 30 */
+int32_t MOD_CAD_SWITCHES;
+int32_t MOD_CAD_LAST; /* the last recorded tick: cost0 | costX << 12 | shown << 24 | planned << 26 | late << 28 */
+/* one struct: the compiler reaches every field from one base address */
+static struct {
+	uint32_t ring[MOD_CAD_WINDOW];
+	int32_t mapGen;
+	int16_t since; /* ticks since the level changed */
+	int16_t cool[2]; /* ticks a context waits before trying a higher level again */
+	int8_t count, pos, ctx, prev, up;
+	int8_t ctxLevel[2];
+} modCad = { { 0 }, 0, 0, { MOD_CAD_WINDOW, MOD_CAD_WINDOW }, 0, 0, -1, -1, 0, { 2, 2 } };
+
+/* the frames a tick of these costs could show at 60: the first pass is shown at the vblank after it ends, each
+ * extra pass starts at the swap of the one before and is shown at the vblank after it ends, inside the tick */
+static int32_t modCadPredict60(int32_t c0, int32_t cx)
+{
+	int32_t frames = 1;
+	int32_t end = c0 + MOD_CAD_MARGIN; /* where a pass ends, with the margin before its vblank */
+	int32_t s = end > 2 * MOD_CAD_LINES ? 3 : end > MOD_CAD_LINES ? 2 : 1; /* the refresh the frame is shown at */
+
+	if (end > 3 * MOD_CAD_LINES) {
+		return 1;
+	}
+	while (s < 3) {
+		end = s * MOD_CAD_LINES + cx + MOD_CAD_MARGIN;
+		if (end > 3 * MOD_CAD_LINES) {
+			break;
+		}
+		s = end > 2 * MOD_CAD_LINES ? 3 : 2;
+		frames++;
+	}
+	return frames;
+}
+
+/* the level this tick renders with; sets MOD_RENDER_CADENCE for steady 30 (8 | half) and 20 (16); -1 leaves the
+ * tick to the loop's own mode (fast ticks, the test tick length, curling's own cadence) */
+static int32_t modCadArm(int32_t flags, int32_t period, int32_t force)
+{
+	int32_t level;
+	int32_t ctx;
+
+	if (MOD_FPS_MODE <= 0 || period < 3 || force || MOD_RENDER_CADENCE) {
+		return -1;
+	}
+	ctx = (flags & MOD_PRESENT_BATTLE) != 0;
+	if (!(flags & MOD_PRESENT_PAUSE)) {
+		if (ctx != modCad.ctx) {
+			if (modCad.ctx >= 0) {
+				modCad.ctxLevel[modCad.ctx] = MOD_CAD_LEVEL;
+			}
+			modCad.ctx = ctx;
+			MOD_CAD_LEVEL = modCad.ctxLevel[ctx];
+			modCad.count = modCad.pos = 0;
+			modCad.since = 0;
+		}
+		if (MOD_INTERP_MAP_GEN != modCad.mapGen) {
+			modCad.mapGen = MOD_INTERP_MAP_GEN;
+			modCad.count = modCad.pos = 0;
+			modCad.cool[ctx] = MOD_CAD_WINDOW;
+		}
+	}
+	switch (MOD_FPS_POLICY) {
+	case MOD_FPS_POLICY_60:
+		level = 2;
+		break;
+	case MOD_FPS_POLICY_30:
+		level = 1;
+		break;
+	case MOD_FPS_POLICY_20:
+		level = 0;
+		break;
+	case MOD_FPS_POLICY_CPU:
+		level = MOD_FPS_MODE_RUN == 2 ? 2 : 0;
+		break;
+	default:
+		level = MOD_CAD_LEVEL;
+	}
+	/* the steady pair starts with its early half (an even tick), so the odd tick that follows has its spare refresh */
+	if (level == 1 && modCad.prev != 1 && (MOD_FPS_TICKS & 1)) {
+		modCad.prev = 2;
+		return -1; /* align at 60 once; this is not evidence that steady 30 failed */
+	}
+	modCad.prev = level;
+	if (level == 1) {
+		MOD_RENDER_CADENCE = 8 | ((MOD_FPS_TICKS & 1) ? 1 : 2);
+	} else if (level == 0) {
+		MOD_RENDER_CADENCE = 16;
+	}
+	return level;
+}
+
+/* a tick's record and the ladder's decision for the next ticks */
+static void modCadRecord(int32_t planned, int32_t shown, int32_t late, int32_t c0, int32_t cx)
+{
+	int32_t i;
+	int32_t n;
+	int32_t level;
+	int32_t next;
+	int32_t ctx = modCad.ctx;
+	int32_t sumShown = 0;
+	int32_t sumMiss = 0;
+	int32_t sumPred = 0;
+	int32_t fit30 = 0;
+	uint32_t e;
+
+	if (c0 > 4095) {
+		c0 = 4095;
+	}
+	if (cx > 4095) {
+		cx = 4095;
+	}
+	MOD_CAD_LAST = c0 | (cx << 12) | (shown << 24) | (planned << 26) | (late << 28);
+	modCad.ring[modCad.pos] = MOD_CAD_LAST;
+	modCad.pos = (modCad.pos + 1) & (MOD_CAD_WINDOW - 1);
+	if (modCad.count < MOD_CAD_WINDOW) {
+		modCad.count++;
+	}
+	if (modCad.since < 0x7FFF) {
+		modCad.since++;
+	}
+	if (MOD_FPS_POLICY != MOD_FPS_POLICY_AUTO || modCad.count < 16 || ctx < 0 || (modCad.since & 7)) {
+		return;
+	}
+	n = modCad.count;
+	for (i = 0; i < n; i++) {
+		e = modCad.ring[i];
+		c0 = e & 0xFFF;
+		cx = (e >> 12) & 0xFFF;
+		if (cx == 0) {
+			cx = c0; /* no extra pass measured: as costly as the tick and its first pass (its setup included) */
+		}
+		sumShown += (e >> 24) & 3;
+		sumMiss += ((e >> 26) & 3) - ((e >> 24) & 3) + ((e >> 28) & 3);
+		sumPred += modCadPredict60(c0, cx);
+		fit30 += c0 + 2 * MOD_CAD_MARGIN <= 2 * MOD_CAD_LINES && cx + 2 * MOD_CAD_MARGIN <= 2 * MOD_CAD_LINES;
+	}
+	level = next = MOD_CAD_LEVEL;
+	if (level == 2 && sumShown * MOD_CAD_WINDOW < MOD_CAD_KEEP60 * n) {
+		next = fit30 == n ? 1 : 0;
+	} else if (level == 1 && sumMiss * MOD_CAD_WINDOW > MOD_CAD_KEEP30 * n) {
+		next = 0;
+	} else if (n == MOD_CAD_WINDOW && modCad.since >= modCad.cool[ctx]) {
+		if (level == 1 && sumPred * MOD_CAD_WINDOW >= (MOD_CAD_KEEP60 + 4) * n) {
+			next = 2;
+		} else if (level == 0 && fit30 == n) {
+			next = 1;
+		}
+	}
+	if (next != level) {
+		if (next < level && modCad.up && modCad.since < 2 * MOD_CAD_WINDOW && modCad.cool[ctx] < 1024) {
+			modCad.cool[ctx] *= 2; /* the try failed: wait longer before the next */
+		}
+		modCad.up = next > level;
+		MOD_CAD_LEVEL = next;
+		modCad.ctxLevel[ctx] = next;
+		MOD_CAD_SWITCHES++;
+		modCad.since = 0;
+		modCad.count = modCad.pos = 0;
+	}
+}
 #endif
 
 /* VSync(0), or with MOD_LOAD_PUMP the file queue stepped until the vblank comes (then VSync(0) once nothing is queued) */
