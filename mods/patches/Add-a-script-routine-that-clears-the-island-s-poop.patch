From 846b641006f550a027772d3816f1f4c2e7398c9e Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Mon, 2 Nov 2026 17:35:00 +0000
Subject: [PATCH] Add a script routine that clears the island's poop

CALL_DIGIMON_ROUTINE 11 empties every WORLD_POOP pile and returns at once: the
extended story's Sukamon sells this as a service in File City.
---
 src/main/partner.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/main/partner.c b/src/main/partner.c
index 0eadc9b..4130ed0 100644
--- a/src/main/partner.c
+++ b/src/main/partner.c
@@ -1175,11 +1175,19 @@ int16_t animId;
 void callDigimonRoutine(routine)
 uint8_t routine;
 {
+	int32_t i;
+
 	switch (routine) {
 	case 0:
 		partnerSetState(6);
 		SOME_SCRIPT_SYNC_BIT = 0;
 		break;
+	case 11: /* MOD: Sukamon sweeps the whole island's poop */
+		for (i = 0; i < 100; i++) {
+			WORLD_POOP[i].map = -1;
+			WORLD_POOP[i].size = 0;
+		}
+		break;
 	case 1:
 		KAR_start();
 		tamerSetState(12);
-- 
2.55.0

