From cb1e0c4db64a5bce7500c4b85541ed9ce22ed211 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Tue, 3 Nov 2026 20:41:17 +0000
Subject: [PATCH] Do not stand still for two reads on the way back from a won
 battle

The field's music font (a seek and 27 sectors) and the background's .TFS header (2 sectors from the start of the file, for
palettes that are already resident) were read before the world ran again; on the way back from a won fight the picture stood
still for both (0.67 s in PCSX-Redux, about 2 s on a device). The header is kept when the same map is reopened (a battle
exit, the ring's own reopening), and the music font goes through the file queue like the battle's, when QUICK BATTLES is on.
---
 src/main/city_residents_extra.h |  4 ++--
 src/main/sound_async.c          | 26 ++++++++++++++++++++++
 src/main/tamer.c                | 15 ++++++++++++-
 src/main/tfs_stream.c           | 39 ++++++++++++++++++++++++++++++---
 4 files changed, 78 insertions(+), 6 deletions(-)

diff --git a/src/main/city_residents_extra.h b/src/main/city_residents_extra.h
index 6726ab54..49b8a53a 100644
--- a/src/main/city_residents_extra.h
+++ b/src/main/city_residents_extra.h
@@ -1,3 +1,3 @@
 /* Generated from content/tables/city-residents.json. */
-#define CITY_RESIDENTS_EXTRA_COUNT 0
-static const uint16_t CITY_RESIDENTS_EXTRA[] = {0};
+#define CITY_RESIDENTS_EXTRA_COUNT 20
+static const uint16_t CITY_RESIDENTS_EXTRA[] = {184, 185, 193, 229, 235, 241, 243, 251, 257, 263, 267, 273, 280, 282, 287, 290, 294, 321, 351, 353};
diff --git a/src/main/sound_async.c b/src/main/sound_async.c
index 4f275e28..cb4492dd 100644
--- a/src/main/sound_async.c
+++ b/src/main/sound_async.c
@@ -3,6 +3,7 @@
 
 #include <dw/file_queue.h>
 #include <dw/main.h>
+#include <dw/mod_options.h> /* MOD (post-battle stall) */
 #include <dw/sound.h>
 #include <dw/sound_async.h>
 #include <dw/species.h>
@@ -385,3 +386,28 @@ void modPlayMusicAsync(int32_t font, int32_t track)
 	addFileReadRequestSection("FAALL.VHB", GENERAL_BUFFER, sector, sectors, &modMusicLoading,
 				  modMusicFinish, (void *)2);
 }
+
+extern uint8_t ACTIVE_BGM_FONT;
+extern uint8_t ACTIVE_BGM_TRACK;
+void handleMusicOverride(uint8_t *outFont, uint8_t *outVariant);
+void playBGM(int32_t bgmId);
+void stopBGM(void);
+
+/* MOD (post-battle stall): playBGM(ACTIVE_BGM_FONT) for the way back from a battle, without the wait for the font when
+ * QUICK BATTLES is on (the original reads it before the world runs again, a seek and 27 sectors) */
+void modResumeFieldMusic(void)
+{
+	uint8_t font;
+	uint8_t variant;
+
+	if (!MOD_OPT_QUICK_BATTLE || ACTIVE_BGM_FONT == 0xff) {
+		playBGM(ACTIVE_BGM_FONT);
+		return;
+	}
+	font = ACTIVE_BGM_FONT;
+	handleMusicOverride(&font, &variant);
+	ACTIVE_BGM_FONT = font;
+	ACTIVE_BGM_TRACK = variant;
+	stopBGM();
+	modPlayMusicAsync(font, variant);
+}
diff --git a/src/main/tamer.c b/src/main/tamer.c
index b8b4c9b7..13f4a33e 100644
--- a/src/main/tamer.c
+++ b/src/main/tamer.c
@@ -817,6 +817,10 @@ void renderItemPickupTextbox(int32_t instanceId)
 	++TEXTBOX_OPEN_TIMER;
 }
 
+extern int8_t MOD_TFS_SAME_MAP; /* tfs_stream.c */
+extern int8_t MOD_TFS_REOPEN_PENDING; /* tfs_stream.c */
+void modResumeFieldMusic(void); /* sound_async.c */
+
 int8_t startBattle(int16_t instanceId)
 {
 	int8_t result;
@@ -848,8 +852,17 @@ int8_t startBattle(int16_t instanceId)
 		handlePostBattleTiredness();
 		SKIP_DAYTIME_TRANSITION = 1;
 	} else if (result == 1) {
-		playBGM(ACTIVE_BGM_FONT);
+		/*
+		 * MOD (post-battle stall): the two reads that stood the picture still on the way back, the field's music font
+		 * (playBGM) and the background's header (readMapTFS, a seek to the start of the .TFS for palettes already
+		 * resident). The header is not read again, and the font goes through the file queue like the battle's.
+		 * The music comes second: its staging at GENERAL_BUFFER empties the ring, which reopens at the first idle tick of the queue.
+		 */
+		MOD_TFS_SAME_MAP = 1;
 		readMapTFS(CURRENT_SCREEN);
+		MOD_TFS_SAME_MAP = 0;
+		modResumeFieldMusic();
+		MOD_TFS_REOPEN_PENDING = 1;
 		STORED_TAMER_POS = TAMER_ENTITY.entity.posData->location;
 		partnerSetState(1);
 		PARTNER_PARA.happiness += careAmt(MOD_CARE_WON_HAPPY);
diff --git a/src/main/tfs_stream.c b/src/main/tfs_stream.c
index b3c4d968..5306b25a 100644
--- a/src/main/tfs_stream.c
+++ b/src/main/tfs_stream.c
@@ -52,6 +52,7 @@
 #include <dw/btl.h>
 #include <dw/file.h>
 #include <dw/map.h>
+#include <dw/mod_options.h>
 #include <dw/memmap.h>
 #include <dw/tfs_stream.h>
 #include <dw/types.h>
@@ -80,6 +81,11 @@ static char TFS_PATH[32];
 static int32_t TFS_ACTIVE;
 static int32_t TFS_FIRST_SECTOR;
 static int32_t TFS_DATA_OFFSET;	/* 8 + 512 * nCLUT */
+static int32_t TFS_HEADER_OK;	/* TFS_PATH's palettes are in MOD_TFS_CLUTS and TFS_DATA_OFFSET is its own */
+int8_t MOD_TFS_SAME_MAP;	/* the caller reopens the screen it is on (battle exit): the header need not be read again */
+extern int8_t MOD_BTL_PRELOAD; /* btl.c */
+extern int8_t MOD_BTL_PRELOAD_BLOCKED;
+int8_t MOD_TFS_REOPEN_PENDING;	/* the battle exit queued a load into the ring's area: reopen it (no disc) when the queue is idle */
 static int32_t TFS_NUM_SLOTS;
 static int32_t TFS_INFLIGHT = -1;
 static int32_t TFS_INFLIGHT_START;
@@ -230,9 +236,19 @@ void tfsStreamOpen(char *path)
 	FileLookup lookup;
 	int32_t size;
 	int32_t i;
+	int32_t reuse;
 
 	tfsStreamInvalidate();
 	tfsForgetCells();	/* VRAM may hold another map's (or file's) tiles */
+	/*
+	 * MOD (post-battle stall): the header is read from the disc only for a map whose palettes are not resident. The ring
+	 * reopening itself (path is TFS_PATH) and the battle exit (MOD_TFS_SAME_MAP, the same screen) keep what the last read
+	 * took from it; a 2-sector read at the start of the file cost a seek, and the picture stood still for it.
+	 */
+	reuse = TFS_HEADER_OK && (path == TFS_PATH || (MOD_TFS_SAME_MAP && strcmp(path, TFS_PATH) == 0));
+	if (!reuse) {
+		TFS_HEADER_OK = 0;
+	}
 	if (path != TFS_PATH) {
 		for (i = 0; (TFS_PATH[i] = path[i]) != 0 && i < 31; i++);
 		TFS_PATH[31] = 0;
@@ -241,9 +257,12 @@ void tfsStreamOpen(char *path)
 		return;
 	}
 	TFS_FIRST_SECTOR = CdPosToInt(&lookup.pos);
-	readFileSectors(TFS_PATH, (void *)TFS_HEADER_ADDR, 0, TFS_HEADER_SIZE >> 11);
-	TFS_DATA_OFFSET = 8 + 512 * ((uint32_t *)TFS_HEADER_ADDR)[1];
-	memcpy(MOD_TFS_CLUTS, (uint8_t *)TFS_HEADER_ADDR + 8, sizeof(MOD_TFS_CLUTS));
+	if (!reuse) {
+		readFileSectors(TFS_PATH, (void *)TFS_HEADER_ADDR, 0, TFS_HEADER_SIZE >> 11);
+		TFS_DATA_OFFSET = 8 + 512 * ((uint32_t *)TFS_HEADER_ADDR)[1];
+		memcpy(MOD_TFS_CLUTS, (uint8_t *)TFS_HEADER_ADDR + 8, sizeof(MOD_TFS_CLUTS));
+		TFS_HEADER_OK = 1;
+	}
 
 	/*
 	 * Never use more of the load area than this screen's whole TFS took in
@@ -638,6 +657,20 @@ void tfsStreamTick(void)
 		}
 		return;
 	}
+	if (MOD_TFS_REOPEN_PENDING) {
+		/*
+		 * MOD (post-battle stall): the music font staged at the battle exit emptied the ring. Reopened when the
+		 * queue is idle (the header is resident, nothing is read), the prefetch fills it before the camera
+		 * needs a tile; reopened only when a tile is needed, that tile (a whole row) is read with the game standing still.
+		 */
+		if (TFS_ACTIVE) {
+			MOD_TFS_REOPEN_PENDING = 0;
+		} else if (isFileReadQueueIdle() && (MOD_BTL_PRELOAD != 0 || MOD_BTL_PRELOAD_BLOCKED || !MOD_OPT_QUICK_BATTLE)) {
+			/* not before the battle's read ahead is queued: its start waits for a tile read in flight (0.8 s) */
+			MOD_TFS_REOPEN_PENDING = 0;
+			tfsStreamOpen(TFS_PATH);
+		}
+	}
 	if (!TFS_ACTIVE || (MAP_TILE_DATA.width == 0)) {
 		return;
 	}
-- 
2.55.0

