+      en_us: "CPU 250%: 60 FPS"
     MOD_NOTICE_STR_HEAD2:
-      ja: "if you turn on these options:"
-      en_us: "if you turn on these options:"
+      ja: "8 MB: Chinese only"
+      en_us: "8 MB: Chinese only"
     MOD_NOTICE_STR_RAM:
-      ja: "8 MB RAM"
-      en_us: "8 MB RAM"
+      ja: "RAM %d MB"
+      en_us: "RAM %d MB"
     MOD_NOTICE_STR_CPU:
-      ja: "CPU overclock at 250%"
-      en_us: "CPU overclock at 250%"
-    MOD_NOTICE_STR_MISSING:
-      ja: "NOT DETECTED"
-      en_us: "NOT DETECTED"
-    MOD_NOTICE_STR_READY:
-      ja: "READY"
-      en_us: "READY"
+      ja: "CPU ～%d％"
+      en_us: "CPU ～%d％"
+    MOD_NOTICE_STR_FPS:
+      ja: "%d FPS"
+      en_us: "%d FPS"
     MOD_OPT_STR_QUICK:
       ja: "QUICK BATTLE START"
       en_us: "QUICK BATTLE START"
