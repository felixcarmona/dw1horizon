From dbd27dc21dfa7881d2a681514aca1133c3159472 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Tue, 24 Nov 2026 06:41:48 +0000
Subject: [PATCH] A new row's evolution gift comes from its own eight
 techniques

---
 src/evl/evl.c           | 2 +-
 src/main/partner_impl.c | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/evl/evl.c b/src/evl/evl.c
index 5e2966bc..2da9a139 100644
--- a/src/evl/evl.c
+++ b/src/evl/evl.c
@@ -1459,7 +1459,7 @@ void EVL_applyEvolution(Entity *entity, Stats *stats, PartnerPara *para, int16_t
 	movePtr = DIGI_PARA(newId).moves;
 	count = 0;
 	for (i = 0; i < 16; movePtr++, i++) {
-		if (moveBase >= 0 && moveBase <= *movePtr && *movePtr <= moveBase + evoAmt(MOD_EVF_LEARN_WINDOW)) {
+		if (moveBase >= 0 && moveBase <= *movePtr && *movePtr <= moveBase + (special <= 6 ? evoAmt(MOD_EVF_LEARN_WINDOW) : 7)) { /* MOD (new technique rows): a new row is its own eight */
 			candidates[count] = *movePtr;
 			count++;
 		}
diff --git a/src/main/partner_impl.c b/src/main/partner_impl.c
index 159b4cfb..7b46fd31 100644
--- a/src/main/partner_impl.c
+++ b/src/main/partner_impl.c
@@ -656,7 +656,7 @@ void modInitializeStarterTechniques(int32_t type)
 	special = para->special[0];
 	base = special <= 6 ? MOD_EVO_FORMULA[MOD_EVF_LEARN_BASE0 + special]
 		: special < NUM_ELEMENTS ? NEW_MOVE_FIRST + (special - NEW_ELEMENT_FIRST) * 8 : -1; /* MOD (new technique rows) */
-	window = evoAmt(MOD_EVF_LEARN_WINDOW);
+	window = special <= 6 ? evoAmt(MOD_EVF_LEARN_WINDOW) : 7; /* MOD (new technique rows): a new row is its own eight */
 	best = 0xff;
 	slot = 0;
 	for (i = 0; base >= 0 && i < 16; i++) {
-- 
2.55.0

