+	{ { 0x007f, 0x7fff, 0x7fff, 0x7fff, 0x01ff, 0x7fff, 0x7fff, 0x7fff, 0x7fff, 0x7fff, 0xffff, }, 10 | 12 << 8 }, /* 8265 F */
