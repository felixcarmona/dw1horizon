+	{ { 0x7fff, 0x7fff, 0x7fff, 0x7fff, 0x7fff, 0x7fff, 0x7fff, 0x7fff, 0x7fff, 0x007f, 0xffff, }, 10 | 12 << 8 }, /* 826B L */
+	{ { 0x3f7f, 0x1e7f, 0x4c7f, 0x617f, 0x737f, 0x7f7f, 0x7f7f, 0x7f7f, 0x7f7f, 0x7f7f, 0xffff, }, 10 | 12 << 8 }, /* 826C M */
+	{ { 0x3f7f, 0x1f7f, 0x4f7f, 0x677f, 0x777f, 0x737f, 0x7b7f, 0x797f, 0x7c7f, 0x7e7f, 0xffff, }, 10 | 12 << 8 }, /* 826D N */
