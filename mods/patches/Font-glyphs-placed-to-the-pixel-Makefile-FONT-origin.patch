+static int16_t GLYPH_CARRY_X;
+static int16_t GLYPH_CARRY_Y = -1;
+static uint8_t *GLYPH_CARRY_SLOT;
+#endif
+
 void clearTextSubArea(RECT *rect)
 {
 	if (MOD_RENDER_PASS != 0) {
