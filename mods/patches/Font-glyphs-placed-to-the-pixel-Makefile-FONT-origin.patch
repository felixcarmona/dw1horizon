+	{ { 0x7f7f, 0x7f7f, 0x7f7f, 0x7f7f, 0x007f, 0x7f7f, 0x7f7f, 0x7f7f, 0x7f7f, 0x7f7f, 0xffff, }, 10 | 12 << 8 }, /* 8267 H */
+	{ { 0x00ff, 0xefff, 0xefff, 0xefff, 0xefff, 0xefff, 0xefff, 0xefff, 0xefff, 0x00ff, 0xffff, }, 9 | 12 << 8 }, /* 8268 I */
+	{ { 0xff7f, 0xff7f, 0xff7f, 0xff7f, 0xff7f, 0xff7f, 0xff7f, 0x7e7f, 0xbcff, 0xc1ff, 0xffff, }, 10 | 12 << 8 }, /* 8269 J */
