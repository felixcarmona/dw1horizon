 include/dw/species.h   |  6 +++--
 src/main/game_menu.c   | 55 +++++++++++++++++++++++++++++-------------
 src/main/mod_species.c | 45 ++++++++++++++++++++++++++++++++--
 text/main/mod_lab.yaml |  3 +++
 5 files changed, 90 insertions(+), 22 deletions(-)

