+		value |= MOD_TAMER_STATE[LOOK_HANDS_ROW] & ~1;
+	} else if (row == LOOK_SKIN_ROW) {
+		value = (value << 1) | MOD_TAMER_HANDS;
+		row = LOOK_HANDS_ROW;
+	}
+	MOD_TAMER_STATE[row] = value;
+}
