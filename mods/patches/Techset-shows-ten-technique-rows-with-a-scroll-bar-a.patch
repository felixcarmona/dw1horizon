+/* MOD (new technique rows): the Techset grid has ten rows and shows seven; MOVE_GRID_SCROLL is the first one on
+ * screen (declared with the cursor). A row is an element (the original seven keep their order, their techniques'
+ * ids are in another one). */
+
+static int32_t moveGridId(int32_t row, int32_t col)
+{
+	static const uint8_t block[7] = { 0, 5, 1, 4, 2, 3, 6 };
+	int32_t id;
+
+	if (row >= 7) {
+		return NEW_MOVE_FIRST + (row - 7) * 8 + col;
+	}
+	id = block[row] * 8 + col;
+	return id >= 0x30 ? id + 1 : id;
+}
+
+/* -> row * 8 + column of a technique (the two that share a cell with another land on it) */
+static int32_t moveGridCell(int32_t id)
+{
+	static const uint8_t rowOf[7] = { 0, 2, 4, 5, 3, 1, 6 };
+
+	if (IS_NEW_MOVE(id)) {
+		return id - NEW_MOVE_FIRST + 56;
+	}
+	if (id == 0x30) {
+		id = 0x2c;
+	} else if (id == 0x39) {
+		id = 0x37;
+	} else if (id > 0x30) {
+		id--;
+	}
+	return rowOf[id >> 3] * 8 + (id & 7);
+}
+
+static int32_t moveGridCursor(void)
+{
+	return moveGridId((MOVE_SELECT_BOX_Y - 0x6f) / 15 + MOVE_GRID_SCROLL, (MOVE_SELECT_BOX_X - 0x73) / 18);
+}
+
+/* An element's icon (two tiles each). The three new rows have theirs, and a palette of their own, in cells of
+ * SYSTEM_W that nothing used (tools/localize/tech_rows_art.py). */
+static void renderMoveIcon(int32_t x, int32_t y, int32_t special, int32_t tile, int32_t otz)
+{
+	static const uint8_t own[3][2][2] = { { { 128, 163 }, { 140, 163 } }, { { 152, 163 }, { 164, 163 } }, { { 200, 200 }, { 200, 212 } } };
+	static const uint16_t cluts[7] = { 0x7a06, 0x7a06, 0x7a46, 0x7a46, 0x7a46, 0x7a86, 0x7a06 };
+
+	if (special >= 7) {
+		renderRectPolyFT4(x, y, 0xc, 0xc, own[special - 7][tile][0], own[special - 7][tile][1], 5, 0x3f56, otz, 0);
+	} else {
+		renderRectPolyFT4(x, y, 0xc, 0xc, tile * 0xc + (special * 0x18 + 0x24), 0x80, 5, cluts[special], otz, 0);
+	}
+}
