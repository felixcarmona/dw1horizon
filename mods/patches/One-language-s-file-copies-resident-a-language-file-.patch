 #include <dw/atan_lookup_table.h>
@@ -853,12 +854,20 @@ FileEntry FILE_OFFSET_TABLE[] = {
 	 * entry above, so the original names resolve as before; build-disc.py --relayout writes their sectors.
 	 */
 #include <file_table_new.h>
+	/*
+	 * MOD (language): the language file slot, the active language's copies (LANG_FILES of the Makefile: its files,
