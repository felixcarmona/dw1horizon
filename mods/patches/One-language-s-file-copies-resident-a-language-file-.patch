 typedef struct __attribute__((packed)) {
 	uint32_t hash : 24;
 	uint16_t copy;
-	uint16_t original; /* Spanish, English signs: a place after FILE_TABLE_NEW_FIRST, 0xFFFF none */
+	uint16_t original; /* Spanish, English signs: a row of LANG_SLOT, 0xFFFF none */
 } LangFileRow;
 _Static_assert(sizeof(LangFileRow) == 7, "language routes use seven bytes");
 
@@ -384,14 +385,14 @@ char *modLangFile(char *name)
 			return name;
 		}
 		copy = !MOD_OPT_STORY && row->original != 0xFFFF ? row->original : row->copy;
-		if (copy == 0xFFFF || (!tfs && MOD_LANG == MOD_LANG_EN)) {
+		if (copy == 0xFFFF || (uint32_t)copy >= LANG_SLOT.count || (!tfs && MOD_LANG == MOD_LANG_EN)) {
 			return name;
 		}
-        key = FILE_OFFSET_TABLE[FILE_TABLE_NEW_FIRST + copy].nameHash;
+        key = LANG_SLOT.entries[copy].nameHash;
         MOD_LANG_NAME[0] = '@';
         for (digit = 0; digit < 8; digit++) MOD_LANG_NAME[digit+1] = "0123456789ABCDEF"[(key >> (28-digit*4)) & 15];
         MOD_LANG_NAME[9] = 0;
-		return FILE_OFFSET_TABLE[FILE_TABLE_NEW_FIRST + copy].sector != 0 ? MOD_LANG_NAME : name;
+		return LANG_SLOT.entries[copy].sector != 0 ? MOD_LANG_NAME : name;
 	}
 	return name;
 }
