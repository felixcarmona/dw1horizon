+#define LANG_SLOT_ROWS
+#include <lang_slot.h>
 	{ 0x00000000, 0x00000000, 0x000000 }, /* { 0x00000000, 0x00000000, "NULL" } */
 };
 
-/* MOD (language): the first of the new files' entries (lang_files.h names the copies by their place among them) */
-#include <file_table_count.h>
-const int16_t FILE_TABLE_NEW_FIRST = sizeof(FILE_OFFSET_TABLE) / sizeof(FileEntry) - 1 - NUM_NEW_FILES;
+/* MOD (language): where the slot starts (lang_files.h names the copies by their row in it; the tools find it here) */
+const LangSlot LANG_SLOT = { &FILE_OFFSET_TABLE[sizeof(FILE_OFFSET_TABLE) / sizeof(FileEntry) - 1 - LANG_SLOT_MAX], LANG_SLOT_MAX };
 // clang-format on
 
 #include <dw/sin_lookup_table.h>
diff --git a/src/main/mod_options.c b/src/main/mod_options.c
