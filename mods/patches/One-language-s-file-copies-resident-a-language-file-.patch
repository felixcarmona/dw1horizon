diff --git a/tools/gen_lang_files.py b/tools/gen_lang_files.py
index c4e1a7b..59e0020 100644
--- a/tools/gen_lang_files.py
+++ b/tools/gen_lang_files.py
@@ -1,16 +1,23 @@
 #!/usr/bin/env python3
-"""Generate active-language file routes for modLangFile.
+"""Generate active-language file routes for modLangFile, and the language file slot.
 
 Each language has identical row layout: a 24-bit collision-checked FNV key in
 a packed three-byte field, a u16 copy index and a u16 original-story index (0xFFFF when absent).
-LANGxx.BIN patches just the active language's seven-byte rows. All filenames
-in the original table and NEW_FILES must have distinct nonzero keys.
+The indices are rows of the language file slot (file_table_us.c LANG_SLOT), the last rows of FILE_OFFSET_TABLE:
+each language's copies (its group) are not resident in the table but written there with the rest of the
+language when it is set (LANGxx.BIN; tools/langpatch.py writes the slot as one run, tools/isowriter.py
+rewrite_lang_slot gives its rows their sectors when the disc is laid out). The slot is as long as the
+largest group; a shorter group ends with empty rows. LANGxx.BIN patches just the active language's
+seven-byte route rows and its slot rows. All filenames in the original table and NEW_FILES must have
+distinct nonzero keys.
 
   gen_lang_files.py OUT.h --lang "NAME:ES:EN[:PT:FR:DE:IT:JA:CA] ..."
-                         --new "NAME ..." --table src/main/file_table_us.c
+                         --new "NAME ..." --table src/main/file_table_us.c [--slot SLOT.h]
 """
 import argparse, os, re, sys
 
+LANGS = 9   # en es pt-br fr de it ja ca zh-hans (MOD_LANG_*); zh-hans reads its copies from its container
+
 
 def fnv1a(name):
     h = 0x811C9DC5
@@ -19,15 +26,51 @@ def fnv1a(name):
     return h & 0xFFFFFF
 
 
+def groups(lang, new):
+    """-> (rows, slots): per language, [(key, copy, original)] (copy and original names or None) and the ordered
+    names of its slot (its copies and their original-story copies, '_' for the first letter, when in NEW_FILES)"""
+    new = set(new)
+    rows = [[] for _ in range(LANGS)]
+    slots = [[] for _ in range(LANGS)]
+    for spec in lang.split():
+        parts = spec.split(':')
+        if not 3 <= len(parts) <= 9:
+            sys.exit(f'gen_lang_files: expected NAME:ES:EN[:PT:FR:DE:IT:JA:CA], got {spec}')
+        key = parts[0]
+        copies = parts[1:] + ['-'] * (9 - len(parts))
+        for c in copies:
+            if c != '-' and c not in new:
+                sys.exit(f'gen_lang_files: {c} (a copy of {key}) is not in NEW_FILES')
+        for lang_ in range(LANGS):
+            c = copies[1 if lang_ == 0 else 0 if lang_ == 1 else lang_] if lang_ < 8 else '-'
+            c = None if c == '-' else c
+            o = '_' + c[1:] if c and '_' + c[1:] in new else None
+            for n in (c, o):
+                if n and n not in slots[lang_]:
+                    slots[lang_].append(n)
+            rows[lang_].append((key, c, o))
+    return rows, slots
+
+
+def copies(lang, new):
+    """every name some language's slot holds: none of them is a resident row of FILE_OFFSET_TABLE"""
+    return {n for s in groups(lang, new)[1] for n in s}
+
+
+def write(path, text):
+    if not os.path.exists(path) or open(path).read() != text:
+        open(path, 'w').write(text)
+
+
 def main():
     ap = argparse.ArgumentParser()
     ap.add_argument('out')
     ap.add_argument('--lang', default='')
     ap.add_argument('--new', default='')
     ap.add_argument('--table', required=True)
+    ap.add_argument('--slot', help='the slot rows of each language build and LANG_SLOT_MAX (file_table_us.c)')
     a = ap.parse_args()
     new = a.new.split()
-    where = {n: i for i, n in enumerate(new)}
     names = set(re.findall(r'"([A-Z0-9_]+\.[A-Z0-9_]+)"', open(a.table).read())) | set(new)
     hashes = {}
     for n in names:
@@ -35,30 +78,29 @@ def main():
     for value, group in hashes.items():
         if value == 0 or len(group) > 1:
             sys.exit(f'gen_lang_files: ambiguous filename hash {value:08X}: {sorted(group)}')
-    rows = [[] for _ in range(9)]
-    for spec in a.lang.split():
-        parts = spec.split(':')
-        if not 3 <= len(parts) <= 9:
-            sys.exit(f'gen_lang_files: expected NAME:ES:EN[:PT:FR:DE:IT:JA:CA], got {spec}')
-        key = parts[0]
-        copies = parts[1:] + ['-'] * (9 - len(parts))
-        if len(hashes.get(fnv1a(key), ())) > 1:
-            sys.exit(f'gen_lang_files: {key} shares its hash with {sorted(hashes[fnv1a(key)] - {key})}')
-        idx = []
-        for c in copies:
-            if c == '-':
-                idx.append(0xFFFF)
-            elif c in where:
-                idx.append(where[c])
-            else:
-                sys.exit(f'gen_lang_files: {c} (a copy of {key}) is not in NEW_FILES')
-        original = [where.get('_' + c[1:], 0xFFFF) if c != '-' else 0xFFFF for c in copies]
-        for lang in range(9):
-            col = 1 if lang == 0 else 0 if lang == 1 else lang
-            rows[lang].append('{ 0x%08X, %d, %d }, /* %s */' % (fnv1a(key), idx[col] if lang < 8 else 0xFFFF, original[col] if lang < 8 else 0xFFFF, key))
-    text = ''.join('#if MOD_LANG_BUILD == %d\n%s#endif\n' % (lang, ''.join(r + '\n' for r in table)) for lang, table in enumerate(rows))
-    if not os.path.exists(a.out) or open(a.out).read() != text:
-        open(a.out, 'w').write(text)
+    rows, slots = groups(a.lang, new)
+    for row in rows[0]:
+        if len(hashes.get(fnv1a(row[0]), ())) > 1:
+            sys.exit(f'gen_lang_files: {row[0]} shares its hash with {sorted(hashes[fnv1a(row[0])] - {row[0]})}')
+    if slots[8]:
+        sys.exit('gen_lang_files: zh-hans has slot rows: its LANGZH.BIN container cannot have them rewritten')
+    out = []
+    for lang, table in enumerate(rows):
+        place = {n: i for i, n in enumerate(slots[lang])}
+        out.append('#if MOD_LANG_BUILD == %d\n%s#endif\n' % (lang, ''.join(
+            '{ 0x%08X, %d, %d }, /* %s */\n' % (fnv1a(key), place.get(c, 0xFFFF), place.get(o, 0xFFFF), key)
+            for key, c, o in table)))
+    write(a.out, ''.join(out))
+    if a.slot:
+        most = max(len(s) for s in slots)
+        text = ('#define LANG_SLOT_MAX %d\n#ifdef LANG_SLOT_ROWS\n#ifndef MOD_LANG_BUILD\n'
+                '#error "the slot rows need MOD_LANG_BUILD (dw/lang.h)"\n#endif\n' % most)
+        for lang, slot in enumerate(slots):
+            text += '#if MOD_LANG_BUILD == %d\n' % lang
+            text += ''.join('\t{ 0, 0x800, 0x%06X }, /* %s */\n' % (fnv1a(n), n) for n in slot)
+            text += '\t{ 0, 0, 0 },\n' * (most - len(slot))
+            text += '#endif\n'
+        write(a.slot, text + '#endif\n')
 
 
 if __name__ == '__main__':
