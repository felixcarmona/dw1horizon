From 760655393d0272bcb5a9158e2b4d7a7b52ff5834 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Thu, 5 Nov 2026 22:04:57 +0000
Subject: [PATCH] Keep Chinese list headers and trade columns aligned

---
 src/main/script_common.c  | 14 +++++++++++++-
 src/main/script_textbox.c |  3 ++-
 src/shop/script_menu.c    | 15 +++++++++------
 3 files changed, 24 insertions(+), 8 deletions(-)

diff --git a/src/main/script_common.c b/src/main/script_common.c
index 214e772..f1b8cac 100644
--- a/src/main/script_common.c
+++ b/src/main/script_common.c
@@ -1,5 +1,7 @@
 #include <string.h>
 
+#include <dw/mod_options.h>
+
 #include <libgs.h>
 
 #include <dw/mod_font.h>
@@ -1657,7 +1659,9 @@ void calculateItemListStrings(ItemMenuBox *box, uint8_t row, int32_t isLast)
 	got = ITEM_NAME(ITEM_MENU_RIGHT->buf[idx]);
 	len = strlen(name);
 	pad = len < 16 ? 8 - (len >> 1) : 0;
-	pad = measureStringMode(name, FIT_VANILLA) + pad * 8 + measureStringMode(got, FIT_VANILLA) > 218 - 22;
+	/* Chinese names use full-width glyphs; keep both fields under their headings. */
+	pad = MOD_LANG == MOD_LANG_ZH ||
+	      measureStringMode(name, FIT_VANILLA) + pad * 8 + measureStringMode(got, FIT_VANILLA) > 218 - 22;
 	*out++ = pad ? textFitCode(name, 0x72 - 6 - 12) : 1;
 	*out++ = (item & 0x80) != 0 ? 1 : 3;
 	strcpy(out, name);
@@ -2902,6 +2906,7 @@ void calculateBirdramonMenuStrings(ItemMenuBox *box, uint8_t row, int32_t isLast
 void updateItemMenuLine(ItemMenuBox *box, int32_t style)
 {
 	TextBoxData *entry;
+	RECT area;
 	int16_t row;
 	int32_t outX;
 	int32_t outClut;
@@ -2938,6 +2943,13 @@ void updateItemMenuLine(ItemMenuBox *box, int32_t style)
 		p += 0x20;
 	}
 
+	/* A shorter Chinese name needs the whole recycled slot cleared, including
+	 * its padding. Half-width Item Bank rows must preserve the adjacent list. */
+	if (MOD_LANG == MOD_LANG_ZH) {
+		setRECT(&area, outX, row * 12, outClut + 1, 12);
+		clearTextSubArea(&area);
+	}
+
 #if !VERSION_IS(US)
 	drawString2(p, outX, row * 12);
 #else
diff --git a/src/main/script_textbox.c b/src/main/script_textbox.c
index 2d189b6..d08c94f 100644
--- a/src/main/script_textbox.c
+++ b/src/main/script_textbox.c
@@ -885,7 +885,8 @@ int32_t drawString2(uint8_t *str, int16_t x, int16_t y, int32_t flag)
 		case 0x17:
 			str++;
 			CLEAR_FROM_PEN(x + pos, y, 0x69);
-			pos = 0x69;
+			/* Chinese card names can use 112 pixels before the numeric field. */
+			pos = MOD_LANG == MOD_LANG_ZH ? 0x70 : 0x69;
 			break;
 		case 0x1b:
 			str++;
diff --git a/src/shop/script_menu.c b/src/shop/script_menu.c
index cb2bce9..f244e69 100644
--- a/src/shop/script_menu.c
+++ b/src/shop/script_menu.c
@@ -1,5 +1,6 @@
 #include <string.h>
 
+#include <dw/mod_options.h>
 #include <dw/mod_rules.h>
 #include <dw/mod_font.h>
 #include <dw/main.h>
@@ -2150,19 +2151,21 @@ void renderKeeperBoxLeft(void)
 #endif
 }
 
+/* Headings are drawn separately. Start Chinese header rows with a break: their
+ * translated text can end before the native byte offsets used to chain list rows. */
 void updateKeeperTextbox(int32_t boxIndex)
 {
 	if (boxIndex == 0) {
 		showMapHeadTextbox(4, 0xff, 1, 0x4d5);
 		TEXTBOX_DATA.box[1].writeCount--;
-		TEXTBOX_LINES_PTR[0x246] = 0xd;
-		TEXTBOX_LINES_PTR[0x3c6] = 0xd;
+		TEXTBOX_LINES_PTR[MOD_LANG == MOD_LANG_ZH ? 0x240 : 0x246] = 0xd;
+		TEXTBOX_LINES_PTR[MOD_LANG == MOD_LANG_ZH ? 0x3c0 : 0x3c6] = 0xd;
 		updateItemMenuStrings(ITEM_MENU_LEFT, 0xa, 0);
 	} else {
 		showMapHeadTextbox(5, 0xff, 2, 0x4d5);
 		TEXTBOX_DATA.box[2].writeCount--;
-		TEXTBOX_LINES_PTR[0x266] = 0xd;
-		TEXTBOX_LINES_PTR[0x3e6] = 0xd;
+		TEXTBOX_LINES_PTR[MOD_LANG == MOD_LANG_ZH ? 0x260 : 0x266] = 0xd;
+		TEXTBOX_LINES_PTR[MOD_LANG == MOD_LANG_ZH ? 0x3e0 : 0x3e6] = 0xd;
 		updateItemMenuStrings(ITEM_MENU_RIGHT, 0xa, 0);
 	}
 }
@@ -2764,8 +2767,8 @@ void updateMojyaTradeStrings(void)
 	showMapHeadTextbox(0xf, 0xff, 1, 0x4d6);
 
 	--TEXTBOX_DATA.box[1].writeCount;
-	TEXTBOX_LINES_PTR[0x254] = 0xd;
-	TEXTBOX_LINES_PTR[0x354] = 0xd;
+	TEXTBOX_LINES_PTR[MOD_LANG == MOD_LANG_ZH ? 0x240 : 0x254] = 0xd;
+	TEXTBOX_LINES_PTR[MOD_LANG == MOD_LANG_ZH ? 0x340 : 0x354] = 0xd;
 
 	updateItemMenuStrings(ITEM_MENU_LEFT, 0xa, 4);
 }
-- 
2.55.0

