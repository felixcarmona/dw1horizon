 #define MOD_LAB_EVO_COUNT ((int32_t)(sizeof(MOD_LAB_EVO_TARGETS) / sizeof(MOD_LAB_EVO_TARGETS[0])))
 
+/* MOD (dcb-import): next target (step 1 or COUNT-1) whose species exists */
