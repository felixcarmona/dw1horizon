diff --git a/tools/overlay_seal.py b/tools/overlay_seal.py
new file mode 100644
index 00000000..58b3facc
--- /dev/null
+++ b/tools/overlay_seal.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""MOD (shop overlay): seal an overlay image, or check a sealed one.
+
+The last word of a sealed overlay is the rotating sum of every word before it (sum = rotl(sum, 1) + word, from SEED).
+The game checks it before it runs the code (modShopOverlayEnsure, src/main/script_common.c), so a slot that holds
+anything else (zeros, another overlay, a torn read) is read again instead of run.
+
+    overlay_seal.py seal FILE        write the seal into FILE's last word
+    overlay_seal.py check FILE...    exit 1 unless every FILE is sealed
+"""
+import struct, sys
+
+SEED = 0x53484F50  # 'SHOP'
+
+
+def checksum(data):
+    s = SEED
+    for (w,) in struct.iter_unpack('<I', data):
+        s = (((s << 1) | (s >> 31)) + w) & 0xFFFFFFFF
+    return s
+
+
+def sealed(data):
+    return len(data) >= 8 and len(data) % 4 == 0 and checksum(data[:-4]) == struct.unpack_from('<I', data, len(data) - 4)[0]
+
+
+def main(argv):
+    if len(argv) >= 3 and argv[1] == 'seal' and len(argv) == 3:
+        data = bytearray(open(argv[2], 'rb').read())
+        if len(data) < 8 or len(data) % 4:
+            sys.exit(f'{argv[2]}: {len(data)} bytes, not a word-aligned overlay')
+        if data[-4:] != b'\0\0\0\0':
+            sys.exit(f'{argv[2]}: the last word is not the linker\'s empty seal')
+        struct.pack_into('<I', data, len(data) - 4, checksum(bytes(data[:-4])))
+        open(argv[2], 'wb').write(data)
+        return 0
+    if len(argv) >= 3 and argv[1] == 'check':
+        bad = [p for p in argv[2:] if not sealed(open(p, 'rb').read())]
+        for p in bad:
+            print(f'{p}: not a sealed overlay', file=sys.stderr)
+        return 1 if bad else 0
+    sys.exit(__doc__)
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv))
