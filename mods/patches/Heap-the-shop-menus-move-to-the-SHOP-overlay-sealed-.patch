+/* MOD (shop overlay): the shops, the naming box, the card packs, the item keeper, the jukebox, the Birdramon
+   transport and the new-game questions live in SHOP_REL.BIN (overlay.ld), which the game reads into its slot on
+   entering a shop screen (checkShopMap) and at the naming scene (routine 0x23, newGameScene). Other overlays share
+   the slot (DGET, DOOA, STD, MOV), so before a routine runs code from it this checks the slot's seal, the overlay's
+   last word written at build time (tools/overlay_seal.py), and reads the overlay again when the slot holds anything
+   else. MOD_SHOP_RELOADS counts those reads: on a normal path it stays 0. */
+extern uint32_t shop_START[];
+extern uint32_t shop_SEAL[];
+int32_t isFileReadQueueIdle(void); /* file_queue.c */
+void _tickFileReadQueue(int32_t instanceId); /* file_queue.c */
+int32_t MOD_SHOP_RELOADS = 0;
+
+void modShopOverlayEnsure(void)
+{
+	uint32_t *w;
+	uint32_t sum;
+	uint8_t done;
+
+	while (!isFileReadQueueIdle()) {
+		_tickFileReadQueue(0);
+	}
+	sum = 0x53484F50; /* 'SHOP' */
+	for (w = shop_START; w < shop_SEAL; w++) {
+		sum = ((sum << 1) | (sum >> 31)) + *w;
+	}
+	if (sum != *shop_SEAL) {
+		MOD_SHOP_RELOADS++;
+		loadDynamicLibrary(SHOP_REL, &done, 0, 0, 0);
+	}
+}
+
 // clang-format off
 void checkArenaMap(mapId)
 	int16_t mapId;
