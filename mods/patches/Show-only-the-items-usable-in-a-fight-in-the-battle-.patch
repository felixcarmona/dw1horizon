From 3e520f5b4e7567b06f8cb3ced85851bbf436dd5a Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Tue, 17 Nov 2026 20:52:25 +0000
Subject: [PATCH] Show only the items usable in a fight in the battle item list

---
 src/main/inventory.c                          |  10 +++
 src/main/mod_feed.c                           |  82 ++++++++++++++++++
 .../gen_lang_files.cpython-312.pyc            | Bin 0 -> 5392 bytes
 3 files changed, 92 insertions(+)
 create mode 100644 tools/__pycache__/gen_lang_files.cpython-312.pyc

diff --git a/src/main/inventory.c b/src/main/inventory.c
index d3586ce..e277015 100644
--- a/src/main/inventory.c
+++ b/src/main/inventory.c
@@ -279,8 +279,14 @@ void drawInventoryTextLine(int16_t startSlot)
 	DrawSync(0);
 }
 
+/* MOD (battle item list): modBag* in mod_feed.c */
+void modBagFilterForBattle(void);
+void modBagRestoreAfterBattle(void);
+void modBagForget(void);
+
 void initializeInventoryUI(void)
 {
+	modBagForget();
 	INVENTORY_ACTION = 0;
 	IS_INVENTORY_INITIALIZED = 0;
 }
@@ -291,6 +297,9 @@ void addInventoryUI(void)
 	    (TAMER_ITEM.worldItem.type == ITEM_NONE)) {
 		IS_INVENTORY_INITIALIZED = 1;
 		INVENTORY_ACTION = 1;
+		if (GAME_STATE == 1) {
+			modBagFilterForBattle();
+		}
 		addObject(0x1a5, 0, tickInventoryUI, 0);
 	}
 }
@@ -430,6 +439,7 @@ void closeInventoryBoxes(void)
 	if (IS_INVENTORY_INITIALIZED != 0) {
 		IS_INVENTORY_INITIALIZED = 0;
 		INVENTORY_ACTION = 0;
+		modBagRestoreAfterBattle();
 		for (i = 0; i < 4; i++) {
 			if (UI_BOX_DATA[i].state != 0) {
 				removeStaticUIBox(i);
diff --git a/src/main/mod_feed.c b/src/main/mod_feed.c
index 7a2a7d8..55ace6e 100644
--- a/src/main/mod_feed.c
+++ b/src/main/mod_feed.c
@@ -553,3 +553,85 @@ int32_t modFeedTick(void)
 	addObject(FEED_OBJECT_ID, 0, feedTick, NULL);
 	return 1;
 }
+
+/* MOD (battle item list): in a fight the bag shows only what can be thrown. The real bag waits here while the list is
+ * open; closing puts it back, the usable items in the order the list left them (Move and Sort still count). */
+ItemId MOD_BAG_TYPES[30];
+uint8_t MOD_BAG_AMOUNTS[30];
+uint8_t MOD_BAG_HELD;
+
+static int32_t isBattleItem(ItemId type)
+{
+	return (type != ITEM_NONE) && ((ITEM_PARA[type].itemColor == 1) || (ITEM_PARA[type].itemColor == 2));
+}
+
+void modBagFilterForBattle(void)
+{
+	int32_t i;
+	int32_t n;
+
+	if (MOD_BAG_HELD != 0) {
+		return;
+	}
+	MOD_BAG_HELD = 1;
+	n = 0;
+	for (i = 0; i < INVENTORY.size; i++) {
+		MOD_BAG_TYPES[i] = INVENTORY.types.array[i];
+		MOD_BAG_AMOUNTS[i] = INVENTORY.amounts.array[i];
+	}
+	for (i = 0; i < INVENTORY.size; i++) {
+		if (isBattleItem(MOD_BAG_TYPES[i])) {
+			INVENTORY.types.array[n] = MOD_BAG_TYPES[i];
+			INVENTORY.amounts.array[n] = MOD_BAG_AMOUNTS[i];
+			INVENTORY.names.array[n] = n;
+			n++;
+		}
+	}
+	for (; n < INVENTORY.size; n++) {
+		INVENTORY.types.array[n] = ITEM_NONE;
+		INVENTORY.amounts.array[n] = 0;
+		INVENTORY.names.array[n] = 0xff;
+	}
+}
+
+void modBagRestoreAfterBattle(void)
+{
+	int32_t i;
+	int32_t n;
+	ItemId held;
+
+	if (MOD_BAG_HELD == 0) {
+		return;
+	}
+	MOD_BAG_HELD = 0;
+	held = INVENTORY.types.array[INVENTORY_POINTER];
+	n = 0;
+	for (i = 0; i < INVENTORY.size; i++) {
+		if (isBattleItem(MOD_BAG_TYPES[i])) {
+			while ((n < INVENTORY.size) && (INVENTORY.types.array[n] == ITEM_NONE)) {
+				n++;
+			}
+			if (n < INVENTORY.size) {
+				MOD_BAG_TYPES[i] = INVENTORY.types.array[n];
+				MOD_BAG_AMOUNTS[i] = INVENTORY.amounts.array[n];
+				n++;
+			} else {
+				MOD_BAG_TYPES[i] = ITEM_NONE;
+				MOD_BAG_AMOUNTS[i] = 0;
+			}
+		}
+	}
+	for (i = 0; i < INVENTORY.size; i++) {
+		INVENTORY.types.array[i] = MOD_BAG_TYPES[i];
+		INVENTORY.amounts.array[i] = MOD_BAG_AMOUNTS[i];
+		INVENTORY.names.array[i] = (MOD_BAG_TYPES[i] != ITEM_NONE) ? i : 0xff;
+		if ((held != ITEM_NONE) && (MOD_BAG_TYPES[i] == held)) {
+			INVENTORY_POINTER = i; /* the throw that follows reads the slot by number */
+		}
+	}
+}
+
+void modBagForget(void)
+{
+	MOD_BAG_HELD = 0;
+}
