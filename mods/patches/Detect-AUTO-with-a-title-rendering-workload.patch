 void renderString(int32_t color, int16_t x, int16_t y, int16_t width, int16_t height, int16_t u, int16_t v, int32_t depth, int32_t shadow);
 
 int32_t MOD_CPU_SPINS;
-static int32_t MOD_NOTICE;
