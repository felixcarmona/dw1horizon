From acb5ffa003f605ce35e01e189198894023595a46 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Sun, 8 Nov 2026 18:18:14 +0000
Subject: [PATCH] Detect AUTO with a title rendering workload

---
 Makefile                 |   3 +-
 include/dw/mod_fps.h     |  13 +++-
 src/main/main.c          | 137 ++++++++++++++++++++++++++++-----------
 src/main/main_menu.c     |   6 +-
 text/main/main_menu.yaml |   4 +-
 5 files changed, 116 insertions(+), 47 deletions(-)

diff --git a/Makefile b/Makefile
index 9db0aa08..35433a15 100644
--- a/Makefile
+++ b/Makefile
@@ -38,11 +38,12 @@ $(shell mkdir -p $(GEN_DIR); printf '#define PARTNER_MMD_MAX %s\n' '$(PARTNER_MM
 # MOD (fps): the frame rate the build presents, 20, 30 or 60 fps (docs/mods/60fps.md); the
 # game logic runs at 20 Hz in all three. Chosen here, at build time only (no menu option).
 # The default below is the one line to change (docs/open-items.md: 60 or 30, pending).
+FPS_DIAGNOSTICS ?= 0
 FPS ?= 60
 ifeq ($(filter $(FPS),20 30 60),)
 $(error FPS=$(FPS): the frame rate must be 20, 30 or 60)
 endif
-$(shell mkdir -p $(GEN_DIR); printf '#define FPS %s\n' '$(FPS)' > $(GEN_DIR)/fps.h.tmp; \
+$(shell mkdir -p $(GEN_DIR); printf '#define FPS %s\n#define FPS_DIAGNOSTICS %s\n' '$(FPS)' '$(FPS_DIAGNOSTICS)' > $(GEN_DIR)/fps.h.tmp; \
 	cmp -s $(GEN_DIR)/fps.h.tmp $(GEN_DIR)/fps.h && rm $(GEN_DIR)/fps.h.tmp \
 	|| mv $(GEN_DIR)/fps.h.tmp $(GEN_DIR)/fps.h)
 
diff --git a/include/dw/mod_fps.h b/include/dw/mod_fps.h
index 5e1ae2ca..86b8ed6e 100644
--- a/include/dw/mod_fps.h
+++ b/include/dw/mod_fps.h
@@ -7,16 +7,25 @@
 #include <fps.h> /* FPS: the build's frame rate (Makefile `FPS=20|30|60`, generated) */
 
 /* FPS=20 compiles out extra passes. FPS=30|60 includes the automatic
- * 20/60 selector: boot and idle-time CPU measurements choose the mode.
+ * 20/60 selector: a title workload trial chooses the mode until reset.
  * Logic cadence is independent of this presentation setting. */
 #define MOD_CPU_LINES 16
 #define MOD_CPU_SPINS_FAST 8500
-#define MOD_CPU_SPINS_SLOW 7500
+/* Diagnostic reference only; CPU polling never selects presentation. */
+#define MOD_WORKLOAD_MIN_FPS 40
+void modFrameRateTrial(void);
+#if FPS_DIAGNOSTICS
+extern uint32_t MOD_FPS_TRIAL_SWAPS, MOD_FPS_TRIAL_VBLANKS;
+extern int32_t MOD_FPS_TRIAL_FPS100, MOD_FPS_TRIAL_CPU_SPINS;
+/* Calibration only: vary representative scene complexity in a diagnostic build. */
+extern int32_t MOD_FPS_TRIAL_DRAWS, MOD_FPS_TRIAL_PACKET_BYTES;
+#endif
 int32_t modCpuProbe(void);
 #if FPS == 20
 #define MOD_FPS_MODE 0
 #elif FPS == 30 || FPS == 60
 extern int32_t MOD_FPS_MODE_RUN;
+extern int32_t MOD_FPS_AUTO_MODE; /* Reapply this result when returning from a manual option to AUTO. */
 #define MOD_FPS_MODE MOD_FPS_MODE_RUN
 #else
 #error "FPS must be 20, 30 or 60"
diff --git a/src/main/main.c b/src/main/main.c
index e6e300ee..66bd34fc 100644
--- a/src/main/main.c
+++ b/src/main/main.c
@@ -160,6 +160,7 @@ void modNoticeRender(void);
 void newGameScene(void);
 void initializeLoadedMap(void);
 void recalculatePPandArena(void);
+
 void gameLoop(void);
 void cleanupGame(void);
 void initializePartner(int32_t type, int32_t posX, int32_t posY,
@@ -3703,6 +3704,7 @@ void runLandingScreen(void)
 	SECRET_CODE = -1;
 #endif
 	addObject(0xfa3, 0, NULL, (RenderFunction)renderPressStartToContinue);
+	modFrameRateTrial();
 	modNoticeDraw(); /* MOD (emulator notice) */
 	modVersionDraw(); /* MOD (version) */
 	FADE_OUT_CURRENT = 0;
@@ -4148,7 +4150,7 @@ static void modPerfReset(void)
 /* MOD (fps): fixed-timestep loop. The game logic (input, scripts,
  * tickObjects: movement, clock, timers, animation, then the late tick) runs
  * once per tick, and a tick always lasts 3 vertical refreshes (20 Hz) as in
- * the original. MOD_FPS_MODE (dw/mod_fps.h: fixed 20 or automatic CPU-based
+ * the original. MOD_FPS_MODE (dw/mod_fps.h: fixed 20 or title workload-based
  * selection in an FPS=30|60 build) chooses at which of the tick's three
  * refreshes a new frame is shown:
  *   0 = 20 fps: the third (the original, one render per tick);
@@ -4164,7 +4166,8 @@ static void modPerfReset(void)
  * although no code reads it */
 const int32_t MOD_FPS_BUILD __attribute__((used, retain)) = FPS;
 #if FPS != 20
-int32_t MOD_FPS_MODE_RUN; /* Automatic presentation: safe 20 fps until the boot probe. */
+int32_t MOD_FPS_AUTO_MODE; /* Cached title decision, independent of manual overrides. */
+int32_t MOD_FPS_MODE_RUN; /* Automatic presentation: safe 20 fps until the title workload trial. */
 #endif
 /* test switch (state checks with the slow interpreter CPU, where the extra
  * passes rarely fit): with N > 0 every tick lasts N refreshes instead of 3,
@@ -5350,48 +5353,11 @@ int8_t MOD_LOAD_PUMP;
 int32_t isFileReadQueueBusy(void); /* file_queue.c */
 void tickFileReadQueue(int32_t unused);
 
-/* Automatic presentation. Sample only inside an existing idle wait, with
- * at least 32 scanlines before its next vblank. The probe costs 16 lines.
- * Two agreeing samples, two seconds apart, and separate thresholds prevent
- * boundary noise from switching modes. Reject waits after a long stall: the
- * SDK line count wraps at 65536, so a small value alone is not proof of slack.
- * Unsigned elapsed time handles wrap and restored clocks. No deadlines change. */
-#if FPS != 20
-static uint32_t modCpuLastV;
-static int32_t modCpuVotes;
-
-static void modAutoFrameRateSample(int32_t spins)
-{
-	int32_t change = MOD_FPS_MODE_RUN == 0 ? spins >= MOD_CPU_SPINS_FAST : spins < MOD_CPU_SPINS_SLOW;
-
-	if (!change) {
-		modCpuVotes = 0;
-	} else if (++modCpuVotes >= 2) {
-		MOD_FPS_MODE_RUN = MOD_FPS_MODE_RUN == 0 ? 2 : 0;
-		modCpuVotes = 0;
-	}
-}
-
-static void modAutoFrameRatePoll(void)
-{
-	uint32_t now = VSync(-1);
-
-	if (!MOD_LOAD_PUMP && now - modCpuLastV >= 120 &&
-	    now - (uint32_t)modLastEndV < 120 && VSync(1) < 263 - 2 * MOD_CPU_LINES) {
-		modCpuLastV = now;
-		modAutoFrameRateSample(modCpuProbe());
-	}
-}
-#endif
-
 /* VSync(0), or with MOD_LOAD_PUMP the file queue stepped until the vblank comes (then VSync(0) once nothing is queued) */
 static void modWaitVblank(void)
 {
 	int32_t v;
 
-#if FPS != 20
-	modAutoFrameRatePoll();
-#endif
 
 	if (MOD_LOAD_PUMP) {
 		v = VSync(-1);
@@ -5605,6 +5571,99 @@ void modPresent(int32_t flags, ModRollbackSet *extra)
 	modLastEndLines = modLines();
 }
 
+/* The title has no entities. Its already-loaded medal provides real lit TMD
+ * geometry through the same libgs/GTE/GPU path as world models. Repeating it
+ * represents a small populated scene without map loads or heap allocations.
+ * The normal title quad covers the geometry (OT 30); it is still submitted and
+ * rasterized. Do not move it offscreen: clipping would make this a cheap test.
+ * Use the normal presenter, including rollback, interpolation setup and pass
+ * admission, rather than timing a synthetic spin loop. */
+#if FPS != 20
+extern GsDOBJ2 MEDAL_OBJECT;
+extern GsCOORDINATE2 MEDAL_COORDINATES;
+void drawObject(GsDOBJ2 *obj, GsOT *ot, int32_t flag);
+static int32_t modTrialDone;
+#if FPS_DIAGNOSTICS
+uint32_t MOD_FPS_TRIAL_SWAPS, MOD_FPS_TRIAL_VBLANKS;
+int32_t MOD_FPS_TRIAL_FPS100, MOD_FPS_TRIAL_CPU_SPINS;
+int32_t MOD_FPS_TRIAL_DRAWS = 64;
+int32_t MOD_FPS_TRIAL_PACKET_BYTES;
+#else
+#define MOD_FPS_TRIAL_DRAWS 64
+#endif
+
+static void modTrialRender(int32_t unused)
+{
+    int32_t i;
+    int32_t draws = MOD_FPS_TRIAL_DRAWS;
+    SVECTOR rotation;
+#if FPS_DIAGNOSTICS
+    PACKET *packetStart = GsGetWorkBase();
+#endif
+    if (draws < 1) draws = 1;
+    if (draws > 64) draws = 64;
+    rotation.vx = MOD_FPS_TICKS & 4095;
+    rotation.vy = MOD_RENDER_ALPHA;
+    rotation.vz = 0;
+    rotation.pad = 0;
+    for (i = 0; i < draws; i++) {
+        rotation.vy += 137;
+        RotMatrix(&rotation, &MEDAL_COORDINATES.coord);
+        MEDAL_COORDINATES.coord.t[0] = (i % 8 - 4) * 80;
+        MEDAL_COORDINATES.coord.t[1] = (i / 8 - 4) * 60;
+        MEDAL_COORDINATES.coord.t[2] = 2000;
+        MEDAL_COORDINATES.flg = 0;
+        drawObject(&MEDAL_OBJECT, ACTIVE_ORDERING_TABLE, 2);
+    }
+#if FPS_DIAGNOSTICS
+    MOD_FPS_TRIAL_PACKET_BYTES = (PACKET *)GsGetWorkBase() - packetStart;
+#endif
+}
+#endif
+
+void modFrameRateTrial(void)
+{
+#if FPS != 20
+    uint32_t start, renders, elapsed, swaps;
+    MATRIX saved;
+    extern int32_t MOD_NOTICE;
+    if (modTrialDone) return;
+    saved = MEDAL_COORDINATES.coord;
+    MOD_FPS_MODE_RUN = 2;
+    addObject(0x7f60, 0, NULL, modTrialRender);
+    /* Warm up GPU and pass-cost estimates before starting the 120-vblank
+     * window. All elapsed refreshes count, including late whole ticks. */
+    modTickStart(0);
+    modFpsBeginFrame();
+    modPresent(0, NULL);
+    start = (uint32_t)VSync(-1);
+    renders = (uint32_t)MOD_FPS_RENDERS;
+    do {
+        modTickStart(0);
+        modFpsBeginFrame();
+        modPresent(0, NULL);
+        elapsed = (uint32_t)VSync(-1) - start;
+    } while (elapsed < 120);
+    swaps = (uint32_t)MOD_FPS_RENDERS - renders;
+    MOD_FPS_AUTO_MODE = swaps * 60 >= elapsed * MOD_WORKLOAD_MIN_FPS ? 2 : 0;
+    MOD_FPS_MODE_RUN = MOD_FPS_AUTO_MODE;
+    MOD_NOTICE = (MOD_NOTICE & 1) | (MOD_FPS_MODE_RUN == 0 ? 2 : 0);
+#if FPS_DIAGNOSTICS
+    MOD_FPS_TRIAL_SWAPS = swaps;
+    MOD_FPS_TRIAL_VBLANKS = elapsed;
+    MOD_FPS_TRIAL_FPS100 = swaps * 6000 / elapsed;
+    MOD_FPS_TRIAL_CPU_SPINS = modCpuProbe();
+    /* The old probe updates advice; the workload decision owns that advice. */
+    MOD_NOTICE = (MOD_NOTICE & 1) | (MOD_FPS_MODE_RUN == 0 ? 2 : 0);
+#endif
+    modTrialDone = 1;
+    removeObject(0x7f60, 0);
+    MEDAL_COORDINATES.coord = saved;
+    MEDAL_COORDINATES.flg = 0;
+    modInterpInvalidate();
+#endif
+}
+
 void gameLoop(void)
 {
 	modTickStart(0);
