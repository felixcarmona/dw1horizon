+/* Whether the tamer, boy or girl, wears that choice of a garment (a file that does not say: every one) */
+static int32_t lookPageWorn(int32_t garment, int32_t value)
+{
+	uint32_t who = lookPageState.who[garment][MOD_TAMER_GIRL];
+
+	return who == 0 || ((who >> value) & 1);
+}
+
+/* The next choice of a garment that the tamer wears, from a value on: step 0 keeps one that is worn */
+static int32_t lookPageNext(int32_t garment, int32_t value, int32_t step)
+{
+	int32_t n = lookPageState.count[3 + 2 * garment];
+	int32_t i;
+
+	value %= n;
+	for (i = 0; i < n; i++) {
+		if (step != 0 || i != 0) {
+			value = (value + n + (step < 0 ? -1 : 1)) % n;
+		}
+		if (lookPageWorn(garment, value)) {
+			break;
+		}
+	}
+	return value;
+}
