 src/main/game_menu.c   | 115 ++++++++++++++++++++++++++++-------------
 src/main/mod_species.c |   2 +-
 text/main/mod_lab.yaml |  24 ++++-----
 4 files changed, 93 insertions(+), 55 deletions(-)

