 src/main/sound.c       |  3 ++
 src/main/sound_async.c | 52 +++++++++++++++++++++++++++++++++++
 src/main/tamer.c       | 15 +++++++++-
 src/main/tfs_stream.c  | 62 ++++++++++++++++++++++++++++++++++++++----
 src/shop/script_menu.c |  4 +++
 6 files changed, 138 insertions(+), 6 deletions(-)

diff --git a/src/main/btl.c b/src/main/btl.c
index a932046..0e36369 100644
--- a/src/main/btl.c
+++ b/src/main/btl.c
@@ -19,6 +19,7 @@
 #include <dw/script.h>
 #include <dw/sound.h>
 #include <dw/sound_async.h>
+#include <dw/tfs_stream.h> /* MOD (post-battle stall) */
 #include <dw/types.h>
 #include <dw/utils.h>
 #include <dw/version.h>
@@ -389,6 +390,13 @@ void modBtlPreloadTick(void)
 	if (GAME_STATE != 0 || IS_SCRIPT_PAUSED != 1 || !isFileReadQueueIdle()) {
 		return;
 	}
+	/*
+	 * MOD (post-battle stall): nor while a background tile is being read: queueing waits for that read (tfsStreamCheckTarget),
+	 * and the first one after a battle seeks from the music font, up to 0.7 s with the picture standing still
+	 */
+	if (tfsStreamBusy()) {
+		return;
+	}
 	MOD_BTL_PRELOAD = 1;
 	loadDynamicLibrary(BTL_REL, &modBtlPreloadReading, 1, (FileCallback)modBtlPreloaded, NULL);
 }
