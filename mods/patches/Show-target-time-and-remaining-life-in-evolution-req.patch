 typedef struct {
@@ -4844,6 +4845,7 @@ typedef struct {
 } ChartCardLine;
 static ChartCardLine CHART_CARD[CHART_CARD_LINES];
 static int16_t CHART_PACK_U, CHART_PACK_V;
+static ChartCell CHART_LIFE; /* fixed red warning, independent of scrolling */
 static int8_t CHART_CARD_MINE;		/* the card is of the partner's tree */
 static int8_t CHART_TEXT_TAKEN;		/* the card wrote over the overview's rows */
 static int16_t CHART_CARD_VERDICT_W;
@@ -4914,6 +4916,14 @@ static const char CHART_POPUP_WEIGHT[] __attribute__((section(".rodata.CHART_POP
 #define CHART_TEXT_WEIGHT ((char *)CHART_POPUP_WEIGHT)
 static const char CHART_POPUP_YES[] __attribute__((section(".rodata.CHART_POPUP_YES"))) = CHART_STR_YES;
 #define CHART_TEXT_YES ((char *)CHART_POPUP_YES)
+static const char CHART_POPUP_TIME[] __attribute__((section(".rodata.CHART_POPUP_TIME"))) = CHART_STR_TIME;
+#define CHART_TEXT_TIME ((char *)CHART_POPUP_TIME)
+static const char CHART_POPUP_WAIT[] __attribute__((section(".rodata.CHART_POPUP_WAIT"))) = CHART_STR_WAIT;
+#define CHART_TEXT_WAIT ((char *)CHART_POPUP_WAIT)
+static const char CHART_POPUP_LIFE[] __attribute__((section(".rodata.CHART_POPUP_LIFE"))) = CHART_STR_LIFE;
+#define CHART_TEXT_LIFE ((char *)CHART_POPUP_LIFE)
+static const char CHART_POPUP_SPECIAL[] __attribute__((section(".rodata.CHART_POPUP_SPECIAL"))) = CHART_STR_SPECIAL;
+#define CHART_TEXT_SPECIAL ((char *)CHART_POPUP_SPECIAL)
 static char *CHART_STAT_NAMES[6] = { CHART_TEXT_STAT_HP,  CHART_TEXT_STAT_MP,  CHART_TEXT_STAT_OFF,
 				      CHART_TEXT_STAT_DEF, CHART_TEXT_STAT_SPD, CHART_TEXT_STAT_BRN };
 
@@ -4997,26 +5007,17 @@ static __attribute__((noinline)) char *chartRange(char *p, char *label, int32_t
 
 #define CHART_NO_VALUE	-32768	/* a line without a number */
 
-/* copies `str` to `p`, returns the end */
-static __attribute__((noinline)) char *chartAppend(char *p, char *str)
-{
-	while (*str != 0) {
-		*p++ = *str++;
-	}
-	*p = 0;
-	return p;
-}
-
 /* Pack normal-width strings into the borrowed rows once, before any sprite is submitted.
  * Fixed title/headers/footer use the rows above CHART_CARD_TITLE_ROW. */
-static ChartCell chartCardText(char *text)
+static __attribute__((noinline)) ChartCell chartCardText(char *text, int32_t maxWidth)
 {
 	ChartCell cell;
-	cell.w = measureStringMode(text, FIT_VANILLA);
+	int32_t mode = fitStringMode(text, maxWidth);
+	cell.w = measureStringMode(text, mode);
 	if (CHART_PACK_U + cell.w > 244) { CHART_PACK_U = 0; CHART_PACK_V += 12; }
 	cell.u = CHART_PACK_U;
 	cell.v = CHART_PACK_V;
-	drawStringMode(text, cell.u, cell.v, FIT_VANILLA);
+	drawStringMode(text, cell.u, cell.v, mode);
 	CHART_PACK_U += (cell.w + 7) & ~3;
 	return cell;
 }
@@ -5038,16 +5039,51 @@ static __attribute__((noinline)) void chartCardLine(char *label, int32_t have, i
 	split = strrchr(name, ' ');
 	if (k && split && ((split[1] >= '0' && split[1] <= '9') || split[1] == '-')) {
 		*split = 0;
-		l->need = chartCardText(split + 1);
+		l->need = chartCardText(split + 1, 140);
 	}
 	if (k == 0) {
 		l->label.w = drawStringMode(name, 0, CHART_CARD_TITLE_ROW, FIT_VANILLA);
 		l->label.u = 0; l->label.v = CHART_CARD_TITLE_ROW;
-	} else l->label = chartCardText(name);
+	} else l->label = chartCardText(name, word ? 280 - 41 - indent - 4 - measureStringMode(word, FIT_VANILLA) : 244);
 	if (CHART_CARD_MINE && (word != NULL || have != CHART_NO_VALUE)) {
 		if (word == NULL) { chartNumber(buf, have); word = buf; }
-		l->value = chartCardText(word);
+		l->value = chartCardText(word, 80);
+	}
+}
+
+/* Earliest natural check for this exact pair, in evoTimer hours. A negative
+ * result is a special/item route, never a promise based on the four marks.
+ * Mirrors tickConditions' outer gate and getNaturalEvolutionTarget's branches;
+ * use the live rule tables, including disabled (-1) gates. */
+static __attribute__((noinline)) int32_t chartTargetHours(int32_t target)
+{
+	int32_t from = CHART_DETAIL_ID, level = DIGI_PARA(from).level;
+	int32_t hours, i, timed = 0;
+	EvolutionPath *path;
+	if (level < LEVEL_FRESH || level > LEVEL_ULTIMATE || MOD_EVO_TIMING[level] < 0) return -1;
+	hours = MOD_EVO_TIMING[level];
+	if (level == LEVEL_FRESH) return getFreshEvolutionTarget(from) == target ? hours : -1;
+	if (level == LEVEL_ULTIMATE) {
+		for (i = 0; i < MOD_EVO_PAIR_MAX; i++) {
+			if (MOD_EVO_ULTIMATE[i][0] == from && MOD_EVO_ULTIMATE[i][1] == target) { timed = 1; break; }
+		}
+		if (!timed) {
+			if (MOD_EVO_TIMING[MOD_EVO_ULTIMATE_AGAIN] < 0) return -1;
+			if (hours < MOD_EVO_TIMING[MOD_EVO_ULTIMATE_AGAIN]) hours = MOD_EVO_TIMING[MOD_EVO_ULTIMATE_AGAIN];
+		}
+		/* Only original timed-pair Megas (Machinedramon) skip the Mega wait. */
+		if (DIGI_PARA(target).level == LEVEL_MEGA && (!timed || !isVanillaSpecies(target)) &&
+		    hours < MOD_EVO_TIMING[MOD_EVO_MEGA]) hours = MOD_EVO_TIMING[MOD_EVO_MEGA];
+		if (timed) return hours;
 	}
+	path = getEvolutionPath(from);
+	for (i = 0; i < 6; i++) if (path->to[i] == target) return hours;
+	if (level == LEVEL_ROOKIE && target == MOD_EVO_TIMING[MOD_EVO_FALLBACK_TARGET] &&
+	    MOD_EVO_TIMING[MOD_EVO_FALLBACK_HOURS] >= 0) {
+		if (hours < MOD_EVO_TIMING[MOD_EVO_FALLBACK_HOURS]) hours = MOD_EVO_TIMING[MOD_EVO_FALLBACK_HOURS];
+		return hours;
+	}
+	return -1;
 }
 
 /* the card of evolving into `target`: drawn into the text area when the target or the centre changes */
@@ -5067,6 +5103,7 @@ static __attribute__((noinline)) void chartCardBuild(int32_t target)
 	int32_t have;
 	int32_t top;
 	int32_t statCount;
+	int32_t hours, left;
 	int16_t req[6];
 
 	setRECT(&rect, 0, CHART_CARD_ROW, 256, CHART_CARD_HEADER_ROW + 12 - CHART_CARD_ROW);
@@ -5074,7 +5111,7 @@ static __attribute__((noinline)) void chartCardBuild(int32_t target)
 	CHART_TEXT_TAKEN = 1;
 	CHART_CARD_COUNT = 0;
 	CHART_PACK_U = 0; CHART_PACK_V = CHART_CARD_ROW;
-	CHART_CARD_VERDICT_W = CHART_CARD_FOOTER_W = 0;
+	CHART_CARD_VERDICT_W = CHART_CARD_FOOTER_W = CHART_LIFE.w = 0;
 	CHART_CARD_MINE = chartIsPartnerTree();
 	r = EVO_REQ_ROW(target);
 	st = &PARTNER_ENTITY.digimonEntity.stats.base;
@@ -5087,6 +5124,17 @@ static __attribute__((noinline)) void chartCardBuild(int32_t target)
 	sprintf(a, CHART_TEXT_EVOLVE, hasDigimonRaised((uint16_t)target) ? (char *)digimonPara(target) : "?????");
 	chartCardLine(a, CHART_NO_VALUE, 1, 0, 0, NULL);
 	CHART_CARD_MINE = chartIsPartnerTree();
+	hours = chartTargetHours(target);
+	left = hours < 0 ? 0 : hours - PARTNER_PARA.evoTimer;
+	if (hours >= 0) {
+		/* Same Needs/Have columns and marks as the requirement rows. */
+		sprintf(a, "%s %d", CHART_TEXT_TIME, hours);
+		chartCardLine(a, PARTNER_PARA.evoTimer, left <= 0, 1, 0, NULL);
+		if (CHART_CARD_MINE && PARTNER_PARA.remainingLifetime < left) {
+			sprintf(a, CHART_TEXT_LIFE, PARTNER_PARA.remainingLifetime);
+			CHART_LIFE = chartCardText(a, 244);
+		}
+	} else chartCardLine(CHART_TEXT_SPECIAL, CHART_NO_VALUE, 0, 0, 0, NULL);
 	if (chartIsAutomatic(&r)) {
 		chartCardLine(CHART_TEXT_AUTOMATIC, CHART_NO_VALUE, 1, 1, 0, NULL);
 		return;
@@ -5182,9 +5230,9 @@ static __attribute__((noinline)) void chartCardBuild(int32_t target)
 		k = ((met & EVO_MET_CARE) != 0) + ((met & EVO_MET_WEIGHT) != 0) + ((met & EVO_MET_STATS) != 0) +
 		    ((met & EVO_MET_BONUS) != 0);
 		sprintf(a, CHART_TEXT_VERDICT, k, evoPassPoints());
-		if (evoRequirementPoints(met) >= evoPassPoints() && isPartnerModelFit(target)) {
-			chartAppend(a + strlen(a), CHART_TEXT_READY);
-			CHART_CARD_VERDICT_COLOR = 7;
+		if (evoRequirementPoints(met) >= evoPassPoints() && isPartnerModelFit(target) && hours >= 0) {
+			sprintf(a + strlen(a), left > 0 ? CHART_TEXT_WAIT : CHART_TEXT_READY, left);
+			CHART_CARD_VERDICT_COLOR = left > 0 ? 6 : 7;
 		} else {
 			CHART_CARD_VERDICT_COLOR = 6;
 		}
@@ -5294,6 +5342,7 @@ static __attribute__((noinline)) void chartCardRender(int32_t target)
 		chartCellRender(&l->value, 280 - l->value.w, y, l->valueColor);
 		if (l->mark) chartMark(30, y + 3, l->mark == 1);
 	}
+	chartCellRender(&CHART_LIFE, 28, 185, 6);
 	if (CHART_CARD_FOOTER_W)
 		renderString(0, 28 - 160, 197 - 120, CHART_CARD_FOOTER_W, 12, 0, CHART_CARD_FOOTER_ROW, 2, 1);
 	chartCardPrompt(1);
