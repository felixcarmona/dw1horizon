+		p = putRecord(p, SAVE_TAG_TAMER_LOOK, swap, 5);
 	}
 	{ uint8_t layout = 1; p = putRecord(p, SAVE_TAG_TECHNIQUE_LAYOUT, &layout, 1); }
 	/* MOD (tier 2): the story state's records go here */
@@ -5537,6 +5540,10 @@ static void applyRecords(uint8_t *e)
 				MOD_TAMER_LOOK = d[0];
 				MOD_TAMER_HAIR = d[1];
 				MOD_TAMER_FACE = len >= 3 && d[2] < TAMER_FACE_COUNT ? d[2] : 0;
+				if (len >= 5 && d[3] < TAMER_SHIRT_COUNT && d[4] < TAMER_CLOTH_COUNT) {
+					MOD_TAMER_SHIRT = d[3];
+					MOD_TAMER_CLOTH = d[4];
+				}
 			}
 			break;
 		case SAVE_TAG_GROUND_PICKUP_BITS:
diff --git a/src/main/mod_species.c b/src/main/mod_species.c
index c16ac0d..f2a91c9 100644
--- a/src/main/mod_species.c
+++ b/src/main/mod_species.c
@@ -1027,6 +1027,8 @@ void modSmoothMapReset(void);
 uint8_t MOD_TAMER_LOOK;
 uint8_t MOD_TAMER_HAIR;
 uint8_t MOD_TAMER_FACE;
+uint8_t MOD_TAMER_SHIRT;
+uint8_t MOD_TAMER_CLOTH;
 static uint32_t TAMER_COLD_READY;	/* the entry the buffer's tail holds */
 static uint16_t TAMER_COLD_SECTOR;	/* 0: the loaded tamer has no cold entries */
 static uint8_t TAMER_COLD_CACHED;
