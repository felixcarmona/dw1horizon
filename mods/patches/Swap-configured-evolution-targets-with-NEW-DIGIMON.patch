From 4089aa216a36f6853292da0e7b729f519470b2e8 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Wed, 4 Nov 2026 21:51:24 +0000
Subject: [PATCH] Swap configured evolution targets with NEW DIGIMON

---
 include/dw/species.h   |  3 +++
 src/main/mod_species.c | 16 ++++++++++++++++
 2 files changed, 19 insertions(+)

diff --git a/include/dw/species.h b/include/dw/species.h
index dfefc5e..9ed4b5e 100644
--- a/include/dw/species.h
+++ b/include/dw/species.h
@@ -101,6 +101,9 @@ typedef struct {
  */
 #define SPECIES_HEADER_LEVEL_OFF	0x500
 #define SPECIES_LEVEL_SWAP_MAX	32
+/* Header: u16 count, then {u16 id, u16 on[6], u16 off[6]}. */
+#define SPECIES_HEADER_STATS_OFF 0x580
+#define SPECIES_STATS_SWAP_MAX 19
 void modApplySpeciesLevels(void);
 /* the level the original game gives a species (its NEW DIGIMON off level): the original evolution items keep their rule with it */
 int32_t modOriginalLevel(int32_t type);
diff --git a/src/main/mod_species.c b/src/main/mod_species.c
index dc479df..6c94ba8 100644
--- a/src/main/mod_species.c
+++ b/src/main/mod_species.c
@@ -65,14 +65,30 @@ static int8_t SPECIES_HAS_VANILLA;
 /* MOD (canon levels): {id, level with NEW DIGIMON on, off} (SPECIES_HEADER_LEVEL_OFF) */
 static uint8_t SPECIES_LEVEL_SWAP[SPECIES_LEVEL_SWAP_MAX][3];
 static int32_t SPECIES_LEVEL_SWAPS;
+static void readSpeciesSector(int32_t sector);
 
 void modApplySpeciesLevels(void)
 {
 	int32_t i;
+	int32_t j;
+	uint16_t *row;
+	int16_t *target;
 
 	for (i = 0; i < SPECIES_LEVEL_SWAPS; i++) {
 		DIGIMON_DATA[SPECIES_LEVEL_SWAP[i][0]].level = SPECIES_LEVEL_SWAP[i][MOD_OPT_NEW_DIGIMON ? 1 : 2];
 	}
+	/* Read targets on demand: the shared sector buffer costs no additional heap. */
+	if (!SPECIES_INDEX_SECTOR) return;
+	readSpeciesSector(0);
+	row = (uint16_t *)((uint8_t *)SPECIES_SECTOR + SPECIES_HEADER_STATS_OFF);
+	j = *row++;
+	if (j > SPECIES_STATS_SWAP_MAX) j = SPECIES_STATS_SWAP_MAX;
+	for (i = 0; i < j; i++, row += 13) {
+		int32_t k;
+		if (row[0] >= NUM_ORIGINAL_DIGIMON) continue;
+		target = &EVOLUTION_STATS_GAINS[row[0]].hp;
+		for (k = 0; k < 6; k++) target[k] = row[1 + (MOD_OPT_NEW_DIGIMON ? 0 : 6) + k];
+	}
 }
 
 int32_t modOriginalLevel(int32_t type)
-- 
2.55.0

