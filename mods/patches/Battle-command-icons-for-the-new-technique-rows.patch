From d7f1610856c7684a1ee20541e911f70a8961c0a7 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Fri, 27 Nov 2026 17:57:25 +0000
Subject: [PATCH] Battle command icons for the five new technique rows

The command ring read the element icon table past its seven rows: Darkness drew a cell outside BTLCOMND and
the other new rows read past the table. Each element now has its icon (tools/battle_icon_art.py) with the
Techset's palettes; Weapon and Earth blink with their second palette.
---
 include/dw/tech_row_icons.h | 40 +++++++++++++++++++++++++++++++++++++
 src/btl/battle_hud.c        |  6 ++++--
 src/btl/battle_main.c       |  5 +++--
 src/btl/command_menu.c      |  6 ++----
 src/std/std_main.c          | 13 ++++++------
 src/vs/vs_hud.c             |  6 ++----
 src/vs/vs_main.c            |  8 +++++---
 7 files changed, 62 insertions(+), 22 deletions(-)
 create mode 100644 include/dw/tech_row_icons.h

diff --git a/include/dw/tech_row_icons.h b/include/dw/tech_row_icons.h
new file mode 100644
index 0000000..175e7c3
--- /dev/null
+++ b/include/dw/tech_row_icons.h
@@ -0,0 +1,40 @@
+#ifndef DW_TECH_ROW_ICONS_H
+#define DW_TECH_ROW_ICONS_H
+
+#include <dw/ids.h>
+
+/* MOD (new technique rows): the battle command icons of Darkness, Light, Water, Weapon and Earth (elements 7..11),
+ * the same in the field fight, the tournament and the versus fight. Their tiles are in BTLCOMND cells nothing used
+ * (tools/battle_icon_art.py holds the same numbers) and they draw with the Techset's palettes in SYSTEM_W
+ * (tools/localize/tech_rows_art.py), so both screens show the same icon. Darkness, Light and Water blink to their
+ * small tile 16 texels right, as the original icons do; Weapon and Earth have one tile and blink with their second
+ * palette, as on the Techset. */
+#define TECH_ROW_BATTLE_ICON_UVS	{ 223, 0xdb }, { 200, 0xee }, { 83, 0xf0 }, { 115, 0xf0 }, { 232, 0xee }
+#define TECH_ROW_BATTLE_CLUT		0x3f56
+#define TECH_ROW_BATTLE_CLUT_ONE	0x3f96	/* Weapon and Earth */
+#define TECH_ROW_BATTLE_CLUT_BLINK	0x3fd6	/* their other frame */
+
+/* the window and palette of the icon of element `eff` (the original table has 0..6; anything else draws Fire's) */
+#define TECH_ROW_SET_ICON(prim, table, eff)                                                                          \
+	do {                                                                                                         \
+		int32_t e_ = (uint32_t)(eff) < NUM_ELEMENTS ? (eff) : 0;                                             \
+		setUVWH(prim, table[e_][0], table[e_][1], 0x10, 0xf);                                                \
+		if (e_ >= NEW_ELEMENT_FIRST) {                                                                       \
+			(prim)->clut = e_ >= NEW_ELEMENT_FIRST + 3 ? TECH_ROW_BATTLE_CLUT_ONE : TECH_ROW_BATTLE_CLUT; \
+		}                                                                                                    \
+	} while (0)
+
+/* the chosen command's blink: one window right, or Weapon's and Earth's other palette */
+#define TECH_ROW_BLINK_ICON(prim)                                       \
+	do {                                                            \
+		if ((prim)->clut == TECH_ROW_BATTLE_CLUT_ONE) {         \
+			(prim)->clut = TECH_ROW_BATTLE_CLUT_BLINK;      \
+		} else {                                                \
+			(prim)->u0 += 0x10;                             \
+			(prim)->u1 += 0x10;                             \
+			(prim)->u2 += 0x10;                             \
+			(prim)->u3 += 0x10;                             \
+		}                                                       \
+	} while (0)
+
+#endif
