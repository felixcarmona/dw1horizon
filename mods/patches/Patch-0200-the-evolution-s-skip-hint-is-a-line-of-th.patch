+	(void)data;
+	modEvoSkipInput();
 
 	switch (data->state) {
 	case 0:
@@ -74,7 +72,7 @@ void renderEvoSequenceLoading(int32_t instanceId)
 	EvoSequenceData *data;
 
 	data = &EVO_SEQUENCE_DATA;
-	if (MOD_EVO_SKIP == 1) {
