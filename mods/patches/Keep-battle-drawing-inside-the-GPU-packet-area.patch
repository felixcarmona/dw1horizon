From 0029cdf42e0541974f901563fc106ec161e8744a Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Thu, 12 Nov 2026 10:30:49 +0000
Subject: [PATCH] Keep battle drawing inside the GPU packet area

A triple battle with a big partner and an all-range technique (Machinedramon's All Range Beam on three Vermilimon or Golemon at Mt. Infinity) froze the game. Four large models, the technique's EFE models, then its particles and damage numbers wrote past the 81,920-byte packet area of the frame: into the other frame's packets while the GPU drew them, or into the ordering-table headers. Nothing in the original checks that area. modPacketFits (world_object.c) now answers whether a draw fits, keeping 8 KB for the unchecked HUD renderers, and the renderers that can emit many packets skip the draw (never the logic) when it does not: model bones, EFE models and sprites, FX particles, particle flashes, entity particles, damage digits and numbers. A cursor outside the frame's area always fits, so loops that draw elsewhere are unchanged.
---
 include/dw/world_object.h | 13 +++++++++++++
 src/btl/battle_effect.c   | 22 +++++++++++++++++-----
 src/main/efe.c            |  8 ++++++++
 src/main/map.c            |  6 ++++++
 src/main/model.c          |  5 +++++
 src/main/utils.c          |  6 ++++++
 src/main/utils2.c         | 10 ++++++++++
 src/main/world_object.c   | 19 +++++++++++++++++++
 8 files changed, 84 insertions(+), 5 deletions(-)

diff --git a/include/dw/world_object.h b/include/dw/world_object.h
index 3ba16b6..0fb9833 100644
--- a/include/dw/world_object.h
+++ b/include/dw/world_object.h
@@ -39,4 +39,17 @@ int32_t removeObject(/* int32_t objectId, int32_t instanceId */);
 void tickObjects(void);
 void renderObjects(void);
 
+/* MOD (packet budget): each framebuffer has an 81,920-byte GPU packet area
+ * (GS_WORK_BASES) and nothing in the original checks it. A triple battle with
+ * a big partner and an all-range technique (four large models, the EFE, then
+ * particles and damage numbers) wrote past it: into the other frame's packets
+ * while the GPU drew them, or into the ordering-table headers, and the game
+ * froze. Renderers that can emit many packets ask first and skip the draw
+ * (never the logic) when it would not fit. MOD_PACKET_RESERVE is kept for the
+ * unchecked HUD renderers, about 6.3 KB in that battle, wherever they fall in
+ * the object order. A cursor outside this frame's area (a loop drawing
+ * elsewhere) always fits. */
+#define MOD_PACKET_RESERVE	0x2000
+int32_t modPacketFits(int32_t bytes);
+
 #endif
diff --git a/src/btl/battle_effect.c b/src/btl/battle_effect.c
index 3e9e251..dcd9e25 100644
--- a/src/btl/battle_effect.c
+++ b/src/btl/battle_effect.c
@@ -3708,7 +3708,10 @@ void BTL_drawTMDScreenSpace(void)
 	GsLinkObject4((unsigned long)EFE_DATA_ITERATOR->model->modelPtr->obj, &EFE_SCRATCH->obj, EFE_SCRATCH->id);
 	EFE_SCRATCH->obj.coord2 = NULL;
 	EFE_SCRATCH->obj.attribute = 0;
-	GsSortObject4(&EFE_SCRATCH->obj, ACTIVE_ORDERING_TABLE, 2, EFE_SORT_WORKSPACE);
+	/* MOD (packet budget): at most one POLY_GT4 per primitive (attribute 0) */
+	if (modPacketFits(((struct TMD_STRUCT *)EFE_SCRATCH->obj.tmd)->primn * sizeof(POLY_GT4))) {
+		GsSortObject4(&EFE_SCRATCH->obj, ACTIVE_ORDERING_TABLE, 2, EFE_SORT_WORKSPACE);
+	}
 }
 
 void BTL_loadClutColors(void)
@@ -3767,7 +3770,10 @@ void BTL_drawTMDYXZ(void)
 	GsLinkObject4((unsigned long)EFE_DATA_ITERATOR->model->modelPtr->obj, &EFE_SCRATCH->obj, EFE_SCRATCH->id);
 	EFE_SCRATCH->obj.coord2 = NULL;
 	EFE_SCRATCH->obj.attribute = 0;
-	GsSortObject4(&EFE_SCRATCH->obj, ACTIVE_ORDERING_TABLE, 2, EFE_SORT_WORKSPACE);
+	/* MOD (packet budget): at most one POLY_GT4 per primitive (attribute 0) */
+	if (modPacketFits(((struct TMD_STRUCT *)EFE_SCRATCH->obj.tmd)->primn * sizeof(POLY_GT4))) {
+		GsSortObject4(&EFE_SCRATCH->obj, ACTIVE_ORDERING_TABLE, 2, EFE_SORT_WORKSPACE);
+	}
 }
 
 void BTL_getCameraRotation(void)
@@ -5091,7 +5097,9 @@ void BTL_renderProjectedSprite(void)
 		EFE_SPRITE_SCRATCH->sprite.scalex = ((uint32_t)(EFE_SPRITE_SCRATCH->sprite.scalex * VIEWPORT_DISTANCE) << 5) / (uint32_t)EFE_SPRITE_SCRATCH->otz;
 		EFE_SPRITE_SCRATCH->sprite.scaley = ((uint32_t)(EFE_SPRITE_SCRATCH->sprite.scaley * VIEWPORT_DISTANCE) << 5) / (uint32_t)EFE_SPRITE_SCRATCH->otz;
 		EFE_SPRITE_SCRATCH->otz = (EFE_SPRITE_SCRATCH->otz - 0xa) >> 2;
-		if (EFE_SPRITE_SCRATCH->otz >= 0x20 && EFE_SPRITE_SCRATCH->otz < 0x1000) {
+		/* MOD (packet budget): a sprite is a POLY_FT4 plus a DR_MODE at most */
+		if (EFE_SPRITE_SCRATCH->otz >= 0x20 && EFE_SPRITE_SCRATCH->otz < 0x1000 &&
+		    modPacketFits(sizeof(POLY_FT4) + sizeof(DR_MODE))) {
 			GsSortSprite(&EFE_SPRITE_SCRATCH->sprite, ACTIVE_ORDERING_TABLE, (uint16_t)EFE_SPRITE_SCRATCH->otz);
 		}
 	}
@@ -5202,7 +5210,8 @@ void BTL_renderScreenSprite(void)
 #if VERSION_EQUAL_OR_OLDER(JP_TRIAL)
 	GsSortSprite(&sprite, ACTIVE_ORDERING_TABLE, (uint16_t)depth);
 #else
-	if ((depth >= 0) && (depth < 0x1000)) {
+	/* MOD (packet budget): a sprite is a POLY_FT4 plus a DR_MODE at most */
+	if ((depth >= 0) && (depth < 0x1000) && modPacketFits(sizeof(POLY_FT4) + sizeof(DR_MODE))) {
 		GsSortSprite(&sprite, ACTIVE_ORDERING_TABLE, (uint16_t)depth);
 	}
 #endif
@@ -5584,7 +5593,10 @@ void BTL_drawTMD(void)
 	GsLinkObject4((unsigned long)EFE_DATA_ITERATOR->model->modelPtr->obj, &EFE_SCRATCH->obj, EFE_SCRATCH->id);
 	EFE_SCRATCH->obj.coord2 = NULL;
 	EFE_SCRATCH->obj.attribute = 0;
-	GsSortObject4(&EFE_SCRATCH->obj, ACTIVE_ORDERING_TABLE, 2, EFE_SORT_WORKSPACE);
+	/* MOD (packet budget): at most one POLY_GT4 per primitive (attribute 0) */
+	if (modPacketFits(((struct TMD_STRUCT *)EFE_SCRATCH->obj.tmd)->primn * sizeof(POLY_GT4))) {
+		GsSortObject4(&EFE_SCRATCH->obj, ACTIVE_ORDERING_TABLE, 2, EFE_SORT_WORKSPACE);
+	}
 }
 
 void BTL_initializeSubEffectInstructions(void)
