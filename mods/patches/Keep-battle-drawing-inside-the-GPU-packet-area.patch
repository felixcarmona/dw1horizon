+++ b/src/main/utils2.c
@@ -25,6 +25,8 @@
 #include <dw/ui.h>
 #include <dw/utils.h>
 #include <dw/version.h>
+
+int32_t modPacketFits(int32_t bytes); /* MOD (packet budget): dw/world_object.h */
