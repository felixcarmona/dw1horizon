+		return;
+	}
 	prim = (POLY_FT4 *)GsGetWorkBase();
 
 	for (j = 0; j <= rows; j++) {
diff --git a/src/main/map.c b/src/main/map.c
index c842ec2..3ec13b2 100644
--- a/src/main/map.c
+++ b/src/main/map.c
@@ -29,6 +29,8 @@
 #include <dw/utils.h>
