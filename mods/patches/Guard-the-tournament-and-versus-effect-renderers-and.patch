+				if ((EFE_PROJ_SCRATCH->flag & 0x80000000) == 0 && modPacketFits(sizeof(POLY_FT4))) {
 					((int32_t *)prim)[1] = STD_RADIAL_WAVE_COLOR;
 					prim->clut = EFE_WAVE_SCRATCH->clut;
 					prim->tpage = EFE_WAVE_SCRATCH->tpage;
