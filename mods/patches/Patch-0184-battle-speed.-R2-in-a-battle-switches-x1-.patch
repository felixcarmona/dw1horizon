 void modTickStart(int32_t flags);
 void modPresent(int32_t flags, ModRollbackSet *extra);
 
+/* MOD (battle speed, main.c): the R2 switch; set before modTickStart when the coming tick may run fast (it clears
+ * it); the tick that is running is fast; 0 on a fast pair's second tick */
+extern int8_t MOD_BATTLE_FAST;
+extern int8_t MOD_BATTLE_FAST_TICK;
+extern int8_t MOD_TICK_FAST;
+extern int8_t MOD_REAL_TICK;
+
 extern int32_t MOD_RENDER_PASS;
 extern int32_t MOD_RENDER_MULTIPASS;
 /* rand() for render code: the real one on the first pass of a tick */
diff --git a/src/btl/battle_hud.c b/src/btl/battle_hud.c
index 2627b97c..f57f3735 100644
--- a/src/btl/battle_hud.c
+++ b/src/btl/battle_hud.c
@@ -331,7 +331,11 @@ void BTL_tickFinisherChargeup(void)
 	}
 
 	if ((COMBAT_DATA_PTR->player.finisherChargeup[0] < BM(CHG_MAX)) && (up != 0)) {
-		COMBAT_DATA_PTR->player.finisherChargeup[0] += BM(CHG_PRESS);
+		/* MOD (battle speed): at x2 the window lasts half the real time, so a press counts twice */
+		COMBAT_DATA_PTR->player.finisherChargeup[0] += MOD_TICK_FAST ? 2 * BM(CHG_PRESS) : BM(CHG_PRESS);
+		if (COMBAT_DATA_PTR->player.finisherChargeup[0] > BM(CHG_MAX)) {
+			COMBAT_DATA_PTR->player.finisherChargeup[0] = BM(CHG_MAX);
+		}
 	}
 }
 
@@ -1295,6 +1299,7 @@ void BTL_initializePartnerStatusBars(void)
 	BTL_FINISHER_READY = 0;
 	BTL_HP_BAR_STEP = BTL_MP_BAR_STEP = 0;
 	addObject(0x19c, 0, (TickFunction)BTL_tickPartnerStatusBars, (RenderFunction)BTL_renderPartnerStatusBars);
+	addObject(0x19b, 0, NULL, (RenderFunction)BTL_renderSpeedPlate); /* MOD (battle speed) */
 }
 
 void BTL_tickPartnerStatusBars(void)
@@ -1397,4 +1402,94 @@ void BTL_renderPartnerStatusBars(int16_t idx)
 void BTL_removePartnerStatusBars(void)
 {
 	removeObject(0x19c, 0);
+	removeObject(0x19b, 0); /* MOD (battle speed) */
+}
+
+/* MOD (battle speed): R2 switches the fight between x1 and x2 (MOD_BATTLE_FAST, main.c). The fight is held at x1
+ * while the item menu is open or an item is in hand, and while the defeat countdown runs (its seconds stay real).
+ * A plate in the bottom right corner, in the digital clock's style, shows "R2 x1" (white) or "R2 x2" (yellow; grey
+ * while held). Each row of a glyph is 3 bits, bit 2 the left column. */
+extern int32_t IS_INVENTORY_INITIALIZED;
+extern int16_t DEATH_COUNTDOWN;
+
+static const uint8_t BTL_SPEED_GLYPHS[4][5] = {
+	{ 6, 5, 6, 5, 5 }, /* R */
+	{ 7, 1, 7, 4, 7 }, /* 2 */
+	{ 0, 0, 5, 2, 5 }, /* x */
+	{ 2, 6, 2, 2, 7 }, /* 1 */
+};
+
+static int32_t BTL_modSpeedHeld(void)
+{
+	return IS_INVENTORY_INITIALIZED == 1 || TAMER_ITEM.worldItem.type != ITEM_NONE || DEATH_COUNTDOWN != 0;
+}
+
+static void BTL_addSpeedRect(int32_t x, int32_t y, int32_t w, int32_t h, int32_t r, int32_t g, int32_t b, int32_t z)
+{
+	POLY_F4 *p;
+
+	p = (POLY_F4 *)GsGetWorkBase();
+	SetPolyF4(p);
+	setRGB0(p, r, g, b);
+	setXYWH(p, x, y, w, h);
+	AddPrim(ACTIVE_ORDERING_TABLE->org + z, p++);
+	GsSetWorkBase((PACKET *)p);
+}
+
+static void BTL_addSpeedGlyph(int32_t x, int32_t y, int32_t glyph, int32_t r, int32_t g, int32_t b)
+{
+	int32_t row;
+	int32_t col;
+	int32_t bits;
+
+	for (row = 0; row < 5; row++) {
+		bits = BTL_SPEED_GLYPHS[glyph][row];
+		for (col = 0; col < 3; col++) {
+			if (bits & (4 >> col)) {
+				BTL_addSpeedRect(x + col, y + row, 1, 1, r, g, b, 4);
+			}
+		}
+	}
+}
+
+/* the plate is 23 x 9 pixels; a later prim at the same depth is drawn under an earlier one, so edge, inside and
+ * letters go 6, 5, 4 */
+void BTL_renderSpeedPlate(void)
+{
+	int32_t x = 0x80;
+	int32_t y = 0x60;
+	int32_t r = 0xF0;
+	int32_t g = 0xF0;
+	int32_t b = 0xF0;
+
+	if (MOD_BATTLE_FAST) {
+		if (BTL_modSpeedHeld()) {
+			r = g = b = 0x80;
+		} else {
+			r = 0xF8;
+			g = 0xD8;
+			b = 0x30;
+		}
+	}
+	BTL_addSpeedRect(x, y, 23, 9, 0x62, 0xB4, 0xF6, 6);
+	BTL_addSpeedRect(x + 1, y + 1, 21, 7, 0x18, 0x18, 0x18, 5);
+	BTL_addSpeedGlyph(x + 3, y + 2, 0, 0xF0, 0xF0, 0xF0);
+	BTL_addSpeedGlyph(x + 7, y + 2, 1, 0xF0, 0xF0, 0xF0);
+	BTL_addSpeedGlyph(x + 13, y + 2, 2, r, g, b);
+	BTL_addSpeedGlyph(x + 17, y + 2, MOD_BATTLE_FAST ? 1 : 3, r, g, b);
+}
+
+/* before each tick of the battle's loops: whether it may run fast */
+void BTL_modSpeedBeforeTick(void)
+{
+	MOD_BATTLE_FAST_TICK = MOD_BATTLE_FAST && !BTL_modSpeedHeld();
+}
+
+/* after the pad is read: R2 switches the speed */
+void BTL_modSpeedInput(void)
+{
+	if ((POLLED_INPUT & ~POLLED_INPUT_PREVIOUS) & 2) {
+		MOD_BATTLE_FAST ^= 1;
+		playSound(0, 2);
+	}
 }
diff --git a/src/btl/battle_main.c b/src/btl/battle_main.c
index b1d02b6c..af87af37 100644
--- a/src/btl/battle_main.c
+++ b/src/btl/battle_main.c
@@ -2655,8 +2655,10 @@ void BTL_battleTickFrame(void)
 {
 	/* MOD (fps): rendered by the shared tick / present helper (main.c);
 	 * the tick started with the AI in BTL_battleMain */
+	BTL_modSpeedBeforeTick(); /* MOD (battle speed) */
 	modTickStart(MOD_PRESENT_BATTLE);
 	POLLED_INPUT = PadRead(1);
+	BTL_modSpeedInput();
 	ACTIVE_FRAMEBUFFER = GsGetActiveBuff();
 	ACTIVE_ORDERING_TABLE = &GS_ORDERING_TABLE[ACTIVE_FRAMEBUFFER];
 	GsSetWorkBase(GS_WORK_BASES[ACTIVE_FRAMEBUFFER]);
