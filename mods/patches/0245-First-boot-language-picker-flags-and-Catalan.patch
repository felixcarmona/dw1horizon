From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Tue, 27 Oct 2026 19:00:00 +0000
Subject: [PATCH] Patch 0245: first-boot language picker, flags and Catalan

Append Catalan without changing old save language values. Show native language
names and procedural flags when no saved preferences exist; remember the choice
through the existing save options. Preserve all original font pixels and widths
with compact Huffman row storage so the multilingual disc keeps its minimum heap.

diff --git a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -62,7 +62,7 @@
 # MOD (language): the language the executable's own strings are in at boot (docs/mods/language.md): en or es. A
 # two-language disc carries the other one as a patch (LANGEN.BIN / LANGES.BIN) and OPTIONS (LANGUAGE) switches.
 LANG_BASE ?= en
-ifeq ($(filter $(LANG_BASE),en es pt-br fr de it ja),)
+ifeq ($(filter $(LANG_BASE),en es pt-br fr de it ja ca),)
 $(error LANG_BASE=$(LANG_BASE): en, es, pt-br, fr, de, it or ja)
 endif
 # LANG_BUILD: the language of this build's strings and language tables (tools/build-full.sh builds the tree twice, once
diff --git a/include/dw/lang.h b/include/dw/lang.h
--- a/include/dw/lang.h
+++ b/include/dw/lang.h
@@ -12,7 +12,8 @@
 #define MOD_LANG_DE	4
 #define MOD_LANG_IT	5
 #define MOD_LANG_JA	6
-#define MOD_LANGS	7
+#define MOD_LANG_CA	7
+#define MOD_LANGS	8
 
 #include <lang_build.h>
 
