@@ -1888,7 +1930,11 @@
 		n--;
 	}
 	if ((code >> 8) >= EXTRA_GLYPH_LEAD && (code >> 8) <= 0xf9 && (code & 0xff) >= 0x40 && (code & 0xff) <= 0xfc && (code & 0xff) != 0x7f && n >= 0 && n < NUM_EXTRA_GLYPHS) {
+#if FONT_SWITCH
