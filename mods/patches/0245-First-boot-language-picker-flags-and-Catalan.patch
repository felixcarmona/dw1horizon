 		return (uint16_t *)FIGURE_SPACE_GLYPH.pixelData;
 	}
-	return lookupGlyph(code, GLYPH_DATA, EXTRA_GLYPH_DATA);
+	return lookupGlyph(code, 1);
 }
 
