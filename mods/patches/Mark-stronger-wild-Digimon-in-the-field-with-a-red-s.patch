+/*
+ * MOD (wild strength mark): a red skull above each wild Digimon in the field that is stronger than the partner.
+ * Strength is HP x (Offense + Defense), the enemy's after the scaling its fight applies (modHardEnemy); the limit is
+ * battleFormulas.strength (tools/battle_audit.py calibrates it against simulated fights). Only Digimon that fight on
+ * touch (autotalk 1) with techniques get one.
+ */
+extern int32_t IS_IN_MENU;
+
+#define SKULL_W 11
+#define SKULL_H 11
+/* one string per row: R body, K eye and nose sockets, . empty */
+static const char *const SKULL[SKULL_H] = {
+	"...RRRRR...",
+	"..RRRRRRR..",
+	".RRRRRRRRR.",
+	".RRRRRRRRR.",
+	".RKKRRRKKR.",
+	".RKKRRRKKR.",
+	".RRRRKRRRR.",
+	"..RRRRRRR..",
+	"...RRRRR...",
+	"...RKRKRK..",
+	"....RRRRR..",
+};
+
+static void strengthRow(int32_t x, int32_t y, int32_t w, uint32_t rgb, int32_t z)
+{
+	POLY_F4 *p = (POLY_F4 *)GsGetWorkBase();
+
+	SetPolyF4(p);
+	setRGB0(p, rgb >> 16, (rgb >> 8) & 0xff, rgb & 0xff);
+	setXYWH(p, x, y, w, 1);
+	AddPrim(ACTIVE_ORDERING_TABLE->org + z, p++);
+	GsSetWorkBase((PACKET *)p);
+}
+
+static void strengthSkull(int32_t x, int32_t y)
+{
+	int32_t r, c, start, in, dx, dy, rr, cc;
+	char want;
+
+	/* the outline first (behind), then the body, then the sockets on top */
+	for (r = -1; r <= SKULL_H; r++) {
+		for (c = -1, start = -2; c <= SKULL_W; c++) {
+			in = 0;
+			for (dy = -1; dy <= 1; dy++) {
+				for (dx = -1; dx <= 1; dx++) {
+					rr = r + dy;
+					cc = c + dx;
+					if (rr >= 0 && rr < SKULL_H && cc >= 0 && cc < SKULL_W && SKULL[rr][cc] != '.') in = 1;
+				}
+			}
+			if (in) {
+				if (start == -2) start = c;
+			} else if (start != -2) {
+				strengthRow(x + start, y + r, c - start, 0x180808, 9);
+				start = -2;
+			}
+		}
+	}
+	for (want = 'R'; ; want = 'K') {
+		for (r = 0; r < SKULL_H; r++) {
+			for (c = 0, start = -1; c <= SKULL_W; c++) {
+				if (c < SKULL_W && SKULL[r][c] == want) {
+					if (start < 0) start = c;
+				} else if (start >= 0) {
+					strengthRow(x + start, y + r, c - start, want == 'R' ? 0xd82020 : 0x180808, want == 'R' ? 8 : 7);
+					start = -1;
+				}
+			}
+		}
+		if (want == 'K') break;
+	}
+}
+
+static int32_t strengthScore(Stats *s)
+{
+	return (s->base.hp * (s->base.off + s->base.def)) >> 6;
+}
+
+void modStrengthMarks(void)
+{
+	int32_t i, x, y, partner, wild;
+	DigimonEntity *d;
+	NPCEntity *npc;
+	SVECTOR world;
+	DVECTOR head;
+	Stats copy;
+
+	if (!MOD_OPT_STRENGTH || GAME_STATE != 0 || IS_SCRIPT_PAUSED != 1 || IS_IN_MENU != 0 || ENTITY_TABLE[1] == NULL) return;
+	partner = strengthScore(&PARTNER_ENTITY.digimonEntity.stats);
+	for (i = 2; i < 10; i++) {
+		if (ENTITY_TABLE[i] == NULL || ENTITY_TABLE[i]->isOnMap == 0 || ENTITY_TABLE[i]->isOnScreen == 0) continue;
+		npc = &NPC_ENTITIES[i - 2];
+		d = &npc->digimonEntity;
+		if (npc->autotalk != 1 || d->stats.base.hp <= 0 || d->stats.base.moves[0] == 0xff || isInvisible(&d->entity)) continue;
+		copy = d->stats;
+		modHardEnemy(&copy);
+		wild = strengthScore(&copy);
+		if (partner > wild / 100 * BM(STRENGTH_STRONGER)) continue;
+		world.vx = d->entity.posData->location.vx;
+		world.vy = -DIGI_PARA(d->entity.type).height;
+		world.vz = d->entity.posData->location.vz;
+		if (worldPosToScreenPos(&world, &head) <= 0) continue;
+		x = head.vx - (160 - DRAWING_OFFSET_X) - 5;
+		y = head.vy - (120 - DRAWING_OFFSET_Y) - 16;
+		if (x < -160 || x > 148 || y < -120 || y > 108) continue; /* the head is off the screen */
+		strengthSkull(x, y);
+	}
+}
+
 void renderFleeBubble(int32_t instanceId)
 {
 	Entity *e;
