 include/dw/lang.h        |   3 +-
 include/dw/mod_options.h |   2 +
 src/btl/battle_effect.c  | 158 ++++++++++++++++++++++++++++++++++++-
 src/btl/battle_hud.c     |   6 +-
 src/main/game_menu.c     |  61 ++++++++-------
 src/main/main.c          |   4 +-
