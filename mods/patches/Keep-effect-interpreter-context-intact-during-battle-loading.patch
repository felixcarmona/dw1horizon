From a344c098277fa03e6447915da771fd090bb870bc Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Thu, 5 Nov 2026 18:57:27 +0000
Subject: [PATCH] Keep effect interpreter context intact during battle loading

---
 src/btl/battle_effect.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/btl/battle_effect.c b/src/btl/battle_effect.c
index 2a2be8c..ecf47c2 100644
--- a/src/btl/battle_effect.c
+++ b/src/btl/battle_effect.c
@@ -41,6 +41,7 @@ extern int16_t MAIN_D_80134CDC;
 extern int32_t VIEWPORT_DISTANCE;
 extern int32_t UNKNOWN_MODEL_TAKEN[16];
 extern uint8_t *BUFF_MODEL[];
+extern int8_t MOD_BATTLE_LOADING;
 
 void setRotTransMatrix(MATRIX *m);
 void setMapLayerEnabled(int32_t enabled);
@@ -2176,6 +2177,12 @@ void BTL_tickEFEEngine(void)
 	int32_t j;
 	EfeSound *p;
 
+	/* The asynchronous loader resumes its init script through these same
+	 * interpreter globals. Do not replace its context with a live effect. */
+	if (MOD_BATTLE_LOADING) {
+		return;
+	}
+
 	setMapLayerEnabled(1);
 
 	COMBAT_EFFECT_ITR = 0;
@@ -2280,6 +2287,10 @@ void BTL_renderEFEEngine(void)
 	int32_t hit;
 	int32_t section;
 
+	if (MOD_BATTLE_LOADING) {
+		return;
+	}
+
 	target = EFE_TARGET_ENTITY_INDEX;
 	hit = EFE_HIT_ENTITY_INDEX;
 	section = EFE_ACTIVE_SECTION;
-- 
2.55.0

