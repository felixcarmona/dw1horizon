From eaf1a0927f64028e9339cab7a854d40ecd084b82 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Sat, 14 Nov 2026 14:59:53 +0000
Subject: [PATCH] Call raiseRow out of line to give the heap 528 B back

Inlined at each RAISE_ROW, the species-or-cache branch cost the main executable 528 bytes; one function with a tail call to getSpeciesRaise does the same lookup.
---
 include/dw/partner.h   | 9 ++-------
 src/main/mod_species.c | 8 ++++++++
 2 files changed, 10 insertions(+), 7 deletions(-)

diff --git a/include/dw/partner.h b/include/dw/partner.h
index 7a59b3a..7da2905 100644
--- a/include/dw/partner.h
+++ b/include/dw/partner.h
@@ -53,13 +53,8 @@ typedef struct {
 extern RaiseData RAISE_DATA[NUM_ORIGINAL_DIGIMON];
 RaiseData *getSpeciesRaise(int32_t type);
 int32_t getItemTakeDistance(int32_t type);
-static inline RaiseData *raiseRow(int32_t type)
-{
-	if ((uint32_t)type < NUM_ORIGINAL_DIGIMON) {
-		return &RAISE_DATA[type];
-	}
-	return getSpeciesRaise(type);
-}
+/* MOD (heap): a function, not inline: inlined at every RAISE_ROW it cost the main executable 528 bytes */
+RaiseData *raiseRow(int32_t type);
 #define RAISE_ROW(type) (*raiseRow(type))
 extern PoopPile WORLD_POOP[];
 
diff --git a/src/main/mod_species.c b/src/main/mod_species.c
index e445bd9..19202c3 100644
--- a/src/main/mod_species.c
+++ b/src/main/mod_species.c
@@ -288,6 +288,14 @@ RaiseData *getSpeciesRaise(int32_t type)
 	return (rec != NULL && (rec->flags & SPECIES_FLAG_PARTNER)) ? &rec->raise : &NO_RAISE;
 }
 
+RaiseData *raiseRow(int32_t type)
+{
+	if ((uint32_t)type < NUM_ORIGINAL_DIGIMON) {
+		return &RAISE_DATA[type];
+	}
+	return getSpeciesRaise(type);
+}
+
 EvoRequirements *getSpeciesEvoReqs(int32_t type)
 {
 	SpeciesRecord *rec;
-- 
2.55.0

