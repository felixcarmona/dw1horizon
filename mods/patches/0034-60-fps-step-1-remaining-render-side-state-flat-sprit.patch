 	tmd = (struct TMD_STRUCT *)obj->tmd;
 	vert = (SVECTOR *)tmd->vertop;
 	normal = (SVECTOR *)tmd->nortop;
@@ -3139,7 +3142,7 @@ void renderWireframed(GsDOBJ2 *obj, int32_t wireFrameShare)
 	LINE_F2 *lf2;
 
 	min = WIREFRAME_COLOR_MIN;
