+	color = min + modRenderRand() % (WIREFRAME_COLOR_MAX - min);
 	tmd = (struct TMD_STRUCT *)obj->tmd;
 	vert = (SVECTOR *)tmd->vertop;
 	normal = (SVECTOR *)tmd->nortop;
