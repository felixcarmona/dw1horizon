+/* the rows of the glyph `code` (Shift-JIS, big endian) in a font's tables: GLYPH_HEIGHT, then its width */
+static uint16_t *lookupGlyph(uint16_t code, const GlyphData *glyphs, const GlyphData *extras)
 {
