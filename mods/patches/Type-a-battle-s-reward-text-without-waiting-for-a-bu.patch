From 1c2f5aeda661b6b6709f311afbdd60b762c41600 Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Tue, 3 Nov 2026 00:39:55 +0000
Subject: [PATCH] Type a battle's reward text without waiting for a button

The end box typed a drop, an injury or a learned technique only after a press of confirm or cancel, with no prompt. Players read the frozen first two letters as a crash, and Palmon's recruit fight always drops. The text now types on its own; a press still skips a row's wait.
---
 src/btl/battle_hud.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/btl/battle_hud.c b/src/btl/battle_hud.c
index 20cda43..1d175a8 100644
--- a/src/btl/battle_hud.c
+++ b/src/btl/battle_hud.c
@@ -854,6 +854,17 @@ void BTL_tickBattleEndText(void)
 		return;
 	}
 
+	/* MOD (end box typing): the original typed a reward's text only after a button press, with
+	 * no prompt on screen: a drop's first two letters stood still and players took it for a
+	 * crash. The text now types on its own, at once for the first row and after each row's
+	 * wait for the next; a press still skips the wait. */
+	if (BATTLE_END_ROWS_DRAWN == 0) {
+		BATTLE_END_WAIT_TIMER = 0;
+	}
+	if (BATTLE_END_WAIT_TIMER == 0) {
+		BATTLE_END_TYPING = 1;
+	}
+
 	if (BATTLE_END_ROWS_SHOWN == BATTLE_END_VISIBLE_ROWS) {
 		if (BATTLE_END_WAIT_TIMER == 0) {
 			BTL_scrollBattleEndText();
-- 
