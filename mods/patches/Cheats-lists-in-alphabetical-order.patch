+/* The bytes of the old fixed-width centering padding of map captions at s: a space, a full-width space or none (0). */
+static __attribute__((noinline)) int32_t modLabPad(const char *s)
+{
+    return *s == ' ' ? 1 : (uint8_t)s[0] == 0x81 && (uint8_t)s[1] == 0x40 ? 2 : 0;
+}
+
+/*
+ * The Digimon and map lists are in alphabetical order. A name can be in a DIGI.DAT record, read from the disc into a
+ * small cache, so each row's sort key is taken once as it is added: its first LAB_KEY - 1 bytes with no padding and
+ * the letters as capitals (not the second byte of a two-byte glyph), by id, in the save extension area, which only a
+ * card operation uses and none runs while the lab is open (memmap.h).
+ */
+#define LAB_KEY 16
+#define LAB_KEYS ((uint8_t (*)[LAB_KEY])SAVE_EXT_ADDR)
+_Static_assert(LAB_KEY * NUM_DIGIMON <= SAVE_EXT_MAX && LAB_KEY * NUM_SCREENS <= SAVE_EXT_MAX, "lab sort keys");
+static __attribute__((noinline)) void modLabAdd(int32_t id)
+{
+    uint8_t *k = LAB_KEYS[id];
+    const uint8_t *s = (uint8_t *)(MOD_LAB_VIEW == LAB_EVOLVE ? DIGIMON_NAME(id) : getScreenCaption(id));
+    uint32_t c;
+    int32_t n, trail = 0;
+    labChoices[labCount++] = id;
+    while ((n = modLabPad((char *)s))) s += n;
+    for (n = 1; n < LAB_KEY && (c = *s++); n++) {
+        if (trail) trail = 0;
+        else if (c >= 0x80) trail = 1;
+        else if (c - 'a' < 26u) c -= 32;
+        *k++ = c;
+    }
+    *k = 0;
+}
+
+/* 1 when a's key comes before b's (byte order); the techniques list adds keys too but is not sorted. */
+static __attribute__((noinline)) int32_t modLabBefore(int32_t a, int32_t b)
+{
+    const uint8_t *x = LAB_KEYS[a], *y = LAB_KEYS[b];
+    while (*x && *x == *y) x++, y++;
+    return *x < *y;
+}
