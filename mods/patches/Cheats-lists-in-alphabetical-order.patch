From 63e2babfe729f7dcde5ed17fd90543d85ef8472d Mon Sep 17 00:00:00 2001
From: Horizon authors <>
Date: Fri, 27 Nov 2026 09:54:14 +0000
Subject: [PATCH] Cheats: the Digimon and teleport lists are sorted
 alphabetically

Both lists were in id order. They are now ordered by the name shown, case-insensitive, with ties in id order; the cursor still starts on the current partner or screen.
---
 src/main/mod_lab_menu.inc | 35 +++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/src/main/mod_lab_menu.inc b/src/main/mod_lab_menu.inc
index 3efe8ccc..57228ed7 100644
--- a/src/main/mod_lab_menu.inc
+++ b/src/main/mod_lab_menu.inc
@@ -189,6 +189,40 @@ static int32_t modLabNewSpecies(int32_t type)
     return type >= NUM_PARTNER_DIGIMON || !isVanillaSpecies(type);
 }
 
+/* Name shown for a list entry, without the old centering padding of map captions. */
+static const char *modLabSortName(int32_t id)
+{
+    const char *s = MOD_LAB_VIEW == LAB_EVOLVE ? DIGIMON_NAME(id) : getScreenCaption(id);
+    while (*s == ' ' || ((uint8_t)s[0] == 0x81 && (uint8_t)s[1] == 0x40)) s += (uint8_t)*s >= 0x80 ? 2 : 1;
+    return s;
+}
+
+static int32_t modLabNameBefore(int32_t a, int32_t b)
+{
+    const char *x = modLabSortName(a), *y = modLabSortName(b);
+    int32_t cx, cy;
+    for (;; x++, y++) {
+        cx = (uint8_t)*x; cy = (uint8_t)*y;
+        if (cx >= 'a' && cx <= 'z') cx -= 32;
+        if (cy >= 'a' && cy <= 'z') cy -= 32;
+        if (cx != cy || !cx) break;
+    }
+    return cx != cy ? cx < cy : a < b;
+}
+
+/* Alphabetical by name; ties keep the id order. Shell sort: no extra memory, few name reads. */
+static void modLabSort(void)
+{
+    int32_t gap, i, j, id;
+    for (gap = labCount / 2; gap > 0; gap /= 2) {
+        for (i = gap; i < labCount; i++) {
+            id = labChoices[i];
+            for (j = i; j >= gap && modLabNameBefore(id, labChoices[j - gap]); j -= gap) labChoices[j] = labChoices[j - gap];
+            labChoices[j] = id;
+        }
+    }
+}
+
 static void modLabList(int32_t view)
 {
     int32_t i, first, id;
@@ -222,6 +256,7 @@ static void modLabList(int32_t view)
             } while (id >= 0 && id != first && labCount < NUM_SCREENS);
         }
     }
+    modLabSort();
     id = view == LAB_EVOLVE ? PARTNER_ENTITY.digimonEntity.entity.type : CURRENT_SCREEN;
     for (i = 0; i < labCount; i++) if (labChoices[i] == id) MOD_LAB_CURSOR = i;
 }
