     }
+    /* Digimon and maps by the name shown (insertion sort: stable, ties keep the id order); techniques by id. */
+    if (view != LAB_MOVES) for (i = 1; i < labCount; i++) {
+        id = labChoices[i];
+        for (j = i; j > 0 && modLabBefore(id, labChoices[j - 1]); j--) labChoices[j] = labChoices[j - 1];
+        labChoices[j] = id;
+    }
     id = view == LAB_EVOLVE ? PARTNER_ENTITY.digimonEntity.entity.type : view == LAB_MOVES ? 0 : CURRENT_SCREEN;
     for (i = 0; i < labCount; i++) if (labChoices[i] == id) MOD_LAB_CURSOR = i;
 }
