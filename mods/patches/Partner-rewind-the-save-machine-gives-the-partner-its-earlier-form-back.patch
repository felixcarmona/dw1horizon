 				if (DIGI_PARA(newId).level == 4) {
 					modTamerLevelEvent(MOD_TL_EVOLVE_CHAMPION_CHANCE, 1);
 				}
@@ -1513,7 +1541,7 @@ void EVL_applyEvolution(Entity *entity, Stats *stats, PartnerPara *para, int16_t
