{
 "recipe": "everything",
 "about": "Every engine patch, What the island forgot, all eight languages and every imported species.",
 "environment": {
  "TEXT": "ours",
  "LANGS": "en,es,pt-br,fr,de,it,ja,ca",
  "LANG_BASE": "en",
  "PACK_ASCII": 1,
  "STORY_ALT": 1,
  "SEEK_ORDER": 1,
  "NO_MOVIES": 0,
  "FONT": null,
  "FPS": null,
  "PARTNER_MMD_MAX": null,
  "IMPORTS": 1,
  "SPECIES": "all",
  "SPECIES_PROVIDER": "imports",
  "REUSE_MODELS": 1,
  "STORY_MODS": "all",
  "DEV": 0,
  "NAME": "everything",
  "DW_HEAP_MAP": "/nonexistent",
  "LANG": "en_US.UTF-8"
 },
 "environment_notes": {
  "DW_HEAP_MAP": "check only (the story's heap check): pinned off so the first and the second build of a fresh $W behave the same (the first has no map yet)",
  "LANG": "Locale for shell globs and sort -u; the ordered source list is explicit below.",
  "REUSE_MODELS": "build.sh's default; with a fresh build/NAME/models every model is made"
 },
 "species": {
  "select": "all",
  "provider": "imports",
  "provider_source": "content/models/imports",
  "pins": "tools/derive/recipes/species-pins.json",
  "note": "The imports provider runs inside derive after model import and field overlays; every output is pinned by SHA-1."
 },
