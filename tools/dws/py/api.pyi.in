class Key:
    """The game's own text, by key: an utterance (`text.s002.sec6.u0`, a text box with its pages) or a menu option
    (`text.s002.sec6.m1.o0`). The words stay on the player's disc (text/us/, or another text source)."""
class _Page:
    """Several rows shown together as one page: `page("First row", "Second row")`."""
Page = str | Key | _Page
def page(*rows: Key | str) -> _Page: """One page with exactly these rows (a key here must be one row)."""
def t(name: str) -> Key: """A named line of this mod: its English is text/en.json[name], its translations text/<lang>.json[name]
    (`say(t("intro.hello"))`; a line written in place, `say("Hello!")`, needs no name). `check` says a name en.json lacks."""

class Flag:
    """A yes/no fact saved with the game: `if invited:`, `invited.set()`, `invited.clear()`."""
    def __bool__(self) -> bool: ...
    def set(self) -> None: """Make it true (saved with the game)."""
    def clear(self) -> None: """Make it false."""
class Var(int):
    """A small number saved with the game (or the engine's own, `pstat(110)`): compare it like an int."""
    def set(self, n: 'int | Reading') -> None: """`visits.set(0)`; `last_day.set(clock.day)` keeps today's day."""
    def add(self, n: int) -> None: """`visits.add(1)`: add to it (0-255 on the original engine)."""
    def sub(self, n: int) -> None: """`visits.sub(1)`: take from it."""

class Quest(Enum):
    """A quest's stages, in order: `class Horn(Quest): NONE = auto(); ASKED = auto()`. Saved as bits of the mod's range.
    A stage is a condition (`when=Horn.ASKED`, `if Horn.ASKED:`); `advance(Horn.FOUND)` moves the quest."""
    stage: Self
    """The current stage, for `match Horn.stage: case Horn.ASKED: ...`."""
    @classmethod
    def before(cls, s: Self) -> bool: """The quest has not reached stage `s` yet."""
    @classmethod
    def reached(cls, s: Self) -> bool: """The quest is at stage `s` or later."""

Cond = bool | Quest | Flag

def flag() -> Flag: """A new flag of this mod (its name is the variable's)."""
def counter() -> Var: """A new saved counter of this mod: 0-255 on the original engine (a test past 255 is refused), 32 bits with story state."""
def advance(stage: Quest) -> None: """Move a quest to `stage`."""
def trigger(n: int) -> Flag: """The game's own flag number `n` (a trigger)."""
def pstat(n: int) -> Var: """The game's own variable number `n` (a pstat)."""

class Test:
    """A test the game makes at the moment the line runs: the clock, a random draw, a battle's outcome. It goes in an `if`
    or a `while` inside a handler; a guard (`when=`) tests saved state only, so it is refused there."""
    def __bool__(self) -> bool: ...
class Reading:
    """A value the game reads at the moment the line runs (`clock.hour`, `random.roll(99)`): compare it in an `if`."""
    def __lt__(self, n: int) -> Test: ...
    def __le__(self, n: int) -> Test: ...
    def __gt__(self, n: int) -> Test: ...
    def __ge__(self, n: int) -> Test: ...
    def __eq__(self, n: object) -> Test: ...  # type: ignore[override]
    def __ne__(self, n: object) -> Test: ...  # type: ignore[override]
    def __sub__(self, kept: Var) -> 'Reading':
        """`clock.day - last_day`: the days since `last_day.set(clock.day)` (`if clock.day - last_day >= 3:`; the story-state engine)."""
class ClockTest(Test):
    """A test of the clock (`clock.hour >= 20`): in an `if`, and in a new NPC's `when=` (its presence: the screen's setup
    reads the clock when it loads), never in a handler's guard."""
class _ClockReading(Reading):
    def __lt__(self, n: int) -> ClockTest: ...
    def __le__(self, n: int) -> ClockTest: ...
    def __gt__(self, n: int) -> ClockTest: ...
    def __ge__(self, n: int) -> ClockTest: ...
    def __eq__(self, n: object) -> ClockTest: ...  # type: ignore[override]
    def __ne__(self, n: object) -> ClockTest: ...  # type: ignore[override]
Outcome = Literal['won', 'lost', 'fled']
"""How a battle ended: `if fight(x) == "won":`, or each of them: `match fight(x): case "won": ... case "lost": ... case "fled": ...`."""

class Entity:
    """Someone on the screen: an NPC, `tamer`, `partner`, `narrator` (the box without a name)."""
    def say(self, *pages: Page) -> None: """One box; each argument is a page (a string is wrapped to 3 rows; a key gives its pages)."""
    def ask(self, *, yes: Page, no: Page) -> bool:
        """A two-option menu in this one's box: `if narrator.ask(yes="Follow it", no="Stay"):`. True when the player picks
        `yes` (always the top option); `no` or cancel is False. Both keywords are required; more options: `choose`."""
    def choose(self, **options: Page) -> str: """A menu; returns the keyword of the option picked (`match choose(...)`)."""
    def walk(self, x: int, z: int, *, camera: bool = False, wait: bool = True) -> None:
        """Walk to (x, z) (world units); `wait=False`: go on at once (`arrived()` waits later); `camera=True`: the camera follows."""
    def run(self, x: int, z: int, *, camera: bool = False, wait: bool = True) -> None: """Run to (x, z): as `walk`, faster."""
    def arrived(self) -> None: """Wait until a walk started with `wait=False` (or an animation) has ended."""
    def face(self, other: 'Entity') -> None: """Turn to look at `other` (`tamer.face(kunemon)`)."""
    def turn(self, angle: int) -> None: """Rotate to an angle (4096 = a full turn)."""
    def play(self, anim: int, *, wait: bool = False) -> None: """Play an animation slot (`anim.idle`, or a number)."""
    def walk_away(self, x: int, z: int, *, looks: int = 3, pause: int = 1000) -> None:
        """Run off to (x, z) while the tamer and partner glance after it `looks` times, `pause` ms apart."""
    def send_to_city(self, *, line: Page, species: 'Species | None' = None, sound: tuple[int, int] = (8, 11), prosperity: int = 1,
                     camera: bool = True) -> None: """It leaves for File City: gone, a jingle, `line` by the narrator, it joins the city."""
    def leave(self) -> None: """Gone from the screen."""

class NPC(Entity):
    """An NPC of a screen, by its slot. `@npc.on_talk` handlers answer when the tamer talks to it."""
    species: 'Species'
    @overload
    def on_talk(self, fn: _F, /) -> _F:
        """What it says when the tamer talks to it. On an NPC of the game (imported from `dw.base`) it needs `when=` and
        answers **instead of** the base's talk while `when` holds (the base's talk answers otherwise). On the mod's own NPC
        (`npc()`, `take_over()`), handlers are tried in order, the first whose `when` holds answers, one without `when` last.
        Without `scene=`, the NPC and the tamer turn to face each other when the talk starts (most talks of the game).
        `scene=True`: they do not turn: a staged scene whose `walk`/`face` place them (trigger 44; 14 talks of the game)."""
    @overload
    def on_talk(self, *, when: Cond = ..., scene: bool = False) -> Callable[[_F], _F]: ...
    def talk(self) -> None: """Its talk handler (`return tokomon.talk()`: go on there)."""

class Level(IntEnum):
    """A species' level: `if partner.level >= Level.champion:` (the partner species of those levels, from content/species: the
    game's 62 partners on the original engine; on --exe species / story-state every species with a `partner` block, the imported too)."""
    fresh = 1
    in_training = 2
    rookie = 3
    champion = 4
    ultimate = 5
    mega = 6

class Partner(Entity):
    species: 'Species'
    level: Level
    hp: int; mp: int; max_hp: int; max_mp: int; offense: int; defense: int; speed: int; brain: int; tiredness: int
    happiness: int; discipline: int; energy: int; virus: int; lifetime: int; merit: int; battles: int; fled_battles: int
    tournaments_won: int; tournament_wins: int; tournaments_lost: int; weight: int; lives: int
    sleepy: bool; tired: bool; hungry: bool; poopy: bool; unhappy: bool; injured: bool; sick: bool
    """Its conditions (`if partner.sick:`); the numbers are compared (`if partner.happiness >= 50:`)."""
    def add(self, **stats: int) -> None: """Raise its stats by name: `partner.add(happiness=10, brain=5)`."""
    def sub(self, **stats: int) -> None: """Lower its stats by name: `partner.sub(tiredness=20)`."""
    def set(self, **stats: int) -> None: """Set its stats by name: `partner.set(hp=100)`."""

class _Camera:
    def on(self, who: Entity, *, speed: int = 10) -> None: """The camera moves to `who` and follows it (`speed`: how fast)."""
    def to(self, x: int, z: int, *, speed: int = 20) -> None: """The camera moves to the point (x, z)."""
    def arrived(self) -> None: """Wait until the camera has got there."""

class _Tamer(Entity):
    level: int
    """The tamer's level (`if tamer.level >= 5:`, `tamer.add(level=1)`)."""
