    def sub(self, *, level: int) -> None: """Lower the tamer's level."""
    def set(self, *, level: int) -> None: """Set the tamer's level."""
tamer: _Tamer
partner: Partner
narrator: Entity
camera: _Camera
def entity(n: int) -> NPC: """An entity by its number (an NPC the script calls by number: `x = entity(6)`)."""

class ScreenRef:
    """A screen: of the game (`screen(Screen.jijimons_house)`, or imported: `from dw.base.jijimons_house import house`) or
    the mod's own (`new_screen(239, map=...)`)."""
    def npc(self, species: 'Species | None', *, at: tuple[int, int] | None = None, behaves_like: NPC | None = None,
            when: Cond | ClockTest = ..., autotalk: bool = False, hp: int | None = None, mp: int | None = None,
            offense: int | None = None, defense: int | None = None, speed: int | None = None, brain: int | None = None,
            bits: int | None = None, range: int | None = None, slot: int | None = None) -> NPC:
        """A new NPC of this mod. It takes the screen's next free slot: the new NPCs of a screen fill its free slots in the
        order the files and mods compiled together declare them (`slot=` may say it, and must be that one; `python3
        tools/dws.py slots SCREEN` lists the slots and the heap left for its model). The mod owns it: its `on_talk` handlers
        are all it says; to own an NPC of the game instead, `take_over(npc)`. `at=(x, z)`: where it stands (required; `dws
        slots SCREEN` prints the walkable box and the overlay that draws it). `behaves_like=tokomon`: it copies that NPC's
        behaviour, range, stats and path (moved to `at`); without it, the screen's first NPC that walks a path (none: its
        last slot, which `check` names).
        `when=`: it is there only while this holds (saved state: quest stages, flags, `recruited(...)`; on every engine);
        `range=N`: how far (world units) a chasing NPC runs after the player; 0 waits to be touched; a zigzag screen whose
        legs lie one above the other wants a short range, or the chase crosses the terrace and the battle cannot be fought.
        `autotalk=True`: it talks when touched. On `screen(a, b)` it stands in the same slot of each. Slots 8-15 and
        species beyond the game's 180 need the story-state engine (`check --exe story-state`); `check` also tests the screen's heap."""
    @overload
    def on_enter(self, fn: _F, /) -> _F:
        """What runs when the tamer enters the screen. On a screen of the game it needs `when=` and runs **before** the
        screen's own enter code, which still runs after it (no `return` in it; a `warp` ends it). On a new screen it is
        the whole enter."""
    @overload
    def on_enter(self, *, when: Cond = ...) -> Callable[[_F], _F]: ...
    @overload
    def on_load(self, fn: _F, /) -> _F: """The screen's setup in MAPHEAD (who stands there), before its script runs."""
    @overload
    def on_load(self, *, when: Cond = ...) -> Callable[[_F], _F]: ...
    def on_step(self, tile: int, *, when: Cond = ...) -> Callable[[_F], _F]:
        """What runs when the tamer steps on the screen's step trigger `tile` (0-28: the ones its map has, `dws slots SCREEN`)."""
    def on_use(self, tile: int, *, when: Cond = ...) -> Callable[[_F], _F]:
        """What runs when the tamer presses CROSS standing on a tile of the use trigger `tile` (a door, a sign, a box)."""
    def section(self, n: int) -> Callable[[_F], _F]: """A numbered section of the screen's script that other code calls."""

def screen(*screens: 'Screen | int') -> ScreenRef:
    """A screen of the game: `house = screen(Screen.jijimons_house)`. Several screens of one script are one place for
    `npc()` (`screen(Screen.file_city_168, Screen.file_city_169)`: the NPC stands on each)."""
def new_screen(n: int, *, map: str | None = None) -> ScreenRef:
    """A screen of the mod's own (a file of its own; one script): `hollow = new_screen(239, map="build/<mod>/maps/X.MAP")`."""
def take_over(npc: NPC, *, species: 'Species | None' = None, at: tuple[int, int] | None = None, hp: int | None = None,
              mp: int | None = None, offense: int | None = None, defense: int | None = None, speed: int | None = None,
              brain: int | None = None, bits: int | None = None) -> NPC:
    """The mod owns an NPC of the base: `jiji = take_over(jijimon)`; its talk is then this mod's `@jiji.on_talk` handlers
    (give it at least one): the base's talk runs only where one ends `return jijimon.talk()` (a line of yours, then the
    game's own talk). `species=`, `at=` and the stats change what stands in
    the slot (a species swap: write its words too, the base's would not match). When it is there stays the base's rule.
    To add to the base's talk instead, import the NPC and write `@jijimon.on_talk(when=...)`."""
