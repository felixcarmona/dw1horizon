def hook(n: int) -> Callable[[_F], _F]: """A global section of MAPHEAD the engine calls (1220-1253)."""
def sections(*entries: int | tuple[int, Callable[[], None]]) -> None: """The order of the script's section table (generated views)."""

def say(*pages: Page) -> None: """The NPC being talked to says it: one box, a page per argument."""
def ask(*, yes: Page, no: Page) -> bool:
    """`if ask(yes="Sure", no="Not now"):` True when the player picks `yes` (always the top option, whatever the keyword
    order); `no` or cancel is False. Both keywords are required; more options, or other names: `match choose(...)`."""
def choose(**options: Page) -> str: """`match choose(a="...", b="..."): case "a": ...`; `case _:` is cancel."""
def fight(*foes: Entity, escape: bool = True) -> Outcome:
    """A battle: with nobody named, the NPC being talked to; `escape=False`: the tamer cannot run. Its outcome is tested where
    it is fought: `if fight(x) == "won":`, or every outcome of the one battle with `match fight(x):` and `case "won":`,
    `case "lost":`, `case "fled":` (`case _:` for the rest). Each `fight(...)` is a battle of its own."""
def recruitable(who: NPC, *, line: Page, joins: 'Species | None' = None) -> None:
    """It says `line`, fights you, and joins the city: the game's own wild recruits, as the views print them (a battle, then
    its recruit flag, with no departure scene). To act on the outcome: `if fight(x) == "won": send_to_city(line=...)`."""
def recruit(species: 'Species', *, prosperity: int = 0) -> None:
    """The species joins File City (its recruit flag; `recruited(species)` tests it); `prosperity=` adds to the city's."""
def unrecruit(species: 'Species') -> None:
    """Clears the species' recruit flag (`recruited(species)` becomes false); the city's prosperity is not touched."""
def send_to_city(*, line: Page, species: 'Species | None' = None, sound: tuple[int, int] = (8, 11), prosperity: int = 1,
                 camera: bool = True) -> None:
    """The NPC being talked to leaves for File City: gone, a jingle, `line` by the narrator, it joins the city."""
def walk_away(x: int, z: int, *, looks: int = 3, pause: int = 1000) -> None:
    """The NPC being talked to runs off to (x, z); the tamer and partner glance after it `looks` times, `pause` ms apart."""
def walk(x: int, z: int, *, camera: bool = False, wait: bool = True) -> None:
    """The NPC being talked to walks to (x, z) (world units); `wait=False`: go on at once; `camera=True`: the camera follows."""
def run(x: int, z: int, *, camera: bool = False, wait: bool = True) -> None: """The NPC being talked to runs to (x, z)."""
def arrived() -> None: """Wait until the NPC being talked to has ended its walk (`walk(..., wait=False)`) or animation."""
def face(who: Entity) -> None: """The NPC being talked to turns to look at `who` (`face(tamer)`)."""
def turn(angle: int) -> None: """The NPC being talked to turns to an angle (4096 = a full turn)."""
def play(anim: int, *, wait: bool = False) -> None:
    """The NPC being talked to plays an animation slot (`anim.idle`, or a number: `play(29)`); `wait=True`: until it ends."""
def leave() -> None: """The NPC being talked to is gone from the screen."""
def wait(ms: int) -> None: """Wait `ms` milliseconds, in steps of 50 (the game counts 20 ticks a second). Every time is in ms."""
class _Sound:
    def __call__(self, bank: int, n: int) -> None: """A sound effect by bank and number: `sound(8, 2)`."""
    def jingle(self) -> None: """The short jingle of a Digimon leaving for File City (bank 8, sound 11; also played at other happy moments)."""
sound: _Sound
def music(n: int) -> None:
    """Change the background music to track `n` (the number the game's scripts use; the tracks have no names here yet:
    the views of the base show which number a screen plays)."""
def warp(to: 'Screen | int', *, entry: int = 0, then: int = 255) -> None:
    """Go to another screen, arriving at its entry `entry` (`python3 tools/dws.py slots SCREEN` lists them); `then`: a section to run there."""
def hide_hud() -> None: """Hide the clock and the status bars (a staged scene)."""
def fade_to_white(ms: int) -> None: """The screen fades to white over `ms` (steps of 50)."""
def fade_from_white(ms: int) -> None: """The screen fades back from white over `ms` (steps of 50)."""
def spawn_item(item: 'Item', *, at: tuple[int, int]) -> None:
    """An item on the ground at (x, z) (world units, as every position), picked up when the tamer walks over it: the game
    puts it on the 100-unit tile under that point (`spawn_item(Item.Digimushrm, at=(-350, -950))`); at most 11 at a time."""
def load(species: 'Species') -> None: """Load a species' model, for `spawn` (the base's own setup code)."""
def spawn(species: 'Species', *, slot: int, autotalk: bool = False) -> None: """Put a loaded species (`load`) in an NPC slot."""
def use_script(script: int, screen: 'Screen | int') -> None: """A screen's setup: the script that runs on the screen."""
def jump_to_script(script: int, section: int) -> None: """Go on in another script's section (no return: the libraries 203, 204...)."""
def spawn_chest(item: 'Item', *, at: tuple[int, int], opened: Flag, facing: int = 0) -> None:
    """A treasure chest at (x, z) (in a screen's setup, `on_enter`). `opened` is set when it is taken, and a chest whose flag
    is set stays open: a `flag()` of the mod. `facing`: 0, 1024, 2048 or 3072 (4096 = a full turn)."""
def call(routine: 'Routine', *, arg: int | None = None) -> None: """Run one of the engine's routines (`call(Routine.x)`), `arg` in engine.arg."""
def give(what: 'Item | Card | None' = None, n: int = 1, *, bits: int = 0) -> None:
    """The tamer gets `n` of an item (`give(Item.Meat, 2)`, 0-255), a card (`give(Card(5))`) and/or bits (`give(bits=500)`).
    Say it with a narrator line: `narrator.say("Received 2 Meat.")`."""
def take(what: 'Item | Card | None' = None, n: int = 1, *, bits: int = 0) -> None:
    """The tamer loses `n` of an item, a card and/or bits (`take(bits=500)`): test `has(...)` or `bits >= 500` first."""
def learn(tech: 'Tech') -> None: """The partner learns a technique."""
def has(what: 'Item | Card', n: int = 1) -> bool: """The tamer has at least `n` of it: `if has(Item.Meat, 2):`."""
bits: int
"""The tamer's money: `if bits >= 500:` (a guard may test it); `give(bits=)` / `take(bits=)` change it."""
def recruited(species: 'Species') -> bool: """The species has joined File City (its recruit flag; `recruit(species)` sets it)."""
def knows(tech: 'Tech') -> bool: """The partner knows the technique."""
def has_card(n: int) -> int: """How many of card `n` the tamer has: `if has_card(5) >= 1:`."""

class _Clock:
    """The game's clock, read when the line runs: `if clock.hour >= 18 or clock.hour < 5:` (in an `if`, and in a new NPC's
    `when=`: its presence; never in a handler's guard).
    `day` is the day of the 30-day year (0-29). A wait: `last_day.set(clock.day)`, later `if clock.day - last_day >= 3:`."""
    year: _ClockReading; day: _ClockReading; hour: _ClockReading; minute: _ClockReading
clock: _Clock
class _Random:
    def chance(self, percent: int) -> Test: """True `percent` times in 100 (in an `if`, never in `when=`)."""
    def roll(self, n: int) -> Reading:
        """A random number 0..n, drawn on its own line and kept: `roll = random.roll(2)`, then `if roll == 0:` ... `elif
        roll == 1:` (the game keeps one draw: the next replaces it). A percentage is `random.chance(p)`."""
random: _Random

class Picked(Enum):
    EMPTY = 0
    CANCELLED = 1
def pick_item() -> 'Item | Picked': """The item menu: an Item, or Picked.EMPTY (nothing to give) / Picked.CANCELLED."""
def take_picked(*, all: bool = False) -> None: """Take the item `pick_item()` gave (one; `all=True`: every one of it)."""
def shop(*items: 'Item') -> None:
    """The NPC being talked to opens its shop with these items (in `on_talk`): buy and sell, the game's own menu, in this
    NPC's box. Its words are the keeper's of its species (the game's shopkeepers), the default keeper's otherwise."""
def swing_door(door: int) -> None: """Swing the screen's 3D door `door` (ROTATE_3D_OBJECT door, 0, 1: a turn over 32 frames)."""

class _Object:
    """A 3D object of the screen, by number (`objects[12]`)."""
    def show(self) -> None: """Show the object."""
    def hide(self) -> None: """Hide the object."""
    def animate(self, k: int) -> None: """Play its animation `k` from the start."""
class _Objects:
    def __getitem__(self, n: int) -> _Object: ...
objects: _Objects

class Card(int):
    """A card by its number: `give(Card(5))`."""

def dws(source: str) -> None: """DWS statements, as they are (docs/mods/dws.md): the escape hatch."""
