# Made from the player's disc, and everything a build writes
extracted
build/

# The text of each disc, extracted from the player's own discs (tools/dws.py extract-text): text/us/, text/jp/, ...
# Authored translations are committed; disc extractions stay ignored.
/text/*/
!/text/ours/
!/text/es/
!/text/pt-br/
!/text/fr/
!/text/de/
!/text/it/
!/text/ja/
!/text/ca/

